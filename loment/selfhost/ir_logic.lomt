module ir_logic

// M82 目标文件 (短路逻辑子集): && / || 生成 phi 短路, 必须与 lomentc 逐字节一致。

fn both(a: u32, b: u32) -> bool {
    return a > 0 && b > 0;
}

fn either(a: u32, b: u32) -> bool {
    return a == 0 || b == 0;
}

fn guard3(a: u32, b: u32, c: u32) -> bool {
    return a < b && b < c;
}

fn mixed(a: u32, b: u32) -> bool {
    return a > 1 && (b > 1 || a == b);
}
