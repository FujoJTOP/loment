        let g: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, sp);
        emit_str(s, out, ", i32 ");
        emit_val(s, out, lvl + 1);
        emit_str(s, out, "\n  ");
        let rl: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, g);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rl);
        let ie: u32 = iv + 1;   // ']' 之后
        if tok_is(src, toks, ie, "as") {
            apply_cast(s, out, src, toks, et, ie + 1, lvl);
            return ie + 2;
        }
        return ie;
    }
    if tok_is(src, toks, dot, "[") && is_array_tok(src, toks, ty) == 1 {
        // M24: 数组下标 a[i] -> GEP(数组, 0, i) + load
        let et2: u32 = elem_tok(src, toks, ty);
        let iv2: u32 = expr_bin(s, out, src, toks, dot + 1, 1, lvl);
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_val(s, out, lvl);
        emit_str(s, out, "\n  ");
        let rl2: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et2);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rl2);
        let ie2: u32 = iv2 + 1;
        if tok_is(src, toks, ie2, "as") {
            apply_cast(s, out, src, toks, et2, ie2 + 1, lvl);
            return ie2 + 2;
        }
        return ie2;
    }
    if tok_is(src, toks, dot, ".") {   // M23: 字段访问 p.a -> GEP + load
        let si: u32 = find_struct(s, src, toks, ty);
        let fi: u32 = field_index(s, src, toks, si, dot + 1);
        let ft: u32 = field_type(s, si, fi);
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, fi);
        emit_str(s, out, "\n  ");
        let rv: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, ft);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rv);
        let fe: u32 = dot + 2;
        if tok_is(src, toks, fe, "as") {
            apply_cast(s, out, src, toks, ft, fe + 1, lvl);
            return fe + 2;
        }
        return fe;
    }
    emit_str(s, out, "  ");
    let n2: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_tok(s, out, src, toks, j);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n2);
    let e9: u32 = j + 1;
    if tok_is(src, toks, e9, "as") {
        apply_cast(s, out, src, toks, ty, e9 + 1, lvl);
        return e9 + 2;
    }
    return e9;
}

/// 一元: -x (sub ty 0, v) / !b (xor i1 v, true) / &a / &mut a (数组 -> 切片)
fn expr_unary(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32, want: u32) -> u32 {
    if tok_is(src, toks, j, "&") {   // M3/M4: 数组 -> 切片 (元素指针 + 个数)
        let nm: u32 = j + 1;
        if tok_is(src, toks, nm, "mut") {
            nm = nm + 1;
        }
        let ty: u32 = var_type(s, src, toks, nm);
        emit_str(s, out, "  ");
        let p0: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, nm);
        emit_str(s, out, ".addr, i32 0, i32 0\n  ");
        let v1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
        emit_dec(s, out, p0);
        emit_str(s, out, ", 0\n  ");
        let v2: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } %t");
        emit_dec(s, out, v1);
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, array_len_of(src, toks, ty));
        emit_str(s, out, ", 1\n");
        set_temp_val(s, lvl, v2);
        return nm + 1;
    }
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        let neg: u32 = tok_is(src, toks, j, "-") as u32;
        let inner: u32 = expr_unary(s, out, src, toks, j + 1, lvl, want);
        let tt: u32 = expr_type(s, src, toks, j + 1);
        emit_str(s, out, "  ");
        let n: u32 = new_temp(s, out);
        if neg == 1 {
            emit_str(s, out, " = sub ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " 0, ");
            emit_val(s, out, lvl);
        } else {
            emit_str(s, out, " = xor i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", true");
        }
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, n);
        return inner;
    }
    return expr_atom(s, out, src, toks, j, lvl);
}

/// 二元 (优先级爬升): 结果落到第 lvl 层。
fn expr_bin(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, minp: u32, lvl: u32) -> u32 {
    let e: u32 = expr_unary(s, out, src, toks, j, lvl, 0);
    let i: u32 = e;
    let go: u32 = 1;
    while go == 1 {
        let c: u32 = op_code(src, toks, i);
        if c == 0 || op_prec(c) < minp {
            go = 0;
        } else if c == 1 || c == 2 {
            // 短路 (phi): 左值已在第 lvl 层; 右操作数只在需要时求值
            let b2: u32 = load32(s, 480) + 1;
            store32(s, 480, b2 + 2);
            emit_str(s, out, "  br i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", label ");
            if c == 2 {                    // &&
                lab_ref(s, out, b2, "sc_rhs");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2 + 1, "sc_short");
            } else {                       // ||
                lab_ref(s, out, b2 + 1, "sc_short");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2, "sc_rhs");
            }
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, b2, "sc_rhs");
            let r2: u32 = expr_bin(s, out, src, toks, i + 2, op_prec(c) + 1, lvl + 1);
            store32(s, 500, load32(s, 488));   // 右操作数结束时的块 = phi 前驱
            store32(s, 504, load32(s, 496));
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 1, "sc_short");
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 2, "sc_end");
            emit_str(s, out, "  ");
            let n2: u32 = new_temp(s, out);
            emit_str(s, out, " = phi i1 [ ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", ");
            ref_from(s, out, load32(s, 500), load32(s, 504));
            emit_str(s, out, " ], [ ");
            if c == 2 {
                emit_str(s, out, "false");
            } else {
                emit_str(s, out, "true");
            }
            emit_str(s, out, ", ");
            lab_ref(s, out, b2 + 1, "sc_short");
            emit_str(s, out, " ]\n");
            set_temp_val(s, lvl, n2);
            i = r2;
        } else if c == 14 || c == 15 {
            // 除法/取模: 除零 = 运行时 trap (M18); 同时点亮运行时文本块
            let r3: u32 = expr_bin(s, out, src, toks, i + 1, op_prec(c) + 1, lvl + 1);
            let lt3: u32 = expr_type(s, src, toks, j);
            let rt3: u32 = expr_type(s, src, toks, i + 1);
            let tt3: u32 = lt3;
            if tt3 == 0 {
                tt3 = rt3;
            }
            let n3: u32 = alloc_temp(s);   // lomentc 先占 r 再占 z
            let z3: u32 = alloc_temp(s);
            let w3: u32 = load32(s, 480) + 1;
            store32(s, 480, w3 + 2);
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, z3);
            emit_str(s, out, " = icmp eq ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0\n  br i1 %t");
            emit_dec(s, out, z3);
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3 + 1, "dtrap");
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3, "dok");
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, w3 + 1, "dtrap");
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            lab_def(s, out, w3, "dok");
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, n3);
            emit_str(s, out, " = ");
            emit_div_mnemonic(s, out, src, toks, c, tt3);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            jump(s, out, w3 + 2, "dend");
            lab_def(s, out, w3 + 2, "dend");
            set_temp_val(s, lvl, n3);
            i = r3;
        } else {
            let np: u32 = op_prec(c) + 1;
            let r: u32 = expr_bin(s, out, src, toks, i + op_toks(c), np, lvl + 1);
            let lt: u32 = expr_type(s, src, toks, j);
            let rt: u32 = expr_type(s, src, toks, i + op_toks(c));
            let tt: u32 = lt;
            if tt == 0 {
                tt = rt;
            }
            emit_str(s, out, "  ");
            let n: u32 = new_temp(s, out);
            emit_str(s, out, " = ");
            emit_mnemonic(s, out, src, toks, c, tt);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, n);
            i = r;
        }
    }
    return i;
}

// ---------------------------------------------------------------- 函数与模块

fn find_body(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j + 1;
}

fn find_paren(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "(") && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j;
}

fn skip_parens(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 返回类型 token: 需要 `-` `>` 才算有显式返回类型, 否则为 UNIT (哨兵 0xFFFFFFFF)。
fn fn_ret_tok(src: ptr, toks: ptr, rp: u32) -> u32 {
    if tok_is(src, toks, rp + 1, "-") && tok_is(src, toks, rp + 2, ">") {
        return rp + 3;
    }
    return 4294967295;
}

/// 是否 unit 返回 (`-> ()` 或省略返回类型)。
fn is_unit_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 4294967295 {
        return 1;
    }
    return tok_is(src, toks, tt, "(") as u32;
}

fn emit_fn(s: ptr, out: ptr, src: ptr, toks: ptr, base: u32) -> u32 {
    let lp: u32 = find_paren(src, toks, base + 2);
    let rp: u32 = skip_parens(src, toks, lp);
    let ret: u32 = fn_ret_tok(src, toks, rp);
    let k: u32 = 0;
    let i: u32 = lp + 1;
    while i < rp && k < 16 {
        store32(s, 16384 + k * 8, i);
        store32(s, 16384 + k * 8 + 4, i + 2);
        k = k + 1;
        i = skip_type(src, toks, i + 2);   // 类型可能是 [T] / [T; N]
        if tok_is(src, toks, i, ",") {
            i = i + 1;
        }
    }
    store32(s, 12, k);
    store32(s, 528, base + 1);   // 当前函数名 token (字符串全局命名用)
    store32(s, 524, 0);          // 字符串全局序号随函数复位
    let body_at: u32 = find_body(src, toks, lp);
    let nl: u32 = collect_locals(s, src, toks, body_at, skip_block(src, toks, body_at - 1));
    if tok_is(src, toks, base - 1, "interrupt") {   // M33: x86_intrcc 需要中断帧指针, 无参数
        emit_str(s, out, "; ");
        emit_tok(s, out, src, toks, base + 1);
        emit_str(s, out, " -> interrupt (x86_intrcc)\n");
        emit_str(s, out, "define x86_intrcc void @");
        emit_tok(s, out, src, toks, base + 1);
        emit_str(s, out, "(ptr byval([8 x i8]) %__frame) {\nentry:\n");
        let bi: u32 = 0;
        while bi < nl {
            emit_str(s, out, "  %");
            emit_tok(s, out, src, toks, load32(s, 20480 + bi * 8));
            emit_str(s, out, ".addr = alloca ");
            emit_ty(s, out, src, toks, load32(s, 20480 + bi * 8 + 4));
            emit_str(s, out, "\n");
            bi = bi + 1;
        }
        let jj: u32 = find_body(src, toks, lp);
        while tok_kind(toks, jj) != 4 {
            if tok_is(src, toks, jj, "}") {
                if load32(s, 476) == 0 {
                    emit_str(s, out, "  ret void\n");
                }
                emit_str(s, out, "}\n");
                return jj + 1;
            }
            jj = stmt(s, out, src, toks, jj, ret);
        }
        return jj;
    }
    emit_str(s, out, "; ");
    emit_tok(s, out, src, toks, base + 1);
    emit_str(s, out, " -> ");
    emitted_name(s, out, src, toks, ret);   // 注释用 Loment 类型名
    emit_str(s, out, "\n");
    emit_str(s, out, "define ");
    emit_ty(s, out, src, toks, ret);
    emit_str(s, out, " @");
    emit_tok(s, out, src, toks, base + 1);
    emit_str(s, out, "(");
    let a: u32 = 0;
    while a < k {
        if a > 0 {
            emit_str(s, out, ", ");
        }
        emit_ty(s, out, src, toks, load32(s, 16384 + a * 8 + 4));
        emit_str(s, out, " %");
        emit_tok(s, out, src, toks, load32(s, 16384 + a * 8));
        a = a + 1;
    }
    emit_str(s, out, ") {\nentry:\n");
    let b: u32 = 0;
    while b < k {
        emit_str(s, out, "  %");
        emit_tok(s, out, src, toks, load32(s, 16384 + b * 8));
        emit_str(s, out, ".addr = alloca ");
        emit_ty(s, out, src, toks, load32(s, 16384 + b * 8 + 4));
        emit_str(s, out, "\n");
        b = b + 1;
    }
    let bl: u32 = 0;   // 局部变量 alloca (紧随参数之后)
    while bl < nl {
        emit_str(s, out, "  %");
        emit_tok(s, out, src, toks, load32(s, 20480 + bl * 8));
        emit_str(s, out, ".addr = alloca ");
        emit_ty(s, out, src, toks, load32(s, 20480 + bl * 8 + 4));
        emit_str(s, out, "\n");
        bl = bl + 1;
    }
    let c: u32 = 0;
    while c < k {
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, load32(s, 16384 + c * 8 + 4));
        emit_str(s, out, " %");
        emit_tok(s, out, src, toks, load32(s, 16384 + c * 8));
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, load32(s, 16384 + c * 8));
        emit_str(s, out, ".addr\n");
        c = c + 1;
    }
    let j: u32 = find_body(src, toks, lp);
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "}") {
            if load32(s, 476) == 0 {   // 块未终止: unit 函数补 ret void, 其余补 unreachable
                if is_unit_tok(src, toks, ret) == 1 {
                    emit_str(s, out, "  ret void\n");
                } else {
                    emit_str(s, out, "  unreachable\n");
                }
            }
            emit_str(s, out, "}\n");
            return j + 1;
        }
        j = stmt(s, out, src, toks, j, ret);
    }
    return j;
}

// ---------------------------------------------------------------- 语句

fn lab_def(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    store32(s, 476, 0);           // terminated = false
    store32(s, 488, n);           // 当前标签 (phi 前驱用)
    store32(s, 496, tag_id(tag));
    emit_str(s, out, "L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    emit_str(s, out, tag);
    return emit_str(s, out, ":\n");
}

fn tag_id(tag: str) -> u32 {
    if str_eq(tag, "then") {
        return 1;
    }
    if str_eq(tag, "else") {
        return 2;
    }
    if str_eq(tag, "end") {
        return 3;
    }
    if str_eq(tag, "wcond") {
        return 4;
    }
    if str_eq(tag, "wbody") {
        return 5;
    }
    if str_eq(tag, "wend") {
        return 6;
    }
    if str_eq(tag, "sc_rhs") {
        return 7;
    }
    if str_eq(tag, "sc_short") {
        return 8;
    }
    if str_eq(tag, "fcond") {
        return 10;
    }
    if str_eq(tag, "fbody") {
        return 11;
    }
    if str_eq(tag, "fend") {
        return 12;
    }
    if str_eq(tag, "dok") {
        return 13;
    }
    if str_eq(tag, "dtrap") {
        return 14;
    }
    if str_eq(tag, "dend") {
        return 15;
    }
    if str_eq(tag, "aok") {
        return 16;
    }
    if str_eq(tag, "aovf") {
        return 17;
    }
    if str_eq(tag, "dead") {
        return 18;
    }
    return 9;   // sc_end
}

fn tag_name(id: u32) -> str {
    if id == 1 {
        return "then";
    }
    if id == 2 {
        return "else";
    }
    if id == 3 {
        return "end";
    }
    if id == 4 {
        return "wcond";
    }
    if id == 5 {
        return "wbody";
    }
    if id == 6 {
        return "wend";
    }
    if id == 7 {
        return "sc_rhs";
    }
    if id == 8 {
        return "sc_short";
    }
    if id == 10 {
        return "fcond";
    }
    if id == 11 {
        return "fbody";
    }
    if id == 12 {
        return "fend";
    }
    if id == 13 {
        return "dok";
    }
    if id == 14 {
        return "dtrap";
    }
    if id == 15 {
        return "dend";
    }
    if id == 16 {
        return "aok";
    }
    if id == 17 {
        return "aovf";
    }
    if id == 18 {
        return "dead";
    }
    return "sc_end";
}

/// 保存/还原当前标签 (phi 前驱)。
fn ref_from(s: ptr, out: ptr, n: u32, id: u32) -> u32 {
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag_name(id));
}

/// 当前标签引用: 0 = entry (隐式首块), 否则 %L{n}_{当前 tag 由调用方传入}
fn cur_ref(s: ptr, out: ptr, tag: str) -> u32 {
    let n: u32 = load32(s, 488);
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag);
}

fn lab_ref(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    emit_str(s, out, "%L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    return emit_str(s, out, tag);
}

/// 未终止才写 br; 随后置 terminated。
fn jump(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    let r: u32 = 0;
    if load32(s, 476) == 0 {
        emit_str(s, out, "  br label ");
        r = lab_ref(s, out, n, tag);
        emit_str(s, out, "\n");
    }
    store32(s, 476, 1);
    return r;
}

/// 变量类型: 参数 -> 局部; 0 = 未知。
fn var_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let t: u32 = param_type(s, src, toks, name_tok);
    if t != 0 {
        return t;
    }
    let i: u32 = 0;
    while i < load32(s, 484) {
        let nt: u32 = load32(s, 20480 + i * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return load32(s, 20480 + i * 8 + 4);
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 变量值加载到第 lvl 层 (load <ty>, ptr %name.addr)。
fn load_var(s: ptr, out: ptr, src: ptr, toks: ptr, name_tok: u32, lvl: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, name_tok);
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_tok(s, out, src, toks, name_tok);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n);
    return n;
}

/// 一条语句; 返回下一个待处理 token 下标。
fn stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    if tok_is(src, toks, j, "return") {
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        emit_str(s, out, "  ret ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " ");
        // 返回 ptr 而表达式就是字面量 0 时, lomentc 写 `null` (expr 的 want="ptr")
        if tok_is(src, toks, ret, "ptr") && tok_kind(toks, j + 1) == 1
                && tok_int(src, toks, j + 1) == 0 && e == j + 2 {
            emit_str(s, out, "null");
        } else {
            emit_val(s, out, 0);
        }
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        return e + 1;
    }
    if tok_is(src, toks, j, "let") {
        let name: u32 = j + 1;
        let ty: u32 = j + 3;
        let eq: u32 = skip_type(src, toks, ty);   // '=' 的位置 (类型可能是 [T; N] / [T])
        if is_array_tok(src, toks, ty) == 1 && tok_is(src, toks, eq + 1, "[") {
            return let_array_lit(s, out, src, toks, name, ty, eq + 1);
        }
        let e2: u32 = expr_bin(s, out, src, toks, eq + 1, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr\n");
        return e2 + 1;
    }
    if tok_is(src, toks, j, "if") {
        // 先算条件再占标签: 条件里的 `&&`/除法会自己占标签 (与 lomentc 的 If 同序)
        let e3: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        let base_l: u32 = load32(s, 480) + 1;   // lomentc 从 L1 起编号
        store32(s, 480, base_l + 2);
        emit_str(s, out, "  br i1 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", label ");
        lab_ref(s, out, base_l, "then");
        emit_str(s, out, ", label ");
        lab_ref(s, out, base_l + 1, "else");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, base_l, "then");
        let k: u32 = e3 + 1;   // '{' 之后的第一条语句
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        k = k + 1;
        jump(s, out, base_l + 2, "end");
        lab_def(s, out, base_l + 1, "else");
        if tok_is(src, toks, k, "else") {
            k = k + 1;
            if tok_is(src, toks, k, "if") {
                k = stmt(s, out, src, toks, k, ret);
            } else {
                k = k + 1;   // '{'
                while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
                    k = stmt(s, out, src, toks, k, ret);
                }
                k = k + 1;
            }
        }
        jump(s, out, base_l + 2, "end");
        lab_def(s, out, base_l + 2, "end");
        return k;
    }
    if tok_is(src, toks, j, "for") {   // for i in lo..hi { ... }
        let var_tok: u32 = j + 1;
        let le: u32 = j + 3;                       // lo 起始 (跳过 'for' 变量 'in')
        let loe: u32 = expr_bin(s, out, src, toks, le, 1, 0);
        let ty: u32 = var_type(s, src, toks, var_tok);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        let hi_start: u32 = loe + 2;               // 跳过 '..'
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "fcond");
        lab_def(s, out, w, "fcond");
        load_var(s, out, src, toks, var_tok, 0);
        let he: u32 = expr_bin(s, out, src, toks, hi_start, 1, 1);
        emit_str(s, out, "  ");
        let cn: u32 = new_temp(s, out);
        emit_str(s, out, " = icmp ");
        if is_signed(src, toks, ty) == 1 {
            emit_str(s, out, "slt ");
        } else {
            emit_str(s, out, "ult ");
        }
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ");
        emit_val(s, out, 1);
        emit_str(s, out, "\n  br i1 %t");
        emit_dec(s, out, cn);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "fbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "fend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "fbody");
        let k: u32 = he + 1;                       // '{' 之后
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        load_var(s, out, src, toks, var_tok, 0);
        emit_str(s, out, "  ");
        let nx: u32 = new_temp(s, out);
        emit_str(s, out, " = add ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", 1\n  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " %t");
        emit_dec(s, out, nx);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        jump(s, out, w, "fcond");
        lab_def(s, out, w + 2, "fend");
        return k + 1;
    }
    if tok_is(src, toks, j, "while") {
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "wcond");
        lab_def(s, out, w, "wcond");
        let e4: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        emit_str(s, out, "  br i1 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "wbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "wend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "wbody");
        let m: u32 = e4 + 1;   // '{' 之后的第一条语句
        while !tok_is(src, toks, m, "}") && tok_kind(toks, m) != 4 {
            m = stmt(s, out, src, toks, m, ret);
        }
        jump(s, out, w, "wcond");
        lab_def(s, out, w + 2, "wend");
        return m + 1;
    }
    // 表达式语句 (调用/内建): NAME ( ... ) ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "(") {
        let e6: u32 = expr_bin(s, out, src, toks, j, 1, 0);
        return e6 + 1;
    }
    // 下标赋值: NAME[IDX] = EXPR ;  (M4 可变切片 / M24 数组)
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "[") {
        let sty: u32 = var_type(s, src, toks, j);
        let set: u32 = elem_tok(src, toks, sty);
        if is_slice_tok(src, toks, sty) == 1 {
            load_var(s, out, src, toks, j, 0);
            emit_str(s, out, "  ");
            let sp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, 0);
            emit_str(s, out, ", 0\n");
            let siv: u32 = expr_bin(s, out, src, toks, j + 2, 1, 1);
            emit_str(s, out, "  ");
            let sgp: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds ");
            emit_ty(s, out, src, toks, set);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, sp);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, 1);
            emit_str(s, out, "\n");
            let sve: u32 = expr_bin(s, out, src, toks, siv + 2, 1, 2);
            emit_str(s, out, "  store ");
            emit_ty(s, out, src, toks, set);
            emit_str(s, out, " ");
            emit_val(s, out, 2);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, sgp);
            emit_str(s, out, "\n");
            return sve + 1;
        }
        if is_array_tok(src, toks, sty) == 1 {
            let aiv: u32 = expr_bin(s, out, src, toks, j + 2, 1, 0);
            emit_str(s, out, "  ");
            let agp: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds ");
            emit_ty(s, out, src, toks, sty);
            emit_str(s, out, ", ptr %");
            emit_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr, i32 0, i32 ");
            emit_val(s, out, 0);
            emit_str(s, out, "\n");
            let ave: u32 = expr_bin(s, out, src, toks, aiv + 2, 1, 1);
            emit_str(s, out, "  store ");
            emit_ty(s, out, src, toks, set);
            emit_str(s, out, " ");
            emit_val(s, out, 1);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, agp);
            emit_str(s, out, "\n");
            return ave + 1;
        }
        return j + 1;
    }
    // 赋值: NAME = EXPR ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "=") {
        let ty2: u32 = var_type(s, src, toks, j);
        let e5: u32 = expr_bin(s, out, src, toks, j + 2, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty2);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr\n");
        return e5 + 1;
    }
    return j + 1;
}

/// 数组字面量绑定: `let a: [T; N] = [e0, e1, …];` —— 逐元素 GEP + 求值 + store。
/// `i` 指向 `[`; 返回其后的 token 下标。
fn let_array_lit(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, i: u32) -> u32 {
    let et: u32 = elem_tok(src, toks, ty);
    let k: u32 = i + 1;
    let idx: u32 = 0;
    while !tok_is(src, toks, k, "]") && tok_kind(toks, k) != 4 {
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, idx);
        emit_str(s, out, "\n");
        let ev: u32 = expr_bin(s, out, src, toks, k, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        k = ev;
        if tok_is(src, toks, k, ",") {
            k = k + 1;
        }
        idx = idx + 1;
    }
    return k + 1;
}

/// 匹配的 '}' 之后的下标 (i 指向 '{')。
fn skip_block(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "{") {
            d = d + 1;
        }
        if tok_is(src, toks, j, "}") {
            d = d - 1;
            if d == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 按序收集局部变量 (let), 去重 —— 镜像 lomentc._collect_locals 的子集 (限于本函数体)。
fn collect_locals(s: ptr, src: ptr, toks: ptr, i: u32, end: u32) -> u32 {
    let n: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && j < end {
        if tok_is(src, toks, j, "for") {   // for 变量也需 alloca
            let name: u32 = j + 1;
            // 与 lomentc 同规则: 类型 = expr_type(lo) or expr_type(hi) or u32(0)
            let vt: u32 = expr_type(s, src, toks, j + 3);
            if vt == 0 {
                let d: u32 = j + 3;
                while tok_kind(toks, d) != 4 && !tok_is(src, toks, d, "{") {
                    if tok_is(src, toks, d, ".") && tok_is(src, toks, d + 1, ".") {
                        vt = expr_type(s, src, toks, d + 2);
                    }
                    d = d + 1;
                }
            }
            let dup0: u32 = 0;
            let kk: u32 = 0;
            while kk < n {
                if load32(s, 20480 + kk * 8) == name {
                    dup0 = 1;
                }
                kk = kk + 1;
            }
            if dup0 == 0 {
                store32(s, 20480 + n * 8, name);
                store32(s, 20480 + n * 8 + 4, vt);
                n = n + 1;
            }
        }
        if tok_is(src, toks, j, "let") {
            let name: u32 = j + 1;
            let dup: u32 = 0;
            let k: u32 = 0;
            while k < n {
                if load32(toks, load32(s, 20480 + k * 8) * 20 + 8) == load32(toks, name * 20 + 8) {
                    let q: u32 = 0;
                    let ok: u32 = 1;
                    while q < load32(toks, name * 20 + 8) {
                        if load8(src, load32(toks, load32(s, 20480 + k * 8) * 20 + 4) + q)
                                != load8(src, load32(toks, name * 20 + 4) + q) {
                            ok = 0;
                        }
                        q = q + 1;
                    }
                    if ok == 1 {
                        dup = 1;
                    }
                }
                k = k + 1;
            }
            if dup == 0 {
                store32(s, 20480 + n * 8, name);
                store32(s, 20480 + n * 8 + 4, j + 3);
                n = n + 1;
            }
        }
        j = j + 1;
    }
    store32(s, 484, n);
    return n;
}

fn count_args(src: ptr, toks: ptr, lp: u32) -> u32 {
    let d: u32 = 0;
    let argc: u32 = 0;
    let any: u32 = 0;
    let j: u32 = lp + 1;
    while !(tok_is(src, toks, j, ")") && d == 0) && tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") || tok_is(src, toks, j, "[") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") || tok_is(src, toks, j, "]") {
            d = d - 1;
        }
        if tok_is(src, toks, j, ",") && d == 0 {
            argc = argc + 1;
        }
        any = 1;
        j = j + 1;
    }
    if any == 0 {
        return 0;
    }
    return argc + 1;
}

/// freestanding 运行时文本块 (镜像 lomentc._IR_RUNTIME), 仅当出现过 `/` `%` 时写出。
/// 位置同 lomentc: 横幅之后、第一个函数之前 (尾部一个空行)。
fn emit_runtime(s: ptr, out: ptr) -> u32 {
    emit_str(s, out, "\n; ---- Loment freestanding 运行时 (M31: 无 libc) ----\ndefine internal i32 @__loment_memcmp(ptr %a, ptr %b, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %cont ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %eq, label %body\nbody:\n  %pa = getelementptr i8, ptr %a, i64 %i\n  %pb = getelementptr i8, ptr %b, i64 %i\n  %ca = load i8, ptr %pa\n  %cb = load i8, ptr %pb\n  %ne = icmp ne i8 %ca, %cb\n  br i1 %ne, label %diff, label %cont\ncont:\n  %i1 = add i64 %i, 1\n  br label %loop\ndiff:\n  %da = zext i8 %ca to i32\n  %db = zext i8 %cb to i32\n  %r = sub i32 %da, %db\n  ret i32 %r\neq:\n  ret i32 0\n}\n\n");
    emit_str(s, out, "define internal void @__loment_memset(ptr %p, i8 %v, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %end, label %body\nbody:\n  %q = getelementptr i8, ptr %p, i64 %i\n  store i8 %v, ptr %q\n  %i1 = add i64 %i, 1\n  br label %loop\nend:\n  ret void\n}\n\n");
    return emit_str(s, out, "define internal void @__loment_abort() {\n  call void @llvm.trap()\n  unreachable\n}\n\ndeclare void @llvm.trap()\n\n");
}

/// 预扫描: 源码里出现过 `/` `%` 运算符 (kind=3 且文本为单字符), 或 `alloc` / `panic`
/// (它们引用 `@__loment_*`) 时需运行时文本块。
/// 输出是顺序写的, 而运行时块要落在横幅之后、函数之前, 所以必须先判定再写横幅。
/// 语义等价于 lomentc 的 `"@__loment_" in text_all` —— 本 codegen 目前只有这三个来源会引用它。
fn runtime_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 3 && (tok_is(src, toks, i, "/") || tok_is(src, toks, i, "%")) {
            return 1;
        }
        if tok_kind(toks, i) == 0 && (tok_is(src, toks, i, "alloc") || tok_is(src, toks, i, "panic")
                || tok_is(src, toks, i, "str_eq")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 预扫描: `alloc` 用到 bump 堆全局 (`@__loment_heap`/`@__loment_off`)。
fn heap_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, "alloc") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 主入口: 写完整 IR (子集), 返回长度。
pub fn emit_module(src: ptr, toks: ptr, out: ptr) -> u32 {
    let s: ptr = alloc(49152);
    store32(s, 0, 0);
    store32(s, 4, 0);
    store32(s, 12, 0);
    store32(s, 640, 0);   // 函数个数
    store32(s, 476, 0);   // terminated
    store32(s, 480, 0);   // label 计数
    store32(s, 484, 0);   // 局部数
    store32(s, 512, runtime_needed(src, toks));
    store32(s, 516, heap_needed(src, toks));
    store32(s, 532, strings_needed(src, toks));
    // 符号表: 登记函数
    let i: u32 = 0;
    let n: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            let lp: u32 = find_paren(src, toks, i + 2);
            let rp: u32 = skip_parens(src, toks, lp);
            store32(s, 12288 + n * 12, i + 1);
            store32(s, 12288 + n * 12 + 4, fn_ret_tok(src, toks, rp));
            store32(s, 12288 + n * 12 + 8, count_args(src, toks, lp));
            // 形参类型表: 调用点按形参类型强制实参 (与 lomentc 的 expr(a, p.type) 同义)
            let pi: u32 = lp + 1;
            let pk: u32 = 0;
            while pi < rp && pk < 16 {
                store32(s, 24576 + n * 128 + pk * 8, pi);
                store32(s, 24576 + n * 128 + pk * 8 + 4, pi + 2);
                pk = pk + 1;
                pi = skip_type(src, toks, pi + 2);
                if tok_is(src, toks, pi, ",") {
                    pi = pi + 1;
                }
            }
            n = n + 1;
        }
        i = i + 1;
    }
    store32(s, 640, n);
    // struct 表: name_tok | nfields | 8 × (field_tok, type_tok) —— 字段仅标量类型
    let sn: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "struct") && sn < 64 {
            store32(s, struct_base(sn), i + 1);
            let fld: u32 = i + 3;   // 跳过 '{'
            let nf: u32 = 0;
            while !tok_is(src, toks, fld, "}") && tok_kind(toks, fld) != 4 && nf < 8 {
                store32(s, struct_base(sn) + 8 + nf * 8, fld);
                store32(s, struct_base(sn) + 8 + nf * 8 + 4, fld + 2);
                nf = nf + 1;
                fld = fld + 4;   // name ':' type ','
            }
            store32(s, struct_base(sn) + 4, nf);
            sn = sn + 1;
        }
        i = i + 1;
    }
    store32(s, 520, sn);
    emit_str(s, out, "; 由 tools/lomentc.py 生成 (native: LLVM IR, docs/144/145)\n");
    emit_str(s, out, "; clang -O1 driver.c this.ll -o exe\n\n");
    if load32(s, 512) == 1 {
        emit_runtime(s, out);
    }
    if load32(s, 516) == 1 {
        emit_str(s, out, "@__loment_heap = internal global [65536 x i8] zeroinitializer\n@__loment_off = internal global i32 0\n\n");
    }
    if load32(s, 532) == 1 {
        emit_str_globals(s, out, src, toks);
        emit_str(s, out, "\n");
    }
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            store32(s, 4, 0);    // temp 计数随函数重置
            store32(s, 480, 0);  // label 计数随函数重置
            store32(s, 476, 0);  // terminated = false
            i = emit_fn(s, out, src, toks, i);
        } else {
            i = i + 1;
        }
    }
    return st_o(s);
}
