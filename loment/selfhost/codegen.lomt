            emit_dec(s, out, ap);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0
  %t");
            emit_dec(s, out, al);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 1
  %t");
            emit_dec(s, out, bp);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0
  %t");
            emit_dec(s, out, bl);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1
  %t");
