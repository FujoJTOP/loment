            let bp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0\n");
            let k14: u32 = arg1(s, out, src, toks, k13, lvl + 1);
