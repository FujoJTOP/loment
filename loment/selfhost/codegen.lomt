module codegen

// M82: Loment 版 IR 生成 —— 生成的 .ll 与 tools/lomentc.py 的 --emit-llvm 逐字节一致。
//
// 覆盖: 标量类型 (u8..u64/i8..i64/bool); 表达式 = 字面量 | 参数 | 括号 | 一元(- !)
//       | 二元(+ - * / % & | ^ << >> 比较) | 短路 &&/|| (phi) | 调用 | `as`;
//       语句 = let/赋值/if/while/for/return/表达式语句。
// 不含: 聚合类型(切片/字符串/数组/struct/枚举)、match、能力域、其余内建与 syscall。
//       除法/取模已含 —— 除零走 trap 跳转块, 并触发 freestanding 运行时文本块。
//
// 关键设计(两阶段): expr_* 先把指令写进输出, 再把"值文本"落到值栈的第 lvl 层;
// 调用方随后把该值内联到自己的行里 —— 这样嵌套表达式也能保持与 Python 版相同的指令顺序。
//
// 状态块: 0=输出游标 4=temp 计数 12=参数个数 512=需运行时文本块
//         值栈: 第 k 层 长度@8192+72k, 文本@8196+72k (容量 68), k=0..40
//         scratch 656.. (16B)
//         实参类型 720+(层)*4 (16 层) 十进制数字缓冲 672..704 函数计数 640  struct 表 1024..6144
//         函数表 CG_FN+i*12 (CG_MAXFN 个) fk 表 CG_FK+i*8 当前函数参数表 CG_CUR..
//         枚举表 CG_ENUM+i*80 (CG_MAXENUM 个) 局部表 CG_LOCAL.. (4 KiB) 每函数形参类型 CG_PARAM+i*80
//
// **容量**: 每函数 100 字节 (12+8+80)。这几张表**按单元的规模**定, 所以整块不再放进
// 语言自带的 64 KiB bump 堆 —— 由驱动器从 `brk` 拿 `cg_arena_bytes()` 再传进来
// (checker 的 arena 早就是这么做的), 否则一放大就 OOM。
//
// 曾经是 192, 又抬到 307 (fk 表只有 192 格时, 单元长到 246 个函数就写穿到参数替换表/
// 枚举表上 —— 症状是"少数函数被改名成 `<接收者>_<方法>`", 而逐字节判据只会报"两个编译器
// 不一致")。2026-09-16 再抬到 CG_MAXFN: `use std` 那种 128 个模块的门面单元有 **4048 个
// 顶层函数**, 旧容量下直接段错误。容量由 `test_m85_codegen_table_capacity` 静态钉住,
// 运行时**超了返回 0** (驱动器据此报错退出), 不写穿。
// 常量初值只能用**整数字面量** (语言如此), 所以下面都是算好的数 —— 改容量要重算:
//   CG_FK = CG_FN + CG_MAXFN*12            CG_CUR = CG_FK + CG_MAXFN*8
//   CG_LOCAL = CG_ENUM + CG_MAXENUM*80     CG_PARAM = CG_LOCAL + 4096
//   CG_BYTES = CG_PARAM + CG_MAXFN*80
const CG_FN: u32 = 12288;          // 函数表 (12 B/条: name_tok, ret_tok, ...)
const CG_MAXFN: u32 = 4600;
const CG_FK: u32 = 67488;          // fkind 表 (8 B/条)
const CG_CUR: u32 = 104288;        // 当前函数参数替换表 (256 B)
const CG_ENUM: u32 = 105472;       // 枚举表 (80 B/条)
const CG_MAXENUM: u32 = 320;
const CG_LOCAL: u32 = 131072;      // 局部表 (4 KiB, 每函数清零)
const CG_PARAM: u32 = 135168;      // 每函数形参类型 (80 B/条)
const CG_BYTES: u32 = 503168;      // 整块大小 (驱动器按这个数从 brk 开)
use bytes
use lexer

/// 状态块内的 16B 共享 scratch (只在下一次调用前存活, 不跨调用保留)。
fn scratch_buf(s: ptr) -> ptr {
    return ptr_add(s, 656);
}

fn st_o(s: ptr) -> u32 {
    return load32(s, 0);
}

fn blen(s: ptr, lvl: u32) -> u32 {
    return 8192 + 72 * lvl;
}

fn btxt(s: ptr, lvl: u32) -> u32 {
    return 8196 + 72 * lvl;
}

// ---------------------------------------------------------------- 输出

fn emit_str(s: ptr, out: ptr, text: str) -> u32 {
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < str_len(text) {
        store8(out, o, str_byte(text, i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_mem(s: ptr, out: ptr, buf: ptr, off: u32, len: u32) -> u32 {
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < len {
        store8(out, o, load8(buf, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_dec(s: ptr, out: ptr, v: u32) -> u32 {
    let tmp: ptr = scratch_buf(s);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(tmp, n, (48 + x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(tmp, n - 1 - i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_tok(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    return emit_mem(s, out, src, load32(toks, i * 20 + 4), load32(toks, i * 20 + 8));
}

/// token 原文是否等于 text。
///
/// **字符串字面量不算** (kind 2 直接返回 false): 词法器给字符串 token 的 `val` 是**里面的
/// 内容**(`"impl"` 的原文就是 `impl`), 所以 `tok_is(i, "impl")` 会匹配到源码里的字符串
/// `"impl"` —— 而"用 Loment 写编译器"这件事必然在源码里写出 `"fn"`/`"impl"`/`"trait"`
/// 这类字符串 (关键字表、内建名表), 于是关键字判断全部误触发。M85 后半天实测: 自举
/// codegen 因此把 checker.lomt 里 `chk_tok_is(src,t,i,"impl")` 的字符串当成 impl 块,
/// 之后的函数全被改名成 `<接收者>_<方法>`, 与参考实现逐字节不一致。
/// 参考实现没有这个坑是因为它的 parser 用 `at(kind, val)` 一起判 kind。
pub fn tok_is(src: ptr, toks: ptr, i: u32, text: str) -> bool {
    if load32(toks, i * 20) == 2 {   // string: 只比原文会与关键字/类型名撞车
        return false;
    }
    if load32(toks, i * 20 + 8) != str_len(text) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(text) {
        if load8(src, load32(toks, i * 20 + 4) + k) != str_byte(text, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn tok_kind(toks: ptr, i: u32) -> u32 {
    return load32(toks, i * 20);
}

/// 只占号不写输出 (除法要先占 r 再占 z, 与 lomentc 的 `r = self.t(); z = self.t()` 同序)。
fn alloc_temp(s: ptr) -> u32 {
    let v: u32 = load32(s, 4) + 1;   // lomentc 从 %t1 起编号
    store32(s, 4, v);
    return v;
}

fn emit_temp_ref(s: ptr, out: ptr, n: u32) -> u32 {
    emit_str(s, out, "%t");
    return emit_dec(s, out, n);
}

fn new_temp(s: ptr, out: ptr) -> u32 {
    let v: u32 = alloc_temp(s);
    emit_temp_ref(s, out, v);
    return v;
}

// ---------------------------------------------------------------- 值栈

fn copy_mem(buf: ptr, off: u32, src: ptr, soff: u32, len: u32) {
    let i: u32 = 0;
    while i < len {
        store8(buf, off + i, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

/// 把第 src 层的值复制到第 dst 层。
fn move_val(s: ptr, dst: u32, src: u32) {
    let len: u32 = load32(s, blen(s, src));
    let i: u32 = 0;
    while i < len {
        store8(s, btxt(s, dst) + i, load8(s, btxt(s, src) + i) as u8);
        i = i + 1;
    }
    store32(s, blen(s, dst), len);
}

/// 把"%tN"写进第 lvl 层。
fn set_temp_val(s: ptr, lvl: u32, n: u32) {
    store8(s, btxt(s, lvl), 37 as u8);
    store8(s, btxt(s, lvl) + 1, 116 as u8);
    let tmp: ptr = scratch_buf(s);
    let d: u32 = 0;
    let x: u32 = n;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(s, btxt(s, lvl) + 2 + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), 2 + d);
}

fn emit_val(s: ptr, out: ptr, lvl: u32) -> u32 {
    return emit_mem(s, out, s, btxt(s, lvl), load32(s, blen(s, lvl)));
}

// ---------------------------------------------------------------- 类型

fn emit_ty(s: ptr, out: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    let stt: u32 = subst_tok(s, src, toks, tt);   // 泛型实例: 类型参数 -> 具体类型
    if stt != tt {
        return emit_ty(s, out, src, toks, stt);
    }
    if tt == 4294967295 {   // UNIT: 无 `-> T` 的函数
        return emit_str(s, out, "void");
    }
    if tt == 0 {
        return emit_str(s, out, "i32");
    }
    if tok_is(src, toks, tt, "(") {   // unit 类型 `()`
        return emit_str(s, out, "void");
    }
    if tok_is(src, toks, tt, "bool") || tok_is(src, toks, tt, "true")
        || tok_is(src, toks, tt, "false") {
        return emit_str(s, out, "i1");
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return emit_str(s, out, "i8");
    }
    if tok_is(src, toks, tt, "ptr") {
        return emit_str(s, out, "ptr");
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return emit_str(s, out, "i16");
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return emit_str(s, out, "i32");
    }
    if tok_is(src, toks, tt, "str") {   // M1: 字节指针 + 长度
        return emit_str(s, out, "{ ptr, i64 }");
    }
    if is_slice_tok(src, toks, tt) == 1 {   // M3: 切片 = 元素指针 + 个数
        return emit_str(s, out, "{ ptr, i64 }");
    }
    if is_array_tok(src, toks, tt) == 1 {   // M24: 定长数组
        emit_str(s, out, "[");
        emit_dec(s, out, array_len_of(src, toks, tt));
        emit_str(s, out, " x ");
        emit_ty(s, out, src, toks, elem_tok(src, toks, tt));
        return emit_str(s, out, "]");
    }
    if tok_kind(toks, tt) == 0 {   // struct 名 / 枚举名
        let si: u32 = find_struct(s, src, toks, tt);
        if si != 4294967295 {
            return emit_struct_ty(s, out, src, toks, si);
        }
        let ei: u32 = find_enum(s, src, toks, tt);
        if ei != 4294967295 {
            return emit_enum_ty(s, out, ei);
        }
    }
    return emit_str(s, out, "i64");
}

fn is_signed(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "i8") || tok_is(src, toks, tt, "i16")
        || tok_is(src, toks, tt, "i32") || tok_is(src, toks, tt, "i64") {
        return 1;
    }
    return 0;
}

/// 类型 token 名 (供注释行用): tt==0 时缺省 "u32"。
/// 泛型实例在参考实现里是被 `_rewrite_types` 改名成 `Pair_u32` 的字面串, 这里等价地
/// 按 `基名_实参1_实参2` 折叠 (docs/156 §3: 结构体名与枚举名同样参与改名)。
fn emitted_name(s: ptr, out: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    let stn: u32 = subst_tok(s, src, toks, tt);   // 泛型实例: 注释里也要用具体类型
    if stn != tt {
        return emitted_name(s, out, src, toks, stn);
    }
    if tt == 4294967295 {
        return emit_str(s, out, "()");
    }
    if tt == 0 {
        return emit_str(s, out, "u32");
    }
    if tok_is(src, toks, tt, "(") {   // 注释里 unit 写作 `()`
        return emit_str(s, out, "()");
    }
    if is_slice_tok(src, toks, tt) == 1 {   // 切片的注释形式与源码一致 (`[T]` / `mut [T]`)
        if tok_is(src, toks, tt, "mut") {
            emit_str(s, out, "mut [");
        } else {
            emit_str(s, out, "[");
        }
        emitted_name(s, out, src, toks, elem_tok(src, toks, tt));
        return emit_str(s, out, "]");
    }
    if is_array_tok(src, toks, tt) == 1 {   // M24: 定长数组 -> `[T; N]`
        emit_str(s, out, "[");
        emitted_name(s, out, src, toks, elem_tok(src, toks, tt));
        emit_str(s, out, "; ");
        emit_dec(s, out, array_len_of(src, toks, tt));
        return emit_str(s, out, "]");
    }
    if tok_kind(toks, tt) == 0 && tok_is(src, toks, tt + 1, "<") {
        let si: u32 = find_struct(s, src, toks, tt);
        let ei: u32 = find_enum(s, src, toks, tt);
        if si != 4294967295 || ei != 4294967295 {
            emit_tok(s, out, src, toks, tt);
            emit_str(s, out, "_");
            let a: u32 = tt + 2;
            let r: u32 = emitted_name(s, out, src, toks, a);
            let af: u32 = skip_type(src, toks, a);
            if tok_is(src, toks, af, ",") {
                emit_str(s, out, "_");
                r = emitted_name(s, out, src, toks, af + 1);
            }
            return r;
        }
    }
    return emit_tok(s, out, src, toks, tt);
}

/// `as T` **左操作数**的类型 (apply_cast 的 from 侧专用)。j 必须是那个操作数的 `(`。
/// 不能用 `expr_type`: 对 `(v / 256) as u8` 它问的是**整个转型表达式**的类型 (u8),
/// 而这里要的是括号里那个表达式的类型。括号里可能是二元表达式, 参考实现的
/// `expr_type(Bin) = lt or rt`, 对左结合链展开就是"第一个操作数, 或某个**顶层**
/// 二元运算符右侧的操作数"。括号内的实参 (例如 `load8(tmp, ..)` 里的 `tmp`) 不算 ——
/// 它们属于子表达式, 按 token 逐个看会错误地拿到 `tmp` 的 ptr 类型。
///
/// **紧跟这个 `)` 的 `as` 属于外面那次转型**(apply_cast 正在处理的那次), 这里不吃 ——
/// 与「括号里那个表达式」自己的 `as` 由 `sub_expr_type` 处理。入口这一层必须分开:
/// 两个位置在 token 上长得**一模一样**, 只能靠"谁在调用"区分。
fn operand_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    return operand_bin_type(s, src, toks, j, skip_parens(src, toks, j));
}

/// 子表达式在 j 处的类型 —— 括号透明, 且**认它自己的 `as`**。
/// 少了后半条, `(48 + (x % 10) as u32) as u8` 里那个右操作数会一路钻进括号取到
/// `x` 的类型 (u64), 于是发成 `trunc i64 %t to i8` 而 `%t` 是 `add i32` —— 自相矛盾的
/// IR (docs/189 第 39 条, 自举定点上唯一的分歧点)。
fn sub_expr_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    if tok_is(src, toks, j, "(") {
        let rp: u32 = skip_parens(src, toks, j);
        if tok_is(src, toks, rp + 1, "as") {
            return rp + 2;
        }
        return operand_bin_type(s, src, toks, j, rp);
    }
    return expr_type(s, src, toks, j);
}

/// [j+1, rp) 这一段按参考实现的 `expr_type(Bin) = lt or rt` 取类型: 先取第一个操作数,
/// 为空再取某个**顶层**二元运算符右侧的操作数。操作数一律交给 `sub_expr_type`。
fn operand_bin_type(s: ptr, src: ptr, toks: ptr, j: u32, rp: u32) -> u32 {
    let t: u32 = sub_expr_type(s, src, toks, j + 1);
    if t != 0 {
        return t;
    }
    let k: u32 = j + 1;
    let depth: u32 = 0;
    while k < rp {
        if tok_is(src, toks, k, "(") || tok_is(src, toks, k, "[") {
            depth = depth + 1;
        } else if tok_is(src, toks, k, ")") || tok_is(src, toks, k, "]") {
            depth = depth - 1;
        } else if depth == 0 {
            let c: u32 = op_code(src, toks, k);
            if c != 0 {
                let t2: u32 = sub_expr_type(s, src, toks, k + op_toks(c));
                if t2 != 0 {
                    return t2;
                }
            }
        }
        k = k + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 运算符

/// 运算符编码 (0 = 不是运算符)。
fn op_code(src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "|") {
        if tok_is(src, toks, i + 1, "|") {
            return 1;
        }
        return 17;
    }
    if tok_is(src, toks, i, "&") {
        if tok_is(src, toks, i + 1, "&") {
            return 2;
        }
        return 16;
    }
    if tok_is(src, toks, i, "=") {
        if tok_is(src, toks, i + 1, "=") {
            return 3;
        }
        return 0;
    }
    if tok_is(src, toks, i, "!") {
        if tok_is(src, toks, i + 1, "=") {
            return 4;
        }
        return 0;
    }
    if tok_is(src, toks, i, "<") {
        if tok_is(src, toks, i + 1, "=") {
            return 6;
        }
        if tok_is(src, toks, i + 1, "<") {
            return 9;
        }
        return 5;
    }
    if tok_is(src, toks, i, ">") {
        if tok_is(src, toks, i + 1, "=") {
            return 8;
        }
        if tok_is(src, toks, i + 1, ">") {
            return 10;
        }
        return 7;
    }
    if tok_is(src, toks, i, "+") {
        return 11;
    }
    if tok_is(src, toks, i, "-") {
        return 12;
    }
    if tok_is(src, toks, i, "*") {
        return 13;
    }
    if tok_is(src, toks, i, "/") {
        return 14;
    }
    if tok_is(src, toks, i, "%") {
        return 15;
    }
    if tok_is(src, toks, i, "^") {
        return 18;
    }
    return 0;
}

fn op_prec(c: u32) -> u32 {
    if c == 1 {
        return 1;
    }
    if c == 2 {
        return 2;
    }
    if c == 3 || c == 4 {
        return 3;
    }
    if c >= 5 && c <= 8 {
        return 4;
    }
    if c == 17 {
        return 5;
    }
    if c == 18 {
        return 6;
    }
    if c == 16 {
        return 7;
    }
    if c == 9 || c == 10 {
        return 8;
    }
    if c == 11 || c == 12 {
        return 9;
    }
    if c >= 13 && c <= 15 {
        return 10;
    }
    return 0;
}

fn op_toks(c: u32) -> u32 {
    if c <= 2 || (c >= 3 && c <= 4) || c == 6 || c == 8 || c == 9 || c == 10 {
        return 2;
    }
    return 1;
}

/// 写指令助记符 (比较类带有无符号)。
fn emit_mnemonic(s: ptr, out: ptr, src: ptr, toks: ptr, c: u32, tt: u32) -> u32 {
    let sg: u32 = is_signed(src, toks, tt);
    if c == 3 {
        return emit_str(s, out, "icmp eq");
    }
    if c == 4 {
        return emit_str(s, out, "icmp ne");
    }
    if c == 5 {
        if sg == 1 {
            return emit_str(s, out, "icmp slt");
        }
        return emit_str(s, out, "icmp ult");
    }
    if c == 6 {
        if sg == 1 {
            return emit_str(s, out, "icmp sle");
        }
        return emit_str(s, out, "icmp ule");
    }
    if c == 7 {
        if sg == 1 {
            return emit_str(s, out, "icmp sgt");
        }
        return emit_str(s, out, "icmp ugt");
    }
    if c == 8 {
        if sg == 1 {
            return emit_str(s, out, "icmp sge");
        }
        return emit_str(s, out, "icmp uge");
    }
    if c == 9 {
        return emit_str(s, out, "shl");
    }
    if c == 10 {
        if sg == 1 {
            return emit_str(s, out, "ashr");
        }
        return emit_str(s, out, "lshr");
    }
    if c == 11 {
        return emit_str(s, out, "add");
    }
    if c == 12 {
        return emit_str(s, out, "sub");
    }
    if c == 13 {
        return emit_str(s, out, "mul");
    }
    if c == 16 {
        return emit_str(s, out, "and");
    }
    if c == 17 {
        return emit_str(s, out, "or");
    }
    return emit_str(s, out, "xor");
}

/// 除法/取模助记符 (c: 14=`/`, 15=`%`)。
fn emit_div_mnemonic(s: ptr, out: ptr, src: ptr, toks: ptr, c: u32, tt: u32) -> u32 {
    let sg: u32 = is_signed(src, toks, tt);
    if c == 14 {
        if sg == 1 {
            return emit_str(s, out, "sdiv");
        }
        return emit_str(s, out, "udiv");
    }
    if sg == 1 {
        return emit_str(s, out, "srem");
    }
    return emit_str(s, out, "urem");
}

// ---------------------------------------------------------------- 符号表

fn find_fn(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 640) {
        let base: u32 = CG_FN + i * 12;
        let nt: u32 = load32(s, base);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

fn fn_ret(s: ptr, fi: u32) -> u32 {
    return load32(s, CG_FN + fi * 12 + 4);
}

/// 参数类型 (name_tok -> type_tok; 0 = 未找到)。
fn param_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 12) {
        let nt: u32 = load32(s, CG_CUR + i * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return subst_tok(s, src, toks, load32(s, CG_CUR + i * 8 + 4));
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 表达式类型推断 (镜像 lomentc.expr_type 的标量子集); 0 = 未知。
fn expr_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    if tok_kind(toks, j) == 1 {
        if tok_is(src, toks, j + 1, "as") {   // 字面量的 `as T`
            return j + 2;
        }
        return 0;
    }
    if tok_kind(toks, j) == 0 {
        if tok_is(src, toks, j, "true") || tok_is(src, toks, j, "false") {
            return j;
        }
        if tok_is(src, toks, j + 1, "as") {   // `x as T`
            return j + 2;
        }
        if tok_is(src, toks, j + 1, ".") {   // M23: 字段类型
            let vt: u32 = var_type(s, src, toks, j);
            let si: u32 = find_struct(s, src, toks, vt);
            if si != 4294967295 {
                let fi: u32 = field_index(s, src, toks, si, j + 2);
                if fi != 4294967295 {
                    let vsub: u32 = push_ty_subst(s, src, toks, vt);   // 变量自己的实例化
                    let fr: u32 = field_type(s, src, toks, si, fi);
                    pop_subst(s, vsub);
                    return fr;
                }
            }
            return 0;
        }
        if tok_is(src, toks, j + 1, "(") {   // 调用 (可能带 `as T` 后缀)
            let cp: u32 = skip_parens(src, toks, j + 1);
            if tok_is(src, toks, cp + 1, "as") {
                return cp + 2;
            }
            let fi: u32 = find_fn(s, src, toks, j);
            if fi != 4294967295 {
                return fn_ret(s, fi);
            }
            return 0;
        }
        return var_type(s, src, toks, j);   // 参数或局部 (镜像 expr_type 的 scope)
    }
    if tok_is(src, toks, j, "(") {
        let rp2: u32 = skip_parens(src, toks, j);
        if tok_is(src, toks, rp2 + 1, "as") {
            return rp2 + 2;
        }
        return expr_type(s, src, toks, j + 1);
    }
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        return expr_type(s, src, toks, j + 1);
    }
    return 0;
}

// ---------------------------------------------------------------- 单态化 (M6/M7, docs/156)

/// 类型参数替换表: 计数@16, 表项@24+i*8 (param_tok | value_tok)。
/// 值栈搬到 8192 之后, 状态块的 16..475 是空的, 这里就放在最前面。
fn sub_clear(s: ptr) {
    store32(s, 16, 0);
}

fn sub_push(s: ptr, ptok: u32, vtok: u32) {
    let n: u32 = load32(s, 16);
    store32(s, 24 + n * 8, ptok);
    store32(s, 24 + n * 8 + 4, vtok);
    store32(s, 16, n + 1);
}

/// 若 tt 正好是当前实例的类型参数, 换成具体类型 token (不在表里则原样返回)。
fn subst_tok(s: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return 0;
    }
    let n: u32 = load32(s, 16);
    let i: u32 = 0;
    while i < n {
        if tok_eq(src, toks, load32(s, 24 + i * 8), tt) == 1 {
            return load32(s, 24 + i * 8 + 4);
        }
        i = i + 1;
    }
    return tt;
}

/// 声明处的类型参数 (name_tok 后面紧跟 `<`): 返回 tparam 下标 which 的 token, 无则 0。
/// `fn max<T>` / `struct Pair<T>` / `enum Opt<T>` 都是同一个形状。
fn decl_tparam(src: ptr, toks: ptr, name_tok: u32, which: u32) -> u32 {
    if !tok_is(src, toks, name_tok + 1, "<") {
        return 0;
    }
    if which == 0 {
        return name_tok + 2;
    }
    if which == 1 {
        return name_tok + 4;   // `<T, U>`: `<` T `,` U `>`
    }
    return 0;
}

/// 变量/参数的类型实参 (从其类型 token 后面的 `<...>` 直接读, 无需额外表):
/// `let p: Pair<u32>` -> 类型 token 是 `Pair`, 实参在 `Pair+2`。
fn var_targ(s: ptr, src: ptr, toks: ptr, name_tok: u32, which: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, name_tok);
    if ty == 0 || !tok_is(src, toks, ty + 1, "<") {
        return 0;
    }
    if which == 0 {
        return ty + 2;
    }
    if which == 1 {
        return ty + 4;
    }
    return 0;
}

/// 从"带类型实参的类型标注"推入替换表 (`Pair<u32>` -> Pair 的 tparam <-> u32),
/// 返回推入条数 (调用方据此 pop)。这样实例体内与字段表里的 `T` 都能解析。
fn push_ty_subst(s: ptr, src: ptr, toks: ptr, ty_tok: u32) -> u32 {
    if ty_tok == 0 || !tok_is(src, toks, ty_tok + 1, "<") {
        return 0;
    }
    // 同一个 `Pair` token 在声明处与使用处含义不同: 形参要从**声明**取, 实参从使用处取
    let p1: u32 = 0;
    let p2: u32 = 0;
    let si: u32 = find_struct(s, src, toks, ty_tok);
    if si != 4294967295 {
        p1 = load32(s, struct_base(si) + 72);
        p2 = load32(s, struct_base(si) + 76);
    } else {
        let ei: u32 = find_enum(s, src, toks, ty_tok);
        if ei != 4294967295 {
            p1 = load32(s, enum_base(ei) + 72);
            p2 = load32(s, enum_base(ei) + 76);
        }
    }
    let n: u32 = 0;
    if p1 != 0 {
        sub_push(s, p1, ty_tok + 2);
        n = 1;
    }
    if p2 != 0 && tok_is(src, toks, ty_tok + 3, ",") {
        sub_push(s, p2, ty_tok + 4);
        n = n + 1;
    }
    return n;
}

fn pop_subst(s: ptr, n: u32) {
    store32(s, 16, load32(s, 16) - n);
}

/// 函数表下标 fi 是否来自泛型声明 (声明名后面紧跟 `<`)。
fn is_generic_fn(s: ptr, src: ptr, toks: ptr, fi: u32) -> u32 {
    if fi == 4294967295 {
        return 0;
    }
    if tok_is(src, toks, load32(s, CG_FN + fi * 12) + 1, "<") {
        return 1;
    }
    return 0;
}

/// 实例表: 计数@64, 表项@72+i*12 (fn_tok | t1 | t2) —— 按"首次被用到"的顺序追加。
fn inst_count(s: ptr) -> u32 {
    return load32(s, 64);
}

fn inst_find(s: ptr, src: ptr, toks: ptr, fn_tok: u32, ta: u32, tb: u32) -> u32 {
    let n: u32 = load32(s, 64);
    let i: u32 = 0;
    while i < n {
        let b: u32 = 72 + i * 12;
        if tok_eq(src, toks, load32(s, b), fn_tok) == 1
                && tok_eq(src, toks, load32(s, b + 4), ta) == 1
                && tok_eq(src, toks, load32(s, b + 8), tb) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 登记实例 (已存在则返回既有下标)。
fn inst_add(s: ptr, src: ptr, toks: ptr, fn_tok: u32, ta: u32, tb: u32) -> u32 {
    let got: u32 = inst_find(s, src, toks, fn_tok, ta, tb);
    if got != 4294967295 {
        return got;
    }
    let n: u32 = load32(s, 64);
    store32(s, 72 + n * 12, fn_tok);
    store32(s, 72 + n * 12 + 4, ta);
    store32(s, 72 + n * 12 + 8, tb);
    store32(s, 64, n + 1);
    return n;
}

/// 发射实例的函数名 (不含 `@`): 基名 + "_" + 各类型实参文本。
fn emit_inst_name(s: ptr, out: ptr, src: ptr, toks: ptr, ent: u32) -> u32 {
    let b: u32 = 72 + ent * 12;
    emit_tok(s, out, src, toks, load32(s, b) + 1);   // fn_tok 的下一个 token = 函数名
    emit_str(s, out, "_");
    emit_tok(s, out, src, toks, load32(s, b + 4));
    if load32(s, b + 8) != 0 {
        emit_str(s, out, "_");
        emit_tok(s, out, src, toks, load32(s, b + 8));
    }
    return st_o(s);
}

// ---------------------------------------------------------------- trait/impl 表 (M8)

/// 每个函数槽的附加信息 (与函数表同序): kind | recv_tok
/// kind: 0 = 普通函数, 1 = trait 声明里的方法 (不发射), 2 = impl 方法 (名字 = <recv>_<方法>)
fn fk_base(i: u32) -> u32 {
    return CG_FK + i * 8;
}

/// 按 (接收者类型, 方法名) 找 impl 方法的函数表下标; 未找到返回 4294967295。
fn find_method(s: ptr, src: ptr, toks: ptr, recv_tok: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 640) {
        if load32(s, fk_base(i)) == 2 && tok_eq(src, toks, load32(s, fk_base(i) + 4), recv_tok) == 1 {
            let nt: u32 = load32(s, CG_FN + i * 12);
            if tok_eq(src, toks, nt, name_tok) == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 发射 impl 方法的 LLVM 名 (不含 `@`): <接收者类型名>_<方法名>。
fn emit_method_name(s: ptr, out: ptr, src: ptr, toks: ptr, fi: u32) -> u32 {
    emit_tok(s, out, src, toks, load32(s, fk_base(fi) + 4));
    emit_str(s, out, "_");
    return emit_tok(s, out, src, toks, load32(s, CG_FN + fi * 12));
}

/// 发射变量名 (self -> __self; 其余原样)。所有"名字"位置的输出都要过这里。
fn emit_name_tok(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "self") {
        return emit_str(s, out, "__self");
    }
    return emit_tok(s, out, src, toks, i);
}

/// `?` 的反糖 (lomentc._desugar_try) 会在 IR 里凭空造出 `__t{line}`/`__v{line}`/
/// `__e{line}` 三个局部, 它们没有对应的源码 token。局部表的名字槽因此是两种编码共用
/// 的 u32: 位 31 置位 = 合成名 (值 = 0x80000000 + k*0x1000000 + line, k: 0=t 1=v 2=e),
/// 否则就是普通 token 下标 (真实下标远小于 2^31, 不会撞)。
fn syn_name(k: u32, line: u32) -> u32 {
    return 2147483648 + k * 16777216 + line;
}

fn emit_syn(s: ptr, out: ptr, k: u32, line: u32) -> u32 {
    emit_str(s, out, "__");
    if k == 0 {
        emit_str(s, out, "t");
    } else if k == 1 {
        emit_str(s, out, "v");
    } else {
        emit_str(s, out, "e");
    }
    return emit_dec(s, out, line);
}

/// 发射局部名: 合成名走 emit_syn, 真实 token 走 emit_name_tok。
fn emit_local_name(s: ptr, out: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    if nm >= 2147483648 {
        return emit_syn(s, out, (nm - 2147483648) / 16777216, nm % 16777216);
    }
    return emit_name_tok(s, out, src, toks, nm);
}

// ---------------------------------------------------------------- 枚举表 (M25/M26)

/// 枚举表项基址: name_tok | nvariants | has_payload | pad | 8 × (variant_tok, payload_tok)
fn enum_base(i: u32) -> u32 {
    return CG_ENUM + i * 80;
}

fn find_enum(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 540) {
        let nt: u32 = load32(s, enum_base(i));
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 变体下标 (声明序), 未找到返回 4294967295。
fn enum_variant_index(s: ptr, src: ptr, toks: ptr, ei: u32, vt: u32) -> u32 {
    let n: u32 = load32(s, enum_base(ei) + 4);
    let k: u32 = 0;
    while k < n {
        let nt: u32 = load32(s, enum_base(ei) + 16 + k * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, vt * 20 + 8) {
            let q: u32 = 0;
            let ok: u32 = 1;
            while q < load32(toks, vt * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + q)
                        != load8(src, load32(toks, vt * 20 + 4) + q) {
                    ok = 0;
                }
                q = q + 1;
            }
            if ok == 1 {
                return k;
            }
        }
        k = k + 1;
    }
    return 4294967295;
}

/// 变体载荷类型 token (0 = 无载荷)。
fn enum_payload_type(s: ptr, src: ptr, toks: ptr, ei: u32, k: u32) -> u32 {
    return subst_tok(s, src, toks, load32(s, enum_base(ei) + 16 + k * 8 + 4));
}

/// 枚举的 LLVM 类型: 有载荷 -> `{ i32, i64 }`, 无载荷 -> `i32` (镜像 _ll_type)。
fn emit_enum_ty(s: ptr, out: ptr, ei: u32) -> u32 {
    if load32(s, enum_base(ei) + 8) == 0 {
        return emit_str(s, out, "i32");
    }
    return emit_str(s, out, "{ i32, i64 }");
}

// ---------------------------------------------------------------- struct 表

fn struct_base(i: u32) -> u32 {
    return 1024 + i * 80;
}

/// 按名字找 struct: 返回下标, 未找到返回 4294967295。
fn find_struct(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 520) {
        let nt: u32 = load32(s, struct_base(i));
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 字段下标 (按声明序), 未找到返回 4294967295。
fn field_index(s: ptr, src: ptr, toks: ptr, si: u32, fname: u32) -> u32 {
    let n: u32 = load32(s, struct_base(si) + 4);
    let k: u32 = 0;
    while k < n {
        let nt: u32 = load32(s, struct_base(si) + 8 + k * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, fname * 20 + 8) {
            let q: u32 = 0;
            let ok: u32 = 1;
            while q < load32(toks, fname * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + q)
                        != load8(src, load32(toks, fname * 20 + 4) + q) {
                    ok = 0;
                }
                q = q + 1;
            }
            if ok == 1 {
                return k;
            }
        }
        k = k + 1;
    }
    return 4294967295;
}

fn field_type(s: ptr, src: ptr, toks: ptr, si: u32, k: u32) -> u32 {
    return subst_tok(s, src, toks, load32(s, struct_base(si) + 8 + k * 8 + 4));
}

/// struct 的 LLVM 类型串 (镜像 `_ll_type`: `{ i32, i32 }`)。
fn emit_struct_ty(s: ptr, out: ptr, src: ptr, toks: ptr, si: u32) -> u32 {
    emit_str(s, out, "{ ");
    let n: u32 = load32(s, struct_base(si) + 4);
    let k: u32 = 0;
    while k < n {
        if k > 0 {
            emit_str(s, out, ", ");
        }
        emit_ty(s, out, src, toks, field_type(s, src, toks, si, k));
        k = k + 1;
    }
    return emit_str(s, out, " }");
}

// ---------------------------------------------------------------- 字符串字面量

fn s_gc(s: ptr, inc: u32) -> u32 {
    if inc == 1 {
        store32(s, 524, load32(s, 524) + 1);
    }
    return load32(s, 524);
}

fn emit_hex2(s: ptr, out: ptr, d: u32) -> u32 {
    let o: u32 = st_o(s);
    let c: u32 = 48 + d;
    if d >= 10 {
        c = 55 + d;   // 'A' + (d - 10)
    }
    store8(out, o, c as u8);
    store32(s, 0, o + 1);
    return o + 1;
}

fn emit_hex_byte(s: ptr, out: ptr, b: u32) -> u32 {
    emit_str(s, out, "\\");
    emit_hex2(s, out, b / 16);
    return emit_hex2(s, out, b % 16);
}

/// 字符串字面量的解码后字节数 (span 含引号; 转义表同 lomc._ESCAPES)。
fn str_lit_len(src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let k: u32 = 1;
    let c: u32 = 0;
    while k + 1 < n {
        if load8(src, st + k) == 92 {
            k = k + 2;
        } else {
            k = k + 1;
        }
        c = c + 1;
    }
    return c;
}

/// 按 `\XX` 大写十六进制写出解码后的字节 (与 lomentc 的转义一致)。
fn emit_str_lit_bytes(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let k: u32 = 1;
    while k + 1 < n {
        let b: u32 = load8(src, st + k);
        if b == 92 {
            let e: u32 = load8(src, st + k + 1);
            let d: u32 = e;
            if e == 110 {
                d = 10;
            } else if e == 116 {
                d = 9;
            }
            emit_hex_byte(s, out, d);
            k = k + 2;
        } else {
            emit_hex_byte(s, out, b);
            k = k + 1;
        }
    }
    return k;
}

/// 模块级字符串常量 (位于横幅/运行时/堆全局之后、函数之前)。
/// 顺序 = 逐函数、逐出现 —— 与表达式求值顺序一致 (都是同一 token 流的线性扫描)。
fn emit_str_globals(s: ptr, out: ptr, src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            // 外部函数 (docs/173) **没有函数体** —— 不挡住的话, 找 `{` 的那一圈会一路扫到
            // **下一个函数**的体入口, 于是把别人的字符串常量挂到外部函数名下
            // (实测: `extern fn c_puts(p: ptr) -> i32;` + main 里的 "hello" 生成
            //  `@.str.c_puts.0`, 而参考实现是 `@.str.main.0`)。
            if i > 0 && tok_is(src, toks, i - 1, "extern") {
                i = i + 1;
            } else {
            store32(s, 524, 0);
            let j: u32 = i;
            while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
                j = j + 1;
            }
            j = j + 1;
            let d: u32 = 1;
            while tok_kind(toks, j) != 4 && d > 0 {
                if tok_is(src, toks, j, "{") {
                    d = d + 1;
                }
                if tok_is(src, toks, j, "}") {
                    d = d - 1;
                }
                if d > 0 && tok_kind(toks, j) == 2 {
                    emit_str(s, out, "@.str.");
                    emit_tok(s, out, src, toks, i + 1);
                    emit_str(s, out, ".");
                    emit_dec(s, out, s_gc(s, 0));
                    emit_str(s, out, " = private unnamed_addr constant [");
                    emit_dec(s, out, str_lit_len(src, toks, j));
                    emit_str(s, out, " x i8] c\"");
                    emit_str_lit_bytes(s, out, src, toks, j);
                    emit_str(s, out, "\"\n");
                    s_gc(s, 1);
                }
                j = j + 1;
            }
            i = j;
            }
        } else {
            i = i + 1;
        }
    }
    return st_o(s);
}

/// 函数体内是否存在字符串字面量 (决定要不要写全局段)。
/// 注意只看**函数体内** —— `use "..."` 也是 kind=2, 但它不是字面量。
fn strings_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            // 外部函数没有函数体 —— 同上, 不挡就会把下一个函数的体算成它的 (docs/173)
            if i > 0 && tok_is(src, toks, i - 1, "extern") {
                i = i + 1;
            } else {
            let j: u32 = i;
            while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
                j = j + 1;
            }
            j = j + 1;
            let d: u32 = 1;
            while tok_kind(toks, j) != 4 && d > 0 {
                if tok_is(src, toks, j, "{") {
                    d = d + 1;
                }
                if tok_is(src, toks, j, "}") {
                    d = d - 1;
                }
                if d > 0 && tok_kind(toks, j) == 2 {
                    return 1;
                }
                j = j + 1;
            }
            i = j;
            }
        } else {
            i = i + 1;
        }
    }
    return 0;
}

// ---------------------------------------------------------------- 切片/数组类型

/// 类型 token 是否为切片 `[T]` / `mut [T]`。
fn is_slice_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "[") && !tok_is(src, toks, tt + 2, ";") {   // [T] 不是 [T; N]
        return 1;
    }
    if tok_is(src, toks, tt, "mut") && tok_is(src, toks, tt + 1, "[") {
        return 1;
    }
    return 0;
}

/// 类型 token 是否为定长数组 `[T; N]`。
fn is_array_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "[") && tok_is(src, toks, tt + 2, ";") {
        return 1;
    }
    return 0;
}

/// 切片/数组的元素类型 token。
fn elem_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "mut") {
        return tt + 2;
    }
    return tt + 1;
}

/// 定长数组长度 (字面量); 非数组返回 0。
fn array_len_of(src: ptr, toks: ptr, tt: u32) -> u32 {
    if is_array_tok(src, toks, tt) == 1 {
        return tok_int(src, toks, tt + 3);
    }
    return 0;
}

/// 跳过一个类型 (`T` / `[T]` / `[T; N]` / `mut [T]` / `()`), 返回其后的位置。
fn skip_type(src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "mut") {
        return skip_type(src, toks, i + 1);
    }
    if tok_is(src, toks, i, "[") || tok_is(src, toks, i, "(") {
        let j: u32 = i + 1;
        let d: u32 = 1;
        while tok_kind(toks, j) != 4 && d > 0 {
            if tok_is(src, toks, j, "[") || tok_is(src, toks, j, "(") {
                d = d + 1;
            }
            if tok_is(src, toks, j, "]") || tok_is(src, toks, j, ")") {
                d = d - 1;
            }
            j = j + 1;
        }
        return j;
    }
    let nx: u32 = i + 1;
    if tok_is(src, toks, nx, "<") {   // 泛型实参列表: Pair<u32> / Result<u32, u32>
        let d: u32 = 0;
        let j: u32 = nx;
        while tok_kind(toks, j) != 4 {
            if tok_is(src, toks, j, "<") {
                d = d + 1;
            }
            if tok_is(src, toks, j, ">") {
                d = d - 1;
                if d == 0 {
                    return j + 1;
                }
            }
            j = j + 1;
        }
        return j;
    }
    return nx;
}

// ---------------------------------------------------------------- 能力域 (P4)

/// 域表项基址: name_tok | space_tok | lo | hi | revocable (24B/项, 64 项)
fn cap_base(i: u32) -> u32 {
    return 6144 + i * 24;
}

/// FNV-1a 32 位 (对 space 名 token 的字节) —— 与 lomentc._fnv1a32 同算法。
fn fnv1a_tok(src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let h: u32 = 2166136261;
    let k: u32 = 0;
    while k < n {
        h = h ^ load8(src, st + k);
        h = h * 16777619;
        k = k + 1;
    }
    return h;
}

/// 按名字找能力域: 返回下标, 未找到返回 4294967295。
fn find_cap(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 536) {
        let nt: u32 = load32(s, cap_base(i));
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// `@__loment_caps` 域描述表 (镜像 lomentc 的 P4/M35 行格式)。
fn emit_caps_table(s: ptr, out: ptr, src: ptr, toks: ptr) -> u32 {
    let n: u32 = load32(s, 536);
    emit_str(s, out, "@__loment_caps = internal constant [");
    emit_dec(s, out, n);
    emit_str(s, out, " x { i64, i64, i64, i64 }] [");
    let i: u32 = 0;
    while i < n {
        if i > 0 {
            emit_str(s, out, ", ");
        }
        emit_str(s, out, "{ i64, i64, i64, i64 } { i64 ");
        emit_dec(s, out, fnv1a_tok(src, toks, load32(s, cap_base(i) + 4)));
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, load32(s, cap_base(i) + 8));
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, load32(s, cap_base(i) + 12));
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, load32(s, cap_base(i) + 16));
        emit_str(s, out, " }");
        i = i + 1;
    }
    emit_str(s, out, "]");
    return emit_str(s, out, "
");
}

// ---------------------------------------------------------------- 表达式

fn bit_width(tt: u32, src: ptr, toks: ptr) -> u32 {
    if tok_is(src, toks, tt, "bool") || tok_is(src, toks, tt, "true")
        || tok_is(src, toks, tt, "false") {
        return 1;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return 8;
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return 16;
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return 32;
    }
    return 64;
}

/// `as T` 后缀: 按位宽与符号性选 trunc/sext/zext (与 lomentc 同规则)。
fn apply_cast(s: ptr, out: ptr, src: ptr, toks: ptr, from_t: u32, to_t: u32, lvl: u32) -> u32 {
    // from_t == 0 时按 u32 处理 (镜像 lomentc 的 `st or "u32"`: 打印与位宽都用 i32)
    let sw: u32 = 32;
    if from_t != 0 {
        sw = bit_width(from_t, src, toks);
    }
    let dw: u32 = bit_width(to_t, src, toks);
    if sw == dw && from_t == to_t {
        return 0;   // 同类型: 不加指令
    }
    if sw == dw && !tok_is(src, toks, from_t, "ptr") && !tok_is(src, toks, to_t, "ptr") {
        // 同宽异名 (u64 <-> i64): LLVM 里本来就是同一个类型, 再写 sext/zext 是非法 IR
        // (自举驱动里的 `i64 as u64` 第一次踩到 —— clang 直接报 invalid cast opcode)
        return 0;
    }
    if tok_is(src, toks, from_t, "ptr") {   // M67: 指针转整数
        if tok_is(src, toks, to_t, "u64") || tok_is(src, toks, to_t, "i64") {
            emit_str(s, out, "  ");
            let np: u32 = new_temp(s, out);
            emit_str(s, out, " = ptrtoint ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, " to i64\n");
            set_temp_val(s, lvl, np);
            return 1;
        }
    }
    if tok_is(src, toks, to_t, "ptr") {   // M83: 整数 -> 指针 (brk/mmap 取内存)
        emit_str(s, out, "  ");
        let npi: u32 = new_temp(s, out);
        emit_str(s, out, " = inttoptr ");
        emit_ty(s, out, src, toks, from_t);
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to ptr\n");
        set_temp_val(s, lvl, npi);
        return 1;
    }
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if dw < sw {
        emit_str(s, out, "trunc ");
    } else if is_signed(src, toks, from_t) == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty(s, out, src, toks, from_t);
    emit_str(s, out, " ");
    emit_val(s, out, lvl);
    emit_str(s, out, " to ");
    emit_ty(s, out, src, toks, to_t);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, n);
    return 1;
}

// ---------------------------------------------------------------- 类型名 (内建结果用)

/// 类型 id: 1=u8 2=u16 3=u32 4=u64 5=ptr 6=bool (镜像 _ll_type 的标量+ptr 子集)。
fn ty_width_id(id: u32) -> u32 {
    if id == 1 {
        return 8;
    }
    if id == 2 {
        return 16;
    }
    if id == 3 {
        return 32;
    }
    if id == 4 {
        return 64;
    }
    if id == 6 {
        return 1;
    }
    return 64;   // ptr 与未知
}

fn emit_ty_name(s: ptr, out: ptr, id: u32) -> u32 {
    if id == 1 {
        return emit_str(s, out, "i8");
    }
    if id == 2 {
        return emit_str(s, out, "i16");
    }
    if id == 3 {
        return emit_str(s, out, "i32");
    }
    if id == 4 {
        return emit_str(s, out, "i64");
    }
    if id == 5 {
        return emit_str(s, out, "ptr");
    }
    return emit_str(s, out, "i1");
}

/// 类型 token -> 类型 id (0 = 缺省 u32, 与 lomentc 的 `st or "u32"` 同义)。
fn ty_name_id(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return 3;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return 1;
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return 2;
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return 3;
    }
    if tok_is(src, toks, tt, "u64") || tok_is(src, toks, tt, "i64") {
        return 4;
    }
    if tok_is(src, toks, tt, "ptr") {
        return 5;
    }
    if tok_is(src, toks, tt, "bool") {
        return 6;
    }
    return 3;
}

/// 内建结果上的 `as` 后缀: from 侧是内建固定的类型 (fid/fsg), to 侧是类型 token。
fn apply_cast_b(s: ptr, out: ptr, src: ptr, toks: ptr, fid: u32, fsg: u32, to_tok: u32, lvl: u32) -> u32 {
    let tid: u32 = ty_name_id(src, toks, to_tok);
    if tid == fid {
        return 0;
    }
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if fid == 5 && tid == 4 {              // M67: 指针转整数
        emit_str(s, out, "ptrtoint ptr ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to i64\n");
        set_temp_val(s, lvl, n);
        return 1;
    }
    if tid == 5 && fid >= 1 && fid <= 4 {   // M83: 整数 -> 指针 (brk/mmap 取内存)
        emit_str(s, out, "inttoptr ");
        emit_ty_name(s, out, fid);
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to ptr\n");
        set_temp_val(s, lvl, n);
        return 1;
    }
    if ty_width_id(tid) < ty_width_id(fid) {
        emit_str(s, out, "trunc ");
    } else if fsg == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty_name(s, out, fid);
    emit_str(s, out, " ");
    emit_val(s, out, lvl);
    emit_str(s, out, " to ");
    emit_ty_name(s, out, tid);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, n);
    return 1;
}

/// 求值一个实参 (落到第 lvl 层), 返回其后 token 下标 (跳过尾随逗号)。
fn arg1(s: ptr, out: ptr, src: ptr, toks: ptr, k: u32, lvl: u32) -> u32 {
    let e: u32 = expr_bin(s, out, src, toks, k, 1, lvl);
    let r: u32 = e;
    if tok_is(src, toks, r, ",") {
        r = r + 1;
    }
    return r;
}

/// 整数字面量的十进制文本写进第 lvl 层, 返回位数。
/// 十进制原样 (去前导 0); 十六进制走**长乘 16 加**转十进制 —— 支持 > u32 的字面量
/// (`0x100000000` 这类; lomentc 用 Python 大整数, 这里用十进制数字缓冲 672..704)。
fn set_int_lit(s: ptr, lvl: u32, src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    if !(n >= 2 && load8(src, st) == 48 && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88)) {
        let k: u32 = 0;
        while k + 1 < n && load8(src, st + k) == 48 {
            k = k + 1;
        }
        let c0: u32 = 0;
        while k + c0 < n {
            store8(s, btxt(s, lvl) + c0, load8(src, st + k + c0) as u8);
            c0 = c0 + 1;
        }
        store32(s, blen(s, lvl), c0);
        return c0;
    }
    store8(s, 672, 0 as u8);
    let nd: u32 = 1;
    let k2: u32 = 2;
    while k2 < n {
        let c: u32 = load8(src, st + k2);
        let dv: u32 = 0;
        if c >= 48 && c <= 57 {
            dv = c - 48;
        } else if c >= 97 && c <= 102 {
            dv = c - 87;
        } else if c >= 65 && c <= 70 {
            dv = c - 55;
        }
        let carry: u32 = dv;
        let j: u32 = 0;
        while j < nd {
            let v: u32 = load8(s, 672 + j) * 16 + carry;
            store8(s, 672 + j, (v % 10) as u8);
            carry = v / 10;
            j = j + 1;
        }
        while carry > 0 {
            store8(s, 672 + nd, (carry % 10) as u8);
            carry = carry / 10;
            nd = nd + 1;
        }
        k2 = k2 + 1;
    }
    let q: u32 = 0;
    while q < nd {
        store8(s, btxt(s, lvl) + q, (48 + load8(s, 672 + nd - 1 - q)) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), nd);
    return nd;
}

/// 整数字面量的值 (十进制或 0x 十六进制) —— lomentc 内联的是**十进制**文本。
fn tok_int(src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    if n >= 2 && load8(src, st) == 48 && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        let v: u32 = 0;
        let k: u32 = 2;
        while k < n {
            let c: u32 = load8(src, st + k);
            let d: u32 = 0;
            if c >= 48 && c <= 57 {
                d = c - 48;
            } else if c >= 97 && c <= 102 {
                d = c - 87;
            } else if c >= 65 && c <= 70 {
                d = c - 55;
            }
            v = v * 16 + d;
            k = k + 1;
        }
        return v;
    }
    let r: u32 = 0;
    let j: u32 = 0;
    while j < n {
        r = r * 10 + (load8(src, st + j) - 48);
        j = j + 1;
    }
    return r;
}

/// 把十进制值写进第 lvl 层 (字面量与常量内联共用), 返回位数。
fn set_dec_val(s: ptr, lvl: u32, v: u32) -> u32 {
    let tmp: ptr = scratch_buf(s);
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(s, btxt(s, lvl) + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), d);
    return d;
}

/// 模块级常量查找: 命中返回**值 token** 下标, 否则 0。
/// 形态: [`pub`] `const` NAME `:` TYPE `=` VALUE `;` —— 名字恒在 `const` 之后一个。
fn find_const(src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "const") {
            let nt: u32 = i + 1;
            if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
                let k: u32 = 0;
                let ok: u32 = 1;
                while k < load32(toks, name_tok * 20 + 8) {
                    if load8(src, load32(toks, nt * 20 + 4) + k)
                            != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                        ok = 0;
                    }
                    k = k + 1;
                }
                if ok == 1 {
                    return i + 5;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 原子 + 后缀: 字面量 / 参数 / 括号 / 调用 / `as T`。
/// bump 堆分配: 大小从第 szlvl 层取 (u32), 结果 (ptr) 写到第 lvl 层;
/// 返回分配到的指针的 temp 号。alloc 与 str_concat 共用 (文本与 lomentc.alloc_ir 同序)。
fn emit_alloc_seq(s: ptr, out: ptr, szlvl: u32, lvl: u32) -> u32 {
    emit_str(s, out, "  ");
    let off: u32 = new_temp(s, out);
    emit_str(s, out, " = load i32, ptr @__loment_off\n  ");
    let nxt: u32 = new_temp(s, out);
    emit_str(s, out, " = add i32 %t");
    emit_dec(s, out, off);
    emit_str(s, out, ", ");
    emit_val(s, out, szlvl);
    emit_str(s, out, "\n  ");
    let ok: u32 = new_temp(s, out);
    emit_str(s, out, " = icmp ule i32 %t");
    emit_dec(s, out, nxt);
    emit_str(s, out, ", 65536\n");
    let w: u32 = load32(s, 480) + 1;
    store32(s, 480, w + 1);
    emit_str(s, out, "  br i1 %t");
    emit_dec(s, out, ok);
    emit_str(s, out, ", label ");
    lab_ref(s, out, w, "aok");
    emit_str(s, out, ", label ");
    lab_ref(s, out, w + 1, "aovf");
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    lab_def(s, out, w + 1, "aovf");
    emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
    store32(s, 476, 1);
    lab_def(s, out, w, "aok");
    emit_str(s, out, "  store i32 %t");
    emit_dec(s, out, nxt);
    emit_str(s, out, ", ptr @__loment_off\n  ");
    let p: u32 = new_temp(s, out);
    emit_str(s, out, " = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %t");
    emit_dec(s, out, off);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, p);
    return p;
}

fn expr_atom(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32) -> u32 {
    if tok_kind(toks, j) == 2 {   // 字符串字面量 -> { ptr, i64 }
        let idx: u32 = s_gc(s, 0);
        s_gc(s, 1);
        emit_str(s, out, "  ");
        let sp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds [");
        emit_dec(s, out, str_lit_len(src, toks, j));
        emit_str(s, out, " x i8], ptr @.str.");
        emit_tok(s, out, src, toks, load32(s, 528));
        emit_str(s, out, ".");
        emit_dec(s, out, idx);
        emit_str(s, out, ", i64 0, i64 0\n  ");
        let sv1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
        emit_dec(s, out, sp);
        emit_str(s, out, ", 0\n  ");
        let sv2: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } %t");
        emit_dec(s, out, sv1);
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, str_lit_len(src, toks, j));
        emit_str(s, out, ", 1\n");
        set_temp_val(s, lvl, sv2);
        return j + 1;
    }
    if tok_kind(toks, j) == 1 {
        set_int_lit(s, lvl, src, toks, j);   // 十进制/十六进制都按十进制内联 (支持 > u32)
        let e0: u32 = j + 1;
        if tok_is(src, toks, e0, "as") {
            apply_cast(s, out, src, toks, 0, e0 + 1, lvl);
            return e0 + 2;
        }
        return e0;
    }
    if tok_is(src, toks, j, "(") {
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, lvl);
        let e1: u32 = e + 1;
        if tok_is(src, toks, e1, "as") {
            // from 侧的类型要用**括号里那个表达式**的类型 (`operand_type`), 不是
            // 整个转型表达式的类型 —— 后者在 `(v / 256) as u8` 上会直接给出 u8,
            // 于是 `as u8` 被当成同宽转型整个丢掉 (自举驱动第一次踩到)
            apply_cast(s, out, src, toks, operand_type(s, src, toks, j), e1 + 1, lvl);
            return e1 + 2;
        }
        return e1;
    }
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "(") {
        // 内建降级: load8 / store8 (与 lomentc 的 _Ir.builtin 同形)
        if tok_is(src, toks, j, "load8") {
            let ap: u32 = expr_bin(s, out, src, toks, j + 2, 1, lvl);
            let ao: u32 = expr_bin(s, out, src, toks, ap + 1, 1, lvl + 1);
            emit_str(s, out, "  ");
            let g: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n  ");
            let b8: u32 = new_temp(s, out);
            emit_str(s, out, " = load i8, ptr %t");
            emit_dec(s, out, g);
            emit_str(s, out, "\n  ");
            let z: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 %t");
            emit_dec(s, out, b8);
            emit_str(s, out, " to i32\n");
            set_temp_val(s, lvl, z);
            if tok_is(src, toks, ao + 1, "as") {   // load8(...) as T
                apply_cast(s, out, src, toks, 0, ao + 2, lvl);
                return ao + 3;
            }
            return ao + 1;
        }
        if tok_is(src, toks, j, "store8") {
            let ap2: u32 = expr_bin(s, out, src, toks, j + 2, 1, lvl);
            let ao2: u32 = expr_bin(s, out, src, toks, ap2 + 1, 1, lvl + 1);
            let av: u32 = expr_bin(s, out, src, toks, ao2 + 1, 1, lvl + 2);
            emit_str(s, out, "  ");
            let g2: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n  store i8 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, g2);
            emit_str(s, out, "\n");
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return av + 1;
        }
        if tok_is(src, toks, j, "alloc") {   // M15: bump 分配器
            let k1: u32 = arg1(s, out, src, toks, j + 2, lvl);
            emit_alloc_seq(s, out, lvl, lvl);
            if tok_is(src, toks, k1 + 1, "as") {
                apply_cast_b(s, out, src, toks, 5, 0, k1 + 2, lvl);
                return k1 + 3;
            }
            return k1 + 1;
        }
        if tok_is(src, toks, j, "free") {
            let k2: u32 = arg1(s, out, src, toks, j + 2, lvl);
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return k2 + 1;
        }
        if tok_is(src, toks, j, "atomic_add") {   // M21
            let k3: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k4: u32 = arg1(s, out, src, toks, k3, lvl + 1);
            emit_str(s, out, "  ");
            let at: u32 = new_temp(s, out);
            emit_str(s, out, " = atomicrmw add ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " seq_cst\n");
            set_temp_val(s, lvl, at);
            if tok_is(src, toks, k4 + 1, "as") {
                apply_cast_b(s, out, src, toks, 3, 0, k4 + 2, lvl);
                return k4 + 3;
            }
            return k4 + 1;
        }
        if tok_is(src, toks, j, "ptr_add") || tok_is(src, toks, j, "ptr_sub") {   // M73
            let sub: u32 = tok_is(src, toks, j, "ptr_sub") as u32;
            let k5: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k6: u32 = arg1(s, out, src, toks, k5, lvl + 1);
            emit_str(s, out, "  ");
            let n64: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i64\n");
            let use: u32 = n64;
            if sub == 1 {
                emit_str(s, out, "  ");
                let nn: u32 = new_temp(s, out);
                emit_str(s, out, " = sub i64 0, %t");
                emit_dec(s, out, n64);
                emit_str(s, out, "\n");
                use = nn;
            }
            emit_str(s, out, "  ");
            let pe: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, use);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, pe);
            if tok_is(src, toks, k6 + 1, "as") {
                apply_cast_b(s, out, src, toks, 5, 0, k6 + 2, lvl);
                return k6 + 3;
            }
            return k6 + 1;
        }
        if tok_is(src, toks, j, "get_bits") || tok_is(src, toks, j, "set_bits") {   // M22
            let setb: u32 = tok_is(src, toks, j, "set_bits") as u32;
            let k7: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k8: u32 = arg1(s, out, src, toks, k7, lvl + 1);
            let k9: u32 = arg1(s, out, src, toks, k8, lvl + 2);
            emit_str(s, out, "  ");
            let one: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 1 to i16\n  ");
            let w16: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i32 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, " to i16\n  ");
            let shl: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i16 %t");
            emit_dec(s, out, one);
            emit_str(s, out, ", %t");
            emit_dec(s, out, w16);
            emit_str(s, out, "\n  ");
            let sb2: u32 = new_temp(s, out);
            emit_str(s, out, " = sub i16 %t");
            emit_dec(s, out, shl);
            emit_str(s, out, ", 1\n  ");
            let mask: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i16 %t");
            emit_dec(s, out, sb2);
            emit_str(s, out, " to i8\n");
            // set_bits 的第 4 个实参在掩码之后求值 (与 lomentc 同序)
            let k10: u32 = k9;
            if setb == 1 {
                k10 = arg1(s, out, src, toks, k9, lvl + 3);
            }
            emit_str(s, out, "  ");
            let nsh: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i8\n");
            if setb == 0 {
                emit_str(s, out, "  ");
                let shr: u32 = new_temp(s, out);
                emit_str(s, out, " = lshr i8 ");
                emit_val(s, out, lvl);
                emit_str(s, out, ", %t");
                emit_dec(s, out, nsh);
                emit_str(s, out, "\n  ");
                let gr: u32 = new_temp(s, out);
                emit_str(s, out, " = and i8 %t");
                emit_dec(s, out, shr);
                emit_str(s, out, ", %t");
                emit_dec(s, out, mask);
                emit_str(s, out, "\n");
                set_temp_val(s, lvl, gr);
                if tok_is(src, toks, k10 + 1, "as") {
                    apply_cast_b(s, out, src, toks, 1, 0, k10 + 2, lvl);
                    return k10 + 3;
                }
                return k10 + 1;
            }
            emit_str(s, out, "  ");
            let shm: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i8 %t");
            emit_dec(s, out, mask);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nsh);
            emit_str(s, out, "\n  ");
            let nm: u32 = new_temp(s, out);
            emit_str(s, out, " = xor i8 %t");
            emit_dec(s, out, shm);
            emit_str(s, out, ", -1\n  ");
            let cl: u32 = new_temp(s, out);
            emit_str(s, out, " = and i8 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nm);
            emit_str(s, out, "\n  ");
            let msk: u32 = new_temp(s, out);
            emit_str(s, out, " = and i8 ");
            emit_val(s, out, lvl + 3);
            emit_str(s, out, ", %t");
            emit_dec(s, out, mask);
            emit_str(s, out, "\n  ");
            let sh: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i8 %t");
            emit_dec(s, out, msk);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nsh);
            emit_str(s, out, "\n  ");
            let sr: u32 = new_temp(s, out);
            emit_str(s, out, " = or i8 %t");
            emit_dec(s, out, cl);
            emit_str(s, out, ", %t");
            emit_dec(s, out, sh);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, sr);
            if tok_is(src, toks, k10 + 1, "as") {
                apply_cast_b(s, out, src, toks, 1, 0, k10 + 2, lvl);
                return k10 + 3;
            }
            return k10 + 1;
        }
        if tok_is(src, toks, j, "panic") {   // M19: 求值后不可继续
            let k11: u32 = arg1(s, out, src, toks, j + 2, lvl);
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            let dl: u32 = load32(s, 480) + 1;
            store32(s, 480, dl);
            lab_def(s, out, dl, "dead");
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return k11 + 1;
        }
        if tok_is(src, toks, j, "str_len") || tok_is(src, toks, j, "str_ptr") {   // M1/M67
            let k12: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let want_ptr: u32 = tok_is(src, toks, j, "str_ptr") as u32;
            let fid12: u32 = 3;                    // str_len -> u32
            if want_ptr == 1 {
                fid12 = 5;                         // str_ptr -> ptr
            }
            emit_str(s, out, "  ");
            let ex: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            if want_ptr == 1 {
                emit_str(s, out, ", 0\n");
                set_temp_val(s, lvl, ex);
            } else {
                emit_str(s, out, ", 1\n  ");
                let tr: u32 = new_temp(s, out);
                emit_str(s, out, " = trunc i64 %t");
                emit_dec(s, out, ex);
                emit_str(s, out, " to i32\n");
                set_temp_val(s, lvl, tr);
            }
            if tok_is(src, toks, k12 + 1, "as") {   // 只在真写了 `as` 时转换
                apply_cast_b(s, out, src, toks, fid12, 0, k12 + 2, lvl);
                return k12 + 3;
            }
            return k12 + 1;
        }
        if tok_is(src, toks, j, "str_byte") {   // 字节指针 + 下标
            // 顺序同 lomentc: 取指针 (extractvalue 0) 落在**第 2 个实参之前**
            let k13: u32 = arg1(s, out, src, toks, j + 2, lvl);
            emit_str(s, out, "  ");
            let bp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0\n");
            let k14: u32 = arg1(s, out, src, toks, k13, lvl + 1);
            emit_str(s, out, "  ");
            let bg: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds i8, ptr %t");
            emit_dec(s, out, bp);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n  ");
            let bb: u32 = new_temp(s, out);
            emit_str(s, out, " = load i8, ptr %t");
            emit_dec(s, out, bg);
            emit_str(s, out, "\n  ");
            let bz: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 %t");
            emit_dec(s, out, bb);
            emit_str(s, out, " to i32\n");
            set_temp_val(s, lvl, bz);
            if tok_is(src, toks, k14 + 1, "as") {
                apply_cast_b(s, out, src, toks, 3, 0, k14 + 2, lvl);
                return k14 + 3;
            }
            return k14 + 1;
        }
        if tok_is(src, toks, j, "str_concat") {   // M2: 两个实参先求值, 再拼到 bump 堆
            let c1: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let c2: u32 = arg1(s, out, src, toks, c1, lvl + 1);
            emit_str(s, out, "  ");
            let ap: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0\n  ");
            let al: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 1\n  ");
            let bp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0\n  ");
            let bl: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1\n  ");
            let nn: u32 = new_temp(s, out);
            emit_str(s, out, " = add i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ", %t");
            emit_dec(s, out, bl);
            emit_str(s, out, "\n  ");
            let nu: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i64 %t");
            emit_dec(s, out, nn);
            emit_str(s, out, " to i32\n");
            set_temp_val(s, lvl + 2, nu);          // 堆计数是 u32
            let cp: u32 = emit_alloc_seq(s, out, lvl + 2, lvl);
            emit_str(s, out, "  call void @__loment_memcpy(ptr %t");
            emit_dec(s, out, cp);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, ap);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ")\n  ");
            let cg: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr %t");
            emit_dec(s, out, cp);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, "\n  call void @__loment_memcpy(ptr %t");
            emit_dec(s, out, cg);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, bp);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, bl);
            emit_str(s, out, ")\n  ");
            let cv1: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
            emit_dec(s, out, cp);
            emit_str(s, out, ", 0\n  ");
            let cv2: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue { ptr, i64 } %t");
            emit_dec(s, out, cv1);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, nn);
            emit_str(s, out, ", 1\n");
            set_temp_val(s, lvl, cv2);
            if tok_is(src, toks, c2 + 1, "as") {
                apply_cast(s, out, src, toks, 0, c2 + 2, lvl);
                return c2 + 3;
            }
            return c2 + 1;
        }
        if tok_is(src, toks, j, "str_eq") {   // 先比长度再 memcmp (bool + phi)
            let k15: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k16: u32 = arg1(s, out, src, toks, k15, lvl + 1);
            let ap: u32 = alloc_temp(s);
            let al: u32 = alloc_temp(s);
            let bp: u32 = alloc_temp(s);
            let bl: u32 = alloc_temp(s);
            let le: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, ap);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0
  %t");
            emit_dec(s, out, al);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 1
  %t");
            emit_dec(s, out, bp);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0
  %t");
            emit_dec(s, out, bl);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1
  %t");
            emit_dec(s, out, le);
            emit_str(s, out, " = icmp eq i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ", %t");
            emit_dec(s, out, bl);
            emit_str(s, out, "
");
            let wq: u32 = load32(s, 480) + 1;
            store32(s, 480, wq + 2);
            emit_str(s, out, "  br i1 %t");
            emit_dec(s, out, le);
            emit_str(s, out, ", label ");
            lab_ref(s, out, wq, "seq");
            emit_str(s, out, ", label ");
            lab_ref(s, out, wq + 1, "sneq");
            emit_str(s, out, "
");
            store32(s, 476, 1);
            lab_def(s, out, wq, "seq");
            let mc: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, mc);
            emit_str(s, out, " = call i32 @__loment_memcmp(ptr %t");
            emit_dec(s, out, ap);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, bp);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ")
");
            let zq: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, zq);
            emit_str(s, out, " = icmp eq i32 %t");
            emit_dec(s, out, mc);
            emit_str(s, out, ", 0
");
            jump(s, out, wq + 2, "send");
            lab_def(s, out, wq + 1, "sneq");
            jump(s, out, wq + 2, "send");
            lab_def(s, out, wq + 2, "send");
            let rq: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, rq);
            emit_str(s, out, " = phi i1 [ %t");
            emit_dec(s, out, zq);
            emit_str(s, out, ", ");
            lab_ref(s, out, wq, "seq");
            emit_str(s, out, " ], [ false, ");
            lab_ref(s, out, wq + 1, "sneq");
            emit_str(s, out, " ]
");
            set_temp_val(s, lvl, rq);
            if tok_is(src, toks, k16 + 1, "as") {
                apply_cast_b(s, out, src, toks, 6, 0, k16 + 2, lvl);
                return k16 + 3;
            }
            return k16 + 1;
        }
        if tok_is(src, toks, j, "syscall4") || tok_is(src, toks, j, "syscall6") {   // M67/M72
            let n6: u32 = tok_is(src, toks, j, "syscall6") as u32;
            let na: u32 = 4;
            if n6 == 1 {
                na = 6;
            }
            let ka: u32 = j + 2;
            let a0: u32 = 0;
            while a0 < na {
                ka = arg1(s, out, src, toks, ka, lvl + 1 + a0);
                a0 = a0 + 1;
            }
            emit_str(s, out, "  ");
            let sc: u32 = new_temp(s, out);
            emit_str(s, out, " = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx}");
            if n6 == 1 {
                emit_str(s, out, ",{r10},{r8}");
            }
            emit_str(s, out, ",~{cx},~{r11},~{memory}\"(");
            let b0: u32 = 0;
            while b0 < na {
                if b0 > 0 {
                    emit_str(s, out, ", ");
                }
                emit_str(s, out, "i64 ");
                emit_val(s, out, lvl + 1 + b0);
                b0 = b0 + 1;
            }
            emit_str(s, out, ")
");
            set_temp_val(s, lvl, sc);
            return ka;
        }
        if tok_is(src, toks, j, "slice_len") {   // M3: 切片取长度 (数组用字面量长度)
            let k18: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let at: u32 = expr_type(s, src, toks, j + 2);
            emit_str(s, out, "  ");
            if is_slice_tok(src, toks, at) == 1 {
                let exs: u32 = new_temp(s, out);
                emit_str(s, out, " = extractvalue { ptr, i64 } ");
                emit_val(s, out, lvl);
                emit_str(s, out, ", 1\n  ");
                let trs: u32 = new_temp(s, out);
                emit_str(s, out, " = trunc i64 %t");
                emit_dec(s, out, exs);
                emit_str(s, out, " to i32\n");
                set_temp_val(s, lvl, trs);
            } else {
                let tra: u32 = new_temp(s, out);
                emit_str(s, out, " = trunc i64 ");
                emit_dec(s, out, array_len_of(src, toks, at));
                emit_str(s, out, " to i32\n");
                set_temp_val(s, lvl, tra);
            }
            if tok_is(src, toks, k18 + 1, "as") {
                apply_cast_b(s, out, src, toks, 3, 0, k18 + 2, lvl);
                return k18 + 3;
            }
            return k18 + 1;
        }
        // 调用: 先算每个实参 (值落到更深的层), 再写 call 行
        let fi: u32 = find_fn(s, src, toks, j);
        let ret: u32 = 0;
        if fi != 4294967295 {
            ret = fn_ret(s, fi);
        }
        let gen: u32 = is_generic_fn(s, src, toks, fi);
        let gent: u32 = 0;
        let gsub: u32 = 0;
        if gen == 1 {
            // 类型实参由第一个实参的类型推出 (与 lomentc 的 scope 推导同义)
            let it1: u32 = expr_type(s, src, toks, j + 2);
            gent = inst_add(s, src, toks, load32(s, CG_FN + fi * 12) - 1, it1, 0);
            let gp1: u32 = decl_tparam(src, toks, load32(s, CG_FN + fi * 12), 0);
            if gp1 != 0 {
                sub_push(s, gp1, load32(s, 72 + gent * 12 + 4));
                gsub = 1;
            }
        }
        let k: u32 = j + 2;
        let a: u32 = 0;
        while !tok_is(src, toks, k, ")") && tok_kind(toks, k) != 4 && a < 10 {
            // 实参按"形参类型"强制 (与 lomentc 的 expr(a, p.type) 同序同型)
            let ft: u32 = 0;
            if fi != 4294967295 {
                ft = load32(s, CG_PARAM + fi * 80 + a * 8 + 4);
            }
            let at: u32 = ft;
            let ae: u32 = expr_bin(s, out, src, toks, k, 1, lvl + 1 + a);
            // 实参类型槽按**值栈层**索引: 嵌套调用的实参不能覆盖外层已记好的槽
            store32(s, 720 + (lvl + 1 + a) * 4, at);
            k = ae;
            if tok_is(src, toks, k, ",") {
                k = k + 1;
            }
            a = a + 1;
        }
        // 上限 10 是**实参类型槽列表**的宽度 (形参表步长 80 = 10 槽 x 8 字节, 见
        // 参数表注释: 加宽会撞上 40960 的枚举表)。超了就**响亮地失败**: 以前这里只是
        // 循环退出 -> 后面 11 个实参里最后一个被静默丢掉 (IR 少一个实参), 参考实现却
        // 照发 —— 逐字节判据把它抓成"两个编译器不一致", 但定位成本高。M85 后半天抓到。
        if a == 10 && !tok_is(src, toks, k, ")") {
            panic(10);
        }
        emit_str(s, out, "  ");
        let unit: u32 = is_unit_tok(src, toks, ret);   // unit 返回: 不占寄存器
        let n: u32 = 0;
        if unit == 0 {
            n = new_temp(s, out);
            emit_str(s, out, " = ");
        }
        emit_str(s, out, "call ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " @");
        if gen == 1 {
            emit_inst_name(s, out, src, toks, gent);
        } else {
            emit_tok(s, out, src, toks, j);
        }
        emit_str(s, out, "(");
        let b: u32 = 0;
        while b < a {
            if b > 0 {
                emit_str(s, out, ", ");
            }
            let at2: u32 = load32(s, 720 + (lvl + 1 + b) * 4);
            emit_ty(s, out, src, toks, at2);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1 + b);
            b = b + 1;
        }
        emit_str(s, out, ")\n");
        if unit == 1 {
            store32(s, blen(s, lvl), 0);   // () 类型的值为空串
        } else {
            set_temp_val(s, lvl, n);
        }
        pop_subst(s, gsub);
        let ec: u32 = k + 1;
        if tok_is(src, toks, ec, "as") {   // 调用结果上的 as
            apply_cast(s, out, src, toks, ret, ec + 1, lvl);
            return ec + 2;
        }
        return ec;
    }
    // 布尔字面量: 值就是字面量 1 / 0 (不是变量 load)
    if tok_kind(toks, j) == 0 && (tok_is(src, toks, j, "true") || tok_is(src, toks, j, "false")) {
        if tok_is(src, toks, j, "true") {
            store8(s, btxt(s, lvl), 49 as u8);
        } else {
            store8(s, btxt(s, lvl), 48 as u8);
        }
        store32(s, blen(s, lvl), 1);
        return j + 1;
    }
    // 枚举路径 / 构造: E::V 与 E::V(expr)  (M25)
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, ":")
            && tok_is(src, toks, j + 2, ":") {
        let ei: u32 = find_enum(s, src, toks, j);
        let vi: u32 = 4294967295;
        let pt: u32 = 0;
        if ei != 4294967295 {
            vi = enum_variant_index(s, src, toks, ei, j + 3);
            if vi != 4294967295 {
                pt = enum_payload_type(s, src, toks, ei, vi);
            }
        }
        if pt == 0 || !tok_is(src, toks, j + 4, "(") {
            // 无载荷变体: 无载荷枚举 -> 字面量下标; 带载荷枚举 -> 只写 tag
            if load32(s, enum_base(ei) + 8) == 0 {
                set_dec_val(s, lvl, vi);
                return j + 4;
            }
            emit_str(s, out, "  ");
            let a0: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue ");
            emit_enum_ty(s, out, ei);
            emit_str(s, out, " undef, i32 ");
            emit_dec(s, out, vi);
            emit_str(s, out, ", 0\n");
            set_temp_val(s, lvl, a0);
            return j + 4;
        }
        // 带载荷构造: 求值实参 -> insertvalue tag -> (必要时 sext/zext) -> insertvalue 载荷
        let av: u32 = expr_bin(s, out, src, toks, j + 5, 1, lvl + 1);
        emit_str(s, out, "  ");
        let a1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue ");
        emit_enum_ty(s, out, ei);
        emit_str(s, out, " undef, i32 ");
        emit_dec(s, out, vi);
        emit_str(s, out, ", 0\n");
        if bit_width(pt, src, toks) >= 64 {
            emit_str(s, out, "  ");
            let b1: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue ");
            emit_enum_ty(s, out, ei);
            emit_str(s, out, " %t");
            emit_dec(s, out, a1);
            emit_str(s, out, ", i64 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1\n");
            set_temp_val(s, lvl, b1);
        } else {
            emit_str(s, out, "  ");
            let c1: u32 = new_temp(s, out);
            emit_str(s, out, " = ");
            if is_signed(src, toks, pt) == 1 {
                emit_str(s, out, "sext ");
            } else {
                emit_str(s, out, "zext ");
            }
            emit_ty(s, out, src, toks, pt);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i64\n  ");
            let b2: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue ");
            emit_enum_ty(s, out, ei);
            emit_str(s, out, " %t");
            emit_dec(s, out, a1);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, c1);
            emit_str(s, out, ", 1\n");
            set_temp_val(s, lvl, b2);
        }
        let ev: u32 = av + 1;
        if tok_is(src, toks, ev, "as") {
            apply_cast(s, out, src, toks, 0, ev + 1, lvl);
            return ev + 2;
        }
        return ev;
    }
    // 模块级常量: 生成期内联成十进制字面量 (优先于变量查找, 与 lomentc 同序)
    let cvt: u32 = find_const(src, toks, j);
    if cvt != 0 {
        set_int_lit(s, lvl, src, toks, cvt);
        let ce: u32 = j + 1;
        if tok_is(src, toks, ce, "as") {
            apply_cast(s, out, src, toks, 0, ce + 1, lvl);
            return ce + 2;
        }
        return ce;
    }
    // 变量 (参数或局部): load
    let ty: u32 = var_type(s, src, toks, j);
    let dot: u32 = j + 1;
    if tok_is(src, toks, dot, "[") && is_slice_tok(src, toks, ty) == 1 {
        // M3: 切片下标 xs[i] -> extractvalue 0 + GEP(元素) + load
        let et: u32 = elem_tok(src, toks, ty);
        load_var(s, out, src, toks, j, lvl);
        emit_str(s, out, "  ");
        let sp: u32 = new_temp(s, out);
        emit_str(s, out, " = extractvalue { ptr, i64 } ");
        emit_val(s, out, lvl);
        emit_str(s, out, ", 0\n");
        let iv: u32 = expr_bin(s, out, src, toks, dot + 1, 1, lvl + 1);
        emit_str(s, out, "  ");
        let g: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, sp);
        emit_str(s, out, ", i32 ");
        emit_val(s, out, lvl + 1);
        emit_str(s, out, "\n  ");
        let rl: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, g);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rl);
        let ie: u32 = iv + 1;   // ']' 之后
        if tok_is(src, toks, ie, "as") {
            apply_cast(s, out, src, toks, et, ie + 1, lvl);
            return ie + 2;
        }
        return ie;
    }
    if tok_is(src, toks, dot, "[") && is_array_tok(src, toks, ty) == 1 {
        // M24: 数组下标 a[i] -> GEP(数组, 0, i) + load
        let et2: u32 = elem_tok(src, toks, ty);
        let iv2: u32 = expr_bin(s, out, src, toks, dot + 1, 1, lvl);
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_val(s, out, lvl);
        emit_str(s, out, "\n  ");
        let rl2: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et2);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rl2);
        let ie2: u32 = iv2 + 1;
        if tok_is(src, toks, ie2, "as") {
            apply_cast(s, out, src, toks, et2, ie2 + 1, lvl);
            return ie2 + 2;
        }
        return ie2;
    }
    if tok_kind(toks, j) == 0 && tok_is(src, toks, dot, ".") && tok_is(src, toks, dot + 2, "(") {
        // M8: 方法调用 x.m(args) -> 编译期解析为 <接收者类型>_m(x, args)
        let mfi: u32 = find_method(s, src, toks, ty, dot + 1);
        load_var(s, out, src, toks, j, lvl);   // 接收者按第一形参类型求值
        let km: u32 = dot + 3;
        let am: u32 = 0;
        while !tok_is(src, toks, km, ")") && tok_kind(toks, km) != 4 && am < 9 {
            let ft2: u32 = load32(s, CG_PARAM + mfi * 80 + (am + 1) * 8 + 4);
            let ae2: u32 = expr_bin(s, out, src, toks, km, 1, lvl + 1 + am);
            store32(s, 720 + (lvl + 1 + am) * 4, ft2);
            km = ae2;
            if tok_is(src, toks, km, ",") {
                km = km + 1;
            }
            am = am + 1;
        }
        emit_str(s, out, "  ");
        let rm: u32 = new_temp(s, out);
        emit_str(s, out, " = call ");
        emit_ty(s, out, src, toks, fn_ret(s, mfi));
        emit_str(s, out, " @");
        emit_method_name(s, out, src, toks, mfi);
        emit_str(s, out, "(");
        emit_ty(s, out, src, toks, load32(s, CG_PARAM + mfi * 80 + 4));
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        let bm: u32 = 0;
        while bm < am {
            emit_str(s, out, ", ");
            emit_ty(s, out, src, toks, load32(s, 720 + (lvl + 1 + bm) * 4));
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1 + bm);
            bm = bm + 1;
        }
        emit_str(s, out, ")\n");
        set_temp_val(s, lvl, rm);
        let me: u32 = km + 1;
        if tok_is(src, toks, me, "as") {
            apply_cast(s, out, src, toks, fn_ret(s, mfi), me + 1, lvl);
            return me + 2;
        }
        return me;
    }
    if tok_is(src, toks, dot, ".") {   // M23: 字段访问 p.a -> GEP + load
        let si: u32 = find_struct(s, src, toks, ty);
        let fi: u32 = field_index(s, src, toks, si, dot + 1);
        let ft: u32 = field_type(s, src, toks, si, fi);
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, fi);
        emit_str(s, out, "\n  ");
        let rv: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, ft);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rv);
        let fe: u32 = dot + 2;
        if tok_is(src, toks, fe, "as") {
            apply_cast(s, out, src, toks, ft, fe + 1, lvl);
            return fe + 2;
        }
        return fe;
    }
    emit_str(s, out, "  ");
    let n2: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, j);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n2);
    let e9: u32 = j + 1;
    if tok_is(src, toks, e9, "as") {
        apply_cast(s, out, src, toks, ty, e9 + 1, lvl);
        return e9 + 2;
    }
    return e9;
}

/// 一元: -x (sub ty 0, v) / !b (xor i1 v, true) / &a / &mut a (数组 -> 切片)
fn expr_unary(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32, want: u32) -> u32 {
    if tok_is(src, toks, j, "&") {   // M3/M4: 数组 -> 切片 (元素指针 + 个数)
        let nm: u32 = j + 1;
        if tok_is(src, toks, nm, "mut") {
            nm = nm + 1;
        }
        let ty: u32 = var_type(s, src, toks, nm);
        emit_str(s, out, "  ");
        let p0: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, nm);
        emit_str(s, out, ".addr, i32 0, i32 0\n  ");
        let v1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
        emit_dec(s, out, p0);
        emit_str(s, out, ", 0\n  ");
        let v2: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } %t");
        emit_dec(s, out, v1);
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, array_len_of(src, toks, ty));
        emit_str(s, out, ", 1\n");
        set_temp_val(s, lvl, v2);
        return nm + 1;
    }
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        let neg: u32 = tok_is(src, toks, j, "-") as u32;
        let inner: u32 = expr_unary(s, out, src, toks, j + 1, lvl, want);
        let tt: u32 = expr_type(s, src, toks, j + 1);
        emit_str(s, out, "  ");
        let n: u32 = new_temp(s, out);
        if neg == 1 {
            emit_str(s, out, " = sub ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " 0, ");
            emit_val(s, out, lvl);
        } else {
            emit_str(s, out, " = xor i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", true");
        }
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, n);
        return inner;
    }
    return expr_atom(s, out, src, toks, j, lvl);
}

/// 二元 (优先级爬升): 结果落到第 lvl 层。
fn expr_bin(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, minp: u32, lvl: u32) -> u32 {
    let e: u32 = expr_unary(s, out, src, toks, j, lvl, 0);
    let i: u32 = e;
    let go: u32 = 1;
    while go == 1 {
        let c: u32 = op_code(src, toks, i);
        if c == 0 || op_prec(c) < minp {
            go = 0;
        } else if c == 1 || c == 2 {
            // 短路 (phi): 左值已在第 lvl 层; 右操作数只在需要时求值
            let b2: u32 = load32(s, 480) + 1;
            store32(s, 480, b2 + 2);
            emit_str(s, out, "  br i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", label ");
            if c == 2 {                    // &&
                lab_ref(s, out, b2, "sc_rhs");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2 + 1, "sc_short");
            } else {                       // ||
                lab_ref(s, out, b2 + 1, "sc_short");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2, "sc_rhs");
            }
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, b2, "sc_rhs");
            let r2: u32 = expr_bin(s, out, src, toks, i + 2, op_prec(c) + 1, lvl + 1);
            store32(s, 500, load32(s, 488));   // 右操作数结束时的块 = phi 前驱
            store32(s, 504, load32(s, 496));
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 1, "sc_short");
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 2, "sc_end");
            emit_str(s, out, "  ");
            let n2: u32 = new_temp(s, out);
            emit_str(s, out, " = phi i1 [ ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", ");
            ref_from(s, out, load32(s, 500), load32(s, 504));
            emit_str(s, out, " ], [ ");
            if c == 2 {
                emit_str(s, out, "false");
            } else {
                emit_str(s, out, "true");
            }
            emit_str(s, out, ", ");
            lab_ref(s, out, b2 + 1, "sc_short");
            emit_str(s, out, " ]\n");
            set_temp_val(s, lvl, n2);
            i = r2;
        } else if c == 14 || c == 15 {
            // 除法/取模: 除零 = 运行时 trap (M18); 同时点亮运行时文本块
            let r3: u32 = expr_bin(s, out, src, toks, i + 1, op_prec(c) + 1, lvl + 1);
            let lt3: u32 = expr_type(s, src, toks, j);
            let rt3: u32 = expr_type(s, src, toks, i + 1);
            let tt3: u32 = lt3;
            if tt3 == 0 {
                tt3 = rt3;
            }
            let n3: u32 = alloc_temp(s);   // lomentc 先占 r 再占 z
            let z3: u32 = alloc_temp(s);
            let w3: u32 = load32(s, 480) + 1;
            store32(s, 480, w3 + 2);
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, z3);
            emit_str(s, out, " = icmp eq ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0\n  br i1 %t");
            emit_dec(s, out, z3);
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3 + 1, "dtrap");
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3, "dok");
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, w3 + 1, "dtrap");
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            lab_def(s, out, w3, "dok");
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, n3);
            emit_str(s, out, " = ");
            emit_div_mnemonic(s, out, src, toks, c, tt3);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            jump(s, out, w3 + 2, "dend");
            lab_def(s, out, w3 + 2, "dend");
            set_temp_val(s, lvl, n3);
            i = r3;
        } else {
            let np: u32 = op_prec(c) + 1;
            let r: u32 = expr_bin(s, out, src, toks, i + op_toks(c), np, lvl + 1);
            let lt: u32 = expr_type(s, src, toks, j);
            let rt: u32 = expr_type(s, src, toks, i + op_toks(c));
            let tt: u32 = lt;
            if tt == 0 {
                tt = rt;
            }
            emit_str(s, out, "  ");
            let n: u32 = new_temp(s, out);
            emit_str(s, out, " = ");
            emit_mnemonic(s, out, src, toks, c, tt);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, n);
            i = r;
        }
    }
    return i;
}

// ---------------------------------------------------------------- 函数与模块

fn find_body(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j + 1;
}

fn find_paren(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "(") && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j;
}

fn skip_parens(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 返回类型 token: 需要 `-` `>` 才算有显式返回类型, 否则为 UNIT (哨兵 0xFFFFFFFF)。
fn fn_ret_tok(src: ptr, toks: ptr, rp: u32) -> u32 {
    if tok_is(src, toks, rp + 1, "-") && tok_is(src, toks, rp + 2, ">") {
        return rp + 3;
    }
    return 4294967295;
}

/// 是否 unit 返回 (`-> ()` 或省略返回类型)。
fn is_unit_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 4294967295 {
        return 1;
    }
    return tok_is(src, toks, tt, "(") as u32;
}

fn emit_fn(s: ptr, out: ptr, src: ptr, toks: ptr, base: u32) -> u32 {
    let lp: u32 = find_paren(src, toks, base + 2);
    let rp: u32 = skip_parens(src, toks, lp);
    let ret: u32 = fn_ret_tok(src, toks, rp);
    let fkind: u32 = load32(s, fk_base(load32(s, 472)));   // 0=普通 1=trait 声明 2=impl 方法
    let k: u32 = 0;
    let i: u32 = lp + 1;
    while i < rp && k < 16 {
        store32(s, CG_CUR + k * 8, i);
        store32(s, CG_CUR + k * 8 + 4, i + 2);
        if fkind == 2 && k == 0 {   // impl 的 self: 类型 = 接收者类型
            store32(s, CG_CUR + k * 8 + 4, load32(s, fk_base(load32(s, 472)) + 4));
        }
        k = k + 1;
        i = skip_type(src, toks, i + 2);   // 类型可能是 [T] / [T; N]
        if tok_is(src, toks, i, ",") {
            i = i + 1;
        }
    }
    store32(s, 12, k);
    store32(s, 528, base + 1);   // 当前函数名 token (字符串全局命名用)
    store32(s, 552, ret);        // 当前函数返回类型 token (match 臂体里 return 用)
    store32(s, 524, 0);          // 字符串全局序号随函数复位
    let body_at: u32 = find_body(src, toks, lp);
    let nl: u32 = collect_locals(s, src, toks, body_at, skip_block(src, toks, body_at - 1));
    if tok_is(src, toks, base - 1, "interrupt") {   // M33: x86_intrcc 需要中断帧指针, 无参数
        emit_str(s, out, "; ");
        emit_tok(s, out, src, toks, base + 1);
        emit_str(s, out, " -> interrupt (x86_intrcc)\n");
        emit_str(s, out, "define x86_intrcc void @");
        emit_tok(s, out, src, toks, base + 1);
        emit_str(s, out, "(ptr byval([8 x i8]) %__frame) {\nentry:\n");
        let bi: u32 = 0;
        while bi < nl {
            emit_str(s, out, "  %");
            emit_local_name(s, out, src, toks, load32(s, CG_LOCAL + bi * 8));
            emit_str(s, out, ".addr = alloca ");
            emit_ty(s, out, src, toks, load32(s, CG_LOCAL + bi * 8 + 4));
            emit_str(s, out, "\n");
            bi = bi + 1;
        }
        let jj: u32 = find_body(src, toks, lp);
        while tok_kind(toks, jj) != 4 {
            if tok_is(src, toks, jj, "}") {
                if load32(s, 476) == 0 {
                    emit_str(s, out, "  ret void\n");
                }
                emit_str(s, out, "}\n");
                return jj + 1;
            }
            jj = stmt(s, out, src, toks, jj, ret);
        }
        return jj;
    }
    emit_str(s, out, "; ");
    if load32(s, 60) != 4294967295 {          // 泛型实例: 名字 = 基名_实参
        emit_inst_name(s, out, src, toks, load32(s, 60));
    } else if fkind == 2 {                    // impl 方法: 注释也用 mangled 名
        emit_method_name(s, out, src, toks, load32(s, 472));
    } else {
        emit_tok(s, out, src, toks, base + 1);
    }
    emit_str(s, out, " -> ");
    emitted_name(s, out, src, toks, ret);   // 注释用 Loment 类型名
    emit_str(s, out, "\n");
    emit_str(s, out, "define ");
    emit_ty(s, out, src, toks, ret);
    emit_str(s, out, " @");
    if load32(s, 60) != 4294967295 {          // 泛型实例
        emit_inst_name(s, out, src, toks, load32(s, 60));
    } else if fkind == 2 {                    // impl 方法: 名字 = <接收者类型>_<方法>
        emit_method_name(s, out, src, toks, load32(s, 472));
    } else {
        emit_tok(s, out, src, toks, base + 1);
    }
    emit_str(s, out, "(");
    let a: u32 = 0;
    while a < k {
        if a > 0 {
            emit_str(s, out, ", ");
        }
        let sa: u32 = push_ty_subst(s, src, toks, load32(s, CG_CUR + a * 8 + 4));
        emit_ty(s, out, src, toks, load32(s, CG_CUR + a * 8 + 4));
        pop_subst(s, sa);
        emit_str(s, out, " %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + a * 8));
        a = a + 1;
    }
    emit_str(s, out, ") {\nentry:\n");
    let b: u32 = 0;
    while b < k {
        emit_str(s, out, "  %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + b * 8));
        emit_str(s, out, ".addr = alloca ");
        let sb: u32 = push_ty_subst(s, src, toks, load32(s, CG_CUR + b * 8 + 4));
        emit_ty(s, out, src, toks, load32(s, CG_CUR + b * 8 + 4));
        pop_subst(s, sb);
        emit_str(s, out, "\n");
        b = b + 1;
    }
    let bl: u32 = 0;   // 局部变量 alloca (紧随参数之后)
    while bl < nl {
        emit_str(s, out, "  %");
        emit_local_name(s, out, src, toks, load32(s, CG_LOCAL + bl * 8));
        emit_str(s, out, ".addr = alloca ");
        let sl: u32 = push_ty_subst(s, src, toks, load32(s, CG_LOCAL + bl * 8 + 4));
        emit_ty(s, out, src, toks, load32(s, CG_LOCAL + bl * 8 + 4));
        pop_subst(s, sl);
        emit_str(s, out, "\n");
        bl = bl + 1;
    }
    let c: u32 = 0;
    while c < k {
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, load32(s, CG_CUR + c * 8 + 4));
        emit_str(s, out, " %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + c * 8));
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + c * 8));
        emit_str(s, out, ".addr\n");
        c = c + 1;
    }
    let j: u32 = find_body(src, toks, lp);
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "}") {
            if load32(s, 476) == 0 {   // 块未终止: unit 函数补 ret void, 其余补 unreachable
                if is_unit_tok(src, toks, ret) == 1 {
                    emit_str(s, out, "  ret void\n");
                } else {
                    emit_str(s, out, "  unreachable\n");
                }
            }
            emit_str(s, out, "}\n");
            return j + 1;
        }
        j = stmt(s, out, src, toks, j, ret);
    }
    return j;
}

// ---------------------------------------------------------------- 语句

fn lab_def(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    store32(s, 476, 0);           // terminated = false
    store32(s, 488, n);           // 当前标签 (phi 前驱用)
    store32(s, 496, tag_id(tag));
    emit_str(s, out, "L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    emit_str(s, out, tag);
    return emit_str(s, out, ":\n");
}

fn tag_id(tag: str) -> u32 {
    if str_eq(tag, "then") {
        return 1;
    }
    if str_eq(tag, "else") {
        return 2;
    }
    if str_eq(tag, "end") {
        return 3;
    }
    if str_eq(tag, "wcond") {
        return 4;
    }
    if str_eq(tag, "wbody") {
        return 5;
    }
    if str_eq(tag, "wend") {
        return 6;
    }
    if str_eq(tag, "sc_rhs") {
        return 7;
    }
    if str_eq(tag, "sc_short") {
        return 8;
    }
    if str_eq(tag, "fcond") {
        return 10;
    }
    if str_eq(tag, "fbody") {
        return 11;
    }
    if str_eq(tag, "fend") {
        return 12;
    }
    if str_eq(tag, "dok") {
        return 13;
    }
    if str_eq(tag, "dtrap") {
        return 14;
    }
    if str_eq(tag, "dend") {
        return 15;
    }
    if str_eq(tag, "aok") {
        return 16;
    }
    if str_eq(tag, "aovf") {
        return 17;
    }
    if str_eq(tag, "dead") {
        return 18;
    }
    if str_eq(tag, "gok") {
        return 22;
    }
    if str_eq(tag, "gtrap") {
        return 23;
    }
    if str_eq(tag, "seq") {      // str_eq 的三块 (M2 才发现: 它们也会当 phi 前驱)
        return 19;
    }
    if str_eq(tag, "sneq") {
        return 20;
    }
    if str_eq(tag, "send") {
        return 21;
    }
    if str_eq(tag, "mend") {     // match 的两块 (同理: `&&` 的右操作数里可以是 match)
        return 24;
    }
    if str_eq(tag, "mwild") {
        return 25;
    }
    return 9;   // sc_end
}

fn tag_name(id: u32) -> str {
    if id == 1 {
        return "then";
    }
    if id == 2 {
        return "else";
    }
    if id == 3 {
        return "end";
    }
    if id == 4 {
        return "wcond";
    }
    if id == 5 {
        return "wbody";
    }
    if id == 6 {
        return "wend";
    }
    if id == 7 {
        return "sc_rhs";
    }
    if id == 8 {
        return "sc_short";
    }
    if id == 10 {
        return "fcond";
    }
    if id == 11 {
        return "fbody";
    }
    if id == 12 {
        return "fend";
    }
    if id == 13 {
        return "dok";
    }
    if id == 14 {
        return "dtrap";
    }
    if id == 15 {
        return "dend";
    }
    if id == 16 {
        return "aok";
    }
    if id == 17 {
        return "aovf";
    }
    if id == 18 {
        return "dead";
    }
    if id == 22 {
        return "gok";
    }
    if id == 23 {
        return "gtrap";
    }
    if id == 19 {
        return "seq";
    }
    if id == 20 {
        return "sneq";
    }
    if id == 21 {
        return "send";
    }
    if id == 24 {
        return "mend";
    }
    if id == 25 {
        return "mwild";
    }
    return "sc_end";
}

/// 保存/还原当前标签 (phi 前驱)。
fn ref_from(s: ptr, out: ptr, n: u32, id: u32) -> u32 {
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag_name(id));
}

/// 当前标签引用: 0 = entry (隐式首块), 否则 %L{n}_{当前 tag 由调用方传入}
fn cur_ref(s: ptr, out: ptr, tag: str) -> u32 {
    let n: u32 = load32(s, 488);
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag);
}

fn lab_ref(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    emit_str(s, out, "%L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    return emit_str(s, out, tag);
}

/// 未终止才写 br; 随后置 terminated。
fn jump(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    let r: u32 = 0;
    if load32(s, 476) == 0 {
        emit_str(s, out, "  br label ");
        r = lab_ref(s, out, n, tag);
        emit_str(s, out, "\n");
    }
    store32(s, 476, 1);
    return r;
}

/// 变量类型: 参数 -> 局部; 0 = 未知。
fn var_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let t: u32 = param_type(s, src, toks, name_tok);
    if t != 0 {
        return t;
    }
    let i: u32 = 0;
    while i < load32(s, 484) {
        let nt: u32 = load32(s, CG_LOCAL + i * 8);
        // nt 可能是合成名 (位 31 置位), 那种槽位不能当下标去读 token 缓冲
        if nt < 2147483648 && load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return subst_tok(s, src, toks, load32(s, CG_LOCAL + i * 8 + 4));
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 变量值加载到第 lvl 层 (load <ty>, ptr %name.addr)。
fn load_var(s: ptr, out: ptr, src: ptr, toks: ptr, name_tok: u32, lvl: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, name_tok);
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name_tok);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n);
    return n;
}

/// `let x: T = e?;` 的发射 —— 等价于 lomentc._desugar_try 的反糖产物:
///   let __t{line}: <rt> = e;   let x: T;
///   match __t{line} { Ok(__v{line}) => { x = __v{line}; }  Err(__e{line}) => { return Err(__e{line}); } }
/// 标签与临时编号都按同一顺序占号, 所以直发即可 (不重建 AST)。
fn emit_try_let(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, eq: u32, lt: u32) -> u32 {
    let ln: u32 = load32(toks, lt * 20 + 12);
    let rtt: u32 = expr_type(s, src, toks, eq + 1);
    let rsub: u32 = push_ty_subst(s, src, toks, rtt);
    let e2: u32 = expr_bin(s, out, src, toks, eq + 1, 1, 0);
    emit_str(s, out, "  store ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, " ");
    emit_val(s, out, 0);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 0, ln);
    emit_str(s, out, ".addr\n");
    emit_str(s, out, "  ");
    let sv: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 0, ln);
    emit_str(s, out, ".addr\n");
    let ei: u32 = find_enum(s, src, toks, rtt);
    let mend: u32 = load32(s, 480) + 1;
    store32(s, 480, mend);
    let lok: u32 = load32(s, 480) + 1;
    store32(s, 480, lok);
    let lerr: u32 = load32(s, 480) + 1;
    store32(s, 480, lerr);
    emit_str(s, out, "  ");
    let tag: u32 = new_temp(s, out);
    emit_str(s, out, " = extractvalue { i32, i64 } %t");
    emit_dec(s, out, sv);
    emit_str(s, out, ", 0\n");
    emit_str(s, out, "  switch i32 %t");
    emit_dec(s, out, tag);
    emit_str(s, out, ", label %L");
    emit_dec(s, out, mend);
    emit_str(s, out, "_mend [\n      i32 0, label %L");
    emit_dec(s, out, lok);
    emit_str(s, out, "_mOk\n      i32 1, label %L");
    emit_dec(s, out, lerr);
    emit_str(s, out, "_mErr\n    ]\n");
    store32(s, 476, 1);
    // Ok 臂: 绑定载荷到 __v{line}, 臂体是 `x = __v{line}`
    store32(s, 476, 0);
    store32(s, 488, lok);
    store32(s, 496, 0);
    emit_str(s, out, "L");
    emit_dec(s, out, lok);
    emit_str(s, out, "_mOk:\n");
    let psub: u32 = push_ty_subst(s, src, toks, rtt);
    let okp: u32 = enum_payload_type(s, src, toks, ei, 0);
    let raw: u32 = alloc_temp(s);
    emit_str(s, out, "  %t");
    emit_dec(s, out, raw);
    emit_str(s, out, " = extractvalue { i32, i64 } %t");
    emit_dec(s, out, sv);
    emit_str(s, out, ", 1\n");
    if bit_width(okp, src, toks) >= 64 {
        emit_str(s, out, "  store i64 %t");
        emit_dec(s, out, raw);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 1, ln);
        emit_str(s, out, ".addr\n");
    } else {
        let cv: u32 = alloc_temp(s);
        emit_str(s, out, "  %t");
        emit_dec(s, out, cv);
        emit_str(s, out, " = trunc i64 %t");
        emit_dec(s, out, raw);
        emit_str(s, out, " to ");
        emit_ty(s, out, src, toks, okp);
        emit_str(s, out, "\n  store ");
        emit_ty(s, out, src, toks, okp);
        emit_str(s, out, " %t");
        emit_dec(s, out, cv);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 1, ln);
        emit_str(s, out, ".addr\n");
    }
    pop_subst(s, psub);
    emit_str(s, out, "  ");
    let lv: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, okp);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 1, ln);
    emit_str(s, out, ".addr\n  store ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, " %t");
    emit_dec(s, out, lv);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name);
    emit_str(s, out, ".addr\n");
    jump(s, out, mend, "mend");
    // Err 臂: 绑定载荷到 __e{line}, 臂体是 `return Err(__e{line})`
    store32(s, 476, 0);
    store32(s, 488, lerr);
    store32(s, 496, 0);
    emit_str(s, out, "L");
    emit_dec(s, out, lerr);
    emit_str(s, out, "_mErr:\n");
    let esub: u32 = push_ty_subst(s, src, toks, rtt);
    let errp: u32 = enum_payload_type(s, src, toks, ei, 1);
    let eraw: u32 = alloc_temp(s);
    emit_str(s, out, "  %t");
    emit_dec(s, out, eraw);
    emit_str(s, out, " = extractvalue { i32, i64 } %t");
    emit_dec(s, out, sv);
    emit_str(s, out, ", 1\n");
    if bit_width(errp, src, toks) >= 64 {
        emit_str(s, out, "  store i64 %t");
        emit_dec(s, out, eraw);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 2, ln);
        emit_str(s, out, ".addr\n");
    } else {
        let ecv: u32 = alloc_temp(s);
        emit_str(s, out, "  %t");
        emit_dec(s, out, ecv);
        emit_str(s, out, " = trunc i64 %t");
        emit_dec(s, out, eraw);
        emit_str(s, out, " to ");
        emit_ty(s, out, src, toks, errp);
        emit_str(s, out, "\n  store ");
        emit_ty(s, out, src, toks, errp);
        emit_str(s, out, " %t");
        emit_dec(s, out, ecv);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 2, ln);
        emit_str(s, out, ".addr\n");
    }
    pop_subst(s, esub);
    emit_str(s, out, "  ");
    let elv: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, errp);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 2, ln);
    emit_str(s, out, ".addr\n  ");
    let a1: u32 = new_temp(s, out);
    emit_str(s, out, " = insertvalue ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, " undef, i32 1, 0\n  ");
    let c1: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if is_signed(src, toks, errp) == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty(s, out, src, toks, errp);
    emit_str(s, out, " %t");
    emit_dec(s, out, elv);
    emit_str(s, out, " to i64\n  ");
    let b1: u32 = new_temp(s, out);
    emit_str(s, out, " = insertvalue ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, " %t");
    emit_dec(s, out, a1);
    emit_str(s, out, ", i64 %t");
    emit_dec(s, out, c1);
    emit_str(s, out, ", 1\n  ret ");
    emit_ty(s, out, src, toks, load32(s, 552));
    emit_str(s, out, " %t");
    emit_dec(s, out, b1);
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    jump(s, out, mend, "mend");
    lab_def(s, out, mend, "mend");
    pop_subst(s, rsub);
    return eq;
}

/// 一条语句; 返回下一个待处理 token 下标。
fn stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    if tok_is(src, toks, j, "return") {
        // `return Result::Ok(v)` 里的枚举名是**泛型基名**, 实例要靠函数返回类型解析
        // (镜像 lomentc._fix_generic_literals 对 Return 分支做的 e.expr.enum = f.ret)。
        // 非泛型返回类型时 push_ty_subst 直接返回 0 —— 无副作用。
        let rsub: u32 = push_ty_subst(s, src, toks, ret);
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        pop_subst(s, rsub);
        emit_str(s, out, "  ret ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " ");
        // 返回 ptr 而表达式就是字面量 0 时, lomentc 写 `null` (expr 的 want="ptr")
        if tok_is(src, toks, ret, "ptr") && tok_kind(toks, j + 1) == 1
                && tok_int(src, toks, j + 1) == 0 && e == j + 2 {
            emit_str(s, out, "null");
        } else {
            emit_val(s, out, 0);
        }
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        return e + 1;
    }
    if tok_is(src, toks, j, "let") {
        let name: u32 = j + 1;
        let ty: u32 = j + 3;
        let eq: u32 = skip_type(src, toks, ty);   // '=' 的位置 (类型可能是 [T; N] / [T])
        // M9: `let x: T = e?;` -> 临时绑定 + match (Err 早退); 替换表由 emit_try_let 自己管
        let qp: u32 = find_try_q(src, toks, eq + 1);
        if qp != 0 {
            emit_try_let(s, out, src, toks, name, ty, eq, j);
            return qp + 2;
        }
        // `let p: Pair<u32>` 的类型实参: 先推入替换, 再处理右侧 (字面量分支也要在表内)
        let lsub: u32 = push_ty_subst(s, src, toks, ty);
        if is_array_tok(src, toks, ty) == 1 && tok_is(src, toks, eq + 1, "[") {
            let arr_e: u32 = let_array_lit(s, out, src, toks, name, ty, eq + 1);
            pop_subst(s, lsub);
            return arr_e;
        }
        if tok_eq(src, toks, eq + 1, ty) && tok_is(src, toks, eq + 2, "{") {   // struct 字面量
            let st_e: u32 = let_struct_lit(s, out, src, toks, name, ty, eq + 2);
            pop_subst(s, lsub);
            return st_e;
        }
        let e2: u32 = expr_bin(s, out, src, toks, eq + 1, 1, 0);
        pop_subst(s, lsub);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr\n");
        return e2 + 1;
    }
    if tok_is(src, toks, j, "if") && tok_is(src, toks, j + 1, "let") {
        // M10: `if let Enum::V(bind) = e { then } else { other }`。
        // lomentc 在 parser 里就把它反糖成 `Match(e, [(V(bind), then), (None, other)])`,
        // 这里等价地直发那份 Match 的 IR: 标签序 = mend, 命中臂, 通配臂。
        let iv: u32 = j + 5;
        let ib: u32 = j + 7;
        let subj: u32 = j + 10;
        let st: u32 = expr_type(s, src, toks, subj);
        let ei: u32 = find_enum(s, src, toks, st);
        let mend: u32 = load32(s, 480) + 1;
        store32(s, 480, mend);
        let md: u32 = load32(s, 548);
        store32(s, 548, md + 1);
        let slvl: u32 = 30 + md * 2;
        expr_bin(s, out, src, toks, subj, 1, 0);
        move_val(s, slvl, 0);
        let pay: u32 = load32(s, enum_base(ei) + 8);
        let tagt: u32 = 0;
        if pay == 1 {
            emit_str(s, out, "  ");
            tagt = new_temp(s, out);
            emit_str(s, out, " = extractvalue { i32, i64 } ");
            emit_val(s, out, slvl);
            emit_str(s, out, ", 0\n");
        }
        let lok: u32 = load32(s, 480) + 1;
        store32(s, 480, lok);
        let lwd: u32 = load32(s, 480) + 1;
        store32(s, 480, lwd);
        let vi: u32 = enum_variant_index(s, src, toks, ei, iv);
        emit_str(s, out, "  switch i32 ");
        if pay == 1 {
            emit_str(s, out, "%t");
            emit_dec(s, out, tagt);
        } else {
            emit_val(s, out, slvl);
        }
        emit_str(s, out, ", label %L");
        emit_dec(s, out, lwd);
        emit_str(s, out, "_mwild [\n      i32 ");
        emit_dec(s, out, vi);
        emit_str(s, out, ", label %L");
        emit_dec(s, out, lok);
        emit_str(s, out, "_m");
        emit_tok(s, out, src, toks, iv);
        emit_str(s, out, "\n    ]\n");
        store32(s, 476, 1);
        // 命中臂
        store32(s, 476, 0);
        store32(s, 488, lok);
        store32(s, 496, 0);
        emit_str(s, out, "L");
        emit_dec(s, out, lok);
        emit_str(s, out, "_m");
        emit_tok(s, out, src, toks, iv);
        emit_str(s, out, ":\n");
        if tok_is(src, toks, j + 6, "(") {   // 载荷绑定
            let pstub: u32 = push_ty_subst(s, src, toks, st);
            let pt3: u32 = enum_payload_type(s, src, toks, ei, vi);
            let raw: u32 = alloc_temp(s);   // new_temp 会自己写 %tN, 这里手写
            emit_str(s, out, "  %t");
            emit_dec(s, out, raw);
            emit_str(s, out, " = extractvalue { i32, i64 } ");
            emit_val(s, out, slvl);
            emit_str(s, out, ", 1\n");
            if bit_width(pt3, src, toks) >= 64 {
                emit_str(s, out, "  store i64 %t");
                emit_dec(s, out, raw);
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, ib);
                emit_str(s, out, ".addr\n");
            } else {
                let cv: u32 = alloc_temp(s);
                emit_str(s, out, "  %t");
                emit_dec(s, out, cv);
                emit_str(s, out, " = trunc i64 %t");
                emit_dec(s, out, raw);
                emit_str(s, out, " to ");
                emit_ty(s, out, src, toks, pt3);
                emit_str(s, out, "\n  store ");
                emit_ty(s, out, src, toks, pt3);
                emit_str(s, out, " %t");
                emit_dec(s, out, cv);
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, ib);
                emit_str(s, out, ".addr\n");
            }
            pop_subst(s, pstub);
        }
        let tend: u32 = skip_block(src, toks, find_body(src, toks, subj) - 1);
        let k3: u32 = find_body(src, toks, subj);
        while k3 < tend - 1 && !tok_is(src, toks, k3, "}") && tok_kind(toks, k3) != 4 {
            k3 = stmt(s, out, src, toks, k3, load32(s, 552));
        }
        jump(s, out, mend, "mend");
        lab_def(s, out, lwd, "mwild");
        let nxt: u32 = tend;
        if tok_is(src, toks, nxt, "else") {
            let ebody: u32 = find_body(src, toks, nxt + 1);
            let eend: u32 = skip_block(src, toks, ebody - 1);
            let k4: u32 = ebody;
            while k4 < eend - 1 && !tok_is(src, toks, k4, "}") && tok_kind(toks, k4) != 4 {
                k4 = stmt(s, out, src, toks, k4, load32(s, 552));
            }
            nxt = eend;
        }
        jump(s, out, mend, "mend");
        lab_def(s, out, mend, "mend");
        store32(s, 548, md);
        return nxt;
    }
    if tok_is(src, toks, j, "if") {
        // 先算条件再占标签: 条件里的 `&&`/除法会自己占标签 (与 lomentc 的 If 同序)
        let e3: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        let base_l: u32 = load32(s, 480) + 1;   // lomentc 从 L1 起编号
        store32(s, 480, base_l + 2);
        emit_str(s, out, "  br i1 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", label ");
        lab_ref(s, out, base_l, "then");
        emit_str(s, out, ", label ");
        lab_ref(s, out, base_l + 1, "else");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, base_l, "then");
        let k: u32 = e3 + 1;   // '{' 之后的第一条语句
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        k = k + 1;
        jump(s, out, base_l + 2, "end");
        lab_def(s, out, base_l + 1, "else");
        if tok_is(src, toks, k, "else") {
            k = k + 1;
            if tok_is(src, toks, k, "if") {
                k = stmt(s, out, src, toks, k, ret);
            } else {
                k = k + 1;   // '{'
                while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
                    k = stmt(s, out, src, toks, k, ret);
                }
                k = k + 1;
            }
        }
        jump(s, out, base_l + 2, "end");
        lab_def(s, out, base_l + 2, "end");
        return k;
    }
    if tok_is(src, toks, j, "for") {   // for i in lo..hi { ... }
        let var_tok: u32 = j + 1;
        let le: u32 = j + 3;                       // lo 起始 (跳过 'for' 变量 'in')
        let loe: u32 = expr_bin(s, out, src, toks, le, 1, 0);
        let ty: u32 = var_type(s, src, toks, var_tok);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        let hi_start: u32 = loe + 2;               // 跳过 '..'
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "fcond");
        lab_def(s, out, w, "fcond");
        load_var(s, out, src, toks, var_tok, 0);
        let he: u32 = expr_bin(s, out, src, toks, hi_start, 1, 1);
        emit_str(s, out, "  ");
        let cn: u32 = new_temp(s, out);
        emit_str(s, out, " = icmp ");
        if is_signed(src, toks, ty) == 1 {
            emit_str(s, out, "slt ");
        } else {
            emit_str(s, out, "ult ");
        }
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ");
        emit_val(s, out, 1);
        emit_str(s, out, "\n  br i1 %t");
        emit_dec(s, out, cn);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "fbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "fend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "fbody");
        let k: u32 = he + 1;                       // '{' 之后
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        load_var(s, out, src, toks, var_tok, 0);
        emit_str(s, out, "  ");
        let nx: u32 = new_temp(s, out);
        emit_str(s, out, " = add ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", 1\n  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " %t");
        emit_dec(s, out, nx);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        jump(s, out, w, "fcond");
        lab_def(s, out, w + 2, "fend");
        return k + 1;
    }
    if tok_is(src, toks, j, "while") {
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "wcond");
        lab_def(s, out, w, "wcond");
        let e4: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        emit_str(s, out, "  br i1 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "wbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "wend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "wbody");
        let m: u32 = e4 + 1;   // '{' 之后的第一条语句
        while !tok_is(src, toks, m, "}") && tok_kind(toks, m) != 4 {
            m = stmt(s, out, src, toks, m, ret);
        }
        jump(s, out, w, "wcond");
        lab_def(s, out, w + 2, "wend");
        return m + 1;
    }
    if tok_is(src, toks, j, "match") {   // M26: switch + 载荷绑定
        let st: u32 = expr_type(s, src, toks, j + 1);
        let ei: u32 = find_enum(s, src, toks, st);
        let mend: u32 = load32(s, 480) + 1;
        store32(s, 480, mend);
        let md: u32 = load32(s, 548);
        store32(s, 548, md + 1);
        let slvl: u32 = 30 + md * 2;      // 主体值的稳定槽 (嵌套 match 不互相踩)
        expr_bin(s, out, src, toks, j + 1, 1, 0);
        move_val(s, slvl, 0);
        let pay: u32 = load32(s, enum_base(ei) + 8);
        let tagt: u32 = 0;
        if pay == 1 {
            emit_str(s, out, "  ");
            tagt = new_temp(s, out);
            emit_str(s, out, " = extractvalue { i32, i64 } ");
            emit_val(s, out, slvl);
            emit_str(s, out, ", 0\n");
        }
        let stop: u32 = skip_block(src, toks, j + 2);
        // 第一遍: 按臂序占标签 (通配臂占号时机与 lomentc 一致), 记在 560+i*4
        let wild: u32 = mend;
        let arms: u32 = 0;
        let k: u32 = j + 3;   // '{' 之后才是第一个臂头
        while k < stop && !tok_is(src, toks, k, "}") && arms < 12 {
            let p: u32 = k;
            let iswild: u32 = 1;
            while p < stop && !(tok_is(src, toks, p, "=") && tok_is(src, toks, p + 1, ">")) {
                if tok_is(src, toks, p, ":") && tok_is(src, toks, p + 1, ":") {
                    iswild = 0;
                }
                p = p + 1;
            }
            let lb: u32 = load32(s, 480) + 1;
            store32(s, 480, lb);
            store32(s, 560 + arms * 4, lb);
            if iswild == 1 {
                wild = lb;
            }
            k = skip_block(src, toks, p + 2);   // 跳过 '=>' 后的臂体 ('=' 与 '>' 是两个 token)
            arms = arms + 1;
        }
        // 发 switch
        emit_str(s, out, "  switch i32 ");
        if pay == 1 {
            emit_str(s, out, "%t");
            emit_dec(s, out, tagt);
        } else {
            emit_val(s, out, slvl);
        }
        emit_str(s, out, ", label %L");
        emit_dec(s, out, wild);
        // 默认目标的**名字**必须跟号一致: 没有通配臂时 wild == mend, 该写 `_mend`。
        // 原先无条件拼 `_mwild`, 于是"覆盖全部变体且不写 `_`"的 match 会发一个
        // 引用**未定义标签**的 switch —— 到链接期才炸, 两个后端都收不了。
        if wild == mend {
            emit_str(s, out, "_mend [\n");
        } else {
            emit_str(s, out, "_mwild [\n");
        }
        let a2: u32 = 0;
        let k2: u32 = j + 3;
        while k2 < stop && !tok_is(src, toks, k2, "}") && a2 < 12 {
            let p2: u32 = k2;
            let isw2: u32 = 1;
            while p2 < stop && !(tok_is(src, toks, p2, "=") && tok_is(src, toks, p2 + 1, ">")) {
                if tok_is(src, toks, p2, ":") && tok_is(src, toks, p2 + 1, ":") {
                    isw2 = 0;
                }
                p2 = p2 + 1;
            }
            let body2: u32 = skip_block(src, toks, p2 + 2);
            if isw2 == 0 {
                let vi2: u32 = enum_variant_index(s, src, toks, ei, k2 + 3);
                emit_str(s, out, "      i32 ");
                emit_dec(s, out, vi2);
                emit_str(s, out, ", label %L");
                emit_dec(s, out, load32(s, 560 + a2 * 4));
                emit_str(s, out, "_m");
                emit_tok(s, out, src, toks, k2 + 3);
                emit_str(s, out, "\n");
            }
            k2 = body2;
            a2 = a2 + 1;
        }
        emit_str(s, out, "    ]\n");
        store32(s, 476, 1);
        // 第二遍: 逐臂发标签/绑定/臂体/跳转
        let a3: u32 = 0;
        let k3: u32 = j + 3;
        while k3 < stop && !tok_is(src, toks, k3, "}") && a3 < 12 {
            let p3: u32 = k3;
            let isw3: u32 = 1;
            while p3 < stop && !(tok_is(src, toks, p3, "=") && tok_is(src, toks, p3 + 1, ">")) {
                if tok_is(src, toks, p3, ":") && tok_is(src, toks, p3 + 1, ":") {
                    isw3 = 0;
                }
                p3 = p3 + 1;
            }
            let lab3: u32 = load32(s, 560 + a3 * 4);
            let be3: u32 = skip_block(src, toks, p3 + 2);   // 臂体范围 (两个分支共用)
            if isw3 == 1 {
                store32(s, 476, 0);
                store32(s, 488, lab3);
                store32(s, 496, 0);
                emit_str(s, out, "L");
                emit_dec(s, out, lab3);
                emit_str(s, out, "_mwild:\n");
                let s4: u32 = p3 + 3;
                while s4 < be3 - 1 && !tok_is(src, toks, s4, "}") && tok_kind(toks, s4) != 4 {
                    s4 = stmt(s, out, src, toks, s4, load32(s, 552));
                }
            } else {
                store32(s, 476, 0);
                store32(s, 488, lab3);
                store32(s, 496, 0);
                emit_str(s, out, "L");
                emit_dec(s, out, lab3);
                emit_str(s, out, "_m");
                emit_tok(s, out, src, toks, k3 + 3);
                emit_str(s, out, ":\n");
                if tok_is(src, toks, k3 + 4, "(") {   // 载荷绑定
                    let vt3: u32 = enum_variant_index(s, src, toks, ei, k3 + 3);
                    let pstub: u32 = push_ty_subst(s, src, toks, st);   // 主体的实例化
                    let pt3: u32 = enum_payload_type(s, src, toks, ei, vt3);
                    let raw: u32 = alloc_temp(s);   // new_temp 会自己写 %tN, 这里手写
                    emit_str(s, out, "  %t");
                    emit_dec(s, out, raw);
                    emit_str(s, out, " = extractvalue { i32, i64 } ");
                    emit_val(s, out, slvl);
                    emit_str(s, out, ", 1\n");
                    if bit_width(pt3, src, toks) >= 64 {
                        emit_str(s, out, "  store i64 %t");
                        emit_dec(s, out, raw);
                        emit_str(s, out, ", ptr %");
                        emit_name_tok(s, out, src, toks, k3 + 5);
                        emit_str(s, out, ".addr\n");
                    } else {
                        let cv: u32 = alloc_temp(s);
                        emit_str(s, out, "  %t");
                        emit_dec(s, out, cv);
                        emit_str(s, out, " = trunc i64 %t");
                        emit_dec(s, out, raw);
                        emit_str(s, out, " to ");
                        emit_ty(s, out, src, toks, pt3);
                        emit_str(s, out, "\n  store ");
                        emit_ty(s, out, src, toks, pt3);
                        emit_str(s, out, " %t");
                        emit_dec(s, out, cv);
                        emit_str(s, out, ", ptr %");
                        emit_name_tok(s, out, src, toks, k3 + 5);
                        emit_str(s, out, ".addr\n");
                    }
                    pop_subst(s, pstub);
                }
                let be: u32 = skip_block(src, toks, p3 + 2);
                let s3: u32 = p3 + 3;   // '{' 之后
                while s3 < be - 1 && !tok_is(src, toks, s3, "}") && tok_kind(toks, s3) != 4 {
                    s3 = stmt(s, out, src, toks, s3, load32(s, 552));
                }
            }
            jump(s, out, mend, "mend");
            k3 = be3;
            a3 = a3 + 1;
        }
        store32(s, 476, 0);
        lab_def(s, out, mend, "mend");
        store32(s, 548, md);
        return stop;
    }
    if tok_is(src, toks, j, "guard") {   // P4/M36+M38: 域检查 + 审计计数
        let ci: u32 = find_cap(s, src, toks, j + 1);
        let ce: u32 = expr_bin(s, out, src, toks, j + 3, 1, 0);
        let clo: u32 = 0;
        let chi: u32 = 0;
        if ci != 4294967295 {
            clo = load32(s, cap_base(ci) + 8);
            chi = load32(s, cap_base(ci) + 12);
        }
        emit_str(s, out, "  ");
        let v64: u32 = new_temp(s, out);
        emit_str(s, out, " = zext i32 ");
        emit_val(s, out, 0);
        emit_str(s, out, " to i64\n  ");
        let ge: u32 = new_temp(s, out);
        emit_str(s, out, " = icmp uge i64 %t");
        emit_dec(s, out, v64);
        emit_str(s, out, ", ");
        emit_dec(s, out, clo);
        emit_str(s, out, "\n  ");
        let le: u32 = new_temp(s, out);
        emit_str(s, out, " = icmp ule i64 %t");
        emit_dec(s, out, v64);
        emit_str(s, out, ", ");
        emit_dec(s, out, chi);
        emit_str(s, out, "\n  ");
        let gokv: u32 = new_temp(s, out);
        emit_str(s, out, " = and i1 %t");
        emit_dec(s, out, ge);
        emit_str(s, out, ", %t");
        emit_dec(s, out, le);
        emit_str(s, out, "\n");
        let gw: u32 = load32(s, 480) + 1;
        store32(s, 480, gw + 1);
        emit_str(s, out, "  br i1 %t");
        emit_dec(s, out, gokv);
        emit_str(s, out, ", label ");
        lab_ref(s, out, gw, "gok");
        emit_str(s, out, ", label ");
        lab_ref(s, out, gw + 1, "gtrap");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, gw + 1, "gtrap");
        emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
        store32(s, 476, 1);
        lab_def(s, out, gw, "gok");
        emit_str(s, out, "  ");
        let ap: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr [16 x i64], ptr @__loment_audit, i32 0, i32 ");
        emit_dec(s, out, ci);
        emit_str(s, out, "\n  ");
        let aold: u32 = new_temp(s, out);
        emit_str(s, out, " = load i64, ptr %t");
        emit_dec(s, out, ap);
        emit_str(s, out, "\n  ");
        let anw: u32 = new_temp(s, out);
        emit_str(s, out, " = add i64 %t");
        emit_dec(s, out, aold);
        emit_str(s, out, ", 1\n  store i64 %t");
        emit_dec(s, out, anw);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, ap);
        emit_str(s, out, "\n");
        return ce + 1;
    }
    // 表达式语句 (调用/内建): NAME ( ... ) ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "(") {
        let e6: u32 = expr_bin(s, out, src, toks, j, 1, 0);
        return e6 + 1;
    }
    // 下标赋值: NAME[IDX] = EXPR ;  (M4 可变切片 / M24 数组)
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "[") {
        let sty: u32 = var_type(s, src, toks, j);
        let set: u32 = elem_tok(src, toks, sty);
        if is_slice_tok(src, toks, sty) == 1 {
            load_var(s, out, src, toks, j, 0);
            emit_str(s, out, "  ");
            let sp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, 0);
            emit_str(s, out, ", 0\n");
            let siv: u32 = expr_bin(s, out, src, toks, j + 2, 1, 1);
            emit_str(s, out, "  ");
            let sgp: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds ");
            emit_ty(s, out, src, toks, set);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, sp);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, 1);
            emit_str(s, out, "\n");
            let sve: u32 = expr_bin(s, out, src, toks, siv + 2, 1, 2);
            emit_str(s, out, "  store ");
            emit_ty(s, out, src, toks, set);
            emit_str(s, out, " ");
            emit_val(s, out, 2);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, sgp);
            emit_str(s, out, "\n");
            return sve + 1;
        }
        if is_array_tok(src, toks, sty) == 1 {
            let aiv: u32 = expr_bin(s, out, src, toks, j + 2, 1, 0);
            emit_str(s, out, "  ");
            let agp: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds ");
            emit_ty(s, out, src, toks, sty);
            emit_str(s, out, ", ptr %");
            emit_name_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr, i32 0, i32 ");
            emit_val(s, out, 0);
            emit_str(s, out, "\n");
            let ave: u32 = expr_bin(s, out, src, toks, aiv + 2, 1, 1);
            emit_str(s, out, "  store ");
            emit_ty(s, out, src, toks, set);
            emit_str(s, out, " ");
            emit_val(s, out, 1);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, agp);
            emit_str(s, out, "\n");
            return ave + 1;
        }
        return j + 1;
    }
    // 赋值: NAME = EXPR ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "=") {
        let ty2: u32 = var_type(s, src, toks, j);
        let e5: u32 = expr_bin(s, out, src, toks, j + 2, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty2);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr\n");
        return e5 + 1;
    }
    return j + 1;
}

/// 数组字面量绑定: `let a: [T; N] = [e0, e1, …];` —— 逐元素 GEP + 求值 + store。
/// `i` 指向 `[`; 返回其后的 token 下标。
fn let_array_lit(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, i: u32) -> u32 {
    let et: u32 = elem_tok(src, toks, ty);
    let k: u32 = i + 1;
    let idx: u32 = 0;
    while !tok_is(src, toks, k, "]") && tok_kind(toks, k) != 4 {
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, idx);
        emit_str(s, out, "\n");
        let ev: u32 = expr_bin(s, out, src, toks, k, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        k = ev;
        if tok_is(src, toks, k, ",") {
            k = k + 1;
        }
        idx = idx + 1;
    }
    return k + 1;
}

/// 两个 token 的文本是否相同 (逐字节)。
fn tok_eq(src: ptr, toks: ptr, a: u32, b: u32) -> bool {
    if load32(toks, a * 20 + 8) != load32(toks, b * 20 + 8) {
        return false;
    }
    let k: u32 = 0;
    while k < load32(toks, a * 20 + 8) {
        if load8(src, load32(toks, a * 20 + 4) + k) != load8(src, load32(toks, b * 20 + 4) + k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// struct 字面量绑定: `let b: Blk = Blk { off: 3, len: 5 };` (M23)。
/// 字段按**声明序**逐个 GEP + 求值 + store; 值按字段名在字面量里查。
fn let_struct_lit(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, i: u32) -> u32 {
    let si: u32 = find_struct(s, src, toks, ty);
    let nf: u32 = load32(s, struct_base(si) + 4);
    let be: u32 = skip_block(src, toks, i);
    let k: u32 = 0;
    while k < nf {
        let fnm: u32 = load32(s, struct_base(si) + 8 + k * 8);
        let ftp: u32 = load32(s, struct_base(si) + 8 + k * 8 + 4);
        let p: u32 = i + 1;
        let vst: u32 = i + 2;
        while p < be {
            if tok_eq(src, toks, p, fnm) && tok_is(src, toks, p + 1, ":") {
                vst = p + 2;
            }
            p = p + 1;
        }
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, k);
        emit_str(s, out, "\n");
        expr_bin(s, out, src, toks, vst, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ftp);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        k = k + 1;
    }
    return be;
}

/// 匹配的 '}' 之后的下标 (i 指向 '{')。
fn skip_block(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "{") {
            d = d + 1;
        }
        if tok_is(src, toks, j, "}") {
            d = d - 1;
            if d == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}

/// `let x: T = <expr>?;` 里的 `?` token 下标 (0 = 不是 ? 形式)。
/// `?` 只以"语句尾"形式出现 (lomentc 的 Try 反糖只认 Let 的右值), 所以判定条件是
/// `?` 紧跟 `;`; 遇到 `{`/`}` 就说明这一句已经越过, 直接放弃。
fn find_try_q(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") && !tok_is(src, toks, j, "}") {
        if tok_is(src, toks, j, "?") && tok_is(src, toks, j + 1, ";") {
            return j;
        }
        j = j + 1;
    }
    return 0;
}

/// 追加一个局部 (按名字去重), 返回新的局部数。
/// 名字槽是"token 下标 / 合成名"两种编码共用的 (见 syn_name), 文本比对只在两者
/// 都是真实 token 时才有意义 —— 否则会按合成值当下标去读 token 缓冲 (越界)。
fn add_local(s: ptr, src: ptr, toks: ptr, n: u32, name: u32, ty: u32) -> u32 {
    let dup: u32 = 0;
    let k: u32 = 0;
    while k < n {
        let ex: u32 = load32(s, CG_LOCAL + k * 8);
        if ex == name {
            dup = 1;
        }
        if ex < 2147483648 && name < 2147483648
                && load32(toks, ex * 20 + 8) == load32(toks, name * 20 + 8) {
            let q: u32 = 0;
            let ok: u32 = 1;
            while q < load32(toks, name * 20 + 8) {
                if load8(src, load32(toks, ex * 20 + 4) + q)
                        != load8(src, load32(toks, name * 20 + 4) + q) {
                    ok = 0;
                }
                q = q + 1;
            }
            if ok == 1 {
                dup = 1;
            }
        }
        k = k + 1;
    }
    if dup == 1 {
        return n;
    }
    store32(s, CG_LOCAL + n * 8, name);
    store32(s, CG_LOCAL + n * 8 + 4, ty);
    return n + 1;
}

/// 按序收集局部变量 (let), 去重 —— 镜像 lomentc._collect_locals 的子集 (限于本函数体)。
fn collect_locals(s: ptr, src: ptr, toks: ptr, i: u32, end: u32) -> u32 {
    let n: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && j < end {
        if tok_is(src, toks, j, "match") {   // M26: match 载荷绑定也要 alloca
            let st: u32 = expr_type(s, src, toks, j + 1);
            let mei: u32 = find_enum(s, src, toks, st);
            if mei != 4294967295 {
                let mstop: u32 = skip_block(src, toks, j + 2);
                let mp: u32 = j + 3;
                while mp < mstop {
                    if tok_is(src, toks, mp, ":") && tok_is(src, toks, mp + 1, ":")
                            && tok_is(src, toks, mp + 3, "(") {
                        let mvt: u32 = enum_variant_index(s, src, toks, mei, mp + 2);
                        let mstub: u32 = push_ty_subst(s, src, toks, st);   // `match a` 的 a: Opt<u32>
                        let mpt: u32 = enum_payload_type(s, src, toks, mei, mvt);
                        pop_subst(s, mstub);
                        let mbn: u32 = mp + 4;
                        if mpt != 0 && mbn < mstop {
                            n = add_local(s, src, toks, n, mbn, mpt);
                        }
                    }
                    mp = mp + 1;
                }
            }
        }
        if tok_is(src, toks, j, "for") {   // for 变量也需 alloca
            let name: u32 = j + 1;
            // 与 lomentc 同规则: 类型 = expr_type(lo) or expr_type(hi) or u32(0)
            let vt: u32 = expr_type(s, src, toks, j + 3);
            if vt == 0 {
                let d: u32 = j + 3;
                while tok_kind(toks, d) != 4 && !tok_is(src, toks, d, "{") {
                    if tok_is(src, toks, d, ".") && tok_is(src, toks, d + 1, ".") {
                        vt = expr_type(s, src, toks, d + 2);
                    }
                    d = d + 1;
                }
            }
            let dup0: u32 = 0;
            let kk: u32 = 0;
            while kk < n {
                if load32(s, CG_LOCAL + kk * 8) == name {
                    dup0 = 1;
                }
                kk = kk + 1;
            }
            if dup0 == 0 {
                store32(s, CG_LOCAL + n * 8, name);
                store32(s, CG_LOCAL + n * 8 + 4, vt);
                n = n + 1;
            }
        }
        if tok_is(src, toks, j, "let") && !tok_is(src, toks, j - 1, "if") {   // `if let` 走下一分支
            let name: u32 = j + 1;
            let ty: u32 = j + 3;
            let eq2: u32 = skip_type(src, toks, ty);
            let qs: u32 = find_try_q(src, toks, eq2 + 1);
            if qs != 0 {
                // M9: `let x: T = e?;` 反糖成 `let __t{line} / let x / match { Ok=>x=v; Err=>return Err(e) }`
                // —— 局部表按反糖后的顺序收 (镜像 _collect_locals 走的那棵 AST)
                let ln2: u32 = load32(toks, j * 20 + 12);
                let rt2: u32 = expr_type(s, src, toks, eq2 + 1);
                n = add_local(s, src, toks, n, syn_name(0, ln2), rt2);
                n = add_local(s, src, toks, n, name, ty);
                let ei2: u32 = find_enum(s, src, toks, rt2);
                if ei2 != 4294967295 {
                    // 变体序写死 0/1: Result 是预置的 `{ Ok(T), Err(E) }`, _desugar_try 也写死这两个名字
                    let sb2: u32 = push_ty_subst(s, src, toks, rt2);
                    let okp: u32 = enum_payload_type(s, src, toks, ei2, 0);
                    let errp: u32 = enum_payload_type(s, src, toks, ei2, 1);
                    pop_subst(s, sb2);
                    n = add_local(s, src, toks, n, syn_name(1, ln2), okp);
                    n = add_local(s, src, toks, n, syn_name(2, ln2), errp);
                }
            } else {
                n = add_local(s, src, toks, n, name, ty);
            }
        }
        if tok_is(src, toks, j, "if") && tok_is(src, toks, j + 1, "let") {
            // M10: `if let Enum::V(bind) = e` 在 parser 里就反糖成 Match —— 绑定也要 alloca。
            // 形状: `if` `let` Enum `:` `:` V `(` bind `)` `=` <主体>
            let iv2: u32 = j + 5;
            let ib2: u32 = j + 7;
            if tok_is(src, toks, j + 6, "(") {
                let ist: u32 = expr_type(s, src, toks, j + 10);
                let mei2: u32 = find_enum(s, src, toks, ist);
                if mei2 != 4294967295 {
                    let isub: u32 = push_ty_subst(s, src, toks, ist);
                    let mvt2: u32 = enum_variant_index(s, src, toks, mei2, iv2);
                    let mpt2: u32 = enum_payload_type(s, src, toks, mei2, mvt2);
                    pop_subst(s, isub);
                    if mpt2 != 0 {
                        n = add_local(s, src, toks, n, ib2, mpt2);
                    }
                }
            }
        }
        j = j + 1;
    }
    store32(s, 484, n);
    return n;
}

fn count_args(src: ptr, toks: ptr, lp: u32) -> u32 {
    let d: u32 = 0;
    let argc: u32 = 0;
    let any: u32 = 0;
    let j: u32 = lp + 1;
    while !(tok_is(src, toks, j, ")") && d == 0) && tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") || tok_is(src, toks, j, "[") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") || tok_is(src, toks, j, "]") {
            d = d - 1;
        }
        if tok_is(src, toks, j, ",") && d == 0 {
            argc = argc + 1;
        }
        any = 1;
        j = j + 1;
    }
    if any == 0 {
        return 0;
    }
    return argc + 1;
}

/// freestanding 运行时文本块 (镜像 lomentc._IR_RUNTIME), 仅当出现过 `/` `%` 时写出。
/// 位置同 lomentc: 横幅之后、第一个函数之前 (尾部一个空行)。
fn emit_runtime(s: ptr, out: ptr) -> u32 {
    emit_str(s, out, "\n; ---- Loment freestanding 运行时 (M31: 无 libc) ----\ndefine internal i32 @__loment_memcmp(ptr %a, ptr %b, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %cont ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %eq, label %body\nbody:\n  %pa = getelementptr i8, ptr %a, i64 %i\n  %pb = getelementptr i8, ptr %b, i64 %i\n  %ca = load i8, ptr %pa\n  %cb = load i8, ptr %pb\n  %ne = icmp ne i8 %ca, %cb\n  br i1 %ne, label %diff, label %cont\ncont:\n  %i1 = add i64 %i, 1\n  br label %loop\ndiff:\n  %da = zext i8 %ca to i32\n  %db = zext i8 %cb to i32\n  %r = sub i32 %da, %db\n  ret i32 %r\neq:\n  ret i32 0\n}\n\n");
    emit_str(s, out, "define internal void @__loment_memset(ptr %p, i8 %v, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %end, label %body\nbody:\n  %q = getelementptr i8, ptr %p, i64 %i\n  store i8 %v, ptr %q\n  %i1 = add i64 %i, 1\n  br label %loop\nend:\n  ret void\n}\n\n");
    emit_str(s, out, "define internal void @__loment_memcpy(ptr %d, ptr %s, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %end, label %body\nbody:\n  %sp = getelementptr i8, ptr %s, i64 %i\n  %b = load i8, ptr %sp\n  %dp = getelementptr i8, ptr %d, i64 %i\n  store i8 %b, ptr %dp\n  %i1 = add i64 %i, 1\n  br label %loop\nend:\n  ret void\n}\n\n");
    return emit_str(s, out, "define internal void @__loment_abort() {\n  call void @llvm.trap()\n  unreachable\n}\n\ndeclare void @llvm.trap()\n\n");
}

/// 预扫描: 源码里出现过 `/` `%` 运算符 (kind=3 且文本为单字符), 或 `alloc` / `panic`
/// (它们引用 `@__loment_*`) 时需运行时文本块。
/// 输出是顺序写的, 而运行时块要落在横幅之后、函数之前, 所以必须先判定再写横幅。
/// 语义等价于 lomentc 的 `"@__loment_" in text_all` —— 本 codegen 目前只有这三个来源会引用它。
/// 全文 (含 import 拼接进来的依赖) 是否出现过某个标识符。
fn contains_ident(src: ptr, toks: ptr, text: str) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, text) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn runtime_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 3 && (tok_is(src, toks, i, "/") || tok_is(src, toks, i, "%")) {
            return 1;
        }
        if tok_kind(toks, i) == 0 && (tok_is(src, toks, i, "alloc") || tok_is(src, toks, i, "panic")
                || tok_is(src, toks, i, "str_eq") || tok_is(src, toks, i, "str_concat")
                || tok_is(src, toks, i, "guard")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 预扫描: `alloc` 用到 bump 堆全局 (`@__loment_heap`/`@__loment_off`)。
fn heap_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 0 && (tok_is(src, toks, i, "alloc")
                || tok_is(src, toks, i, "str_concat")) {   // str_concat 也拼到堆上
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 状态块要多大 —— 驱动器按这个数从 `brk` 开一块传进来 (`emit_module` 的第 4 个参数)。
/// **不再从语言自带的 64 KiB bump 堆开**: 那几张表按单元规模定, 放大后远超 64 KiB。
pub fn cg_arena_bytes() -> u32 {
    return CG_BYTES;
}

/// 主入口: 写完整 IR (子集), 返回长度; **返回 0 = 单元的规模超过表容量** (驱动器据此报错)。
pub fn emit_module(src: ptr, toks: ptr, out: ptr, s: ptr) -> u32 {
    store32(s, 0, 0);
    store32(s, 4, 0);
    store32(s, 12, 0);
    store32(s, 640, 0);   // 函数个数
    store32(s, 476, 0);   // terminated
    store32(s, 480, 0);   // label 计数
    store32(s, 484, 0);   // 局部数
    store32(s, 512, runtime_needed(src, toks));
    store32(s, 516, heap_needed(src, toks));
    store32(s, 532, strings_needed(src, toks));
    // 符号表: 登记函数。同时识别 trait 声明 (方法只声明不发射) 与 impl 块 (方法名 = <类型>_<方法>)
    let i: u32 = 0;
    let n: u32 = 0;
    let depth: u32 = 0;
    let impl_depth: u32 = 0;
    let impl_recv: u32 = 0;
    let trait_depth: u32 = 0;
    let pend_impl: u32 = 0;
    store32(s, 456, 0);
    store32(s, 460, 0);
    store32(s, 464, 0);
    store32(s, 468, 0);
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "impl") {   // 接收者 = `for` 之后那个 token
            let fp: u32 = i + 1;
            while tok_kind(toks, fp) != 4 && !tok_is(src, toks, fp, "for") && !tok_is(src, toks, fp, "{") {
                fp = fp + 1;
            }
            pend_impl = fp + 1;
        }
        if tok_is(src, toks, i, "{") {
            depth = depth + 1;
            if pend_impl != 0 && impl_depth == 0 {
                impl_depth = depth;
                impl_recv = pend_impl;
                pend_impl = 0;
            }
        }
        if tok_is(src, toks, i, "}") {
            if impl_depth != 0 && depth == impl_depth {
                impl_depth = 0;
                impl_recv = 0;
            }
            if trait_depth != 0 && depth == trait_depth {
                trait_depth = 0;
            }
            if depth > 0 {
                depth = depth - 1;
            }
        }
        if tok_is(src, toks, i, "trait") {   // trait 声明块: 里面的 fn 只有签名
            let tb: u32 = i + 1;
            while tok_kind(toks, tb) != 4 && !tok_is(src, toks, tb, "{") {
                tb = tb + 1;
            }
            trait_depth = depth + 1;
        }
        if tok_is(src, toks, i, "fn") {
            // 容量守卫: 写穿这张表的下场是**静默改名**(fk 格被后面的表盖掉, fkind 变成 2),
            // 判据只会报"两个编译器不一致"。超了返回 0, 驱动器据此报错退出。
            if n >= CG_MAXFN {
                return 0;
            }
            let lp: u32 = find_paren(src, toks, i + 2);
            let rp: u32 = skip_parens(src, toks, lp);
            store32(s, CG_FN + n * 12, i + 1);
            store32(s, CG_FN + n * 12 + 4, fn_ret_tok(src, toks, rp));
            store32(s, CG_FN + n * 12 + 8, count_args(src, toks, lp));
            // 附加信息: 0=普通 1=trait 声明里的方法 2=impl 方法 (名字 <recv>_<方法>)
            store32(s, fk_base(n), 0);
            store32(s, fk_base(n) + 4, 0);
            // 外部函数 (docs/173): 第三种"只声明不发射"的类型。判**前一个 token** 是不是
            // `extern` —— 比挂一个粘性标志稳（`extern` 后面必须紧跟 `fn`, 看前一个 token 就
            // 精确等价, 也不会被后面的 `fn` 误吃）。
            if i > 0 && tok_is(src, toks, i - 1, "extern") {
                store32(s, fk_base(n), 3);
            } else if trait_depth != 0 && depth == trait_depth {
                store32(s, fk_base(n), 1);
            } else if impl_depth != 0 && depth == impl_depth {
                store32(s, fk_base(n), 2);
                store32(s, fk_base(n) + 4, impl_recv);
            }
            // 形参类型表: 调用点按形参类型强制实参 (与 lomentc 的 expr(a, p.type) 同义)。
            // 步长 80 (= 10 个槽) 而不是 128: 表从 24576 起, 步长 128 时第 128 个函数
            // 正好压到枚举表 (40960) —— codegen.lomt 自己的单元只有 118 个函数, 侥幸没撞,
            // 自举驱动把 lexer/bytes 一起装进来 (134 个函数) 才暴露 (M83 抓到的真 bug)。
            let pi: u32 = lp + 1;
            let pk: u32 = 0;
            while pi < rp && pk < 10 {
                store32(s, CG_PARAM + n * 80 + pk * 8, pi);
                store32(s, CG_PARAM + n * 80 + pk * 8 + 4, pi + 2);
                if load32(s, fk_base(n)) == 2 && pk == 0 {   // impl 的 self: 类型 = 接收者类型
                    store32(s, CG_PARAM + n * 80 + pk * 8 + 4, load32(s, fk_base(n) + 4));
                }
                pk = pk + 1;
                pi = skip_type(src, toks, pi + 2);
                if tok_is(src, toks, pi, ",") {
                    pi = pi + 1;
                }
            }
            n = n + 1;
        }
        i = i + 1;
    }
    store32(s, 640, n);
    // struct 表: name_tok | nfields | 8 × (field_tok, type_tok) —— 字段仅标量类型
    let sn: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "struct") && sn < 64 {
            store32(s, struct_base(sn), i + 1);
            let sbrace: u32 = i + 2;
            while tok_kind(toks, sbrace) != 4 && !tok_is(src, toks, sbrace, "{") {
                sbrace = sbrace + 1;   // 跳过 `struct Pair<T>` 的 `<T>`
            }
            let fld: u32 = sbrace + 1;
            let nf: u32 = 0;
            while !tok_is(src, toks, fld, "}") && tok_kind(toks, fld) != 4 && nf < 8 {
                store32(s, struct_base(sn) + 8 + nf * 8, fld);
                store32(s, struct_base(sn) + 8 + nf * 8 + 4, fld + 2);
                nf = nf + 1;
                fld = fld + 4;   // name ':' type ','
            }
            store32(s, struct_base(sn) + 4, nf);
            store32(s, struct_base(sn) + 72, 0);   // 类型形参 (声明处) <T> / <T, U>
            store32(s, struct_base(sn) + 76, 0);
            if tok_is(src, toks, i + 2, "<") {
                store32(s, struct_base(sn) + 72, i + 3);
                if tok_is(src, toks, i + 4, ",") {
                    store32(s, struct_base(sn) + 76, i + 5);
                }
            }
            sn = sn + 1;
        }
        i = i + 1;
    }
    store32(s, 520, sn);
    // 能力域表: name_tok | space_tok | lo | hi | revocable
    let cn: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "capability") && cn < 64 {
            store32(s, cap_base(cn), i + 1);
            store32(s, cap_base(cn) + 4, i + 3);
            store32(s, cap_base(cn) + 8, tok_int(src, toks, i + 5));
            store32(s, cap_base(cn) + 12, tok_int(src, toks, i + 8));
            store32(s, cap_base(cn) + 16, 0);
            if tok_is(src, toks, i + 10, "revocable") {
                store32(s, cap_base(cn) + 16, 1);
            }
            cn = cn + 1;
        }
        i = i + 1;
    }
    store32(s, 536, cn);
    // 枚举表: name_tok | nvariants | has_payload | pad | 8 × (variant_tok, payload_tok)
    let en: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "enum") {
            // 原先守卫是 `en < 64`, 而枚举表只有 19 格 —— 20..64 会**写进后面的局部表**。
            // 现在表是 CG_MAXENUM 格, 守卫与表同源, 超了返回 0。
            if en >= CG_MAXENUM {
                return 0;
            }
            store32(s, enum_base(en), i + 1);
            let ebrace: u32 = i + 2;
            while tok_kind(toks, ebrace) != 4 && !tok_is(src, toks, ebrace, "{") {
                ebrace = ebrace + 1;   // 跳过 `enum Opt<T>` 的 `<T>`
            }
            let vt: u32 = ebrace + 1;
            let nv: u32 = 0;
            let hasp: u32 = 0;
            while !tok_is(src, toks, vt, "}") && tok_kind(toks, vt) != 4 && nv < 8 {
                store32(s, enum_base(en) + 16 + nv * 8, vt);
                store32(s, enum_base(en) + 16 + nv * 8 + 4, 0);
                let nxt: u32 = vt + 2;
                if tok_is(src, toks, vt + 1, "(") {
                    store32(s, enum_base(en) + 16 + nv * 8 + 4, vt + 2);
                    hasp = 1;
                    nxt = vt + 4;
                }
                if tok_is(src, toks, nxt, ",") {
                    nxt = nxt + 1;
                }
                vt = nxt;
                nv = nv + 1;
            }
            store32(s, enum_base(en) + 4, nv);
            store32(s, enum_base(en) + 8, hasp);
            store32(s, enum_base(en) + 72, 0);
            store32(s, enum_base(en) + 76, 0);
            if tok_is(src, toks, i + 2, "<") {
                store32(s, enum_base(en) + 72, i + 3);
                if tok_is(src, toks, i + 4, ",") {
                    store32(s, enum_base(en) + 76, i + 5);
                }
            }
            en = en + 1;
        }
        i = i + 1;
    }
    store32(s, 540, en);
    emit_str(s, out, "; 由 tools/lomentc.py 生成 (native: LLVM IR, docs/144/145)\n");
    emit_str(s, out, "; clang -O1 driver.c this.ll -o exe\n\n");
    if load32(s, 512) == 1 {
        emit_runtime(s, out);
    }
    if contains_ident(src, toks, "guard") == 1 {   // P4/M38: 审计计数全局
        emit_str(s, out, "@__loment_audit = internal global [16 x i64] zeroinitializer\n\n");
    }
    if load32(s, 536) != 0 {   // P4/M35: 域描述表 (space 取 FNV-1a 32 位)
        emit_caps_table(s, out, src, toks);
        emit_str(s, out, "\n");
    }
    if load32(s, 516) == 1 {
        emit_str(s, out, "@__loment_heap = internal global [65536 x i8] zeroinitializer\n@__loment_off = internal global i32 0\n\n");
    }
    // 外部函数的 `declare` (docs/173): 每个外部符号一条, 按名字去重, **放在函数体之前**。
    // 位置对着参考实现排: `emit_llvm` 把它们追加进 `globals_`, 而 `globals_` = [declares] +
    // 每函数的 globals (字符串常量就在那一堆里), 之后统一补一个空行。所以这里插在**字符串
    // globals 之前**, 空行只在"后面没有字符串 globals"时自己补 —— 有的话那个块已经补过了。
    let dx: u32 = 0;
    let nd: u32 = 0;
    while dx < load32(s, 640) {
        if load32(s, fk_base(dx)) == 3 {
            nd = nd + 1;
            emit_str(s, out, "declare ");
            emit_ty(s, out, src, toks, load32(s, CG_FN + dx * 12 + 4));
            emit_str(s, out, " @");
            emit_tok(s, out, src, toks, load32(s, CG_FN + dx * 12));
            emit_str(s, out, "(");
            let dk: u32 = 0;
            let dc: u32 = load32(s, CG_FN + dx * 12 + 8);
            while dk < dc && dk < 10 {
                if dk > 0 {
                    emit_str(s, out, ", ");
                }
                emit_ty(s, out, src, toks, load32(s, CG_PARAM + dx * 80 + dk * 8 + 4));
                dk = dk + 1;
            }
            emit_str(s, out, ")\n");
        }
        dx = dx + 1;
    }
    if nd > 0 && load32(s, 532) != 1 {
        emit_str(s, out, "\n");
    }
    if load32(s, 532) == 1 {
        emit_str_globals(s, out, src, toks);
        emit_str(s, out, "\n");
    }
    store32(s, 64, 0);       // 实例表: 按"首次被用到"的顺序追加
    store32(s, 60, 4294967295);   // 当前正在发射的实例 (NONE = 不是实例)
    i = 0;
    let fnix: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            if is_generic_fn(s, src, toks, fnix) == 1 {   // 泛型声明本身不发射 (只发实例)
                let gb: u32 = find_body(src, toks, find_paren(src, toks, i + 2));
                i = skip_block(src, toks, gb - 1);
            } else if load32(s, fk_base(fnix)) == 1 {   // trait 声明里的方法: 只有签名, 整条跳过
                let trp: u32 = skip_parens(src, toks, find_paren(src, toks, i + 2));
                let tq: u32 = trp + 1;
                while tok_kind(toks, tq) != 4 && !tok_is(src, toks, tq, ";") {
                    tq = tq + 1;
                }
                i = tq + 1;
            } else if load32(s, fk_base(fnix)) == 3 {   // 外部函数: 同样只有签名, 整条跳过
                let erp: u32 = skip_parens(src, toks, find_paren(src, toks, i + 2));
                let eq: u32 = erp + 1;
                while tok_kind(toks, eq) != 4 && !tok_is(src, toks, eq, ";") {
                    eq = eq + 1;
                }
                i = eq + 1;
            } else {
                store32(s, 4, 0);    // temp 计数随函数重置
                store32(s, 480, 0);  // label 计数随函数重置
                store32(s, 476, 0);  // terminated = false
                store32(s, 472, fnix);   // 当前函数表下标 (impl 方法取名用)
                i = emit_fn(s, out, src, toks, i);
            }
            fnix = fnix + 1;
        } else {
            i = i + 1;
        }
    }
    // 实例发射: 按发现序, 每个实例推入自己的类型实参替换, 再当作普通函数发射一遍
    let ie: u32 = 0;
    let ic: u32 = load32(s, 64);
    while ie < ic {
        let eb: u32 = 72 + ie * 12;
        let efn: u32 = load32(s, eb);
        let e1: u32 = load32(s, eb + 4);
        let e2t: u32 = load32(s, eb + 8);
        let esub: u32 = 0;
        let ep1: u32 = decl_tparam(src, toks, efn + 1, 0);
        if ep1 != 0 && e1 != 0 {
            sub_push(s, ep1, e1);
            esub = 1;
        }
        let ep2: u32 = decl_tparam(src, toks, efn + 1, 1);
        if ep2 != 0 && e2t != 0 {
            sub_push(s, ep2, e2t);
            esub = esub + 1;
        }
        store32(s, 4, 0);
        store32(s, 480, 0);
        store32(s, 476, 0);
        store32(s, 472, 0);
        store32(s, 60, ie);
        i = emit_fn(s, out, src, toks, efn);
        store32(s, 60, 4294967295);
        pop_subst(s, esub);
        ic = load32(s, 64);   // 实例体内可能又发现新实例
        ie = ie + 1;
    }
    return st_o(s);
}
