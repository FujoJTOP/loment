module codegen

// M82: Loment 版 IR 生成 —— 生成的 .ll 与 tools/lomentc.py 的 --emit-llvm 逐字节一致。
//
// 覆盖: 标量类型 (u8..u64/i8..i64/bool); 表达式 = 字面量 | 参数 | 括号 | 一元(- !)
//       | 二元(+ - * / % & | ^ << >> 比较) | 短路 &&/|| (phi) | 调用 | `as`;
//       语句 = let/赋值/if/while/for/return/表达式语句。
// 不含: 聚合类型(切片/字符串/数组/struct/枚举)、match、能力域、其余内建与 syscall。
//       除法/取模已含 —— 除零走 trap 跳转块, 并触发 freestanding 运行时文本块。
//
// 关键设计(两阶段): expr_* 先把指令写进输出, 再把"值文本"落到值栈的第 lvl 层;
// 调用方随后把该值内联到自己的行里 —— 这样嵌套表达式也能保持与 Python 版相同的指令顺序。
//
// 状态块: 0=输出游标 4=temp 计数 12=参数个数 512=需运行时文本块
//         值栈: 第 k 层 长度@16+72k, 文本@20+72k (容量 68), k=0..5
//         实参类型 608.. 函数计数 640 函数表 704.. 当前函数参数表 1536..
//         局部表 3072.. 每函数形参类型 4096+i*128
use "loment/examples/bytes.lomt"
use "loment/selfhost/lexer.lomt"

fn st_o(s: ptr) -> u32 {
    return load32(s, 0);
}

fn blen(s: ptr, lvl: u32) -> u32 {
    return 16 + 72 * lvl;
}

fn btxt(s: ptr, lvl: u32) -> u32 {
    return 20 + 72 * lvl;
}

// ---------------------------------------------------------------- 输出

fn emit_str(s: ptr, out: ptr, text: str) -> u32 {
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < str_len(text) {
        store8(out, o, str_byte(text, i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_mem(s: ptr, out: ptr, buf: ptr, off: u32, len: u32) -> u32 {
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < len {
        store8(out, o, load8(buf, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_dec(s: ptr, out: ptr, v: u32) -> u32 {
    let tmp: ptr = alloc(16);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(tmp, n, (48 + x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(tmp, n - 1 - i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_tok(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    return emit_mem(s, out, src, load32(toks, i * 20 + 4), load32(toks, i * 20 + 8));
}

fn tok_is(src: ptr, toks: ptr, i: u32, text: str) -> bool {
    if load32(toks, i * 20 + 8) != str_len(text) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(text) {
        if load8(src, load32(toks, i * 20 + 4) + k) != str_byte(text, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn tok_kind(toks: ptr, i: u32) -> u32 {
    return load32(toks, i * 20);
}

/// 只占号不写输出 (除法要先占 r 再占 z, 与 lomentc 的 `r = self.t(); z = self.t()` 同序)。
fn alloc_temp(s: ptr) -> u32 {
    let v: u32 = load32(s, 4) + 1;   // lomentc 从 %t1 起编号
    store32(s, 4, v);
    return v;
}

fn emit_temp_ref(s: ptr, out: ptr, n: u32) -> u32 {
    emit_str(s, out, "%t");
    return emit_dec(s, out, n);
}

fn new_temp(s: ptr, out: ptr) -> u32 {
    let v: u32 = alloc_temp(s);
    emit_temp_ref(s, out, v);
    return v;
}

// ---------------------------------------------------------------- 值栈

fn copy_mem(buf: ptr, off: u32, src: ptr, soff: u32, len: u32) {
    let i: u32 = 0;
    while i < len {
        store8(buf, off + i, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

/// 把第 src 层的值复制到第 dst 层。
fn move_val(s: ptr, dst: u32, src: u32) {
    let len: u32 = load32(s, blen(s, src));
    let i: u32 = 0;
    while i < len {
        store8(s, btxt(s, dst) + i, load8(s, btxt(s, src) + i) as u8);
        i = i + 1;
    }
    store32(s, blen(s, dst), len);
}

/// 把"%tN"写进第 lvl 层。
fn set_temp_val(s: ptr, lvl: u32, n: u32) {
    store8(s, btxt(s, lvl), 37 as u8);
    store8(s, btxt(s, lvl) + 1, 116 as u8);
    let tmp: ptr = alloc(16);
    let d: u32 = 0;
    let x: u32 = n;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(s, btxt(s, lvl) + 2 + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), 2 + d);
}

fn emit_val(s: ptr, out: ptr, lvl: u32) -> u32 {
    return emit_mem(s, out, s, btxt(s, lvl), load32(s, blen(s, lvl)));
}

// ---------------------------------------------------------------- 类型

fn emit_ty(s: ptr, out: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return emit_str(s, out, "i32");
    }
    if tok_is(src, toks, tt, "bool") || tok_is(src, toks, tt, "true")
        || tok_is(src, toks, tt, "false") {
        return emit_str(s, out, "i1");
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return emit_str(s, out, "i8");
    }
    if tok_is(src, toks, tt, "ptr") {
        return emit_str(s, out, "ptr");
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return emit_str(s, out, "i16");
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return emit_str(s, out, "i32");
    }
    return emit_str(s, out, "i64");
}

fn is_signed(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "i8") || tok_is(src, toks, tt, "i16")
        || tok_is(src, toks, tt, "i32") || tok_is(src, toks, tt, "i64") {
        return 1;
    }
    return 0;
}

/// 类型 token 名 (供注释行用): tt==0 时缺省 "u32"。
fn emitted_name(s: ptr, out: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return emit_str(s, out, "u32");
    }
    return emit_tok(s, out, src, toks, tt);
}

// ---------------------------------------------------------------- 运算符

/// 运算符编码 (0 = 不是运算符)。
fn op_code(src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "|") {
        if tok_is(src, toks, i + 1, "|") {
            return 1;
        }
        return 17;
    }
    if tok_is(src, toks, i, "&") {
        if tok_is(src, toks, i + 1, "&") {
            return 2;
        }
        return 16;
    }
    if tok_is(src, toks, i, "=") {
        if tok_is(src, toks, i + 1, "=") {
            return 3;
        }
        return 0;
    }
    if tok_is(src, toks, i, "!") {
        if tok_is(src, toks, i + 1, "=") {
            return 4;
        }
        return 0;
    }
    if tok_is(src, toks, i, "<") {
        if tok_is(src, toks, i + 1, "=") {
            return 6;
        }
        if tok_is(src, toks, i + 1, "<") {
            return 9;
        }
        return 5;
    }
    if tok_is(src, toks, i, ">") {
        if tok_is(src, toks, i + 1, "=") {
            return 8;
        }
        if tok_is(src, toks, i + 1, ">") {
            return 10;
        }
        return 7;
    }
    if tok_is(src, toks, i, "+") {
        return 11;
    }
    if tok_is(src, toks, i, "-") {
        return 12;
    }
    if tok_is(src, toks, i, "*") {
        return 13;
    }
    if tok_is(src, toks, i, "/") {
        return 14;
    }
    if tok_is(src, toks, i, "%") {
        return 15;
    }
    if tok_is(src, toks, i, "^") {
        return 18;
    }
    return 0;
}

fn op_prec(c: u32) -> u32 {
    if c == 1 {
        return 1;
    }
    if c == 2 {
        return 2;
    }
    if c == 3 || c == 4 {
        return 3;
    }
    if c >= 5 && c <= 8 {
        return 4;
    }
    if c == 17 {
        return 5;
    }
    if c == 18 {
        return 6;
    }
    if c == 16 {
        return 7;
    }
    if c == 9 || c == 10 {
        return 8;
    }
    if c == 11 || c == 12 {
        return 9;
    }
    if c >= 13 && c <= 15 {
        return 10;
    }
    return 0;
}

fn op_toks(c: u32) -> u32 {
    if c <= 2 || (c >= 3 && c <= 4) || c == 6 || c == 8 || c == 9 || c == 10 {
        return 2;
    }
    return 1;
}

/// 写指令助记符 (比较类带有无符号)。
fn emit_mnemonic(s: ptr, out: ptr, src: ptr, toks: ptr, c: u32, tt: u32) -> u32 {
    let sg: u32 = is_signed(src, toks, tt);
    if c == 3 {
        return emit_str(s, out, "icmp eq");
    }
    if c == 4 {
        return emit_str(s, out, "icmp ne");
    }
    if c == 5 {
        if sg == 1 {
            return emit_str(s, out, "icmp slt");
        }
        return emit_str(s, out, "icmp ult");
    }
    if c == 6 {
        if sg == 1 {
            return emit_str(s, out, "icmp sle");
        }
        return emit_str(s, out, "icmp ule");
    }
    if c == 7 {
        if sg == 1 {
            return emit_str(s, out, "icmp sgt");
        }
        return emit_str(s, out, "icmp ugt");
    }
    if c == 8 {
        if sg == 1 {
            return emit_str(s, out, "icmp sge");
        }
        return emit_str(s, out, "icmp uge");
    }
    if c == 9 {
        return emit_str(s, out, "shl");
    }
    if c == 10 {
        if sg == 1 {
            return emit_str(s, out, "ashr");
        }
        return emit_str(s, out, "lshr");
    }
    if c == 11 {
        return emit_str(s, out, "add");
    }
    if c == 12 {
        return emit_str(s, out, "sub");
    }
    if c == 13 {
        return emit_str(s, out, "mul");
    }
    if c == 16 {
        return emit_str(s, out, "and");
    }
    if c == 17 {
        return emit_str(s, out, "or");
    }
    return emit_str(s, out, "xor");
}

/// 除法/取模助记符 (c: 14=`/`, 15=`%`)。
fn emit_div_mnemonic(s: ptr, out: ptr, src: ptr, toks: ptr, c: u32, tt: u32) -> u32 {
    let sg: u32 = is_signed(src, toks, tt);
    if c == 14 {
        if sg == 1 {
            return emit_str(s, out, "sdiv");
        }
        return emit_str(s, out, "udiv");
    }
    if sg == 1 {
        return emit_str(s, out, "srem");
    }
    return emit_str(s, out, "urem");
}

// ---------------------------------------------------------------- 符号表

fn find_fn(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 640) {
        let base: u32 = 704 + i * 12;
        let nt: u32 = load32(s, base);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

fn fn_ret(s: ptr, fi: u32) -> u32 {
    return load32(s, 704 + fi * 12 + 4);
}

/// 参数类型 (name_tok -> type_tok; 0 = 未找到)。
fn param_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 12) {
        let nt: u32 = load32(s, 1536 + i * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return load32(s, 1536 + i * 8 + 4);
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 表达式类型推断 (镜像 lomentc.expr_type 的标量子集); 0 = 未知。
fn expr_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    if tok_kind(toks, j) == 1 {
        return 0;
    }
    if tok_kind(toks, j) == 0 {
        if tok_is(src, toks, j, "true") || tok_is(src, toks, j, "false") {
            return j;
        }
        if tok_is(src, toks, j + 1, "(") {
            let fi: u32 = find_fn(s, src, toks, j);
            if fi != 4294967295 {
                return fn_ret(s, fi);
            }
            return 0;
        }
        return param_type(s, src, toks, j);
    }
    if tok_is(src, toks, j, "(") {
        return expr_type(s, src, toks, j + 1);
    }
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        return expr_type(s, src, toks, j + 1);
    }
    return 0;
}

// ---------------------------------------------------------------- 表达式

fn bit_width(tt: u32, src: ptr, toks: ptr) -> u32 {
    if tok_is(src, toks, tt, "bool") || tok_is(src, toks, tt, "true")
        || tok_is(src, toks, tt, "false") {
        return 1;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return 8;
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return 16;
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return 32;
    }
    return 64;
}

/// `as T` 后缀: 按位宽与符号性选 trunc/sext/zext (与 lomentc 同规则)。
fn apply_cast(s: ptr, out: ptr, src: ptr, toks: ptr, from_t: u32, to_t: u32, lvl: u32) -> u32 {
    let sw: u32 = bit_width(from_t, src, toks);
    let dw: u32 = bit_width(to_t, src, toks);
    if sw == dw && from_t == to_t {
        return 0;   // 同类型: 不加指令
    }
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if dw < sw {
        emit_str(s, out, "trunc ");
    } else if is_signed(src, toks, from_t) == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty(s, out, src, toks, from_t);
    emit_str(s, out, " ");
    emit_val(s, out, lvl);
    emit_str(s, out, " to ");
    emit_ty(s, out, src, toks, to_t);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, n);
    return 1;
}

// ---------------------------------------------------------------- 类型名 (内建结果用)

/// 类型 id: 1=u8 2=u16 3=u32 4=u64 5=ptr 6=bool (镜像 _ll_type 的标量+ptr 子集)。
fn ty_width_id(id: u32) -> u32 {
    if id == 1 {
        return 8;
    }
    if id == 2 {
        return 16;
    }
    if id == 3 {
        return 32;
    }
    if id == 4 {
        return 64;
    }
    if id == 6 {
        return 1;
    }
    return 64;   // ptr 与未知
}

fn emit_ty_name(s: ptr, out: ptr, id: u32) -> u32 {
    if id == 1 {
        return emit_str(s, out, "i8");
    }
    if id == 2 {
        return emit_str(s, out, "i16");
    }
    if id == 3 {
        return emit_str(s, out, "i32");
    }
    if id == 4 {
        return emit_str(s, out, "i64");
    }
    if id == 5 {
        return emit_str(s, out, "ptr");
    }
    return emit_str(s, out, "i1");
}

/// 类型 token -> 类型 id (0 = 缺省 u32, 与 lomentc 的 `st or "u32"` 同义)。
fn ty_name_id(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return 3;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return 1;
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return 2;
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return 3;
    }
    if tok_is(src, toks, tt, "u64") || tok_is(src, toks, tt, "i64") {
        return 4;
    }
    if tok_is(src, toks, tt, "ptr") {
        return 5;
    }
    if tok_is(src, toks, tt, "bool") {
        return 6;
    }
    return 3;
}

/// 内建结果上的 `as` 后缀: from 侧是内建固定的类型 (fid/fsg), to 侧是类型 token。
fn apply_cast_b(s: ptr, out: ptr, src: ptr, toks: ptr, fid: u32, fsg: u32, to_tok: u32, lvl: u32) -> u32 {
    let tid: u32 = ty_name_id(src, toks, to_tok);
    if tid == fid {
        return 0;
    }
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if fid == 5 && tid == 4 {              // M67: 指针转整数
        emit_str(s, out, "ptrtoint ptr ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to i64\n");
        set_temp_val(s, lvl, n);
        return 1;
    }
    if ty_width_id(tid) < ty_width_id(fid) {
        emit_str(s, out, "trunc ");
    } else if fsg == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty_name(s, out, fid);
    emit_str(s, out, " ");
    emit_val(s, out, lvl);
    emit_str(s, out, " to ");
    emit_ty_name(s, out, tid);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, n);
    return 1;
}

/// 求值一个实参 (落到第 lvl 层), 返回其后 token 下标 (跳过尾随逗号)。
fn arg1(s: ptr, out: ptr, src: ptr, toks: ptr, k: u32, lvl: u32) -> u32 {
    let e: u32 = expr_bin(s, out, src, toks, k, 1, lvl);
    let r: u32 = e;
    if tok_is(src, toks, r, ",") {
        r = r + 1;
    }
    return r;
}

/// 原子 + 后缀: 字面量 / 参数 / 括号 / 调用 / `as T`。
fn expr_atom(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32) -> u32 {
    if tok_kind(toks, j) == 1 {
        copy_mem(s, btxt(s, lvl), src, load32(toks, j * 20 + 4), load32(toks, j * 20 + 8));
        store32(s, blen(s, lvl), load32(toks, j * 20 + 8));
        let e0: u32 = j + 1;
        if tok_is(src, toks, e0, "as") {
            apply_cast(s, out, src, toks, 0, e0 + 1, lvl);
            return e0 + 2;
        }
        return e0;
    }
    if tok_is(src, toks, j, "(") {
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, lvl);
        let e1: u32 = e + 1;
        if tok_is(src, toks, e1, "as") {
            apply_cast(s, out, src, toks, 0, e1 + 1, lvl);
            return e1 + 2;
        }
        return e1;
    }
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "(") {
        // 内建降级: load8 / store8 (与 lomentc 的 _Ir.builtin 同形)
        if tok_is(src, toks, j, "load8") {
            let ap: u32 = expr_bin(s, out, src, toks, j + 2, 1, lvl);
            let ao: u32 = expr_bin(s, out, src, toks, ap + 1, 1, lvl + 1);
            emit_str(s, out, "  ");
            let g: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n  ");
            let b8: u32 = new_temp(s, out);
            emit_str(s, out, " = load i8, ptr %t");
            emit_dec(s, out, g);
            emit_str(s, out, "\n  ");
            let z: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 %t");
            emit_dec(s, out, b8);
            emit_str(s, out, " to i32\n");
            set_temp_val(s, lvl, z);
            if tok_is(src, toks, ao + 1, "as") {   // load8(...) as T
                apply_cast(s, out, src, toks, 0, ao + 2, lvl);
                return ao + 2;
            }
            return ao;
        }
        if tok_is(src, toks, j, "store8") {
            let ap2: u32 = expr_bin(s, out, src, toks, j + 2, 1, lvl);
            let ao2: u32 = expr_bin(s, out, src, toks, ap2 + 1, 1, lvl + 1);
            let av: u32 = expr_bin(s, out, src, toks, ao2 + 1, 1, lvl + 2);
            emit_str(s, out, "  ");
            let g2: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n  store i8 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, g2);
            emit_str(s, out, "\n");
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return av;
        }
        if tok_is(src, toks, j, "alloc") {   // M15: bump 分配器
            let k1: u32 = arg1(s, out, src, toks, j + 2, lvl);
            emit_str(s, out, "  ");
            let off: u32 = new_temp(s, out);
            emit_str(s, out, " = load i32, ptr @__loment_off\n  ");
            let nxt: u32 = new_temp(s, out);
            emit_str(s, out, " = add i32 %t");
            emit_dec(s, out, off);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl);
            emit_str(s, out, "\n  ");
            let ok: u32 = new_temp(s, out);
            emit_str(s, out, " = icmp ule i32 %t");
            emit_dec(s, out, nxt);
            emit_str(s, out, ", 65536\n");
            let w: u32 = load32(s, 480) + 1;
            store32(s, 480, w + 1);
            emit_str(s, out, "  br i1 %t");
            emit_dec(s, out, ok);
            emit_str(s, out, ", label ");
            lab_ref(s, out, w, "aok");
            emit_str(s, out, ", label ");
            lab_ref(s, out, w + 1, "aovf");
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, w + 1, "aovf");
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            lab_def(s, out, w, "aok");
            emit_str(s, out, "  store i32 %t");
            emit_dec(s, out, nxt);
            emit_str(s, out, ", ptr @__loment_off\n  ");
            let p: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %t");
            emit_dec(s, out, off);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, p);
            if tok_is(src, toks, k1 + 1, "as") {
                apply_cast_b(s, out, src, toks, 5, 0, k1 + 2, lvl);
                return k1 + 2;
            }
            return k1;
        }
        if tok_is(src, toks, j, "free") {
            let k2: u32 = arg1(s, out, src, toks, j + 2, lvl);
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return k2;
        }
        if tok_is(src, toks, j, "atomic_add") {   // M21
            let k3: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k4: u32 = arg1(s, out, src, toks, k3, lvl + 1);
            emit_str(s, out, "  ");
            let at: u32 = new_temp(s, out);
            emit_str(s, out, " = atomicrmw add ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " seq_cst\n");
            set_temp_val(s, lvl, at);
            if tok_is(src, toks, k4 + 1, "as") {
                apply_cast_b(s, out, src, toks, 3, 0, k4 + 2, lvl);
                return k4 + 2;
            }
            return k4;
        }
        if tok_is(src, toks, j, "ptr_add") || tok_is(src, toks, j, "ptr_sub") {   // M73
            let sub: u32 = tok_is(src, toks, j, "ptr_sub") as u32;
            let k5: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k6: u32 = arg1(s, out, src, toks, k5, lvl + 1);
            emit_str(s, out, "  ");
            let n64: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i64\n");
            let use: u32 = n64;
            if sub == 1 {
                emit_str(s, out, "  ");
                let nn: u32 = new_temp(s, out);
                emit_str(s, out, " = sub i64 0, %t");
                emit_dec(s, out, n64);
                emit_str(s, out, "\n");
                use = nn;
            }
            emit_str(s, out, "  ");
            let pe: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, use);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, pe);
            if tok_is(src, toks, k6 + 1, "as") {
                apply_cast_b(s, out, src, toks, 5, 0, k6 + 2, lvl);
                return k6 + 2;
            }
            return k6;
        }
        if tok_is(src, toks, j, "get_bits") || tok_is(src, toks, j, "set_bits") {   // M22
            let setb: u32 = tok_is(src, toks, j, "set_bits") as u32;
            let k7: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k8: u32 = arg1(s, out, src, toks, k7, lvl + 1);
            let k9: u32 = arg1(s, out, src, toks, k8, lvl + 2);
            emit_str(s, out, "  ");
            let one: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 1 to i16\n  ");
            let w16: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i32 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, " to i16\n  ");
            let shl: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i16 %t");
            emit_dec(s, out, one);
            emit_str(s, out, ", %t");
            emit_dec(s, out, w16);
            emit_str(s, out, "\n  ");
            let sb2: u32 = new_temp(s, out);
            emit_str(s, out, " = sub i16 %t");
            emit_dec(s, out, shl);
            emit_str(s, out, ", 1\n  ");
            let mask: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i16 %t");
            emit_dec(s, out, sb2);
            emit_str(s, out, " to i8\n");
            // set_bits 的第 4 个实参在掩码之后求值 (与 lomentc 同序)
            let k10: u32 = k9;
            if setb == 1 {
                k10 = arg1(s, out, src, toks, k9, lvl + 3);
            }
            emit_str(s, out, "  ");
            let nsh: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i8\n");
            if setb == 0 {
                emit_str(s, out, "  ");
                let shr: u32 = new_temp(s, out);
                emit_str(s, out, " = lshr i8 ");
                emit_val(s, out, lvl);
                emit_str(s, out, ", %t");
                emit_dec(s, out, nsh);
                emit_str(s, out, "\n  ");
                let gr: u32 = new_temp(s, out);
                emit_str(s, out, " = and i8 %t");
                emit_dec(s, out, shr);
                emit_str(s, out, ", %t");
                emit_dec(s, out, mask);
                emit_str(s, out, "\n");
                set_temp_val(s, lvl, gr);
                if tok_is(src, toks, k10 + 1, "as") {
                    apply_cast_b(s, out, src, toks, 1, 0, k10 + 2, lvl);
                    return k10 + 2;
                }
                return k10;
            }
            emit_str(s, out, "  ");
            let shm: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i8 %t");
            emit_dec(s, out, mask);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nsh);
            emit_str(s, out, "\n  ");
            let nm: u32 = new_temp(s, out);
            emit_str(s, out, " = xor i8 %t");
            emit_dec(s, out, shm);
            emit_str(s, out, ", -1\n  ");
            let cl: u32 = new_temp(s, out);
            emit_str(s, out, " = and i8 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nm);
            emit_str(s, out, "\n  ");
            let msk: u32 = new_temp(s, out);
            emit_str(s, out, " = and i8 ");
            emit_val(s, out, lvl + 3);
            emit_str(s, out, ", %t");
            emit_dec(s, out, mask);
            emit_str(s, out, "\n  ");
            let sh: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i8 %t");
            emit_dec(s, out, msk);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nsh);
            emit_str(s, out, "\n  ");
            let sr: u32 = new_temp(s, out);
            emit_str(s, out, " = or i8 %t");
            emit_dec(s, out, cl);
            emit_str(s, out, ", %t");
            emit_dec(s, out, sh);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, sr);
            if tok_is(src, toks, k10 + 1, "as") {
                apply_cast_b(s, out, src, toks, 1, 0, k10 + 2, lvl);
                return k10 + 2;
            }
            return k10;
        }
        if tok_is(src, toks, j, "panic") {   // M19: 求值后不可继续
            let k11: u32 = arg1(s, out, src, toks, j + 2, lvl);
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            let dl: u32 = load32(s, 480) + 1;
            store32(s, 480, dl);
            lab_def(s, out, dl, "dead");
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return k11;
        }
        // 调用: 先算每个实参 (值落到更深的层), 再写 call 行
        let fi: u32 = find_fn(s, src, toks, j);
        let ret: u32 = 0;
        if fi != 4294967295 {
            ret = fn_ret(s, fi);
        }
        let k: u32 = j + 2;
        let a: u32 = 0;
        while !tok_is(src, toks, k, ")") && tok_kind(toks, k) != 4 && a < 4 {
            // 实参按"形参类型"强制 (与 lomentc 的 expr(a, p.type) 同序同型)
            let ft: u32 = 0;
            if fi != 4294967295 {
                ft = load32(s, 4096 + fi * 128 + a * 8 + 4);
            }
            let at: u32 = ft;
            let ae: u32 = expr_bin(s, out, src, toks, k, 1, lvl + 1 + a);
            store32(s, 608 + a * 4, at);
            k = ae;
            if tok_is(src, toks, k, ",") {
                k = k + 1;
            }
            a = a + 1;
        }
        emit_str(s, out, "  ");
        let n: u32 = new_temp(s, out);
        emit_str(s, out, " = call ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " @");
        emit_tok(s, out, src, toks, j);
        emit_str(s, out, "(");
        let b: u32 = 0;
        while b < a {
            if b > 0 {
                emit_str(s, out, ", ");
            }
            let at2: u32 = load32(s, 608 + b * 4);
            emit_ty(s, out, src, toks, at2);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1 + b);
            b = b + 1;
        }
        emit_str(s, out, ")\n");
        set_temp_val(s, lvl, n);
        let ec: u32 = k + 1;
        if tok_is(src, toks, ec, "as") {   // 调用结果上的 as
            apply_cast(s, out, src, toks, ret, ec + 1, lvl);
            return ec + 2;
        }
        return ec;
    }
    // 变量 (参数或局部): load
    let ty: u32 = var_type(s, src, toks, j);
    emit_str(s, out, "  ");
    let n2: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_tok(s, out, src, toks, j);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n2);
    let e9: u32 = j + 1;
    if tok_is(src, toks, e9, "as") {
        apply_cast(s, out, src, toks, ty, e9 + 1, lvl);
        return e9 + 2;
    }
    return e9;
}

/// 一元: -x (sub ty 0, v) / !b (xor i1 v, true)
fn expr_unary(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32, want: u32) -> u32 {
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        let neg: u32 = tok_is(src, toks, j, "-") as u32;
        let inner: u32 = expr_unary(s, out, src, toks, j + 1, lvl, want);
        let tt: u32 = expr_type(s, src, toks, j + 1);
        emit_str(s, out, "  ");
        let n: u32 = new_temp(s, out);
        if neg == 1 {
            emit_str(s, out, " = sub ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " 0, ");
            emit_val(s, out, lvl);
        } else {
            emit_str(s, out, " = xor i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", true");
        }
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, n);
        return inner;
    }
    return expr_atom(s, out, src, toks, j, lvl);
}

/// 二元 (优先级爬升): 结果落到第 lvl 层。
fn expr_bin(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, minp: u32, lvl: u32) -> u32 {
    let e: u32 = expr_unary(s, out, src, toks, j, lvl, 0);
    let i: u32 = e;
    let go: u32 = 1;
    while go == 1 {
        let c: u32 = op_code(src, toks, i);
        if c == 0 || op_prec(c) < minp {
            go = 0;
        } else if c == 1 || c == 2 {
            // 短路 (phi): 左值已在第 lvl 层; 右操作数只在需要时求值
            let b2: u32 = load32(s, 480) + 1;
            store32(s, 480, b2 + 2);
            emit_str(s, out, "  br i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", label ");
            if c == 2 {                    // &&
                lab_ref(s, out, b2, "sc_rhs");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2 + 1, "sc_short");
            } else {                       // ||
                lab_ref(s, out, b2 + 1, "sc_short");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2, "sc_rhs");
            }
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, b2, "sc_rhs");
            let r2: u32 = expr_bin(s, out, src, toks, i + 2, op_prec(c) + 1, lvl + 1);
            store32(s, 500, load32(s, 488));   // 右操作数结束时的块 = phi 前驱
            store32(s, 504, load32(s, 496));
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 1, "sc_short");
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 2, "sc_end");
            emit_str(s, out, "  ");
            let n2: u32 = new_temp(s, out);
            emit_str(s, out, " = phi i1 [ ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", ");
            ref_from(s, out, load32(s, 500), load32(s, 504));
            emit_str(s, out, " ], [ ");
            if c == 2 {
                emit_str(s, out, "false");
            } else {
                emit_str(s, out, "true");
            }
            emit_str(s, out, ", ");
            lab_ref(s, out, b2 + 1, "sc_short");
            emit_str(s, out, " ]\n");
            set_temp_val(s, lvl, n2);
            i = r2;
        } else if c == 14 || c == 15 {
            // 除法/取模: 除零 = 运行时 trap (M18); 同时点亮运行时文本块
            let r3: u32 = expr_bin(s, out, src, toks, i + 1, op_prec(c) + 1, lvl + 1);
            let lt3: u32 = expr_type(s, src, toks, j);
            let rt3: u32 = expr_type(s, src, toks, i + 1);
            let tt3: u32 = lt3;
            if tt3 == 0 {
                tt3 = rt3;
            }
            let n3: u32 = alloc_temp(s);   // lomentc 先占 r 再占 z
            let z3: u32 = alloc_temp(s);
            let w3: u32 = load32(s, 480) + 1;
            store32(s, 480, w3 + 2);
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, z3);
            emit_str(s, out, " = icmp eq ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0\n  br i1 %t");
            emit_dec(s, out, z3);
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3 + 1, "dtrap");
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3, "dok");
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, w3 + 1, "dtrap");
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            lab_def(s, out, w3, "dok");
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, n3);
            emit_str(s, out, " = ");
            emit_div_mnemonic(s, out, src, toks, c, tt3);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            jump(s, out, w3 + 2, "dend");
            lab_def(s, out, w3 + 2, "dend");
            set_temp_val(s, lvl, n3);
            i = r3;
        } else {
            let np: u32 = op_prec(c) + 1;
            let r: u32 = expr_bin(s, out, src, toks, i + op_toks(c), np, lvl + 1);
            let lt: u32 = expr_type(s, src, toks, j);
            let rt: u32 = expr_type(s, src, toks, i + op_toks(c));
            let tt: u32 = lt;
            if tt == 0 {
                tt = rt;
            }
            emit_str(s, out, "  ");
            let n: u32 = new_temp(s, out);
            emit_str(s, out, " = ");
            emit_mnemonic(s, out, src, toks, c, tt);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, n);
            i = r;
        }
    }
    return i;
}

// ---------------------------------------------------------------- 函数与模块

fn find_body(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j + 1;
}

fn find_paren(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "(") && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j;
}

fn skip_parens(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

fn emit_fn(s: ptr, out: ptr, src: ptr, toks: ptr, base: u32) -> u32 {
    let lp: u32 = find_paren(src, toks, base + 2);
    let rp: u32 = skip_parens(src, toks, lp);
    // 子集要求显式返回类型: ')' '-' '>' T
    let ret: u32 = rp + 3;
    let k: u32 = 0;
    let i: u32 = lp + 1;
    while i < rp && k < 16 {
        store32(s, 1536 + k * 8, i);
        store32(s, 1536 + k * 8 + 4, i + 2);
        k = k + 1;
        i = i + 3;
        if tok_is(src, toks, i, ",") {
            i = i + 1;
        }
    }
    store32(s, 12, k);
    let body_at: u32 = find_body(src, toks, lp);
    let nl: u32 = collect_locals(s, src, toks, body_at, skip_block(src, toks, body_at - 1));
    emit_str(s, out, "; ");
    emit_tok(s, out, src, toks, base + 1);
    emit_str(s, out, " -> ");
    emitted_name(s, out, src, toks, ret);   // 注释用 Loment 类型名
    emit_str(s, out, "\n");
    emit_str(s, out, "define ");
    emit_ty(s, out, src, toks, ret);
    emit_str(s, out, " @");
    emit_tok(s, out, src, toks, base + 1);
    emit_str(s, out, "(");
    let a: u32 = 0;
    while a < k {
        if a > 0 {
            emit_str(s, out, ", ");
        }
        emit_ty(s, out, src, toks, load32(s, 1536 + a * 8 + 4));
        emit_str(s, out, " %");
        emit_tok(s, out, src, toks, load32(s, 1536 + a * 8));
        a = a + 1;
    }
    emit_str(s, out, ") {\nentry:\n");
    let b: u32 = 0;
    while b < k {
        emit_str(s, out, "  %");
        emit_tok(s, out, src, toks, load32(s, 1536 + b * 8));
        emit_str(s, out, ".addr = alloca ");
        emit_ty(s, out, src, toks, load32(s, 1536 + b * 8 + 4));
        emit_str(s, out, "\n");
        b = b + 1;
    }
    let bl: u32 = 0;   // 局部变量 alloca (紧随参数之后)
    while bl < nl {
        emit_str(s, out, "  %");
        emit_tok(s, out, src, toks, load32(s, 3072 + bl * 8));
        emit_str(s, out, ".addr = alloca ");
        emit_ty(s, out, src, toks, load32(s, 3072 + bl * 8 + 4));
        emit_str(s, out, "\n");
        bl = bl + 1;
    }
    let c: u32 = 0;
    while c < k {
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, load32(s, 1536 + c * 8 + 4));
        emit_str(s, out, " %");
        emit_tok(s, out, src, toks, load32(s, 1536 + c * 8));
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, load32(s, 1536 + c * 8));
        emit_str(s, out, ".addr\n");
        c = c + 1;
    }
    let j: u32 = find_body(src, toks, lp);
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "}") {
            emit_str(s, out, "}\n");
            return j + 1;
        }
        j = stmt(s, out, src, toks, j, ret);
    }
    return j;
}

// ---------------------------------------------------------------- 语句

fn lab_def(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    store32(s, 476, 0);           // terminated = false
    store32(s, 488, n);           // 当前标签 (phi 前驱用)
    store32(s, 496, tag_id(tag));
    emit_str(s, out, "L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    emit_str(s, out, tag);
    return emit_str(s, out, ":\n");
}

fn tag_id(tag: str) -> u32 {
    if str_eq(tag, "then") {
        return 1;
    }
    if str_eq(tag, "else") {
        return 2;
    }
    if str_eq(tag, "end") {
        return 3;
    }
    if str_eq(tag, "wcond") {
        return 4;
    }
    if str_eq(tag, "wbody") {
        return 5;
    }
    if str_eq(tag, "wend") {
        return 6;
    }
    if str_eq(tag, "sc_rhs") {
        return 7;
    }
    if str_eq(tag, "sc_short") {
        return 8;
    }
    if str_eq(tag, "fcond") {
        return 10;
    }
    if str_eq(tag, "fbody") {
        return 11;
    }
    if str_eq(tag, "fend") {
        return 12;
    }
    if str_eq(tag, "dok") {
        return 13;
    }
    if str_eq(tag, "dtrap") {
        return 14;
    }
    if str_eq(tag, "dend") {
        return 15;
    }
    if str_eq(tag, "aok") {
        return 16;
    }
    if str_eq(tag, "aovf") {
        return 17;
    }
    if str_eq(tag, "dead") {
        return 18;
    }
    return 9;   // sc_end
}

fn tag_name(id: u32) -> str {
    if id == 1 {
        return "then";
    }
    if id == 2 {
        return "else";
    }
    if id == 3 {
        return "end";
    }
    if id == 4 {
        return "wcond";
    }
    if id == 5 {
        return "wbody";
    }
    if id == 6 {
        return "wend";
    }
    if id == 7 {
        return "sc_rhs";
    }
    if id == 8 {
        return "sc_short";
    }
    if id == 10 {
        return "fcond";
    }
    if id == 11 {
        return "fbody";
    }
    if id == 12 {
        return "fend";
    }
    if id == 13 {
        return "dok";
    }
    if id == 14 {
        return "dtrap";
    }
    if id == 15 {
        return "dend";
    }
    if id == 16 {
        return "aok";
    }
    if id == 17 {
        return "aovf";
    }
    if id == 18 {
        return "dead";
    }
    return "sc_end";
}

/// 保存/还原当前标签 (phi 前驱)。
fn ref_from(s: ptr, out: ptr, n: u32, id: u32) -> u32 {
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag_name(id));
}

/// 当前标签引用: 0 = entry (隐式首块), 否则 %L{n}_{当前 tag 由调用方传入}
fn cur_ref(s: ptr, out: ptr, tag: str) -> u32 {
    let n: u32 = load32(s, 488);
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag);
}

fn lab_ref(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    emit_str(s, out, "%L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    return emit_str(s, out, tag);
}

/// 未终止才写 br; 随后置 terminated。
fn jump(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    let r: u32 = 0;
    if load32(s, 476) == 0 {
        emit_str(s, out, "  br label ");
        r = lab_ref(s, out, n, tag);
        emit_str(s, out, "\n");
    }
    store32(s, 476, 1);
    return r;
}

/// 变量类型: 参数 -> 局部; 0 = 未知。
fn var_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let t: u32 = param_type(s, src, toks, name_tok);
    if t != 0 {
        return t;
    }
    let i: u32 = 0;
    while i < load32(s, 484) {
        let nt: u32 = load32(s, 3072 + i * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return load32(s, 3072 + i * 8 + 4);
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 变量值加载到第 lvl 层 (load <ty>, ptr %name.addr)。
fn load_var(s: ptr, out: ptr, src: ptr, toks: ptr, name_tok: u32, lvl: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, name_tok);
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_tok(s, out, src, toks, name_tok);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n);
    return n;
}

/// 一条语句; 返回下一个待处理 token 下标。
fn stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    if tok_is(src, toks, j, "return") {
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        emit_str(s, out, "  ret ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        return e + 1;
    }
    if tok_is(src, toks, j, "let") {
        let name: u32 = j + 1;
        let ty: u32 = j + 3;
        let e2: u32 = expr_bin(s, out, src, toks, j + 5, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr\n");
        return e2 + 1;
    }
    if tok_is(src, toks, j, "if") {
        let base_l: u32 = load32(s, 480) + 1;   // lomentc 从 L1 起编号
        store32(s, 480, base_l + 2);
        let e3: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        emit_str(s, out, "  br i1 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", label ");
        lab_ref(s, out, base_l, "then");
        emit_str(s, out, ", label ");
        lab_ref(s, out, base_l + 1, "else");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, base_l, "then");
        let k: u32 = e3 + 1;   // '{' 之后的第一条语句
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        k = k + 1;
        jump(s, out, base_l + 2, "end");
        lab_def(s, out, base_l + 1, "else");
        if tok_is(src, toks, k, "else") {
            k = k + 1;
            if tok_is(src, toks, k, "if") {
                k = stmt(s, out, src, toks, k, ret);
            } else {
                k = k + 1;   // '{'
                while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
                    k = stmt(s, out, src, toks, k, ret);
                }
                k = k + 1;
            }
        }
        jump(s, out, base_l + 2, "end");
        lab_def(s, out, base_l + 2, "end");
        return k;
    }
    if tok_is(src, toks, j, "for") {   // for i in lo..hi { ... }
        let var_tok: u32 = j + 1;
        let le: u32 = j + 3;                       // lo 起始 (跳过 'for' 变量 'in')
        let loe: u32 = expr_bin(s, out, src, toks, le, 1, 0);
        let ty: u32 = var_type(s, src, toks, var_tok);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        let hi_start: u32 = loe + 2;               // 跳过 '..'
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "fcond");
        lab_def(s, out, w, "fcond");
        load_var(s, out, src, toks, var_tok, 0);
        let he: u32 = expr_bin(s, out, src, toks, hi_start, 1, 1);
        emit_str(s, out, "  ");
        let cn: u32 = new_temp(s, out);
        emit_str(s, out, " = icmp ");
        if is_signed(src, toks, ty) == 1 {
            emit_str(s, out, "slt ");
        } else {
            emit_str(s, out, "ult ");
        }
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ");
        emit_val(s, out, 1);
        emit_str(s, out, "\n  br i1 %t");
        emit_dec(s, out, cn);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "fbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "fend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "fbody");
        let k: u32 = he + 1;                       // '{' 之后
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        load_var(s, out, src, toks, var_tok, 0);
        emit_str(s, out, "  ");
        let nx: u32 = new_temp(s, out);
        emit_str(s, out, " = add ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", 1\n  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " %t");
        emit_dec(s, out, nx);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        jump(s, out, w, "fcond");
        lab_def(s, out, w + 2, "fend");
        return k + 1;
    }
    if tok_is(src, toks, j, "while") {
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "wcond");
        lab_def(s, out, w, "wcond");
        let e4: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0);
        emit_str(s, out, "  br i1 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "wbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "wend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "wbody");
        let m: u32 = e4 + 1;   // '{' 之后的第一条语句
        while !tok_is(src, toks, m, "}") && tok_kind(toks, m) != 4 {
            m = stmt(s, out, src, toks, m, ret);
        }
        jump(s, out, w, "wcond");
        lab_def(s, out, w + 2, "wend");
        return m + 1;
    }
    // 表达式语句 (调用/内建): NAME ( ... ) ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "(") {
        let e6: u32 = expr_bin(s, out, src, toks, j, 1, 0);
        return e6 + 1;
    }
    // 赋值: NAME = EXPR ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "=") {
        let ty2: u32 = var_type(s, src, toks, j);
        let e5: u32 = expr_bin(s, out, src, toks, j + 2, 1, 0);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty2);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr\n");
        return e5 + 1;
    }
    return j + 1;
}

/// 匹配的 '}' 之后的下标 (i 指向 '{')。
fn skip_block(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "{") {
            d = d + 1;
        }
        if tok_is(src, toks, j, "}") {
            d = d - 1;
            if d == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 按序收集局部变量 (let), 去重 —— 镜像 lomentc._collect_locals 的子集 (限于本函数体)。
fn collect_locals(s: ptr, src: ptr, toks: ptr, i: u32, end: u32) -> u32 {
    let n: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && j < end {
        if tok_is(src, toks, j, "for") {   // for 变量也需 alloca
            let name: u32 = j + 1;
            // 与 lomentc 同规则: 类型 = expr_type(lo) or expr_type(hi) or u32(0)
            let vt: u32 = expr_type(s, src, toks, j + 3);
            if vt == 0 {
                let d: u32 = j + 3;
                while tok_kind(toks, d) != 4 && !tok_is(src, toks, d, "{") {
                    if tok_is(src, toks, d, ".") && tok_is(src, toks, d + 1, ".") {
                        vt = expr_type(s, src, toks, d + 2);
                    }
                    d = d + 1;
                }
            }
            let dup0: u32 = 0;
            let kk: u32 = 0;
            while kk < n {
                if load32(s, 3072 + kk * 8) == name {
                    dup0 = 1;
                }
                kk = kk + 1;
            }
            if dup0 == 0 {
                store32(s, 3072 + n * 8, name);
                store32(s, 3072 + n * 8 + 4, vt);
                n = n + 1;
            }
        }
        if tok_is(src, toks, j, "let") {
            let name: u32 = j + 1;
            let dup: u32 = 0;
            let k: u32 = 0;
            while k < n {
                if load32(toks, load32(s, 3072 + k * 8) * 20 + 8) == load32(toks, name * 20 + 8) {
                    let q: u32 = 0;
                    let ok: u32 = 1;
                    while q < load32(toks, name * 20 + 8) {
                        if load8(src, load32(toks, load32(s, 3072 + k * 8) * 20 + 4) + q)
                                != load8(src, load32(toks, name * 20 + 4) + q) {
                            ok = 0;
                        }
                        q = q + 1;
                    }
                    if ok == 1 {
                        dup = 1;
                    }
                }
                k = k + 1;
            }
            if dup == 0 {
                store32(s, 3072 + n * 8, name);
                store32(s, 3072 + n * 8 + 4, j + 3);
                n = n + 1;
            }
        }
        j = j + 1;
    }
    store32(s, 484, n);
    return n;
}

fn count_args(src: ptr, toks: ptr, lp: u32) -> u32 {
    let d: u32 = 0;
    let argc: u32 = 0;
    let any: u32 = 0;
    let j: u32 = lp + 1;
    while !(tok_is(src, toks, j, ")") && d == 0) && tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") || tok_is(src, toks, j, "[") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") || tok_is(src, toks, j, "]") {
            d = d - 1;
        }
        if tok_is(src, toks, j, ",") && d == 0 {
            argc = argc + 1;
        }
        any = 1;
        j = j + 1;
    }
    if any == 0 {
        return 0;
    }
    return argc + 1;
}

/// freestanding 运行时文本块 (镜像 lomentc._IR_RUNTIME), 仅当出现过 `/` `%` 时写出。
/// 位置同 lomentc: 横幅之后、第一个函数之前 (尾部一个空行)。
fn emit_runtime(s: ptr, out: ptr) -> u32 {
    emit_str(s, out, "\n; ---- Loment freestanding 运行时 (M31: 无 libc) ----\ndefine internal i32 @__loment_memcmp(ptr %a, ptr %b, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %cont ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %eq, label %body\nbody:\n  %pa = getelementptr i8, ptr %a, i64 %i\n  %pb = getelementptr i8, ptr %b, i64 %i\n  %ca = load i8, ptr %pa\n  %cb = load i8, ptr %pb\n  %ne = icmp ne i8 %ca, %cb\n  br i1 %ne, label %diff, label %cont\ncont:\n  %i1 = add i64 %i, 1\n  br label %loop\ndiff:\n  %da = zext i8 %ca to i32\n  %db = zext i8 %cb to i32\n  %r = sub i32 %da, %db\n  ret i32 %r\neq:\n  ret i32 0\n}\n\n");
    emit_str(s, out, "define internal void @__loment_memset(ptr %p, i8 %v, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %end, label %body\nbody:\n  %q = getelementptr i8, ptr %p, i64 %i\n  store i8 %v, ptr %q\n  %i1 = add i64 %i, 1\n  br label %loop\nend:\n  ret void\n}\n\n");
    return emit_str(s, out, "define internal void @__loment_abort() {\n  call void @llvm.trap()\n  unreachable\n}\n\ndeclare void @llvm.trap()\n\n");
}

/// 预扫描: 源码里出现过 `/` `%` 运算符 (kind=3 且文本为单字符), 或 `alloc` / `panic`
/// (它们引用 `@__loment_*`) 时需运行时文本块。
/// 输出是顺序写的, 而运行时块要落在横幅之后、函数之前, 所以必须先判定再写横幅。
/// 语义等价于 lomentc 的 `"@__loment_" in text_all` —— 本 codegen 目前只有这三个来源会引用它。
fn runtime_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 3 && (tok_is(src, toks, i, "/") || tok_is(src, toks, i, "%")) {
            return 1;
        }
        if tok_kind(toks, i) == 0 && (tok_is(src, toks, i, "alloc") || tok_is(src, toks, i, "panic")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 预扫描: `alloc` 用到 bump 堆全局 (`@__loment_heap`/`@__loment_off`)。
fn heap_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, "alloc") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 主入口: 写完整 IR (子集), 返回长度。
pub fn emit_module(src: ptr, toks: ptr, out: ptr) -> u32 {
    let s: ptr = alloc(8192);
    store32(s, 0, 0);
    store32(s, 4, 0);
    store32(s, 12, 0);
    store32(s, 640, 0);   // 函数个数
    store32(s, 476, 0);   // terminated
    store32(s, 480, 0);   // label 计数
    store32(s, 484, 0);   // 局部数
    store32(s, 512, runtime_needed(src, toks));
    store32(s, 516, heap_needed(src, toks));
    // 符号表: 登记函数
    let i: u32 = 0;
    let n: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            let lp: u32 = find_paren(src, toks, i + 2);
            let rp: u32 = skip_parens(src, toks, lp);
            store32(s, 704 + n * 12, i + 1);
            store32(s, 704 + n * 12 + 4, rp + 3);
            store32(s, 704 + n * 12 + 8, count_args(src, toks, lp));
            // 形参类型表: 调用点按形参类型强制实参 (与 lomentc 的 expr(a, p.type) 同义)
            let pi: u32 = lp + 1;
            let pk: u32 = 0;
            while pi < rp && pk < 8 {
                store32(s, 4096 + n * 128 + pk * 8, pi);
                store32(s, 4096 + n * 128 + pk * 8 + 4, pi + 2);
                pk = pk + 1;
                pi = pi + 3;
                if tok_is(src, toks, pi, ",") {
                    pi = pi + 1;
                }
            }
            n = n + 1;
        }
        i = i + 1;
    }
    store32(s, 640, n);
    emit_str(s, out, "; 由 tools/lomentc.py 生成 (native: LLVM IR, docs/144/145)\n");
    emit_str(s, out, "; clang -O1 driver.c this.ll -o exe\n\n");
    if load32(s, 512) == 1 {
        emit_runtime(s, out);
    }
    if load32(s, 516) == 1 {
        emit_str(s, out, "@__loment_heap = internal global [65536 x i8] zeroinitializer\n@__loment_off = internal global i32 0\n\n");
    }
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            store32(s, 4, 0);    // temp 计数随函数重置
            store32(s, 480, 0);  // label 计数随函数重置
            store32(s, 476, 0);  // terminated = false
            i = emit_fn(s, out, src, toks, i);
        } else {
            i = i + 1;
        }
    }
    return st_o(s);
}
