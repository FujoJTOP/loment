module ir_cast

// M82 目标文件 (转换子集): `as` 生成 trunc/sext/zext, 必须与 lomentc 逐字节一致。
// 注: 实参位置的 as 转换不在子集内 (需要调用方按形参类型强制, 见 docs/150)。

fn narrow(x: u32) -> u8 {
    return x as u8;
}

fn widen(x: u8) -> u32 {
    return x as u32;
}

fn widen_signed(x: i32) -> i64 {
    return x as i64;
}

fn lit_cast() -> u8 {
    return 48 as u8;
}

fn bool_cast(c: bool) -> u32 {
    return c as u32;
}
