// loment/selfhost/potato.lomt — 自举侧的 **Potato v5 形式对象**发射 (docs/189 S1)
//
// 对照面是 `tools/lomentc.py::emit_potato`(3610 行起): 同一份源, 参考实现发的对象与这里
// 发的必须**逐字节相同**(`tools/loment_potato_emit_test.py`)。判据不是"长得差不多" ——
// 形式对象是**跨线契约的那一侧**(docs/147 承诺过旧版可回放), 差一个字节就是两个对象。
//
// ## 它读什么
//
// **读 token 流与开关表**, 不读源码、不重新解析。这有三条理由:
//
//   * 走到这里时单元**已经检查过了**(`check_arena` 返回 0 条诊断), 所以"顶层 `fn` 就是
//     一个函数声明"这件事是检查器担保的, 不需要再判一次;
//   * 参考实现的 `emit_potato` 也是**在 AST 上取格**, 不是重新扫源; 两边要对齐的
//     "什么叫一个声明"就只有**深度 0**这一条;
//   * 检查器的符号表(`chk_arena_syms`)里**没有**这一格要的锚点 —— 它按需重扫
//     (aux 只记 `(`/`{` 的下标), 而 `generics` 要的类型形参在名字与 `{` 之间。既然
//     两边都要回 token 流, 就**只回 token 流**, 免得维护两套声明视图。
//
// ## 边界: 子集之外**点名拒绝**, 绝不静默发错
//
// 现在覆盖的是"依赖 + 根 + 预置块"、trait/impl、以及全部标量视图那一大片；**还拒**的是
// 三件事，各有各的理由：
//
//   1. **自写的泛型声明 / 泛型类型的用法**(`generics`/`instances`)—— 这两格在参考实现里
//      是**一对**: 声明了 `<T>` 的, 单态化出来的那些实例要列在 `instances` 里, 而
//      `prepare` 还会把签名里的类型名改写成 `Result_u32_u32` 那种具体名。单态化还没搬
//      进来, 所以这里发不出真值。**预置枚举除外** —— 它们由驱动器注入, 一定带 `<T>`,
//      而且是 `generics` 里唯一必然存在的两条。⚠ 泛型**声明**那条按**整个单元**判:
//      根的函数签名里出现一个**依赖声明的**泛型类型时, `prepare` 照样会改 `f.ret`。
//   2. **`layout` / L0**(`layouts`)—— 它来自 `use "xxx.lom"` 那种 L0 装载。参考实现会把它
//      读成 `layouts` 那几格, 自举侧不装载 L0 —— 与其发一张空表, 不如点名。
//   3. **外部代码块 / 方言**(`bodies` / `dialects`)—— 由**驱动器**拒: 外部代码块在检查
//      **之前**就被它拒了; 而方言那一格只有它知道"这次 `comefor` 展开过没有"(走到这里
//      token 流上那两类词已经没了)。
//
// 拒绝是**打到 stderr 的一句话 + 返回 0**, 由驱动器翻成退出码 1 —— 与"超限报错,
// 绝不静默丢"是同一处纪律(那个词用在 `MAX_USE` / `MAX_CHOOSE` 上)。
//
// ## 单元的形状: **依赖在前, 根在后**
//
// 这是实测的(同一份源喂两个实现, IR 里被依赖者的函数排在根前面 —— 与
// `lomentc.resolve_deps` 的"被依赖者在前"同序), 而 `driver.lomt` 里两处注释有一处是错的:
//
//     依赖1 依赖2 … 根 预置块?
//
// 所以"根在哪" = **最后一个 `module` 标记**(它是 `__prelude` 时取前一个), 而 `unit` 取的是
// **根**那个名字。Potato 的那些格**只描述根单元**(参考实现的 `mod` 是根), 依赖只以
// `imports` 的名字出现 —— 每一格的范围都由 `pt_root_range` 划的那两个数说了算。
//
// 例外: `switches` 是**整个程序**的表(参考实现走 `load_unit` 时带开关预扫), 所以它不收范围。
//
// ## 与参考实现对齐时**最容易漏的三处**
//
//   * `unit` 是源里的 **`module` 名**, 不是文件名: `switch.lomt` 的 unit 是 `switchex`。
//   * `functions` **不含 `extern fn`** —— 参考实现把它收在 `mod.externs` 里, 与本体函数
//     分开; 而检查器两种都登记成 `K_FN`, 所以"名字前面两位是不是 `extern`"是这一格
//     唯一的判据。
//   * 枚举/结构体体里的分隔符 **`,` 与 `;` 都算**, 而 `<...>` / `[...]` / `(...)` 里的
//     逗号**不算** —— 否则 `Result<T, E>` 会被数成两个变体。
module potato

use bytes
use switches

/// 无符号里当"哨兵"用。token 下标从 0 起, 这个值不可能撞上 (与 `switches.SW_NONE` 同形)。
const PT_NONE: u32 = 4294967295;

// ---------------------------------------------------------------- 输出原语
//
// 游标**显式回传**(不是状态块): 这个文件里每一处写都很短, 显式回传比"mem 里存一格"
// 少一层间接, 调用点也能一眼看出顺序。返回值就是"新游标"。

fn pt_ind(out: ptr, o: u32, n: u32) -> u32 {
    let k: u32 = 0;
    while k < n * 2 {
        store8(out, o, 32 as u8);
        o = o + 1;
        k = k + 1;
    }
    return o;
}

fn pt_str(out: ptr, o: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(out, o, str_byte(s, i) as u8);
        o = o + 1;
        i = i + 1;
    }
    return o;
}

fn pt_mem(out: ptr, o: u32, src: ptr, off: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(src, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    return o;
}

/// 十进制。**不用暂存**: 先倒着写进输出缓冲再**原地反转**。
/// 这个文件只拿得到两个缓冲(输出 / 单元), 而那些 `const` 偏移是**全局**的
/// (别的模块也用那块 mem), 不能借 —— 借了就与 `wdec` / codegen 的 `scratch_buf` 抢。
///
/// 参数是 **u64** 而不是 u32: `const` 的值可以是 u64(参考实现那边的库里就有
/// `14695981039346656037` 这种), 按 u32 累加会**发出一个回绕过的数**而一声不响。
fn pt_dec(out: ptr, o: u32, v: u64) -> u32 {
    let st: u32 = o;
    let x: u64 = v;
    if x == 0 {
        store8(out, o, 48 as u8);
        return o + 1;
    }
    while x > 0 {
        // 中间量**显式落成一个 u32 局部**: `(48 + (x % 10) as u32) as u8` 这种写法两个实现
        // 推出的类型不一样（参考实现按左操作数算成 i32, 自举 codegen 记成 i64, 于是发
        // `trunc i64 %t19 to i8` 而 `%t19` 是 `add i32` —— 自相矛盾的 IR）。落一个具名
        // 局部两边就都没得猜了。实测这一处是自举定点（bootstrap 2/4）唯一的分歧点。
        let dg: u32 = (x % 10) as u32;
        store8(out, o, (48 + dg) as u8);
        o = o + 1;
        x = x / 10;
    }
    let n: u32 = o - st;
    let i: u32 = 0;
    while i < n / 2 {
        let a: u32 = load8(out, st + i) as u32;
        let b: u32 = load8(out, st + n - 1 - i) as u32;
        store8(out, st + i, b as u8);
        store8(out, st + n - 1 - i, a as u8);
        i = i + 1;
    }
    return o;
}

fn pt_hex1(out: ptr, o: u32, v: u32) -> u32 {
    if v < 10 {
        store8(out, o, (48 + v) as u8);
    } else {
        store8(out, o, (97 + v - 10) as u8);
    }
    return o + 1;
}

/// `\u00XX` —— `json.dumps` 对 < 0x20 的其余控制字符就是**十六进制小写**两位。
fn pt_uesc(out: ptr, o: u32, c: u32) -> u32 {
    o = pt_str(out, o, "\\u00");
    o = pt_hex1(out, o, c / 16);
    return pt_hex1(out, o, c % 16);
}

/// `src[off..off+n]` 按 **JSON 字符串**写出(含两侧引号)。
///
/// 转义面与 `json.dumps(ensure_ascii=False)` 一致: `"` `\` `\b` `\f` `\n` `\r` `\t` 与
/// 其余 `< 0x20` 走 `\u00XX`; **>= 0x80 的字节原样过** (ensure_ascii=False 就是不做这件事)。
/// 标识符/类型名走这条路是恒等变换(词法器只收 ASCII 字母数字下划线), 但**不能省**:
/// `excluded` 的字符串是**任意字节**。
fn pt_q(out: ptr, o: u32, src: ptr, off: u32, n: u32) -> u32 {
    store8(out, o, 34 as u8);
    o = o + 1;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(src, off + i) as u32;
        if c == 34 {
            o = pt_str(out, o, "\\\"");
        } else if c == 92 {
            o = pt_str(out, o, "\\\\");
        } else if c == 8 {
            o = pt_str(out, o, "\\b");
        } else if c == 12 {
            o = pt_str(out, o, "\\f");
        } else if c == 10 {
            o = pt_str(out, o, "\\n");
        } else if c == 13 {
            o = pt_str(out, o, "\\r");
        } else if c == 9 {
            o = pt_str(out, o, "\\t");
        } else if c < 32 {
            o = pt_uesc(out, o, c);
        } else {
            store8(out, o, c as u8);
            o = o + 1;
        }
        i = i + 1;
    }
    store8(out, o, 34 as u8);
    return o + 1;
}

/// 字面量(本文件自己写的那几个: `v5` / `loment` / `std` / `type` …)。
fn pt_qs(out: ptr, o: u32, s: str) -> u32 {
    store8(out, o, 34 as u8);
    o = o + 1;
    o = pt_str(out, o, s);
    store8(out, o, 34 as u8);
    return o + 1;
}

fn pt_bool(out: ptr, o: u32, v: u32) -> u32 {
    if v == 0 {
        return pt_str(out, o, "false");
    }
    return pt_str(out, o, "true");
}

// ---- JSON 骨架: 四个动作凑出 `json.dumps(indent=2)` 的形状。
//
// 缩进是 **2*层**, 层号自己数。四个动作分别是: 键 / 数组开头 / 数组元素行首 / 数组收尾。
// 空数组写 `[]`(与 Python 一致), 所以 `pt_aopen` 与 `pt_acls` 都**要条数**。

fn pt_key(out: ptr, o: u32, lv: u32, k: str) -> u32 {
    o = pt_ind(out, o, lv);
    o = pt_qs(out, o, k);
    return pt_str(out, o, ": ");
}

fn pt_aopen(out: ptr, o: u32, n: u32) -> u32 {
    if n == 0 {
        return pt_str(out, o, "[]");
    }
    return pt_str(out, o, "[\n");
}

/// 数组第 `ix` 个元素的**行首**(非首元素先补 `,\n`)。
fn pt_aelm(out: ptr, o: u32, lv: u32, ix: u32) -> u32 {
    if ix > 0 {
        o = pt_str(out, o, ",\n");
    }
    return pt_ind(out, o, lv);
}

/// 数组收尾 —— 闭括号与**键**同层(`lv` 是键那一层的层号)。空数组不写。
fn pt_acls(out: ptr, o: u32, lv: u32, n: u32) -> u32 {
    if n == 0 {
        return o;
    }
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, lv);
    return pt_str(out, o, "]");
}

// ---------------------------------------------------------------- token 工具
//
// 单元里到处都是 `"fn"` / `"impl"` / `"module"` 这类**字符串**(关键字表、本文件自己的
// 字面量), 只比原文会把它们当成声明。参考实现没有这个坑, 因为它的 parser 用
// (kind, val) 一起判 —— 自举这边把那条纪律收进 `pt_tis`: **字符串 token 一律不匹配**。

fn pt_kind(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20);
}

fn pt_off(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 4);
}

/// token 的字节长度。**字符串 token 含两侧引号** —— 这是自举词法器的口径, 与参考侧
/// `Tok.val`(**不含**引号)不同。要字符串的内容就自己 `+1 / -2`。
fn pt_tlen(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 8);
}

fn pt_tis(src: ptr, t: ptr, i: u32, s: str) -> bool {
    if load32(t, i * 20) == 2 {
        return false;
    }
    let n: u32 = str_len(s);
    if load32(t, i * 20 + 8) != n {
        return false;
    }
    let off: u32 = load32(t, i * 20 + 4);
    let k: u32 = 0;
    while k < n {
        if (load8(src, off + k) as u32) != (str_byte(s, k) as u32) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// `src[off..off+n]` 里有字节 `c` 吗(只用于那条"字符串里有转义就拒绝"的判据)。
fn pt_has_byte(src: ptr, off: u32, n: u32, c: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if (load8(src, off + i) as u32) == c {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 拒绝出口

/// 说一句话到 stderr 并返回 0。**返回 0 就是"没发出东西"**, 由调用方翻成退出码 1。
fn pt_wfail(msg: str) -> u32 {
    let _w: i64 = syscall4(1, 2, str_ptr(msg) as u64, str_len(msg) as u64);
    return 0;
}

// ---------------------------------------------------------------- 单元的形状

/// 根单元在 token 流里的**范围** —— 返回 `(起点 << 32) | 结束`(结束不含)。
///
/// 驱动器手上的单元是"依赖 + 根 + 预置枚举"拼在一起的一个 token 流, 而 Potato 的那些格
/// **只描述根单元**(参考实现的 `mod` 是根)。**依赖在前**, 这是实测的(一个 `use` 的单元,
/// IR 里被依赖者的函数排在根前面, 与 `lomentc.resolve_deps` 的"被依赖者在前"同序):
///
///     依赖1 依赖2 … 根 预置块?
///
/// 所以"根在哪" = **最后一个 `module` 标记**(每份源都有自己的 `module`, 这是唯一的分界物);
/// 而它正好是注入的预置块(`append_prelude` 那段, 名字就是 `__prelude`)时, 根是**前一个**。
fn pt_root_range(unit: ptr, t: ptr, nt: u32) -> u64 {
    let last: u32 = 0;
    let prev: u32 = 0;
    let seen: u32 = 0;
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "module") {
            prev = last;
            last = i;
            seen = seen + 1;
        }
        i = i + 1;
    }
    if seen == 0 {
        return PT_NONE as u64;
    }
    if seen >= 2 && pt_tis(unit, t, last + 1, "__prelude") {
        return (prev as u64) * 4294967296 + (last as u64);
    }
    return (last as u64) * 4294967296 + (nt as u64);
}

/// 依赖的条数 = 根之前的那几个 `module` 标记。
fn pt_cnt_imports(unit: ptr, t: ptr, lo: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = 0;
    while i < lo && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "module") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `imports`: 依赖单元的名字, **按依赖序**(参考实现是 `[d.name for d in deps]`)。
fn pt_imports(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let i: u32 = 0;
    while i < lo && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "module") {
            o = pt_aelm(out, o, 2, ix);
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 子集之外的构造 —— 返回**给用户看的一句话**(空串 = 在子集里)。
///
/// **分两段扫**，因为两类东西的作用域不一样：
///
/// * **自己那一半**（`[lo, hi)` = 根单元）—— trait/impl、泛型类型的用法、`excluded` 的转义：
///   它们只影响**根**那几格（参考实现的 `mod` 是根，依赖的声明根本不进对象）。
/// * **整个单元**（除预置块）—— 泛型**声明**：根的函数签名里出现一个**依赖声明的**泛型类型
///   （`fn f() -> Pair<u32>` 而 `Pair` 在依赖里）时，`prepare` 照样会把 `f.ret` 改写成
///   `Pair_u32`。所以这条不能只看根那一半。
///
/// 预置块（`__prelude`）自己带 `<T>`，两段都要跳过它 —— 否则每个单元都被拒。
fn pt_refuse(unit: ptr, t: ptr, lo: u32, hi: u32, pre: u32, nt: u32) -> u32 {
    if !pt_tis(unit, t, 0, "module") {
        let _w0: u32 = pt_wfail("fujoc-s: --emit-potato: 单元不以 `module` 开头 (参考实现的前门也是这一条)\n");
        return 1;
    }
    // ---- 整个单元(除预置块): 泛型声明 + L0 布局
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if !(pre != PT_NONE && i >= pre) {
            // 泛型**类型**的声明还没做（M7 那一半：收类型串 → 按串排序 → 批量实例化）。
            // 泛型**函数**的声明放行 —— 它的实例化在 `pt_mono_all` 里做。
            if (pt_tis(unit, t, i, "struct") || pt_tis(unit, t, i, "enum"))
                    && pt_tis(unit, t, i + 2, "<") {
                let _w1: u32 = pt_wfail("fujoc-s: --emit-potato: 这个单元 (含依赖) 有泛型**类型**的声明 —— 那一半 (M7: 类型串收集 + 批量实例化) 还没进自举侧\n");
                return 1;
            }
            // L0 布局 (`use "xxx.lom"`): 参考实现会把它读成 `layouts` 那几格, 而自举侧
            // 不装载 L0 —— 这一条按**整个单元**判, 因为驱动器会把那份文本也拼进来。
            // ⚠ 字符串 token 的切片**含两侧引号**, 所以后缀要从 `ln - 5` 起看
            // (`"a.lom"` 的最后 5 个字节是 `.lom"`)。
            if pt_tis(unit, t, i, "use") && pt_kind(t, i + 1) == 2 {
                let ln: u32 = pt_tlen(t, i + 1);
                if ln > 5 && pt_mem_is(unit, pt_off(t, i + 1) + ln - 5, ".lom") == 1 {
                    let _w2: u32 = pt_wfail("fujoc-s: --emit-potato: 这个单元 `use` 了 L0 布局 (`.lom`) —— `layouts` 那一格还没进自举侧\n");
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    // ---- 根那一半: trait/impl、泛型类型用法、excluded 的转义
    let d: u32 = 0;
    i = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 {
            // 泛型**类型**的用法 (`Result<u32, u32>`): 单态化会把它改写成具体名
            // (`Result_u32_u32`), 签名那一格跟着变, 而 `instances` 也要多一格 ——
            // 两件事都在自举侧之外。**泛型声明上面那条已经拒了**(整个单元), 所以走到这里
            // 还能出现的泛型名只有预置的 Option/Result。
            // ⚠ 不能拿"标识符后面跟 `<`"当判据: `a < b` 到处都是。这条只认这两个名字 ——
            // 而它们在这个子集里**一定是**泛型的(非泛型的 `Option<…>` 本身就不是合法源)。
            if (pt_tis(unit, t, i, "Option") || pt_tis(unit, t, i, "Result"))
                    && pt_tis(unit, t, i + 1, "<") {
                let _w4: u32 = pt_wfail("fujoc-s: --emit-potato: 这个单元用了泛型类型 (`Option<…>` / `Result<…>`) —— 单态化会把签名里的名字改写成 `Result_u32_u32` 那种具体名, `instances` 也要跟着写; 还没进自举侧\n");
                return 1;
            }
            // `excluded` 的字符串里有反斜杠: 自举词法器**不替我们解转义**(参考实现解),
            // 照抄出去就是两个实现的字节不一样 —— 与其发错, 不如点名。
            if pt_tis(unit, t, i, "excluded") && pt_kind(t, i + 1) == 2 {
                if pt_has_byte(unit, pt_off(t, i + 1) + 1, pt_tlen(t, i + 1) - 2, 92) == 1 {
                    let _w5: u32 = pt_wfail("fujoc-s: --emit-potato: `excluded` 的字符串里有 `\\` 转义 —— 自举词法器不解转义, 这一格还没做到\n");
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `src[off..off+4]` 是 `s` 吗(不用 token 表 —— 给"字符串 token 的后缀"用)。
fn pt_mem_is(src: ptr, off: u32, s: str) -> u32 {
    let i: u32 = 0;
    while i < str_len(s) {
        if (load8(src, off + i) as u32) != (str_byte(s, i) as u32) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// ---------------------------------------------------------------- 数字与配对

/// 整数 token → 十进制。参考实现的对象里 `0x10` 也是 `16`(`int_lit` 先解成 int)。
///
/// 前面可以有 `-`(`int_lit` 允许): 那不是 u32 表示得出来的数, 所以**分开写**负号与数值
/// —— 直接按 u32 累加会发出 4294967295 这种数, 而参考实现发的是 `-1`。
fn pt_num(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    let neg: u32 = 0;
    if pt_tis(src, t, j, "-") {
        neg = 1;
        j = j + 1;
    }
    let st: u32 = pt_off(t, j);
    let ln: u32 = pt_tlen(t, j);
    let hex: u32 = 0;
    let k: u32 = 0;
    if ln > 2 && load8(src, st) == 48
            && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        hex = 1;
        k = 2;
    }
    let v: u64 = 0;
    while k < ln {
        let c: u32 = load8(src, st + k) as u32;
        let dg: u32 = 0;
        if c >= 48 && c <= 57 {
            dg = c - 48;
        } else if c >= 97 && c <= 102 {
            dg = c - 97 + 10;
        } else if c >= 65 && c <= 70 {
            dg = c - 65 + 10;
        }
        if hex == 1 {
            v = v * 16 + (dg as u64);
        } else {
            v = v * 10 + (dg as u64);
        }
        k = k + 1;
    }
    if neg == 1 {
        store8(out, o, 45 as u8);
        o = o + 1;
    }
    return pt_dec(out, o, v);
}

/// 这个数字 token 的**量级**超过 u64 吗(1 = 超了)。
///
/// 参考实现的 `int_lit` 是**任意精度**(Python 的 int), 而这里只到 u64 —— 超了就得
/// 点名, 不能发一个回绕过的数(`std/num.lomt` 里 `4294967296` 那种 u32 装不下的值
/// **是真实存在的**, 实测就是这么撞出来的)。
///
/// **只比原文不解值**: 去掉 `-` 与 `0x` 前缀、跳过前导零之后 ① 位数多的一定更大;
/// ② 位数相同的按字节与上限逐位比(同位数时字典序 == 数值序, 十六进制统一小写)。
fn pt_num_ovf(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    if pt_tis(src, t, j, "-") {
        j = j + 1;   // 负号不看: 判的是**量级**
    }
    let st: u32 = pt_off(t, j);
    let ln: u32 = pt_tlen(t, j);
    let hex: u32 = 0;
    let b: u32 = 0;
    if ln > 2 && load8(src, st) == 48
            && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        hex = 1;
        b = 2;
    }
    while b + 1 < ln && load8(src, st + b) == 48 {
        b = b + 1;
    }
    let nd: u32 = ln - b;
    let lim: u32 = 20;
    let cap: str = "18446744073709551615";
    if hex == 1 {
        lim = 16;
        cap = "ffffffffffffffff";
    }
    if nd > lim {
        return 1;
    }
    if nd < lim {
        return 0;
    }
    let k: u32 = 0;
    while k < lim {
        let c: u32 = load8(src, st + b + k) as u32;
        if c >= 65 && c <= 70 {
            c = c + 32;
        }
        let q: u32 = str_byte(cap, k) as u32;
        if c > q {
            return 1;
        }
        if c < q {
            return 0;
        }
        k = k + 1;
    }
    return 0;
}

/// `i` 指向 `lo` 时, 返回配对的 `hi` 的下标(不配对时停在 eof 附近 —— 调用方靠
/// `pt_kind != 4` 兜住; 走到这里时单元已经检查过了, 括号是配平的)。
fn pt_match(src: ptr, t: ptr, i: u32, lo: str, hi: str) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while pt_kind(t, j) != 4 {
        if pt_tis(src, t, j, lo) {
            d = d + 1;
        }
        if pt_tis(src, t, j, hi) {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

// ---------------------------------------------------------------- 计数
//
// 每一格都要先知道条数才能写 `[]` 还是 `[\n`, 所以计数与发射各走一遍 token 流。
// 计数都很短(深度 0 扫一遍), 换来的是"发到一半才发现要回退"这种形状不会出现。

/// 深度 0 上某个关键字 token 的个数。`{` `}` `(` `)` `[` `]` 计深度。
///
/// 深度 0 就是"顶层": 走到这里时单元已经检查过, 而且 trait/impl/外部代码块都在
/// `pt_refuse` 里拒掉了, 所以顶层 `fn`/`struct`/`enum`/`const`/`capability`/`excluded`
/// 与各自的声明是**一一对应**的。函数体里的词不计数, 全靠这个深度。
fn pt_cnt_kw0(unit: ptr, t: ptr, lo: u32, hi: u32, kw: str) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, kw) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 这个深度 0 的 `fn` 是不是**本体函数**(不是外部函数声明)。
///
/// 参考实现的 `functions` 收的是 `mod.funcs`, 而 `extern fn` 另走 `mod.externs`
/// (`docs/173`) —— 裸机那几个门面里 `pub extern fn` 一片, 混进去就是两个对象。
/// 形状是固定的: 名字前面一位是 `fn`, 再前面一位就是修饰词。**`interrupt fn` 要算本体**
/// (它进的是 `mod.funcs`), 所以只认 `extern`。
fn pt_is_body_fn(unit: ptr, t: ptr, i: u32) -> u32 {
    if i < 2 {
        return 1;
    }
    if pt_tis(unit, t, i - 2, "extern") {
        return 0;
    }
    return 1;
}

/// `impl T for X` 里 `for` 的下标(没有就 `PT_NONE`)。`for` 之后才是接受者类型。
fn pt_find_for(unit: ptr, t: ptr, i: u32, hi: u32) -> u32 {
    let j: u32 = i;
    while j < hi && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "for") {
            return j;
        }
        j = j + 1;
    }
    return PT_NONE;
}

/// 本体函数个数(深度 0 的 `fn`, 减掉 `extern fn`) —— 见 `pt_cnt_fn` 上的说明。
fn pt_cnt_fn(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let its: u32 = PT_NONE;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
                if d == 0 {
                    its = PT_NONE;
                }
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            let ft: u32 = pt_find_for(unit, t, i + 1, hi);
            if ft != PT_NONE {
                its = ft + 1;
            }
        } else if pt_tis(unit, t, i, "fn") && (d == 0 || (d == 1 && its != PT_NONE)) {
            if d == 0 && pt_is_body_fn(unit, t, i + 1) == 0 {
                // `extern fn` 不进 `functions`(参考实现收在 `mod.externs`)
            } else if pt_tis(unit, t, i + 2, "<") {
                // 泛型**原件**不进 `functions` —— 它只进 `generics`, 实例由单态化追加
            } else {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// 枚举/结构体声明体 `{...}` 里"名字位置"的个数。
///
/// 状态机与检查器的 `chk_sfield_exists` 同形: **`, ` 与 `;` 都是分隔符**, 而
/// `<...>` / `[...]` / `(...)` 里的逗号不是 —— 否则 `Result<T, E>` 会被数成两个变体。
fn pt_cnt_names(unit: ptr, t: ptr, brc: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let n: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            n = n + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return n;
}

/// 带载荷的变体个数(参考实现只在这时候才写 `payloads` 这个键)。
fn pt_cnt_pay(unit: ptr, t: ptr, brc: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let n: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            if pt_tis(unit, t, j + 1, "(") {
                n = n + 1;
            }
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return n;
}

/// `guards`: 参考实现数的是 `_count_guards` —— **函数体里**的 `guard` 语句, 递归走
/// if/while/for/match 的体。token 流上就是"`guard` 后面跟一个名字再跟 `(`":
/// `let guard: u32` 那种(名字后面是 `:`)不算, 而 guard 语句的 `(` 是形状的一部分。
///
/// 不数整个单元而是数**根那一半**: 预置块里没有语句, 这不是必需 —— 是为了与"根单元
/// 才是被描述的那一个"这条口径一致。
fn pt_cnt_guards(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "guard")
                && pt_kind(t, i + 1) == 0 && pt_tis(unit, t, i + 2, "(") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 类型形参个数: `Name < A , B >` 里逗号个数 + 1。
fn pt_cnt_tps(unit: ptr, t: ptr, lt: u32, gt: u32) -> u32 {
    let n: u32 = 1;
    let j: u32 = lt + 1;
    while j < gt {
        if pt_tis(unit, t, j, ",") {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// `types` 的条数: 顶层 `struct`, **减掉带 `<T>` 的那种**。
///
/// 为什么减: 参考实现的对象取的是**单态化之后**的 `mod.structs` —— `prepare` 把声明了
/// 形参的那一类**换成**实例化出来的具体副本(名字形如 `Pair_u32`), 原件不再留在表里。
/// 所以"带 `<T>` 的声明"**不是** `types` 里的一格, 而是 `generics` 里的一格(见
/// `pt_gen_kw`)。预置枚举正是靠这条从 `enums` 里消失的 —— 它们的形参就是 `<T>`,
/// 而 `prepare` 一定会被它们触发(它那条"没有泛型就早退"的判据看的就是这个)。
fn pt_cnt_types(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "struct") && !pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `enums` 的条数 —— 与 `pt_cnt_types` 同一个理由(单态化之后的那张表)。
fn pt_cnt_enums(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "enum") && !pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 数字那一格的第二条拒绝: 量级超过 u64 的字面量。
///
/// 与 `pt_refuse` 分开是因为 `pt_num_ovf` 定义在它后面(本语言"先定义后使用")——
/// 两条都由 `potato_emit` 顺次调用。
fn pt_refuse_num(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 1 && pt_num_ovf(unit, t, i) == 1 {
            let _w: u32 = pt_wfail("fujoc-s: --emit-potato: 有个整数常量的量级超过 u64 —— 参考实现的 `int_lit` 是任意精度, 这一格只到 u64; 与其发一个回绕过的数, 不如点名 (docs/189 S1)\n");
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 类型渲染

/// 渲一个类型, 返回 `(下一个 token 下标 << 32) | 新游标`。
///
/// 形状与 `lomentc.Parser.type_name` **逐字符**同形 —— 它不是"抄原文": 原文里的
/// `[u8;16]` / `Pair<u32,u32>` 到了对象里是 `[u8; 16]` / `Pair<u32, u32>`
/// (分号/逗号后**恰好**一个空格, 数组长度**规范化成十进制**)。抄原文在语料上就会红。
///
/// 两个返回值打成一个 u64: 语言的函数没有元组, 而这是本文件里唯一需要"同时回传
/// 游标与 token 位置"的地方(递归渲染必须知道吃到哪了)。参考实现里也有这个形状
/// (`declare` 返回 `(n << 32) | o`)。
fn pt_ty(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u64 {
    let j: u32 = i;
    if pt_tis(src, t, j, "mut") && pt_tis(src, t, j + 1, "[") {
        o = pt_str(out, o, "mut [");
        let r0: u64 = pt_ty(out, o, src, t, j + 2);
        o = (r0 % 4294967296) as u32;
        j = (r0 / 4294967296) as u32;
        o = pt_str(out, o, "]");
        // 递归回来时 `j` 停在 `]` 上 —— **要吃掉它**, 否则调用方以为下一个形参就在这儿
        // (实测症状: `fill(xs: mut [u32], v: u32)` 的第二个形参名字变成 `]`、类型是空串)。
        j = j + 1;
        return (j as u64) * 4294967296 + (o as u64);
    }
    if pt_tis(src, t, j, "[") {
        o = pt_str(out, o, "[");
        let r1: u64 = pt_ty(out, o, src, t, j + 1);
        o = (r1 % 4294967296) as u32;
        j = (r1 / 4294967296) as u32;
        if pt_tis(src, t, j, ";") {
            o = pt_str(out, o, "; ");
            o = pt_num(out, o, src, t, j + 1);
            j = j + 2;
        }
        o = pt_str(out, o, "]");
        j = j + 1;   // 同上: 吃掉 `]`
        return (j as u64) * 4294967296 + (o as u64);
    }
    o = pt_mem(out, o, src, pt_off(t, j), pt_tlen(t, j));
    j = j + 1;
    if pt_tis(src, t, j, "<") {
        o = pt_str(out, o, "<");
        j = j + 1;
        while !pt_tis(src, t, j, ">") && pt_kind(t, j) != 4 {
            let r2: u64 = pt_ty(out, o, src, t, j);
            o = (r2 % 4294967296) as u32;
            j = (r2 / 4294967296) as u32;
            if pt_tis(src, t, j, ",") {
                o = pt_str(out, o, ", ");
                j = j + 1;
            }
        }
        j = j + 1;
        o = pt_str(out, o, ">");
    }
    return (j as u64) * 4294967296 + (o as u64);
}

/// 类型那一格 —— 值是一个**字符串**(上面渲染出来的那个), 所以引号加在**这一层**,
/// 不在 `pt_ty` 里: 嵌套的类型(`[u8; 16]` / `Pair<u32>`)的里层不该再带引号。
fn pt_tyq(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u64 {
    o = pt_str(out, o, "\"");
    let r: u64 = pt_ty(out, o, src, t, i);
    o = (r % 4294967296) as u32;
    o = pt_str(out, o, "\"");
    return ((r / 4294967296) as u64) * 4294967296 + (o as u64);
}

/// 类型形参名表 —— **字符串数组**(不是 `functions[].params` 那种对象数组)。
fn pt_names(out: ptr, o: u32, src: ptr, t: ptr, lt: u32, n: u32) -> u32 {
    let j: u32 = lt + 1;
    let i: u32 = 0;
    while i < n {
        o = pt_aelm(out, o, 4, i);
        o = pt_q(out, o, src, pt_off(t, j), pt_tlen(t, j));
        j = j + 1;
        if pt_tis(src, t, j, ",") {
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 开关
//
// 开关表(`switches.lomt`)每条 16 字节: 名起点 | 名长 | 标记 | token 下标。标记
// **2 = 定义**(`set choose`), 1 = 取值"开", 0 = 取值"关"; **每个出现各一条, 不去重**。
//
// 参考实现是 `[{"name": n, "on": self.state(n)} for n in sorted(self.defs)]`:
// **按名字排序**(确定性是判据 —— 同一份源必须给同一串字节), 只收**定义过**的开关。

/// 名字序: 0 = a 在 b 前, 1 = 相等, 2 = a 在 b 后。按字节比, 短的在前(与 Python 的
/// `sorted` 在 ASCII 上逐码点比同一结果)。
fn pt_sw_cmp(unit: ptr, sw: ptr, a: u32, b: u32) -> u32 {
    let la: u32 = load32(sw, a * SW_SIZE + 4);
    let lb: u32 = load32(sw, b * SW_SIZE + 4);
    let oa: u32 = load32(sw, a * SW_SIZE);
    let ob: u32 = load32(sw, b * SW_SIZE);
    let n: u32 = la;
    if lb < n {
        n = lb;
    }
    let k: u32 = 0;
    while k < n {
        let ca: u32 = load8(unit, oa + k) as u32;
        let cb: u32 = load8(unit, ob + k) as u32;
        if ca < cb {
            return 0;
        }
        if ca > cb {
            return 2;
        }
        k = k + 1;
    }
    if la < lb {
        return 0;
    }
    if la > lb {
        return 2;
    }
    return 1;
}

/// 第 `i` 条**定义**是不是同名里最靠前的那一条(去重)。
/// 重复定义本身是 E022 —— 走到这里不会发生, 但去重仍按参考实现的口径(第一条算),
/// 免得"同一个名字发两次"这种**表面绿、对象非法**的东西出去。
fn pt_def_first(unit: ptr, sw: ptr, i: u32) -> u32 {
    let j: u32 = 0;
    while j < i {
        if load32(sw, j * SW_SIZE + 8) == 2 && pt_sw_cmp(unit, sw, j, i) == 1 {
            return 0;
        }
        j = j + 1;
    }
    return 1;
}

/// 一个开关开没开: **第一个取值**说了算 (`state()` 只记首次, 之后只记重复);
/// **没写就是关**。
fn pt_sw_state(unit: ptr, sw: ptr, ns: u32, idx: u32) -> u32 {
    let i: u32 = 0;
    while i < ns {
        if load32(sw, i * SW_SIZE + 8) != 2 && pt_sw_cmp(unit, sw, i, idx) == 1 {
            return load32(sw, i * SW_SIZE + 8);
        }
        i = i + 1;
    }
    return 0;
}

fn pt_cnt_defs(unit: ptr, sw: ptr) -> u32 {
    let ns: u32 = load32(sw, MAX_CHOOSE * SW_SIZE);
    let n: u32 = 0;
    let i: u32 = 0;
    while i < ns {
        if load32(sw, i * SW_SIZE + 8) == 2 && pt_def_first(unit, sw, i) == 1 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 排序用**后继扫描**: 每一轮找"比上一轮那条大"的最小者。语言里没有数组, 拿不到
/// "排好序的索引表"; 这条是 O(n^2), 但 n 是**开关个数**(常是个位数)。
fn pt_switches(out: ptr, o: u32, unit: ptr, sw: ptr, n: u32) -> u32 {
    let ns: u32 = load32(sw, MAX_CHOOSE * SW_SIZE);
    let prev: u32 = 0;
    let have: u32 = 0;
    let ix: u32 = 0;
    let stop: u32 = 0;
    while stop == 0 {
        let best: u32 = PT_NONE;
        let i: u32 = 0;
        while i < ns {
            if load32(sw, i * SW_SIZE + 8) == 2 && pt_def_first(unit, sw, i) == 1 {
                let ok: u32 = 0;
                if have == 0 {
                    ok = 1;
                } else if pt_sw_cmp(unit, sw, i, prev) == 2 {
                    ok = 1;
                }
                if ok == 1 {
                    if best == PT_NONE || pt_sw_cmp(unit, sw, i, best) == 0 {
                        best = i;
                    }
                }
            }
            i = i + 1;
        }
        if best == PT_NONE {
            stop = 1;
        } else {
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, load32(sw, best * SW_SIZE),
                     load32(sw, best * SW_SIZE + 4));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "on");
            o = pt_bool(out, o, pt_sw_state(unit, sw, ns, best));
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
            prev = best;
            have = 1;
        }
    }
    return o;
}

// ---------------------------------------------------------------- 声明的体

/// 枚举的变体名(字符串数组)。
fn pt_variants(out: ptr, o: u32, unit: ptr, t: ptr, brc: u32, n: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            o = pt_aelm(out, o, 4, ix);
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
            ix = ix + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return o;
}

/// 带载荷的变体 —— 一个 **JSON 对象**(`{"Circle": "u32"}`), 顺序 = 变体顺序。
/// 一个都没有时**整个键都不写**(参考实现是 `**({"payloads": …} if e.payloads else {})`),
/// 所以调用方先看 `pt_cnt_pay`。
fn pt_payloads(out: ptr, o: u32, unit: ptr, t: ptr, brc: u32, lv: u32, n: u32) -> u32 {
    o = pt_str(out, o, "{\n");
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            if pt_tis(unit, t, j + 1, "(") {
                o = pt_aelm(out, o, lv + 1, ix);
                o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
                o = pt_str(out, o, ": ");
                let rp: u64 = pt_tyq(out, o, unit, t, j + 2);
                o = (rp % 4294967296) as u32;
                ix = ix + 1;
            }
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, lv);
    return pt_str(out, o, "}");
}

/// 结构体的字段 —— 对象数组(`{"name": …, "type": …}`), 顺序 = 声明顺序。
/// `lv` 是**字段对象**那一层的层号。
fn pt_fields(out: ptr, o: u32, unit: ptr, t: ptr, brc: u32, lv: u32, n: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            o = pt_aelm(out, o, lv, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, lv + 1, "name");
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, lv + 1, "type");
            // 字段的形状是定长的: 名字 `:` 类型
            let rf: u64 = pt_tyq(out, o, unit, t, j + 2);
            o = (rf % 4294967296) as u32;
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, lv);
            o = pt_str(out, o, "}");
            ix = ix + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return o;
}

/// 形参个数: `(` 到配对的 `)` 之间第 0 层的逗号数 + 1(空表是 0)。
/// **不**拿检查器符号表里的 `argc`: 那一格是给"实参个数比对"用的, 而这一格要的是
/// "声明里写了几个", 两件事在 `self` 那种形参上会分家。
fn pt_cnt_params(unit: ptr, t: ptr, lp: u32) -> u32 {
    if pt_tis(unit, t, lp + 1, ")") {
        return 0;
    }
    let n: u32 = 1;
    let j: u32 = lp + 1;
    let d: u32 = 0;
    while pt_kind(t, j) != 4 && !(pt_tis(unit, t, j, ")") && d == 0) {
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && pt_tis(unit, t, j, ",") {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// 形参表 —— 对象数组, 元素在**第 4 层**(`functions` 的元素在第 2 层, 键在第 3 层)。
///
/// 两个 `self` 的例外（参考实现的两条路，别混）：
///   * **impl 方法**的 `self`：`parse_impl` 把它改写成 `__self`，类型填**接受者类型**
///     （`Small`）—— 所以 `its` 不是 `PT_NONE` 时第一个裸 `self` 走这一支；
///   * **顶层函数**里的裸 `self`（`fn f(self)`）：`parse_fn` 给的是 `Param("self", "")`
///     —— 名字在, 类型是空串。那一支**不写字面量空串**（那会生成一个零长全局）。
fn pt_params(out: ptr, o: u32, unit: ptr, t: ptr, lp: u32, n: u32, its: u32) -> u32 {
    let j: u32 = lp + 1;
    let i: u32 = 0;
    while i < n {
        o = pt_aelm(out, o, 4, i);
        o = pt_str(out, o, "{\n");
        let has_ty: u32 = 0;
        if pt_tis(unit, t, j + 1, ":") {
            has_ty = 1;
        } else if its != PT_NONE && i == 0 {
            has_ty = 2;
        }
        o = pt_key(out, o, 5, "name");
        if has_ty == 2 {
            o = pt_qs(out, o, "__self");
        } else if has_ty == 1 {
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
        } else {
            store8(out, o, 34 as u8);
            store8(out, o + 1, 34 as u8);
            o = o + 2;
        }
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 5, "type");
        if has_ty == 1 {
            let rq: u64 = pt_tyq(out, o, unit, t, j + 2);
            o = (rq % 4294967296) as u32;
            j = (rq / 4294967296) as u32;
        } else if has_ty == 2 {
            let rq2: u64 = pt_tyq(out, o, unit, t, its);
            o = (rq2 % 4294967296) as u32;
            j = j + 1;
        } else {
            store8(out, o, 34 as u8);
            store8(out, o + 1, 34 as u8);
            o = o + 2;
            j = j + 1;
        }
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 4);
        o = pt_str(out, o, "}");
        if pt_tis(unit, t, j, ",") {
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 返回类型: `)` 后面有 `->` 就有, 否则是 `()`。
/// (`lomentc.Parser.parse_fn`: 后面是 `{` 或 `;` 就是无返回。外部函数没有函数体 ——
/// 而外部函数**本来就不进 `functions`**, 所以这里只会撞到 `{`。)
fn pt_ret(out: ptr, o: u32, unit: ptr, t: ptr, lp: u32) -> u32 {
    let rp: u32 = pt_match(unit, t, lp, "(", ")");
    let j: u32 = rp + 1;
    if pt_tis(unit, t, j, "-") && pt_tis(unit, t, j + 1, ">") {
        let rr: u64 = pt_tyq(out, o, unit, t, j + 2);
        return (rr % 4294967296) as u32;
    }
    return pt_str(out, o, "\"()\"");
}

// ---------------------------------------------------------------- 各格

/// 核心模式 (`docs/143` §3.2)。
///
/// 开关在 token 流上**已经落定过**(`apply_switches`): `choose std` / `choose no_std`
/// 是**留着**的, 其余的开关声明已被那张表吃掉。所以这里只认这两个词 —— 与参考实现
/// "看名字是不是 std/no_std" 是同一条判据。没写就是 `std`(`mod.choose or "std"`)。
fn pt_mode(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "std") || pt_tis(unit, t, i + 1, "no_std")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "std");
}

/// `capabilities`。形状是**定长**的(检查器也是照这个形状读的):
/// `capability NAME : SPACE [ LO .. HI ] (revocable)?`
/// 即 NAME=i+1, `:`=i+2, SPACE=i+3, `[`=i+4, LO=i+5, `..`=i+6,i+7, HI=i+8, `]`=i+9,
/// `revocable`=i+10(可选)。lo/hi 是**解出来的数**(参考实现 `int_lit()`), 所以走 `pt_num`。
fn pt_caps(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "capability") {
            let rev: u32 = 0;
            if pt_tis(unit, t, i + 10, "revocable") {
                rev = 1;
            }
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "domain");
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 4, "space");
            o = pt_q(out, o, unit, pt_off(t, i + 3), pt_tlen(t, i + 3));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 4, "lo");
            o = pt_num(out, o, unit, t, i + 5);
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 4, "hi");
            o = pt_num(out, o, unit, t, i + 8);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 3);
            o = pt_str(out, o, "},\n");
            o = pt_key(out, o, 3, "revocable");
            o = pt_bool(out, o, rev);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `excluded`(元素是字符串的数组)。
///
/// 自举词法器的字符串 token **含两侧引号**, 而参考实现的 `mod.excluded` 是**里面的
/// 内容** —— 所以切 `+1 / -2`。里面有 `\` 的单元在 `pt_refuse` 就被挡住了。
fn pt_excluded(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "excluded") && pt_kind(t, i + 1) == 2 {
            o = pt_aelm(out, o, 2, ix);
            o = pt_q(out, o, unit, pt_off(t, i + 1) + 1, pt_tlen(t, i + 1) - 2);
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `consts`: 形状是 `const NAME : TYPE = VALUE ;`, 所以名字后面第 2 位起就是类型。
/// 值走 `pt_num`(参考实现的对象里它是**数**, 不是原文)。
fn pt_consts(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "const") {
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "type");
            let rc: u64 = pt_tyq(out, o, unit, t, i + 3);
            o = (rc % 4294967296) as u32;
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "value");
            // 类型后面是 `=`, 值在它后面(`int_lit` 允许前面有 `-`)
            o = pt_num(out, o, unit, t, (rc / 4294967296) as u32 + 1);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `enums`。**顺序 = 声明的先后**(参考实现的 `mod.enums` 就是这个序: 根单元的枚举在前,
/// 预置的 Option/Result 由驱动器 append 在**末尾**)。
fn pt_enums(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "enum") && !pt_tis(unit, t, i + 2, "<") {
            // 名字后面可能是 `<T, E>` 再是 `{`
            let mut_j: u32 = i + 2;
            while !pt_tis(unit, t, mut_j, "{") && pt_kind(t, mut_j) != 4 {
                mut_j = mut_j + 1;
            }
            let brc: u32 = mut_j;
            let nv: u32 = pt_cnt_names(unit, t, brc);
            let np: u32 = pt_cnt_pay(unit, t, brc);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "variants");
            o = pt_aopen(out, o, nv);
            o = pt_variants(out, o, unit, t, brc, nv);
            o = pt_acls(out, o, 3, nv);
            if np > 0 {
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "payloads");
                o = pt_payloads(out, o, unit, t, brc, 3, np);
            }
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `types`(结构体)。字段是**对象数组**, 元素在第 4 层。
fn pt_types(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "struct") && !pt_tis(unit, t, i + 2, "<") {
            let mut_j: u32 = i + 2;
            while !pt_tis(unit, t, mut_j, "{") && pt_kind(t, mut_j) != 4 {
                mut_j = mut_j + 1;
            }
            let brc: u32 = mut_j;
            let nf: u32 = pt_cnt_names(unit, t, brc);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "fields");
            o = pt_aopen(out, o, nf);
            o = pt_fields(out, o, unit, t, brc, 4, nf);
            o = pt_acls(out, o, 3, nf);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- trait / impl
//
// 参考实现的 `traits`/`impls` 收的是**原始视图**（`raw_mod` —— 单态化之前那份）：
//
//   traits: [{"name": "Measurable", "methods": ["area"]}]
//   impls:  [{"trait": "Measurable", "for": "Rect", "methods": ["area"]}]
//
// 检查器把 impl 方法压成了 `K_METHOD`（trait 名与接受者名都不留），所以这两格只能回
// token 流重扫 —— 形状是定长的：`trait NAME { fn M ( … ) -> R ; … }`、
// `impl TRAIT for TYPE { fn M ( … ) { … } }`。

/// `trait` 的个数（深度 0）。
fn pt_cnt_traits(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "trait") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `impl` 的个数（深度 0，**不含 `impl` 块里的方法** —— 那算 `functions`）。
fn pt_cnt_impls(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 块内的 `fn` 个数（`trait` 的签名式方法与 `impl` 的方法都是这个形状）。
fn pt_cnt_block_fn(unit: ptr, t: ptr, brc: u32, end: u32) -> u32 {
    let n: u32 = 0;
    let j: u32 = brc + 1;
    while j < end && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "fn") {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// 块内的 `fn` 名字（字符串数组）。
fn pt_block_fn_names(out: ptr, o: u32, unit: ptr, t: ptr, brc: u32, end: u32, n: u32) -> u32 {
    let j: u32 = brc + 1;
    let ix: u32 = 0;
    while j < end && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "fn") {
            o = pt_aelm(out, o, 4, ix);
            o = pt_q(out, o, unit, pt_off(t, j + 1), pt_tlen(t, j + 1));
            ix = ix + 1;
        }
        j = j + 1;
    }
    return o;
}

/// 从 `i` 起找第一个文本等于 `ch` 的 token（`PT_NONE` = 没有）。
fn pt_find_ch(unit: ptr, t: ptr, i: u32, hi: u32, ch: str) -> u32 {
    let j: u32 = i;
    while j < hi && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, ch) {
            return j;
        }
        j = j + 1;
    }
    return PT_NONE;
}

fn pt_traits(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "trait") {
            let brc: u32 = pt_find_ch(unit, t, i + 1, hi, "{");
            let end: u32 = pt_match(unit, t, brc, "{", "}");
            let nm: u32 = pt_cnt_block_fn(unit, t, brc, end);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "methods");
            o = pt_aopen(out, o, nm);
            o = pt_block_fn_names(out, o, unit, t, brc, end, nm);
            o = pt_acls(out, o, 3, nm);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

fn pt_impls(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            // `impl TRAIT for TYPE { … }`：trait 在 `impl` 后一位, 类型在 `for` 后一位
            let ft: u32 = pt_find_for(unit, t, i + 1, hi);
            let brc: u32 = pt_find_ch(unit, t, i + 1, hi, "{");
            let end: u32 = pt_match(unit, t, brc, "{", "}");
            let nm: u32 = pt_cnt_block_fn(unit, t, brc, end);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "trait");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "for");
            let r: u64 = pt_tyq(out, o, unit, t, ft + 1);
            o = (r % 4294967296) as u32;
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "methods");
            o = pt_aopen(out, o, nm);
            o = pt_block_fn_names(out, o, unit, t, brc, end, nm);
            o = pt_acls(out, o, 3, nm);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 函数名那一格: 顶层是名字本身; impl 方法要写成 `<接受者>_<方法名>`
/// （参考实现的 `parse` 在收 impl 时就 `f.name = f"{im.type}_{f.name}"`，对象里是改过名的）。
fn pt_fn_name(out: ptr, o: u32, unit: ptr, t: ptr, ntok: u32, its: u32) -> u32 {
    if its == PT_NONE {
        return pt_q(out, o, unit, pt_off(t, ntok), pt_tlen(t, ntok));
    }
    store8(out, o, 34 as u8);
    o = o + 1;
    let r: u64 = pt_ty(out, o, unit, t, its);
    o = (r % 4294967296) as u32;
    store8(out, o, 95 as u8);
    o = o + 1;
    o = pt_mem(out, o, unit, pt_off(t, ntok), pt_tlen(t, ntok));
    store8(out, o, 34 as u8);
    return o + 1;
}

/// `functions`。名字在 `fn` 后面一位, 形参表从它后面那个 `(` 起 —— 泛型函数是
/// `fn f<T>(…)`, 所以 `(` 的位置要**扫**出来(参考实现的 `chk_find_paren` 也是这么做的)。
/// 自写的泛型在 `pt_refuse` 被挡住, 所以这里撞到的 `<` 只可能来自……没有。留着这个扫描
/// 是因为"顺着 token 找下一个 `(`"比"假设它就在下一位"少一条隐藏前提。
fn pt_functions(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let its: u32 = PT_NONE;      // 当前 impl 的接受者类型起点(`impl T for X` 里 X 的位置)
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
                if d == 0 {
                    its = PT_NONE;
                }
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            let ft: u32 = pt_find_for(unit, t, i + 1, hi);
            if ft != PT_NONE {
                its = ft + 1;
            }
        } else if pt_tis(unit, t, i, "fn")
                && (d == 0 || (d == 1 && its != PT_NONE)) {
            let skip: u32 = 0;
            if d == 0 {
                if pt_is_body_fn(unit, t, i + 1) == 0 {
                    skip = 1;    // `extern fn` 不进 `functions`
                }
            }
            if pt_tis(unit, t, i + 2, "<") {
                skip = 1;        // 泛型原件：实例由单态化追加（见 pt_fn_insts）
            }
            if skip == 0 {
                let mut_j: u32 = i + 2;
                while !pt_tis(unit, t, mut_j, "(") && pt_kind(t, mut_j) != 4 {
                    mut_j = mut_j + 1;
                }
                let lp: u32 = mut_j;
                let np: u32 = pt_cnt_params(unit, t, lp);
                o = pt_aelm(out, o, 2, ix);
                o = pt_str(out, o, "{\n");
                o = pt_key(out, o, 3, "name");
                // impl 方法的名字是**改过名的**: `<接受者>_<方法名>`
                o = pt_fn_name(out, o, unit, t, i + 1, its);
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "params");
                o = pt_aopen(out, o, np);
                o = pt_params(out, o, unit, t, lp, np, its);
                o = pt_acls(out, o, 3, np);
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "ret");
                o = pt_ret(out, o, unit, t, lp);
                o = pt_str(out, o, "\n");
                o = pt_ind(out, o, 2);
                o = pt_str(out, o, "}");
                ix = ix + 1;
            }
        }
        i = i + 1;
    }
    return o;
}


/// `generics` 的条数 —— 与 `pt_gen_kw` 同一个条件(带 `<` 的 `enum`)。
/// 计数与发射各走一遍是这一格的统一做法(见前面"计数"那一节)。
fn pt_cnt_gen(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "enum") && pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}


/// 带形参的声明个数 —— **只看一种关键字**(`kw` = `fn` / `struct` / `enum`)。
/// 参考实现的 `generics` 是三段拼起来的(`fn` 在前、再 struct、再 enum), 所以要分开数。
fn pt_cnt_gen_kw(unit: ptr, t: ptr, lo: u32, hi: u32, kw: str) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, kw) && pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 一种关键字那一类（`fn` / `struct` / `enum`）的 `generics` 条目, `ix0` 是起始下标。
/// 形状与参考实现一致: `{"kind": "fn"|"type", "name": …, "params": [类型形参名]}`。
fn pt_gen_kw(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32,
             kw: str, kind: str, ix0: u32) -> u32 {
    let ix: u32 = ix0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, kw) && pt_tis(unit, t, i + 2, "<") {
            let gt: u32 = pt_match(unit, t, i + 2, "<", ">");
            let np: u32 = pt_cnt_tps(unit, t, i + 2, gt);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "kind");
            o = pt_qs(out, o, kind);
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "params");
            o = pt_aopen(out, o, np);
            o = pt_names(out, o, unit, t, i + 2, np);
            o = pt_acls(out, o, 3, np);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 泛型函数的单态化（M6）
//
// 对象这一半只做**泛型函数**：`generics`（声明那一格）与 `instances`（单态化出来的那一格），
// 以及**函数表被替换**（泛型原件从 `functions` 里消失、实例按创建顺序追加到末尾）。
//
// 参考实现的 M6 走 AST + 完整类型推断；这里走 token 流 + 一张**局部变量表**，实参只收两种
// 能定死类型的形态（标识符 → 查表；`x as T` → T）。**其余一律点名拒绝** —— 跳过会让对象
// 少一格实例，而"少一格"看起来完全正常（这正是这一格最怕的那种错）。
//
// 泛型**类型**（`struct S<T>` / `enum E<T>` 的实例化）还没做：那一类要先做 M7 的
// "收类型串 → 按串排序 → 批量实例化"，所以 `pt_refuse` 里那条边界留着。

/// brk 分配（`sys_alloc` 是驱动器的私有函数，这里自己来一份）。
fn pt_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

// 工作区（一次拿一整块，游标都放在区块尾巴上，不占形参）：
//   [0, 8192)       名字池：实例名（`Base_arg1_arg2`）
//   [8192, 10240)   实例表：64 条 × 32 字节
//   [10240, 12288)  实参表：64 条 × 32 字节（每条最多 4 对"类型起点/终点" token）
//   [12288, 36864)  局部变量表：1536 条 × 16 字节（名字 token / 类型起点 / 类型终点 / 块深度）
//   [36864]         实例条数   [36868] 名字池游标   [36872] 局部变量条数
//   [36876, 36940)  泛型函数的**名字 token**（16 条 × 4）—— 每次调用点都要查，所以先收好
//   [36940]         泛型函数条数
const PT_POOL: u32 = 0;
const PT_TAB: u32 = 8192;
const PT_ATAB: u32 = 10240;
const PT_ENV: u32 = 12288;
const PT_N: u32 = 36864;
const PT_PC: u32 = 36868;
const PT_EN: u32 = 36872;
const PT_GFN: u32 = 36876;
const PT_NG: u32 = 36940;
const PT_MAX: u32 = 64;
const PT_EMAX: u32 = 1536;
const PT_AMAX: u32 = 4;
const PT_GMAX: u32 = 16;
const PT_TMPA: u32 = 36944;      // 一次调用点的实参类型区间（按**形参序**，4 对）
const PT_TMPB: u32 = 36976;      // 同一批按**类型形参序**整理后的那份（4 对）
const PT_TMPC: u32 = 37008;      // 每个类型形参"见过没"（4 格 u32）
const PT_SC_BYTES: u64 = 37032;

// 实例表一条（32 字节）
const PE_NAME: u32 = 0;      // 名字在池里的起点
const PE_NLEN: u32 = 4;      // 名字长度
const PE_BASE: u32 = 8;      // 实例名的起点？（占位）—— 见 PE_DECL
const PE_DECL: u32 = 8;      // 那个泛型声明的名字 token
const PE_LT: u32 = 12;       // 声明的 `<` token（类型形参从那一位之后开始）
const PE_NTP: u32 = 16;      // 类型形参个数
const PE_NARG: u32 = 20;     // 实参个数
const PE_IOFF: u32 = 24;     // 实参表里的下标（每条 32 字节）

// 局部变量表一条（16 字节）
const EV_NAME: u32 = 0;      // 名字 token
const EV_TS: u32 = 4;        // 类型起点 token
const EV_TE: u32 = 8;        // 类型终点 token（不含）
const EV_D: u32 = 12;        // 块深度（`}` 一收就丢这一层）

fn pt_sc_new() -> ptr {
    let v: u64 = pt_alloc(PT_SC_BYTES);
    let sc: ptr = v as ptr;
    store32(sc, PT_N, 0);
    store32(sc, PT_PC, 0);
    store32(sc, PT_EN, 0);
    return sc;
}

fn pt_same(src: ptr, t: ptr, a: u32, b: u32) -> u32 {
    if pt_kind(t, a) != 0 || pt_kind(t, b) != 0 {
        return 0;
    }
    let la: u32 = pt_tlen(t, a);
    if la != pt_tlen(t, b) {
        return 0;
    }
    let oa: u32 = pt_off(t, a);
    let ob: u32 = pt_off(t, b);
    let k: u32 = 0;
    while k < la {
        if (load8(src, oa + k) as u32) != (load8(src, ob + k) as u32) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// 在两个指针上按字节比 `n` 个字节（池内的名字之间比）。
fn pt_pool_eq(a: ptr, ao: u32, al: u32, b: ptr, bo: u32, bl: u32) -> u32 {
    if al != bl {
        return 0;
    }
    let k: u32 = 0;
    while k < al {
        if (load8(a, ao + k) as u32) != (load8(b, bo + k) as u32) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// 实例名：`<基名>_<实参1>_<实参2>`（参考实现是 `base + "_" + "_".join(args)`）。
/// 渲进名字池，返回 `(池内起点 << 32) | 长度`。
fn pt_inst_name(sc: ptr, unit: ptr, t: ptr, base_tok: u32, ags: ptr, narg: u32) -> u64 {
    let po: u32 = load32(sc, PT_PC);
    let st: u32 = po;
    let bo: u32 = pt_off(t, base_tok);
    let bl: u32 = pt_tlen(t, base_tok);
    let k: u32 = 0;
    while k < bl {
        store8(sc, po, load8(unit, bo + k) as u8);
        po = po + 1;
        k = k + 1;
    }
    let a: u32 = 0;
    while a < narg {
        store8(sc, po, 95 as u8);
        po = po + 1;
        let r: u64 = pt_ty(sc, po, unit, t, load32(ags, a * 8));
        po = (r % 4294967296) as u32;
        a = a + 1;
    }
    store32(sc, PT_PC, po);
    return (st as u64) * 4294967296 + ((po - st) as u64);
}

/// 名字池里有没有同名的实例（键就是名字：`max_of_u32` 唯一决定 `(max_of, [u32])`）。
fn pt_inst_find(sc: ptr, noff: u32, nlen: u32) -> u32 {
    let n: u32 = load32(sc, PT_N);
    let i: u32 = 0;
    while i < n {
        let e: u32 = PT_TAB + i * 32;
        if pt_pool_eq(sc, load32(sc, e + PE_NAME), load32(sc, e + PE_NLEN),
                      sc, noff, nlen) == 1 {
            return i;
        }
        i = i + 1;
    }
    return PT_NONE;
}

/// 类型渲染的**替换版**：类型形参那个 token 换成实参类型的 token 区间。
/// 形状与 `pt_ty` 完全一致（它是 `pt_ty` 加两处钩子），递归时用自己。
fn pt_ty_sub(out: ptr, o: u32, unit: ptr, t: ptr, i: u32,
             lt: u32, ntp: u32, ags: ptr) -> u64 {
    let j: u32 = i;
    // 钩子①: 名字位置上如果是类型形参 -> 换成实参的类型（形参在 lt+1, lt+3, …）
    if pt_kind(t, j) == 0 && !pt_tis(unit, t, j, "mut") {
        let k: u32 = 0;
        while k < ntp {
            if pt_same(unit, t, j, lt + 1 + k * 2) == 1 {
                let r0: u64 = pt_ty(out, o, unit, t, load32(ags, k * 8));
                o = (r0 % 4294967296) as u32;
                return ((j + 1) as u64) * 4294967296 + (o as u64);
            }
            k = k + 1;
        }
    }
    if pt_tis(unit, t, j, "mut") && pt_tis(unit, t, j + 1, "[") {
        o = pt_str(out, o, "mut [");
        let r1: u64 = pt_ty_sub(out, o, unit, t, j + 2, lt, ntp, ags);
        o = (r1 % 4294967296) as u32;
        j = (r1 / 4294967296) as u32;
        o = pt_str(out, o, "]");
        return ((j + 1) as u64) * 4294967296 + (o as u64);
    }
    if pt_tis(unit, t, j, "[") {
        o = pt_str(out, o, "[");
        let r2: u64 = pt_ty_sub(out, o, unit, t, j + 1, lt, ntp, ags);
        o = (r2 % 4294967296) as u32;
        j = (r2 / 4294967296) as u32;
        if pt_tis(unit, t, j, ";") {
            o = pt_str(out, o, "; ");
            o = pt_num(out, o, unit, t, j + 1);
            j = j + 2;
        }
        o = pt_str(out, o, "]");
        return ((j + 1) as u64) * 4294967296 + (o as u64);
    }
    o = pt_mem(out, o, unit, pt_off(t, j), pt_tlen(t, j));
    j = j + 1;
    if pt_tis(unit, t, j, "<") {
        o = pt_str(out, o, "<");
        j = j + 1;
        while !pt_tis(unit, t, j, ">") && pt_kind(t, j) != 4 {
            let r3: u64 = pt_ty_sub(out, o, unit, t, j, lt, ntp, ags);
            o = (r3 % 4294967296) as u32;
            j = (r3 / 4294967296) as u32;
            if pt_tis(unit, t, j, ",") {
                o = pt_str(out, o, ", ");
                j = j + 1;
            }
        }
        j = j + 1;
        o = pt_str(out, o, ">");
    }
    return (j as u64) * 4294967296 + (o as u64);
}

/// 局部变量表：压一条。满了**不写**（调用方在进函数前先查 `PT_EN < PT_EMAX` 再走，
/// 所以这里是"到不了"的那一支 —— 本语言没有裸 `return;`，所以写成 if/else）。
fn pt_env_put(sc: ptr, name_tok: u32, ts: u32, te: u32, d: u32) {
    let n: u32 = load32(sc, PT_EN);
    if n < PT_EMAX {
        let e: u32 = PT_ENV + n * 16;
        store32(sc, e + EV_NAME, name_tok);
        store32(sc, e + EV_TS, ts);
        store32(sc, e + EV_TE, te);
        store32(sc, e + EV_D, d);
        store32(sc, PT_EN, n + 1);
    }
}

/// 局部变量表：按名字令牌**从后往前**查（最近的 `let` 赢，与作用域语义一致）。
/// 返回 `(类型起点 << 32) | 类型终点`；没找到返回 `PT_NONE`（当 u64 用不了，用 0 表示）。
fn pt_env_get(sc: ptr, unit: ptr, t: ptr, name_tok: u32) -> u64 {
    let n: u32 = load32(sc, PT_EN);
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        let e: u32 = PT_ENV + i * 16;
        if pt_same(unit, t, load32(sc, e + EV_NAME), name_tok) == 1 {
            return (load32(sc, e + EV_TS) as u64) * 4294967296 + (load32(sc, e + EV_TE) as u64);
        }
    }
    return 0;
}

/// 弹掉深度 > `d` 的局部（一个块收了）。**没有裸 `return;`**，所以用"边弹边判"的写法。
fn pt_env_pop(sc: ptr, d: u32) {
    let n: u32 = load32(sc, PT_EN);
    let go: u32 = 1;
    while n > 0 && go == 1 {
        let e: u32 = PT_ENV + (n - 1) * 16;
        if load32(sc, e + EV_D) <= d {
            go = 0;
        } else {
            n = n - 1;
        }
    }
    store32(sc, PT_EN, n);
}

/// 一个实参的**类型 token 区间**（`(起点 << 32) | 终点`），定不出来就是 0。
/// 只收两种形态：标识符（查局部表）与 `x as T`（取 `as` 后面那个类型）。
fn pt_arg_ty(sc: ptr, unit: ptr, t: ptr, i: u32, hi: u32) -> u64 {
    let j: u32 = i;
    if pt_kind(t, j) == 0 && pt_kind(t, j + 1) == 0 && pt_tis(unit, t, j + 1, "as") {
        let ts: u32 = j + 2;
        let te: u32 = pt_ty_end(unit, t, ts, hi);
        return (ts as u64) * 4294967296 + (te as u64);
    }
    if pt_kind(t, j) == 0 && pt_kind(t, j + 1) != 0 {
        return pt_env_get(sc, unit, t, j);
    }
    return 0;
}

/// 一个类型的结束 token（不含）—— 与 `pt_ty` 的吃法一致，只是不写输出。
fn pt_ty_end(unit: ptr, t: ptr, i: u32, hi: u32) -> u32 {
    let j: u32 = i;
    if pt_tis(unit, t, j, "mut") {
        j = j + 1;
    }
    if pt_tis(unit, t, j, "[") {
        let d: u32 = 0;
        while j < hi && pt_kind(t, j) != 4 {
            if pt_tis(unit, t, j, "[") {
                d = d + 1;
            }
            if pt_tis(unit, t, j, "]") {
                d = d - 1;
                if d == 0 {
                    return j + 1;
                }
            }
            j = j + 1;
        }
        return j;
    }
    j = j + 1;
    if pt_tis(unit, t, j, "<") {
        let d2: u32 = 0;
        while j < hi && pt_kind(t, j) != 4 {
            if pt_tis(unit, t, j, "<") {
                d2 = d2 + 1;
            }
            if pt_tis(unit, t, j, ">") {
                d2 = d2 - 1;
                if d2 == 0 {
                    return j + 1;
                }
            }
            j = j + 1;
        }
        return j;
    }
    return j;
}

/// 先把**泛型函数声明**的名字 token 收进工作区（`fn NAME <`）。每次调用点都要查，
/// 逐次扫全单元是 O(调用点 × token)，不能那么干；泛型声明本来就只有个位数。
/// 超上限（16）返回 1 = 拒绝。
fn pt_gfn_scan(sc: ptr, unit: ptr, t: ptr, nt: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if pt_tis(unit, t, i, "fn") && pt_kind(t, i + 1) == 0
                && pt_tis(unit, t, i + 2, "<") {
            // **impl 块里的泛型方法**不收：那类实例的第一个形参是 `self`（要改名成 `__self`
            // 并填接受者类型），这一节没做 —— 报出来比发错好。
            if d != 0 {
                return 1;
            }
            if n >= PT_GMAX {
                return 1;
            }
            store32(sc, PT_GFN + n * 4, i + 1);
            n = n + 1;
        }
        i = i + 1;
    }
    store32(sc, PT_NG, n);
    return 0;
}

/// 这个 token 是哪个泛型函数的**声明名**？返回声明处的名字 token（`PT_NONE` = 不是）。
fn pt_gfn_find(sc: ptr, unit: ptr, t: ptr, name_tok: u32) -> u32 {
    let n: u32 = load32(sc, PT_NG);
    let k: u32 = 0;
    while k < n {
        let d: u32 = load32(sc, PT_GFN + k * 4);
        if pt_same(unit, t, d, name_tok) == 1 {
            return d;
        }
        k = k + 1;
    }
    return PT_NONE;
}

/// 加一个实例（名字已经在池里了）。返回新条数；满了返回 `PT_MAX + 1` = 拒绝。
fn pt_inst_add(sc: ptr, noff: u32, nlen: u32, decl: u32, lt: u32,
               ntp: u32, narg: u32, ags: ptr) -> u32 {
    let n: u32 = load32(sc, PT_N);
    if n >= PT_MAX {
        return PT_MAX + 1;
    }
    let e: u32 = PT_TAB + n * 32;
    store32(sc, e + PE_NAME, noff);
    store32(sc, e + PE_NLEN, nlen);
    store32(sc, e + PE_DECL, decl);
    store32(sc, e + PE_LT, lt);
    store32(sc, e + PE_NTP, ntp);
    store32(sc, e + PE_NARG, narg);
    store32(sc, e + PE_IOFF, n * 32);
    let a: u32 = 0;
    while a < narg {
        store32(sc, PT_ATAB + n * 32 + a * 8, load32(ags, a * 8));
        store32(sc, PT_ATAB + n * 32 + a * 8 + 4, load32(ags, a * 8 + 4));
        a = a + 1;
    }
    store32(sc, PT_N, n + 1);
    return n + 1;
}

/// 一次调用点：实参类型定得出来就建实例（同名已存在就复用）。
/// 返回 0 = 成（或者"推不出形参、本来就该跳过"），1 = 拒绝（实参形态超出子集）。
fn pt_mono_call(sc: ptr, unit: ptr, t: ptr, nt: u32, decl: u32, lp: u32, narg: u32) -> u32 {
    let lt: u32 = decl + 1;                       // 声明名后面那个 `<`
    let gt: u32 = pt_match(unit, t, lt, "<", ">");
    let ntp: u32 = pt_cnt_tps(unit, t, lt, gt);
    if narg > PT_AMAX || ntp > PT_AMAX {
        return 1;                                 // 形参/实参过多：子集外
    }
    // 实参的类型 token 区间（定不出来 = 0）
    let ags: ptr = ptr_add(sc, PT_TMPA);
    let j: u32 = lp + 1;
    let a: u32 = 0;
    while a < narg {
        // 实参是"表达式"，这里只收两种形态（见 `pt_arg_ty` 的注释）
        let ty: u64 = pt_arg_ty(sc, unit, t, j, nt);
        if ty == 0 {
            return 1;                             // 定不出类型：点子集之外，点名拒
        }
        store32(ags, a * 8, (ty / 4294967296) as u32);
        store32(ags, a * 8 + 4, (ty % 4294967296) as u32);
        // 走到下一个顶层逗号（括号/方括号/尖括号里的不算）—— **没有 `break`**，
        // 所以用 `go` 标志；`j` 停在逗号上时再 +1（与参考实现的 `accept(",")` 同形）。
        let d: u32 = 0;
        let go: u32 = 1;
        while j < nt && pt_kind(t, j) != 4 && go == 1 {
            if pt_tis(unit, t, j, "(") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "<") {
                d = d + 1;
            }
            if pt_tis(unit, t, j, ")") || pt_tis(unit, t, j, "]") || pt_tis(unit, t, j, ">") {
                if d == 0 {
                    go = 0;
                } else {
                    d = d - 1;
                }
            }
            if go == 1 {
                if d == 0 && pt_tis(unit, t, j, ",") {
                    j = j + 1;
                    go = 0;
                } else {
                    j = j + 1;
                }
            }
        }
        a = a + 1;
    }
    let st: u64 = pt_targs(sc, unit, t, nt, decl, ntp, narg);
    let code: u32 = (st % 4294967296) as u32;
    if code == 2 {
        return 1;                          // 拒绝：形参类型里有切片/数组套着类型形参
    }
    if code == 1 {
        return 0;                          // 跳过：推不出全部形参（参考实现也不建实例）
    }
    let noff: u32 = load32(sc, PT_TMPC + 16);
    let nlen: u32 = load32(sc, PT_TMPC + 20);
    if pt_inst_find(sc, noff, nlen) != PT_NONE {
        return 0;
    }
    let dst: ptr = ptr_add(sc, PT_TMPB);
    let r: u32 = pt_inst_add(sc, noff, nlen, decl, lt, ntp, ntp, dst);
    if r > PT_MAX {
        return 1;
    }
    return 0;
}

/// 两段 token 的**原文**相等吗（长度 + 逐 token 逐字节）—— 比的是类型串本身。
fn pt_span_eq(src: ptr, t: ptr, a: u32, ae: u32, b: u32, be: u32) -> u32 {
    if ae - a != be - b {
        return 0;
    }
    let i: u32 = 0;
    while i < ae - a {
        if pt_tlen(t, a + i) != pt_tlen(t, b + i) {
            return 0;
        }
        let oa: u32 = pt_off(t, a + i);
        let ob: u32 = pt_off(t, b + i);
        let k: u32 = 0;
        while k < pt_tlen(t, a + i) {
            if (load8(src, oa + k) as u32) != (load8(src, ob + k) as u32) {
                return 0;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return 1;
}

/// 把"按形参序收好的实参类型"整理成**按类型形参序**（参考实现的 `_infer_targs`），
/// 顺便把名字建出来。返回 `(名字 << 32) | 结果`：结果 1 = 跳过（推不出全部形参，
/// 或者同一个形参被推成两个类型 —— 参考实现在这两种情况下**都不建实例**），
/// 2 = 拒绝（形参类型里有切片/数组套着类型形参 —— 那一支还没做）。
fn pt_targs(sc: ptr, unit: ptr, t: ptr, nt: u32, decl: u32, ntp: u32, narg: u32) -> u64 {
    let lt: u32 = decl + 1;
    let src: ptr = ptr_add(sc, PT_TMPA);
    let dst: ptr = ptr_add(sc, PT_TMPB);
    let seen: ptr = ptr_add(sc, PT_TMPC);
    let k: u32 = 0;
    while k < PT_AMAX {
        store32(seen, k * 4, 0);
        k = k + 1;
    }
    let dlp: u32 = pt_find_ch(unit, t, decl + 1, nt, "(");
    let j: u32 = dlp + 1;
    let a: u32 = 0;
    while a < narg && j < nt && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, ")") {
            a = narg;                       // 形参比实参少：不该发生（检查器担保）
        } else {
            let ts: u32 = j + 2;            // 形参名 `:` 类型
            let te: u32 = pt_ty_end(unit, t, ts, nt);
            if pt_kind(t, ts) == 0 && te == ts + 1 {
                // 单名类型：是类型形参就记下来，不是就**不管**（参考实现只映形参）
                let m: u32 = 0;
                while m < ntp {
                    if pt_same(unit, t, ts, lt + 1 + m * 2) == 1 {
                        if load32(seen, m * 4) == 1 {
                            // 同一个形参推成**两个不同**的类型 -> 参考实现返回 None -> 不建实例。
                            // ⚠ 推成**同一个**类型是合法的（`fn f<T>(a: T, b: T)` 正是这样），
                            // 所以这里比的是类型本身，不是"见没见过"。
                            let s1: u32 = load32(dst, m * 8);
                            let e1: u32 = load32(dst, m * 8 + 4);
                            let s2: u32 = load32(src, a * 8);
                            let e2: u32 = load32(src, a * 8 + 4);
                            if pt_span_eq(unit, t, s1, e1, s2, e2) == 0 {
                                return (0 as u64) * 4294967296 + 1;
                            }
                        } else {
                            store32(seen, m * 4, 1);
                            store32(dst, m * 8, load32(src, a * 8));
                            store32(dst, m * 8 + 4, load32(src, a * 8 + 4));
                        }
                    }
                    m = m + 1;
                }
            } else {
                // 切片/数组（或别的复合形）：里面出现类型形参就是没做的那一支
                let q: u32 = ts;
                while q < te {
                    let m2: u32 = 0;
                    while m2 < ntp {
                        if pt_same(unit, t, q, lt + 1 + m2 * 2) == 1 {
                            return (0 as u64) * 4294967296 + 2;
                        }
                        m2 = m2 + 1;
                    }
                    q = q + 1;
                }
            }
            j = te;
            if pt_tis(unit, t, j, ",") {
                j = j + 1;
            }
            a = a + 1;
        }
    }
    // 形参没全推出来 -> 不建实例（与参考实现的 `all(t in m …)` 同一条）
    let m3: u32 = 0;
    while m3 < ntp {
        if load32(seen, m3 * 4) == 0 {
            return (0 as u64) * 4294967296 + 1;
        }
        m3 = m3 + 1;
    }
    let nm2: u64 = pt_inst_name(sc, unit, t, decl, dst, ntp);
    store32(sc, PT_TMPC + 16, (nm2 / 4294967296) as u32);
    store32(sc, PT_TMPC + 20, (nm2 % 4294967296) as u32);
    return 0;
}

/// 走一个函数体：维护局部变量表，遇到泛型调用就建实例。返回 1 = 拒绝。
fn pt_mono_body(sc: ptr, unit: ptr, t: ptr, nt: u32, brc: u32, body_end: u32,
                in_gen: u32) -> u32 {
    let d: u32 = 1;                    // 函数体那一层
    let j: u32 = brc + 1;
    while j < body_end && pt_kind(t, j) != 4 {
        let k: u32 = pt_kind(t, j);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, j)) as u32;
            if c == 123 {
                d = d + 1;
            }
            if c == 125 {
                d = d - 1;
                pt_env_pop(sc, d);
            }
        } else if k == 0 {
            if pt_tis(unit, t, j, "let") && pt_kind(t, j + 1) == 0 && pt_tis(unit, t, j + 2, ":") {
                let ts: u32 = j + 3;
                let te: u32 = pt_ty_end(unit, t, ts, nt);
                pt_env_put(sc, j + 1, ts, te, d);
            } else if pt_kind(t, j + 1) == 3 && pt_tis(unit, t, j + 1, "(") {
                let decl: u32 = pt_gfn_find(sc, unit, t, j);
                if decl != PT_NONE {
                    // **泛型函数体里再调泛型函数**（链式单态化）没做：参考实现靠 8 轮
                    // 迭代（它会走**实例**的体，那时 T 已经被换成具体类型），而这里只走
                    // 单元本体、看到的实参类型还是 `T` —— 会造出 `min_T` 这种**错的**实例名。
                    // 静默的错比拒绝坏，所以点名拒。
                    if in_gen == 1 {
                        return 2;
                    }
                    // 实参个数：`(` 到配对的 `)` 之间顶层逗号 + 1
                    let rp: u32 = pt_match(unit, t, j + 1, "(", ")");
                    let narg: u32 = pt_cnt_params(unit, t, j + 1);
                    let rc: u32 = pt_mono_call(sc, unit, t, nt, decl, j + 1, narg);
                    if rc != 0 {
                        return 1;
                    }
                    j = rp;
                }
            }
        }
        j = j + 1;
    }
    return 0;
}

/// 走单元里**每个函数体**（根与依赖都走 —— 参考实现单态化的是整个程序）。
fn pt_mono_all(sc: ptr, unit: ptr, t: ptr, nt: u32) -> u32 {
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "fn") {
            let lp: u32 = pt_find_ch(unit, t, i + 1, nt, "(");
            let brc: u32 = pt_find_ch(unit, t, i + 1, nt, "{");
            let be: u32 = pt_match(unit, t, brc, "{", "}");
            // 形参进局部表（`self` 那种由 impl 那条路管，这里不碰）
            let n: u32 = load32(sc, PT_EN);
            let _n0: u32 = n;
            let j: u32 = lp + 1;
            let d: u32 = 1;
            while j < brc && pt_kind(t, j) != 4 {
                if pt_kind(t, j) == 0 && pt_tis(unit, t, j + 1, ":") {
                    let ts: u32 = j + 2;
                    let te: u32 = pt_ty_end(unit, t, ts, nt);
                    pt_env_put(sc, j, ts, te, d);
                    j = te;
                }
                j = j + 1;
            }
            let is_gen: u32 = 0;
            if pt_tis(unit, t, i + 2, "<") {
                is_gen = 1;
            }
            let mrc: u32 = pt_mono_body(sc, unit, t, nt, brc, be, is_gen);
            if mrc != 0 {
                if mrc == 2 { return 2; }
                return 1;
            }
            store32(sc, PT_EN, 0);        // 每个函数一张新表（与参考实现同口径）
            i = be;
        }
        i = i + 1;
    }
    return 0;
}

/// 名字池里的一段按 **JSON 字符串**写出（实例名都是标识符+数字+下划线，无需转义）。
fn pt_pool_q(out: ptr, o: u32, sc: ptr, off: u32, n: u32) -> u32 {
    store8(out, o, 34 as u8);
    o = o + 1;
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(sc, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store8(out, o, 34 as u8);
    return o + 1;
}

/// 一个 fn 实例的形参表：与 `pt_params` 同形，但类型走**替换版**（类型形参 -> 实参类型）。
fn pt_params_sub(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lp: u32, n: u32, e: u32) -> u32 {
    let j: u32 = lp + 1;
    let i: u32 = 0;
    while i < n {
        o = pt_aelm(out, o, 4, i);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 5, "name");
        o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 5, "type");
        o = pt_str(out, o, "\"");
        let lt: u32 = load32(sc, PT_TAB + e * 32 + PE_LT);
        let ntp: u32 = load32(sc, PT_TAB + e * 32 + PE_NTP);
        let aio: ptr = ptr_add(sc, PT_ATAB + load32(sc, PT_TAB + e * 32 + PE_IOFF));
        let r: u64 = pt_ty_sub(out, o, unit, t, j + 2, lt, ntp, aio);
        o = (r % 4294967296) as u32;
        j = (r / 4294967296) as u32;
        o = pt_str(out, o, "\"");
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 4);
        o = pt_str(out, o, "}");
        if pt_tis(unit, t, j, ",") {
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `functions` 里的那些实例条目（参考实现把它们**追加在非泛型函数之后**）。
fn pt_fn_insts(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, ix0: u32) -> u32 {
    let n: u32 = load32(sc, PT_N);
    let ix: u32 = ix0;
    let i: u32 = 0;
    while i < n {
        let e: u32 = PT_TAB + i * 32;
        let decl: u32 = load32(sc, e + PE_DECL);
        let lp: u32 = pt_find_ch(unit, t, decl + 1, decl + 400, "(");
        let rp: u32 = pt_match(unit, t, lp, "(", ")");
        let np: u32 = pt_cnt_params(unit, t, lp);
        o = pt_aelm(out, o, 2, ix);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 3, "name");
        o = pt_pool_q(out, o, sc, load32(sc, e + PE_NAME), load32(sc, e + PE_NLEN));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "params");
        o = pt_aopen(out, o, np);
        o = pt_params_sub(out, o, sc, unit, t, lp, np, i);
        o = pt_acls(out, o, 3, np);
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "ret");
        o = pt_str(out, o, "\"");
        let lt: u32 = load32(sc, e + PE_LT);
        let ntp: u32 = load32(sc, e + PE_NTP);
        let aio: ptr = ptr_add(sc, PT_ATAB + load32(sc, e + PE_IOFF));
        let j: u32 = rp + 1;
        if pt_tis(unit, t, j, "-") && pt_tis(unit, t, j + 1, ">") {
            let r: u64 = pt_ty_sub(out, o, unit, t, j + 2, lt, ntp, aio);
            o = (r % 4294967296) as u32;
        } else {
            o = pt_str(out, o, "()");
        }
        o = pt_str(out, o, "\"");
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 2);
        o = pt_str(out, o, "}");
        ix = ix + 1;
        i = i + 1;
    }
    return o;
}

/// `instances` 那一格（这一节只发 `kind: "fn"` 的 —— 泛型**类型**的实例还没做）。
fn pt_instances(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        let e: u32 = PT_TAB + i * 32;
        let decl: u32 = load32(sc, e + PE_DECL);
        let narg: u32 = load32(sc, e + PE_NARG);
        let aio: ptr = ptr_add(sc, PT_ATAB + load32(sc, e + PE_IOFF));
        o = pt_aelm(out, o, 2, i);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 3, "kind");
        o = pt_qs(out, o, "fn");
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "name");
        o = pt_pool_q(out, o, sc, load32(sc, e + PE_NAME), load32(sc, e + PE_NLEN));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "of");
        o = pt_q(out, o, unit, pt_off(t, decl), pt_tlen(t, decl));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "args");
        o = pt_aopen(out, o, narg);
        let a: u32 = 0;
        while a < narg {
            o = pt_aelm(out, o, 4, a);
            o = pt_str(out, o, "\"");
            let r: u64 = pt_ty(out, o, unit, t, load32(aio, a * 8));
            o = (r % 4294967296) as u32;
            o = pt_str(out, o, "\"");
            a = a + 1;
        }
        o = pt_acls(out, o, 3, narg);
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 2);
        o = pt_str(out, o, "}");
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 入口

/// 发一个单元的 Potato v5 对象, 返回写出的字节数。**0 = 拒绝** —— 话已经打到 stderr,
/// 调用方据此以 1 退出(与那些"超限报错, 绝不静默丢"的判据同一种形状)。
///
/// 键的顺序与参考实现**逐字对齐**(`emit_potato` 那个字面量 dict 的顺序): 对象是拿
/// 字节比的, 顺序也在比较面里。
pub fn potato_emit(unit: ptr, t: ptr, nt: u32, sw: ptr, out: ptr) -> u32 {
    let rr: u64 = pt_root_range(unit, t, nt);
    if rr == PT_NONE as u64 {
        return pt_wfail("fujoc-s: --emit-potato: 单元里一个 `module` 都没有 (参考实现的前门也是这一条)\n");
    }
    let lo: u32 = (rr / 4294967296) as u32;
    let hi: u32 = (rr % 4294967296) as u32;
    // 预置块的起点: `pt_root_range` 只在"根后面紧跟 `__prelude`"时把 `hi` 指到它身上,
    // 所以 `hi < nt` **就是**"有预置块"。
    let pre: u32 = PT_NONE;
    if hi < nt {
        pre = hi;
    }
    // `generics` 只有一类来源: 预置的 Option/Result(它们带 `<T>`)。根自己的泛型声明在
    // `pt_refuse` 里被拒了, 所以这一格扫**预置块**那一小段就够了 —— 见 `pt_cnt_gen` 的注释。
    let glo: u32 = lo;
    let ghi: u32 = lo;
    if pre != PT_NONE {
        glo = pre;
        ghi = nt;
    }
    // 两条拒绝都是"自己把话打了 + 返回 1" —— 话在函数里就打出去了, 这里只把它翻成
    // "没发出东西"(返回 0)。**空串不当哨兵**: 那会生成一个零长的字符串全局
    // (`[0 x i8] c""`), 而它正是那个把 genesis 链接器绊倒的东西(见文件末那条注释)。
    if pt_refuse(unit, t, lo, hi, pre, nt) == 1 {
        return 0;
    }
    if pt_refuse_num(unit, t, lo, hi) == 1 {
        return 0;
    }
    // ---- 单态化（M6）：先收泛型函数的名字，再走一遍所有函数体建实例。
    // **在计数之前**做完 —— 实例要追加进 `functions`/`instances` 两格。
    // 指针**不能比相等/大小**：参考实现的 codegen 会发出 `icmp == ptr`（**非法 IR**，
    // clang 与 Python 链接器都拒）。所以失败判定在 u64 上做（brk 返回 0 = 失败）。
    let scv: u64 = pt_alloc(PT_SC_BYTES);
    if scv == 0 {
        return pt_wfail("fujoc-s: --emit-potato: brk 失败 (单态化工作区)\n");
    }
    let sc: ptr = scv as ptr;
    store32(sc, PT_N, 0);
    store32(sc, PT_PC, 0);
    store32(sc, PT_EN, 0);
    store32(sc, PT_NG, 0);
    if pt_gfn_scan(sc, unit, t, nt) == 1 {
        return pt_wfail("fujoc-s: --emit-potato: 泛型函数声明超出这一节 (impl 块里的泛型方法 / 超过 16 个)\n");
    }
    if load32(sc, PT_NG) > 0 {
        let mrc: u32 = pt_mono_all(sc, unit, t, nt);
        if mrc == 2 {
            return pt_wfail("fujoc-s: --emit-potato: 链式泛型 —— 泛型**函数体里**再调泛型函数 (参考实现靠 8 轮迭代走**实例**的体, 这里只走单元本体, 会把实参类型当成 `T` 造出错的实例名); 没做\n");
        }
        if mrc == 1 {
            return pt_wfail("fujoc-s: --emit-potato: 泛型调用点的实参形态超出这一节 (只收标识符与 `x as T`; `p.a` 那种字段访问还没做)\n");
        }
    }
    let nins: u32 = load32(sc, PT_N);
    let nfn: u32 = pt_cnt_fn(unit, t, lo, hi);
    let nst: u32 = pt_cnt_types(unit, t, lo, hi);
    let nen: u32 = pt_cnt_enums(unit, t, lo, hi);
    let nco: u32 = pt_cnt_kw0(unit, t, lo, hi, "const");
    let ncp: u32 = pt_cnt_kw0(unit, t, lo, hi, "capability");
    let nex: u32 = pt_cnt_kw0(unit, t, lo, hi, "excluded");
    let ndf: u32 = pt_cnt_defs(unit, sw);
    let ngu: u32 = pt_cnt_guards(unit, t, lo, hi);
    // `generics` 是三段拼的（参考实现: `[fn 的] + [struct 的] + [enum 的]`），
    // 最后再加上**预置块**里的枚举（Option/Result）。
    let ngf: u32 = pt_cnt_gen_kw(unit, t, lo, hi, "fn");
    let ngs: u32 = pt_cnt_gen_kw(unit, t, lo, hi, "struct");
    let nge: u32 = pt_cnt_gen_kw(unit, t, lo, hi, "enum");
    let ngp: u32 = pt_cnt_gen(unit, t, glo, ghi);
    let ngi: u32 = ngf + ngs + nge + ngp;
    let ntr: u32 = pt_cnt_traits(unit, t, lo, hi);
    let npl: u32 = pt_cnt_impls(unit, t, lo, hi);
    let nim: u32 = pt_cnt_imports(unit, t, lo);
    let o: u32 = 0;
    o = pt_str(out, o, "{\n");
    o = pt_key(out, o, 1, "potato");
    o = pt_qs(out, o, "v5");
    o = pt_str(out, o, ",\n");
    // `unit` 是**根**那份源的 `module` 名 —— 依赖在前, 所以它是根那个标记后面的名字
    // (不是第 1 个 token: 那是第一个依赖的名字)。
    o = pt_key(out, o, 1, "unit");
    o = pt_q(out, o, unit, pt_off(t, lo + 1), pt_tlen(t, lo + 1));
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "language");
    o = pt_qs(out, o, "loment");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "mode");
    o = pt_mode(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "switches");
    o = pt_aopen(out, o, ndf);
    o = pt_switches(out, o, unit, sw, ndf);
    o = pt_acls(out, o, 1, ndf);
    o = pt_str(out, o, ",\n");
    // 两格恒空, 且**每一条都在别处被挡过**(不是"没实现所以写空"):
    //   dialects —— 驱动器在 comefor 展开过之后就不让走这条路
    //   bodies   —— 外部代码块在检查**之前**就被驱动器拒了
    o = pt_key(out, o, 1, "dialects");
    o = pt_str(out, o, "[]");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "bodies");
    o = pt_str(out, o, "[]");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "imports");
    o = pt_aopen(out, o, nim);
    o = pt_imports(out, o, unit, t, lo, nim);
    o = pt_acls(out, o, 1, nim);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "capabilities");
    o = pt_aopen(out, o, ncp);
    o = pt_caps(out, o, unit, t, lo, hi, ncp);
    o = pt_acls(out, o, 1, ncp);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "functions");
    o = pt_aopen(out, o, nfn + nins);
    o = pt_functions(out, o, unit, t, lo, hi, nfn);
    o = pt_fn_insts(out, o, sc, unit, t, nfn);
    o = pt_acls(out, o, 1, nfn + nins);
    o = pt_str(out, o, ",\n");
    // layouts: 来自 L0 装载 (`use "xxx.lom"`) —— 第 1 条边界把它连同 `use` 一起挡了
    o = pt_key(out, o, 1, "layouts");
    o = pt_str(out, o, "[]");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "consts");
    o = pt_aopen(out, o, nco);
    o = pt_consts(out, o, unit, t, lo, hi, nco);
    o = pt_acls(out, o, 1, nco);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "enums");
    o = pt_aopen(out, o, nen);
    o = pt_enums(out, o, unit, t, lo, hi, nen);
    o = pt_acls(out, o, 1, nen);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "types");
    o = pt_aopen(out, o, nst);
    o = pt_types(out, o, unit, t, lo, hi, nst);
    o = pt_acls(out, o, 1, nst);
    o = pt_str(out, o, ",\n");
    // traits / impls: `pt_refuse` 挡住了带这两类声明的单元
    o = pt_key(out, o, 1, "traits");
    o = pt_aopen(out, o, ntr);
    o = pt_traits(out, o, unit, t, lo, hi, ntr);
    o = pt_acls(out, o, 1, ntr);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "impls");
    o = pt_aopen(out, o, npl);
    o = pt_impls(out, o, unit, t, lo, hi, npl);
    o = pt_acls(out, o, 1, npl);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "generics");
    o = pt_aopen(out, o, ngi);
    o = pt_gen_kw(out, o, unit, t, lo, hi, "fn", "fn", 0);
    o = pt_gen_kw(out, o, unit, t, lo, hi, "struct", "type", ngf);
    o = pt_gen_kw(out, o, unit, t, lo, hi, "enum", "type", ngf + ngs);
    o = pt_gen_kw(out, o, unit, t, glo, ghi, "enum", "type", ngf + ngs + nge);
    o = pt_acls(out, o, 1, ngi);
    o = pt_str(out, o, ",\n");
    // instances: 单态化实例 —— 这一节只发泛型**函数**的（泛型类型的实例还没做）
    o = pt_key(out, o, 1, "instances");
    o = pt_aopen(out, o, nins);
    o = pt_instances(out, o, sc, unit, t, nins);
    o = pt_acls(out, o, 1, nins);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "guards");
    o = pt_dec(out, o, ngu as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "excluded");
    o = pt_aopen(out, o, nex);
    o = pt_excluded(out, o, unit, t, lo, hi, nex);
    o = pt_acls(out, o, 1, nex);
    o = pt_str(out, o, "\n");
    o = pt_str(out, o, "}");
    return pt_str(out, o, "\n");
}
