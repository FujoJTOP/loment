module ir_index

// M82 目标文件：**数组/切片下标**。钉的是**下标的 GEP 类型**与**下标的算式类型**：
//
//   * `i: u64` 的 `a[i]` 必须发 `i64 %` —— 写成 `i32` 就是**不合法的 LLVM IR**
//     （`lomelf` 按 GEP 里写的类型读下标，于是悄悄截断，所以这个 bug 一直看不见；见 `docs/212` §4）；
//   * 算式里 `a[2]` 的类型必须是**元素**（`mul i64`），**不是**数组（`mul [4 x i64]`）。
//
// 两条都让 IR 喂得进 LLVM（`clang`），也就是"外包"那条路的前提。

fn sum_dyn(i: u64) -> u64 {
    let a: [u64; 4] = [10, 20, 30, 40];
    return a[i] + a[i] * 3;
}

fn sum_const() -> u64 {
    let a: [u64; 4] = [1, 2, 3, 4];
    return a[2] * 5 + a[0];
}

fn fill(m: mut [u32], n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        m[i] = i * 7;
        i = i + 1;
    }
    return m[1];
}
