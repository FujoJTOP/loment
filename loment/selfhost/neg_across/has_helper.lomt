module has_helper

// 跨模块同名负例 (依赖侧): 与入口模块 entry.lomt 都声明了私有 `helper`。
//
// 为什么这必须是编译期错误: **单元的发射符号是平的** —— 内核线按名字找入口
// (`_start` / `timer_isr`, 见 docs/155 §3), 所以私有符号不能靠 mangling 变成模块限定名。
// 平名字的代价就是"一个单元里顶层名字必须唯一": 否则后端会发出两条 `define @helper`
// (非法 IR), 调用点还会解析到同一个函数 (静默错编)。
//
// 见 docs/150 缺口①。

fn helper(x: u32) -> u32 {
    return x + 1;
}

pub fn dep_pub(x: u32) -> u32 {
    return helper(x);
}
