module lib

// 跨文件负例 (依赖侧): 库不许写 `choose` (docs/143 §3.2)。
//
// 为什么这是**装载器**规则而不是检查器规则: 单元拼完之后检查器拿到的是一整块 token,
// 模块边界已经没了 —— 它分不清这一句 choose 是入口写的还是被 use 进来的。只有 load_file
// 知道自己在第几层 (depth)。**用户侧的理由**更重要: 库该声明的是**能力需求**
// (docs/168), 由项目决定模式; 库自己钉死模式就等于替用它的人做决定。
//
// 与 E018 同构 —— 那也是装载器规则, 进不了 `loment_rule_parity._CASES` (它喂的是
// 自包含单文件源码), 所以棘轮由驱动闸门承担, `BUDGET` 不动。见 docs/158 §5。

choose std

pub fn dep_pub(x: u32) -> u32 {
    return x + 1;
}
