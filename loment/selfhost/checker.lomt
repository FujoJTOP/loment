module checker

// M81 (子集): Loment 版类型/符号检查 —— 消费 M79 token 流, 判定程序是否合法。
// 覆盖规则 (与 Python 版 lomentc.check 的判定对照):
//   E-DUP-NAME    : 顶层名字重复 (fn/struct/enum/const) + 字段/变体/形参重名
//   E-UNKNOWN-TYPE: 声明里的类型未声明 (参数/返回/字段/变体载荷/let)
//   E-UNKNOWN-FN  : 调用未声明的函数
//   E-ARITY       : 实参个数与声明/内建签名不符
//   E-DEF         : 类型名为基类型 / 结构体或枚举为空
//   E-CAP         : 能力重复声明 / 域 lo>hi / 占用 excluded 空间 / guard 未声明或越界
//   E-CONST-TYPE  : 常量类型不是整型
// 批次 1 = **声明级**规则 (只吃 token 流, 不需要表达式类型推断);
// 表达式类型那一批 (E001 的各种"两侧类型对不上") 还没搬过来 —— 见 docs/150 缺口表。
// 输出: 每条错误 8 字节 (code u32 | tok u32); 返回错误条数。
use "loment/examples/bytes.lomt"
use "loment/selfhost/lexer.lomt"

const K_FN: u32 = 1;
const K_STRUCT: u32 = 2;
const K_ENUM: u32 = 3;
const K_CONST: u32 = 4;
const K_TPARAM: u32 = 5;   // 泛型形参 (`fn f<T>` 里的 T): 只当类型名用

// 错误码 = 项目统一口径 `loment_diag.RULES` (E001–E017) 的**数字部分**。
// 自举 checker 与参考实现的对照判据 = 两边**码集相等**, 所以码值必须取自同一张表 ——
// 以前这里自定义 1..4, 与 loment_diag 的分类对不上 (E_DUP=1 vs E013=13 之类)。
const E_DUP: u32 = 13;     // E013 重名
const E_TYPE: u32 = 2;     // E002 符号未声明 (含"类型未声明"/"未定义的函数")
const E_FN: u32 = 2;
const E_ARITY: u32 = 3;    // E003 实参数量不符
const E_CAP: u32 = 4;      // E004 能力域非法
const E_DEF: u32 = 9;      // E009 类型名非法 (与基类型同名 / 类型为空)
const E_TMISMATCH: u32 = 1;  // E001 类型不匹配 (常量"类型必须是整型"也归这一码)
const E_LVAL: u32 = 14;    // E014 赋值目标不是左值
const E_ARR: u32 = 16;     // E016 数组字面量非法 (长度不符)

// 类型编码 (批次 2): 一个 u32 —— 0 = 未知, 其它按 (kind << TY_KIND_SHIFT) + payload。
//   kind 1 = 基类型 (payload = 1..11 的内码)
//   kind 2 = 具名类型 (payload = 名字 token 下标)
// 为什么用 token 下标而不是字符串: 声明处的类型与推断出来的类型**都是同一份源码里的
// 同一个 token**, 所以"相等"退化成"同一个 token"或"同一段 token 文本" —— 不需要造
// 字符串缓冲, 也不会踩到规范化(空格/分号后空格)的两套写法。
// 复合类型 (数组/切片/泛型实例) 一律记 0 = 未知: 保守方向**只可能少报**, 不会假阳性,
// 而假阳性会被语料测试 (40/40 零诊断) 立刻抓住。
const TY_KIND_SHIFT: u32 = 28;
const TY_K_NAMED: u32 = 2;
const TY_BOOL: u32 = 268435465;   // (1 << 28) + 9
const TY_U32: u32 = 268435459;    // (1 << 28) + 3
const K_INT_MIN: u32 = 1;   // 内码 1..8 = u8..i64
const K_INT_MAX: u32 = 8;

/// 基类型名 -> 内码 (非基类型 -> 0)。
fn chk_base_code(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "u8") {
        return 1;
    }
    if chk_tok_is(src, t, i, "u16") {
        return 2;
    }
    if chk_tok_is(src, t, i, "u32") {
        return 3;
    }
    if chk_tok_is(src, t, i, "u64") {
        return 4;
    }
    if chk_tok_is(src, t, i, "i8") {
        return 5;
    }
    if chk_tok_is(src, t, i, "i16") {
        return 6;
    }
    if chk_tok_is(src, t, i, "i32") {
        return 7;
    }
    if chk_tok_is(src, t, i, "i64") {
        return 8;
    }
    if chk_tok_is(src, t, i, "bool") {
        return 9;
    }
    if chk_tok_is(src, t, i, "str") {
        return 10;
    }
    if chk_tok_is(src, t, i, "ptr") {
        return 11;
    }
    return 0;
}

/// 类型位置的首 token -> 类型编码 (见 TY_* 说明)。
///
/// 两个"不建模"的出口, 都是为了**不假阳性**:
///   - `Name<...>` (泛型实例): 类型是复合的, 而且参考实现跑在**单态化之后**的模块上
///     (`mod.funcs` 里的泛型已被实例替换、调用点的名字也改写了), 所以它的类型串里
///     不会出现 `T`。token 版够不着单态化, 一律记未知。
///   - 类型形参 `T` (符号表里 K_TPARAM): 同一个 `T` 在不同函数里含义不同, 记未知。
fn chk_ty_of_tok(src: ptr, t: ptr, s: ptr, n: u32, i: u32) -> u32 {
    if chk_tok_kind(t, i) != 0 {
        return 0;
    }
    let b: u32 = chk_base_code(src, t, i);
    if b != 0 {
        return (1 << TY_KIND_SHIFT) + b;
    }
    if chk_tok_is(src, t, i + 1, "<") {
        return 0;
    }
    let slot: u32 = chk_lookup_slot(src, t, s, n, i);
    if slot == 0 {
        return (TY_K_NAMED << TY_KIND_SHIFT) + i;   // 未声明名字: 用 token 本身当身份
    }
    if load32(s, (slot - 1) * 16 + 4) == K_TPARAM {
        return 0;
    }
    return (TY_K_NAMED << TY_KIND_SHIFT) + (slot - 1);
}

fn chk_ty_is_int(v: u32) -> u32 {
    if v >> TY_KIND_SHIFT != 1 {
        return 0;
    }
    let c: u32 = v % (1 << TY_KIND_SHIFT);
    if c >= K_INT_MIN && c <= K_INT_MAX {
        return 1;
    }
    return 0;
}

/// 内建函数的返回类型编码 (镜像 lomentc.BUILTINS 的第二项); 非内建 -> 0。
/// 表写错 = 语料上立刻出假阳性 (这是拿语料测试当护栏的地方之一)。
fn chk_builtin_ret(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "str_eq") {
        return (1 << TY_KIND_SHIFT) + 9;          // bool
    }
    if chk_tok_is(src, t, i, "str_concat") {
        return (1 << TY_KIND_SHIFT) + 10;         // str
    }
    if chk_tok_is(src, t, i, "alloc") || chk_tok_is(src, t, i, "str_ptr")
            || chk_tok_is(src, t, i, "ptr_add") || chk_tok_is(src, t, i, "ptr_sub") {
        return (1 << TY_KIND_SHIFT) + 11;         // ptr
    }
    if chk_tok_is(src, t, i, "get_bits") || chk_tok_is(src, t, i, "set_bits") {
        return (1 << TY_KIND_SHIFT) + 1;          // u8
    }
    if chk_tok_is(src, t, i, "syscall4") || chk_tok_is(src, t, i, "syscall6") {
        return (1 << TY_KIND_SHIFT) + 8;          // i64
    }
    // 其余内建 (str_len/str_byte/panic/free/load8/store8/atomic_add/inb/outb/slice_len)
    // 参考实现里都返回 u32; 非内建返回 0。
    if chk_builtin_arity(src, t, i) != 999999 {
        return (1 << TY_KIND_SHIFT) + 3;
    }
    return 0;
}

// 符号表条目: 名字 token 下标 u32 | kind u32 | 参数个数 u32 | 返回类型编码 u32 (16 字节)
// 返回类型是批次 2 加的: `return` 的类型比对要查被调函数的返回类型, 单靠 (名字, 元数)
// 查不出来。stride 从 12 改成 16 时**所有字段偏移都要一起改** —— 漏一处就会读到
// 相邻条目的字节, 症状是"码偶尔对偶尔错"(地址相关)。
fn sym_get(t: ptr, s: ptr, n: u32, i: u32) -> u32 {
    return load32(s, i * 16);
}

fn sym_pub(src: ptr, t: ptr, p: ptr, o: u32, code: u32, tok: u32) -> u32 {
    store32(p, o, code);
    store32(p, o + 4, tok);
    return o + 8;
}

fn chk_tok_kind(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20);
}

fn tok_start(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 4);
}

fn tok_len(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 8);
}

/// token 原文是否等于 s。
fn chk_tok_is(src: ptr, t: ptr, i: u32, s: str) -> bool {
    if tok_len(t, i) != str_len(s) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(s) {
        if load8(src, tok_start(t, i) + k) != str_byte(s, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// 名字 token 是否等于 s。
fn same(src: ptr, t: ptr, i: u32, j: u32) -> bool {
    if chk_tok_kind(t, i) != 0 || chk_tok_kind(t, j) != 0 {
        return false;
    }
    if tok_len(t, i) != tok_len(t, j) {
        return false;
    }
    let k: u32 = 0;
    while k < tok_len(t, i) {
        if load8(src, tok_start(t, i) + k) != load8(src, tok_start(t, j) + k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn is_base_type(src: ptr, t: ptr, i: u32) -> bool {
    if chk_tok_kind(t, i) != 0 {
        return false;
    }
    if chk_tok_is(src, t, i, "u8") || chk_tok_is(src, t, i, "u16") || chk_tok_is(src, t, i, "u32")
        || chk_tok_is(src, t, i, "u64") || chk_tok_is(src, t, i, "i8") || chk_tok_is(src, t, i, "i16")
        || chk_tok_is(src, t, i, "i32") || chk_tok_is(src, t, i, "i64") || chk_tok_is(src, t, i, "bool")
        || chk_tok_is(src, t, i, "str") || chk_tok_is(src, t, i, "ptr") {
        return true;
    }
    return false;
}

fn is_builtin(src: ptr, t: ptr, i: u32) -> bool {
    let k: u32 = 0;
    let names: str = "str_len str_eq str_concat str_byte slice_len panic alloc free load8 store8 atomic_add inb outb get_bits set_bits str_ptr ptr_add ptr_sub syscall4 syscall6";
    // 逐词比较 (内建名用空格分隔的常量表); 新增内建要同步这里, 否则调用点报假 E-UNKNOWN-FN
    let off: u32 = 0;
    while off < str_len(names) {
        let b: u32 = 0;
        let n: u32 = 0;
        while off + n < str_len(names) && str_byte(names, off + n) != 32 {
            n = n + 1;
        }
        if n > 0 && tok_len(t, i) == n {
            let j: u32 = 0;
            let ok: u32 = 1;
            while j < n {
                if load8(src, tok_start(t, i) + j) != str_byte(names, off + j) {
                    ok = 0;
                }
                j = j + 1;
            }
            if ok == 1 {
                return true;
            }
        }
        off = off + n + 1;
        k = k + 1;
    }
    return false;
}

/// 顶层名字查表: 返回槽位+1 (0 = 未找到)。调用方按 stride 16 读各字段。
fn chk_lookup_slot(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if same(src, t, sym_get(t, s, n, i), name_tok) {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 登记顶层名字; 重复 -> 产出 E-DUP。
fn declare(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32, kind: u32,
           argc: u32, ret: u32, p: ptr, o: u32) -> u64 {
    if chk_lookup_slot(src, t, s, n, name_tok) != 0 {
        return (n as u64) * 4294967296 + (sym_pub(src, t, p, o, E_DUP, name_tok) as u64);
    }
    store32(s, n * 16, name_tok);
    store32(s, n * 16 + 4, kind);
    store32(s, n * 16 + 8, argc);
    store32(s, n * 16 + 12, ret);
    return ((n + 1) as u64) * 4294967296 + (o as u64);
}

/// 类型位置检查: 支持 [T]/[T; N]/mut [T] 或已声明名字; 未声明 -> E-TYPE。
fn check_type(src: ptr, t: ptr, s: ptr, n: u32, i: u32, p: ptr, o: u32) -> u64 {
    if chk_tok_is(src, t, i, "[") || chk_tok_is(src, t, i, "mut") {
        return (i as u64) * 4294967296 + (o as u64);
    }
    if is_base_type(src, t, i) {
        return (i as u64) * 4294967296 + (o as u64);
    }
    if chk_tok_kind(t, i) == 0 {
        if chk_lookup_slot(src, t, s, n, i) != 0 {
            return (i as u64) * 4294967296 + (o as u64);
        }
    }
    return (i as u64) * 4294967296 + (sym_pub(src, t, p, o, E_TYPE, i) as u64);
}

/// 从 i 起找下一个 '(' 的下标 (处理泛型 `<T>` 前缀)。
/// 注意前缀 `chk_`: 本编译器的符号表是**全单元扁平**的, `codegen.lomt` 里也有同名的
/// 私有函数 —— 同单元里两处定义会撞名 (函数撞名会连带撞字符串全局名, 直接是非法 IR)。
fn chk_find_paren(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "(") && !chk_tok_is(src, t, j, "{") {
        j = j + 1;
    }
    return j;
}

/// 跳过完整类型 (含 `[T]` / `[T; N]` / `mut [T]` / `Pair<u32>`), 返回类型之后的下标。
/// 泛型实参必须一起跳掉: 只吃下 `Pair` 的话, 后面的 `<` `u32` `>` 会被当成下一个形参,
/// 于是一串假 E-TYPE (codegen 的 `skip_type` 当初也是漏了 `<...>` 才踩同一个坑)。
/// 前缀 `chk_` 的理由同 `chk_find_paren` (扁平符号表)。
fn chk_skip_type(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    if chk_tok_is(src, t, j, "mut") {
        j = j + 1;
    }
    if chk_tok_is(src, t, j, "[") {
        j = j + 1;
        while !chk_tok_is(src, t, j, "]") && chk_tok_kind(t, j) != 4 {
            j = j + 1;
        }
        return j + 1;
    }
    j = j + 1;
    if chk_tok_is(src, t, j, "<") {
        while !chk_tok_is(src, t, j, ">") && chk_tok_kind(t, j) != 4 {
            j = j + 1;
        }
        j = j + 1;
    }
    return j;
}

/// `fn f<T, U>` / `struct S<T>` / `enum E<T>`: 把 `<...>` 里的名字登记成类型名,
/// 返回新的符号个数。**不能走 declare** —— 它会报 E-DUP, 而"两个声明各用 T"是合法的。
fn decl_tparams(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32) -> u32 {
    let j: u32 = name_tok + 1;
    if !chk_tok_is(src, t, j, "<") {
        return n;
    }
    let k: u32 = j + 1;
    let c: u32 = n;
    while chk_tok_kind(t, k) != 4 && !chk_tok_is(src, t, k, ">") {
        if chk_tok_kind(t, k) == 0 {
            store32(s, c * 16, k);
            store32(s, c * 16 + 4, K_TPARAM);
            store32(s, c * 16 + 8, 0);
            store32(s, c * 16 + 12, 0);
            c = c + 1;
        }
        k = k + 1;
    }
    return c;
}

/// 关键字: 后面就算跟 `(` 也不是函数调用 (`return (a)`、`if (b)`、`return (x, y)`)。
fn chk_is_kw(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "return") || chk_tok_is(src, t, i, "if")
            || chk_tok_is(src, t, i, "while") || chk_tok_is(src, t, i, "for")
            || chk_tok_is(src, t, i, "match") || chk_tok_is(src, t, i, "guard")
            || chk_tok_is(src, t, i, "let") || chk_tok_is(src, t, i, "fn")
            || chk_tok_is(src, t, i, "struct") || chk_tok_is(src, t, i, "enum")
            || chk_tok_is(src, t, i, "const") || chk_tok_is(src, t, i, "use")
            || chk_tok_is(src, t, i, "as") || chk_tok_is(src, t, i, "mut")
            || chk_tok_is(src, t, i, "pub") || chk_tok_is(src, t, i, "interrupt")
            || chk_tok_is(src, t, i, "trait") || chk_tok_is(src, t, i, "impl")
            || chk_tok_is(src, t, i, "else") || chk_tok_is(src, t, i, "break")
            || chk_tok_is(src, t, i, "continue") {
        return 1;
    }
    return 0;
}

/// 从 `struct`/`enum`/`trait` 这类声明处的 `{` 跳到匹配的 `}` 之后。
fn chk_skip_body(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "{") {
        j = j + 1;
    }
    let d: u32 = 0;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "{") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, "}") {
            d = d - 1;
            if d == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 整型基类型 (镜像 lomentc.INT_TYPES; **bool 不算** —— 常量的类型必须是整型)。
fn chk_is_int(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "u8") || chk_tok_is(src, t, i, "u16") || chk_tok_is(src, t, i, "u32")
        || chk_tok_is(src, t, i, "u64") || chk_tok_is(src, t, i, "i8") || chk_tok_is(src, t, i, "i16")
        || chk_tok_is(src, t, i, "i32") || chk_tok_is(src, t, i, "i64") {
        return 1;
    }
    return 0;
}

/// 十进制字面量 token -> 数值 (能力域上下界用; 参考实现的 int_lit 只吃 number,
/// 所以这里不必处理负号/进制前缀)。
fn chk_dec(src: ptr, t: ptr, i: u32) -> u32 {
    let n: u32 = tok_len(t, i);
    let v: u32 = 0;
    let k: u32 = 0;
    while k < n {
        let c: u32 = load8(src, tok_start(t, i) + k) as u32;
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
        }
        k = k + 1;
    }
    return v;
}

/// name_tab 里有没有跟 i 同文的 token (表项 = token 下标, 4 字节一项)。
/// 字段/变体/形参的重名判定都用它 —— 参考实现是 set[str], 这里等价于 set[token 文本]。
fn chk_tab_has(src: ptr, t: ptr, tab: ptr, n: u32, i: u32) -> u32 {
    let k: u32 = 0;
    while k < n {
        if same(src, t, load32(tab, k * 4), i) {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

/// 从 i 起找 `{` 的下标。
fn chk_find_brace(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "{") {
        j = j + 1;
    }
    return j;
}

/// `struct S { ... }` 的字段: 重名 -> E-DUP; 类型未声明 -> E-TYPE; 没有字段 -> E-DEF。
/// lb = `{` 的下标; 返回 (后一项下标 << 32) | o。
fn chk_struct_body(src: ptr, t: ptr, s: ptr, n: u32, lb: u32, name_tok: u32,
                   tab: ptr, p: ptr, o: u32) -> u64 {
    let j: u32 = lb + 1;
    let c: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if chk_tab_has(src, t, tab, c, j) == 1 {
            o = sym_pub(src, t, p, o, E_DUP, j);
        }
        store32(tab, c * 4, j);
        c = c + 1;
        j = j + 1;
        if chk_tok_is(src, t, j, ":") {
            j = j + 1;
            let r: u64 = check_type(src, t, s, n, j, p, o);
            o = (r % 4294967296) as u32;
            j = chk_skip_type(src, t, j);
        }
        if chk_tok_is(src, t, j, ",") {
            j = j + 1;
        }
    }
    if c == 0 {
        o = sym_pub(src, t, p, o, E_DEF, name_tok);
    }
    return ((j + 1) as u64) * 4294967296 + (o as u64);
}

/// `enum E { ... }` 的变体: 重名 -> E-DUP; 载荷类型未声明 -> E-TYPE; 没有变体 -> E-DEF。
fn chk_enum_body(src: ptr, t: ptr, s: ptr, n: u32, lb: u32, name_tok: u32,
                 tab: ptr, p: ptr, o: u32) -> u64 {
    let j: u32 = lb + 1;
    let c: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if chk_tok_kind(t, j) == 0 {
            if chk_tab_has(src, t, tab, c, j) == 1 {
                o = sym_pub(src, t, p, o, E_DUP, j);
            }
            store32(tab, c * 4, j);
            c = c + 1;
            j = j + 1;
            if chk_tok_is(src, t, j, "(") {
                let r: u64 = check_type(src, t, s, n, j + 1, p, o);
                o = (r % 4294967296) as u32;
                j = chk_skip_type(src, t, j + 1);
                if chk_tok_is(src, t, j, ")") {
                    j = j + 1;
                }
            }
        } else {
            j = j + 1;
        }
        if chk_tok_is(src, t, j, ",") {
            j = j + 1;
        }
    }
    if c == 0 {
        o = sym_pub(src, t, p, o, E_DEF, name_tok);
    }
    return ((j + 1) as u64) * 4294967296 + (o as u64);
}

/// `capability NAME : SPACE [ LO .. HI ] (revocable)?` —— **只登记不判错**。
/// 判错必须等整个单元扫完: 参考实现是在 parse 完成后拿 mod.caps / mod.excluded
/// 一起比的, 所以"先写能力再用 excluded 声明同一空间"也必须报 (顺序无关)。
/// token 布局是**定长**的 (parser 的形状固定): NAME=i+1, ':'=i+2, SPACE=i+3,
/// '['=i+4, LO=i+5, '.'=i+6, '.'=i+7, HI=i+8, ']'=i+9。返回后一项下标。
fn chk_cap_collect(src: ptr, t: ptr, ctab: ptr, nc: ptr, i: u32) -> u32 {
    let n0: u32 = load32(nc, 0);
    store32(ctab, n0 * 16, i + 1);                    // 名字 token
    store32(ctab, n0 * 16 + 4, chk_dec(src, t, i + 5));   // lo
    store32(ctab, n0 * 16 + 8, chk_dec(src, t, i + 8));   // hi
    store32(ctab, n0 * 16 + 12, i + 3);               // 空间 token
    store32(nc, 0, n0 + 1);
    i = i + 10;
    if chk_tok_is(src, t, i, "revocable") {
        i = i + 1;
    }
    return i;
}

/// 能力表判错 (参考实现 2094-2107): 重复声明 / LO>HI / 占用 excluded 空间 -> E-CAP。
fn chk_caps_verify(src: ptr, t: ptr, ctab: ptr, n0: u32, exs: ptr, nexs: u32, p: ptr, o: u32) -> u32 {
    let k: u32 = 0;
    while k < n0 {
        let nt: u32 = load32(ctab, k * 16);
        if load32(ctab, k * 16 + 4) > load32(ctab, k * 16 + 8) {
            o = sym_pub(src, t, p, o, E_CAP, nt);
        }
        // 与**之前**的每个能力比名字: 每个重复项各报一次 (与 set 的"每项都报"同口径)
        let k2: u32 = 0;
        while k2 < k {
            if same(src, t, load32(ctab, k2 * 16), nt) {
                o = sym_pub(src, t, p, o, E_CAP, nt);
            }
            k2 = k2 + 1;
        }
        // excluded "<space>: ..." —— 取 ':' 之前的部分跟能力空间比
        let e: u32 = 0;
        while e < nexs {
            let es: u32 = load32(exs, e * 4);
            let el: u32 = tok_len(t, es);
            let ep: u32 = tok_start(t, es) + 1;      // 跳过开引号
            let k3: u32 = 0;
            let colon: u32 = 0;
            while k3 < el && colon == 0 {
                if load8(src, ep + k3) == 58 {
                    colon = k3;
                }
                k3 = k3 + 1;
            }
            if colon > 0 && colon == tok_len(t, load32(ctab, k * 16 + 12)) {
                let ok: u32 = 1;
                let k4: u32 = 0;
                while k4 < colon {
                    if load8(src, ep + k4) != load8(src, tok_start(t, load32(ctab, k * 16 + 12)) + k4) {
                        ok = 0;
                    }
                    k4 = k4 + 1;
                }
                if ok == 1 {
                    o = sym_pub(src, t, p, o, E_CAP, nt);
                }
            }
            e = e + 1;
        }
        k = k + 1;
    }
    return o;
}

/// guard 的能力与索引: 未声明 -> E-CAP; 字面量索引越界 -> E-CAP。
/// i 指向 `guard`, i+1 = 能力名, i+2 = '(' , i+3 = 索引 (可选)。
fn chk_guard(src: ptr, t: ptr, ctab: ptr, nc: u32, i: u32, p: ptr, o: u32) -> u32 {
    let nt: u32 = i + 1;
    let k: u32 = 0;
    let found: u32 = 0;
    while k < nc {
        if same(src, t, load32(ctab, k * 16), nt) {
            found = 1;
            if chk_tok_kind(t, i + 3) == 1 {
                let v: u32 = chk_dec(src, t, i + 3);
                if v < load32(ctab, k * 16 + 4) || v > load32(ctab, k * 16 + 8) {
                    o = sym_pub(src, t, p, o, E_CAP, nt);
                }
            }
        }
        k = k + 1;
    }
    if found == 0 {
        o = sym_pub(src, t, p, o, E_CAP, nt);
    }
    return o;
}

/// 内建函数的形参个数 (镜像 lomentc.BUILTINS 的 arity); 不是内建 -> 999999。
/// 这张表必须与 `is_builtin` 的名字清单**同增同减** —— `test_m81_builtin_table_matches`
/// 会逐名比对两边, 漏改一边就红。
fn chk_builtin_arity(src: ptr, t: ptr, i: u32) -> u32 {
    // slice_len 也是内建 (参考实现里它单列一条, 不在 BUILTINS 表里), 但 arity 同口径
    if chk_tok_is(src, t, i, "str_len") || chk_tok_is(src, t, i, "panic")
            || chk_tok_is(src, t, i, "alloc") || chk_tok_is(src, t, i, "free")
            || chk_tok_is(src, t, i, "inb") || chk_tok_is(src, t, i, "str_ptr")
            || chk_tok_is(src, t, i, "slice_len") {
        return 1;
    }
    if chk_tok_is(src, t, i, "str_eq") || chk_tok_is(src, t, i, "str_concat")
            || chk_tok_is(src, t, i, "str_byte") || chk_tok_is(src, t, i, "load8")
            || chk_tok_is(src, t, i, "atomic_add") || chk_tok_is(src, t, i, "outb")
            || chk_tok_is(src, t, i, "ptr_add") || chk_tok_is(src, t, i, "ptr_sub") {
        return 2;
    }
    if chk_tok_is(src, t, i, "store8") || chk_tok_is(src, t, i, "get_bits") {
        return 3;
    }
    if chk_tok_is(src, t, i, "set_bits") || chk_tok_is(src, t, i, "syscall4") {
        return 4;
    }
    if chk_tok_is(src, t, i, "syscall6") {
        return 6;
    }
    return 999999;
}

/// 参数表: '('<i..>')' —— 检查类型与形参重名, 返回结束下标。
fn scan_params(src: ptr, t: ptr, s: ptr, n: u32, i: u32, p: ptr, o: u32, tab: ptr) -> u64 {
    i = i + 1;
    let c: u32 = 0;
    while !chk_tok_is(src, t, i, ")") && chk_tok_kind(t, i) != 4 {
        // 方法接收者: `&self` / `&mut self` / 裸 `self` (trait 块里写作 `fn m(self) -> u32;`)。
        // 它没有类型注解 —— 不排掉就会把后面的 `)` 或 `-` 当成类型, 报一串假 E-TYPE。
        if chk_tok_is(src, t, i, "&") {
            i = i + 1;
            if chk_tok_is(src, t, i, "mut") {
                i = i + 1;
            }
            i = i + 1;              // self
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else if chk_tok_is(src, t, i, "self") {
            i = i + 1;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else {
            // 形参重名 -> E-DUP (`fn f(a: u32, a: u32)`; 参考实现的口径是 E013)
            if chk_tab_has(src, t, tab, c, i) == 1 {
                o = sym_pub(src, t, p, o, E_DUP, i);
            }
            store32(tab, c * 4, i);
            c = c + 1;
            i = i + 1;              // 参数名
            i = i + 1;              // ':'
            let r: u64 = check_type(src, t, s, n, i, p, o);
            o = (r % 4294967296) as u32;
            i = chk_skip_type(src, t, i);
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
    }
    return ((i + 1) as u64) * 4294967296 + (o as u64);
}

/// 形参个数。前缀 `chk_` 的理由同 `chk_find_paren` —— 而且这两个 `count_args`
/// **语义恰好不同** (这里数形参, codegen 那边数实参), 撞名会静默算错。
pub fn chk_count_args(src: ptr, t: ptr, i: u32) -> u32 {
    // 从 '(' 之后开始, 数顶层逗号: 空表按 0
    let depth: u32 = 0;
    let argc: u32 = 0;
    let any: u32 = 0;
    let j: u32 = i + 1;
    while !(chk_tok_is(src, t, j, ")") && depth == 0) && chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            depth = depth + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            depth = depth - 1;
        }
        if chk_tok_is(src, t, j, ",") && depth == 0 {
            argc = argc + 1;
        }
        any = 1;
        j = j + 1;
    }
    if any == 0 {
        return 0;
    }
    return argc + 1;
}

/// 局部环境 (形参 + let) 查类型: 条目 = 名字 token | 类型编码 (8 字节)。
fn chk_env_get(src: ptr, t: ptr, env: ptr, envc: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < envc {
        if same(src, t, load32(env, i * 8), name_tok) {
            return load32(env, i * 8 + 4);
        }
        i = i + 1;
    }
    return 0;
}

fn chk_env_add(t: ptr, env: ptr, envc: u32, name_tok: u32, ty: u32) -> u32 {
    store32(env, envc * 8, name_tok);
    store32(env, envc * 8 + 4, ty);
    return envc + 1;
}

/// 名字对应的类型: 局部环境优先, 再看顶层符号表 (模块级常量在函数体内可见,
/// 参考实现是 `scope = dict(const_scope)` 起手)。
fn chk_name_ty(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32, name_tok: u32) -> u32 {
    let v: u32 = chk_env_get(src, t, env, envc, name_tok);
    if v != 0 {
        return v;
    }
    let slot: u32 = chk_lookup_slot(src, t, syms, n, name_tok);
    if slot != 0 && load32(syms, (slot - 1) * 16 + 4) == K_CONST {
        // 常量的类型编码存在**返回类型那一格** (常量没有返回类型, 那格空着)
        return load32(syms, (slot - 1) * 16 + 12);
    }
    return 0;
}

/// 词法器把多字符运算符拆成**单字符 token** (`!=` -> `!` `=`, `<<` -> `<` `<`,
/// `==` -> `=` `=`), 所以比较/算术运算符必须在 token 层按相邻字符重新组装。
/// 这一条踩过一次: 按 `chk_tok_is(j, "==")` 判定的话**永远不匹配**, 于是
/// `return a != b;` 被算成"非 bool", 在语料上立刻变成假阳性。
fn chk_is_cmp(src: ptr, t: ptr, j: u32) -> u32 {
    if chk_tok_is(src, t, j, "=") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // ==
    }
    if chk_tok_is(src, t, j, "!") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // !=
    }
    if chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // <=
    }
    if chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // >=
    }
    if chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<") {
        return 0;                                       // << 是移位, 不是比较
    }
    if chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">") {
        return 0;
    }
    if chk_tok_is(src, t, j, "<") || chk_tok_is(src, t, j, ">") {
        return 1;                                       // <  >
    }
    if chk_tok_is(src, t, j, "&") && chk_tok_is(src, t, j + 1, "&") {
        return 1;                                       // &&
    }
    if chk_tok_is(src, t, j, "|") && chk_tok_is(src, t, j + 1, "|") {
        return 1;                                       // ||
    }
    return 0;
}

fn chk_is_binop(src: ptr, t: ptr, j: u32) -> u32 {
    if chk_tok_is(src, t, j, "+") || chk_tok_is(src, t, j, "-")
            || chk_tok_is(src, t, j, "*") || chk_tok_is(src, t, j, "/")
            || chk_tok_is(src, t, j, "%") || chk_tok_is(src, t, j, "^") {
        return 1;
    }
    if chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<") {
        return 1;                                       // <<
    }
    if chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">") {
        return 1;                                       // >>
    }
    if chk_tok_is(src, t, j, "&") && !chk_tok_is(src, t, j + 1, "&") {
        return 1;                                       // 位与 (排除 &&)
    }
    if chk_tok_is(src, t, j, "|") && !chk_tok_is(src, t, j + 1, "|") {
        return 1;
    }
    return 0;
}

/// 表达式 [lo, hi) 的类型编码; 0 = 未知。
///
/// 语义对照 lomentc.expr_type (AST 版), 这里是**token 版**:
///   - 整型字面量 / 未知形状 -> 0 (参考实现里 IntLit 也是 None, 让上下文定宽)
///   - `true`/`false` -> bool, 字符串字面量 -> str
///   - 深度 0 有比较/逻辑运算符 -> bool
///   - 否则取**最左操作数**的类型 (参考实现的 `Bin` 返回 `lt or rt`, 左结合链的最左
///     操作数就是它)
///   - `as T` -> T (只认基类型/具名单 token; 复合类型 -> 0)
///   - `&x` / `&mut x` -> 0 (切片是复合类型, 见 TY_* 说明)
///   - `f(...)` -> 内建/函数的返回类型; `x.m(...)` -> 0 (方法派发不建模)
///   - 复合类型 (数组字面量、结构体字面量、下标、字段) -> 0
fn chk_ty_expr(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
               lo: u32, hi: u32) -> u32 {
    if lo >= hi {
        return 0;
    }
    // 单 token: 字面量 / 标识符
    if hi == lo + 1 {
        if chk_tok_kind(t, lo) == 1 {
            return 0;
        }
        if chk_tok_kind(t, lo) == 2 {
            return (1 << TY_KIND_SHIFT) + 10;
        }
        if chk_tok_is(src, t, lo, "true") || chk_tok_is(src, t, lo, "false") {
            return (1 << TY_KIND_SHIFT) + 9;
        }
        if chk_tok_kind(t, lo) == 0 {
            return chk_name_ty(src, t, syms, n, env, envc, lo);
        }
        return 0;
    }
    // 深度 0 扫描: 比较运算符**优先于**算术运算符 —— `v % 2 == 0` 的顶节点是 `==`
    // (参考实现里比较一律返回 bool)。所以这里不能一见到算术运算符就收工: 必须把
    // 整段扫完, 见到比较就立刻返回 bool。
    let d: u32 = 0;
    let j: u32 = lo;
    let bin_at: u32 = 0;
    let as_at: u32 = 0;
    let dot_at: u32 = 0;
    let idx_at: u32 = 0;
    while j < hi {
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        }
        if d == 0 {
            if chk_is_cmp(src, t, j) == 1 {
                return (1 << TY_KIND_SHIFT) + 9;
            }
            if chk_tok_is(src, t, j, "as") {
                as_at = j;
            }
            if chk_is_binop(src, t, j) == 1 && j > lo && bin_at == 0 {
                bin_at = j;         // 只记**最左**那个 (左结合链的类型 = 最左操作数的类型)
            }
            // `<<` / `>>` 是**两个** `<` / `>` token: 第二个字符不能再被当成新的运算符
            // (否则 `1 << n` 里的第二个 `<` 会被读成"小于", 整段被算成 bool)。
            if (chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<"))
                    || (chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">")) {
                j = j + 1;
            }
            if chk_tok_is(src, t, j, ".") {
                dot_at = j;
            }
            if chk_tok_is(src, t, j, "[") {
                idx_at = j;
            }
        }
        j = j + 1;
    }
    if as_at != 0 {
        // 目标必须是基类型 (参考实现: `as 目标类型非法`)。非法时返回 0 —— **不能**把
        // `1 as Foo` 当成"类型 Foo", 否则会多报一条 E001 掩盖真正的 E017 (码漂移)。
        if chk_base_code(src, t, as_at + 1) == 0 {
            return 0;
        }
        return chk_ty_of_tok(src, t, syms, n, as_at + 1);
    }
    if bin_at != 0 {
        return chk_ty_expr(src, t, syms, n, env, envc, lo, bin_at);
    }
    // 整体外层括号 -> 剥掉
    if chk_tok_is(src, t, lo, "(") && chk_match_paren(src, t, lo) == hi - 1 {
        return chk_ty_expr(src, t, syms, n, env, envc, lo + 1, hi - 1);
    }
    // `f(...)` 调用形: 名字紧跟 '(' 且右括号正好收到区间末尾
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo + 1, "(")
            && chk_match_paren(src, t, lo + 1) == hi - 1 {
        let b: u32 = chk_builtin_ret(src, t, lo);
        if b != 0 {
            return b;
        }
        let slot: u32 = chk_lookup_slot(src, t, syms, n, lo);
        if slot != 0 {
            return load32(syms, (slot - 1) * 16 + 12);
        }
        return 0;
    }
    if chk_tok_is(src, t, lo, "&") || chk_tok_is(src, t, lo, "!") {
        if chk_tok_is(src, t, lo, "!") {
            return chk_ty_expr(src, t, syms, n, env, envc, lo + 1, hi);
        }
        return 0;   // `&x` / `&mut x` -> 切片 (复合类型)
    }
    if chk_tok_is(src, t, lo, "mut") && chk_tok_is(src, t, lo + 1, "&") {
        return 0;
    }
    if dot_at != 0 || idx_at != 0 {
        return 0;       // 字段访问 / 下标: 需要结构体表与元素类型, 本批不建模
    }
    return 0;
}

/// 从 '(' 出发找匹配的 ')' (只按圆括号计数)。
fn chk_match_paren(src: ptr, t: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "(") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 从 i 起找深度 0 的目标 token (用于切语句边界); eof/越界返回 hi。
fn chk_find_at(src: ptr, t: ptr, i: u32, hi: u32, what: str) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while j < hi && chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        }
        if d == 0 && chk_tok_is(src, t, j, what) {
            return j;
        }
        j = j + 1;
    }
    return hi;
}

/// 形参表 -> 局部环境 (只记类型, 不报错: 类型检查已在第一遍做过)。
fn chk_env_params(src: ptr, t: ptr, s: ptr, n: u32, env: ptr, envc: u32,
                  lp: u32, hi: u32) -> u32 {
    let i: u32 = lp + 1;
    let c: u32 = envc;
    while i < hi && chk_tok_kind(t, i) != 4 && !chk_tok_is(src, t, i, ")") {
        if chk_tok_is(src, t, i, "&") {
            i = i + 1;
            if chk_tok_is(src, t, i, "mut") {
                i = i + 1;
            }
            i = i + 1;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else if chk_tok_is(src, t, i, "self") {
            i = i + 1;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else {
            let nm: u32 = i;
            i = i + 2;              // 名字 ':'
            c = chk_env_add(t, env, c, nm, chk_ty_of_tok(src, t, s, n, i));
            i = chk_skip_type(src, t, i);
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
    }
    return c;
}

/// 数组字面量 `[a, b, c]` 的元素个数 (空 -> 0); ni = `[` 的下标。
fn chk_arr_count(src: ptr, t: ptr, ni: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = ni;
    let c: u32 = 0;
    let any: u32 = 0;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "[") || chk_tok_is(src, t, j, "(") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, "]") || chk_tok_is(src, t, j, ")") {
            d = d - 1;
            if d == 0 {
                if any == 0 {
                    return 0;
                }
                return c + 1;
            }
        }
        if d == 1 && chk_tok_is(src, t, j, ",") {
            c = c + 1;
        }
        any = 1;
        j = j + 1;
    }
    return 0;
}

/// 语句级检查 (批次 2): let / return / 赋值 / if / while / for。
///
/// 形参压到 10 个: 自举 codegen 的实参上限是 10 (形参类型表步长 80 = 10 槽), 超限会
/// `panic`。所以函数体的区间用 u64 **打包**传 (b << 32 | e), 而不是两个 u32。
/// ret = 函数的返回类型编码。
fn chk_body(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
            be: u64, ret: u32, p: ptr, o: u32) -> u32 {
    let b: u32 = (be / 4294967296) as u32;
    let e: u32 = (be % 4294967296) as u32;
    let j: u32 = b + 1;
    let c: u32 = envc;
    while j < e && chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "let") && !(j > 0 && chk_tok_is(src, t, j - 1, "if")) {
            let nm: u32 = j + 1;
            let dty: u32 = 0;
            let dlo: u32 = 0;       // 声明类型 token 区间 (取数组长度用)
            let dhi: u32 = 0;
            let k: u32 = j + 2;
            if chk_tok_is(src, t, k, ":") {
                k = k + 1;
                dlo = k;
                dty = chk_ty_of_tok(src, t, syms, n, k);
                k = chk_skip_type(src, t, k);
                dhi = k;
            }
            let eq: u32 = chk_find_at(src, t, k, e, "=");
            let semi: u32 = chk_find_at(src, t, eq + 1, e, ";");
            if eq < e && semi <= e {
                // 数组长度 (参考实现只在"声明是数组 且 字面量是数组"时比)
                if chk_tok_is(src, t, dlo, "[") && chk_tok_is(src, t, eq + 1, "[") {
                    let sep: u32 = chk_find_at(src, t, dlo, dhi, ";");
                    if sep < dhi {
                        let want: u32 = chk_dec(src, t, sep + 1);
                        if want != chk_arr_count(src, t, eq + 1) {
                            o = sym_pub(src, t, p, o, E_ARR, nm);
                        }
                    }
                }
                let t2: u32 = chk_ty_expr(src, t, syms, n, env, c, eq + 1, semi);
                if t2 != 0 && dty != 0 && t2 != dty {
                    o = sym_pub(src, t, p, o, E_TMISMATCH, nm);
                }
            }
            c = chk_env_add(t, env, c, nm, dty);
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "return") {
            let semi: u32 = chk_find_at(src, t, j + 1, e, ";");
            let t3: u32 = chk_ty_expr(src, t, syms, n, env, c, j + 1, semi);
            if t3 != 0 && ret != 0 && t3 != ret {
                o = sym_pub(src, t, p, o, E_TMISMATCH, j);
            }
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "if") || chk_tok_is(src, t, j, "while") {
            // `if let ...` 是模式, 不是条件表达式
            if !(chk_tok_is(src, t, j, "if") && chk_tok_is(src, t, j + 1, "let")) {
                let lb: u32 = chk_find_at(src, t, j + 1, e, "{");
                let ct: u32 = chk_ty_expr(src, t, syms, n, env, c, j + 1, lb);
                if ct != 0 && ct != TY_BOOL {
                    o = sym_pub(src, t, p, o, E_TMISMATCH, j);
                }
                j = lb;
            } else {
                j = j + 1;
            }
        } else if chk_tok_is(src, t, j, "for") {
            let var: u32 = j + 1;
            let lo_t: u32 = 0;
            let hi_t: u32 = 0;
            let d1: u32 = chk_find_at(src, t, j + 2, e, ".");
            let lb2: u32 = chk_find_at(src, t, d1 + 1, e, "{");
            if d1 < e {
                lo_t = chk_ty_expr(src, t, syms, n, env, c, j + 3, d1);
                hi_t = chk_ty_expr(src, t, syms, n, env, c, d1 + 2, lb2);
            }
            if lo_t != 0 && chk_ty_is_int(lo_t) == 0 {
                o = sym_pub(src, t, p, o, E_TMISMATCH, j);
            }
            if hi_t != 0 && chk_ty_is_int(hi_t) == 0 {
                o = sym_pub(src, t, p, o, E_TMISMATCH, j);
            }
            let vt: u32 = lo_t;
            if vt == 0 {
                vt = hi_t;
            }
            if vt == 0 {
                vt = TY_U32;
            }
            c = chk_env_add(t, env, c, var, vt);
            if lb2 < e {
                j = lb2;
            } else {
                j = e;
            }
        } else if chk_tok_kind(t, j) == 0 && chk_tok_is(src, t, j + 1, "=")
                && chk_is_kw(src, t, j) == 0
                // `E::A => { ... }` 的 `=>` 里也有 `=` —— 少了这两个守卫, 枚举变体
                // 会被当成"给未声明变量 A 赋值"(假 E002)。`A` 前面是 `:` 同理。
                && !chk_tok_is(src, t, j + 2, ">")
                && !(j > 0 && chk_tok_is(src, t, j - 1, ":")) {
            let semi: u32 = chk_find_at(src, t, j + 2, e, ";");
            let tt: u32 = chk_name_ty(src, t, syms, n, env, c, j);
            if tt == 0 {
                o = sym_pub(src, t, p, o, E_TYPE, j);   // 赋值未声明的变量
            } else {
                let et: u32 = chk_ty_expr(src, t, syms, n, env, c, j + 2, semi);
                if et != 0 && et != tt {
                    o = sym_pub(src, t, p, o, E_TMISMATCH, j);
                }
            }
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else {
            j = j + 1;
        }
    }
    return o;
}


/// 主入口: 返回错误条数 (错误记录写在 p)。
pub fn check(src: ptr, t: ptr, out: ptr) -> u32 {
    // 内存来自语言自带的 64 KiB bump 堆, **与 codegen 共用**: codegen 的
    // `emit_module` 一次要 49152 字节 (48 KiB), 所以这里的总量必须压在 ~12 KiB 以内,
    // 否则 `alloc` 的 OOM 边界检查会走 `@__loment_abort` —— 在自举驱动里就是一条
    // 非法指令 (SIGILL), 而不是一条诊断。这个耦合由 `test_m85_heap_budget` 静态钉住:
    // 两边的 alloc 字面量之和必须留出余量。尺寸都按**语料实测**定 (字段≤2, 变体≤3,
    // 形参≤11, 每函数 let≤152, 能力≤1, excluded≤2)。
    let syms: ptr = alloc(8192);   // 全单元符号表 (16 字节/条): 512 条 —— 最大的单元也够
    let scr: ptr = alloc(1024);    // 名表暂存 (字段/变体/形参), 逐声明复用
    let ctab: ptr = alloc(512);    // 能力表 (16 字节一项)
    let nc: ptr = alloc(16);       // 能力条数 (一格内存)
    let exs: ptr = alloc(256);     // excluded 的字符串 token 下标
    let env: ptr = alloc(2048);    // 局部环境 (形参 + let), 每函数重建
    store32(nc, 0, 0);
    let n: u32 = 0;
    let o: u32 = 0;
    let nexs: u32 = 0;
    let i: u32 = 0;
    // 名表清理: 逐声明复用同一块暂存, 每次用都要"清零条数" —— 但 chk_* 系列用
    // 显式计数 (c) 而不是查找长度, 所以只需不读旧值即可, 无需 memclr。
    // ---- 第零遍: 先把**类型名**收齐再查签名。
    // 单元里的引用可能出现在声明之前 —— 最典型的是预置枚举: `lomentc.load` 把
    // `Option`/`Result` append 到单元**末尾**, 而 `-> Result<u32, u32>` 在文件开头,
    // 单趟扫描会报一串假 E-TYPE。
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "struct") || chk_tok_is(src, t, i, "enum") {
            let k0: u32 = K_STRUCT;
            if chk_tok_is(src, t, i, "enum") {
                k0 = K_ENUM;
            }
            let r0a: u64 = declare(src, t, syms, n, i + 1, k0, 0, 0, out, o);
            n = (r0a / 4294967296) as u32;
            o = (r0a % 4294967296) as u32;
            n = decl_tparams(src, t, syms, n, i + 1);
            i = i + 1;
        } else if chk_tok_is(src, t, i, "impl") {
            i = chk_skip_body(src, t, i);   // impl 块不在子集内 (理由见第一遍)
        } else {
            i = i + 1;
        }
    }
    // ---- 第一遍: 其余顶层声明 + 类型检查
    i = 0;
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "fn") {
            let lp: u32 = chk_find_paren(src, t, i + 2);
            let argc: u32 = chk_count_args(src, t, lp);
            // 返回类型 (可选 ->)。签名式方法 (`trait` 里 `fn m(self) -> u32;`) 没有函数体,
            // 所以 `;` 也要当作终止 —— 否则会一路走到下一个 `{` (那是 impl 块的), 把游标
            // 拽进别人的块里, 后面全错位。
            // 位置必须先扫出来: `declare` 要把返回类型编码记进符号表 (批次 2 的 return 比对)。
            let j: u32 = i + 2;
            let rtok: u32 = 0;
            while !chk_tok_is(src, t, j, "{") && !chk_tok_is(src, t, j, ";")
                    && chk_tok_kind(t, j) != 4 {
                if chk_tok_is(src, t, j, "-") {
                    rtok = j + 2;
                }
                j = j + 1;
            }
            let rcode: u32 = 0;
            if rtok != 0 {
                rcode = chk_ty_of_tok(src, t, syms, n, rtok);
            }
            let r0: u64 = declare(src, t, syms, n, i + 1, K_FN, argc, rcode, out, o);
            n = (r0 / 4294967296) as u32;
            o = (r0 % 4294967296) as u32;
            n = decl_tparams(src, t, syms, n, i + 1);   // `fn f<T>`: T 是类型名
            let r1: u64 = scan_params(src, t, syms, n, lp, out, o, scr);
            o = (r1 % 4294967296) as u32;
            if rtok != 0 {
                let r2: u64 = check_type(src, t, syms, n, rtok, out, o);
                o = (r2 % 4294967296) as u32;
            }
            i = j;
        } else if chk_tok_is(src, t, i, "struct") || chk_tok_is(src, t, i, "enum") {
            // 名字已在第零遍登记过 (这里不能再 declare, 否则自己跟自己报 E-DUP)。
            // 声明体这一遍**真正解析** (字段/变体重名与类型、空类型), 不再整块跳过。
            let is_enum: bool = chk_tok_is(src, t, i, "enum");
            if is_base_type(src, t, i + 1) == 1 {
                o = sym_pub(src, t, out, o, E_DEF, i + 1);   // 与基类型同名 (参考实现 E009)
            }
            let lb: u32 = chk_find_brace(src, t, i + 1);
            if is_enum {
                let rb: u64 = chk_enum_body(src, t, syms, n, lb, i + 1, scr, out, o);
                o = (rb % 4294967296) as u32;
                i = (rb / 4294967296) as u32;
            } else {
                let rb2: u64 = chk_struct_body(src, t, syms, n, lb, i + 1, scr, out, o);
                o = (rb2 % 4294967296) as u32;
                i = (rb2 / 4294967296) as u32;
            }
        } else if chk_tok_is(src, t, i, "impl") {
            // impl 块**不在本检查器的子集内**: 方法在平坦符号表里会互相撞名
            // (`impl T for Small { fn m }` 与 `impl T for Big { fn m }` 都叫 m, 会报假 E-DUP),
            // 而方法调用一律走 `x.m()` —— 已经被 `.` 那条规则排除掉了。
            // 整块跳过; 方法体内的调用检查在第二遍照做 (那里不跳 impl)。
            i = chk_skip_body(src, t, i);
        } else if chk_tok_is(src, t, i, "capability") {
            i = chk_cap_collect(src, t, ctab, nc, i);
        } else if chk_tok_is(src, t, i, "excluded") {
            // excluded "space: ..." —— 只记字符串 token, 等能力表齐了再比 (顺序无关)
            if chk_tok_kind(t, i + 1) == 2 {
                store32(exs, nexs * 4, i + 1);
                nexs = nexs + 1;
            }
            i = i + 2;
        } else if chk_tok_is(src, t, i, "const") {
            // 常量的类型编码记在 ret 格里 (供 `chk_name_ty` 在函数体里查常量类型用)
            let cty: u32 = 0;
            if chk_tok_is(src, t, i + 2, ":") {
                cty = chk_ty_of_tok(src, t, syms, n, i + 3);
            }
            let r4: u64 = declare(src, t, syms, n, i + 1, K_CONST, 0, cty, out, o);
            n = (r4 / 4294967296) as u32;
            o = (r4 % 4294967296) as u32;
            if chk_tok_is(src, t, i + 2, ":") {
                // 常量**不做** check_type: 参考实现的常量只查"类型必须是整型"
                // (`const C: Foo = 1;` 只报 E001, 不报"类型未声明") —— 多报就是假阳性。
                if chk_is_int(src, t, i + 3) == 0 {
                    o = sym_pub(src, t, out, o, E_TMISMATCH, i + 3);
                }
            }
            i = i + 4;
        } else {
            i = i + 1;
        }
    }
    // ---- 第一遍半: 能力表判错 (等 caps 与 excluded 都收齐, 顺序无关)
    o = chk_caps_verify(src, t, ctab, load32(nc, 0), exs, nexs, out, o);
    // ---- 第二遍: 函数体里的调用检查
    i = 0;
    while chk_tok_kind(t, i) != 4 {
        // 声明体不是代码: `enum Option<T> { Some(T), None }` 里的 `Some(T)` 长得像调用,
        // `struct S { a: u32 }` 同理。整块跳过 (含预置枚举 —— 它是注入进单元的尾巴)。
        // 跳过之后**这一轮不能再 +1**: 跳完正好落在下一个声明的关键字上, 再前进一步
        // 就会把它整个略过 (s2 那样的 "struct 后面紧跟 enum" 就是这么漏的)。
        let skipped: u32 = 0;
        if chk_tok_is(src, t, i, "enum") || chk_tok_is(src, t, i, "struct")
                || chk_tok_is(src, t, i, "trait") {
            i = chk_skip_body(src, t, i);
            skipped = 1;
        }
        if skipped == 0 {
            // guard NAME(idx) —— 能力未声明或字面量索引越界 -> E-CAP。
            // 排在调用检查之前, 并靠 `i-1 != "guard"` 把随后的 `NAME(` 排除掉。
            if chk_tok_is(src, t, i, "guard") {
                o = chk_guard(src, t, ctab, load32(nc, 0), i, out, o);
            }
            // `if let E::V(x) = e` 里的 `let` 是**模式**不是带类型的绑定 (它的 `Result`
            // 后面跟的是 `::` 而不是 `:`) —— 不排掉就会把 `::` 里的第二个 `:` 当类型报 E-TYPE。
            if chk_tok_is(src, t, i, "let") && !(i > 0 && chk_tok_is(src, t, i - 1, "if")) {
                // let NAME ':' TYPE —— TYPE 未声明 -> E-TYPE
                let r6: u64 = check_type(src, t, syms, n, i + 3, out, o);
                o = (r6 % 4294967296) as u32;
            }
            // 调用检查: `ident (` 才算, 且要排掉四类**看起来像调用其实不是**的东西 ——
            // 关键字 (`return (a)` / `if (b)`) / 枚举构造 (`E::V(x)`) / 域检查
            // (`guard NAME(idx)`) / 方法调用 (`x.m(...)`)。
            // i>0 是必须的: i-1 在下溢时会变成巨大的下标, 读出缓冲区外的垃圾。
            if i > 0 && chk_tok_kind(t, i) == 0 && chk_tok_is(src, t, i + 1, "(")
                    && chk_is_kw(src, t, i) == 0
                    && !chk_tok_is(src, t, i - 1, ":")
                    && !chk_tok_is(src, t, i - 1, ".")
                    && !chk_tok_is(src, t, i - 1, "guard") {
                let nl: u32 = tok_len(t, i);
                if nl > 0 {
                    let want_b: u32 = chk_builtin_arity(src, t, i);
                    if want_b != 999999 {
                        // 内建: 只查实参个数 (形参类型那一半属于表达式类型批次)
                        if want_b != chk_count_args(src, t, i + 1) {
                            o = sym_pub(src, t, out, o, E_ARITY, i);
                        }
                    } else {
                        let slot: u32 = chk_lookup_slot(src, t, syms, n, i);
                        if slot == 0 {
                            o = sym_pub(src, t, out, o, E_FN, i);
                        } else {
                            let want: u32 = load32(syms, (slot - 1) * 16 + 8);
                            let got: u32 = chk_count_args(src, t, i + 1);
                            if want != got {
                                o = sym_pub(src, t, out, o, E_ARITY, i);
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
    // ---- 第三遍: 语句级类型比对 (批次 2) —— let / return / 赋值 / if / while / for。
    // 每个函数重建一次局部环境; 函数体的范围用花括号匹配切出来。
    i = 0;
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "fn") {
            let lp2: u32 = chk_find_paren(src, t, i + 2);
            let slot2: u32 = chk_lookup_slot(src, t, syms, n, i + 1);
            // 名字不能叫 `rb`: 第一遍的 struct/enum 分支已经有一个 u64 的 `rb` ——
            // 局部表按名字存类型, 重名会让新 let 的 i32 值按 i64 读回来 (clang 报
            // "%t defined with type i64 but expected i32")。批次 3 的局部名统一 f 前缀。
            let fbra: u32 = chk_find_brace(src, t, i + 2);
            // 签名式方法 (`fn m(self) -> u32;`) 没有函数体: 不能把后面的 impl 块当自己的
            if chk_tok_is(src, t, fbra, "{") && slot2 != 0 {
                let retc: u32 = load32(syms, (slot2 - 1) * 16 + 12);
                let fend: u32 = chk_skip_body(src, t, fbra);
                let envc: u32 = chk_env_params(src, t, syms, n, env, 0, lp2, fbra);
                o = chk_body(src, t, syms, n, env, envc,
                             (fbra as u64) * 4294967296 + (fend as u64), retc, out, o);
                i = fend;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return o / 8;
}
