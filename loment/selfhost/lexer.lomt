module lexer

// M79: Loment 版 lexer —— 与 tools/lomc.py 的词法规则一致 (token 流对照见 loment_p8_test)。
// token 记录 20B (小端): kind u32 @0 | start u32 @4 | len u32 @8 | line u32 @12 | col u32 @16
// kind: 0=ident 1=number 2=string 3=punct 4=eof
use bytes

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn is_alpha(c: u32) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn is_punct(c: u32) -> bool {
    let s: str = "{}()[]:;=@,.+-*/%<>!&|^?";
    let i: u32 = 0;
    while i < str_len(s) {
        if str_byte(s, i) == c {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// 写一条 token 记录; `n >= cap` 时**不写** —— 越界写会静默踩坏后面的内存。
fn emit(out: ptr, n: u32, cap: u32, kind: u32, start: u32, len: u32, line: u32, col: u32) {
    if n < cap {
        let p: ptr = ptr_add(out, n * 20);
        store32(p, 0, kind);
        store32(p, 4, start);
        store32(p, 8, len);
        store32(p, 12, line);
        store32(p, 16, col);
    }
}

/// 词法分析, **带容量**: 写满 `cap` 条就只数不写, 但**始终返回真实条数 (含 eof)**
/// —— 调用方拿 `n > cap` 判断"缓冲不够"并自己报错。要这个入口的原因: 驱动器给整个
/// **单元**开的词法缓冲是按源码长度估的, 估小了必须**报出来**, 不能悄悄少几条 token
/// (少 token 的下场是后面的语句凭空消失, 而判据只会报"两个编译器不一致")。
pub fn lex_cap(src: ptr, len: u32, out: ptr, cap: u32) -> u32 {
    let i: u32 = 0;
    let line: u32 = 1;
    let col: u32 = 1;
    let n: u32 = 0;
    while i < len {
        let c: u32 = load8(src, i);
        if c == 10 {
            line = line + 1;
            col = 1;
            i = i + 1;
        } else if c == 32 || c == 9 || c == 13 {
            col = col + 1;
            i = i + 1;
        } else if c == 47 && i + 1 < len && load8(src, i + 1) == 47 {
            while i < len && load8(src, i) != 10 {
                i = i + 1;
            }
        } else if c == 47 && i + 1 < len && load8(src, i + 1) == 42 {
            i = i + 2;
            while i + 1 < len && !(load8(src, i) == 42 && load8(src, i + 1) == 47) {
                if load8(src, i) == 10 {
                    line = line + 1;
                    col = 1;
                }
                i = i + 1;
            }
            i = i + 2;
            col = col + 2;
        } else if c == 34 {
            let s: u32 = i;
            let lc: u32 = col;
            i = i + 1;
            col = col + 1;
            while i < len && load8(src, i) != 34 {
                if load8(src, i) == 92 && i + 1 < len {
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
            i = i + 1;
            col = col + 1;
            emit(out, n, cap, 2, s, i - s, line, lc);
            n = n + 1;
        } else if is_digit(c) {
            let s: u32 = i;
            let lc: u32 = col;
            if c == 48 && i + 1 < len && (load8(src, i + 1) == 120 || load8(src, i + 1) == 88) {
                i = i + 2;
                col = col + 2;
                while i < len && is_hex(load8(src, i)) {
                    i = i + 1;
                    col = col + 1;
                }
            } else {
                while i < len && is_digit(load8(src, i)) {
                    i = i + 1;
                    col = col + 1;
                }
            }
            emit(out, n, cap, 1, s, i - s, line, lc);
            n = n + 1;
        } else if is_alpha(c) {
            let s: u32 = i;
            let lc: u32 = col;
            while i < len && (is_alpha(load8(src, i)) || is_digit(load8(src, i))) {
                i = i + 1;
                col = col + 1;
            }
            emit(out, n, cap, 0, s, i - s, line, lc);
            n = n + 1;
        } else if is_punct(c) {
            emit(out, n, cap, 3, i, 1, line, col);
            n = n + 1;
            i = i + 1;
            col = col + 1;
        } else {
            i = i + 1;
            col = col + 1;
        }
    }
    emit(out, n, cap, 4, i, 0, line, col);
    return n + 1;
}

fn is_hex(c: u32) -> bool {
    return is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

/// 无界包装: 老调用方 (工具) 的缓冲都按 20 字节/源码字节开, 本来就是安全上界, 不需要限。
pub fn lex(src: ptr, len: u32, out: ptr) -> u32 {
    return lex_cap(src, len, out, 4294967295);
}
