// loment/selfhost/driver.lomt — M83/M85: 独立的自举编译器 (docs/145/150)
//
//   ./fujoc-s loment/examples/demo.lomt > demo.ll
//
// 它自己做**全部装载** —— 这是它不再是"被夹具喂单元的函数"的关键:
//
// 1. 入口路径从 `/proc/self/cmdline` 取。`_start` 的 argc/argv 在栈上, 不写内联汇编
//    拿不到; `/proc` 给了同样的信息, 代价是一次 openat+read。
// 2. `use "..."` 递归解析, 依赖按**先序**拼进单元 (与 `lomentc.resolve_deps` 同规则),
//    同一路径只装一次 (循环导入自然被去重表挡住)。
// 3. 单元里缺 `Option`/`Result` 时注入预置枚举 (与 `lomentc.load` 同规则) ——
//    注入点必须在**单元末尾**, 因为参考实现是把预置枚举 append 到模块枚举之后的。
//
// 内存来自内核 (`brk`), 不用语言自带的 64 KiB bump 堆: 一个 190 KiB 的单元要 ~4 MiB
// token 表加 ~1.5 MiB 输出。把那个静态堆调大是**错的方向** —— 每个 `alloc` 用户
// (内核模块尤其) 的 `.bss` 都要跟着涨。这也是 M83 顺手补上 `整数 as ptr` 的原因
// (M67 只做了反方向的 `ptr as u64`)。
//
// 每层源文件在单元缓冲**顶部**占一个固定槽 (SLOT), 因为输出是顺序写的而依赖必须先写:
// 父文件读进自己的槽 → 递归处理它的 `use` → 再把槽里的字节补到自己后面。
// 写成"先写自己再回头看依赖"会让依赖落在后面, 与参考实现的顺序不符。

module driver

// 尺寸都用 u32 字面量: 常量在表达式里**没有类型** (参考实现的 expr_type(Ident) 只看
// 局部/参数), 所以 `(SLOT + 64) * 20` 会被算成 i32。要么显式 `as u64`, 要么把乘积
// 预先算成常量 —— 后者更省事也更好读。
const SLOT: u32 = 262144;        // 每层源文件槽 (够装最大的 codegen.lomt)
const MAXDEPTH: u32 = 8;         // 依赖深度上限
const UNIT_CAP: u32 = 8388608;   // 单元缓冲 (含顶部 MAXDEPTH*SLOT 的槽区)
const IR_CAP: u32 = 16777216;    // IR 输出缓冲 (上界 8*单元 + 8192, 留足余量)
const SEEN_CAP: u32 = 65536;     // 已装载路径去重表
// 小暂存的布局 (改了偏移必须所有用点一起改 —— 它们写在同一块内存上):
//   [0, 4000)      NUL 路径 (open_ro 要 C 串)
//   [4096, 6496)   use 清单 (MAX_USE 条, 每条 8 字节: 起点 + 长度)
//   [6496, 8192)   候选路径暂存 (resolve_use_name / fix_rel)
//   [8192, 8256)   wdec 的数字缓冲
//   [8256, 9280)   项目根: 入口文件所在目录 (NUL)  ← 名字形式的 deps/ 层相对它
//   [9280, 10304)  工具目录: argv[0] 所在目录 (NUL) ← 自带 store 相对它
//   [10304, 11328) 版本名: store 里列出的那个子目录 (NUL)
//   [11328, 12352) 目录项缓冲 (getdents64)
//   [12352, 13824) 子路径暂存 (<dir>/<entry>, 判是不是目录用)
//   [13824, 14080) 源后缀: loment.conf 里配的那个 (NUL), 空 = 用默认 .lomt
//   [14080, 15104) --diag-out 路径 (NUL), 空 = 不吐结构化诊断 (docs/182 §5)
const SCR_CAP: u32 = 16384;
//: 单个文件的 `use` 条数上限 (路径形式 + 名字形式合起来算), **与参考实现同值**。
//: 超限**报错退出**, 绝不静默丢 —— 原先进程按 8 条布局, 第 9 条起直接不要, 而参考实现
//: 无上限: 同一份源码两个实现给出不同的单元 (2026-09-16 发现)。抬到 300 是让 std 那种
//: 多模块门面装得下。
const MAX_USE: u32 = 300;
const USE_OFF: u32 = 4096;       // use 清单起点
const NAMTMP_OFF: u32 = 6496;    // 候选路径暂存起点
const PROJ_OFF: u32 = 8256;      // 项目根
const TOOLDIR_OFF: u32 = 9280;   // 工具目录
const VER_OFF: u32 = 10304;      // 版本名
const DENT_OFF: u32 = 11328;     // 目录项缓冲
const SUBP_OFF: u32 = 12352;     // 子路径暂存
const EXT_OFF: u32 = 13824;      // 源后缀 (loment.conf)
const DIAG_OFF: u32 = 14080;     // --diag-out 路径
const DIAG_CAP: u32 = 1024;      // 路径上限
const EXT_CAP: u32 = 256;        // 源后缀上限
const DIR_CAP: u32 = 1024;       // 项目根 / 工具目录 / 版本名 各自的上限
const DENT_CAP: u32 = 1024;      // 目录项缓冲上限 (PE 垫片一次只回一条记录)
const SUBP_CAP: u32 = 1472;      // 子路径上限
const TOKS_CAP: u32 = 5244160;   // (SLOT + 64) * 20 = 单文件词法缓冲

use lexer
use codegen
use checker

/// 退出; 返回值只为类型完整 (syscall 之后不会回来)。
fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

/// 向内核抬 program break 拿 n 字节; 返回块首 (0 = 失败)。
fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

/// 从 fd 读到 EOF 或读满; 返回实际字节数。
fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let n: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if n <= 0 {
            return off;
        }
        off = off + (n as u64);
    }
    return off;
}

/// write 可以短写, 循环写干净。
fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn fail(msg: str) -> u32 {
    write_all(2, str_ptr(msg), str_len(msg) as u64);
    return die(1);
}

/// 写一个 str 到 fd (长度交给 str_len —— 手数字节数会连字符串常量的 NUL 一起写出去)。
fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

/// 一个字节的低 8 位按**小写十六进制两位**写出去 (`\u00XX` 要用)。
fn whex2(fd: u64, v: u32) -> u64 {
    let hi: u32 = (v / 16) % 16;
    let lo: u32 = v % 16;
    let bh: u8 = 48 as u8;
    if hi > 9 {
        bh = (87 + hi) as u8;           // 10 -> 'a'
    } else {
        bh = (48 + hi) as u8;
    }
    let bl: u8 = 48 as u8;
    if lo > 9 {
        bl = (87 + lo) as u8;
    } else {
        bl = (48 + lo) as u8;
    }
    let t: ptr = alloc(2);
    store8(t, 0, bh);
    store8(t, 1, bl);
    return write_all(fd, t, 2);
}

/// 把 `p[0..n]` 按**JSON 字符串**写出 (含两侧引号)。这是 `--diag-out` 那一路的核心:
/// 片段是**源码原文的字节**, 里面完全可能有 `"`、反斜杠或控制字节 —— 不转义写出来的
/// 就不是合法 JSON, 而下游 `lomenterr` 会整行解析失败 (docs/182 §5)。
///
/// 控制字节一律走 `\u00XX` 而**不是**替换成空格: 替换是**悄悄改内容**, 而这条链上
/// 唯一的底气就是"报出来的东西和源码里的一致"。
fn wjson_str(fd: u64, p: ptr, n: u32) -> u64 {
    let _q: u64 = wstr(fd, "\"");
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i) as u32;
        if c == 34 {
            let _a: u64 = wstr(fd, "\\\"");
        } else if c == 92 {
            let _b: u64 = wstr(fd, "\\\\");
        } else if c < 32 {
            let _c: u64 = wstr(fd, "\\u00");
            let _d: u64 = whex2(fd, c);
        } else {
            let _e: u64 = write_all(fd, ptr_add(p, i), 1);
        }
        i = i + 1;
    }
    return wstr(fd, "\"");
}

/// 一条诊断 = 一行 JSON。字段集与参考实现一致 (`file/line/col/code/message`) ——
/// **不含 `title`/`hint`**: 那两样由报错器查 `surface_data` 补, 编译器只报"是什么、在哪"
/// (docs/182 §5.3)。两侧的 `message` 文本本来就不同 (参考是整句中文, 这里只有源码片段),
/// 那是 `docs/158` §4 记着的既有分叉, 判据比的是**码**。
fn wdiag(fd: u64, scr: ptr, file: ptr, fnam: u32,
         line: u32, code: u32, frag: ptr, fl: u32) -> u64 {
    let _a: u64 = wstr(fd, "{\"file\":");
    let _b: u64 = wjson_str(fd, file, fnam);
    let _c: u64 = wstr(fd, ",\"line\":");
    let _d: u64 = wdec(fd, scr, line);
    // 列: 驱动器手里只有 token 索引, 没有列 —— 与参考实现 check() 那条路一样给 0
    let _e: u64 = wstr(fd, ",\"col\":0,\"code\":\"E");
    // 码写成**三位**(`E022` 而不是 `E22`) —— 与参考实现一致。参考的码来自
    // `loment_diag.RULES`(唯一真源), 那里就是三位; CLI 显示成 `E22` 是**呈现层**的事。
    // 这条是判据**第一次跑就抓出来的**: 原先这里直接 wdec, 报
    // "自举 ['E22'] vs 参考 ['E022']" —— 同一件事两个实现给出不同的字符串。
    if code < 10 {
        let _p1: u64 = wstr(fd, "00");
    } else if code < 100 {
        let _p2: u64 = wstr(fd, "0");
    }
    let _f: u64 = wdec(fd, scr, code);
    let _g: u64 = wstr(fd, "\",\"message\":");
    let _h: u64 = wjson_str(fd, frag, fl);
    return wstr(fd, "}\n");
}

/// u32 十进制写到 fd (诊断里要报错误码与行号; 驱动器里没有 printf)。
/// 数字缓冲借 scr 的 [8000, 8064) (布局见 SCR_CAP 上面的表)。
fn wdec(fd: u64, scr: ptr, v: u32) -> u64 {
    let t: ptr = ptr_add(scr, 8000);
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(t, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(t, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(t, 32 + q, load8(t, d - 1 - q) as u8);
        q = q + 1;
    }
    return write_all(fd, ptr_add(t, 32), d as u64);
}

/// 只读打开: 先把路径复制成 NUL 结尾 (内核要 C 串), 再 openat(AT_FDCWD, p, O_RDONLY)。
fn open_ro(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    return syscall4(257, (0 as u64) - 100, scr as u64, 0);
}

/// 写打开 (建/清空): `openat(AT_FDCWD, p, O_WRONLY|O_CREAT|O_TRUNC, 0644)`。
///
/// **必须带 mode, 所以只能走 `syscall6`** —— Linux 的 openat 是 4 参系统调用,
/// `open_ro` 用 `syscall4` 只递得到 rdx (flags); 带 O_CREAT 时 r10 里的 mode 递不过去,
/// 文件会被建成权限 0。
fn open_wo(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    // O_WRONLY(1) | O_CREAT(64) | O_TRUNC(512) = 577; mode 0644 = 420
    return syscall6(257, (0 as u64) - 100, scr as u64, 577, 420, 0);
}

/// `p[0..n]` 与字面量 `s` 相等吗 (含长度)。
fn streq(p: ptr, n: u32, s: str) -> u32 {
    if n != str_len(s) {
        return 0;
    }
    let i: u32 = 0;
    let sp: ptr = str_ptr(s);
    while i < n {
        if (load8(p, i) as u32) != (load8(sp, i) as u32) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 从 /proc/self/cmdline 取第 `idx` 个参数: 返回 (start << 32) | len, 0 = 没有。
/// idx=0 是工具自己的路径 (用来推"工具目录"), idx=1 是入口文件。
fn argv_at(buf: ptr, cap: u64, scr: ptr, idx: u32) -> u64 {
    // 长度交给 str_len: 手数字符会连字符串常量的 NUL 一起复制进去 (openat 要的是 C 串)
    let fd: i64 = open_ro(str_ptr("/proc/self/cmdline"),
                          str_len("/proc/self/cmdline"), scr);
    if fd < 0 {
        return 0;
    }
    let n: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if n <= 0 {
        return 0;
    }
    let i: u64 = 0;
    let k: u32 = 0;
    while k < idx {
        while i < n as u64 && load8(buf, i as u32) != 0 {
            i = i + 1;
        }
        if i >= n as u64 {
            return 0;
        }
        i = i + 1;
        k = k + 1;
    }
    let s: u64 = i;
    while i < n as u64 && load8(buf, i as u32) != 0 {
        i = i + 1;
    }
    if i == s {
        return 0;
    }
    return (s << 32) | (i - s);
}

fn copy_bytes(dst: ptr, doff: u64, src: ptr, soff: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, (doff + i as u64) as u32, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

/// 去重表: 每项 = len(u32) + 路径字节, 顺次排布。
/// 表长放在**一格内存**里 (snc), 因为它必须在兄弟递归之间共享: Loment 没有
/// out 参数也没有可变全局, 按值传会在"两个模块都 import 同一个依赖"时漏判
/// (checker 先装 bytes 再装 lexer, lexer 又 import bytes —— 按值传会把 bytes 装两遍)。
fn seen_has(seen: ptr, snc: ptr, p: ptr, n: u32) -> u32 {
    let sn: u32 = load32(snc, 0);
    let o: u32 = 0;
    while o < sn {
        let l: u32 = load32(seen, o);
        if l == n {
            let ok: u32 = 1;
            let i: u32 = 0;
            while i < n {
                if load8(seen, o + 4 + i) != load8(p, i) {
                    ok = 0;
                }
                i = i + 1;
            }
            if ok == 1 {
                return 1;
            }
        }
        o = o + 4 + l;
    }
    return 0;
}

fn seen_add(seen: ptr, snc: ptr, p: ptr, n: u32) {
    let sn: u32 = load32(snc, 0);
    store32(seen, sn, n);
    copy_bytes(seen, sn as u64 + 4, p, 0, n);
    store32(snc, 0, sn + 4 + n);
}

/// 文本模式读入: 去掉 CRLF 里的 CR。
/// 参考实现用 `read_text` (通用换行) 载入源码, 而驱动器读的是**原始字节** ——
/// 源码里有跨行的字符串字面量 (生成器里到处都是), CR 会原样进到字面量字节里,
/// 于是 IR 里的常量写成 `c"\0D\0A"` 而不是 `c"\0A"` (docs/150 记过一次同类事故)。
fn strip_cr(buf: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    while i < n {
        let c: u32 = load8(buf, i);
        if c == 13 && i + 1 < n && load8(buf, i + 1) == 10 {
            i = i + 1;   // 丢掉 CR, 保留 LF
        } else {
            store8(buf, o, c as u8);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

/// `use <名字>` 的搜索根 (与参考实现的 `lomentc.NAME_ROOTS` **必须逐条一致**)。
fn name_root_at(r: u32) -> str {
    if r == 0 {
        return "loment/lib";
    }
    if r == 1 {
        return "loment/examples";
    }
    if r == 2 {
        return "loment/selfhost";
    }
    return "loment/tools";
}

/// NUL 串长度。
fn cstr_len(p: ptr) -> u32 {
    let i: u32 = 0;
    while load8(p, i) != 0 && i < 4096 {
        i = i + 1;
    }
    return i;
}

/// dst[off...] += src[0..n]; 返回新偏移 (用来拼候选路径)。
fn cat(dst: ptr, off: u32, src: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, off + i, load8(src, i) as u8);
        i = i + 1;
    }
    return off + n;
}

/// 同上, 源是字符串字面量。
fn catl(dst: ptr, off: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, off + i, str_byte(s, i) as u8);
        i = i + 1;
    }
    return off + n;
}

/// 路径的目录部分 (最后一个分隔符之前) 写进 dst (NUL), 返回长度。
/// 没有分隔符就是空串 —— 等价于参考实现里 `Path("hi.lomt").parent` 给的 "."。
///
/// **两种分隔符都认 (47 '/' 与 92 '\')**: PE 垫片的 `/proc/self/cmdline` 原样带着调用方
/// 写的分隔符, 而 Windows 上那通常是反斜杠 —— 只认 '/' 会把 argv[0] 的目录算成空串,
/// "自带 store" 那一层于是永远指向 <当前目录>/../share/... (踩过)。
fn dir_of(path: ptr, n: u32, dst: ptr, cap: u32) -> u32 {
    let last: u32 = 4294967295;
    let i: u32 = 0;
    while i < n {
        if load8(path, i) == 47 || load8(path, i) == 92 {
            last = i;
        }
        i = i + 1;
    }
    let d: u32 = 0;
    if last != 4294967295 {
        while d < last && d < cap - 1 {
            store8(dst, d, load8(path, d) as u8);
            d = d + 1;
        }
    }
    store8(dst, d, 0 as u8);
    return d;
}

/// 列出 `<dirp>` 的**子目录**。返回值: 1 = 恰好一个 (名字 NUL 结尾写进 dst); 0 = 打不开
/// 或没有子目录; ≥2 = 有多个 (dst 里留的是第一个, 调用方只拿它报数)。
///
/// "是不是目录"**用 openat(O_DIRECTORY) 试**, 不看 d_type —— PE 垫片的 d_type 从没被
/// 验证过 (lpi_test 里那几条 dir 自检只喂内存里的合成记录, lompi 的 scan_dir 也从不看它),
/// 而"打开目录"这条路是验过的 (lompi index 在 PE 上能用)。踩过: 按 d_type==4 判, 在 PE 上
/// 一个目录都数不出来, `use std` 于是永远找不到自带的库。
/// **PE 垫片每次只返回一条记录** (Linux 一次一批), 所以循环按"读一批走一批"写。
fn subdirs_of(dirp: ptr, dl: u32, dst: ptr, scr: ptr) -> u32 {
    let dent: ptr = ptr_add(scr, DENT_OFF);
    let i: u32 = 0;
    while i < dl && i < DIR_CAP - 1 {
        store8(scr, i, load8(dirp, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, scr as u64, 65536);
    if fd < 0 {
        return 0;
    }
    let n: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        let rn: i64 = syscall4(217, fd as u64, dent as u64, DENT_CAP as u64);
        if rn <= 0 {
            go = 0;
        } else {
            let m: u32 = rn as u32;
            let e: u32 = 0;
            while e < m {
                let rl: u32 = load16(dent, e + 16);
                if rl == 0 {
                    e = m;
                } else {
                    let nm: u32 = e + 19;
                    if load8(dent, nm) != 46 && is_dir_at(dirp, dl, dent, nm, scr) == 1 {
                        if n == 0 {
                            let j: u32 = 0;
                            while j < 200 && load8(dent, nm + j) != 0 {
                                store8(dst, j, load8(dent, nm + j) as u8);
                                j = j + 1;
                            }
                            store8(dst, j, 0 as u8);
                        }
                        n = n + 1;
                    }
                    e = e + rl;
                }
            }
        }
    }
    syscall4(3, fd as u64, 0, 0);
    return n;
}

/// `<dir>/<名字>` 是个目录吗 —— 拼进子路径暂存, 再 openat(O_DIRECTORY) 试一下。
/// 名字从目录项缓冲里现取 (`dent + nm`, NUL 结尾), 所以不用先拷出来。
fn is_dir_at(dirp: ptr, dl: u32, dent: ptr, nm: u32, scr: ptr) -> u32 {
    let w: ptr = ptr_add(scr, SUBP_OFF);
    let d: u32 = cat(w, 0, dirp, dl);
    let d2: u32 = catl(w, d, "/");
    let j: u32 = 0;
    let e: u32 = d2;
    while j < 200 && e < SUBP_CAP - 1 && load8(dent, nm + j) != 0 {
        store8(w, e, load8(dent, nm + j) as u8);
        e = e + 1;
        j = j + 1;
    }
    store8(w, e, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, w as u64, 65536);
    if fd < 0 {
        return 0;
    }
    syscall4(3, fd as u64, 0, 0);
    return 1;
}

/// `<名字>` 是否在 `<根>/deps/<名字>/<名字>.lomt` —— 项目本地的依赖 (lompi 落点)。
/// 命中写进 tmp 并返回长度; 0 = 没这个目录。
fn try_deps(root: ptr, rn: u32, src: ptr, off: u32, len: u32, tmp: ptr, scr: ptr) -> u32 {
    let d: u32 = 0;
    if rn > 0 {
        d = cat(tmp, d, root, rn);
        d = catl(tmp, d, "/");
    }
    d = catl(tmp, d, "deps/");
    d = cat(tmp, d, ptr_add(src, off), len);
    d = catl(tmp, d, "/");
    d = cat(tmp, d, ptr_add(src, off), len);
    return open_two(d, tmp, scr);
}

/// `<名字>` 是否在**工具链自带的库**里: `<工具目录>/../share/lompi/store/<名字>/<版本>/<名字>.lomt`。
/// 版本那一层**只允许一个** (与参考实现同规则: 编译器不做版本选择); 多个就报错退出。
/// 命中写进 tmp 并返回长度; 0 = 没这个包。
fn try_store(td: ptr, tn: u32, src: ptr, off: u32, len: u32, tmp: ptr, scr: ptr) -> u32 {
    let d: u32 = 0;
    if tn > 0 {
        d = cat(tmp, d, td, tn);
    }
    d = catl(tmp, d, "/../share/lompi/store/");
    d = cat(tmp, d, ptr_add(src, off), len);
    store8(tmp, d, 0 as u8);
    let verd: ptr = ptr_add(scr, VER_OFF);
    let nv: u32 = subdirs_of(tmp, d, verd, scr);
    if nv == 0 {
        return 0;
    }
    if nv > 1 {
        let m1: str = "fujoc-s: 自带的库里 ";
        let m2: str = " 有多个版本 —— 编译器不做版本选择, 要指定版本就用 deps/";
        write_all(2, str_ptr(m1), str_len(m1) as u64);
        write_all(2, ptr_add(src, off), len as u64);
        write_all(2, str_ptr(m2), str_len(m2) as u64);
        write_all(2, str_ptr("\n"), 1);
        die(1);
    }
    d = cat(tmp, d, str_ptr("/"), 1);
    d = cat(tmp, d, verd, cstr_len(verd));
    d = cat(tmp, d, str_ptr("/"), 1);
    d = cat(tmp, d, ptr_add(src, off), len);
    return open_two(d, tmp, scr);
}

/// `use <名字>` -> 真实路径, 写进 dst, 返回长度 (0 = 找不到或有歧义)。
/// **按层搜, 先命中先用** (与 `lomentc.resolve_name` 同规则):
///   1. `<项目根>/deps/<名字>/<名字>.lomt`  项目本地
///   2. `<工具目录>/../share/lompi/store/<名字>/<版本>/<名字>.lomt`  随包自带
///   3. 内置四根 `<根>/<名字>.lomt` —— **这一层命中必须唯一**
/// 只解析 `.lomt` —— 名字形式是 L1 模块用的, L0 布局走路径形式。
fn resolve_use_name(src: ptr, off: u32, len: u32, dst: ptr, scr: ptr) -> u32 {
    // 候选写进 tmp, **不能写 dst**: 为了判歧义要试完 4 个根, 而后面那些试写会把
    // 已经命中的那个覆盖掉 (踩过: examples 命中 29 字节, 又被 tools 的 26 字节盖住,
    // 于是 load_file 拿到 "loment/tools/mathutil.lomt" + 上一轮残尾 "omt")。
    let tmp: ptr = ptr_add(scr, NAMTMP_OFF);
    // 前面两层: 路径命中即返回, 不需要判唯一 (参考实现也是"先命中先用")。
    let r1: u32 = try_deps(ptr_add(scr, PROJ_OFF), cstr_len(ptr_add(scr, PROJ_OFF)),
                           src, off, len, tmp, scr);
    if r1 > 0 {
        return cat(dst, 0, tmp, r1);
    }
    let r2: u32 = try_store(ptr_add(scr, TOOLDIR_OFF), cstr_len(ptr_add(scr, TOOLDIR_OFF)),
                            src, off, len, tmp, scr);
    if r2 > 0 {
        return cat(dst, 0, tmp, r2);
    }
    let hits: u32 = 0;
    let hit_len: u32 = 0;
    let r: u32 = 0;
    while r < 4 {
        let rp: str = name_root_at(r);
        let d: u32 = 0;
        let j: u32 = 0;
        while j < str_len(rp) {
            store8(tmp, d, str_byte(rp, j) as u8);
            d = d + 1;
            j = j + 1;
        }
        store8(tmp, d, 47 as u8);   // '/'
        d = d + 1;
        j = 0;
        while j < len {
            store8(tmp, d, load8(src, off + j) as u8);
            d = d + 1;
            j = j + 1;
        }
        let rl: u32 = open_two(d, tmp, scr);
        if rl > 0 {
            if hits == 0 {
                let q: u32 = 0;
                while q < rl {
                    store8(dst, q, load8(tmp, q) as u8);
                    q = q + 1;
                }
                hit_len = rl;
            }
            hits = hits + 1;
        }
        r = r + 1;
    }
    if hits != 1 {
        return 0;
    }
    return hit_len;
}

/// 这个 `use` 的路径是不是 `.lomt`。
/// `lomentc` 的 parser 只把 `.lomt` 记进 `mod.imports`, `use "...lom"` 进 `mod.uses`
/// (L0 声明由 lomc 处理, 不参与 L1 单元装载) —— 驱动必须同规则, 否则会把 fujr.lom
/// 也拼进单元 (demo.lomt 上多出整整一个模块)。
/// 路径形式的一条 `use` 定路径: **先按原样 (相对 CWD), 再挂 `<本文件所在目录>/`** ——
/// 与参考实现同序 (先 root, 后被导入文件所在目录)。命中后者就写进 tmp 并返回长度;
/// 返回 0 = 按原样就行 (开得了), 或两处都开不了 (交给 load_file 报错)。
///
/// 没有这一步, `deps/std/std.lomt` 里的 `use "mem.lomt"` 会去找 `<CWD>/mem.lomt` ——
/// 一个不存在的路径 (2026-09-16 用户报的"use std 指向不存在的路径")。
fn fix_rel(slot: ptr, sp: u32, sl: u32, path: ptr, n: u32, scr: ptr) -> u32 {
    let fd0: i64 = open_ro(ptr_add(slot, sp), sl, scr);
    if fd0 >= 0 {
        syscall4(3, fd0 as u64, 0, 0);
        return 0;
    }
    let last: u32 = 4294967295;
    let i: u32 = 0;
    while i < n {
        if load8(path, i) == 47 || load8(path, i) == 92 {
            last = i;
        }
        i = i + 1;
    }
    if last == 4294967295 {
        return 0;              // 本文件就在当前目录 —— 兜底等于原样, 试过就不试了
    }
    let tmp: ptr = ptr_add(scr, NAMTMP_OFF);
    let d: u32 = cat(tmp, 0, path, last);
    d = catl(tmp, d, "/");
    d = cat(tmp, d, ptr_add(slot, sp), sl);
    store8(tmp, d, 0 as u8);
    let fd1: i64 = open_ro(tmp, d, scr);
    if fd1 < 0 {
        return 0;
    }
    syscall4(3, fd1 as u64, 0, 0);
    return d;
}

/// 在 `<tmp 里已拼好的 head><后缀>` 上试**两种**后缀: 先配置的那个 (scr+EXT_OFF),
/// 再默认 `.lomt`。命中就把完整路径留在 tmp (NUL 结尾) 并返回长度; 0 = 都没有。
///
/// 为什么要试两种: 项目可以把自己的源后缀配成 `.foo`, 而**工具链自带的模块仍然是 `.lomt`**
/// —— 名字形式既要找得到这个项目的库, 也要找得到自带的那些 (docs/143 的搜索层)。
fn open_two(head: u32, tmp: ptr, scr: ptr) -> u32 {
    let en: u32 = cstr_len(ptr_add(scr, EXT_OFF));
    if en > 0 {
        let d: u32 = cat(tmp, head, ptr_add(scr, EXT_OFF), en);
        store8(tmp, d, 0 as u8);
        let fd: i64 = open_ro(tmp, d, scr);
        if fd >= 0 {
            syscall4(3, fd as u64, 0, 0);
            return d;
        }
    }
    let d2: u32 = catl(tmp, head, ".lomt");
    store8(tmp, d2, 0 as u8);
    let fd2: i64 = open_ro(tmp, d2, scr);
    if fd2 < 0 {
        return 0;
    }
    syscall4(3, fd2 as u64, 0, 0);
    return d2;
}

/// 从 `<dirp>/loment.conf` 读源后缀, 写进 dst (**不带引号**), 返回长度; 0 = 没配/读不出。
///
/// 配置就是**一份 Loment 源码** (与 `lompi.conf` / `pkg.lomp` 同一种形状), 只认一个标签:
///
///     pub fn source_ext() -> str { return ".foo"; }
///
/// 取 `source_ext` 之后**第一个字符串字面量** —— 用词法器扫, 所以注释里出现的同名字符串
/// 不会误命中。`dirp` 长度 0 表示"当前目录"(项目自己放的那份优先)。读不出来就当没配。
///
/// 值必须以 `.` 开头, 否则也算没配: 写错一个字母就把名字形式指到一堆奇怪的文件上, 不如
/// 退回默认那个 —— 配置文件会被人改坏, "编得过但改错了后缀"比"编不过"难查得多。
fn cfg_source_ext(dirp: ptr, dl: u32, dst: ptr, scr: ptr, buf: ptr, toks: ptr) -> u32 {
    let d: u32 = 0;
    if dl > 0 {
        d = cat(scr, d, dirp, dl);
        d = catl(scr, d, "/");
    }
    d = catl(scr, d, "loment.conf");
    store8(scr, d, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, scr as u64, 0);
    if fd < 0 {
        return 0;
    }
    let raw: u64 = read_all(fd as u64, buf, 65536);
    syscall4(3, fd as u64, 0, 0);
    if raw == 0 {
        return 0;
    }
    let n: u32 = lex(buf, raw as u32, toks);
    let found: u32 = 4294967295;
    let i: u32 = 0;
    while i < n && found == 4294967295 {
        if load32(toks, i * 20) == 0 && tok_is(buf, toks, i, "source_ext") == 1 {
            found = i;
        }
        i = i + 1;
    }
    if found == 4294967295 {
        return 0;
    }
    let s: u32 = 4294967295;
    let j: u32 = found + 1;
    while j < n && s == 4294967295 {
        if load32(toks, j * 20) == 2 {      // 2 = 字符串
            s = j;
        }
        j = j + 1;
    }
    if s == 4294967295 {
        return 0;
    }
    let st: u32 = load32(toks, s * 20 + 4);
    let sl: u32 = load32(toks, s * 20 + 8);   // 含两端的引号
    if sl < 3 {
        return 0;                             // 至少 `"."`
    }
    let q: u32 = 0;
    let bad: u32 = 0;
    while q < sl - 2 && q < EXT_CAP - 1 {
        let ch: u8 = load8(buf, st + 1 + q) as u8;
        if ch == 92 {
            bad = 1;                          // 带转义的也拒 (见下)
        }
        store8(dst, q, ch);
        q = q + 1;
    }
    store8(dst, q, 0 as u8);
    // 不以 `.` 开头、或带转义的, 一律当没配。转义那条是对着参考实现钉的: 这里拷的是**原始
    // 字节**(`\t` 两个字节), 参考实现的词法器给的却是**解码后**的值 —— 只在这一处会分叉,
    // 而文件名后缀里本来就不该有转义, 两边一起拒掉最省事。
    if q == 0 || load8(dst, 0) != 46 || bad == 1 {
        return 0;
    }
    return q;
}

fn is_lomt(src: ptr, sp: u32, sl: u32) -> u32 {
    // **L0 只有 `.lom` 一种后缀**, 别的任何后缀都算 L1 源 —— 后缀不是语言的一部分, 只是
    // 习惯 (用户 2026-09-16: "Loment 也可以作为其他文件名后缀的诞生地")。别把这条改回
    // "等于 .lomt 才算 L1": 那样 `use "x.foo"` 会被当成 L0 去找 .lom 而报"不存在"。
    if sl >= 4 {
        let e: u32 = sp + sl - 1;   // 结尾的引号
        if load8(src, e - 4) == 46 && load8(src, e - 3) == 108
                && load8(src, e - 2) == 111 && load8(src, e - 1) == 109 {
            return 0;               // ".lom"
        }
    }
    return 1;
}

/// 装载一个文件 (连同它的 `use`), 追加到 out 的第 off 字节起; 返回新的长度。
/// 父文件先读进自己的槽, 递归处理依赖, 最后才把自己补上去 —— 顺序=依赖在前。
///
/// 形参不能叫 `entry`: LLVM 的块标签与局部值共用名字空间, 每个函数的第一块都叫
/// `entry`, 于是 `%entry` 参数会让 clang 报 "unable to create block named 'entry'"。
fn load_file(path: ptr, n: u32, out: ptr, off: u64, seen: ptr, snc: ptr,
             depth: u32, scr: ptr, toks: ptr) -> u64 {
    if depth >= MAXDEPTH {
        return off;
    }
    if seen_has(seen, snc, path, n) == 1 {
        return off;
    }
    seen_add(seen, snc, path, n);
    let slot: ptr = ptr_add(out, UNIT_CAP - (depth + 1) * SLOT);
    let fd: i64 = open_ro(path, n, scr);
    if fd < 0 {
        // 就地报路径: 再晚一点 slot 的读就会把这块内存盖掉。
        // **必须硬失败** —— 原来这里是"报一行然后接着编", 于是缺依赖的编译会退出 0,
        // 只留一行 stderr。那正是这套工具链反复要消灭的东西(见 lomelf 头注与 docs/167:
        // "把静默错编改成报错退出"), 而且参考实现遇到这种输入是抛错退非零的 —— 两边
        // 必须一致。用户能不能看出是导入出的事, 就靠这一下。
        write_all(2, str_ptr("fujoc-s: 打不开 "), 20);
        write_all(2, path, n as u64);
        write_all(2, str_ptr("\n"), 1);
        die(1);
    }
    let raw_n: u64 = read_all(fd as u64, slot, SLOT as u64);
    syscall4(3, fd as u64, 0, 0);
    let nb: u32 = strip_cr(slot, raw_n as u32);
    // 先把本文件的 `use` 全收下来 (递归会复用 toks, 不能一边扫一边递归)
    lex(slot, nb, toks);
    let uses: ptr = ptr_add(scr, USE_OFF);
    let nu: u32 = 0;
    let i: u32 = 0;
    // 两种写法都收进来, 统一成"确切的 (起点, 长度)"再递归:
    //   字符串形式 `use b` -> 剥掉引号
    //   名字形式   `use name`       -> 解析成真实路径, 写在 slot 的 nb 之后
    // (每层各有一个槽, 所以递归不会踩到父层写下的这些路径)
    let rbase: u32 = nb;
    while load32(toks, i * 20) != 4 {
        // `choose` 声明的是**整个程序**的模式 (docs/143 §3.2), 所以只有**根单元**能写。
        // 这条只能在这里判: 装载器是唯一分得清"这一层是根还是被 use 进来的"的地方 ——
        // 单元拼完之后检查器看到的是一整块 token, 模块边界已经没了 (docs/158 §5 记过)。
        // 与 E018 同构: 那是装载器规则, 进不了 `loment_rule_parity._CASES` (它喂的是
        // 自包含单文件), 所以棘轮由驱动闸门承担, `BUDGET` 不动。
        if depth > 0 && tok_is(slot, toks, i, "choose") {
            let mc: str = "fujoc-s: 库不许写 choose (它是整个程序的模式, 只有根单元能定): ";
            write_all(2, str_ptr(mc), str_len(mc) as u64);
            write_all(2, path, n as u64);
            write_all(2, str_ptr("\n"), 1);
            die(1);
        }
        if tok_is(slot, toks, i, "use") {
            let k: u32 = load32(toks, (i + 1) * 20);
            let up: u32 = load32(toks, (i + 1) * 20 + 4);
            let ul: u32 = load32(toks, (i + 1) * 20 + 8);
            // 条数上限: 只在**要计数的那两种写法**上卡, 而且**报错, 不静默丢** ——
            // 丢掉的话单元少几块, 而参考实现照收, 两个实现就对同一份源码给出不同产物。
            if (k == 2 && is_lomt(slot, up, ul) == 1) || k == 0 {
                if nu >= MAX_USE {
                    let m1: str = "fujoc-s: 单个文件的 use 超过上限 ";
                    let m2: str = " 条 (路径形式 + 名字形式合起来算) —— 门面拆小, 别把整库塞进一个文件\n";
                    write_all(2, str_ptr(m1), str_len(m1) as u64);
                    wdec(2, scr, MAX_USE);
                    write_all(2, str_ptr(m2), str_len(m2) as u64);
                    die(1);
                }
            }
            if k == 2 && is_lomt(slot, up, ul) == 1 {
                store32(uses, nu * 8, up + 1);
                store32(uses, nu * 8 + 4, ul - 2);
                nu = nu + 1;
            } else if k == 0 {
                let rl: u32 = resolve_use_name(slot, up, ul, ptr_add(slot, rbase + nu * 64), scr);
                if rl == 0 {
                    // 同"打不开": 报出来之后**硬失败**, 不带着缺依赖的单元继续编
                    let msg: str = "fujoc-s: 名字导入找不到或有歧义: ";
                    write_all(2, str_ptr(msg), str_len(msg) as u64);
                    write_all(2, ptr_add(slot, up), ul as u64);
                    write_all(2, str_ptr("\n"), 1);
                    die(1);
                } else {
                    store32(uses, nu * 8, rbase + nu * 64);
                    store32(uses, nu * 8 + 4, rl);
                    nu = nu + 1;
                }
            }
        }
        i = i + 1;
    }
    let u: u32 = 0;
    while u < nu {
        let sp: u32 = load32(uses, u * 8);
        let sl: u32 = load32(uses, u * 8 + 4);
        // 路径形式先定路径 (CWD -> 本文件所在目录); 名字形式解析出来的已经能用,
        // fix_rel 第一试就命中, 返回 0, 于是照原样往下传。
        let fr: u32 = fix_rel(slot, sp, sl, path, n, scr);
        if fr > 0 {
            off = load_file(ptr_add(scr, NAMTMP_OFF), fr, out, off, seen, snc,
                            depth + 1, scr, toks);
        } else {
            off = load_file(ptr_add(slot, sp), sl, out, off, seen, snc,
                            depth + 1, scr, toks);
        }
        u = u + 1;
    }
    copy_bytes(out, off, slot, 0, nb);
    return off + nb as u64;
}

/// 单元里有没有这个枚举声明 (预置注入的判据, 镜像 lomentc.load)。
fn has_enum(src: ptr, toks: ptr, name: str) -> u32 {
    let i: u32 = 0;
    while load32(toks, i * 20) != 4 {
        if tok_is(src, toks, i, "enum") && tok_is(src, toks, i + 1, name) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 把预置枚举追加到单元末尾 (位置与 lomentc.load 的 append 一致: 模块枚举之后)。
fn append_prelude(dst: ptr, off: u64) -> u64 {
    let s: str = "\nmodule __prelude\npub enum Option<T> { Some(T), None }\npub enum Result<T, E> { Ok(T), Err(E) }\n";
    copy_bytes(dst, off, str_ptr(s), 0, str_len(s));
    return off + str_len(s) as u64;
}

fn _start() -> u32 {
    let unitv: u64 = sys_alloc(UNIT_CAP as u64);
    let irv: u64 = sys_alloc(IR_CAP as u64);
    let seenv: u64 = sys_alloc(SEEN_CAP as u64);
    let scrv: u64 = sys_alloc(SCR_CAP as u64);
    let argv_buf: u64 = sys_alloc(65536);   // 入口路径单独一块 (不能压在槽区里)
    let sncv: u64 = sys_alloc(16);          // 去重表长度 (一格内存, 递归共享)
    if unitv == 0 || irv == 0 || seenv == 0 || scrv == 0 || argv_buf == 0 || sncv == 0 {
        return fail("fujoc-s: brk failed\n");
    }
    let unit: ptr = unitv as ptr;
    let ir: ptr = irv as ptr;
    let seen: ptr = seenv as ptr;
    let scr: ptr = scrv as ptr;
    let snc: ptr = sncv as ptr;
    store32(snc, 0, 0);
    // `--diag-out PATH` (docs/182 §5): 结构化诊断的输出路径。**必须在取 argv[0]/argv[1]
    // 之前取** —— `argv_at` 每次都重写同一块缓冲 (`argv_buf`), 而后面的 `ap` 是指进那块
    // 缓冲的指针; 顺序反了 `ap` 的内容会被这两次调用抹掉。
    // 不给这个参数就是**老行为**: 只打人看的文本到 stderr, 不吐 JSONL。
    store8(scr, DIAG_OFF, 0 as u8);
    let a2: u64 = argv_at(argv_buf as ptr, 65536, scr, 2);
    if a2 != 0 {
        let p2: ptr = ptr_add(argv_buf as ptr, (a2 >> 32) as u32);
        if streq(p2, (a2 % 4294967296) as u32, "--diag-out") == 1 {
            let a3: u64 = argv_at(argv_buf as ptr, 65536, scr, 3);
            if a3 != 0 {
                let p3: ptr = ptr_add(argv_buf as ptr, (a3 >> 32) as u32);
                let n3: u32 = (a3 % 4294967296) as u32;
                copy_bytes(ptr_add(scr, DIAG_OFF), 0, p3, 0, n3);
                store8(scr, DIAG_OFF + n3, 0 as u8);
            }
        }
    }
    // 工具目录: argv[0] 所在目录 (自带 store 相对它)。**先取它** —— 下一次 argv_at 会把
    // 同一块 argv_buf 重写一遍, 而后面 ap 指进 argv_buf, 顺序反了内容会被抹掉。
    let a0: u64 = argv_at(argv_buf as ptr, 65536, scr, 0);
    if a0 == 0 {
        store8(scr, TOOLDIR_OFF, 0 as u8);
    } else {
        let _t: u32 = dir_of(ptr_add(argv_buf as ptr, (a0 >> 32) as u32),
                             (a0 % 4294967296) as u32,
                             ptr_add(scr, TOOLDIR_OFF), DIR_CAP);
    }
    let av: u64 = argv_at(argv_buf as ptr, 65536, scr, 1);
    if av == 0 {
        return fail("fujoc-s: 用法: fujoc-s <入口.lomt> [--diag-out PATH]\n");
    }
    let ap: ptr = ptr_add(argv_buf as ptr, (av >> 32) as u32);
    let an: u32 = (av % 4294967296) as u32;
    // 结构化诊断的输出 fd。**现在就开** (建/清空), 不是等出错了再开:
    //   * 上一次跑剩的旧文件不会被这一次误读 (空文件 = "这一次没有诊断");
    //   * 路径写错**立刻**炸出来, 而不是"编译通过所以没写文件"看不出来。
    // 与参考实现的 `--diag-out` 同一口径 (两边都在给定路径时就建, 无诊断时它是空的)。
    let dfd: i64 = 0 as i64 - 1;
    let dn: u32 = cstr_len(ptr_add(scr, DIAG_OFF));
    if dn > 0 {
        let o: i64 = open_wo(ptr_add(scr, DIAG_OFF), dn, scr);
        if o < 0 {
            return fail("fujoc-s: --diag-out 打不开 (路径或权限)\n");
        }
        dfd = o;
    }
    // 项目根: 入口文件所在目录 (名字形式的 deps/ 层相对它)
    let _p: u32 = dir_of(ap, an, ptr_add(scr, PROJ_OFF), DIR_CAP);
    // 词法缓冲按"单个文件"的大小开 (单元只 lex 一次, 见下)
    let tokv: u64 = sys_alloc(TOKS_CAP as u64);
    if tokv == 0 {
        return fail("fujoc-s: brk failed\n");
    }
    let toks: ptr = tokv as ptr;
    // 源后缀 (名字形式 `use <名字>` 用它拼候选): **项目自己放的那份优先** (项目根 =
    // 入口文件所在目录), 再是工具链旁边那份; 都没配就用默认 `.lomt`。这时 unit/toks
    // 还空着, 借它们当读配置的暂存 —— load_file 紧接着就会盖掉它们。
    store8(scr, EXT_OFF, 0 as u8);
    let _e0: u32 = cfg_source_ext(ptr_add(scr, PROJ_OFF),
                                  cstr_len(ptr_add(scr, PROJ_OFF)),
                                  ptr_add(scr, EXT_OFF), scr, unit, toks);
    if _e0 == 0 {
        let _e1: u32 = cfg_source_ext(ptr_add(scr, TOOLDIR_OFF),
                                      cstr_len(ptr_add(scr, TOOLDIR_OFF)),
                                      ptr_add(scr, EXT_OFF), scr, unit, toks);
    }
    let len: u64 = load_file(ap, an, unit, 0, seen, snc, 0, scr, toks);
    if len == 0 {
        return fail("fujoc-s: 入口装不进来 (路径对吗?)\n");
    }
    // 单元的词法缓冲: 按**实测密度**估 —— 仓库 184 个文件合计 4.81 字节/token, 最密的
    // 3.02; 取 **10 字节/源码字节**, 一倍余量。原先按 20 字节/源码字节开 (那是"1 字节
    // 1 个 token"的理论上界), 编 std 那种 1.86 MB 的单元要 37 MB, 而 PE 垫片的堆一共
    // 只有 64 MB (`WS_HEAP`) —— 于是"单元太大"。**估小了由 lex_cap 报出来**, 不静默少
    // token (少 token = 后面的语句凭空消失, 而判据只会报"两个编译器不一致")。
    let tcap: u64 = (len + 512) * 10;
    let tok2v: u64 = sys_alloc(tcap);
    if tok2v == 0 {
        return fail("fujoc-s: 单元太大: 词法缓冲要不到\n");
    }
    let toks2: ptr = tok2v as ptr;
    let ntk: u32 = (tcap / 20) as u32;
    // 预置枚举注入: 先粗判一次 (同一个缓冲; +512 的余量够放下小段 prelude)
    let nt0: u32 = lex_cap(unit, len as u32, toks2, ntk);
    if nt0 > ntk {
        return fail("fujoc-s: 单元太大: token 数超过缓冲 (密度比 10 字节/token 还密)\n");
    }
    if has_enum(unit, toks2, "Option") == 0 || has_enum(unit, toks2, "Result") == 0 {
        len = append_prelude(unit, len);
    }
    // 正式词法 + 发射
    let nt: u32 = lex_cap(unit, len as u32, toks2, ntk);
    if nt > ntk {
        return fail("fujoc-s: 单元太大: token 数超过缓冲 (密度比 10 字节/token 还密)\n");
    }
    // 先检查再发射: 有诊断就报到 stderr 并以 1 退出, 否则才发 IR。
    // 诊断格式与 p8 的 C 夹具同源: `<码>@<token>:<行> <片段>` 一行一条。
    let errsv: u64 = sys_alloc(8192);
    if errsv == 0 {
        return fail("fujoc-s: brk failed\n");
    }
    let errs: ptr = errsv as ptr;
    // 检查器的工作缓冲也从 brk 拿 (一块 >= chk_arena_bytes(), 内部分段见 checker.lomt 的
    // `chk_arena_*`)。**不**用语言自带的 64 KiB bump 堆: `emit_module` 一次就要
    // 49152B, 两者相加会越过 65536, 而 OOM 的边界检查在无 libc 环境下是
    // `@__loment_abort` —— 一条非法指令 (SIGILL), 看起来像"编译器崩了"。
    let arenav: u64 = sys_alloc(chk_arena_bytes() as u64);
    if arenav == 0 {
        return fail("fujoc-s: brk failed\n");
    }
    let arena: ptr = arenav as ptr;
    // 检查器的符号表按**单元规模**定 (syms 段 / 每条 20 字节)。先数一遍声明关键字 ——
    // 这是个**保守上界** (trait 里只声明不发射的方法也算进去), 超了就报错, 不写穿。
    let nsym: u32 = 0;
    let sk: u32 = 0;
    while load32(toks2, sk * 20) != 4 {
        if tok_is(unit, toks2, sk, "fn") || tok_is(unit, toks2, sk, "const")
                || tok_is(unit, toks2, sk, "struct") || tok_is(unit, toks2, sk, "enum") {
            nsym = nsym + 1;
        }
        sk = sk + 1;
    }
    if nsym > (chk_arena_scr() - chk_arena_syms()) / 20 {
        return fail("fujoc-s: 单元声明数超过 checker 符号表容量 (把门面拆小)\n");
    }
    let ne: u32 = check_arena(unit, toks2, errs, arena,
                              ptr_add(arena, chk_arena_scr()),
                              ptr_add(arena, chk_arena_ctab()),
                              ptr_add(arena, chk_arena_nc()),
                              ptr_add(arena, chk_arena_exs()),
                              ptr_add(arena, chk_arena_env()),
                              ptr_add(arena, chk_arena_tyt()));
    if ne != 0 {
        wstr(2, "fujoc-s: 静态检查未通过\n");
        let e: u32 = 0;
        while e < ne && e < 64 {
            let code: u32 = load32(errs, e * 8);
            let tk: u32 = load32(errs, e * 8 + 4);
            wstr(2, "  E");
            wdec(2, scr, code);
            wstr(2, " @");
            wdec(2, scr, tk);
            wstr(2, " line ");
            wdec(2, scr, load32(toks2, tk * 20 + 12));
            wstr(2, ": ");
            let st: u32 = load32(toks2, tk * 20 + 4);
            let ln: u32 = load32(toks2, tk * 20 + 8);
            let take: u32 = 24;
            if ln < 24 {
                take = ln;
            }
            write_all(2, ptr_add(unit, st), take as u64);
            wstr(2, "\n");
            // 同一条诊断, 结构化那一份 (docs/182 §5)。**同一份数据两个受众**:
            // 上面那份给人看 (stderr), 这份给报错器看 (一行 JSON)。
            if dfd >= 0 {
                let _j: u64 = wdiag(dfd as u64, scr, ap, an,
                                    load32(toks2, tk * 20 + 12), code,
                                    ptr_add(unit, st), take);
            }
            e = e + 1;
        }
        return die(1);
    }
    // codegen 的状态块也从 brk 拿: 那几张表按**单元规模**定 (函数表 4600 格), 整块
    // 500 KB 上下, 放不进语言自带的 64 KiB bump 堆 (checker 的 arena 早就是这条路)。
    let cgv: u64 = sys_alloc(cg_arena_bytes() as u64);
    if cgv == 0 {
        return fail("fujoc-s: brk failed (codegen 状态块)\n");
    }
    let cg: ptr = cgv as ptr;
    let m: u32 = emit_module(unit, toks2, ir, cg);
    if m == 0 {
        return fail("fujoc-s: 单元的函数数超过 codegen 表容量 (拆小门面)\n");
    }
    write_all(1, ir, m as u64);
    return die(0);
}
