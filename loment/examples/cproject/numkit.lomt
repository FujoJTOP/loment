/*
 * **本单元的每一处算术都压在 i32 不溢出以内**：C 的有符号溢出是 UB，
 * 拿它当语料比不出翻译器对不对（实测 clang 与译文在那份上没有可比性）。
 *
 * numkit —— 数论与控制流。**用 C 拼法写的 Loment**（docs/188 §0）。
 *
 * 与 `bitkit.lomt` 分工：那一份压**位运算**，这一份压**控制流** ——
 * `if` 的 C 写法（拿 int 当条件）、`&&`/`||` 的短路、`for` 的三种形状、
 * 多层 `else if`、提前 return、以及循环里改形参。
 *
 * **整份单元只有一种整型（`int`）** —— 见 bitkit 文件头那条。
 */

choose write grammar c

int gcd(int a, int b) {
    while (b != 0) {
        int t = a % b;
        a = b;
        b = t;
    }
    return a;
}

/* 模幂：循环里改底数与指数，结果全程取模。 */
int modpow(int base, int exp, int mod) {
    int result = 1;
    int b = base % mod;
    int e = exp;
    while (e > 0) {
        if (e % 2 == 1) {
            result = (result * b) % mod;
        }
        b = (b * b) % mod;
        e = e / 2;
    }
    return result;
}

/* Collatz 步数：分支里改形参，数一数走了几步。 */
int collatz(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

/* 数位和：取模与整除交替。 */
int digit_sum(int n) {
    int s = 0;
    int x = n;
    while (x > 0) {
        s = s + x % 10;
        x = x / 10;
    }
    return s;
}

/* 整数平方根：二分。上下界靠提前 return 收。 */
int isqrt(int n) {
    int lo = 0;
    int hi = n;
    int best = 0;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (mid * mid <= n) {
            best = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return best;
}

/* 1..n 里素数个数：试除，除数到 sqrt 就停。 */
int prime_count(int n) {
    int count = 0;
    int k = 2;
    while (k <= n) {
        int is_p = 1;
        int d = 2;
        while (d * d <= k) {
            if (k % d == 0) {
                is_p = 0;
                d = k;
            } else {
                d = d + 1;
            }
        }
        if (is_p == 1) {
            count = count + 1;
        }
        k = k + 1;
    }
    return count;
}

/* 四个数的排序网络（子集里没有数组，所以按名字展开）。返回打包值。 */
int sort4_packed(int a, int b, int c, int d) {
    int t = 0;
    if (a > b) { t = a; a = b; b = t; }
    if (c > d) { t = c; c = d; d = t; }
    if (a > c) { t = a; a = c; c = t; }
    if (b > d) { t = b; b = d; d = t; }
    if (b > c) { t = b; b = c; c = t; }
    return ((a * 10 + b) * 10 + c) * 10 + d;
}

/* 三层 else if + 复合条件（C 的 `&&` / `||`）。 */
int fizz_class(int n) {
    if (n % 3 == 0 && n % 5 == 0) {
        return 3;
    } else if (n % 3 == 0) {
        return 1;
    } else if (n % 5 == 0) {
        return 2;
    }
    return 0;
}

/* 拿 int 当条件（C 的写法，docs/186 §5 那张表的第一行）。 */
int truthy(int a, int b) {
    int acc = 0;
    if (a) {
        acc = acc + 1;
    }
    if (!b) {
        acc = acc + 2;
    }
    if (a && b) {
        acc = acc + 4;
    }
    if (a || b) {
        acc = acc + 8;
    }
    return acc;
}

/* 累加：同一个函数里两个 `for (int i = ...)`。 */
int double_sum(int n) {
    int acc = 0;
    for (int i = 1; i <= n; i = i + 1) {
        acc = acc + i;
    }
    for (int i = 1; i <= n; i = i + 1) {
        acc = acc + i * 2;
    }
    return acc;
}
