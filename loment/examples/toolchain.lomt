module toolchain

// P6 工具链演示 (docs/148): fmt / doc / diag / ir / test / bench / cov 的输入。

/// 斐波那契 (迭代)。
fn fib(n: u32) -> u32 {
    let a: u32 = 0;
    let b: u32 = 1;
    let i: u32 = 0;
    while i < n {
        let t: u32 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

/// 最大公约数。
fn gcd(a: u32, b: u32) -> u32 {
    let x: u32 = a;
    let y: u32 = b;
    while y != 0 {
        let t: u32 = x % y;
        x = y;
        y = t;
    }
    return x;
}

/// 位计数。
fn popcount(x: u32) -> u32 {
    let v: u32 = x;
    let c: u32 = 0;
    while v != 0 {
        c = c + v % 2;
        v = v / 2;
    }
    return c;
}

fn test_fib() -> bool { return fib(10) == 55; }

fn test_gcd() -> bool { return gcd(48, 18) == 6; }

fn test_popcount() -> bool { return popcount(255) == 8; }

fn test_fail_case() -> bool { return fib(0) == 0; }

fn bench_fib() -> u32 { return fib(20); }

fn bench_popcount() -> u32 { return popcount(255); }

fn cov_main() -> u32 {
    let a: u32 = 1;
    if a == 1 {
        return fib(5);
    }
    return 0;
}
