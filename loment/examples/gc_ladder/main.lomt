// loment/examples/gc_ladder/main.lomt — 四层梯各来一站（docs/210 §2）
//
// 这一份唯一的用处：让 v10 的 `gc_ladder` 四个数**都非零** —— 于是两个实现数出来的那份
// **组成**（`docs/210` §3）逐字节可比（`loment_potato_emit_test` 的 `EXTRA_COVERED`）。
//
// 四层**只在 `gc_auto_alpha` 档下动**（别的档 `gc_ladder` 恒为 `{0,0,0,total}`，
// 那半由 `lomentc_test` 的 `test_gc_ladder_rule` 在一对程序上钉）。

module gc_ladder

choose gc_auto_alpha
choose runtime

fn main() -> i32 {
    let a: ptr = alloc(64);          // L0：字面量尺寸 + 只被解引用透过
    store8(a, 0, 9);
    let n: u32 = 8;
    let b: ptr = alloc(n);           // L1：尺寸是变量（L0 接不到）、顶层声明、只解引用
    store8(b, 0, 3);
    let i: i32 = 0;
    while i < 4 {
        let c: ptr = alloc(n);       // L2：循环体内分配、名字不出体 -> 整个体退前沿
        store8(c, 0, 1);
        i = i + 1;
    }
    let d: ptr = alloc(n);           // L3：外逃（交给别的变量）—— 上面三层都接不到
    let e: ptr = d;
    store8(e, 0, 1);
    return (load8(a, 0) as i32) + (load8(b, 0) as i32) + (load8(e, 0) as i32);
}
