module all_loment

// M78: 全 Loment 演示 —— 多模块 + 泛型 + 能力域 + 用户态 syscall 的组合。
use mathutil

fn write_str(fd: u64, s: str) -> i64 {
    return syscall4(1, fd, str_ptr(s) as u64, str_len(s) as u64);
}

fn write_dec(fd: u64, v: u32) {
    let buf: ptr = alloc(12);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, (48 + x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n / 2 {
        let lo: u8 = load8(buf, i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    syscall4(1, fd, buf as u64, n as u64);
}

fn max_of<T>(a: T, b: T) -> T {
    if a > b {
        return a;
    }
    return b;
}

fn fib(n: u32) -> u32 {
    let a: u32 = 0;
    let b: u32 = 1;
    let i: u32 = 0;
    while i < n {
        let t: u32 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

fn _start() {
    let p: Pair = Pair { a: 20, b: 22 };
    let s: u32 = pair_sum(p);
    let d: u32 = double(s);
    let m: u32 = max_of(s, d);
    let f: u32 = fib(10);
    write_str(1, "M78 sum=");
    write_dec(1, s);
    write_str(1, " double=");
    write_dec(1, d);
    write_str(1, " max=");
    write_dec(1, m);
    write_str(1, " fib=");
    write_dec(1, f);
    write_str(1, "\n");
    if s == 42 && d == 84 && m == 84 && f == 55 {
        write_str(1, "M78 RESULT: PASS all-loment\n");
        syscall4(60, 0, 0, 0);
    }
    write_str(1, "M78 RESULT: FAIL all-loment\n");
    syscall4(60, 1, 0, 0);
}
