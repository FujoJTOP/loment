// loment/examples/native_res.lomt — M9/M10 验证集: Result/Option + ? + if let (docs/145)
//
// 预置泛型枚举 Option<T> / Result<T,E>; `?` 传播错误; `if let` 语法糖。

module native_res

fn parse_small(v: u32) -> Result<u32, u32> {
    if v > 10 {
        return Result::Err(1);
    }
    return Result::Ok(v);
}

fn twice(v: u32) -> Result<u32, u32> {
    let x: u32 = parse_small(v)?;
    return Result::Ok(x * 2);
}

fn call_ok() -> u32 {
    let r: Result<u32, u32> = twice(3);
    if let Result::Ok(v) = r {
        return v;
    }
    return 0;
}

fn call_err() -> u32 {
    let r: Result<u32, u32> = twice(50);
    if let Result::Ok(v) = r {
        return v;
    } else {
        return 99;
    }
}
