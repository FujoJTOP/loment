// loment/lib/proc.lomt — 起一个外部程序, 把它的 stdout 读回来 (docs/173 第二条路)
//
// **为什么需要这条路**: 调用外部库有两条腿, 走哪条由**对方是什么**决定。
//
//   * **C ABI 库** (C / C++ / Rust / Zig / Go(c-archive) / Swift / C#(NativeAOT) …) —— 它们
//     导出的是同一种符号与同一套传参约定, 所以 `extern fn` 声明 + `loment build --link`
//     就完了 (docs/173 §2 阶段 1/2)。
//   * **运行期** (Python / Java / JS …) —— 它们**不是导出 C ABI 的库**, 是解释器/虚拟机。
//     要在本进程里用它们得把解释器嵌进来 (libpython / libjvm), 而那要先把动态库装载做出来
//     (docs/173 阶段 3/4)。**在那之前这条路让它们现在就能用**: 起一个解释器进程, 把代码
//     交给它, 把它的输出读回来。Python 那边照旧 `import` 它自己的库。
//
// 所以这一条**不是"C ABI 的降级版", 是另一条腿**: 不需要链接、不需要改语言, 但多了一个
// 进程边界 —— 传的是**字节流**, 不是指针。这一句必须留着, 不然会有人以为能传结构体过去。
//
// 命名: 单元是平名字空间 (docs/158 §2), 所以公开名字一律 `proc_*`, 内部 `pc_*`。
//
// 平台: **只在 Linux/ELF 上可用**。PE 垫片只放行 8 个 syscall (docs/167), 没有 fork/pipe,
// 所以 Windows 包里 `proc_sh` 一律返回 -1 —— **不是悄悄失败**, 调用方能看见。
//
// 语言只有字节级访存 (`load8`/`store8`, 没有 store64), 所以指针数组是逐字节拼的。

module proc

/// 工作区大小: 路径 + 选项 + 命令行 + 管道 fd + argv 指针数组。
const PROC_WS: u32 = 4096;
/// 命令行的上限 (留出路径与 argv 的位置)。
const PROC_CMD_MAX: u32 = 1800;

fn pc_len(p: ptr) -> u32 {
    let n: u32 = 0;
    while load8(p, n) != 0 && n < PROC_WS {
        n = n + 1;
    }
    return n;
}

/// 把一个 `str` (指针 + 长度) 拷到 dst 并补 NUL —— 系统调用要的是 C 字符串。返回写入长度。
fn pc_cstr(dst: ptr, src: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(src, i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return n + 1;
}

/// 小端写 8 字节 —— 语言没有 store64, 逐字节拼。
fn pc_put64(dst: ptr, off: u32, v: u64) -> u32 {
    let i: u32 = 0;
    while i < 8 {
        let sh: u64 = (i * 8) as u64;
        store8(dst, off + i, ((v >> sh) & 255 as u64) as u8);
        i = i + 1;
    }
    return 8;
}

/// 小端读 4 字节 (管道 fd 是 int)。
fn pc_get32(src: ptr, off: u32) -> u32 {
    let v: u32 = load8(src, off) as u32;
    v = v + (load8(src, off + 1) as u32) * 256;
    v = v + (load8(src, off + 2) as u32) * 65536;
    v = v + (load8(src, off + 3) as u32) * 16777216;
    return v;
}

/// 跑 `/bin/sh -c <cmd>`, 把子进程的 stdout 读进 out (最多 cap 字节), 返回读到的字节数。
/// **-1 = 起不来** (fork/pipe 失败、命令太长, 或平台不支持)。
///
/// 不看子进程的退出码: 拿字节流是这条路的本分, 退出码的判断留给调用方自己解析输出。
pub fn proc_sh(cmd: str, out: ptr, cap: u32) -> i64 {
    let n: u32 = str_len(cmd);
    if n > PROC_CMD_MAX {
        return (0 as i64) - (1 as i64);      // 护栏: 命令行太长, 不越界
    }
    let ws: ptr = alloc(PROC_WS);
    // 布局: [0,8) "/bin/sh\0" | [8,16) "-c\0" | [16,16+cmd) 命令行
    //       [2048,2056) 管道 fd | [2080,2112) argv (4 个指针)
    let p_path: ptr = ptr_add(ws, 0);
    let p_opt: ptr = ptr_add(ws, 8);
    let p_cmd: ptr = ptr_add(ws, 16);
    let p_fds: ptr = ptr_add(ws, 2048);
    let p_argv: ptr = ptr_add(ws, 2080);
    store8(p_path, 0, 47 as u8);    // '/'
    store8(p_path, 1, 98 as u8);    // 'b'
    store8(p_path, 2, 105 as u8);   // 'i'
    store8(p_path, 3, 110 as u8);   // 'n'
    store8(p_path, 4, 47 as u8);    // '/'
    store8(p_path, 5, 115 as u8);   // 's'
    store8(p_path, 6, 104 as u8);   // 'h'
    store8(p_path, 7, 0 as u8);
    store8(p_opt, 0, 45 as u8);     // '-'
    store8(p_opt, 1, 99 as u8);     // 'c'
    store8(p_opt, 2, 0 as u8);
    let _cl: u32 = pc_cstr(p_cmd, str_ptr(cmd), n);
    // argv = { path, "-c", cmd, NULL }
    let _a0: u32 = pc_put64(p_argv, 0, p_path as u64);
    let _a1: u32 = pc_put64(p_argv, 8, p_opt as u64);
    let _a2: u32 = pc_put64(p_argv, 16, p_cmd as u64);
    let _a3: u32 = pc_put64(p_argv, 24, 0 as u64);
    // pipe2(fds, 0)
    let pr: i64 = syscall4(293, p_fds as u64, 0, 0);
    if pr < 0 {
        return (0 as i64) - (1 as i64);
    }
    let rfd: u64 = pc_get32(p_fds, 0) as u64;
    let wfd: u64 = pc_get32(p_fds, 4) as u64;
    // fork()
    let pid: i64 = syscall4(57, 0, 0, 0);
    if pid < 0 {
        return (0 as i64) - (1 as i64);
    }
    if pid == 0 {
        // ---- 子进程: stdout 接到管道写端, 然后 exec。
        let _c1: i64 = syscall4(3, rfd, 0, 0);            // close(读端)
        let _c2: i64 = syscall4(33, wfd, 1, 0);           // dup2(写端, 1)
        let _c3: i64 = syscall4(3, wfd, 0, 0);            // dup2 之后才关写端
        let _ex: i64 = syscall4(59, p_path as u64, p_argv as u64, 0);   // execve(path, argv, NULL)
        let _x: i64 = syscall4(60, 127, 0, 0);            // exec 失败: 退出 127, 不返回
    }
    // ---- 父进程: **先关写端**, 否则读端永远等不到 EOF (子进程退了管道还开着)。
    let _c4: i64 = syscall4(3, wfd, 0, 0);
    let total: u32 = 0;
    let go: u32 = 1;
    while go == 1 && total < cap {
        // **写成两条语句, 不写 `(ptr_add(out, total)) as u64`**: 自举 codegen 判 `ptr -> 整数`
        // 的转换时看的是**源类型的 token**, 而括号里的表达式没有那个 token, 于是它会掉进
        // int 那条路发出 `zext i32` —— 把指针截成 32 位 (参考实现发的是 `ptrtoint ptr`)。
        // 这是自举侧一个**已知分叉** (记在 docs/158 §4): 语料里以前没有"括号包着的 ptr 表达式
        // 再 as"这种写法, 所以一直没暴露。经过一个带类型的 `let` 就绕开了。
        let dst: ptr = ptr_add(out, total);
        let rn: i64 = syscall4(0, rfd, dst as u64, (cap - total) as u64);
        if rn <= 0 {
            go = 0;
        } else {
            total = total + (rn as u32);
        }
    }
    let _c5: i64 = syscall4(3, rfd, 0, 0);
    let _w: i64 = syscall6(61, pid as u64, 0, 0, 0, 0);   // wait4(pid, NULL, 0, NULL)
    return total as i64;
}

/// 便捷: 跑一段 Python 代码, 把它的 stdout 读回来。
/// 代码里的引号要自己小心 —— 它经过 `/bin/sh -c`, 所以用双引号包 `-c` 的实参更稳。
pub fn proc_python(code: str, out: ptr, cap: u32) -> i64 {
    return proc_sh(str_concat("python3 -c '", str_concat(code, "'")), out, cap);
}
