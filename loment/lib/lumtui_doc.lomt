    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_H_MODE);
}

pub fn lumtui_fuc_h_val(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_H_VAL);
}

pub fn lumtui_fuc_pad_l(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_PAD_L);
}

pub fn lumtui_fuc_pad_t(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_PAD_T);
}

