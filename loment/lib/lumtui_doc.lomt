    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_X);
}

pub fn lumtui_fuc_y(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_Y);
}

