}

pub fn lumtui_fuc_align(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_ALIGN);
}

pub fn lumtui_fuc_justify(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_JUSTIFY);
}

/// 字号。0 是"没写" -> 默认像素数。
pub fn lumtui_fuc_font_px(b: ptr, i: u32) -> u32 {
    let v: u32 = lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_SIZE);
    if v == 0 {
        return lumtui_default_px();
    }
    return v;
}

pub fn lumtui_fuc_bg(b: ptr, i: u32) -> u32 {
    return lumtui_ld32(lumtui_fuc_nrec(b, i), LUMTUI_N_BG);
}

pub fn lumtui_fuc_fg(b: ptr, i: u32) -> u32 {
    return lumtui_ld32(lumtui_fuc_nrec(b, i), LUMTUI_N_FG);
