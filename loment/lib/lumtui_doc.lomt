pub fn lumtui_fuc_tone(b: ptr, i: u32) -> u32 {
    return lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_TONE);
}

/// 不透明度: 0 当成 255 (与 `fuc.rs::Node::opacity` 同一条 —— 没写 = 不透明)。
pub fn lumtui_fuc_opacity(b: ptr, i: u32) -> u32 {
    let v: u32 = lumtui_ld16(lumtui_fuc_nrec(b, i), LUMTUI_N_OPACITY);
    if v == 0 {
        return 255;
    }
    return v;
}

pub fn lumtui_fuc_first_child(b: ptr, i: u32) -> u32 {
    return lumtui_ld32(lumtui_fuc_nrec(b, i), LUMTUI_N_FIRST_CHILD);
}

pub fn lumtui_fuc_extra(b: ptr, i: u32) -> u32 {
    return lumtui_ld32(lumtui_fuc_nrec(b, i), LUMTUI_N_EXTRA);
}

// ---- 载入侧的字符串表

pub fn lumtui_fuc_str_count(b: ptr) -> u32 {
    return lumtui_ld32(b, lumtui_ld32(b, LUMTUI_H_STR_OFF));
}

/// 字符串 `idx` 的**绝对地址**。找不到给空串的地址 (与 `fuc.rs::str_at` 同一条)。
pub fn lumtui_fuc_str_ptr(b: ptr, idx: u32) -> ptr {
    let base: u32 = lumtui_ld32(b, LUMTUI_H_STR_OFF);
    let total: u32 = lumtui_ld32(b, LUMTUI_H_STR_LEN);
    let o: u32 = 4;
    let i: u32 = 0;
    let n: u32 = lumtui_fuc_str_count(b);
    while i < n {
        if o + 2 > total {
            return ptr_add(b, base + 6);
        }
        let l: u32 = lumtui_ld16(b, base + o);
        if i == idx {
            return ptr_add(b, base + o + 2);
        }
        o = o + 2 + l;
        i = i + 1;
    }
    return ptr_add(b, base + 6);
}

pub fn lumtui_fuc_str_len(b: ptr, idx: u32) -> u32 {
    let base: u32 = lumtui_ld32(b, LUMTUI_H_STR_OFF);
    let total: u32 = lumtui_ld32(b, LUMTUI_H_STR_LEN);
    let o: u32 = 4;
    let i: u32 = 0;
    let n: u32 = lumtui_fuc_str_count(b);
    while i < n {
        if o + 2 > total {
            return 0;
        }
        let l: u32 = lumtui_ld16(b, base + o);
        if i == idx {
            return l;
        }
        o = o + 2 + l;
        i = i + 1;
    }
    return 0;
}

pub fn lumtui_fuc_tok_count(b: ptr) -> u32 {
    return lumtui_ld32(b, LUMTUI_H_TOK_COUNT);
}
