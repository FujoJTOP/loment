// loment/lib/sha256.lomt — SHA-256 (Loment 版, 无 Python)
//
// 从 loment/tools/lompkg.lomt 里**原样抽出**的一份库 (2026-09-14, docs/167 Stage 3):
// lompkg 与 loment/tools/lomrel.lomt 都要用, 与其抄两遍, 不如放进 lib/ 各 use 一次。
// 抽的是**逐字节相同**的算法与常量 —— lompkg 的门禁 (C17) 就是这次抽取的判据。
//
// 用法 (调用方自己管文件 I/O):
//   sha_init(s); sha_update(s, p, n); sha_final(s, dig); hex_dig(dig, hex64);
//   s 指向至少 1024 字节的状态块 (布局见下面的 SH_*), dig 32 字节, hex64 64 字节。

module sha256

// 状态块内布局 (与 lompkg 原版一致)
pub const SH_CNT: u32 = 32;         // 缓冲里的字节数
pub const SH_TOT: u32 = 36;         // 总字节数 (u32 够: 单次不会到 512 MiB)
pub const SH_BLK: u32 = 48;         // 64 字节块
pub const SH_W: u32 = 112;          // 消息表 w[64]
pub const SH_K: u32 = 368;          // 常量表 K[64]

pub fn sha_init(s: ptr) {
    store32(s, 0, 1779033703);
    store32(s, 4, 3144134277);
    store32(s, 8, 1013904242);
    store32(s, 12, 2773480762);
    store32(s, 16, 1359893119);
    store32(s, 20, 2600822924);
    store32(s, 24, 528734635);
    store32(s, 28, 1541459225);
    store32(s, SH_CNT, 0);
    store32(s, SH_TOT, 0);
    store32(s, SH_K + 0*4, 1116352408); store32(s, SH_K + 1*4, 1899447441); store32(s, SH_K + 2*4, 3049323471); store32(s, SH_K + 3*4, 3921009573);
    store32(s, SH_K + 4*4, 961987163); store32(s, SH_K + 5*4, 1508970993); store32(s, SH_K + 6*4, 2453635748); store32(s, SH_K + 7*4, 2870763221);
    store32(s, SH_K + 8*4, 3624381080); store32(s, SH_K + 9*4, 310598401); store32(s, SH_K + 10*4, 607225278); store32(s, SH_K + 11*4, 1426881987);
    store32(s, SH_K + 12*4, 1925078388); store32(s, SH_K + 13*4, 2162078206); store32(s, SH_K + 14*4, 2614888103); store32(s, SH_K + 15*4, 3248222580);
    store32(s, SH_K + 16*4, 3835390401); store32(s, SH_K + 17*4, 4022224774); store32(s, SH_K + 18*4, 264347078); store32(s, SH_K + 19*4, 604807628);
    store32(s, SH_K + 20*4, 770255983); store32(s, SH_K + 21*4, 1249150122); store32(s, SH_K + 22*4, 1555081692); store32(s, SH_K + 23*4, 1996064986);
    store32(s, SH_K + 24*4, 2554220882); store32(s, SH_K + 25*4, 2821834349); store32(s, SH_K + 26*4, 2952996808); store32(s, SH_K + 27*4, 3210313671);
    store32(s, SH_K + 28*4, 3336571891); store32(s, SH_K + 29*4, 3584528711); store32(s, SH_K + 30*4, 113926993); store32(s, SH_K + 31*4, 338241895);
    store32(s, SH_K + 32*4, 666307205); store32(s, SH_K + 33*4, 773529912); store32(s, SH_K + 34*4, 1294757372); store32(s, SH_K + 35*4, 1396182291);
    store32(s, SH_K + 36*4, 1695183700); store32(s, SH_K + 37*4, 1986661051); store32(s, SH_K + 38*4, 2177026350); store32(s, SH_K + 39*4, 2456956037);
    store32(s, SH_K + 40*4, 2730485921); store32(s, SH_K + 41*4, 2820302411); store32(s, SH_K + 42*4, 3259730800); store32(s, SH_K + 43*4, 3345764771);
    store32(s, SH_K + 44*4, 3516065817); store32(s, SH_K + 45*4, 3600352804); store32(s, SH_K + 46*4, 4094571909); store32(s, SH_K + 47*4, 275423344);
    store32(s, SH_K + 48*4, 430227734); store32(s, SH_K + 49*4, 506948616); store32(s, SH_K + 50*4, 659060556); store32(s, SH_K + 51*4, 883997877);
    store32(s, SH_K + 52*4, 958139571); store32(s, SH_K + 53*4, 1322822218); store32(s, SH_K + 54*4, 1537002063); store32(s, SH_K + 55*4, 1747873779);
    store32(s, SH_K + 56*4, 1955562222); store32(s, SH_K + 57*4, 2024104815); store32(s, SH_K + 58*4, 2227730452); store32(s, SH_K + 59*4, 2361852424);
    store32(s, SH_K + 60*4, 2428436474); store32(s, SH_K + 61*4, 2756734187); store32(s, SH_K + 62*4, 3204031479); store32(s, SH_K + 63*4, 3329325298);
}

pub fn rotr(x: u32, n: u32) -> u32 {
    let w: u32 = 32;
    return (x >> n) | (x << (w - n));
}

pub fn sha_block(s: ptr) {
    let blk: ptr = ptr_add(s, SH_BLK);
    let w: ptr = ptr_add(s, SH_W);
    let kt: ptr = ptr_add(s, SH_K);
    let i: u32 = 0;
    while i < 16 {
        let v: u32 = load8(blk, i * 4) * 16777216 + load8(blk, i * 4 + 1) * 65536
                   + load8(blk, i * 4 + 2) * 256 + load8(blk, i * 4 + 3);
        store32(w, i * 4, v);
        i = i + 1;
    }
    i = 16;
    while i < 64 {
        let x: u32 = load32(w, (i - 15) * 4);
        let y: u32 = load32(w, (i - 2) * 4);
        let s0: u32 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
        let s1: u32 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10);
        store32(w, i * 4, load32(w, (i - 16) * 4) + s0 + load32(w, (i - 7) * 4) + s1);
        i = i + 1;
    }
    let a: u32 = load32(s, 0);
    let b: u32 = load32(s, 4);
    let c: u32 = load32(s, 8);
    let d: u32 = load32(s, 12);
    let e: u32 = load32(s, 16);
    let f: u32 = load32(s, 20);
    let g: u32 = load32(s, 24);
    let h: u32 = load32(s, 28);
    i = 0;
    while i < 64 {
        let bs1: u32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        let ch: u32 = (e & f) ^ ((e ^ 4294967295) & g);
        let t1: u32 = h + bs1 + ch + load32(kt, i * 4) + load32(w, i * 4);
        let bs0: u32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
        let t2: u32 = bs0 + maj;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        i = i + 1;
    }
    store32(s, 0, load32(s, 0) + a);
    store32(s, 4, load32(s, 4) + b);
    store32(s, 8, load32(s, 8) + c);
    store32(s, 12, load32(s, 12) + d);
    store32(s, 16, load32(s, 16) + e);
    store32(s, 20, load32(s, 20) + f);
    store32(s, 24, load32(s, 24) + g);
    store32(s, 28, load32(s, 28) + h);
}

pub fn sha_update(s: ptr, p: ptr, n: u32) {
    let c: u32 = load32(s, SH_CNT);
    store32(s, SH_TOT, load32(s, SH_TOT) + n);
    let i: u32 = 0;
    while i < n {
        store8(s, SH_BLK + c, load8(p, i) as u8);
        c = c + 1;
        i = i + 1;
        if c == 64 {
            sha_block(s);
            c = 0;
        }
    }
    store32(s, SH_CNT, c);
}

pub fn sha_final(s: ptr, outd: ptr) {
    let n: u32 = load32(s, SH_CNT);
    store8(s, SH_BLK + n, 128 as u8);
    n = n + 1;
    if n > 56 {
        while n < 64 {
            store8(s, SH_BLK + n, 0 as u8);
            n = n + 1;
        }
        sha_block(s);
        n = 0;
    }
    while n < 56 {
        store8(s, SH_BLK + n, 0 as u8);
        n = n + 1;
    }
    let bit: u32 = load32(s, SH_TOT) * 8;
    store8(s, SH_BLK + 56, 0 as u8);
    store8(s, SH_BLK + 57, 0 as u8);
    store8(s, SH_BLK + 58, 0 as u8);
    store8(s, SH_BLK + 59, 0 as u8);
    store8(s, SH_BLK + 60, ((bit >> 24) % 256) as u8);
    store8(s, SH_BLK + 61, ((bit >> 16) % 256) as u8);
    store8(s, SH_BLK + 62, ((bit >> 8) % 256) as u8);
    store8(s, SH_BLK + 63, (bit % 256) as u8);
    sha_block(s);
    let i: u32 = 0;
    while i < 8 {
        let v: u32 = load32(s, i * 4);
        store8(outd, i * 4, ((v >> 24) % 256) as u8);
        store8(outd, i * 4 + 1, ((v >> 16) % 256) as u8);
        store8(outd, i * 4 + 2, ((v >> 8) % 256) as u8);
        store8(outd, i * 4 + 3, (v % 256) as u8);
        i = i + 1;
    }
}

pub fn hex_dig(dig: ptr, out: ptr) {
    let hexs: str = "0123456789abcdef";
    let i: u32 = 0;
    while i < 32 {
        let b: u32 = load8(dig, i);
        store8(out, i * 2, str_byte(hexs, b / 16) as u8);
        store8(out, i * 2 + 1, str_byte(hexs, b % 16) as u8);
        i = i + 1;
    }
}
