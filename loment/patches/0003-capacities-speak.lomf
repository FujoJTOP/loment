>>>
new <<<
    let m: u32 = emit_module(unit, toks2, ir, cg);
    if m == 0 {
        // **两张表共用这一句，所以两张都点名**（`#345` 的 (a)）：发射器对 `CG_MAXFN`
        // 与 `CG_MAXENUM` 都只 `return 0`，从这一端看不出是哪一张撞的 —— 那就别猜，
        // 把两个名字一起写出来（原先只写"函数数"，于是枚举爆掉时用户去删函数）。
        return fail("fujoc-s: 单元超过 codegen 表容量 —— 函数数 > 4600 或枚举数 > 320 (拆小门面)\n");
>>>
