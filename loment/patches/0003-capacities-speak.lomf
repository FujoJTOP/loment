lomf 1
mod   0003-capacities-speak
about 编译器**前端**那几处固定容量：越界时**说出来**，不再静默截断（issue #345 采纳的 (a)）。
about 
about #345 的选项里，**(a)「给每个固定容量补一条失败路径」是唯一既安全、又不动那条招牌的一条**
about （它自己写的），而它的第一档是**能验、能守住**的一条线：**用户一份源文件推得动的那些
about 容量，越界必须有话**。(b) 让编译器链运行期、(c) 让 `alloc` 变成真正的分配器、(d) 把
about `no_runtime` 的说法收窄 —— 三条都比这一笔大，理由记在 `docs/255`。
about 
about 这一笔落的四处都在 `driver.lomt`，症状都是**静默截断**（不是写穿）：
about   * `SLOT` —— 源文件不小于 512 KiB 时读满槽，截断后的源会给出一串**与被截断位置无关**的解析错；
about   * `DIR_CAP` / `SUBP_CAP` —— 路径拼装截断，于是 `openat` 去找一个不存在的路径，
about     用户看到的是「这个 `use` 找不到」；
about   * `EXT_CAP` —— `loment.conf` 的源后缀截断，而截断出来的后缀**可能正好又叫中另一个词法档**。
about 
about 顺带把 `codegen` 那两张表共用的那句报错**点全名**：发射器对 `CG_MAXFN` 与 `CG_MAXENUM` 都只
about `return 0`，从驱动这一端看不出是哪一张撞的 —— 原先只写「函数数」，于是枚举爆掉时用户会去删函数。
about 
about 棘轮：`loment_caps_test::test_the_front_end_has_no_silent_capacity` 把「前端缺口 0」钉住，
about `EXPLAINED` 逐条写清每一处排除的来路（见 `tools/loment_caps.py`）。

edit loment/selfhost/driver.lomt expect 1
old <<<
    let raw_n: u64 = read_all(fd as u64, slot, SLOT as u64);
    syscall4(3, fd as u64, 0, 0);
    let nb: u32 = strip_cr(slot, raw_n as u32);
>>>
new <<<
    let raw_n: u64 = read_all(fd as u64, slot, SLOT as u64);
    syscall4(3, fd as u64, 0, 0);
    // **读满了槽 ≠ 文件就这么大**（`#345` 的 (a)：每一个固定容量越界时都要**有话**）。
    // 槽原先静默截断：一份大于 512 KiB 的源会**少一截**，用户看到的是一串与被截断位置
    // 无关的解析错 —— 那是本仓最不肯让的形状（`docs/188` 的"宁拒勿猜"）。
    // 判据只需一次比较：读满 `SLOT` 就说明**至少**这么大，下面那句把这个事实说出来。
    if raw_n >= SLOT as u64 {
        return fail("fujoc-s: 源文件不小于 524288 字节 —— 单文件槽装不下它，而截断会给出与被截断位置无关的解析错 (#345)。把门面拆小\n") as u64;
    }
    let nb: u32 = strip_cr(slot, raw_n as u32);
>>>

edit loment/selfhost/driver.lomt expect 1
old <<<
fn subdirs_of(dirp: ptr, dl: u32, dst: ptr, scr: ptr) -> u32 {
    let dent: ptr = ptr_add(scr, DENT_OFF);
    let i: u32 = 0;
    while i < dl && i < DIR_CAP - 1 {
        store8(scr, i, load8(dirp, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
>>>
new <<<
fn subdirs_of(dirp: ptr, dl: u32, dst: ptr, scr: ptr) -> u32 {
    let dent: ptr = ptr_add(scr, DENT_OFF);
    // **目录路径比槽大 ⇒ 说出来**（`#345` 的 (a)）。原来这条循环只是**停**：截断过的路径
    // 会去 `openat` 一个不存在的目录，用户看到的是"这个 `use` 找不到"（`docs/188` 的
    // "宁拒勿猜"：宁可报错，也不要让一个截断过的输入伪装成一个查无此物）。
    if dl >= DIR_CAP - 1 {
        return fail("fujoc-s: 目录路径超过 1024 字节 (项目根/工具目录/版本名的上限, #345)\n");
    }
    let i: u32 = 0;
    while i < dl && i < DIR_CAP - 1 {
        store8(scr, i, load8(dirp, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
>>>

edit loment/selfhost/driver.lomt expect 1
old <<<
    while j < 200 && e < SUBP_CAP - 1 && load8(dent, nm + j) != 0 {
        store8(w, e, load8(dent, nm + j) as u8);
        e = e + 1;
        j = j + 1;
    }
    store8(w, e, 0 as u8);
>>>
new <<<
    while j < 200 && e < SUBP_CAP - 1 && load8(dent, nm + j) != 0 {
        store8(w, e, load8(dent, nm + j) as u8);
        e = e + 1;
        j = j + 1;
    }
    // 循环是三个条件里哪一个停的？**`e` 撞上沿**就是路径被截断 —— 那时下面这次 `openat`
    // 找的是一个不存在的路径，而调用方只知道"这个名字不是目录"（`#345` 的 (a)）。
    if e >= SUBP_CAP - 1 && load8(dent, nm + j) != 0 {
        return fail("fujoc-s: 子路径超过 1472 字节 (每层源文件一个槽, #345)\n");
    }
    store8(w, e, 0 as u8);
>>>

edit loment/selfhost/driver.lomt expect 1
old <<<
    while q < sl - 2 && q < EXT_CAP - 1 {
        let ch: u8 = load8(buf, st + 1 + q) as u8;
        if ch == 92 {
            bad = 1;                          // 带转义的也拒 (见下)
        }
        store8(dst, q, ch);
        q = q + 1;
    }
    store8(dst, q, 0 as u8);
>>>
new <<<
    while q < sl - 2 && q < EXT_CAP - 1 {
        let ch: u8 = load8(buf, st + 1 + q) as u8;
        if ch == 92 {
            bad = 1;                          // 带转义的也拒 (见下)
        }
        store8(dst, q, ch);
        q = q + 1;
    }
    // 同 `SUBP_CAP` 那条：`q` 撞上沿而字符串里还有字节 ⇒ 后缀被截断（`#345` 的 (a)）。
    // 静默截断的后果比"配错了"更难查：截出来的后缀**可能正好又叫中另一个词法档**。
    if q >= EXT_CAP - 1 && q < sl - 2 {
        return fail("fujoc-s: loment.conf 里的源后缀超过 256 字节 (#345)\n");
    }
    store8(dst, q, 0 as u8);
>>>

