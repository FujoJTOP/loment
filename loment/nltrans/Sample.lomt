// 由 tools/lomt_from.py 从 Potato 形式对象生成 —— 请勿手改。
// 它是**带实现的单元** (`--impl`, docs/186): 带正文的函数是真 `pub fn`，
// 没带正文的仍是 `extern fn` (实现在源语言那一侧, docs/173 §2)。
// 源对象: unit=sample language=loment potato=v6

module sample

// ---- 常量
pub const LIMIT: i64 = 3;

// ---- 由正文翻译出来的实现 (docs/186: natural -> Loment, tools/nltrans.py)
fn nl_write_num(fd: u64, v: i64) {
    let buf: ptr = alloc(24);
    let start: u32 = 0;
    let x: u64 = 0;
    let zero: i64 = 0;
    if v < zero {
        store8(buf, 0, 45 as u8);
        start = 1;
        x = (zero - v) as u64;
    } else {
        x = v as u64;
    }
    let n: u32 = start;
    if x == 0 {
        store8(buf, n, 48 as u8);
        n = n + 1;
    }
    while x > 0 {
        store8(buf, n, (48 + ((x % 10) as u32)) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < (n - start) / 2 {
        let lo: u8 = load8(buf, start + i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, start + i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    syscall4(1, fd, buf as u64, n as u64);
}

pub fn add(a: i64, b: i64) -> i64 {
    return (a + b);
}

pub fn gcd(a: i64, b: i64) -> i64 {
    let x: i64 = a;
    let y: i64 = b;
    while (y != 0) {
        let t: i64 = (x % y);
        x = y;
        y = t;
    }
    return x;
}

pub fn sum_to(n: i64) -> i64 {
    let acc: i64 = 0;
    for i in 1..n {
        acc = add(acc, i);
    }
    return acc;
}

pub fn tally(n: i64) -> i64 {
    let v: i64 = n;
    let steps: i64 = 0;
    while (v > 0) {
        steps = (steps + 1);
        v = (v / 2);
    }
    return steps;
}

pub fn is_even(n: i64) -> bool {
    return ((n % 2) == 0);
}

pub fn label(n: i64) -> i64 {
    if is_even(n) {
        return 1;
    } else {
        return 0;
    }
}

pub fn run() -> i64 {
    let a: i64 = sum_to(LIMIT);
    let b: i64 = gcd(48, 18);
    let c: i64 = label(8);
    let d: i64 = tally(100);
    let e: i64 = (LIMIT * 10);
    return ((((a + b) + c) + d) + e);
}

pub fn _start() {
    let buf: ptr = alloc(8);
    store8(buf, 0 as u32, 42 as u8);
    syscall4(1, 1, str_ptr("sample: ") as u64, str_len("sample: ") as u64);
    nl_write_num(1, run() as i64);
    syscall4(1, 1, str_ptr(" painted ") as u64, str_len(" painted ") as u64);
    nl_write_num(1, load8(buf, 0) as i64);
    syscall4(1, 1, str_ptr("\n") as u64, str_len("\n") as u64);
    syscall4(60 as u64, run() as u64, 0 as u64, 0 as u64);
}
