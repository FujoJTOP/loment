// loment/tools/lompotc.lomt — Loment 版「花括号写法 -> 形式对象」前端（docs/186 / 188）
//
// 判据: 同一份源喂本程序与 `tools/potato_from.py::from_c`（或 `from_cpp` / `from_java`），
// 产出的 **Potato JSON 逐字节相同**（判据加在 tools/loment_ctrans_test.py）。这是 §4.1
// 那根轴（六门翻译器）的**前端**那一半 —— 建树 + 类型映射 + 正文保真; 发射那一半
// （Potato -> Loment 源）在 `lomt_from.py` 里, 还没有 Loment 版。
//
// **这不是移植 `ctrans`**（那是 `trans_core` 的语法树那条路）—— 判据走的是
// `potato_from.from_c -> lomt_from.emit_lomt` 这条链, 所以这一半要对着 `from_c` 移植。
//
// 与 `potato_from.py` 的**刻意偏离**（写在最显眼处）:
//   1. **只吐对象，不吐报告**。`Report`（skipped / field_notes / validate_errors）判据不比,
//      本程序就不产出它 —— 但**跳过的判定照做**: 该丢的实体一条都不能进对象。
//   2. 上游用的是**正则**（`_C_STRUCT` / `_C_FIELD` / `_C_ENUM` / `_C_FN`），这里是手写的
//      扫描器, 语义按那四条逐条对齐（含 `_C_FN` 那两处惰性量词）。
//   3. 实体上限 64 / 字段上限 32 / 枚举成员上限 64 —— 语料远达不到; 超了**报错**, 不静默丢。
//
// **方言**: `lompotc <src>` 是 C；`lompotc --cpp <src>` 是 C++。两门共用同一个引擎
// （上游也是 —— `_from_c(..., grammar, types)`），差异只有**类型表**那一张：
//   * C   —— `char`/`char *`/`const char *` 都映（`i8` / `str` / `str`）
//   * C++ —— 这三个**明确不映**（`char` 的符号性在 C++ 里是实现定义的，表示层不该猜），
//            另外多认 `long long` / `unsigned long long`
// 之所以要分"C 是命中且有效"与"C++ 是命中但无映射"：上游是 `if t in types: return types[t]`
// —— **命中就是命中，哪怕是 `None`**，后面的指针分支不再走。混了的话 `char *` 在 C++ 下
// 会掉进指针分支被判成 `str`，而这正是那一格要拦住的猜测。
//
// **方言**: `lompotc --java <src>` / `--csharp <src>` —— 上游 `_from_class_lang` 是
// "函数住在 `class X { … }` 里"那一族的**共用引擎**（Java / C#），与 C 那套**不是同一批
// 扫描器**: 类体要按花括号**配平切成员**（深度 0 上遇 `;` 或一段完整的 `{…}` 收一个，
// 末尾不成段的丢掉），类型另一张表（`char` 是**16 位无符号** ⇒ `u16`；装箱类型与
// `float`/`double` 显式无映射），而且**字符串字面量先换成 `""`、抹注释在后**
// （那一层会**改长度** ⇒ 走 `M_SRC2` 两级）。
//
// 两门共用一个引擎、差异只在方言表（`docs/188` §7.1）—— 由 `mode`（3=Java / 4=C#）
// 分派。**四处真不同**: 声明形状（C# 多收 `struct`，且修饰词是**一整张反复的表**，连
// `public` 都在里面）、常量（C# 是 `const`，**隐含 static**）、成员修饰词表（C# 多
// `internal`/`sealed`/`partial`/`async` 那十六个）、类型表（**`byte` 是两门唯一没落在
// 同一格上的**：C# 无符号 ⇒ `u8`、Java 有符号 ⇒ `i8`；`String`/`boolean` 只有 Java 有）。
//
// 差 `from_rust`（还是轻量解析那一派）与 `from_python`（坐在 `ast` 上，不是）
// 以及发射那一半（`lomt_from`）。
//
// **Go**（`--go`，mode 5）是第三条支路: 类型写在**名字后面**、条件不带括号、没有
// `while`；`struct` 的体**不是**花括号配平出来的（到第一个以 `}` 起头的行为止），
// 形参有**分组写法** `func gcd(a, b int)`，`//export` 才记 `abi: "c"` 且不带正文。
//
// 用法: `lompotc [--cpp|--java|--csharp|--go] <src>` —— 对象打到 stdout（紧凑那种）。

module lompotc

use bytes
use json

// ---------------------------------------------------------------- 尺寸
const IN_CAP: u32 = 131072;        // 源
const OUT_CAP: u32 = 524288;       // JSON 输出
const NMAX: u32 = 64;              // 实体/名字上限
const NW: u32 = 72;                // known 表一条
const FMAX: u32 = 32;              // 一个 struct 的字段上限
const FW: u32 = 24;                // 字段一条: name(off,len) + type(off,len) + arr(off,len)
const MMAX: u32 = 64;              // 一个 enum 的成员上限
const MW: u32 = 12;                // 成员一条: name(off,len) + value
const CMAX: u32 = 128;             // 一个类体的成员上限（Java 那一门）
const CW: u32 = 12;                // 类体成员一条: start, end, off(在类体里)

// ---------------------------------------------------------------- 内存布局
const M_SRC: u32 = 0;              // IN_CAP      -> 131072
const M_BODY: u32 = 131072;        // IN_CAP      -> 262144   （抹注释后的等长副本）
const M_OUT: u32 = 262144;         // OUT_CAP     -> 786432
const M_NAMES: u32 = 786432;       // NMAX*72 = 4608   -> 791040   （known: struct 名）
const M_FLD: u32 = 791040;         // FMAX*24 = 768    -> 791808   （当前 struct 的字段）
const M_MEMB: u32 = 791808;        // MMAX*12 = 768    -> 792576   （当前 enum 的成员）
const M_IDENT: u32 = 792576;       // 512              -> 793088   （ident 暂存）
const M_TYPE: u32 = 793088;        // 512              -> 793600   （类型映射暂存）
const M_TXT: u32 = 793600;         // 512              -> 794112   （拼出来的类型串）
const M_TXT2: u32 = 794112;        // 512              -> 794624   （参数名的副本）
const M_R: u32 = 794624;           // 128              -> 794752   （扫描结果格）
const M_CNST: u32 = 794752;        // 8192             -> 802944   （已发出的 const 名）
const M_SC: u32 = 802944;          // 64               -> 803008
// 标量: [0]=源长度  [8]=模式(1=C / 2=C++)
// ⚠ **argv 缓冲要单独一块**（原先是 M_CAP-2048 —— 那正好压在 M_SC 上：
// 读一次 cmdline 就把"源长度"与"模式"盖掉，症状是长文件名下 unit 名多出几个下划线、
// 或者干脆打不开源文件。2026-09-20 在 C++ 那一门撞到）。
const M_ARG: u32 = 803008;         // 2048             -> 805056
// ---- Java（`_from_class_lang`）那一半要的几块
const M_SRC2: u32 = 805888;        // IN_CAP           -> 936960   （字面量换成 "" 的副本）
const M_NORM: u32 = 936960;        // IN_CAP           -> 1068032  （当前成员的归一化文本）
const M_CMEM: u32 = 1068032;       // CMAX*12          -> 1069568  （一个类体的成员表）
const M_JS: u32 = 1069568;         // 128              -> 1069696  （Java 扫描/分类结果格）
const M_JT: u32 = 1069696;         // 4096             -> 1073792  （类型文本暂存）
const M_CAP: u32 = 1073920;

// 扫描结果格（find_struct / find_enum / find_fn 共用）
const R_NO: u32 = 0;               // 名字起点
const R_NL: u32 = 4;               // 名字长度
const R_IS: u32 = 8;               // 内容/参数起点
const R_IE: u32 = 12;              // 内容/参数终点
const R_MS: u32 = 16;              // 整段起点
const R_ME: u32 = 20;              // 整段终点（`;` 或 `{` 之后）
const R_BR: u32 = 24;              // 尾部是不是 `{`
const R_RO: u32 = 28;              // 返回类型起点
const R_RL: u32 = 32;              // 返回类型长度
const R_TMP: u32 = 36;             // 杂项

// Java 那一门的扫描/分类结果格（M_JS 里）
const J_OB: u32 = 0;               // 类体那个 `{` 的下标
const J_CE: u32 = 4;               // 配对的 `}`；FAIL = 不配平
const J_NO: u32 = 8;               // 类/枚举名（在 `body` 里）
const J_NL: u32 = 12;
const J_TS: u32 = 24;              // 分类结果: 类型 token（在 norm 里）
const J_TL: u32 = 28;
const J_NS: u32 = 32;              // 分类结果: 名字
const J_NL2: u32 = 36;
const J_PS: u32 = 40;              // 分类结果: 参数表
const J_PL: u32 = 44;
const J_VS: u32 = 48;              // 分类结果: 常量值的数字段
const J_VL: u32 = 52;
const J_VN: u32 = 56;              // 分类结果的负号
const J_K: u32 = 60;               // jl_type 的临时（数组层数）
const J_SP0: u32 = 64;             // last_tok 的 scratch
const J_MS: u32 = 68;              // Go: 整段起点（行首，上游 m.start()）
const J_RS: u32 = 72;              // Go: 返回类型起点/长度
const J_RL: u32 = 76;

const FAIL: u32 = 4294967295;

// ---------------------------------------------------------------- 基础

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let n: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if n <= 0 {
            return off;
        }
        off = off + (n as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn fail(msg: str) -> u32 {
    let _a: u64 = write_all(2, str_ptr(msg), str_len(msg) as u64);
    return die(1);
}

fn ld32(p: ptr, off: u32) -> u32 {
    let v: u32 = load8(p, off);
    v = v + load8(p, off + 1) * 256;
    v = v + load8(p, off + 2) * 65536;
    v = v + load8(p, off + 3) * 16777216;
    return v;
}

fn st32(p: ptr, off: u32, v: u32) -> u32 {
    store8(p, off, (v % 256) as u8);
    store8(p, off + 1, ((v / 256) % 256) as u8);
    store8(p, off + 2, ((v / 65536) % 256) as u8);
    store8(p, off + 3, ((v / 16777216) % 256) as u8);
    return 0;
}

// ---------------------------------------------------------------- 字符类

fn is_w(c: u32) -> u32 {
    if c == 95 {
        return 1;
    }
    if c >= 48 && c <= 57 {
        return 1;
    }
    if c >= 65 && c <= 90 {
        return 1;
    }
    if c >= 97 && c <= 122 {
        return 1;
    }
    return 0;
}

fn is_id0(c: u32) -> u32 {
    if c == 95 {
        return 1;
    }
    if c >= 65 && c <= 90 {
        return 1;
    }
    if c >= 97 && c <= 122 {
        return 1;
    }
    return 0;
}

fn is_d(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return 1;
    }
    return 0;
}

/// `\s`（含换行）。
fn is_sp(c: u32) -> u32 {
    if c == 32 || c == 9 || c == 10 || c == 13 {
        return 1;
    }
    return 0;
}

/// `[ \t]`。
fn is_ht(c: u32) -> u32 {
    if c == 32 || c == 9 {
        return 1;
    }
    return 0;
}

fn skip_sp(p: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    while j < n && is_sp(load8(p, j)) == 1 {
        j = j + 1;
    }
    return j;
}

fn skip_ht(p: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    while j < n && is_ht(load8(p, j)) == 1 {
        j = j + 1;
    }
    return j;
}

/// `p[off..off+len(s))` 等于字面量 `s` 吗。
fn eq(p: ptr, off: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        if load8(p, off + i) != str_byte(s, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// `p[a..b)` 里有 c 吗。
fn has_ch(p: ptr, a: u32, b: u32, c: u32) -> u32 {
    let i: u32 = a;
    while i < b {
        if load8(p, i) == c {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn find_ch(p: ptr, a: u32, b: u32, c: u32) -> u32 {
    let i: u32 = a;
    while i < b {
        if load8(p, i) == c {
            return i;
        }
        i = i + 1;
    }
    return FAIL;
}

/// 子串（字面量）在 `p[a..b)` 里吗。
fn has_sub(p: ptr, a: u32, b: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    if n == 0 {
        return 0;
    }
    let i: u32 = a;
    while i + n <= b {
        if eq(p, i, s) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 把字面量写进 `dst`（补 NUL），返回长度。
fn put_lit(dst: ptr, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, str_byte(s, i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return n;
}

fn copy_n(dst: ptr, dof: u32, src: ptr, sof: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, dof + i, load8(src, sof + i) as u8);
        i = i + 1;
    }
    return n;
}

/// `^[A-Za-z_][A-Za-z0-9_]*$`
fn is_ident(p: ptr, off: u32, n: u32) -> u32 {
    if n == 0 || is_id0(load8(p, off)) == 0 {
        return 0;
    }
    let i: u32 = 1;
    while i < n {
        if is_w(load8(p, off + i)) == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// ---------------------------------------------------------------- 抹注释

/// `//…` / `/*…*/` 与行首的 `#…` 抹成**等长**空白（保留换行）。长度一字不变 ——
/// `body` 的下标要能直接回**原文**切正文（`functions[i].body` 是原文那一段）。
///
/// `hashp` = 1 才抹 `#` 指令：那是 C 的预处理，**Java 没有**（`_from_class_lang`
/// 只走 `_C_COMMENT` 那一条）。两门共用一个函数，但这一处不能共用。
fn blank_noise(src: ptr, n: u32, dst: ptr, hashp: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(src, i) as u8);
        i = i + 1;
    }
    // 行首 `#` 指令（`^[ \t]*#.*$`, re.M）
    if hashp == 1 {
        let ln: u32 = 0;
        let bol: u32 = 1;
        while ln < n {
            if bol == 1 {
                let j: u32 = skip_ht(src, ln, n);
                if j < n && load8(src, j) == 35 {
                    let k: u32 = j;
                    while k < n && load8(src, k) != 10 {
                        store8(dst, k, 32 as u8);
                        k = k + 1;
                    }
                    ln = k;
                } else {
                    bol = 0;
                }
            }
            if ln < n && load8(src, ln) == 10 {
                bol = 1;
            }
            ln = ln + 1;
        }
    }
    // `//…`（到行尾）与 `/*…*/`
    let i2: u32 = 0;
    while i2 < n {
        let c2: u32 = load8(src, i2);
        if c2 == 47 && i2 + 1 < n && load8(src, i2 + 1) == 47 {
            let k2: u32 = i2;
            while k2 < n && load8(src, k2) != 10 {
                store8(dst, k2, 32 as u8);
                k2 = k2 + 1;
            }
            i2 = k2;
        } else if c2 == 47 && i2 + 1 < n && load8(src, i2 + 1) == 42 {
            let k3: u32 = i2 + 2;
            let done: u32 = 0;
            while k3 < n && done == 0 {
                if load8(src, k3) == 42 && k3 + 1 < n && load8(src, k3 + 1) == 47 {
                    done = 1;
                } else {
                    k3 = k3 + 1;
                }
            }
            let e: u32 = n;
            if done == 1 {
                e = k3 + 2;
            }
            let m: u32 = i2;
            while m < e {
                if load8(src, m) != 10 {
                    store8(dst, m, 32 as u8);
                }
                m = m + 1;
            }
            i2 = e;
        } else {
            i2 = i2 + 1;
        }
    }
    return 0;
}

// ---------------------------------------------------------------- 扫描器
// 三条都往结果格 `r` 里写: R_NO/R_NL 名字, R_IS/R_IE 内容(或参数), R_MS/R_ME 整段,
// R_BR 尾部是不是 `{`, R_RO/R_RL 返回类型（只有 find_fn）。

/// `\bstruct\s+([A-Za-z_]\w*)\s*\{([^}]*)\}`（re.S），从 `from` 起找第一条。
fn find_struct(body: ptr, n: u32, from: u32, r: ptr) -> u32 {
    let i: u32 = from;
    while i + 7 < n {
        if load8(body, i) == 115 && eq(body, i, "struct") == 1 {
            let pre: u32 = 1;
            if i > 0 && is_w(load8(body, i - 1)) == 1 {
                pre = 0;
            }
            let post: u32 = 1;
            if is_w(load8(body, i + 6)) == 1 {
                post = 0;
            }
            if pre == 1 && post == 1 {
                let j: u32 = i + 6;
                let k: u32 = skip_sp(body, j, n);
                if k > j && k < n && is_id0(load8(body, k)) == 1 {
                    let e: u32 = k;
                    while e < n && is_w(load8(body, e)) == 1 {
                        e = e + 1;
                    }
                    let b: u32 = skip_sp(body, e, n);
                    if b < n && load8(body, b) == 123 {
                        let z: u32 = find_ch(body, b + 1, n, 125);
                        if z != FAIL {
                            let _a: u32 = st32(r, R_NO, k);
                            let _b: u32 = st32(r, R_NL, e - k);
                            let _c: u32 = st32(r, R_IS, b + 1);
                            let _d: u32 = st32(r, R_IE, z);
                            let _f: u32 = st32(r, R_MS, i);
                            let _g: u32 = st32(r, R_ME, z + 1);
                            return 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `\benum\s+([A-Za-z_]\w*)\s*\{([^}]*)\}` —— 形状与 `find_struct` 同。
fn find_enum(body: ptr, n: u32, from: u32, r: ptr) -> u32 {
    let i: u32 = from;
    while i + 5 < n {
        if load8(body, i) == 101 && eq(body, i, "enum") == 1 {
            let pre: u32 = 1;
            if i > 0 && is_w(load8(body, i - 1)) == 1 {
                pre = 0;
            }
            let post: u32 = 1;
            if is_w(load8(body, i + 4)) == 1 {
                post = 0;
            }
            if pre == 1 && post == 1 {
                let j: u32 = i + 4;
                let k: u32 = skip_sp(body, j, n);
                if k > j && k < n && is_id0(load8(body, k)) == 1 {
                    let e: u32 = k;
                    while e < n && is_w(load8(body, e)) == 1 {
                        e = e + 1;
                    }
                    let b: u32 = skip_sp(body, e, n);
                    if b < n && load8(body, b) == 123 {
                        let z: u32 = find_ch(body, b + 1, n, 125);
                        if z != FAIL {
                            let _a: u32 = st32(r, R_NO, k);
                            let _b: u32 = st32(r, R_NL, e - k);
                            let _c: u32 = st32(r, R_IS, b + 1);
                            let _d: u32 = st32(r, R_IE, z);
                            let _f: u32 = st32(r, R_MS, i);
                            let _g: u32 = st32(r, R_ME, z + 1);
                            return 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `^[ \t]*(?:static\s+|inline\s+|const\s+)*([A-Za-z_][\w \t\*]*?)\s+([A-Za-z_]\w*)
///  \s*\(([^;{)]*)\)\s*[;{]`（re.M）。两处惰性量词这样落:
///   * `group1` 短、`\s+` 紧跟 ⇒ **掐掉尾部空白后，最后一个标识符就是名字**;
///   * `\s*` 在 `[;{]` 之前 ⇒ `)` 之后可以跨**换行**。
fn find_fn(body: ptr, n: u32, from: u32, r: ptr) -> u32 {
    let i: u32 = from;
    while i < n {
        if i > 0 && load8(body, i - 1) != 10 {
            i = i + 1;
        } else {
            let t1: u32 = skip_ht(body, i, n);
            // 修饰词 `(static\s+|inline\s+|const\s+)*`
            let m: u32 = t1;
            let going: u32 = 1;
            while going == 1 {
                if eq(body, m, "static") == 1 && m + 6 < n && is_sp(load8(body, m + 6)) == 1 {
                    m = skip_sp(body, m + 6, n);
                } else if eq(body, m, "inline") == 1 && m + 6 < n
                        && is_sp(load8(body, m + 6)) == 1 {
                    m = skip_sp(body, m + 6, n);
                } else if eq(body, m, "const") == 1 && m + 5 < n
                        && is_sp(load8(body, m + 5)) == 1 {
                    m = skip_sp(body, m + 5, n);
                } else {
                    going = 0;
                }
            }
            // `[\w \t\*]+` 吃到 `(`
            let k: u32 = m;
            while k < n && (is_w(load8(body, k)) == 1 || load8(body, k) == 32
                            || load8(body, k) == 9 || load8(body, k) == 42) {
                k = k + 1;
            }
            if k < n && load8(body, k) == 40 && k > m {
                let e: u32 = k;
                while e > m && (load8(body, e - 1) == 32 || load8(body, e - 1) == 9) {
                    e = e - 1;
                }
                let ns: u32 = e;
                while ns > m && is_w(load8(body, ns - 1)) == 1 {
                    ns = ns - 1;
                }
                if ns > m && ns < e && is_id0(load8(body, ns)) == 1 {
                    let g1: u32 = ns;
                    while g1 > m && (load8(body, g1 - 1) == 32 || load8(body, g1 - 1) == 9) {
                        g1 = g1 - 1;
                    }
                    if g1 > m && is_id0(load8(body, m)) == 1 && g1 < ns {
                        let q: u32 = k + 1;
                        let bad: u32 = 0;
                        while q < n && load8(body, q) != 41 {
                            let cc: u32 = load8(body, q);
                            if cc == 59 || cc == 123 {
                                bad = 1;
                            }
                            q = q + 1;
                        }
                        if bad == 0 && q < n && load8(body, q) == 41 {
                            let z: u32 = skip_sp(body, q + 1, n);
                            if z < n && (load8(body, z) == 59 || load8(body, z) == 123) {
                                let br: u32 = 0;
                                if load8(body, z) == 123 {
                                    br = 1;
                                }
                                let _a: u32 = st32(r, R_RO, m);
                                let _b: u32 = st32(r, R_RL, g1 - m);
                                let _c: u32 = st32(r, R_NO, ns);
                                let _d: u32 = st32(r, R_NL, e - ns);
                                let _f: u32 = st32(r, R_IS, k + 1);
                                let _g: u32 = st32(r, R_IE, q);
                                let _h: u32 = st32(r, R_MS, i);
                                let _j: u32 = st32(r, R_ME, z + 1);
                                let _l: u32 = st32(r, R_BR, br);
                                return 1;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
    return 0;
}

// ---------------------------------------------------------------- 类型映射

/// C 系的类型表。**命中就把结果写进 `M_TYPE` 并返回长度；命中但这一门不映返回 `FAIL`；
/// 没命中返回 0。**（哨兵不能用 `2` —— `i8`/`u8` 的长度**就是 2**。）
fn table(d: ptr, s: u32, m: u32, mode: u32) -> u32 {
    if m == 7 && eq(d, s, "uint8_t") == 1 {
        return put_lit(d, "u8");
    }
    if m == 8 && eq(d, s, "uint16_t") == 1 {
        return put_lit(d, "u16");
    }
    if m == 8 && eq(d, s, "uint32_t") == 1 {
        return put_lit(d, "u32");
    }
    if m == 8 && eq(d, s, "uint64_t") == 1 {
        return put_lit(d, "u64");
    }
    if m == 6 && eq(d, s, "int8_t") == 1 {
        return put_lit(d, "i8");
    }
    if m == 7 && eq(d, s, "int16_t") == 1 {
        return put_lit(d, "i16");
    }
    if m == 7 && eq(d, s, "int32_t") == 1 {
        return put_lit(d, "i32");
    }
    if m == 7 && eq(d, s, "int64_t") == 1 {
        return put_lit(d, "i64");
    }
    if m == 13 && eq(d, s, "unsigned char") == 1 {
        return put_lit(d, "u8");
    }
    if m == 14 && eq(d, s, "unsigned short") == 1 {
        return put_lit(d, "u16");
    }
    if m == 12 && eq(d, s, "unsigned int") == 1 {
        return put_lit(d, "u32");
    }
    if m == 13 && eq(d, s, "unsigned long") == 1 {
        return put_lit(d, "u64");
    }
    if m == 11 && eq(d, s, "signed char") == 1 {
        return put_lit(d, "i8");
    }
    if m == 5 && eq(d, s, "short") == 1 {
        return put_lit(d, "i16");
    }
    if m == 3 && eq(d, s, "int") == 1 {
        return put_lit(d, "i32");
    }
    if m == 8 && eq(d, s, "unsigned") == 1 {
        return put_lit(d, "u32");
    }
    if m == 6 && eq(d, s, "signed") == 1 {
        return put_lit(d, "i32");
    }
    if m == 4 && eq(d, s, "char") == 1 {
        if mode == 2 {
            return FAIL;              // C++: 符号性实现定义 —— 不猜
        }
        return put_lit(d, "i8");
    }
    if m == 4 && eq(d, s, "long") == 1 {
        return put_lit(d, "i64");
    }
    if mode == 2 && m == 9 && eq(d, s, "long long") == 1 {
        return put_lit(d, "i64");
    }
    if mode == 2 && m == 18 && eq(d, s, "unsigned long long") == 1 {
        return put_lit(d, "u64");
    }
    if m == 6 && eq(d, s, "size_t") == 1 {
        return put_lit(d, "u64");
    }
    if m == 7 && eq(d, s, "ssize_t") == 1 {
        return put_lit(d, "i64");
    }
    if m == 4 && eq(d, s, "bool") == 1 {
        return put_lit(d, "bool");
    }
    if m == 5 && eq(d, s, "_Bool") == 1 {
        return put_lit(d, "bool");
    }
    if m == 4 && eq(d, s, "void") == 1 {
        return put_lit(d, "()");
    }
    if m == 6 && eq(d, s, "char *") == 1 {
        if mode == 2 {
            return FAIL;
        }
        return put_lit(d, "str");
    }
    if m == 12 && eq(d, s, "const char *") == 1 {
        if mode == 2 {
            return FAIL;
        }
        return put_lit(d, "str");
    }
    if m == 6 && eq(d, s, "void *") == 1 {
        return put_lit(d, "ptr");
    }
    if m == 9 && eq(d, s, "uintptr_t") == 1 {
        return put_lit(d, "u64");
    }
    if m == 8 && eq(d, s, "intptr_t") == 1 {
        return put_lit(d, "i64");
    }
    if m == 2 && eq(d, s, "u8") == 1 {
        return m;
    }
    if m == 3 && eq(d, s, "u16") == 1 {
        return m;
    }
    if m == 3 && eq(d, s, "u32") == 1 {
        return m;
    }
    if m == 3 && eq(d, s, "u64") == 1 {
        return m;
    }
    if m == 2 && eq(d, s, "i8") == 1 {
        return m;
    }
    if m == 3 && eq(d, s, "i16") == 1 {
        return m;
    }
    if m == 3 && eq(d, s, "i32") == 1 {
        return m;
    }
    if m == 3 && eq(d, s, "i64") == 1 {
        return m;
    }
    return 0;
}

fn known_reset(mem: ptr) -> u32 {
    return st32(ptr_add(mem, M_NAMES), 0, 0);
}

fn known_add(mem: ptr, p: ptr, l: u32) -> u32 {
    let b: ptr = ptr_add(mem, M_NAMES);
    let n: u32 = ld32(b, 0);
    if n >= NMAX {
        return 1;                 // 表满: 报出去, 不静默丢
    }
    let _a: u32 = st32(b, 4 + n * NW, l);
    let i: u32 = 0;
    while i < l {
        store8(b, 4 + n * NW + 4 + i, load8(p, i) as u8);
        i = i + 1;
    }
    let _b: u32 = st32(b, 0, n + 1);
    return 0;
}

fn known_find(mem: ptr, p: ptr, off: u32, l: u32) -> u32 {
    let b: ptr = ptr_add(mem, M_NAMES);
    let n: u32 = ld32(b, 0);
    let k: u32 = 0;
    while k < n {
        if ld32(b, 4 + k * NW) == l {
            let i: u32 = 0;
            let same: u32 = 1;
            while i < l {
                if load8(b, 4 + k * NW + 4 + i) != load8(p, off + i) {
                    same = 0;
                }
                i = i + 1;
            }
            if same == 1 {
                return 1;
            }
        }
        k = k + 1;
    }
    return 0;
}

/// `_c_type`: 归一化空白 -> 剥前置限定词 -> `[]`->` *` -> `enum X`->`i32` -> 查表 ->
/// `T *` -> 已声明的 struct 名。命中写进 `M_TYPE` 返回长度; 无映射返回 0。
fn ctype(mem: ptr, tp: ptr, tl: u32) -> u32 {
    let d: ptr = ptr_add(mem, M_TYPE);
    let a: u32 = 0;
    let b: u32 = tl;
    while a < b && is_sp(load8(tp, a)) == 1 {
        a = a + 1;
    }
    while b > a && is_sp(load8(tp, b - 1)) == 1 {
        b = b - 1;
    }
    let o: u32 = 0;
    let sp: u32 = 0;
    let i: u32 = a;
    while i < b {
        let c: u32 = load8(tp, i);
        if is_sp(c) == 1 {
            sp = 1;
        } else {
            if sp == 1 && o > 0 {
                store8(d, o, 32 as u8);
                o = o + 1;
            }
            sp = 0;
            store8(d, o, c as u8);
            o = o + 1;
        }
        i = i + 1;
    }
    store8(d, o, 0 as u8);
    // 剥前置限定词（可反复）
    let s: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        going = 0;
        if o - s > 6 && eq(d, s, "const ") == 1 {
            s = s + 6;
            going = 1;
        } else if o - s > 9 && eq(d, s, "volatile ") == 1 {
            s = s + 9;
            going = 1;
        } else if o - s > 7 && eq(d, s, "static ") == 1 {
            s = s + 7;
            going = 1;
        } else if o - s > 9 && eq(d, s, "register ") == 1 {
            s = s + 9;
            going = 1;
        }
    }
    let m: u32 = o - s;
    if m >= 2 && load8(d, s + m - 2) == 91 && load8(d, s + m - 1) == 93 {
        store8(d, s + m - 2, 32 as u8);
        store8(d, s + m - 1, 42 as u8);
    }
    if m > 5 && eq(d, s, "enum ") == 1 {
        return put_lit(d, "i32");
    }
    let mode: u32 = ld32(ptr_add(mem, M_SC), 8);
    let r: u32 = table(d, s, m, mode);
    if r == FAIL {
        return 0;                     // 命中但**这一门不映**（C++ 的 `char` 那三个）
    }
    if r > 0 {
        return r;
    }
    if m >= 1 && load8(d, s + m - 1) == 42 {
        let base: ptr = ptr_add(d, s);
        let bl: u32 = m - 1;
        let bb: u32 = bl;
        while bb > 0 && is_sp(load8(base, bb - 1)) == 1 {
            bb = bb - 1;
        }
        if bb == 4 && eq(base, 0, "char") == 1 {
            return put_lit(d, "str");
        }
        return put_lit(d, "ptr");
    }
    if known_find(mem, d, s, m) == 1 {
        let k: u32 = 0;
        while k < m {
            store8(d, k, load8(d, s + k) as u8);
            k = k + 1;
        }
        store8(d, m, 0 as u8);
        return m;
    }
    return 0;
}

/// `_ident`: 非 `[A-Za-z0-9_]` 换 `_`; 首字符不合法就前置 `_`; 过不了 IDENT_RE 用 `fb`。
/// 写进 `M_IDENT`，返回长度。
fn ident_of(mem: ptr, p: ptr, off: u32, ln: u32, fb: str) -> u32 {
    let d: ptr = ptr_add(mem, M_IDENT);
    let o: u32 = 0;
    let i: u32 = 0;
    while i < ln && o < 500 {
        let c: u32 = load8(p, off + i);
        if is_w(c) == 1 {
            store8(d, o, c as u8);
        } else {
            store8(d, o, 95 as u8);
        }
        o = o + 1;
        i = i + 1;
    }
    if o == 0 || is_id0(load8(d, 0)) == 0 {
        let k: u32 = o;
        while k > 0 {
            store8(d, k, load8(d, k - 1) as u8);
            k = k - 1;
        }
        store8(d, 0, 95 as u8);
        o = o + 1;
    }
    if is_ident(d, 0, o) == 0 {
        return put_lit(d, fb);
    }
    return o;
}

// ---------------------------------------------------------------- JSON 发射

fn jl(out: ptr, o: u32, s: str) -> u32 {
    return json_emit_lit(out, o, s);
}

fn jq(out: ptr, o: u32, p: ptr, off: u32, n: u32) -> u32 {
    return json_emit_str(out, o, ptr_add(p, off), n);
}

/// 原样拷进输出（已经在一个 JSON 串里时用；类型名与数字里不会有要转义的字符）。
fn jraw(out: ptr, o: u32, p: ptr, off: u32, n: u32) -> u32 {
    let _c: u32 = copy_n(out, o, p, off, n);
    return o + n;
}

/// 带符号的整数（`consts[].value` 可以是负的）。
fn jint(out: ptr, o: u32, neg: u32, v: u32) -> u32 {
    if neg == 1 {
        store8(out, o, 45 as u8);
        o = o + 1;
    }
    return json_emit_u32(out, o, v);
}

/// `{` 配对（`_block_end`）。注意调用方已经先把注释字符串抹掉了。
fn block_end(p: ptr, open: u32, n: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = open;
    while i < n {
        let c: u32 = load8(p, i);
        if c == 123 {
            d = d + 1;
        } else if c == 125 {
            d = d - 1;
            if d == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return FAIL;
}

/// `off` 落在第几行（1 起）—— `body_line` 那一步，数的是**原文**里的换行。
fn line_of(p: ptr, off: u32) -> u32 {
    let c: u32 = 1;
    let i: u32 = 0;
    while i < off {
        if load8(p, i) == 10 {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// `p[0, n)` 里有几个**字符**（UTF-8 续接字节不算一个字符）。
/// 上游拿的是 Python 字符串的**字符**下标，而这里的缓冲是**字节** ——
/// 文件里有中文（`jtrans/*.java` 的注释就是）时两者差着"每个多字节字符多出来的字节"。
fn chars_n(p: ptr, n: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    while i < n {
        if (load8(p, i) & 192) != 128 {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// `src.count("\n", 0, off) + 1`，`off` 是**字符**下标（`_body_line` 的口径）。
fn line_at_chars(p: ptr, n: u32, off: u32) -> u32 {
    let c: u32 = 1;
    let sc: u32 = 0;
    let i: u32 = 0;
    while i < n && sc < off {
        let b: u32 = load8(p, i);
        if b == 10 {
            c = c + 1;
        }
        if (b & 192) != 128 {
            sc = sc + 1;
        }
        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------- 字段扫描

fn fld_no(i: u32) -> u32 {
    return M_FLD + i * FW;
}

/// `_C_FIELD = ([^;{}]+?)\s+([A-Za-z_]\w*)\s*(\[\s*\d+\s*\])?\s*;` 的 finditer。
/// 命中的字段记进 `M_FLD`（名字 + **原始**类型文本），返回条数。
fn scan_fields(mem: ptr, a: u32, b: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let cnt: u32 = 0;
    let i: u32 = a;
    while i < b {
        // 从 i 起找 `;`（`{` `}` 在字符类之外 —— 撞上就是这一位起不可能匹配）
        let semi: u32 = FAIL;
        let blk: u32 = 0;
        let k: u32 = i;
        while k < b && semi == FAIL && blk == 0 {
            let c: u32 = load8(body, k);
            if c == 123 || c == 125 {
                blk = 1;
            } else if c == 59 {
                semi = k;
            }
            k = k + 1;
        }
        if semi == FAIL {
            i = i + 1;
        } else {
            // [i, semi) 里切出 名字 + 类型
            let e: u32 = semi;
            while e > i && is_sp(load8(body, e - 1)) == 1 {
                e = e - 1;
            }
            // 可选的 `[ N ]`
            let arr: u32 = 0;
            let arrl: u32 = 0;
            if e > i && load8(body, e - 1) == 93 {
                let lb: u32 = find_ch(body, i, e - 1, 91);
                if lb != FAIL {
                    let ok: u32 = 1;
                    let t: u32 = lb + 1;
                    let digits: u32 = 0;
                    while t < e - 1 {
                        let c: u32 = load8(body, t);
                        if is_sp(c) == 1 {
                            t = t + 1;
                        } else if is_d(c) == 1 {
                            digits = digits + 1;
                            t = t + 1;
                        } else {
                            ok = 0;
                            t = t + 1;
                        }
                    }
                    if ok == 1 && digits > 0 {
                        arr = lb + 1;
                        arrl = (e - 1) - (lb + 1);
                        e = lb;
                        while e > i && is_sp(load8(body, e - 1)) == 1 {
                            e = e - 1;
                        }
                    }
                }
            }
            // 名字 = 尾部那段标识符
            let ns: u32 = e;
            while ns > i && is_w(load8(body, ns - 1)) == 1 {
                ns = ns - 1;
            }
            let okn: u32 = 0;
            if ns < e && is_id0(load8(body, ns)) == 1 {
                okn = 1;
            }
            if okn == 0 {
                i = semi + 1;
            } else {
                // group1
                let te: u32 = ns;
                while te > i && is_sp(load8(body, te - 1)) == 1 {
                    te = te - 1;
                }
                let nw: u32 = e - ns;
                // 名字是保留字的那几条不算字段
                let skipw: u32 = 0;
                if (nw == 2 && eq(body, ns, "if") == 1) || (nw == 5 && eq(body, ns, "while") == 1)
                        || (nw == 3 && eq(body, ns, "for") == 1)
                        || (nw == 6 && eq(body, ns, "return") == 1) {
                    skipw = 1;
                }
                if skipw == 0 && te > i && cnt < FMAX {
                    let _a: u32 = st32(ptr_add(mem, M_FLD), cnt * FW, ns);
                    let _b: u32 = st32(ptr_add(mem, M_FLD), cnt * FW + 4, nw);
                    let _c: u32 = st32(ptr_add(mem, M_FLD), cnt * FW + 8, i);
                    let _d: u32 = st32(ptr_add(mem, M_FLD), cnt * FW + 12, te - i);
                    let _e: u32 = st32(ptr_add(mem, M_FLD), cnt * FW + 16, arr);
                    let _f: u32 = st32(ptr_add(mem, M_FLD), cnt * FW + 20, arrl);
                    cnt = cnt + 1;
                }
                i = semi + 1;
            }
        }
    }
    return cnt;
}

// ---------------------------------------------------------------- 函数扫描与发射

// ---------------------------------------------------------------- 参数切分

/// 参数/字段里**最后一个 token**（名字）。起点写进 `outp`，返回长度。
fn last_tok(p: ptr, a: u32, b: u32, outp: ptr) -> u32 {
    let k: u32 = a;
    let ts: u32 = 0;
    let tl: u32 = 0;
    while k < b {
        let c: u32 = load8(p, k);
        if is_sp(c) == 1 {
            k = k + 1;
        } else if c == 42 {
            ts = k;
            tl = 1;
            k = k + 1;
        } else {
            let s0: u32 = k;
            while k < b && is_sp(load8(p, k)) == 0 && load8(p, k) != 42 {
                k = k + 1;
            }
            ts = s0;
            tl = k - s0;
        }
    }
    let _a: u32 = st32(outp, 0, ts);
    return tl;
}

/// 名字之前那些 token 用**单个空格**连起来（`" ".join(parts[:-1])`，`*` 自成一 token）。
/// 结果写进 `dst`，返回长度。
fn type_text(p: ptr, a: u32, b: u32, dst: ptr) -> u32 {
    let k: u32 = a;
    let o: u32 = 0;
    let cnt: u32 = 0;
    while k < b && o < 400 {
        let c: u32 = load8(p, k);
        if is_sp(c) == 1 {
            k = k + 1;
        } else if c == 42 {
            if cnt > 0 {
                store8(dst, o, 32 as u8);
                o = o + 1;
            }
            store8(dst, o, 42 as u8);
            o = o + 1;
            cnt = cnt + 1;
            k = k + 1;
        } else {
            let s0: u32 = k;
            while k < b && is_sp(load8(p, k)) == 0 && load8(p, k) != 42 {
                k = k + 1;
            }
            if cnt > 0 {
                store8(dst, o, 32 as u8);
                o = o + 1;
            }
            let q: u32 = s0;
            while q < k {
                store8(dst, o, load8(p, q) as u8);
                o = o + 1;
                q = q + 1;
            }
            cnt = cnt + 1;
        }
    }
    // 掐掉**最后一个 token**（连同它前面那个空格）
    let cut: u32 = o;
    while cut > 0 && load8(dst, cut - 1) != 32 {
        cut = cut - 1;
    }
    if cut > 0 {
        cut = cut - 1;
    }
    return cut;
}

/// `f[j]` 那段参数是不是坏的（`_C_FUNCTION` 那一步的跳过条件）。
/// 返回 1 = 好，0 = 这条函数要跳过。
fn params_ok(mem: ptr, a: u32, b: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let p: u32 = a;
    while p <= b {
        let seg: u32 = find_ch(body, p, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = p;
        while s2 < se && is_sp(load8(body, s2)) == 1 {
            s2 = s2 + 1;
        }
        let e2: u32 = se;
        while e2 > s2 && is_sp(load8(body, e2 - 1)) == 1 {
            e2 = e2 - 1;
        }
        if e2 > s2 {
            let isv: u32 = 0;
            if e2 - s2 == 4 && eq(body, s2, "void") == 1 {
                isv = 1;
            }
            if isv == 0 {
                let sp0: ptr = ptr_add(mem, M_R + 40);
                let nln: u32 = last_tok(body, s2, e2, sp0);
                let tbuf: ptr = ptr_add(mem, M_TXT);
                let to: u32 = type_text(body, s2, e2, tbuf);
                if nln == 0 || to == 0 {
                    return 0;
                }
                if ctype(mem, tbuf, to) == 0 {
                    return 0;
                }
            }
        }
        if seg == FAIL {
            p = b + 1;
        } else {
            p = seg + 1;
        }
    }
    return 1;
}

/// 逐条参数发 `{"name": .., "type": ..}`。调用方已确认过都合法。
fn emit_params(mem: ptr, out: ptr, o: u32, a: u32, b: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let first: u32 = 1;
    let p: u32 = a;
    while p <= b {
        let seg: u32 = find_ch(body, p, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = p;
        while s2 < se && is_sp(load8(body, s2)) == 1 {
            s2 = s2 + 1;
        }
        let e2: u32 = se;
        while e2 > s2 && is_sp(load8(body, e2 - 1)) == 1 {
            e2 = e2 - 1;
        }
        if e2 > s2 {
            let isv: u32 = 0;
            if e2 - s2 == 4 && eq(body, s2, "void") == 1 {
                isv = 1;
            }
            if isv == 0 {
                let sp0: ptr = ptr_add(mem, M_R + 40);
                let nln: u32 = last_tok(body, s2, e2, sp0);
                let nsp: u32 = ld32(sp0, 0);
                let tbuf: ptr = ptr_add(mem, M_TXT);
                let to: u32 = type_text(body, s2, e2, tbuf);
                let nl: u32 = ident_of(mem, body, nsp, nln, "ax");
                let idb: ptr = ptr_add(mem, M_IDENT);
                let _sv: u32 = copy_n(ptr_add(mem, M_TXT2), 0, idb, 0, nl);
                if first == 0 {
                    o = jl(out, o, ", ");
                }
                first = 0;
                o = jl(out, o, "{\"name\": ");
                o = jq(out, o, ptr_add(mem, M_TXT2), 0, nl);
                o = jl(out, o, ", \"type\": ");
                let tl: u32 = ctype(mem, tbuf, to);
                o = jq(out, o, ptr_add(mem, M_TYPE), 0, tl);
                o = jl(out, o, "}");
            }
        }
        if seg == FAIL {
            p = b + 1;
        } else {
            p = seg + 1;
        }
    }
    return o;
}

/// 一条函数能不能收（收的条件全在这儿判，**发之前**判完）。
fn fn_ok(mem: ptr, r: ptr) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let no: u32 = ld32(r, R_NO);
    let nl: u32 = ld32(r, R_NL);
    if (nl == 2 && eq(body, no, "if") == 1) || (nl == 5 && eq(body, no, "while") == 1)
            || (nl == 3 && eq(body, no, "for") == 1)
            || (nl == 6 && eq(body, no, "switch") == 1)
            || (nl == 6 && eq(body, no, "return") == 1)
            || (nl == 6 && eq(body, no, "sizeof") == 1)
            || (nl == 2 && eq(body, no, "do") == 1) || (nl == 4 && eq(body, no, "else") == 1) {
        return 0;
    }
    // 返回类型的**最后一个 token** 不能是关键字
    let ro: u32 = ld32(r, R_RO);
    let rl: u32 = ld32(r, R_RL);
    let ls: u32 = ro + rl;
    while ls > ro && is_sp(load8(body, ls - 1)) == 1 {
        ls = ls - 1;
    }
    let ws: u32 = ls;
    while ws > ro && is_sp(load8(body, ws - 1)) == 0 {
        ws = ws - 1;
    }
    let wl: u32 = ls - ws;
    if (wl == 2 && eq(body, ws, "if") == 1) || (wl == 5 && eq(body, ws, "while") == 1)
            || (wl == 3 && eq(body, ws, "for") == 1)
            || (wl == 6 && eq(body, ws, "switch") == 1)
            || (wl == 6 && eq(body, ws, "return") == 1)
            || (wl == 6 && eq(body, ws, "sizeof") == 1)
            || (wl == 2 && eq(body, ws, "do") == 1) || (wl == 4 && eq(body, ws, "else") == 1) {
        return 0;
    }
    if ctype(mem, ptr_add(body, ro), rl) == 0 {
        return 0;
    }
    let is: u32 = ld32(r, R_IS);
    let ie: u32 = ld32(r, R_IE);
    if has_sub(body, is, ie, "...") == 1 {
        return 0;
    }
    if params_ok(mem, is, ie) == 0 {
        return 0;
    }
    if ld32(r, R_BR) == 1 {
        if block_end(body, ld32(r, R_ME) - 1, ld32(ptr_add(mem, M_SC), 0)) == FAIL {
            return 0;
        }
    }
    return 1;
}

fn emit_one_fn(mem: ptr, out: ptr, o: u32, r: ptr) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let src: ptr = ptr_add(mem, M_SRC);
    o = jl(out, o, "{\"name\": ");
    o = jq(out, o, body, ld32(r, R_NO), ld32(r, R_NL));
    o = jl(out, o, ", \"params\": [");
    o = emit_params(mem, out, o, ld32(r, R_IS), ld32(r, R_IE));
    o = jl(out, o, "], \"ret\": ");
    let rl: u32 = ctype(mem, ptr_add(body, ld32(r, R_RO)), ld32(r, R_RL));
    o = jq(out, o, ptr_add(mem, M_TYPE), 0, rl);
    if ld32(r, R_BR) == 1 {
        let close: u32 = block_end(body, ld32(r, R_ME) - 1, ld32(ptr_add(mem, M_SC), 0));
        let ms: u32 = ld32(r, R_MS);
        // 正文要回**原文**切（`body` 是等长抹过的，下标通用）
        let bl: u32 = close + 1 - ms;
        let lead: u32 = 0;
        let k: u32 = 0;
        while k < bl && is_sp(load8(src, ms + k)) == 1 {
            lead = lead + 1;
            k = k + 1;
        }
        let tl: u32 = bl - lead;
        let te: u32 = bl;
        while te > lead && is_sp(load8(src, ms + te - 1)) == 1 {
            te = te - 1;
        }
        let fin: u32 = te - lead;
        o = jl(out, o, ", \"body\": ");
        o = jq(out, o, src, ms + lead, fin);
        o = jl(out, o, ", \"body_line\": ");
        // 数的是**原文**里的换行，下标却是 Python 的**字符**口径（`_body_at`）。
        // `body` 与 `src` 等长（抹注释不长度），所以同一个字节下标两边通用。
        o = jint(out, o, 0, line_at_chars(src, ld32(ptr_add(mem, M_SC), 0),
                                          chars_n(src, ms) + lead));
    }
    o = jl(out, o, "}");
    return o;
}

/// `body` 的长度在 `M_R + 4500`（`build` 里先放一次）。
fn emit_functions(mem: ptr, out: ptr, o: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let r: ptr = ptr_add(mem, M_R);
    let i: u32 = 0;
    let first: u32 = 1;
    while find_fn(body, n, i, r) == 1 {
        i = ld32(r, R_ME);
        if fn_ok(mem, r) == 1 {
            if first == 0 {
                o = jl(out, o, ", ");
            }
            first = 0;
            // `jint` 返回的是新 offset，上面那一处要接住
            let _save: u32 = st32(ptr_add(mem, M_R), R_TMP + 4, o);
            o = emit_one_fn(mem, out, o, r);
        }
    }
    return o;
}

// ---------------------------------------------------------------- 常量与枚举

/// `enum` 的成员表填进 `M_MEMB`，返回条数。
fn enum_members(mem: ptr, a: u32, b: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let cnt: u32 = 0;
    let nv: u32 = 0;
    let p: u32 = a;
    while p <= b {
        let seg: u32 = find_ch(body, p, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = p;
        while s2 < se && is_sp(load8(body, s2)) == 1 {
            s2 = s2 + 1;
        }
        let e2: u32 = se;
        while e2 > s2 && is_sp(load8(body, e2 - 1)) == 1 {
            e2 = e2 - 1;
        }
        if e2 > s2 {
            let eqp: u32 = find_ch(body, s2, e2, 61);
            let ok: u32 = 1;
            let ns: u32 = s2;
            let ne: u32 = e2;
            if eqp != FAIL {
                ns = s2;
                ne = eqp;
                while ne > ns && is_sp(load8(body, ne - 1)) == 1 {
                    ne = ne - 1;
                }
                // 值必须是 `-?\d+`
                let vs: u32 = eqp + 1;
                while vs < e2 && is_sp(load8(body, vs)) == 1 {
                    vs = vs + 1;
                }
                let neg: u32 = 0;
                if vs < e2 && load8(body, vs) == 45 {
                    neg = 1;
                    vs = vs + 1;
                }
                let v: u32 = 0;
                let dg: u32 = 0;
                let t: u32 = vs;
                while t < e2 {
                    let c: u32 = load8(body, t);
                    if is_d(c) == 1 {
                        v = v * 10 + (c - 48);
                        dg = dg + 1;
                    } else {
                        ok = 0;
                    }
                    t = t + 1;
                }
                if dg == 0 {
                    ok = 0;
                }
                if ok == 1 {
                    // **存两补**：`-1` 要发成 `-1`，而且下一个成员是 `0`（不是 `2`）
                    if neg == 1 {
                        nv = (0 as u32) - v;
                    } else {
                        nv = v;
                    }
                }
            }
            if is_ident(body, ns, ne - ns) == 0 {
                ok = 0;
            }
            if ok == 1 && cnt < MMAX {
                let _a: u32 = st32(ptr_add(mem, M_MEMB), cnt * MW, ns);
                let _b: u32 = st32(ptr_add(mem, M_MEMB), cnt * MW + 4, ne - ns);
                let _c: u32 = st32(ptr_add(mem, M_MEMB), cnt * MW + 8, nv);
                cnt = cnt + 1;
                nv = nv + 1;
            }
        }
        if seg == FAIL {
            p = b + 1;
        } else {
            p = seg + 1;
        }
    }
    return cnt;
}

/// 成员值是不是"正好等于下标"。
fn members_are_index(mem: ptr, cnt: u32) -> u32 {
    let i: u32 = 0;
    while i < cnt {
        if ld32(ptr_add(mem, M_MEMB), i * MW + 8) != i {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 这个名字在**已经发出去的 consts** 里吗（`vn in {c["name"] ...}`）。
fn const_seen(mem: ptr, p: ptr, off: u32, l: u32) -> u32 {
    let b: ptr = ptr_add(mem, M_CNST);
    let n: u32 = ld32(b, 0);
    let k: u32 = 0;
    while k < n {
        if ld32(b, 8 + k * NW) == l {
            let i: u32 = 0;
            let same: u32 = 1;
            while i < l {
                if load8(b, 8 + k * NW + 4 + i) != load8(p, off + i) {
                    same = 0;
                }
                i = i + 1;
            }
            if same == 1 {
                return 1;
            }
        }
        k = k + 1;
    }
    return 0;
}

fn const_mark(mem: ptr, p: ptr, off: u32, l: u32) -> u32 {
    let b: ptr = ptr_add(mem, M_CNST);
    let n: u32 = ld32(b, 0);
    if n >= 100 {
        return 1;
    }
    let _a: u32 = st32(b, 8 + n * NW, l);
    let i: u32 = 0;
    while i < l {
        store8(b, 8 + n * NW + 4 + i, load8(p, off + i) as u8);
        i = i + 1;
    }
    let _b: u32 = st32(b, 0, n + 1);
    return 0;
}

/// `which` = 0 发 `consts`，1 发 `enums`。
fn emit_enum_kind(mem: ptr, out: ptr, o: u32, which: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let r: ptr = ptr_add(mem, M_R);
    let i: u32 = 0;
    let first: u32 = 1;
    while find_enum(body, n, i, r) == 1 {
        i = ld32(r, R_ME);
        let cnt: u32 = enum_members(mem, ld32(r, R_IS), ld32(r, R_IE));
        if cnt > 0 {
            let is_idx: u32 = members_are_index(mem, cnt);
            if which == 1 && is_idx == 1 {
                if first == 0 {
                    o = jl(out, o, ", ");
                }
                first = 0;
                o = jl(out, o, "{\"name\": ");
                o = jq(out, o, body, ld32(r, R_NO), ld32(r, R_NL));
                o = jl(out, o, ", \"variants\": [");
                let k: u32 = 0;
                while k < cnt {
                    if k > 0 {
                        o = jl(out, o, ", ");
                    }
                    let b2: ptr = ptr_add(mem, M_MEMB);
                    o = jq(out, o, body, ld32(b2, k * MW), ld32(b2, k * MW + 4));
                    k = k + 1;
                }
                o = jl(out, o, "]}");
            } else if which == 0 && is_idx == 0 {
                let k2: u32 = 0;
                while k2 < cnt {
                    let b3: ptr = ptr_add(mem, M_MEMB);
                    let no: u32 = ld32(b3, k2 * MW);
                    let nl: u32 = ld32(b3, k2 * MW + 4);
                    if const_seen(mem, body, no, nl) == 0 {
                        if first == 0 {
                            o = jl(out, o, ", ");
                        }
                        first = 0;
                        o = jl(out, o, "{\"name\": ");
                        o = jq(out, o, body, no, nl);
                        o = jl(out, o, ", \"type\": \"i32\", \"value\": ");
                        let v: u32 = ld32(b3, k2 * MW + 8);
                        let neg: u32 = 0;
                        if v > 2147483647 {
                            neg = 1;
                            v = 4294967296 - v;
                        }
                        o = jint(out, o, neg, v);
                        o = jl(out, o, "}");
                        let _m: u32 = const_mark(mem, body, no, nl);
                    }
                    k2 = k2 + 1;
                }
            }
        }
    }
    return o;
}

// ---------------------------------------------------------------- struct -> types

/// 一个 struct 有几个字段能进对象（映射不上 / 保留字名的不算）。
fn count_added(mem: ptr, a: u32, b: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let cnt: u32 = scan_fields(mem, a, b);
    let got: u32 = 0;
    let k: u32 = 0;
    while k < cnt {
        let f: ptr = ptr_add(mem, M_FLD);
        let to: u32 = ld32(f, k * FW + 8);
        let tl: u32 = ld32(f, k * FW + 12);
        if ctype(mem, ptr_add(body, to), tl) > 0 {
            got = got + 1;
        }
        k = k + 1;
    }
    return got;
}

fn emit_types(mem: ptr, out: ptr, o: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let r: ptr = ptr_add(mem, M_R);
    let i: u32 = 0;
    let first: u32 = 1;
    while find_struct(body, n, i, r) == 1 {
        i = ld32(r, R_ME);
        let no: u32 = ld32(r, R_NO);
        let nl: u32 = ld32(r, R_NL);
        let cnt: u32 = scan_fields(mem, ld32(r, R_IS), ld32(r, R_IE));
        // 先数一遍"能进几个"，>0 才算这个 type（上行同）
        let got: u32 = 0;
        let k: u32 = 0;
        while k < cnt {
            let f: ptr = ptr_add(mem, M_FLD);
            if ctype(mem, ptr_add(body, ld32(f, k * FW + 8)), ld32(f, k * FW + 12)) > 0 {
                got = got + 1;
            }
            k = k + 1;
        }
        if got > 0 {
            let _kk: u32 = known_add(mem, ptr_add(body, no), nl);
            if first == 0 {
                o = jl(out, o, ", ");
            }
            first = 0;
            o = jl(out, o, "{\"name\": ");
            o = jq(out, o, body, no, nl);
            o = jl(out, o, ", \"fields\": [");
            let firstf: u32 = 1;
            let j: u32 = 0;
            while j < cnt {
                let f2: ptr = ptr_add(mem, M_FLD);
                let fno: u32 = ld32(f2, j * FW);
                let fnl: u32 = ld32(f2, j * FW + 4);
                let to: u32 = ld32(f2, j * FW + 8);
                let tl: u32 = ld32(f2, j * FW + 12);
                let mp: u32 = ctype(mem, ptr_add(body, to), tl);
                if mp > 0 {
                    if firstf == 0 {
                        o = jl(out, o, ", ");
                    }
                    firstf = 0;
                    o = jl(out, o, "{\"name\": ");
                    o = jq(out, o, body, fno, fnl);
                    o = jl(out, o, ", \"type\": ");
                    // `[T; N]`：映射结果外面再套一层
                    let aa: u32 = ld32(f2, j * FW + 16);
                    let al2: u32 = ld32(f2, j * FW + 20);
                    if aa > 0 {
                        o = jl(out, o, "\"[");
                        o = jraw(out, o, ptr_add(mem, M_TYPE), 0, mp);
                        o = jl(out, o, "; ");
                        let sa: u32 = aa;
                        while sa < aa + al2 && is_sp(load8(body, sa)) == 1 {
                            sa = sa + 1;
                        }
                        let sb: u32 = aa + al2;
                        while sb > sa && is_sp(load8(body, sb - 1)) == 1 {
                            sb = sb - 1;
                        }
                        o = jraw(out, o, body, sa, sb - sa);
                        o = jl(out, o, "]\"");
                    } else {
                        o = jq(out, o, ptr_add(mem, M_TYPE), 0, mp);
                    }
                    o = jl(out, o, "}");
                }
                j = j + 1;
            }
            o = jl(out, o, "]}");
        }
    }
    return o;
}

// ---------------------------------------------------------------- 单元名

/// `_ident(Path(name).stem)` —— argv 里的路径取 basename，再去掉最后一个后缀。
fn unit_name(mem: ptr, argp: ptr, al: u32) -> u32 {
    let base: u32 = 0;
    let i: u32 = 0;
    while i < al {
        if load8(argp, i) == 47 || load8(argp, i) == 92 {
            base = i + 1;
        }
        i = i + 1;
    }
    let stem: u32 = al - base;
    let d: u32 = 0;
    while d < stem {
        if load8(argp, base + d) == 46 {
            stem = d;
        }
        d = d + 1;
    }
    return ident_of(mem, argp, base, stem, "unit");
}

// ================================================================ Java（第三门）
//
// `_from_class_lang` —— "函数住在 `class X { … }` 里"那一族的共用引擎（Java / C#）。
// 与 C 那套**不是同一批扫描器**：类体要按花括号配平切成员（深度 0 上遇 `;` 或一段完整的
// `{…}` 收一个），类型表另一张，而且**字符串字面量先换成 `""`**（上游 `_STR_LIT.sub('""')`
// 在前、抹注释在后）—— 那一层会**改长度**，所以这一段用 `M_SRC2 → M_BODY` 两级。
// 对象的样子（`_blank` 那个固定键序）与 C 同一份，发射骨架照旧。
//
// 已接的是 Java（`--java`）。C# 只差四张正则与一张类型表，等有对照语料（`loment/cstrans/`）
// 再接 —— 现在接就是**没有对照组**的一格。

/// `_STR_LIT = "(?:[^"\\\n]|\\.)*"` 换成 `""`（**长度会变**，但不跨行 ⇒ 行号不动）。
/// 上游靠"行号不受影响"这条（见 `_from_class_lang` 里那段注解）用 `body` 的下标回
/// `src` 数行号，本实现照同一口径。
fn strip_str(src: ptr, n: u32, dst: ptr) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    while i < n {
        let c: u32 = load8(src, i);
        if c == 34 {
            let j: u32 = i + 1;
            let close: u32 = FAIL;
            let going: u32 = 1;
            while j < n && going == 1 {
                let cj: u32 = load8(src, j);
                if cj == 34 {
                    close = j;
                    going = 0;
                } else if cj == 10 {
                    going = 0;
                } else if cj == 92 && j + 1 < n && load8(src, j + 1) != 10 {
                    j = j + 2;
                } else if cj == 92 {
                    going = 0;
                } else {
                    j = j + 1;
                }
            }
            if close != FAIL {
                store8(dst, o, 34 as u8);
                store8(dst, o + 1, 34 as u8);
                o = o + 2;
                i = close + 1;
            } else {
                store8(dst, o, 34 as u8);
                o = o + 1;
                i = i + 1;
            }
        } else {
            store8(dst, o, c as u8);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

/// 掐掉尾部空白，返回新终点。
fn trim_end(p: ptr, a: u32, b: u32) -> u32 {
    let e: u32 = b;
    while e > a && is_sp(load8(p, e - 1)) == 1 {
        e = e - 1;
    }
    return e;
}

/// 两段字节相等吗（不同缓冲、不同起点；`body` 里的类名与 `norm` 里的方法名要比）。
fn same_n(p: ptr, a: u32, q: ptr, b: u32, l: u32) -> u32 {
    let i: u32 = 0;
    while i < l {
        if load8(p, a + i) != load8(q, b + i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// `kw` + `[ \t]+`（**只收空格/制表**：上游这些地方写的是 `[ \t]+`，换行不算）。
/// 命中返回词后第一个下标；不命中返回 `FAIL`。
fn jm_word(p: ptr, i: u32, n: u32, kw: str) -> u32 {
    let kl: u32 = str_len(kw);
    if i + kl >= n {
        return FAIL;
    }
    if eq(p, i, kw) == 0 {
        return FAIL;
    }
    if is_ht(load8(p, i + kl)) == 0 {
        return FAIL;
    }
    return skip_ht(p, i + kl, n);
}

/// 成员声明上的修饰词表。`which`: 0 = 常量那一个（**至多一个**），1 = 方法，2 = 字段。
/// **两张表必须分开**（`docs/188` §7.1）：C# 的 `internal` / `sealed` / `partial` 不在
/// Java 那张里 —— 共用一张的话一条 `internal static int F()` 匹配不上方法那条正则，
/// 就掉进"以 `;` 结尾 = 字段"那一支被丢掉（**静默丢一个函数**）。
fn jmods(p: ptr, i: u32, n: u32, which: u32, mode: u32) -> u32 {
    let j: u32 = i;
    if which == 0 {
        let a: u32 = jm_word(p, j, n, "public");
        if a != FAIL {
            return a;
        }
        let b: u32 = jm_word(p, j, n, "private");
        if b != FAIL {
            return b;
        }
        let c: u32 = jm_word(p, j, n, "protected");
        if c != FAIL {
            return c;
        }
        if mode == 4 {
            let d: u32 = jm_word(p, j, n, "internal");
            if d != FAIL {
                return d;
            }
        }
        return j;
    }
    let going: u32 = 1;
    while going == 1 {
        let nx: u32 = jm_word(p, j, n, "public");
        if nx == FAIL {
            nx = jm_word(p, j, n, "private");
        }
        if nx == FAIL {
            nx = jm_word(p, j, n, "protected");
        }
        if mode == 4 {
            if nx == FAIL {
                nx = jm_word(p, j, n, "internal");
            }
        }
        if nx == FAIL {
            nx = jm_word(p, j, n, "static");
        }
        // `final` **只在 Java 那张表里**（`_CS_MODS` 没有它）—— 不挡的话
        // `static final int K = 5;` 在 C# 下会被吃成"修饰词 static final + 字段 K"，
        // 而上游那边它落在"无映射、丢掉"。
        if nx == FAIL && mode != 4 {
            nx = jm_word(p, j, n, "final");
        }
        if mode == 4 {
            // C# 那十六张（`_CS_MODS`）
            if nx == FAIL {
                nx = jm_word(p, j, n, "sealed");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "abstract");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "virtual");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "override");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "partial");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "new");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "extern");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "unsafe");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "readonly");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "volatile");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "async");
            }
        } else if which == 1 {
            if nx == FAIL {
                nx = jm_word(p, j, n, "abstract");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "native");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "synchronized");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "default");
            }
        } else {
            if nx == FAIL {
                nx = jm_word(p, j, n, "transient");
            }
            if nx == FAIL {
                nx = jm_word(p, j, n, "volatile");
            }
        }
        if nx == FAIL {
            going = 0;
        } else {
            j = nx;
        }
    }
    return j;
}

/// 可选 `public[ \t]+`。
fn jm_public(p: ptr, i: u32, n: u32) -> u32 {
    let a: u32 = jm_word(p, i, n, "public");
    if a == FAIL {
        return i;
    }
    return a;
}

/// C# 那两类声明的前缀试一次：`public|internal|private|protected` 加上
/// `sealed|abstract|static|partial|readonly|ref`（**只有 class/struct 那一支**）。
/// 上游 `_CS_CLASS` / `_CS_ENUM` 写成"一整张反复的表、连 `public` 都在表里"，
/// 与 Java 那个"可选 `public` + 反复的 final/abstract"**不同形** —— 所以另写一支。
fn jcs_decl1(p: ptr, j: u32, n: u32, kind: u32) -> u32 {
    let nx: u32 = jm_word(p, j, n, "public");
    if nx == FAIL {
        nx = jm_word(p, j, n, "internal");
    }
    if nx == FAIL {
        nx = jm_word(p, j, n, "private");
    }
    if nx == FAIL {
        nx = jm_word(p, j, n, "protected");
    }
    if nx == FAIL && kind == 0 {
        nx = jm_word(p, j, n, "sealed");
    }
    if nx == FAIL && kind == 0 {
        nx = jm_word(p, j, n, "abstract");
    }
    if nx == FAIL && kind == 0 {
        nx = jm_word(p, j, n, "static");
    }
    if nx == FAIL && kind == 0 {
        nx = jm_word(p, j, n, "partial");
    }
    if nx == FAIL && kind == 0 {
        nx = jm_word(p, j, n, "readonly");
    }
    if nx == FAIL && kind == 0 {
        nx = jm_word(p, j, n, "ref");
    }
    return nx;
}

/// 类/枚举声明前面那串修饰词（Java 与 C# 的表不同 —— `docs/188` §7.1）。
fn jdecl_mods(p: ptr, i: u32, n: u32, kind: u32, mode: u32) -> u32 {
    let j: u32 = i;
    if mode == 4 {
        let going: u32 = 1;
        while going == 1 {
            let nx: u32 = jcs_decl1(p, j, n, kind);
            if nx == FAIL {
                going = 0;
            } else {
                j = nx;
            }
        }
        return j;
    }
    let j1: u32 = jm_public(p, j, n);
    let going2: u32 = 1;
    while going2 == 1 {
        let nx: u32 = jm_word(p, j1, n, "final");
        if nx == FAIL && kind == 0 {
            nx = jm_word(p, j1, n, "abstract");
        }
        if nx == FAIL && kind == 1 {
            nx = jm_word(p, j1, n, "static");
        }
        if nx == FAIL {
            going2 = 0;
        } else {
            j1 = nx;
        }
    }
    return j1;
}

/// 类/枚举那条声明：`(?:^|\n)[ \t]*(?:MOD[ \t]+)*(class|enum)[ \t]+NAME[^{;]*\{`
/// （Java 的 `_JAVA_CLASS` / `_JAVA_ENUM`；C# 那边多收一个 `struct`）。
/// `kind`: 0 = class/struct, 1 = enum。
/// 命中写 `J_OB`（那个 `{`）/`J_CE`（配对的 `}`，不配平时 `FAIL`）/`J_NO`,`J_NL`（名字）。
fn find_jdecl(body: ptr, n: u32, from: u32, r: ptr, kind: u32, mode: u32) -> u32 {
    let i: u32 = from;
    while i < n {
        if i == 0 || load8(body, i - 1) == 10 {
            let j0: u32 = skip_ht(body, i, n);
            let j2: u32 = jdecl_mods(body, j0, n, kind, mode);
            let kl: u32 = 0;
            let hit: u32 = 0;
            if kind == 0 {
                if j2 + 5 <= n && eq(body, j2, "class") == 1 {
                    kl = 5;
                    hit = 1;
                }
                // C# 的"一坨有字段的值类型"最自然的写法是 `struct`（只收 class 的话，
                // 一份 `public struct Frame { public byte tag; }` 会**静默丢掉整个类型**）
                if mode == 4 {
                    if j2 + 6 <= n && eq(body, j2, "struct") == 1 {
                        kl = 6;
                        hit = 1;
                    }
                }
            } else {
                if j2 + 4 <= n && eq(body, j2, "enum") == 1 {
                    kl = 4;
                    hit = 1;
                }
            }
            if hit == 1 {
                let t: u32 = j2 + kl;
                if t < n && is_ht(load8(body, t)) == 1 {
                    let k: u32 = skip_ht(body, t, n);
                    if k > t && k < n && is_id0(load8(body, k)) == 1 {
                        let e: u32 = k;
                        while e < n && is_w(load8(body, e)) == 1 {
                            e = e + 1;
                        }
                        let z: u32 = e;
                        while z < n && load8(body, z) != 123 && load8(body, z) != 59 {
                            z = z + 1;
                        }
                        if z < n && load8(body, z) == 123 {
                            let _a: u32 = st32(r, J_OB, z);
                            let _b: u32 = st32(r, J_NO, k);
                            let _c: u32 = st32(r, J_NL, e - k);
                            let _d: u32 = st32(r, J_CE, block_end(body, z, n));
                            return 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `_class_members(inner)`：类体里**顶层**的成员（深度 0 上遇 `;` 或一段完整的 `{…}` 收一个）。
/// 成员记进 `M_CMEM`: (start, end, off)。**末尾不成段的那些丢掉**（上游也不收）。
fn class_members(mem: ptr, body: ptr, a: u32, b: u32) -> u32 {
    let tbl: ptr = ptr_add(mem, M_CMEM);
    let cnt: u32 = 0;
    let depth: u32 = 0;
    let start: u32 = FAIL;
    let begin: u32 = a;
    let i: u32 = a;
    while i < b {
        let c: u32 = load8(body, i);
        if c == 123 {
            depth = depth + 1;
            if depth == 1 {
                start = i;
            }
        } else if c == 125 {
            depth = depth - 1;
            if depth == 0 && start != FAIL {
                if cnt < CMAX {
                    let _a: u32 = st32(tbl, cnt * CW, begin);
                    let _b: u32 = st32(tbl, cnt * CW + 4, i + 1);
                    let _c: u32 = st32(tbl, cnt * CW + 8, begin - a);
                }
                cnt = cnt + 1;
                start = FAIL;
                begin = i + 1;
            }
        } else if c == 59 && depth == 0 {
            if cnt < CMAX {
                let _d: u32 = st32(tbl, cnt * CW, begin);
                let _e: u32 = st32(tbl, cnt * CW + 4, i + 1);
                let _f: u32 = st32(tbl, cnt * CW + 8, begin - a);
            }
            cnt = cnt + 1;
            begin = i + 1;
        }
        i = i + 1;
    }
    return cnt;
}

/// `" ".join(text.split())`（写进 `dst`；原地归一化也安全 —— `o` 只会落后于 `i`）。
fn norm_of(p: ptr, a: u32, b: u32, dst: ptr) -> u32 {
    let o: u32 = 0;
    let i: u32 = a;
    while i < b {
        if is_sp(load8(p, i)) == 1 {
            i = i + 1;
        } else {
            if o > 0 {
                store8(dst, o, 32 as u8);
                o = o + 1;
            }
            while i < b && is_sp(load8(p, i)) == 0 {
                store8(dst, o, load8(p, i) as u8);
                o = o + 1;
                i = i + 1;
            }
        }
    }
    return o;
}

/// 类型 token: `[A-Za-z_][\w.]*(?:<[^>]*>)?(?:\[\])*`。返回终点下标（配不上返回 `FAIL`）。
/// `<…>` 配不上 `>` 时**停在 `<` 之前** —— 上游那一支是可选的，退回去之后后面必然配不上，
/// 由调用方那一处自然失败，不是这里提前判死。
fn jtype(p: ptr, i: u32, n: u32) -> u32 {
    if i >= n || is_id0(load8(p, i)) == 0 {
        return FAIL;
    }
    let j: u32 = i + 1;
    while j < n && (is_w(load8(p, j)) == 1 || load8(p, j) == 46) {
        j = j + 1;
    }
    if j < n && load8(p, j) == 60 {
        let k: u32 = j + 1;
        let went: u32 = 0;
        while k < n && load8(p, k) != 62 {
            k = k + 1;
            went = 1;
        }
        if k < n && went == 1 {
            j = k + 1;
        }
    }
    while j + 1 < n && load8(p, j) == 91 && load8(p, j + 1) == 93 {
        j = j + 2;
    }
    return j;
}

/// `_JAVA_CONST`：`^[ \t]*(?:(?:public|private|protected)[ \t]+)?static[ \t]+final[ \t]+`
/// `([A-Za-z_][\w.]*)[ \t]+([A-Za-z_]\w*)[ \t]*=[ \t]*(-?\d+)[ \t]*;`
/// C# 那边是 `_CS_CONST`：`const` **隐含 static**，所以没有 `static` 那一截；
/// 可选修饰词里多一个 `internal`。
fn jm_const(mem: ptr, p: ptr, l: u32, mode: u32) -> u32 {
    let jr: ptr = ptr_add(mem, M_JS);
    let i0: u32 = skip_ht(p, 0, l);
    let i1: u32 = jmods(p, i0, l, 0, mode);
    let a: u32 = jm_word(p, i1, l, "static");
    if a == FAIL && mode == 4 {
        a = i1;
    }
    if a == FAIL {
        return 0;
    }
    let b: u32 = jm_word(p, a, l, "const");
    if b == FAIL && mode != 4 {
        b = jm_word(p, a, l, "final");
    }
    if b == FAIL {
        return 0;
    }
    if b >= l || is_id0(load8(p, b)) == 0 {
        return 0;
    }
    let te: u32 = b + 1;
    while te < l && (is_w(load8(p, te)) == 1 || load8(p, te) == 46) {
        te = te + 1;
    }
    if te >= l || is_ht(load8(p, te)) == 0 {
        return 0;
    }
    let ns: u32 = skip_ht(p, te, l);
    if ns >= l || is_id0(load8(p, ns)) == 0 {
        return 0;
    }
    let ne: u32 = ns + 1;
    while ne < l && is_w(load8(p, ne)) == 1 {
        ne = ne + 1;
    }
    let eqp: u32 = skip_ht(p, ne, l);
    if eqp >= l || load8(p, eqp) != 61 {
        return 0;
    }
    let vs: u32 = skip_ht(p, eqp + 1, l);
    let neg: u32 = 0;
    let vs2: u32 = vs;
    if vs2 < l && load8(p, vs2) == 45 {
        neg = 1;
        vs = vs2 + 1;
    }
    let de: u32 = vs;
    while de < l && is_d(load8(p, de)) == 1 {
        de = de + 1;
    }
    if de == vs {
        return 0;
    }
    let sc: u32 = skip_ht(p, de, l);
    if sc >= l || load8(p, sc) != 59 {
        return 0;
    }
    let _a: u32 = st32(jr, J_TS, b);
    let _b: u32 = st32(jr, J_TL, te - b);
    let _c: u32 = st32(jr, J_NS, ns);
    let _d: u32 = st32(jr, J_NL2, ne - ns);
    let _e: u32 = st32(jr, J_VS, vs);
    let _f: u32 = st32(jr, J_VL, de - vs);
    let _g: u32 = st32(jr, J_VN, neg);
    return 1;
}

/// `_JAVA_METHOD`：`^[ \t]*((?:public|private|protected|static|final|abstract|native|`
/// `synchronized|default)[ \t]+)*(?:<[^>]+>[ \t]+)?` 类型 `[ \t]+` 名字 `[ \t]*\(([^)]*)\)`
fn jm_method(mem: ptr, p: ptr, l: u32, mode: u32) -> u32 {
    let jr: ptr = ptr_add(mem, M_JS);
    let i0: u32 = skip_ht(p, 0, l);
    let i1: u32 = jmods(p, i0, l, 1, mode);
    let g: u32 = i1;
    if g < l && load8(p, g) == 60 {
        let k: u32 = g + 1;
        let went: u32 = 0;
        while k < l && load8(p, k) != 62 {
            k = k + 1;
            went = 1;
        }
        if k < l && went == 1 && k + 1 < l && is_ht(load8(p, k + 1)) == 1 {
            g = skip_ht(p, k + 1, l);
        } else {
            return 0;
        }
    }
    let ts: u32 = g;
    let te: u32 = jtype(p, g, l);
    if te == FAIL {
        return 0;
    }
    if te >= l || is_ht(load8(p, te)) == 0 {
        return 0;
    }
    let ns: u32 = skip_ht(p, te, l);
    if ns >= l || is_id0(load8(p, ns)) == 0 {
        return 0;
    }
    let ne: u32 = ns + 1;
    while ne < l && is_w(load8(p, ne)) == 1 {
        ne = ne + 1;
    }
    let ps: u32 = skip_ht(p, ne, l);
    if ps >= l || load8(p, ps) != 40 {
        return 0;
    }
    let pe: u32 = ps + 1;
    while pe < l && load8(p, pe) != 41 {
        pe = pe + 1;
    }
    if pe >= l {
        return 0;
    }
    let _a: u32 = st32(jr, J_TS, ts);
    let _b: u32 = st32(jr, J_TL, te - ts);
    let _c: u32 = st32(jr, J_NS, ns);
    let _d: u32 = st32(jr, J_NL2, ne - ns);
    // `J_PS`/`J_PL` 是**参数表那一段的起止下标**（`[J_PS, J_PL)`，与 C 那套 `params_ok`
    // 同一个口径：`b` 是终点不是长度）。空参数表时 `J_PS > J_PL` ⇒ 走一遍不发射。
    let _e: u32 = st32(jr, J_PS, ps + 1);
    let _f: u32 = st32(jr, J_PL, pe);
    return 1;
}

/// `_JAVA_FIELD`：修饰词 + 类型 + 名字 + `(?:=[^;]*)?;`，**整条到底**（`$`）。
fn jm_field(mem: ptr, p: ptr, l: u32, mode: u32) -> u32 {
    let jr: ptr = ptr_add(mem, M_JS);
    let i0: u32 = skip_ht(p, 0, l);
    let i1: u32 = jmods(p, i0, l, 2, mode);
    let ts: u32 = i1;
    let te: u32 = jtype(p, ts, l);
    if te == FAIL {
        return 0;
    }
    if te >= l || is_ht(load8(p, te)) == 0 {
        return 0;
    }
    let ns: u32 = skip_ht(p, te, l);
    if ns >= l || is_id0(load8(p, ns)) == 0 {
        return 0;
    }
    let ne: u32 = ns + 1;
    while ne < l && is_w(load8(p, ne)) == 1 {
        ne = ne + 1;
    }
    let j2: u32 = skip_ht(p, ne, l);
    let sc: u32 = j2;
    if j2 < l && load8(p, j2) == 61 {
        let k: u32 = j2 + 1;
        while k < l && load8(p, k) != 59 {
            k = k + 1;
        }
        if k >= l {
            return 0;
        }
        sc = k;
    }
    if sc >= l || load8(p, sc) != 59 {
        return 0;
    }
    if trim_end(p, sc + 1, l) != sc + 1 {
        return 0;
    }
    let _a: u32 = st32(jr, J_TS, ts);
    let _b: u32 = st32(jr, J_TL, te - ts);
    let _c: u32 = st32(jr, J_NS, ns);
    let _d: u32 = st32(jr, J_NL2, ne - ns);
    return 1;
}

/// 判一个成员是哪一类（`_from_class_lang` 那个顺序：**常量 -> 方法 -> 字段**）。
/// 方法必须在字段之前 —— 抽象/native 方法以 `;` 结尾却带参数表，先判字段就会把它们丢掉。
/// 返回 1=常量, 2=方法, 3=字段, 0=不收。
fn jclassify(mem: ptr, body: ptr, s: u32, e: u32, norm: ptr, mode: u32) -> u32 {
    let l: u32 = norm_of(body, s, e, norm);
    if jm_const(mem, norm, l, mode) == 1 {
        return 1;
    }
    if jm_method(mem, norm, l, mode) == 1 {
        return 2;
    }
    if l > 0 {
        if load8(norm, l - 1) == 59 {
            if jm_field(mem, norm, l, mode) == 1 {
                return 3;
            }
        }
    }
    return 0;
}

/// Java / C# 那张类型表（`JAVA_TYPES` / `CS_TYPES`）。命中写进 `d` 返回长度；无映射返回 0。
/// **`float`/`double` 与装箱类型（`Integer`/`Object`…）故意不在这张表里** —— 上游给的是
/// 显式 `None`：装箱类型**可以为 null**，映成 `i32` 就把"可能没有值"丢了。
///
/// ⚠ **两门唯一没落在同一格上的是 `byte`**：Java 有符号（`i8`）、C# 无符号（`u8`）。
/// 搞反的后果**不是报错而是静默算错**（C# 里 `byte b = 200;` 会变成 -56）。
fn jtable(d: ptr, s: ptr, m: u32, mode: u32) -> u32 {
    if m == 4 && eq(s, 0, "byte") == 1 {
        if mode == 4 {
            return put_lit(d, "u8");
        }
        return put_lit(d, "i8");
    }
    if mode == 4 {
        if m == 5 && eq(s, 0, "sbyte") == 1 {
            return put_lit(d, "i8");
        }
        if m == 6 && eq(s, 0, "ushort") == 1 {
            return put_lit(d, "u16");
        }
        if m == 4 && eq(s, 0, "uint") == 1 {
            return put_lit(d, "u32");
        }
        if m == 5 && eq(s, 0, "ulong") == 1 {
            return put_lit(d, "u64");
        }
        if m == 4 && eq(s, 0, "bool") == 1 {
            return put_lit(d, "bool");
        }
        if m == 6 && eq(s, 0, "string") == 1 {
            return put_lit(d, "str");
        }
    }
    if m == 5 && eq(s, 0, "short") == 1 {
        return put_lit(d, "i16");
    }
    if m == 3 && eq(s, 0, "int") == 1 {
        return put_lit(d, "i32");
    }
    if m == 4 && eq(s, 0, "long") == 1 {
        return put_lit(d, "i64");
    }
    if m == 4 && eq(s, 0, "void") == 1 {
        return put_lit(d, "()");
    }
    if m == 4 && eq(s, 0, "char") == 1 {
        // Java 的 `char` 是 **16 位无符号**（不是 C 的 8 位）
        return put_lit(d, "u16");
    }
    // `boolean` / `String` **只有 Java 那张表里有**（C# 写 `bool` / `string`）——
    // 不挡的话 C# 的 `String x;` 会被这一支接下判成 `str`，而上游那边是"无映射"。
    if mode != 4 {
        if m == 7 && eq(s, 0, "boolean") == 1 {
            return put_lit(d, "bool");
        }
        if m == 6 && eq(s, 0, "String") == 1 {
            return put_lit(d, "str");
        }
    }
    return 0;
}

/// `_lang_type` 里**不是数组**的那一半：known -> `<` 泛型 -> 查表。
fn jl_atom(mem: ptr, t: ptr, tl: u32, mode: u32) -> u32 {
    let d: ptr = ptr_add(mem, M_TYPE);
    if known_find(mem, t, 0, tl) == 1 {
        let _c: u32 = copy_n(d, 0, t, 0, tl);
        return tl;
    }
    if find_ch(t, 0, tl, 60) != FAIL {
        return 0;
    }
    return jtable(d, t, tl, mode);
}

/// `_lang_type`: 归一化空白 -> `[]` 递归 -> known -> `<` 泛型 -> 查表。
/// 命中把类型名写进 `M_TYPE` 返回长度；无映射返回 0。递归改循环（`[]` 只往后剥）。
fn jl_type(mem: ptr, p: ptr, off: u32, l: u32, mode: u32) -> u32 {
    let t: ptr = ptr_add(mem, M_JT);
    let tl: u32 = norm_of(p, off, off + l, t);
    let k: u32 = 0;
    while tl >= 2 && load8(t, tl - 2) == 91 && load8(t, tl - 1) == 93 {
        k = k + 1;
        tl = norm_of(t, 0, tl - 2, t);
    }
    if tl == 0 {
        return 0;
    }
    let base: u32 = jl_atom(mem, t, tl, mode);
    if base == 0 {
        return 0;
    }
    let d: ptr = ptr_add(mem, M_TYPE);
    let bl: u32 = base;
    let j: u32 = 0;
    while j < k {
        let z: u32 = bl + 2 * j;
        let q: u32 = z;
        while q > 0 {
            store8(d, q, load8(d, q - 1) as u8);
            q = q - 1;
        }
        store8(d, 0, 91 as u8);
        store8(d, z + 1, 93 as u8);
        j = j + 1;
    }
    return bl + 2 * k;
}

/// 参数表里每一段是不是 `类型 名字`（返回 1 = 全好）。逐段判、**不发射**。
fn jparams_ok(mem: ptr, p: ptr, a: u32, b: u32, mode: u32) -> u32 {
    let sp0: ptr = ptr_add(mem, M_JS + J_SP0);
    let q: u32 = a;
    while q <= b {
        let seg: u32 = find_ch(p, q, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = skip_sp(p, q, se);
        let e2: u32 = trim_end(p, s2, se);
        if e2 > s2 {
            let nl: u32 = last_tok(p, s2, e2, sp0);
            let ns: u32 = ld32(sp0, 0);
            if ns <= s2 {
                return 0;
            }
            if is_ident(p, ns, nl) == 0 {
                return 0;
            }
            if jl_type(mem, p, s2, ns - s2, mode) == 0 {
                return 0;
            }
        }
        if seg == FAIL {
            q = b + 1;
        } else {
            q = seg + 1;
        }
    }
    return 1;
}

/// 逐条参数发 `{"name": .., "type": ..}`（调用方已确认都合法）。
fn jparams_emit(mem: ptr, out: ptr, o: u32, p: ptr, a: u32, b: u32, mode: u32) -> u32 {
    let sp0: ptr = ptr_add(mem, M_JS + J_SP0);
    let first: u32 = 1;
    let q: u32 = a;
    while q <= b {
        let seg: u32 = find_ch(p, q, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = skip_sp(p, q, se);
        let e2: u32 = trim_end(p, s2, se);
        if e2 > s2 {
            let nl: u32 = last_tok(p, s2, e2, sp0);
            let ns: u32 = ld32(sp0, 0);
            let tt: u32 = jl_type(mem, p, s2, ns - s2, mode);
            if first == 0 {
                o = jl(out, o, ", ");
            }
            first = 0;
            o = jl(out, o, "{\"name\": ");
            o = jq(out, o, p, ns, nl);
            o = jl(out, o, ", \"type\": ");
            o = jq(out, o, ptr_add(mem, M_TYPE), 0, tt);
            o = jl(out, o, "}");
        }
        if seg == FAIL {
            q = b + 1;
        } else {
            q = seg + 1;
        }
    }
    return o;
}

/// 常量类型必须是整型（`t not in ("i8", …)`）。判的是 `M_TYPE` 里那 `tl` 个字节。
fn is_int_type(mem: ptr, tl: u32) -> u32 {
    let d: ptr = ptr_add(mem, M_TYPE);
    if tl == 2 && eq(d, 0, "u8") == 1 {
        return 1;
    }
    if tl == 2 && eq(d, 0, "i8") == 1 {
        return 1;
    }
    if tl == 3 && eq(d, 0, "u16") == 1 {
        return 1;
    }
    if tl == 3 && eq(d, 0, "i16") == 1 {
        return 1;
    }
    if tl == 3 && eq(d, 0, "u32") == 1 {
        return 1;
    }
    if tl == 3 && eq(d, 0, "i32") == 1 {
        return 1;
    }
    if tl == 3 && eq(d, 0, "u64") == 1 {
        return 1;
    }
    if tl == 3 && eq(d, 0, "i64") == 1 {
        return 1;
    }
    return 0;
}

/// `inner.split(",")` 那一步的每个变体名。记进 `M_MEMB`: (off, len)；返回条数。
/// 变体可以带构造实参（`B(1)`）与体（`C { … }`）—— 只取名字，与上游同。
fn jenum_variants(mem: ptr, body: ptr, a: u32, b: u32) -> u32 {
    let cnt: u32 = 0;
    let p: u32 = a;
    while p <= b {
        let seg: u32 = find_ch(body, p, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = skip_sp(body, p, se);
        let e2: u32 = trim_end(body, s2, se);
        if e2 > s2 {
            // 第一段非空白 = `raw.strip().split()[0]`
            let e3: u32 = s2;
            while e3 < e2 && is_sp(load8(body, e3)) == 0 {
                e3 = e3 + 1;
            }
            // 再 `.split("(")[0].split("{")[0].strip()`
            let e4: u32 = e3;
            let k1: u32 = find_ch(body, s2, e3, 40);
            if k1 != FAIL {
                e4 = k1;
            }
            let k2: u32 = find_ch(body, s2, e4, 123);
            if k2 != FAIL {
                e4 = k2;
            }
            let s5: u32 = skip_sp(body, s2, e4);
            let e5: u32 = trim_end(body, s5, e4);
            if e5 > s5 && is_ident(body, s5, e5 - s5) == 1 && cnt < MMAX {
                let _a: u32 = st32(ptr_add(mem, M_MEMB), cnt * MW, s5);
                let _b: u32 = st32(ptr_add(mem, M_MEMB), cnt * MW + 4, e5 - s5);
                let _c: u32 = st32(ptr_add(mem, M_MEMB), cnt * MW + 8, 0);
                cnt = cnt + 1;
            }
        }
        if seg == FAIL {
            p = b + 1;
        } else {
            p = seg + 1;
        }
    }
    return cnt;
}

/// 枚举那一圈对 `known` 的贡献（上游在**类那一圈之前**做，且只有"有变体"的那些进 known）。
fn jenum_known(mem: ptr, mode: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let jr: ptr = ptr_add(mem, M_JS);
    let i: u32 = 0;
    while find_jdecl(body, n, i, jr, 1, mode) == 1 {
        let ob: u32 = ld32(jr, J_OB);
        let ce: u32 = ld32(jr, J_CE);
        i = ob + 1;
        if ce != FAIL {
            if jenum_variants(mem, body, ob + 1, ce) > 0 {
                let _k: u32 = known_add(mem, ptr_add(body, ld32(jr, J_NO)), ld32(jr, J_NL));
            }
        }
    }
    return 0;
}

/// 一个类体的成员里有几个字段能进对象（映射不上的不算）。判的时候用**当前** known。
fn jfld_count(mem: ptr, body: ptr, ob: u32, ce: u32, norm: ptr, mode: u32) -> u32 {
    let cnt: u32 = class_members(mem, body, ob, ce);
    let jr: ptr = ptr_add(mem, M_JS);
    let got: u32 = 0;
    let k: u32 = 0;
    while k < cnt {
        let ms: u32 = ld32(ptr_add(mem, M_CMEM), k * CW);
        let me: u32 = ld32(ptr_add(mem, M_CMEM), k * CW + 4);
        if jclassify(mem, body, ms, me, norm, mode) == 3 {
            if jl_type(mem, norm, ld32(jr, J_TS), ld32(jr, J_TL), mode) != 0 {
                got = got + 1;
            }
        }
        k = k + 1;
    }
    return got;
}

/// 类里的方法 -> `functions`。`known` 按上游的增量顺序走：枚举先、每进一个类先补它的名字。
fn j_emit_functions(mem: ptr, out: ptr, o: u32, mode: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let jr: ptr = ptr_add(mem, M_JS);
    let norm: ptr = ptr_add(mem, M_NORM);
    let _rst: u32 = known_reset(mem);
    let _ek: u32 = jenum_known(mem, mode);
    let first: u32 = 1;
    let i: u32 = 0;
    while find_jdecl(body, n, i, jr, 0, mode) == 1 {
        let ob: u32 = ld32(jr, J_OB);
        let ce: u32 = ld32(jr, J_CE);
        let cns: u32 = ld32(jr, J_NO);
        let cnl: u32 = ld32(jr, J_NL);
        i = ob + 1;
        if ce != FAIL {
            let cnt: u32 = class_members(mem, body, ob + 1, ce);
            if jfld_count(mem, body, ob + 1, ce, norm, mode) > 0 {
                let _ka: u32 = known_add(mem, ptr_add(body, cns), cnl);
            }
            let k: u32 = 0;
            while k < cnt {
                let ms: u32 = ld32(ptr_add(mem, M_CMEM), k * CW);
                let me: u32 = ld32(ptr_add(mem, M_CMEM), k * CW + 4);
                if jclassify(mem, body, ms, me, norm, mode) == 2 {
                    let mnl: u32 = ld32(jr, J_NL2);
                    let mns: u32 = ld32(jr, J_NS);
                    let ctor: u32 = 0;
                    if mnl == cnl {
                        if same_n(norm, mns, body, cns, cnl) == 1 {
                            ctor = 1;
                        }
                    }
                    if ctor == 0 {
                        let rtl: u32 = jl_type(mem, norm, ld32(jr, J_TS), ld32(jr, J_TL), mode);
                        if rtl != 0 {
                            let _sv: u32 = copy_n(ptr_add(mem, M_TXT), 0, ptr_add(mem, M_TYPE), 0, rtl);
                            if jparams_ok(mem, norm, ld32(jr, J_PS), ld32(jr, J_PL), mode) == 1 {
                                if first == 0 {
                                    o = jl(out, o, ", ");
                                }
                                first = 0;
                                o = jl(out, o, "{\"name\": ");
                                o = jq(out, o, norm, mns, mnl);
                                o = jl(out, o, ", \"params\": [");
                                o = jparams_emit(mem, out, o, norm, ld32(jr, J_PS), ld32(jr, J_PL), mode);
                                o = jl(out, o, "], \"ret\": ");
                                o = jq(out, o, ptr_add(mem, M_TXT), 0, rtl);
                                let lead: u32 = 0;
                                let q: u32 = ms;
                                while q < me && is_sp(load8(body, q)) == 1 {
                                    lead = lead + 1;
                                    q = q + 1;
                                }
                                let bs: u32 = ms + lead;
                                let be: u32 = trim_end(body, bs, me);
                                if be > bs {
                                    o = jl(out, o, ", \"body\": ");
                                    o = jq(out, o, body, bs, be - bs);
                                    o = jl(out, o, ", \"body_line\": ");
                                    // 上游 `_body_at(src, open_idx+1+mem_off, mem_raw)`：
                                    // 那个下标是**剥过字面量的 body** 的（Python 的**字符**口径），
                                    // 数的却是**原文 src** 里的换行。两件事各归各，这里照抄。
                                    o = jint(out, o, 0,
                                             line_at_chars(ptr_add(mem, M_SRC),
                                                           ld32(ptr_add(mem, M_SC), 16),
                                                           chars_n(ptr_add(mem, M_SRC2), ms) + lead));
                                }
                                o = jl(out, o, "}");
                            }
                        }
                    }
                }
                k = k + 1;
            }
        }
    }
    return o;
}

/// 类里的常量 -> `consts`（同名只发一次；类型必须是整型）。
fn j_emit_consts(mem: ptr, out: ptr, o: u32, mode: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let jr: ptr = ptr_add(mem, M_JS);
    let norm: ptr = ptr_add(mem, M_NORM);
    let first: u32 = 1;
    let i: u32 = 0;
    while find_jdecl(body, n, i, jr, 0, mode) == 1 {
        let ob: u32 = ld32(jr, J_OB);
        let ce: u32 = ld32(jr, J_CE);
        i = ob + 1;
        if ce != FAIL {
            let cnt: u32 = class_members(mem, body, ob + 1, ce);
            let k: u32 = 0;
            while k < cnt {
                let ms: u32 = ld32(ptr_add(mem, M_CMEM), k * CW);
                let me: u32 = ld32(ptr_add(mem, M_CMEM), k * CW + 4);
                if jclassify(mem, body, ms, me, norm, mode) == 1 {
                    let ns: u32 = ld32(jr, J_NS);
                    let nl: u32 = ld32(jr, J_NL2);
                    if const_seen(mem, norm, ns, nl) == 0 {
                        let tl: u32 = jl_type(mem, norm, ld32(jr, J_TS), ld32(jr, J_TL), mode);
                        if tl != 0 {
                            if is_int_type(mem, tl) == 1 {
                                if first == 0 {
                                    o = jl(out, o, ", ");
                                }
                                first = 0;
                                o = jl(out, o, "{\"name\": ");
                                o = jq(out, o, norm, ns, nl);
                                o = jl(out, o, ", \"type\": ");
                                o = jq(out, o, ptr_add(mem, M_TYPE), 0, tl);
                                o = jl(out, o, ", \"value\": ");
                                let vs: u32 = ld32(jr, J_VS);
                                let vl: u32 = ld32(jr, J_VL);
                                let neg: u32 = ld32(jr, J_VN);
                                let z0: u32 = vs;
                                while z0 < vs + vl && load8(norm, z0) == 48 {
                                    z0 = z0 + 1;
                                }
                                if z0 == vs + vl {
                                    o = jl(out, o, "0");
                                } else {
                                    if neg == 1 {
                                        o = jl(out, o, "-");
                                    }
                                    o = jraw(out, o, norm, z0, vs + vl - z0);
                                }
                                o = jl(out, o, "}");
                                let _m: u32 = const_mark(mem, norm, ns, nl);
                            }
                        }
                    }
                }
                k = k + 1;
            }
        }
    }
    return o;
}

/// Java 的 `enum Name { A, B, C }` -> `enums`（**不是 class**，类那一圈抓不到它）。
fn j_emit_enums(mem: ptr, out: ptr, o: u32, mode: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let jr: ptr = ptr_add(mem, M_JS);
    let first: u32 = 1;
    let i: u32 = 0;
    while find_jdecl(body, n, i, jr, 1, mode) == 1 {
        let ob: u32 = ld32(jr, J_OB);
        let ce: u32 = ld32(jr, J_CE);
        i = ob + 1;
        if ce != FAIL {
            let cnt: u32 = jenum_variants(mem, body, ob + 1, ce);
            if cnt > 0 {
                if first == 0 {
                    o = jl(out, o, ", ");
                }
                first = 0;
                o = jl(out, o, "{\"name\": ");
                o = jq(out, o, body, ld32(jr, J_NO), ld32(jr, J_NL));
                o = jl(out, o, ", \"variants\": [");
                let k: u32 = 0;
                while k < cnt {
                    if k > 0 {
                        o = jl(out, o, ", ");
                    }
                    o = jq(out, o, body, ld32(ptr_add(mem, M_MEMB), k * MW),
                           ld32(ptr_add(mem, M_MEMB), k * MW + 4));
                    k = k + 1;
                }
                o = jl(out, o, "]}");
            }
        }
    }
    return o;
}

/// 类 -> `types`（字段全映射不上的那些类**整类丢掉**，与上游同）。
fn j_emit_types(mem: ptr, out: ptr, o: u32, mode: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let jr: ptr = ptr_add(mem, M_JS);
    let norm: ptr = ptr_add(mem, M_NORM);
    let _rst: u32 = known_reset(mem);
    let _ek: u32 = jenum_known(mem, mode);
    let first: u32 = 1;
    let i: u32 = 0;
    while find_jdecl(body, n, i, jr, 0, mode) == 1 {
        let ob: u32 = ld32(jr, J_OB);
        let ce: u32 = ld32(jr, J_CE);
        let cns: u32 = ld32(jr, J_NO);
        let cnl: u32 = ld32(jr, J_NL);
        i = ob + 1;
        if ce != FAIL {
            if jfld_count(mem, body, ob + 1, ce, norm, mode) > 0 {
                let cnt: u32 = class_members(mem, body, ob + 1, ce);
                if first == 0 {
                    o = jl(out, o, ", ");
                }
                first = 0;
                o = jl(out, o, "{\"name\": ");
                o = jq(out, o, body, cns, cnl);
                o = jl(out, o, ", \"fields\": [");
                let fst2: u32 = 1;
                let k: u32 = 0;
                while k < cnt {
                    let ms: u32 = ld32(ptr_add(mem, M_CMEM), k * CW);
                    let me: u32 = ld32(ptr_add(mem, M_CMEM), k * CW + 4);
                    if jclassify(mem, body, ms, me, norm, mode) == 3 {
                        let tl: u32 = jl_type(mem, norm, ld32(jr, J_TS), ld32(jr, J_TL), mode);
                        if tl != 0 {
                            if fst2 == 0 {
                                o = jl(out, o, ", ");
                            }
                            fst2 = 0;
                            o = jl(out, o, "{\"name\": ");
                            o = jq(out, o, norm, ld32(jr, J_NS), ld32(jr, J_NL2));
                            o = jl(out, o, ", \"type\": ");
                            o = jq(out, o, ptr_add(mem, M_TYPE), 0, tl);
                            o = jl(out, o, "}");
                        }
                    }
                    k = k + 1;
                }
                o = jl(out, o, "]}");
                let _ka: u32 = known_add(mem, ptr_add(body, cns), cnl);
            }
        }
    }
    return o;
}

/// Java 那一门的主干（`_from_class_lang`）。
fn build_class(mem: ptr, srcn: u32, argp: ptr, al: u32, mode: u32) -> u32 {
    let src: ptr = ptr_add(mem, M_SRC);
    let src2: ptr = ptr_add(mem, M_SRC2);
    let body: ptr = ptr_add(mem, M_BODY);
    // ① `_STR_LIT.sub('""')`（长度变）② 再抹注释（等长）
    let n2: u32 = strip_str(src, srcn, src2);
    let _b: u32 = blank_noise(src2, n2, body, 0);
    let _n: u32 = st32(ptr_add(mem, M_SC), 0, n2);
    let _sl: u32 = st32(ptr_add(mem, M_SC), 16, srcn);
    let _m: u32 = st32(ptr_add(mem, M_SC), 8, mode);
    let _c: u32 = st32(ptr_add(mem, M_CNST), 0, 0);
    let out: ptr = ptr_add(mem, M_OUT);
    let o1: u32 = jl(out, 0, "{\"potato\": \"v6\", \"unit\": ");
    let un: u32 = unit_name(mem, argp, al);
    let idb: ptr = ptr_add(mem, M_IDENT);
    let o2: u32 = jq(out, o1, idb, 0, un);
    let o3: u32 = o2;
    if mode == 4 {
        o3 = jl(out, o2, ", \"language\": \"loment\", \"grammar\": \"csharp\"");
    } else {
        o3 = jl(out, o2, ", \"language\": \"loment\", \"grammar\": \"java\"");
    }
    let o4: u32 = jl(out, o3, ", \"imports\": [], \"capabilities\": [], \"functions\": [");
    let o5: u32 = j_emit_functions(mem, out, o4, mode);
    let o6: u32 = jl(out, o5, "], \"layouts\": [], \"consts\": [");
    let o7: u32 = j_emit_consts(mem, out, o6, mode);
    let o8: u32 = jl(out, o7, "], \"enums\": [");
    let o9: u32 = j_emit_enums(mem, out, o8, mode);
    let o10: u32 = jl(out, o9, "], \"types\": [");
    let o11: u32 = j_emit_types(mem, out, o10, mode);
    let o12: u32 = jl(out, o11, "], \"traits\": [], \"impls\": [], \"generics\": [], \"instances\": [], \"guards\": 0, \"excluded\": [], \"mode\": \"std\", \"switches\": [], \"dialects\": [], \"bodies\": []}");
    return o12;
}

// ================================================================ Go（第五门）
//
// `potato_from.from_go` —— **类型写在名字后面、条件不带括号、没有 `while`**。
// 与 C / Java-C# 那两套都不是一批扫描器，但它是**正则派**的（不像 Python 那一门要 `ast`）：
// `_GO_STRUCT` / `_GO_FN` / `_GO_EXPORT` 三条，逐个对齐。
//
// 三处与别门不同、必须照抄的：
//   * `struct` 的体**不是**花括号配平出来的 —— `_GO_STRUCT` 写的是 `(.∗?)^[ \t]*\}`：
//     到**第一个以 `}` 起头的行**为止（嵌套 struct 会被截在里层那个 `}` 上，上游如此）。
//   * 形参有**分组写法** `func gcd(a, b int)`（Go 里极常见）：只有名字的那一段先攒着，
//     等后面 `名字 类型` 那一段把类型带过来；**攒到最后还没等到** ⇒ 拒（不静默丢）。
//   * `//export` 是**源码里显式宣称的 C ABI**（`docs/188` §3）—— 只有那种才记 `abi: "c"`，
//     而且只有**没记 abi** 的才带正文（`--impl` 那条路用）。
//
// 差 `from_rust` 与 `from_python`（后者坐在 `ast` 上，不是轻量解析那一派）。

/// `_GO_EXPORT = ^[ \t]*//[ \t]*export[ \t]+([A-Za-z_]\w*)` 里有 `name` 吗。
/// **要在原文上找**（那本身就是一条注释，抹掉就没了）—— 上游也是先在 `src` 上收一遍。
fn go_exported(src: ptr, n: u32, namep: ptr, nameo: u32, nl: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if i == 0 || load8(src, i - 1) == 10 {
            let j: u32 = skip_ht(src, i, n);
            if j + 1 < n && load8(src, j) == 47 && load8(src, j + 1) == 47 {
                let k: u32 = skip_ht(src, j + 2, n);
                if k + 6 <= n && eq(src, k, "export") == 1 {
                    if k + 6 < n && is_ht(load8(src, k + 6)) == 1 {
                        let w: u32 = skip_ht(src, k + 6, n);
                        if w < n && is_id0(load8(src, w)) == 1 {
                            let we: u32 = w + 1;
                            while we < n && is_w(load8(src, we)) == 1 {
                                we = we + 1;
                            }
                            if we - w == nl && same_n(src, w, namep, nameo, nl) == 1 {
                                return 1;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// Go 那张类型表（`GO_TYPES`）。**`int`/`uint` 是平台相关的**，这里按本仓唯一支持的
/// 目标（x86-64）读 —— `int` ⇒ `i64`（与 C 那边 `int -> i32` 不同，是**语言规定不同**，
/// 不是为了整齐）。`float*` / `complex*` 不在表里 ⇒ 无映射。
fn go_table(d: ptr, s: ptr, m: u32) -> u32 {
    if m == 3 && eq(s, 0, "int") == 1 {
        return put_lit(d, "i64");
    }
    if m == 4 && eq(s, 0, "int8") == 1 {
        return put_lit(d, "i8");
    }
    if m == 5 && eq(s, 0, "int16") == 1 {
        return put_lit(d, "i16");
    }
    if m == 5 && eq(s, 0, "int32") == 1 {
        return put_lit(d, "i32");
    }
    if m == 5 && eq(s, 0, "int64") == 1 {
        return put_lit(d, "i64");
    }
    if m == 4 && eq(s, 0, "uint") == 1 {
        return put_lit(d, "u64");
    }
    if m == 5 && eq(s, 0, "uint8") == 1 {
        return put_lit(d, "u8");
    }
    if m == 6 && eq(s, 0, "uint16") == 1 {
        return put_lit(d, "u16");
    }
    if m == 6 && eq(s, 0, "uint32") == 1 {
        return put_lit(d, "u32");
    }
    if m == 6 && eq(s, 0, "uint64") == 1 {
        return put_lit(d, "u64");
    }
    if m == 4 && eq(s, 0, "byte") == 1 {
        return put_lit(d, "u8");
    }
    if m == 4 && eq(s, 0, "rune") == 1 {
        return put_lit(d, "i32");
    }
    if m == 4 && eq(s, 0, "bool") == 1 {
        return put_lit(d, "bool");
    }
    if m == 7 && eq(s, 0, "uintptr") == 1 {
        return put_lit(d, "u64");
    }
    if m == 6 && eq(s, 0, "string") == 1 {
        return put_lit(d, "str");
    }
    return 0;
}

/// `_go_type`: 归一化空白 -> `()`（空）-> `[]` / 变参无映射 -> 尾部 `*` -> known -> 表。
/// 命中把类型名写进 `M_TYPE` 返回长度；无映射返回 0（`()` **是**有效映射）。
fn go_type(mem: ptr, p: ptr, off: u32, l: u32) -> u32 {
    let t: ptr = ptr_add(mem, M_JT);
    let d: ptr = ptr_add(mem, M_TYPE);
    let tl: u32 = norm_of(p, off, off + l, t);
    if tl == 0 {
        return put_lit(d, "()");
    }
    if tl >= 2 && load8(t, 0) == 91 && load8(t, 1) == 93 {
        return 0;                       // 切片是 (ptr,len,cap) 三个字 —— 不猜成 ptr
    }
    if tl >= 3 && load8(t, 0) == 46 && load8(t, 1) == 46 && load8(t, 2) == 46 {
        return 0;                       // `...T` 变参
    }
    // 上游还多一条 `t.endswith("...T")` —— 原样照抄（那是另一种写法的变参）
    if tl >= 4 && load8(t, tl - 4) == 46 && load8(t, tl - 3) == 46
            && load8(t, tl - 2) == 46 && load8(t, tl - 1) == 84 {
        return 0;
    }
    let n: u32 = 0;
    let tl2: u32 = tl;
    while tl2 > 0 && load8(t, tl2 - 1) == 42 {
        tl2 = norm_of(t, 0, tl2 - 1, t);
        n = n + 1;
    }
    if n > 0 {
        return put_lit(d, "ptr");       // `*T` 一律 ptr（Go 没有别的指针形态好用）
    }
    if known_find(mem, t, 0, tl2) == 1 {
        let _c: u32 = copy_n(d, 0, t, 0, tl2);
        return tl2;
    }
    return go_table(d, t, tl2);
}

/// `^[ \t]*type[ \t]+NAME[ \t]+struct[ \t]*\{` + 到**第一个以 `}` 起头的行**。
/// 命中写 `J_OB`（那个 `{`）/`J_CE`（那个 `}` 行的 `}` 下标）/`J_NO`,`J_NL`（名字）。
fn find_gostruct(body: ptr, n: u32, from: u32, r: ptr) -> u32 {
    let i: u32 = from;
    while i < n {
        if i == 0 || load8(body, i - 1) == 10 {
            let j0: u32 = skip_ht(body, i, n);
            if j0 + 4 <= n && eq(body, j0, "type") == 1 {
                if j0 + 4 < n && is_ht(load8(body, j0 + 4)) == 1 {
                    let ns: u32 = skip_ht(body, j0 + 4, n);
                    if ns < n && is_id0(load8(body, ns)) == 1 {
                        let ne: u32 = ns + 1;
                        while ne < n && is_w(load8(body, ne)) == 1 {
                            ne = ne + 1;
                        }
                        let s1: u32 = skip_ht(body, ne, n);
                        if s1 + 6 <= n && eq(body, s1, "struct") == 1 {
                            let ob: u32 = skip_ht(body, s1 + 6, n);
                            if ob < n && load8(body, ob) == 123 {
                                // `^` 的位置是"行首"：0 或者紧跟一个换行之后的那一格。
                                // `ob + 1` **不是**行首（它前面是 `{`）——所以从 ob+1 起
                                // 找"前一个字节是换行"的位置，与 `(.*?)^[ \t]*\}` 同义。
                                let close: u32 = FAIL;
                                let q: u32 = ob + 1;
                                while q <= n {
                                    if q > 0 && load8(body, q - 1) == 10 {
                                        let z: u32 = skip_ht(body, q, n);
                                        if z < n && load8(body, z) == 125 {
                                            close = z;
                                            q = n + 1;
                                        }
                                    }
                                    if q <= n {
                                        q = q + 1;
                                    }
                                }
                                if close != FAIL {
                                    let _a: u32 = st32(r, J_OB, ob);
                                    let _b: u32 = st32(r, J_CE, close);
                                    let _c: u32 = st32(r, J_NO, ns);
                                    let _d: u32 = st32(r, J_NL, ne - ns);
                                    return 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `_GO_FN = ^[ \t]*func[ \t]+NAME[ \t]*\(([^)]*)\)[ \t]*([^{;\n]*?)[ \t]*\{`。
/// 命中写 `J_MS`（**行首**，上游 `m.start()` 就在那里）/`J_OB`（那个 `{`）/
/// `J_NO`,`J_NL`（名字）/`J_PS`,`J_PL`（形参表）/`J_RS`,`J_RL`（返回类型，可空）。
fn find_gofn(body: ptr, n: u32, from: u32, r: ptr) -> u32 {
    let i: u32 = from;
    while i < n {
        if i == 0 || load8(body, i - 1) == 10 {
            let j0: u32 = skip_ht(body, i, n);
            if j0 + 4 <= n && eq(body, j0, "func") == 1 {
                if j0 + 4 < n && is_ht(load8(body, j0 + 4)) == 1 {
                    let ns: u32 = skip_ht(body, j0 + 4, n);
                    if ns < n && is_id0(load8(body, ns)) == 1 {
                        let ne: u32 = ns + 1;
                        while ne < n && is_w(load8(body, ne)) == 1 {
                            ne = ne + 1;
                        }
                        let ps: u32 = skip_ht(body, ne, n);
                        if ps < n && load8(body, ps) == 40 {
                            let pe: u32 = ps + 1;
                            while pe < n && load8(body, pe) != 41 {
                                pe = pe + 1;
                            }
                            if pe < n {
                                // 返回类型那一段：`[ \t]*` 之后的**惰性**量词，不含
                                // `{` / `;` / 换行 —— 所以它必然与 `{` 同行。
                                let rs: u32 = skip_ht(body, pe + 1, n);
                                let rz: u32 = rs;
                                while rz < n && load8(body, rz) != 123
                                        && load8(body, rz) != 59 && load8(body, rz) != 10 {
                                    rz = rz + 1;
                                }
                                if rz < n && load8(body, rz) == 123 {
                                    let re2: u32 = trim_end(body, rs, rz);
                                    let _a: u32 = st32(r, J_MS, i);
                                    let _b: u32 = st32(r, J_OB, rz);
                                    let _c: u32 = st32(r, J_NO, ns);
                                    let _d: u32 = st32(r, J_NL, ne - ns);
                                    let _e: u32 = st32(r, J_PS, ps + 1);
                                    let _f: u32 = st32(r, J_PL, pe);
                                    let _g: u32 = st32(r, J_RS, rs);
                                    let _h: u32 = st32(r, J_RL, re2 - rs);
                                    return 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 一行按空白切成 token（Go 的结构体字段与形参都按这个切）。写进 `M_CMEM`
/// （第 k 个: 偏移在 `12k`、长度在 `12k+4`），返回条数（最多 16）。
fn go_toks(mem: ptr, p: ptr, a: u32, b: u32) -> u32 {
    let tbl: ptr = ptr_add(mem, M_CMEM);
    let cnt: u32 = 0;
    let i: u32 = a;
    while i < b {
        if is_sp(load8(p, i)) == 1 {
            i = i + 1;
        } else {
            let s0: u32 = i;
            while i < b && is_sp(load8(p, i)) == 0 {
                i = i + 1;
            }
            if cnt < 16 {
                let _a: u32 = st32(tbl, cnt * 12, s0);
                let _b: u32 = st32(tbl, cnt * 12 + 4, i - s0);
            }
            cnt = cnt + 1;
        }
    }
    return cnt;
}

/// 发一个 Go 形参。**"是不是第一个"记在 `M_SC + 32`** —— 分组写法要连着发好几个，
/// 那个状态得跨调用（与 C 那侧 `emit_params` 里那个 `first` 同一个意思，只是搬进了格子）。
fn go_param1(mem: ptr, out: ptr, o: u32, p: ptr, off: u32, l: u32, tl: u32) -> u32 {
    if ld32(ptr_add(mem, M_SC), 32) == 0 {
        o = jl(out, o, ", ");
    }
    let _f: u32 = st32(ptr_add(mem, M_SC), 32, 0);
    o = jl(out, o, "{\"name\": ");
    o = jq(out, o, p, off, l);
    o = jl(out, o, ", \"type\": ");
    o = jq(out, o, ptr_add(mem, M_TYPE), 0, tl);
    o = jl(out, o, "}");
    return o;
}

/// Go 的形参表是不是好的（`a, b int` 那种分组写法要**攒着**等类型）。返回 1 = 好。
/// **逐段判、不发射**。
fn goparams_ok(mem: ptr, p: ptr, a: u32, b: u32) -> u32 {
    let pend: ptr = ptr_add(mem, M_CMEM + 512);   // 攒着的名字: (off, len)
    let np: u32 = 0;
    let q: u32 = a;
    while q <= b {
        let seg: u32 = find_ch(p, q, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = skip_sp(p, q, se);
        let e2: u32 = trim_end(p, s2, se);
        if e2 > s2 {
            let nt: u32 = go_toks(mem, p, s2, e2);
            if nt == 1 {
                if is_ident(p, s2, e2 - s2) == 0 {
                    return 0;
                }
                if np < NMAX {
                    let _a: u32 = st32(pend, np * 12, s2);
                    let _b: u32 = st32(pend, np * 12 + 4, e2 - s2);
                }
                np = np + 1;
            } else {
                if nt != 2 {
                    return 0;
                }
                let tno: u32 = ld32(ptr_add(mem, M_CMEM), 0);
                let tnl: u32 = ld32(ptr_add(mem, M_CMEM), 4);
                if is_ident(p, tno, tnl) == 0 {
                    return 0;
                }
                let pso: u32 = ld32(ptr_add(mem, M_CMEM), 12);
                let psl: u32 = ld32(ptr_add(mem, M_CMEM), 16);
                if go_type(mem, p, pso, psl) == 0 {
                    return 0;
                }
                np = 0;
            }
        }
        if seg == FAIL {
            q = b + 1;
        } else {
            q = seg + 1;
        }
    }
    if np > 0 {
        return 0;                       // 只有名字、没等到类型 —— 报出来
    }
    return 1;
}

/// 逐条发 Go 的形参（分组写法在这儿展开：一个类型带前面攒下的那几个名字）。
fn goparams_emit(mem: ptr, out: ptr, o: u32, p: ptr, a: u32, b: u32) -> u32 {
    let pend: ptr = ptr_add(mem, M_CMEM + 512);
    let np: u32 = 0;
    let _f0: u32 = st32(ptr_add(mem, M_SC), 32, 1);   // "是不是第一个"（1 = 是）
    let q: u32 = a;
    while q <= b {
        let seg: u32 = find_ch(p, q, b, 44);
        let se: u32 = b;
        if seg != FAIL {
            se = seg;
        }
        let s2: u32 = skip_sp(p, q, se);
        let e2: u32 = trim_end(p, s2, se);
        if e2 > s2 {
            let nt: u32 = go_toks(mem, p, s2, e2);
            if nt == 1 {
                if np < NMAX {
                    let _a: u32 = st32(pend, np * 12, s2);
                    let _b: u32 = st32(pend, np * 12 + 4, e2 - s2);
                }
                np = np + 1;
            } else {
                if nt == 2 {
                    let tno: u32 = ld32(ptr_add(mem, M_CMEM), 0);
                    let tnl: u32 = ld32(ptr_add(mem, M_CMEM), 4);
                    let pso: u32 = ld32(ptr_add(mem, M_CMEM), 12);
                    let psl: u32 = ld32(ptr_add(mem, M_CMEM), 16);
                    let tl: u32 = go_type(mem, p, pso, psl);
                    // `for n in pending + [pn]` —— **攒着的**与**这一段自己的名字**一起发
                    // （漏掉后者的话，`func f(n int)` 这种最常见的写法一个形参都不发）
                    let k: u32 = 0;
                    while k < np {
                        o = go_param1(mem, out, o, p, ld32(pend, k * 12),
                                      ld32(pend, k * 12 + 4), tl);
                        k = k + 1;
                    }
                    o = go_param1(mem, out, o, p, tno, tnl, tl);
                    np = 0;
                }
            }
        }
        if seg == FAIL {
            q = b + 1;
        } else {
            q = seg + 1;
        }
    }
    return o;
}

/// `_go_type(" ".join(parts[1:]))` —— 从 `a` 到 `b` 的 token 用单个空格连起来再查表。
fn go_type_sp(mem: ptr, p: ptr, a: u32, b: u32) -> u32 {
    let d: ptr = ptr_add(mem, M_TXT);
    let o: u32 = 0;
    let i: u32 = a;
    let cnt: u32 = 0;
    while i < b {
        if is_sp(load8(p, i)) == 1 {
            i = i + 1;
        } else {
            let s0: u32 = i;
            while i < b && is_sp(load8(p, i)) == 0 {
                i = i + 1;
            }
            if cnt > 0 {
                store8(d, o, 32 as u8);
                o = o + 1;
            }
            let q: u32 = s0;
            while q < i {
                store8(d, o, load8(p, q) as u8);
                o = o + 1;
                q = q + 1;
            }
            cnt = cnt + 1;
        }
    }
    return go_type(mem, d, 0, o);
}

/// 一段 struct 体里有几个字段能进对象（逐行切；空行 / 单 token 行 / 名字不合法的都不算）。
fn go_fld_count(mem: ptr, a: u32, b: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let got: u32 = 0;
    let ls: u32 = a;
    while ls <= b {
        let le: u32 = ls;
        while le < b && load8(body, le) != 10 {
            le = le + 1;
        }
        let s2: u32 = skip_sp(body, ls, le);
        let e2: u32 = trim_end(body, s2, le);
        if e2 > s2 {
            let nt: u32 = go_toks(mem, body, s2, e2);
            if nt >= 2 {
                let fno: u32 = ld32(ptr_add(mem, M_CMEM), 0);
                let fnl: u32 = ld32(ptr_add(mem, M_CMEM), 4);
                if is_ident(body, fno, fnl) == 1 {
                    let ts: u32 = ld32(ptr_add(mem, M_CMEM), 12);
                    if go_type_sp(mem, body, ts, e2) != 0 {
                        got = got + 1;
                    }
                }
            }
        }
        ls = le + 1;
    }
    return got;
}

/// Go 的 `type X struct` 那一圈：把**有字段**的那些名字填进 `known`
/// （上游那一圈就在函数那一圈**之前**，所以先声明后引用是通的）。
fn go_struct_known(mem: ptr) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let r: ptr = ptr_add(mem, M_JS);
    let i: u32 = 0;
    while find_gostruct(body, n, i, r) == 1 {
        let ce: u32 = ld32(r, J_CE);
        i = ce + 1;
        if go_fld_count(mem, ld32(r, J_OB) + 1, ce) > 0 {
            let _k: u32 = known_add(mem, ptr_add(body, ld32(r, J_NO)), ld32(r, J_NL));
        }
    }
    return 0;
}

/// 函数 -> `functions`（`//export` 过的记 `abi: "c"` 且**不带正文**）。
fn go_emit_functions(mem: ptr, out: ptr, o: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let src: ptr = ptr_add(mem, M_SRC);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let srcn: u32 = ld32(ptr_add(mem, M_SC), 16);
    let r: ptr = ptr_add(mem, M_JS);
    let _rst: u32 = known_reset(mem);
    let _sk: u32 = go_struct_known(mem);
    let first: u32 = 1;
    let i: u32 = 0;
    while find_gofn(body, n, i, r) == 1 {
        let ms: u32 = ld32(r, J_MS);
        let ob: u32 = ld32(r, J_OB);
        let ns: u32 = ld32(r, J_NO);
        let nl: u32 = ld32(r, J_NL);
        i = ob + 1;
        let exported: u32 = go_exported(src, srcn, body, ns, nl);
        // 多返回值：Potato 是单返回
        let multi: u32 = 0;
        if ld32(r, J_RL) > 0 {
            if load8(body, ld32(r, J_RS)) == 40 {
                multi = 1;
            }
        }
        if multi == 0 {
            let rtl: u32 = go_type(mem, body, ld32(r, J_RS), ld32(r, J_RL));
            if rtl != 0 {
                let _sv: u32 = copy_n(ptr_add(mem, M_TXT), 0, ptr_add(mem, M_TYPE), 0, rtl);
                if goparams_ok(mem, body, ld32(r, J_PS), ld32(r, J_PL)) == 1 {
                    if first == 0 {
                        o = jl(out, o, ", ");
                    }
                    first = 0;
                    o = jl(out, o, "{\"name\": ");
                    o = jq(out, o, body, ns, nl);
                    o = jl(out, o, ", \"params\": [");
                    o = goparams_emit(mem, out, o, body, ld32(r, J_PS), ld32(r, J_PL));
                    o = jl(out, o, "], \"ret\": ");
                    o = jq(out, o, ptr_add(mem, M_TXT), 0, rtl);
                    if exported == 1 {
                        o = jl(out, o, ", \"abi\": \"c\"");
                    } else {
                        let close: u32 = block_end(body, ob, n);
                        if close != FAIL {
                            let lead: u32 = 0;
                            let q: u32 = ms;
                            while q < close + 1 && is_sp(load8(src, q)) == 1 {
                                lead = lead + 1;
                                q = q + 1;
                            }
                            let bs: u32 = ms + lead;
                            let be: u32 = trim_end(src, bs, close + 1);
                            if be > bs {
                                o = jl(out, o, ", \"body\": ");
                                o = jq(out, o, src, bs, be - bs);
                                o = jl(out, o, ", \"body_line\": ");
                                o = jint(out, o, 0, line_at_chars(src, srcn,
                                                                  chars_n(src, ms) + lead));
                            }
                        }
                    }
                    o = jl(out, o, "}");
                }
            }
        }
    }
    return o;
}

/// `type X struct` -> `types`（字段全映射不上的那些**整块丢掉**，与上游同）。
fn go_emit_types(mem: ptr, out: ptr, o: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let n: u32 = ld32(ptr_add(mem, M_SC), 0);
    let r: ptr = ptr_add(mem, M_JS);
    let _rst: u32 = known_reset(mem);
    let first: u32 = 1;
    let i: u32 = 0;
    while find_gostruct(body, n, i, r) == 1 {
        let ob: u32 = ld32(r, J_OB);
        let ce: u32 = ld32(r, J_CE);
        let cns: u32 = ld32(r, J_NO);
        let cnl: u32 = ld32(r, J_NL);
        i = ce + 1;
        if go_fld_count(mem, ob + 1, ce) > 0 {
            if first == 0 {
                o = jl(out, o, ", ");
            }
            first = 0;
            o = jl(out, o, "{\"name\": ");
            o = jq(out, o, body, cns, cnl);
            o = jl(out, o, ", \"fields\": [");
            let fst2: u32 = 1;
            let ls: u32 = ob + 1;
            while ls <= ce {
                let le: u32 = ls;
                while le < ce && load8(body, le) != 10 {
                    le = le + 1;
                }
                let s2: u32 = skip_sp(body, ls, le);
                let e2: u32 = trim_end(body, s2, le);
                if e2 > s2 {
                    let nt: u32 = go_toks(mem, body, s2, e2);
                    if nt >= 2 {
                        let fno: u32 = ld32(ptr_add(mem, M_CMEM), 0);
                        let fnl: u32 = ld32(ptr_add(mem, M_CMEM), 4);
                        if is_ident(body, fno, fnl) == 1 {
                            let ts: u32 = ld32(ptr_add(mem, M_CMEM), 12);
                            let tl: u32 = go_type_sp(mem, body, ts, e2);
                            if tl != 0 {
                                if fst2 == 0 {
                                    o = jl(out, o, ", ");
                                }
                                fst2 = 0;
                                o = jl(out, o, "{\"name\": ");
                                o = jq(out, o, body, fno, fnl);
                                o = jl(out, o, ", \"type\": ");
                                o = jq(out, o, ptr_add(mem, M_TYPE), 0, tl);
                                o = jl(out, o, "}");
                            }
                        }
                    }
                }
                ls = le + 1;
            }
            o = jl(out, o, "]}");
            let _ka: u32 = known_add(mem, ptr_add(body, cns), cnl);
        }
    }
    return o;
}

/// Go 那一门的主干（`from_go`）。抹注释**不保不住长度**：Go 没有 `#` 指令也没有
/// 那一层字面量替换，`blank_noise` 是等长的 —— 所以 `body` 与 `src` 的下标通用，
/// 而正文与行号都取**原文**（上游也是 `src[m.start():…]`）。
fn build_go(mem: ptr, srcn: u32, argp: ptr, al: u32) -> u32 {
    let src: ptr = ptr_add(mem, M_SRC);
    let body: ptr = ptr_add(mem, M_BODY);
    let _b: u32 = blank_noise(src, srcn, body, 0);
    let _n: u32 = st32(ptr_add(mem, M_SC), 0, srcn);
    let _sl: u32 = st32(ptr_add(mem, M_SC), 16, srcn);
    let _m: u32 = st32(ptr_add(mem, M_SC), 8, 5);
    let _c: u32 = st32(ptr_add(mem, M_CNST), 0, 0);
    let out: ptr = ptr_add(mem, M_OUT);
    let o1: u32 = jl(out, 0, "{\"potato\": \"v6\", \"unit\": ");
    let un: u32 = unit_name(mem, argp, al);
    let idb: ptr = ptr_add(mem, M_IDENT);
    let o2: u32 = jq(out, o1, idb, 0, un);
    let o3: u32 = jl(out, o2, ", \"language\": \"loment\", \"grammar\": \"go\"");
    let o4: u32 = jl(out, o3, ", \"imports\": [], \"capabilities\": [], \"functions\": [");
    let o5: u32 = go_emit_functions(mem, out, o4);
    let o6: u32 = jl(out, o5, "], \"layouts\": [], \"consts\": [], \"enums\": [], \"types\": [");
    let o7: u32 = go_emit_types(mem, out, o6);
    let o8: u32 = jl(out, o7, "], \"traits\": [], \"impls\": [], \"generics\": [], \"instances\": [], \"guards\": 0, \"excluded\": [], \"mode\": \"std\", \"switches\": [], \"dialects\": [], \"bodies\": []}");
    return o8;
}

// ---------------------------------------------------------------- 入口

fn build(mem: ptr, srcn: u32, argp: ptr, al: u32) -> u32 {
    let body: ptr = ptr_add(mem, M_BODY);
    let _b: u32 = blank_noise(ptr_add(mem, M_SRC), srcn, body, 1);
    let _n: u32 = st32(ptr_add(mem, M_SC), 0, srcn);
    let _c: u32 = st32(ptr_add(mem, M_CNST), 0, 0);
    let r: ptr = ptr_add(mem, M_R);
    // known: 先按出现顺序过一遍 struct（**增量**加，与上游同）
    let _rst: u32 = known_reset(mem);
    let i: u32 = 0;
    while find_struct(body, srcn, i, r) == 1 {
        i = ld32(r, R_ME);
        if count_added(mem, ld32(r, R_IS), ld32(r, R_IE)) > 0 {
            let _k: u32 = known_add(mem, ptr_add(body, ld32(r, R_NO)), ld32(r, R_NL));
        }
    }
    let out: ptr = ptr_add(mem, M_OUT);
    let o: u32 = 0;
    let o2: u32 = jl(out, 0, "{\"potato\": \"v6\", \"unit\": ");
    let un: u32 = unit_name(mem, argp, al);
    let idb: ptr = ptr_add(mem, M_IDENT);
    let o3: u32 = jq(out, o2, idb, 0, un);
    let o3b: u32 = jl(out, o3, ", \"language\": \"loment\", \"grammar\": ");
    let o3c: u32 = o3b;
    if ld32(ptr_add(mem, M_SC), 8) == 2 {
        o3c = jl(out, o3b, "\"cpp\"");
    } else {
        o3c = jl(out, o3b, "\"c\"");
    }
    let o4: u32 = jl(out, o3c, ", \"imports\": [], \"capabilities\": [], \"functions\": [");
    let o5: u32 = emit_functions(mem, out, o4);
    let o6: u32 = jl(out, o5, "], \"layouts\": [], \"consts\": [");
    let o7: u32 = emit_enum_kind(mem, out, o6, 0);
    let o8: u32 = jl(out, o7, "], \"enums\": [");
    let o9: u32 = emit_enum_kind(mem, out, o8, 1);
    let o10: u32 = jl(out, o9, "], \"types\": [");
    let _rst2: u32 = known_reset(mem);
    let o11: u32 = emit_types(mem, out, o10);
    let o12: u32 = jl(out, o11, "], \"traits\": [], \"impls\": [], \"generics\": [], \"instances\": [], \"guards\": 0, \"excluded\": [], \"mode\": \"std\", \"switches\": [], \"dialects\": [], \"bodies\": []}");
    return o12;
}

/// argv 第 k 项（从 0 数）的偏移；返回长度。
fn arg_at(buf: ptr, tot: u32, k: u32, outp: ptr) -> u32 {
    let i: u32 = 0;
    let idx: u32 = 0;
    let s: u32 = 0;
    let found: u32 = 0;
    let ln: u32 = 0;
    while i < tot {
        if load8(buf, i) == 0 {
            if idx == k && found == 0 {
                let _a: u32 = st32(outp, 0, s);
                ln = i - s;
                found = 1;
            }
            idx = idx + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return ln;
}

fn _start() -> u32 {
    let mv: u64 = sys_alloc(M_CAP as u64);
    if mv == 0 {
        return fail("lompotc: brk 失败\n");
    }
    let mem: ptr = mv as ptr;
    // argv[1]
    let fd: i64 = syscall4(257, (0 as u64) - 100, str_ptr("/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return fail("lompotc: 读不到 argv\n");
    }
    let cb: ptr = ptr_add(mem, M_ARG);
    let n: u64 = read_all(fd as u64, cb, 2048);
    syscall4(3, fd as u64, 0, 0);
    let tot: u32 = n as u32;
    let ap: ptr = ptr_add(mem, M_R + 64);
    let l1: u32 = arg_at(cb, tot, 1, ap);
    let o1: u32 = ld32(ap, 0);
    if l1 == 0 {
        return fail("lompotc: usage: lompotc [--cpp|--java|--csharp] <src>\n");
    }
    let mode: u32 = 1;
    let a1: ptr = ptr_add(cb, o1);
    if l1 == 8 && eq(a1, 0, "--csharp") == 1 {
        mode = 4;
        let lc: u32 = arg_at(cb, tot, 2, ap);
        let oc: u32 = ld32(ap, 0);
        if lc == 0 {
            return fail("lompotc: usage: lompotc [--cpp|--java|--csharp] <src>\n");
        }
        l1 = lc;
        o1 = oc;
        a1 = ptr_add(cb, oc);
    }
    if l1 == 4 && eq(a1, 0, "--go") == 1 {
        mode = 5;
        let lg: u32 = arg_at(cb, tot, 2, ap);
        let og: u32 = ld32(ap, 0);
        if lg == 0 {
            return fail("lompotc: usage: lompotc [--cpp|--java|--csharp|--go] <src>
");
        }
        l1 = lg;
        o1 = og;
        a1 = ptr_add(cb, og);
    }
    if l1 == 6 && eq(a1, 0, "--java") == 1 {
        mode = 3;
        let lj: u32 = arg_at(cb, tot, 2, ap);
        let oj: u32 = ld32(ap, 0);
        if lj == 0 {
            return fail("lompotc: usage: lompotc [--cpp|--java] <src>\n");
        }
        l1 = lj;
        o1 = oj;
        a1 = ptr_add(cb, oj);
    }
    if l1 == 5 && eq(a1, 0, "--cpp") == 1 {
        mode = 2;
        let l2: u32 = arg_at(cb, tot, 2, ap);
        let o2: u32 = ld32(ap, 0);
        if l2 == 0 {
            return fail("lompotc: usage: lompotc [--cpp|--java] <src>\n");
        }
        l1 = l2;
        o1 = o2;
        a1 = ptr_add(cb, o2);
    }
    let _md: u32 = st32(ptr_add(mem, M_SC), 8, mode);
    let pp: ptr = a1;
    store8(pp, l1, 0 as u8);
    let jf: i64 = syscall4(257, (0 as u64) - 100, pp as u64, 0);
    if jf < 0 {
        return fail("lompotc: 打不开源文件\n");
    }
    let srcn: u64 = read_all(jf as u64, ptr_add(mem, M_SRC), IN_CAP as u64);
    syscall4(3, jf as u64, 0, 0);
    let o: u32 = 0;
    if mode == 5 {
        o = build_go(mem, srcn as u32, pp, l1);
    } else if mode == 3 || mode == 4 {
        o = build_class(mem, srcn as u32, pp, l1, mode);
    } else {
        o = build(mem, srcn as u32, pp, l1);
    }
    let _w: u64 = write_all(1, ptr_add(mem, M_OUT), o as u64);
    return die(0);
}
