// loment/tools/lomlib.lomt — Loment 版库系统 (无 Python, docs/168)
//
// 判据 (tools/loment_lib_test.py::test_loment_lomlib_matches_python):
// 同一棵包树喂本程序 (链成 PE/ELF 后跑) 与 `lomlib.py id <dir>`, **stdout 逐字节相同 + 退出码相同**。
//
// 覆盖面 —— **与 Python 版不对称的部分写在最显眼处, 别把"孪生"读成"全等"**:
//   有: `id`   —— 实例身份 (判据 2 的递归哈希: H(名字 ⊕ 排序文件 ⊕ 排序边))
//       `tree` —— 实例树 (去重后): 每条边 `-> 名字 版本 [身份前 8 位]`, 重复的标
//                "同一实例, 已见", 末尾 `[OK] n 个实例` + 多版本那条 `[NOTE]`
//       `dbg`  —— 把折叠的分量 (名字/文件/边) 打出来, **只给调试用**, 不进判据
//   无: `cap` / `check` / `materialize`
//       (`check` 要按 token 判"引用了一个有多个来源的名字", `materialize` 要按 token
//       改写源码 —— 两件都是另一件事, 见 docs/168 §4.2。)
//
// 刻意偏离 (与 lompkg.lomt 同一路数, 见 docs/159 §4b 的记法):
//   1. Python 的 `Path.resolve()` 解析符号链接并绝对化; 本版只做词法拼接。无符号链接的树上等价。
//   2. Python 的 `use <名字>` 还会落到仓库内置的四个根; 本版**只认 `<包>/deps/<名字>/`** ——
//      孪生程序不知道自己在哪个仓库里跑。判据的场景只用 deps/。
//   3. 排序按**原始字节**; Python 的 `sorted(Path)` 在 Windows 上是大小写不敏感的排序。
//      判据的场景全小写, 两边一致。
//   4. 哈希读**原始字节**, 绝不 strip CR (树上是 LF, 但临时树里的 `.lomp` 可能是 CRLF)。
//   5. **指针算术一律用 `ptr_add(p, n)` 内建, 不写 `p + n`; 比较两侧宽度要对齐**
//      (用 `as u32` 而不是 `as u8`)。这两条不是风格: 自举镜在这两处与参考实现产出的 IR
//      **不一致** (2026-09-15 写本文件时被 p8 语料抓到, 见 docs/168 §5)。
//      本仓库其它工具一直用 `ptr_add`, 所以从没暴露过。

module lomlib

use bytes
use sha256

// ---------------------------------------------------------------- 尺寸
const MAXD: u32 = 16;          // 依赖深度上限 (Python 无上限, 这里给护栏)
const PATHW: u32 = 1024;       // 一个 NUL 结尾路径缓冲
const DIRQ: u32 = 32;          // 目录队列长度 (BFS)
const FMAX: u32 = 32;          // 单个包的 .lomt 文件数上限
const EMAX: u32 = 16;          // 单个包的依赖边数上限
const DIRBUF: u32 = 8192;      // getdents64 缓冲
const RBUF: u32 = 16384;       // 读文件缓冲 (哈希分块)
const FBUF: u32 = 16384;       // 读文件缓冲 (扫边用, 单独一块以免嵌套时打架)
const DEPTHSZ: u32 = 4608;     // 每层: sha 1024 + 目录 1024 + 信息 192 + 边 2176 + 余量

// ---------------------------------------------------------------- 内存布局
const M_QP: u32 = 0;                          // DIRQ * PATHW  队列: 绝对路径
const M_QR: u32 = 32768;        // DIRQ * PATHW  队列: 相对路径
const M_POOL: u32 = 65536;      // FMAX * 256    相对路径池
const M_IDX: u32 = 73728;       // FMAX * 8      文件索引 (off,len)
const M_DIRB: u32 = 73984;         // DIRBUF
const M_RBUF: u32 = 82176;          // RBUF
const M_FBUF: u32 = 98560;            // FBUF
const M_TMP: u32 = 114944;             // 8192 事务缓冲 (8 * PATHW)
// M_TMP 里的格子（8 个 PATHW）: *2 文件路径 / *3 清单路径 / *4 sha 的 NUL 垫 /
// *5 `note_multi` 的索引 / *6 `is_dir` 的 stat / *7 `wdec`+`wsp` 的十进制与缩进暂存。
// ⚠ **别在这儿用 `alloc`** —— 它是**只有 64 KiB 的 bump 堆**，本程序已经把 256 KiB 的
// 静态区都 brk 出来了；2026-09-19 实测：`tree` 的打印路上用 `alloc`，
// 输出全对、**函数返回时**才崩（ELF 上 rc=132 SIGILL，PE 上 0xC0000005）。
const M_DEP: u32 = 123136;              // MAXD * DEPTHSZ
const M_CELL: u32 = 196864;
const M_CB: u32 = 196928;   // 标量格
// `tree` 要的两张表（`id` 用不上 —— 它只算一次身份、不留图）:
//   M_SEEN  见过的身份 (去重表; 条数写 C_SEENN)  —— "同一实例, 已见" 与 `[OK] n 个实例`
//   M_CNT   实例名 -> 份数 (条数写 C_CNTN)       —— `[NOTE] 同名多实例`
// **从 201024 起** —— [M_CB, M_CB+4096) 是 **argv 缓冲**（`read_all(cb, 4096)`），
// 而 `dirp` 就指着里面那一段。2026-09-19 踩到：把 M_SEEN 摆回 M_CB（196928），
// 第一次 `seen_add` 就把命令行的头 64 字节盖掉 —— 身份随即全错、版本永远读不到。
const M_SEEN: u32 = 201024;
const M_CNT: u32 = 205120;
const M_CAP: u32 = 262144;

// 每层内偏移
const S_SHA: u32 = 0;
const S_DIR: u32 = 1024;
const S_INFO: u32 = 2048;      // name 128 + hex 64
const S_EDG: u32 = 2304;       // EMAX * 128 边名池
const S_EOFF: u32 = 4352;   // EMAX * 8

// 信息块内偏移
const I_NAME: u32 = 0;
const I_HEX: u32 = 128;
const I_NL: u32 = 192;
const I_EC: u32 = 196;

// 标量格
const C_FILES: u32 = 0;
const C_POOL: u32 = 4;
const C_QT: u32 = 8;
const C_TMPV: u32 = 12;
const C_SEENN: u32 = 24;     // 去重表里已登记的身份数
const C_CNTN: u32 = 28;      // 名册里的名字数

// `tree` 用的表
const NMAX: u32 = 64;        // 见过的实例数上限
const CNTSZ: u32 = 136;      // 名册一条: name 128 + nl 4 + cnt 4
const C_NL: u32 = 128;
const C_CNT: u32 = 132;
// 每层的空闲尾巴 (S_EOFF 结束于 4480, 每层 4608)。
// **别往 S_INFO 里塞** —— 它的 224..288 是 sha_final 的 64 字节摘要格，跨过尾巴伸进
// S_EDG 头 32 字节（2026-09-19 踩到：把版本放在 +200 正好被那份摘要盖掉，版本永远是空的）。
const S_DUP: u32 = 4480;     // EMAX 个字节: 这条边指向的是不是"已见的同一实例"
const S_VER: u32 = 4496;     // 96 字节: 版本标签（够长；不进 sha）
const S_VL: u32 = 4592;      // 版本长度
const S_LEC: u32 = 4596;     // 这层的边数（共用标量格会被子层踩掉，得存一份）

const S_IFDIR: u32 = 16384;
const NOTFOUND: u32 = 4294967295;

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return code as u32;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let n: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if n <= 0 {
            return off;
        }
        off = off + (n as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn fail(msg: str) -> u32 {
    let _a: u64 = write_all(2, str_ptr(msg), str_len(msg) as u64);
    return die(1);
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn wmem(fd: u64, p: ptr, n: u32) -> u64 {
    return write_all(fd, p, n as u64);
}

// ---------------------------------------------------------------- 小工具

fn slen(p: ptr) -> u32 {
    let i: u32 = 0;
    while load8(p, i) != 0 {
        i = i + 1;
    }
    return i;
}

fn cpy(dst: ptr, dof: u32, src: ptr, sof: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, dof + i, load8(src, sof + i) as u8);
        i = i + 1;
    }
    return n;
}

fn cpz(dst: ptr, src: ptr) -> u32 {
    let i: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        let c: u32 = load8(src, i);
        store8(dst, i, c as u8);
        if c == 0 {
            going = 0;
        } else {
            i = i + 1;
        }
    }
    return i;
}

/// 把 str 字面量写进 dst 并补 NUL。
fn litp(dst: ptr, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, str_byte(s, i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return n;
}

fn beq(a: ptr, ao: u32, al: u32, b: ptr, bo: u32, bl: u32) -> u32 {
    if al != bl {
        return 0;
    }
    let i: u32 = 0;
    let ok: u32 = 1;
    while i < al {
        if load8(a, ao + i) != load8(b, bo + i) {
            ok = 0;
        }
        i = i + 1;
    }
    return ok;
}

/// a < b (逐字节)。与 Python 的 sorted 在同名场景下等价。
fn blt(a: ptr, ao: u32, al: u32, b: ptr, bo: u32, bl: u32) -> u32 {
    let m: u32 = al;
    if bl < m {
        m = bl;
    }
    let i: u32 = 0;
    let r: u32 = 2;
    while i < m && r == 2 {
        let x: u32 = load8(a, ao + i);
        let y: u32 = load8(b, bo + i);
        if x < y {
            r = 1;
        } else {
            if x > y {
                r = 0;
            }
        }
        i = i + 1;
    }
    if r == 2 {
        if al < bl {
            return 1;
        }
        return 0;
    }
    return r;
}

fn ends_with(p: ptr, n: u32, s: str) -> u32 {
    let k: u32 = str_len(s);
    if n < k {
        return 0;
    }
    let i: u32 = 0;
    let ok: u32 = 1;
    while i < k {
        if load8(p, n - k + i) != (str_byte(s, i) as u32) {
            ok = 0;
        }
        i = i + 1;
    }
    return ok;
}

// ---------------------------------------------------------------- 文件系统

fn open_ro(p: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, p as u64, 0);
}

fn close_fd(fd: i64) -> i64 {
    return syscall4(3, fd as u64, 0, 0);
}

fn stat_mode(p: ptr, stb: ptr) -> u32 {
    let r: i64 = syscall4(262, (0 as u64) - 100, p as u64, stb as u64);
    if r < 0 {
        return NOTFOUND;
    }
    return load32(stb, 24) & 61440;
}

fn is_dir(p: ptr, stb: ptr) -> u32 {
    if stat_mode(p, stb) == S_IFDIR {
        return 1;
    }
    return 0;
}

/// `<dir>` + "/" + `<name>` -> dst (NUL 结尾)。
fn join(dst: ptr, dirp: ptr, namep: ptr, nl: u32) -> u32 {
    let dl: u32 = slen(dirp);
    let a: u32 = cpy(dst, 0, dirp, 0, dl);
    if a > 0 && load8(dst, a - 1) != 47 && load8(dst, a - 1) != 92 {
        store8(dst, a, 47 as u8);
        a = a + 1;
    }
    cpy(dst, a, namep, 0, nl);
    store8(dst, a + nl, 0 as u8);
    return a + nl;
}

// ---------------------------------------------------------------- 目录遍历
// 收集**本包自己的** `*.lomt` 相对路径: 递归, 但排除任何 `deps` 段 —— 依赖不是本包源码。

fn is_deps_name(namep: ptr, nl: u32) -> u32 {
    if nl == 4 && load8(namep, 0) == 100 && load8(namep, 1) == 101
            && load8(namep, 2) == 112 && load8(namep, 3) == 115 {
        return 1;
    }
    return 0;
}

fn take_entry(mem: ptr, dpath: ptr, drel: ptr, drl: u32, namep: ptr, nl: u32, dtype: u32) {
    let go: u32 = 1;
    if is_deps_name(namep, nl) == 1 {
        go = 0;
    }
    if go == 1 {
    let tmp: ptr = ptr_add(mem, M_TMP);
    let a: u32 = cpz(tmp, dpath);
    if a > 0 && load8(tmp, a - 1) != 47 {
        store8(tmp, a, 47 as u8);
        a = a + 1;
    }
    cpy(tmp, a, namep, 0, nl);
    store8(tmp, a + nl, 0 as u8);
    let isd: u32 = 0;
    if dtype == 4 {
        isd = 1;
    }
    if dtype == 8 {
        isd = 0;
    }
    if dtype != 4 && dtype != 8 {
        if stat_mode(tmp, ptr_add(mem, M_TMP + PATHW)) == S_IFDIR {
            isd = 1;
        }
    }
    if isd == 1 {
        let t: u32 = load32(mem, M_CELL + C_QT);
        if t < DIRQ {
            cpy(ptr_add(mem, M_QP + t * PATHW), 0, tmp, 0, a + nl + 1);
            let cr: ptr = ptr_add(mem, M_QR + t * PATHW);
            let c: u32 = drl;
            if drl > 0 {
                cpy(cr, 0, drel, 0, drl);
                store8(cr, drl, 47 as u8);
                c = drl + 1;
            }
            cpy(cr, c, namep, 0, nl);
            store8(cr, c + nl, 0 as u8);
            store32(mem, M_CELL + C_QT, t + 1);
        }
    } else {
        if ends_with(namep, nl, ".lomt") == 1 {
            let fi: u32 = load32(mem, M_CELL + C_FILES);
            let po: u32 = load32(mem, M_CELL + C_POOL);
            if fi < FMAX && po + drl + nl + 1 < FMAX * 256 {
                let cr2: ptr = ptr_add(mem, M_POOL + po);
                let c2: u32 = 0;
                if drl > 0 {
                    cpy(cr2, 0, drel, 0, drl);
                    store8(cr2, drl, 47 as u8);
                    c2 = drl + 1;
                }
                cpy(cr2, c2, namep, 0, nl);
                let rl: u32 = c2 + nl;
                store32(ptr_add(mem, M_IDX), fi * 8, po);
                store32(ptr_add(mem, M_IDX), fi * 8 + 4, rl);
                store32(mem, M_CELL + C_FILES, fi + 1);
                store32(mem, M_CELL + C_POOL, po + rl);
            }
        }
    }
}
}


/// BFS: root 下本包自己的 .lomt 相对路径 -> (M_POOL, M_IDX); 条数写 C_FILES。
fn walk_own(mem: ptr, root: ptr) {
    store32(mem, M_CELL + C_FILES, 0);
    store32(mem, M_CELL + C_POOL, 0);
    store32(mem, M_CELL + C_QT, 0);
    cpz(ptr_add(mem, M_QP), root);
    store8(mem, M_QR, 0 as u8);
    store32(mem, M_CELL + C_QT, 1);
    let head: u32 = 0;
    while head < load32(mem, M_CELL + C_QT) {
        let dpath: ptr = ptr_add(mem, M_QP + head * PATHW);
        let drel: ptr = ptr_add(mem, M_QR + head * PATHW);
        let drl: u32 = slen(drel);
        let fd: i64 = open_ro(dpath);
        if fd >= 0 {
            let going: u32 = 1;
            while going == 1 {
                let rn: i64 = syscall4(217, fd as u64,
                                       ptr_add(mem, M_DIRB) as u64, DIRBUF as u64);
                if rn <= 0 {
                    going = 0;
                } else {
                    let total: u32 = rn as u32;
                    let off: u32 = 0;
                    while off < total {
                        let reclen: u32 = load16(ptr_add(mem, M_DIRB), off + 16);
                        if reclen == 0 {
                            off = total;
                        } else {
                            let dtype: u32 = load8(ptr_add(mem, M_DIRB), off + 18);
                            let namep: ptr = ptr_add(ptr_add(mem, M_DIRB), off + 19);
                            let nl: u32 = slen(namep);
                            let skip: u32 = 0;
                            if nl == 1 && load8(namep, 0) == 46 {
                                skip = 1;
                            }
                            if nl == 2 && load8(namep, 0) == 46 && load8(namep, 1) == 46 {
                                skip = 1;
                            }
                            if skip == 0 {
                                take_entry(mem, dpath, drel, drl, namep, nl, dtype);
                            }
                            off = off + reclen;
                        }
                    }
                }
            }
            close_fd(fd);
        }
        head = head + 1;
    }
}

/// 按相对路径排序 (插入排序; 反正最后都要排)。
fn sort_files(mem: ptr) {
    let n: u32 = load32(mem, M_CELL + C_FILES);
    let idx: ptr = ptr_add(mem, M_IDX);
    let pool: ptr = ptr_add(mem, M_POOL);
    let i: u32 = 1;
    while i < n {
        let oi: u32 = load32(idx, i * 8);
        let li: u32 = load32(idx, i * 8 + 4);
        let j: u32 = i;
        let going: u32 = 1;
        while j > 0 && going == 1 {
            let oj: u32 = load32(idx, (j - 1) * 8);
            let lj: u32 = load32(idx, (j - 1) * 8 + 4);
            if blt(pool, oi, li, pool, oj, lj) == 1 {
                store32(idx, j * 8, oj);
                store32(idx, j * 8 + 4, lj);
                j = j - 1;
            } else {
                going = 0;
            }
        }
        store32(idx, j * 8, oi);
        store32(idx, j * 8 + 4, li);
        i = i + 1;
    }
}

// ---------------------------------------------------------------- 清单 (.lomp)
// `pub fn name() -> str { return "x"; }` —— 找 `fn <key>` 之后最近的那个字符串字面量。
// Python 侧认"函数体里第一条字面量 return"; 键名不会出现在别处, 所以这个口径等价。

fn scan_label(path: ptr, key: str, out: ptr, buf: ptr) -> u32 {
    let fd: i64 = open_ro(path);
    if fd < 0 {
        return 0;
    }
    let n: u64 = read_all(fd as u64, buf, 8192);
    close_fd(fd);
    let tot: u32 = n as u32;
    let kn: u32 = str_len(key);
    let i: u32 = 0;
    while i + 4 + kn < tot {
        if load8(buf, i) == 102 && load8(buf, i + 1) == 110 && load8(buf, i + 2) == 32 {
            let ok: u32 = 1;
            let j: u32 = 0;
            while j < kn {
                if load8(buf, i + 3 + j) != (str_byte(key, j) as u32) {
                    ok = 0;
                }
                j = j + 1;
            }
            if ok == 1 {
                let k: u32 = i + 3 + kn;
                while k < tot && load8(buf, k) != 34 {
                    k = k + 1;
                }
                if k < tot {
                    let q: u32 = k + 1;
                    let d: u32 = 0;
                    while q < tot && load8(buf, q) != 34 {
                        store8(out, d, load8(buf, q) as u8);
                        d = d + 1;
                        q = q + 1;
                    }
                    store8(out, d, 0 as u8);
                    return d;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 包根目录里第一个 `*.lomp` (Python: sorted(dir.glob("*.lomp"))[0]); 返回是否存在。
fn find_lomp(mem: ptr, dirp: ptr, out: ptr) -> u32 {
    let fd: i64 = open_ro(dirp);
    if fd < 0 {
        return 0;
    }
    let found: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        let rn: i64 = syscall4(217, fd as u64, ptr_add(mem, M_DIRB) as u64, DIRBUF as u64);
        if rn <= 0 {
            going = 0;
        } else {
            let total: u32 = rn as u32;
            let off: u32 = 0;
            while off < total {
                let reclen: u32 = load16(ptr_add(mem, M_DIRB), off + 16);
                if reclen == 0 {
                    off = total;
                } else {
                    let namep: ptr = ptr_add(ptr_add(mem, M_DIRB), off + 19);
                    let nl: u32 = slen(namep);
                    if found == 0 && ends_with(namep, nl, ".lomp") == 1 {
                        let _j: u32 = join(out, dirp, namep, nl);
                        found = 1;
                    }
                    off = off + reclen;
                }
            }
        }
    }
    close_fd(fd);
    return found;
}

// ---------------------------------------------------------------- 边 (`use <名字>`)
// 只认**名字形式**: 行首(可带空白) `use` + 空白 + 标识符 (不是 `"`)。路径形式是包内引用,
// 不是依赖边 —— 与 Python 的 name_imports 口径一致。

fn edge_add(mem: ptr, ed: ptr, eo: ptr, p: ptr, n: u32) {
    let ec: u32 = load32(mem, M_CELL + C_TMPV + 4);
    let dup: u32 = 0;
    let i: u32 = 0;
    while i < ec {
        let oo: u32 = load32(eo, i * 8);
        let ol: u32 = load32(eo, i * 8 + 4);
        if beq(ed, oo, ol, p, 0, n) == 1 {
            dup = 1;
        }
        i = i + 1;
    }
    if dup == 0 && ec < EMAX {
    let poff: u32 = load32(mem, M_CELL + C_TMPV + 8);
    cpy(ed, poff, p, 0, n);
    store32(eo, ec * 8, poff);
    store32(eo, ec * 8 + 4, n);
    store32(mem, M_CELL + C_TMPV + 4, ec + 1);
    store32(mem, M_CELL + C_TMPV + 8, poff + n);
}

}

fn scan_edges(mem: ptr, buf: ptr, tot: u32, ed: ptr, eo: ptr) {
    let i: u32 = 0;
    while i < tot {
        let s: u32 = i;
        while s < tot && (load8(buf, s) == 32 || load8(buf, s) == 9) {
            s = s + 1;
        }
        let e: u32 = s;
        while e < tot && load8(buf, e) != 10 {
            e = e + 1;
        }
        // 门槛是 `e > s + 4`（"use " 四个字符之后**至少还要有一个**）—— 2026-09-19 写成
        // `e > s + 5` 时，`use b` 这种**单字符依赖名**正好 5 个字符，整条被静默丢掉：
        // 环、菱形、多版本这些夹具用的是两字符以上的名字，所以一直没暴露；判据新加的
        // 环夹具（`a` use `b`）当场抓住（`docs/189` 第 14 格）。
        if e > s + 4 && load8(buf, s) == 117 && load8(buf, s + 1) == 115
                && load8(buf, s + 2) == 101
                && (load8(buf, s + 3) == 32 || load8(buf, s + 3) == 9) {
            let k: u32 = s + 4;
            while k < e && (load8(buf, k) == 32 || load8(buf, k) == 9) {
                k = k + 1;
            }
            if k < e && load8(buf, k) != 34 {
                let q: u32 = k;
                while q < e && load8(buf, q) != 32 && load8(buf, q) != 9 && load8(buf, q) != 13 {
                    q = q + 1;
                }
                if q > k {
                    edge_add(mem, ed, eo, ptr_add(buf, k), q - k);
                }
            }
        }
        i = e + 1;
    }
}

// ---------------------------------------------------------------- 身份 (递归)

/// 收集 `<dir>` 的边 (去重, 顺序即出现顺序; 后面按名字排序)。
fn collect_edges(mem: ptr, dirp: ptr, ed: ptr, eo: ptr) {
    store32(mem, M_CELL + C_TMPV + 4, 0);
    store32(mem, M_CELL + C_TMPV + 8, 0);
    walk_own(mem, dirp);
    let fc: u32 = load32(mem, M_CELL + C_FILES);
    let i: u32 = 0;
    while i < fc {
        let po: u32 = load32(ptr_add(mem, M_IDX), i * 8);
        let rl: u32 = load32(ptr_add(mem, M_IDX), i * 8 + 4);
        let fp: ptr = ptr_add(mem, M_TMP + PATHW * 2);
        let _j: u32 = join(fp, dirp, ptr_add(mem, M_POOL + po), rl);
        let fd: i64 = open_ro(fp);
        if fd >= 0 {
            let n: u64 = read_all(fd as u64, ptr_add(mem, M_FBUF), FBUF as u64);
            close_fd(fd);
            scan_edges(mem, ptr_add(mem, M_FBUF), n as u32, ed, eo);
        }
        i = i + 1;
    }
}

/// 判断名字是否已在祖先栈里 (环)。
fn on_stack(mem: ptr, namep: ptr, nl: u32, depth: u32) -> u32 {
    let d: u32 = 0;
    while d < depth {
        let inf: ptr = ptr_add(mem, M_DEP + d * DEPTHSZ + S_INFO);
        let ol: u32 = load32(inf, I_NL);
        if beq(inf, I_NAME, ol, namep, 0, nl) == 1 {
            return 1;
        }
        d = d + 1;
    }
    return 0;
}

/// 递归算身份。返回 0 = OK; 3 = 太深; 4 = 有环; 5 = 依赖不存在。
fn ident_of(mem: ptr, dirp: ptr, depth: u32) -> u32 {
    if depth >= MAXD {
        return 3;
    }
    let base: u32 = M_DEP + depth * DEPTHSZ;
    let inf: ptr = ptr_add(mem, base + S_INFO);
    let _d: u32 = cpz(ptr_add(mem, base + S_DIR), dirp);
    // 名字: 清单优先, 否则用目录名
    let lp: ptr = ptr_add(mem, M_TMP + PATHW * 3);
    let nl: u32 = 0;
    let hasm: u32 = find_lomp(mem, dirp, lp);
    if hasm == 1 {
        nl = scan_label(lp, "name", inf, ptr_add(mem, M_FBUF));
    }
    if nl == 0 {
        let dl: u32 = slen(dirp);
        let b: u32 = 0;
        let i: u32 = 0;
        while i < dl {
            let ch: u32 = load8(dirp, i);
            if ch == 47 || ch == 92 {
                b = i + 1;
            }
            i = i + 1;
        }
        let m: u32 = dl - b;
        cpy(inf, I_NAME, dirp, b, m);
        store8(inf, I_NAME + m, 0 as u8);
        store32(inf, I_NL, m);
    } else {
        store32(inf, I_NL, nl);
    }
    // 版本: 清单里的 `fn version` 说了算, 没有就 `0.0.0`（与 Python 的 `_read_manifest` 同）。
    // **不进 sha** —— 版本是标签, 不是身份的一部分（`docs/168` 判据 2）。
    let vl: u32 = 0;
    if hasm == 1 {
        vl = scan_label(lp, "version", ptr_add(mem, base + S_VER), ptr_add(mem, M_FBUF));
    }
    if vl == 0 {
        store8(mem, base + S_VER, 48 as u8);
        store8(mem, base + S_VER + 1, 46 as u8);
        store8(mem, base + S_VER + 2, 48 as u8);
        store8(mem, base + S_VER + 3, 46 as u8);
        store8(mem, base + S_VER + 4, 48 as u8);
        vl = 5;
    }
    store32(mem, base + S_VL, vl);
    if on_stack(mem, inf, load32(inf, I_NL), depth) == 1 {
        return 4;
    }
    // 自身部分: 名字 ⊕ 排序后的文件
    let ed: ptr = ptr_add(mem, base + S_EDG);
    let eo: ptr = ptr_add(mem, base + S_EOFF);
    collect_edges(mem, dirp, ed, eo);
    // 边数留一份: 那个共用格会被**子层**的 collect_edges 踩掉，而 `tree` 打完这一层
    // 还要回来读它（2026-09-19 踩到：回调后读到的是最后一个叶子层的 0，边一条都不打）。
    store32(mem, base + S_LEC, load32(mem, M_CELL + C_TMPV + 4));
    sort_files(mem);
    let s: ptr = ptr_add(mem, base + S_SHA);
    sha_init(s);
    sha_update(s, inf, load32(inf, I_NL));
    let zb: ptr = ptr_add(mem, M_TMP + PATHW * 4);
    store8(zb, 0, 0 as u8);
    sha_update(s, zb, 1);
    let fc: u32 = load32(mem, M_CELL + C_FILES);
    let i2: u32 = 0;
    while i2 < fc {
        let po: u32 = load32(ptr_add(mem, M_IDX), i2 * 8);
        let rl: u32 = load32(ptr_add(mem, M_IDX), i2 * 8 + 4);
        // 相对路径 ⊕ NUL ⊕ 原始字节 ⊕ NUL
        sha_update(s, ptr_add(mem, M_POOL + po), rl);
        sha_update(s, zb, 1);
        let fp: ptr = ptr_add(mem, M_TMP + PATHW * 2);
        let _j: u32 = join(fp, dirp, ptr_add(mem, M_POOL + po), rl);
        let fd: i64 = open_ro(fp);
        if fd >= 0 {
            let going: u32 = 1;
            while going == 1 {
                let n: i64 = syscall4(0, fd as u64,
                                      ptr_add(mem, M_RBUF) as u64, RBUF as u64);
                if n <= 0 {
                    going = 0;
                } else {
                    sha_update(s, ptr_add(mem, M_RBUF), n as u32);
                }
            }
            close_fd(fd);
        }
        sha_update(s, zb, 1);
        i2 = i2 + 1;
    }
    // 边 (按名字排序), 每条递归算子身份
    let ec: u32 = load32(mem, M_CELL + C_TMPV + 4);
    let ei: u32 = 1;
    while ei < ec {
        let oi: u32 = load32(eo, ei * 8);
        let li: u32 = load32(eo, ei * 8 + 4);
        let j2: u32 = ei;
        let going: u32 = 1;
        while j2 > 0 && going == 1 {
            let oj: u32 = load32(eo, (j2 - 1) * 8);
            let lj: u32 = load32(eo, (j2 - 1) * 8 + 4);
            if blt(ed, oi, li, ed, oj, lj) == 1 {
                store32(eo, j2 * 8, oj);
                store32(eo, j2 * 8 + 4, lj);
                j2 = j2 - 1;
            } else {
                going = 0;
            }
        }
        store32(eo, j2 * 8, oi);
        store32(eo, j2 * 8 + 4, li);
        ei = ei + 1;
    }
    let e: u32 = 0;
    while e < ec {
        let eo2: u32 = load32(eo, e * 8);
        let el: u32 = load32(eo, e * 8 + 4);
        // <dir>/deps/<名字> —— 写进**子层自己的**目录缓冲。
        // 不能用 M_TMP 的共用格: 父层还要用 dirp 继续下一条边, 而子层会把它踩掉
        // (2026-09-15 实测: 一个孩子没事, 两个孩子时第二个拿到垃圾路径)。
        let cdir: ptr = ptr_add(mem, M_DEP + (depth + 1) * DEPTHSZ + S_DIR);
        let _a: u32 = cpz(cdir, dirp);
        let _b: u32 = join(cdir, dirp, str_ptr("deps"), 4);
        let cl: u32 = slen(cdir);
        store8(cdir, cl, 47 as u8);
        cpy(cdir, cl + 1, ptr_add(ed, eo2), 0, el);
        store8(cdir, cl + 1 + el, 0 as u8);
        if is_dir(cdir, ptr_add(mem, M_TMP + PATHW * 6)) == 0 {
            return 5;
        }
        let rc: u32 = ident_of(mem, cdir, depth + 1);
        if rc != 0 {
            return rc;
        }
        let chex: ptr = ptr_add(mem, M_DEP + (depth + 1) * DEPTHSZ + S_INFO + I_HEX);
        sha_update(s, ptr_add(ed, eo2), el);
        sha_update(s, zb, 1);
        sha_update(s, chex, 64);
        sha_update(s, zb, 1);
        e = e + 1;
    }
    let dig: ptr = ptr_add(mem, base + S_INFO + 224);   // 每层独立, 绝不与 sha 状态重叠
    sha_final(s, dig);
    hex_dig(dig, ptr_add(mem, base + S_INFO + I_HEX));
    return 0;
}

// ---------------------------------------------------------------- 实例树（tree）

/// 十进制（`tree` 的 `[OK] n 个实例` 与 `[NOTE] name xN` 要它）。
fn wdec(mem: ptr, fd: u64, v: u32) -> u64 {
    let b: ptr = ptr_add(mem, M_TMP + PATHW * 7);
    if v == 0 {
        store8(b, 0, 48 as u8);
        return write_all(fd, b, 1);
    }
    let n: u32 = 0;
    let x: u32 = v;
    while x > 0 {
        store8(b, 15 - n, (48 + (x % 10)) as u8);
        n = n + 1;
        x = x / 10;
    }
    return write_all(fd, ptr_add(b, 16 - n), n as u64);
}

/// 打 n 个空格（缩进）。
fn wsp(mem: ptr, n: u32) -> u64 {
    let b: ptr = ptr_add(mem, M_TMP + PATHW * 7);
    let i: u32 = 0;
    while i < n && i < 64 {
        store8(b, i, 32 as u8);
        i = i + 1;
    }
    return write_all(1, b, i as u64);
}

/// 这一层的版本号。
fn wver(mem: ptr, lvl: u32) -> u64 {
    let base: u32 = M_DEP + lvl * DEPTHSZ;
    return wmem(1, ptr_add(mem, base + S_VER), load32(mem, base + S_VL));
}

/// 见过这个身份吗 —— 见过返回 1；没见过就登记下来返回 0。
/// 这张表就是 `[OK] n 个实例` 的 n（去重后的实例数），也是"同一实例, 已见"的判据。
fn seen_add(mem: ptr, hex: ptr) -> u32 {
    let n: u32 = load32(mem, M_CELL + C_SEENN);
    let i: u32 = 0;
    while i < n {
        if beq(ptr_add(mem, M_SEEN), i * 64, 64, hex, 0, 64) == 1 {
            return 1;
        }
        i = i + 1;
    }
    if n < NMAX {
        cpy(ptr_add(mem, M_SEEN), n * 64, hex, 0, 64);
        store32(mem, M_CELL + C_SEENN, n + 1);
    }
    return 0;
}

/// 名册里找这个名字；返回下标，没有返回 FAIL。
fn cnt_find(mem: ptr, namep: ptr, nl: u32) -> u32 {
    let n: u32 = load32(mem, M_CELL + C_CNTN);
    let i: u32 = 0;
    while i < n {
        if load32(ptr_add(mem, M_CNT), i * CNTSZ + C_NL) == nl
                && beq(ptr_add(mem, M_CNT), i * CNTSZ, nl, namep, 0, nl) == 1 {
            return i;
        }
        i = i + 1;
    }
    return NOTFOUND;
}

/// 记一份实例名（多版本时同一个名字会 >1）。
fn cnt_bump(mem: ptr, namep: ptr, nl: u32) {
    let i: u32 = cnt_find(mem, namep, nl);
    if i == NOTFOUND {
        let n: u32 = load32(mem, M_CELL + C_CNTN);
        if n < NMAX {
            cpy(ptr_add(mem, M_CNT), n * CNTSZ, namep, 0, nl);
            store32(ptr_add(mem, M_CNT), n * CNTSZ + C_NL, nl);
            store32(ptr_add(mem, M_CNT), n * CNTSZ + C_CNT, 1);
            store32(mem, M_CELL + C_CNTN, n + 1);
        }
    } else {
        let c: u32 = load32(ptr_add(mem, M_CNT), i * CNTSZ + C_CNT);
        store32(ptr_add(mem, M_CNT), i * CNTSZ + C_CNT, c + 1);
    }
}

/// 第 `e` 条边指向的孩子目录，拼进**第 `lvl+1` 层自己那一格**。
/// 与 `ident_of` 里那段是同一份 —— 这里之所以单独成函数，是因为第二趟展开时
/// 那一格已经被上一条边踩掉了，**得能重算**。
fn child_dir(mem: ptr, ed: ptr, eo: ptr, e: u32, dirp: ptr, lvl: u32) -> ptr {
    let eo2: u32 = load32(eo, e * 8);
    let el: u32 = load32(eo, e * 8 + 4);
    let cdir: ptr = ptr_add(mem, M_DEP + (lvl + 1) * DEPTHSZ + S_DIR);
    let _a: u32 = cpz(cdir, dirp);
    let _b: u32 = join(cdir, dirp, str_ptr("deps"), 4);
    let cl: u32 = slen(cdir);
    store8(cdir, cl, 47 as u8);
    cpy(cdir, cl + 1, ptr_add(ed, eo2), 0, el);
    store8(cdir, cl + 1 + el, 0 as u8);
    return cdir;
}

/// 递归打一棵实例树。返回 0 = OK; 3/4/5 同 `ident_of`。
///
/// 形状与 Python 的 `_tree_lines` **逐字同**：一条边一行，**打完这一行就展开它**，
/// 再打下一行 —— 不是"先把边列全再逐条展开"（2026-09-19 按后一种写，输出顺序整段错位）。
fn tree_walk(mem: ptr, dirp: ptr, lvl: u32, pfx: u32) -> u32 {
    let rc: u32 = ident_of(mem, dirp, lvl);
    if rc != 0 {
        return rc;
    }
    let base: u32 = M_DEP + lvl * DEPTHSZ;
    let inf: ptr = ptr_add(mem, base + S_INFO);
    let nml: u32 = load32(inf, I_NL);
    // **只有根**打自己的那一行: 子节点只出现在父亲的边行里（与 Python 的 `_tree_lines` 同）
    if lvl == 0 {
        let _s0: u64 = wsp(mem, pfx);
        let _s1: u64 = wmem(1, inf, nml);
        let _s2: u64 = wstr(1, " ");
        let _s3: u64 = wver(mem, lvl);
        let _s4: u64 = wstr(1, " [");
        let _s5: u64 = wmem(1, ptr_add(inf, I_HEX), 8);
        let _s6: u64 = wstr(1, "]\n");
        // Python: `seen = {r.ident}` —— 根在走孩子**之前**就登记了
        let _me: u32 = seen_add(mem, ptr_add(inf, I_HEX));
    }
    cnt_bump(mem, inf, nml);
    let ed: ptr = ptr_add(mem, base + S_EDG);
    let eo: ptr = ptr_add(mem, base + S_EOFF);
    let ec: u32 = load32(mem, base + S_LEC);
    let e: u32 = 0;
    while e < ec {
        let cdir: ptr = child_dir(mem, ed, eo, e, dirp, lvl);
        let rc2: u32 = ident_of(mem, cdir, lvl + 1);
        if rc2 != 0 {
            return rc2;
        }
        let cinf: ptr = ptr_add(mem, M_DEP + (lvl + 1) * DEPTHSZ + S_INFO);
        let dup: u32 = seen_add(mem, ptr_add(cinf, I_HEX));
        let eo2: u32 = load32(eo, e * 8);
        let el: u32 = load32(eo, e * 8 + 4);
        let _a: u64 = wsp(mem, pfx + 2);
        let _b: u64 = wmem(1, ptr_add(ed, eo2), el);
        let _c: u64 = wstr(1, " -> ");
        let _d: u64 = wmem(1, cinf, load32(cinf, I_NL));
        let _f: u64 = wstr(1, " ");
        let _g: u64 = wver(mem, lvl + 1);
        let _h: u64 = wstr(1, " [");
        let _i: u64 = wmem(1, ptr_add(cinf, I_HEX), 8);
        let _j: u64 = wstr(1, "]");
        if dup == 1 {
            let _m: u64 = wstr(1, "  (同一实例, 已见)");
        }
        let _k: u64 = wstr(1, "\n");
        e = e + 1;
        if dup == 0 {
            let rc3: u32 = tree_walk(mem, cdir, lvl + 1, pfx + 2);
            if rc3 != 0 {
                return rc3;
            }
        }
    }
    return 0;
}

/// `[NOTE] 同名多实例: a x2, b x3`（按名字排序 —— 与 Python 的 `sorted(multi.items())` 同）。
fn note_multi(mem: ptr) -> u32 {
    let cn: u32 = load32(mem, M_CELL + C_CNTN);
    let idx: ptr = ptr_add(mem, M_TMP + PATHW * 5);
    let m: u32 = 0;
    let i: u32 = 0;
    while i < cn {
        if load32(ptr_add(mem, M_CNT), i * CNTSZ + C_CNT) > 1 {
            store32(idx, m * 4, i);
            m = m + 1;
        }
        i = i + 1;
    }
    if m == 0 {
        return 0;
    }
    // 按名字冒泡（与边那张表同一套写法）
    let a: u32 = 1;
    while a < m {
        let oi: u32 = load32(idx, a * 4);
        let j: u32 = a;
        let going: u32 = 1;
        while j > 0 && going == 1 {
            let oj: u32 = load32(idx, (j - 1) * 4);
            let nl_i: u32 = load32(ptr_add(mem, M_CNT), oi * CNTSZ + C_NL);
            let nl_j: u32 = load32(ptr_add(mem, M_CNT), oj * CNTSZ + C_NL);
            if blt(ptr_add(mem, M_CNT), oi * CNTSZ, nl_i,
                   ptr_add(mem, M_CNT), oj * CNTSZ, nl_j) == 1 {
                store32(idx, j * 4, oj);
                j = j - 1;
            } else {
                going = 0;
            }
        }
        store32(idx, j * 4, oi);
        a = a + 1;
    }
    let _p: u64 = wstr(1, "[NOTE] 同名多实例: ");
    let k: u32 = 0;
    while k < m {
        let oi2: u32 = load32(idx, k * 4);
        if k > 0 {
            let _c: u64 = wstr(1, ", ");
        }
        let np: ptr = ptr_add(mem, M_CNT);
        let _n: u64 = wmem(1, ptr_add(np, oi2 * CNTSZ), load32(np, oi2 * CNTSZ + C_NL));
        let _x: u64 = wstr(1, " x");
        let _v: u64 = wdec(mem, 1, load32(np, oi2 * CNTSZ + C_CNT));
        k = k + 1;
    }
    let _n2: u64 = wstr(1, "\n");
    return 0;
}

// ---------------------------------------------------------------- 入口

/// argv 第 k 项 (从 0 数) 的偏移与长度 (切 /proc/self/cmdline 的 NUL 分隔)。
fn arg_at(buf: ptr, tot: u32, k: u32, outp: ptr) -> u32 {
    let i: u32 = 0;
    let idx: u32 = 0;
    let s: u32 = 0;
    let found: u32 = 0;
    let ln: u32 = 0;
    while i < tot {
        if load8(buf, i) == 0 {
            if idx == k && found == 0 {
                store32(outp, 0, s);
                ln = i - s;
                found = 1;
            }
            idx = idx + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return ln;
}

fn _start() -> u32 {
    let memv: u64 = sys_alloc(M_CAP as u64);
    if memv == 0 {
        return fail("lomlib: brk failed\n");
    }
    let mem: ptr = memv as ptr;
    let cb: ptr = ptr_add(mem, M_CB);
    let fd: i64 = open_ro(str_ptr("/proc/self/cmdline"));
    if fd < 0 {
        return fail("lomlib: 读不到 argv\n");
    }
    let n: u64 = read_all(fd as u64, cb, 4096);
    close_fd(fd);
    let tot: u32 = n as u32;
    let ap: ptr = ptr_add(mem, M_CELL + 32);
    let l1: u32 = arg_at(cb, tot, 1, ap);
    let o1: u32 = load32(ap, 0);
    let l2: u32 = arg_at(cb, tot, 2, ap);
    let o2: u32 = load32(ap, 0);
    if l1 == 0 || l2 == 0 {
        return fail("lomlib: usage: lomlib id DIR\n");
    }
    let is_dbg: u32 = beq(cb, o1, l1, str_ptr("dbg"), 0, 3);
    let is_tree: u32 = beq(cb, o1, l1, str_ptr("tree"), 0, 4);
    if beq(cb, o1, l1, str_ptr("id"), 0, 2) == 0 && is_dbg == 0 && is_tree == 0 {
        return fail("lomlib: usage: lomlib id DIR\n");
    }
    let dirp: ptr = ptr_add(cb, o2);
    store8(dirp, l2, 0 as u8);
    if is_tree == 1 {
        store32(mem, M_CELL + C_SEENN, 0);
        store32(mem, M_CELL + C_CNTN, 0);
        let trc: u32 = tree_walk(mem, dirp, 0, 0);
        if trc == 4 {
            return fail("lomlib: 依赖环\n");
        }
        if trc == 5 {
            return fail("lomlib: 依赖找不到\n");
        }
        if trc != 0 {
            return fail("lomlib: 解析失败\n");
        }
        let _o1: u64 = wstr(1, "[OK] ");
        let _o2: u64 = wdec(mem, 1, load32(mem, M_CELL + C_SEENN));
        let _o3: u64 = wstr(1, " 个实例\n");
        note_multi(mem);
        syscall4(60, 0, 0, 0);
        return 0;
    }
    if is_dbg == 1 {
        walk_own(mem, dirp);
        sort_files(mem);
        let dl: u32 = slen(dirp);
        let b: u32 = 0;
        let i0: u32 = 0;
        while i0 < dl {
            let ch: u32 = load8(dirp, i0);
            if ch == 47 || ch == 92 {
                b = i0 + 1;
            }
            i0 = i0 + 1;
        }
        let _n0: u64 = wstr(1, "name=");
        let _n1: u64 = wmem(1, ptr_add(dirp, b), dl - b);
        let _n2: u64 = wstr(1, "\n");
        let fc: u32 = load32(mem, M_CELL + C_FILES);
        let k: u32 = 0;
        while k < fc {
            let po: u32 = load32(ptr_add(mem, M_IDX), k * 8);
            let rl: u32 = load32(ptr_add(mem, M_IDX), k * 8 + 4);
            let _f0: u64 = wstr(1, "f=");
            let _f1: u64 = wmem(1, ptr_add(mem, M_POOL + po), rl);
            let _f2: u64 = wstr(1, "\n");
            k = k + 1;
        }
        let ed: ptr = ptr_add(mem, M_DEP + S_EDG);
        let eo: ptr = ptr_add(mem, M_DEP + S_EOFF);
        collect_edges(mem, dirp, ed, eo);
        let ec: u32 = load32(mem, M_CELL + C_TMPV + 4);
        let e: u32 = 0;
        while e < ec {
            let eo2: u32 = load32(eo, e * 8);
            let el: u32 = load32(eo, e * 8 + 4);
            let _e0: u64 = wstr(1, "e=");
            let _e1: u64 = wmem(1, ptr_add(ed, eo2), el);
            let _e2: u64 = wstr(1, "\n");
            e = e + 1;
        }
        syscall4(60, 0, 0, 0);
        return 0;
    }
    let rc: u32 = ident_of(mem, dirp, 0);
    if rc == 4 {
        return fail("lomlib: 依赖环\n");
    }
    if rc == 5 {
        return fail("lomlib: 依赖找不到\n");
    }
    if rc != 0 {
        return fail("lomlib: 解析失败\n");
    }
    let inf0: ptr = ptr_add(mem, M_DEP + S_INFO);
    let _w1: u64 = wmem(1, inf0, load32(inf0, I_NL));
    let _w2: u64 = wstr(1, " ");
    let _w3: u64 = wmem(1, ptr_add(inf0, I_HEX), 64);
    let _w4: u64 = wstr(1, "\n");
    syscall4(60, 0, 0, 0);
    return 0;
}
