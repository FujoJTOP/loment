// loment/tools/lomelf.lomt — Loment 版原生 ELF 后端 (无 Python, docs/167)
//
// 判据 (tools/loment_elf_test.py 的 test_lomelf_selfhost_matches_reference):
// 同一份 `.ll` 喂本程序 (走种子自举链编成 ELF 后跑) 与 tools/lomelf.py,
// **产出的 ELF 逐字节相同**。这是"编译一个 Loment 程序不再需要一个 C 编译器"的那一格。
//
// CLI:  lomelf IN.ll OUT        (无选项; 参考实现的 -o/--check 是它自己的便利, 不镜像)
// 退出码 0 = OK / 1 = 输入不支持或解析失败 / 2 = 用法错误
//
// 与参考实现 (tools/lomelf.py) 的关系: **逐条镜像**, 包括那些看起来啰嗦的地方 ——
// 判据是字节相同, 任何"我这版写得更漂亮"的发挥都会让判据红。参考实现就是这格的规格书。
//
// 已知边界 (与参考实现头注同源, 逐条记账):
//   * 调用约定是我们自己的 (实参走栈), 不是 System V;
//   * 聚合返回值 / 间接调用 / 浮点不支持 (报错退出, 不静默错编)。
//
// 自举子集注意 (docs/150 的两条自举链缺口): 不写 `(a + b as T) as U`, 变量不叫 `fn`。

module lomelf

use bytes
use win_shim_data

// ---------------------------------------------------------------- PE 目标
//
// 与 tools/lomelf.py 的 --target pe 逐字对齐。四个节**钉在固定 RVA**，所以
// `__win_syscall` 里对 IAT 与静态状态的取址全是编译期常量 —— 那段机器码与布局完全无关，
// 直接从 win_shim_data（`tools/lomelf.py --dump-win-shim` 生成）拷进 .text 即可。
// 节间**不能留空洞**：加载器会报"不是有效的 Win32 应用程序"，所以每节的 VirtualSize
// 一直铺到下一节起点。
const PE_TEXT_RVA: u32 = 0x1000;
const PE_IDATA_RVA: u32 = 0x1000000;
const PE_DATA_RVA: u32 = 0x2000000;
const PE_STATE_RVA: u32 = 0x3000000;
const PE_SEC_ALIGN: u32 = 0x1000;
const PE_FILE_ALIGN: u32 = 0x200;
const PE_WS_SIZE: u32 = 1066840;   // 与参考实现的 WS_SIZE 对齐
const PE_LIT_OFF: u32 = 0x1000;    // "/proc/self/cmdline" 在 .idata 内的偏移
const PE_IMG_BASE: u64 = 5368709120;   // 0x140000000 —— 只在实际落绝对地址时才加
                                       // （表里存的是 RVA：u32 装不下这个基址）

// ---------------------------------------------------------------- 内存布局

// ---- 2026-09-19: 输入缓冲从 2 MiB 抬到 4 MiB（`docs/192` 记的那条待办）
//
// 起因不是猜的: **自举种子自己长过了 2 MiB**（`loment/build/selfhost_driver.ll`,
// 上一版余量只剩 1377 B —— 那次给 comefor 补两处守卫就顶出去了）。种子必须喂给 lomelf
// （`bootstrap.sh` 的 1/4 步），所以这条上限就是**种子的上限**。抬法是把布局整体重排:
// 输入 / 代码 / 输出三块各给 4 MiB（输入装得下种子, 代码与输出按同比例给, 免得
// "输入收下了、产物却装不下"那种一半的失败）。表区与全局数据不动。
const M_ARGV: u32 = 0;             // 8192
const M_IN: u32 = 8192;            // 4 MiB 输入 .ll 文本
const M_TXT: u32 = 4202496;        // 4 MiB 代码缓冲
const M_OUT: u32 = 8396800;        // 4 MiB 输出 ELF
const M_GB: u32 = 12591104;        // 1 MiB 全局数据
const M_TAB: u32 = 13639680;       // 4 MiB 表区
const M_OBJ: u32 = 17833984;       // 4 MiB 外部目标文件 (.o) 暂存 (docs/173, 一次一个)
const ARENA: u64 = 22028288;

const IN_CAP: u32 = 4194304;
const OUT_CAP: u32 = 4194304;
const GB_CAP: u32 = 1048576;
const OBJ_CAP: u32 = 4194304;

// 表区内的格 (相对 M_TAB)
const C_NG: u32 = 0;
const C_GB: u32 = 4;
const C_BSS: u32 = 8;
const C_NLBL: u32 = 12;
const C_NFIX: u32 = 16;
const C_NSLOT: u32 = 20;
const C_NALLOC: u32 = 24;
const C_FRAME: u32 = 28;
const C_TYLEN: u32 = 32;
const C_TYOFF: u32 = 36;
const C_VLOFF: u32 = 40;
const C_VLLEN: u32 = 44;
const C_DESTO: u32 = 48;
const C_DESTL: u32 = 52;
const C_RETL: u32 = 56;
const C_NPHI: u32 = 60;
const C_CURBO: u32 = 64;           // 当前基本块名 (phi 前驱匹配用)
const C_CURBL: u32 = 68;
const C_FNO: u32 = 72;             // 当前函数名
const C_FNL: u32 = 76;
const C_CC: u32 = 80;
const C_CSS: u32 = 84;
const C_PE: u32 = 88;              // 1 = 出 PE (Windows)，0 = 出 ELF
const C_SHIM: u32 = 92;            // PE：`__win_syscall` 在代码缓冲里的偏移
const C_NEXT: u32 = 96;            // 外部函数 (declare) 个数 (docs/173)
const C_EXTN: u32 = 100;           // 外部符号名池游标 (相对输入缓冲起点)
const C_NFREL: u32 = 104;          // 外部目标文件里的重定位条数 (docs/173 阶段 2)
const C_NOBJ: u32 = 108;           // 已摆好的外部对象个数

// 表起址 (相对 M_TAB); 格区 256 字节
//
// ---- 2026-09-20: 全局表从 2048 抬到 4096（`docs/200` 记的那条墙）
//
// 与上面那条输入缓冲**同一个病**: 种子又长过了一格, 这次撞的是全局表。参考实现给每一条
// 字符串字面量发一个 `.str.<函数>.<序号>` 全局（**不按内容去重**），所以"驱动链里多几十个
// 字符串字面量"就等于"全局表多几十条"。种子一旦超过 2048 条, `gadd` 那里**没有任何边界
// 检查**（它是单调 bump）—— 第 2049 条起直接写进**标签表**里, 症状不是报错, 是
// `lomelf: 未定义的标签: `（标签表被改坏, 查出来是个空名字）。
//
// 抬法是**整条表区往后挪**: 全局表 +65536（= 32 × 2048）, 回填表再 +458752
// （= 28 × 16384 —— 加完守卫之后它当场说出来自己是第二张满的, 见 `docs/200` §2）。
// 两张表都给完之后, 表尾最后一个偏移从 1785608 涨到 2244360, 于是**表区跟着从 2 MiB
// 抬到 4 MiB**, `M_OBJ` / `ARENA` 依次后移（与 `docs/192` §2 抬输入缓冲同一条式子）。
// `TB_G_MAX` 是给判据读的（`loment_genesis_test::test_seed_fits_lomelf_table_caps`）——
// 与 `IN_CAP` 那条同一种"把余量变成看得见的预算"。
const TB_G_MAX: u32 = 4096;        // 全局表条数上限（判据按它数种子里的 `@x = `）
const TB_G: u32 = 256;             // 全局表 stride 32 × TB_G_MAX
const G_NOFF: u32 = 0;
const G_NLEN: u32 = 4;
const G_TOFF: u32 = 8;
const G_TLEN: u32 = 12;
const G_SIZE: u32 = 16;
const G_DOFF: u32 = 20;
const G_ADDR: u32 = 24;
const G_ZERO: u32 = 28;

// 每张表的**容量**单独一个常量: ① 表满时要报错（下面各 `*_add` 的守卫）; ②
// `loment_genesis_test::test_seed_fits_lomelf_table_caps` 按它数种子 —— **不另抄一份数**,
// 与 `IN_CAP` / `test_m85_codegen_table_capacity` 同一条纪律。
const TB_LBL_MAX: u32 = 16384;     // 标签表条数
const TB_FIX_MAX: u32 = 32768;     // 回填表条数
const TB_SLOT_MAX: u32 = 32768;    // 槽表条数（每函数清）
const TB_ALLOC_MAX: u32 = 8192;    // alloca 表条数（每函数清）
const TB_PHI_MAX: u32 = 512;       // phi 表条数（每函数清）

const TB_LBL: u32 = 131328;          // 标签表 stride 24 × 16384: (函数名, 块名, 地址)
const L_NOFF: u32 = 0;
const L_NLEN: u32 = 4;
const L_ADDR: u32 = 8;
const L_BOFF: u32 = 12;            // 基本块名 (函数级标签留 0)
const L_BLEN: u32 = 16;

const TB_FIX: u32 = 524544;        // 回填表 stride 28 × TB_FIX_MAX（16384 → 32768, docs/200 §3）
const F_SITE: u32 = 0;
const F_KIND: u32 = 4;
const F_NOFF: u32 = 8;
const F_NLEN: u32 = 12;
const F_BOFF: u32 = 16;
const F_BLEN: u32 = 20;

const TB_SLOT: u32 = 1442048;       // 槽表 stride 16 × 32768 (每函数清)
const S_NOFF: u32 = 0;
const S_NLEN: u32 = 4;
const S_OFF: u32 = 8;

const TB_ALLOC: u32 = 1966336;     // alloca 表 stride 16 × 8192 (每函数清)
const A_NOFF: u32 = 0;
const A_NLEN: u32 = 4;
const A_OFF: u32 = 8;
const A_SIZE: u32 = 12;

const TB_ARG: u32 = 2097408;       // 调用实参暂存 (每个 24 字节)

const TB_PHI: u32 = 2097792;       // phi 表 stride 16 × 512 (每函数清)
const TB_IDATA: u32 = 2105984;      // PE: 导入表 blob 的落点（4115 字节，走 hex 搬进来）
const PH_BOFF: u32 = 0;            // 所属基本块名
const PH_BLEN: u32 = 4;
const PH_IOFF: u32 = 8;            // phi 指令的起始偏移
const PH_ILEN: u32 = 12;

// 外部函数表 (docs/173): `declare` 出来的符号名, 偏移指向**输入文本** (与标签表同基)。
const TB_EXT: u32 = 2111488;       // stride 8 × 4096: (起点, 长度)
const E_NOFF: u32 = 0;
const E_NLEN: u32 = 4;

// 外部对象表 (docs/173 阶段 2): 每个对象在**代码缓冲**里的起点。它的基址 = TEXT_VADDR + 该值。
const TB_OBJ: u32 = 2112288;       // stride 8 × 256
const O_TEXT: u32 = 0;             // 该对象的代码在缓冲里的偏移 (16 对齐)

// 外部重定位表 (docs/173 阶段 2): 先**全部记下来**, 等所有对象都摆好、标签都立好, 再统一应用
// —— 因为 `a.o` 里的重定位可能指向只有 `b.o` 知道的地址。
const TB_FREL: u32 = 2113288;      // stride 32 × 4096
const F2_OBJ: u32 = 0;             // 对象号 (索引 TB_OBJ)
const F2_AT: u32 = 4;              // 被重定位节在该对象代码里的起点
const F2_OFF: u32 = 8;             // r_offset (节内偏移)
const F2_TY: u32 = 12;             // 重定位类型 (ELF 的 R_X86_64_* 编号)
const F2_NOFF: u32 = 16;           // 目标符号名 (名字池内偏移, 与标签表同基)
const F2_NLEN: u32 = 20;
const F2_ADD: u32 = 24;            // 加数 (i32 位型)

// ---------------------------------------------------------------- 常量

const TEXT_VADDR: u32 = 4194304;   // 0x400000
const DATA_VADDR: u32 = 6291456;   // 0x600000
const NO: u32 = 4294967295;
const PHI: u64 = 4294967296;

const RAX: u32 = 0;
const RCX: u32 = 1;
const RDX: u32 = 2;
const RSP: u32 = 4;
const RBP: u32 = 5;
const RSI: u32 = 6;
const RDI: u32 = 7;
const R8: u32 = 8;                 // 只为 System V 的第 5、6 个实参寄存器 (docs/173)
const R9: u32 = 9;

const ADD: u32 = 0;
const SUB: u32 = 5;
const CMP: u32 = 7;

fn hi32(v: u64) -> u32 {
    return (v / PHI) as u32;
}

fn lo32(v: u64) -> u32 {
    return (v % PHI) as u32;
}

fn pk16(a: u32, b: u32) -> u64 {
    return (a as u64) * PHI + (b as u64);
}

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn fail(msg: str) -> u32 {
    wstr(2, "lomelf: ");
    wstr(2, msg);
    wstr(2, "\n");
    return die(1);
}

fn fail_line(t: ptr, ls: u32, le: u32) -> u32 {
    wstr(2, "lomelf: 不支持: ");
    write_all(2, ptr_add(t, ls), (le - ls) as u64);
    wstr(2, "\n");
    return die(1);
}

/// 第 n 个 argv (0 = 程序名) 的 (起点 << 32) | 长度。
fn cstr(dst: ptr, s: str) -> ptr {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return dst;
}

fn argv_n(buf: ptr, cap: u64, n: u32) -> u64 {
    let fd: i64 = syscall4(257, (0 as u64) - 100,
                           cstr(ptr_add(buf, 8192), "/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return 0;
    }
    let rn: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if rn <= 0 {
        return 0;
    }
    let m: u32 = rn as u32;
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    let hit: u64 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == n {
                hit = (s as u64) * PHI + ((i - s) as u64);
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    if f == n {
        hit = (s as u64) * PHI + ((m - s) as u64);
    }
    return hit;
}

fn open_ro(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 0);
}

fn open_wo(path: ptr) -> i64 {
    return syscall6(257, (0 as u64) - 100, path as u64, 577, 420, 0);
}

// ---------------------------------------------------------------- 文本小工具

/// 记号字符。**`-` 要算进来** —— LLVM IR 的立即数允许负号（`and i32 %x, -8`），
/// 而操作数的跨度就是靠这个函数量出来的。少了它，`-8` 会被量成**长度 0**：
/// 常量物化读到空串，于是**镜像发 `0`、参考发 `-8`** —— 两份链接器逐字节那条判据当场红。
/// 第一份带负立即数的 IR 是 `gc_manual` 的分配器（`and i32 %need0, -8`），
/// 在那之前这条路径**从来没有被走过**，所以它一直没露出来。
/// 只有注释里还有个 `->`，而 `lower` 对 `;` 开头的行整行返回，碰不到这里。
fn is_word(c: u32) -> u32 {
    if c >= 97 && c <= 122 {
        return 1;
    }
    if c >= 65 && c <= 90 {
        return 1;
    }
    if c >= 48 && c <= 57 {
        return 1;
    }
    if c == 95 || c == 46 || c == 64 || c == 37 || c == 45 {
        return 1;
    }
    return 0;
}

fn skip_sp(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c == 32 || c == 9 || c == 13 {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

fn word_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        if is_word(load8(t, j)) == 0 {
            go = 0;
        } else {
            j = j + 1;
        }
    }
    return j;
}

fn lit_at(t: ptr, i: u32, n: u32, lit: str) -> u32 {
    let L: u32 = str_len(lit);
    if i + L > n {
        return 0;
    }
    let k: u32 = 0;
    while k < L {
        if load8(t, i + k) != load8(str_ptr(lit), k) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

fn span_eq(t: ptr, a: u32, alen: u32, b: u32, blen: u32) -> u32 {
    if alen != blen {
        return 0;
    }
    let k: u32 = 0;
    while k < alen {
        if load8(t, a + k) != load8(t, b + k) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

fn line_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    while j < n {
        if load8(t, j) == 10 {
            return j;
        }
        j = j + 1;
    }
    return n;
}

fn balanced(t: ptr, a: u32, b: u32) -> u32 {
    let d: u32 = 0;
    let k: u32 = a;
    while k < b {
        let c: u32 = load8(t, k);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        }
        if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        }
        k = k + 1;
    }
    if d == 0 {
        return 1;
    }
    return 0;
}

/// 一条指令的结束位置: 括号不闭合就继续收下一行 (自举 codegen 的 switch 是多行的)。
fn logical_end(t: ptr, i: u32, n: u32) -> u32 {
    let e: u32 = line_end(t, i, n);
    let go: u32 = 1;
    while go == 1 {
        if balanced(t, i, e) == 1 {
            go = 0;
        } else {
            if e >= n {
                go = 0;
            } else {
                e = line_end(t, e + 1, n);
            }
        }
    }
    return e;
}

/// 64 位字面量 (IR 里的常量可以是 2^32 这种; u32 版会截断)。
fn num64_at(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = skip_sp(t, i, n);
    let neg: u32 = 0;
    if j < n && load8(t, j) == 45 {
        neg = 1;
        j = j + 1;
    }
    let v: u64 = 0;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c >= 48 && c <= 57 {
            v = v * 10 + ((c - 48) as u64);
            j = j + 1;
        } else {
            go = 0;
        }
    }
    if neg == 1 {
        v = (0 as u64) - v;
    }
    return v;
}

fn num_at(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = skip_sp(t, i, n);
    let neg: u32 = 0;
    if j < n && load8(t, j) == 45 {
        neg = 1;
        j = j + 1;
    }
    let v: u32 = 0;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            j = j + 1;
        } else {
            go = 0;
        }
    }
    if neg == 1 {
        v = 4294967296 - v;
    }
    return pk16(j, v);
}

// ---------------------------------------------------------------- 类型

fn type_span(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = skip_sp(t, i, n);
    let c: u32 = load8(t, j);
    if c == 123 || c == 91 {
        let open: u32 = c;
        let close: u32 = 125;
        if open == 91 {
            close = 93;
        }
        let d: u32 = 0;
        let k: u32 = j;
        let done: u32 = 0;
        while k < n && done == 0 {
            let ch: u32 = load8(t, k);
            if ch == open {
                d = d + 1;
            }
            if ch == close {
                d = d - 1;
            }
            k = k + 1;
            if d == 0 {
                done = 1;
            }
        }
        return pk16(j, k - j);
    }
    let e: u32 = word_end(t, j, n);
    return pk16(j, e - j);
}

fn scalar_size(t: ptr, off: u32, len: u32) -> u32 {
    if len == 2 && load8(t, off) == 105 {
        let c: u32 = load8(t, off + 1);
        if c == 49 || c == 56 {
            return 1;
        }
    }
    if len == 3 && load8(t, off) == 105 {
        let c2: u32 = load8(t, off + 2);
        if c2 == 54 {
            return 2;
        }
        if c2 == 50 {
            return 4;
        }
        if c2 == 52 {
            return 8;
        }
    }
    if len == 3 && load8(t, off) == 112 && load8(t, off + 2) == 114 {
        return 8;
    }
    return 0;
}

fn arr_n(t: ptr, off: u32, len: u32) -> u32 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let v: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let c: u32 = load8(t, i);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            i = i + 1;
        } else {
            go = 0;
        }
    }
    return v;
}

fn arr_elem(t: ptr, off: u32, len: u32) -> u64 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let go: u32 = 1;
    while i < end && go == 1 {
        if load8(t, i) == 120 {
            go = 0;
        } else {
            i = i + 1;
        }
    }
    return type_span(t, i + 1, end);
}

/// 代码/数据在**表里**用什么基址：ELF 用绝对 vaddr，PE 用 RVA。
/// PE 的 0x140000000 装不进 u32，所以只在真要落 8 字节绝对地址的地方才加回去。
fn txt_base(tab: ptr) -> u32 {
    if cell(tab, C_PE) == 1 {
        return PE_TEXT_RVA;
    }
    return TEXT_VADDR;
}

fn data_base(tab: ptr) -> u32 {
    if cell(tab, C_PE) == 1 {
        return PE_DATA_RVA;
    }
    return DATA_VADDR;
}

fn align_to(v: u32, a: u32) -> u32 {
    if a == 0 {
        return v;
    }
    let r: u32 = v % a;
    if r == 0 {
        return v;
    }
    return v + (a - r);
}

// ---------------------------------------------------------------- hex blob

fn hexval(ch: u32) -> u32 {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    return ch - 87;                 // 'a'..'f'
}

/// 把 hex 串解成字节写进缓冲；返回新的游标。
/// win_shim_data 里那两段数据（shim 机器码、导入表）都与布局无关，所以在 Loment 源码里
/// 以 hex 字面量形式带着走 —— 镜像是独立二进制，不该在运行时去读仓库里的文件。
fn blob_copy(out: ptr, c: u32, hx: str) -> u32 {
    let n: u32 = str_len(hx) / 2;
    let d: u32 = c;
    let i: u32 = 0;
    while i < n {
        let hi: u32 = hexval(str_byte(hx, i * 2) as u32);
        let lo: u32 = hexval(str_byte(hx, i * 2 + 1) as u32);
        let b: u32 = hi * 16 + lo;
        store8(out, d, b as u8);
        d = d + 1;
        i = i + 1;
    }
    return d;
}

fn ty_size(t: ptr, off: u32, len: u32) -> u32 {
    let c: u32 = load8(t, off);
    if c == 123 {
        let i: u32 = off + 1;
        let end: u32 = off + len - 1;
        let sz: u32 = 0;
        let go: u32 = 1;
        while i < end && go == 1 {
            let j: u32 = skip_sp(t, i, end);
            if j >= end {
                go = 0;
            } else {
                if load8(t, j) == 44 {
                    j = j + 1;
                }
                let fs: u64 = type_span(t, j, end);
                let fo: u32 = hi32(fs);
                let fl: u32 = lo32(fs);
                sz = align_to(sz, ty_size(t, fo, fl)) + ty_size(t, fo, fl);
                i = fo + fl;
            }
        }
        return sz;
    }
    if c == 91 {
        let es: u64 = arr_elem(t, off, len);
        return arr_n(t, off, len) * ty_size(t, hi32(es), lo32(es));
    }
    return scalar_size(t, off, len);
}

fn field_off(t: ptr, off: u32, len: u32, idx: u32) -> u32 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let sz: u32 = 0;
    let k: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let j: u32 = skip_sp(t, i, end);
        if j >= end {
            return NO;
        }
        if load8(t, j) == 44 {
            j = j + 1;
        }
        let fs: u64 = type_span(t, j, end);
        let fo: u32 = hi32(fs);
        let fl: u32 = lo32(fs);
        let fsz: u32 = ty_size(t, fo, fl);
        let aoff: u32 = align_to(sz, fsz);
        if k == idx {
            return aoff;
        }
        sz = aoff + fsz;
        k = k + 1;
        i = fo + fl;
    }
    return NO;
}

fn field_ty(t: ptr, off: u32, len: u32, idx: u32) -> u64 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let k: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let j: u32 = skip_sp(t, i, end);
        if j >= end {
            return pk16(NO, NO);
        }
        if load8(t, j) == 44 {
            j = j + 1;
        }
        let fs: u64 = type_span(t, j, end);
        if k == idx {
            return fs;
        }
        k = k + 1;
        i = hi32(fs) + lo32(fs);
    }
    return pk16(NO, NO);
}

fn is_agg(t: ptr, off: u32, len: u32) -> u32 {
    let c: u32 = load8(t, off);
    if c == 123 || c == 91 {
        return 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 表

fn cell(tab: ptr, off: u32) -> u32 {
    return load32(tab, off);
}

fn setcell(tab: ptr, off: u32, v: u32) {
    store32(tab, off, v);
}

fn lbl_add(tab: ptr, noff: u32, nlen: u32, boff: u32, blen: u32, addr: u32) {
    let k: u32 = cell(tab, C_NLBL);
    // 表满 = **响亮地退出**, 不是往下写。这几张表都是**单调 bump**, 一旦越过自己的容量
    // 就踩进下一张表 —— 症状离现场很远（2026-09-20 实测: 全局表越界 38 条, 报出来的是
    // "未定义的标签: "，空白名字, 因为标签表被写坏了)。与 `IN_CAP` 那条守卫同一个纪律。
    if k >= TB_LBL_MAX {
        let _f: u32 = fail("标签表满了 — 抬高 TB_LBL 的容量 (loment/tools/lomelf.lomt 的 TB_LBL_MAX)");
    }
    let base: u32 = TB_LBL + k * 24;
    store32(tab, base + L_NOFF, noff);
    store32(tab, base + L_NLEN, nlen);
    store32(tab, base + L_ADDR, addr);
    store32(tab, base + L_BOFF, boff);
    store32(tab, base + L_BLEN, blen);
    setcell(tab, C_NLBL, k + 1);
}

fn lbl_find(tab: ptr, t: ptr, noff: u32, nlen: u32, boff: u32, blen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NLBL);
    while k < n {
        let base: u32 = TB_LBL + k * 24;
        if span_eq(t, load32(tab, base + L_NOFF), load32(tab, base + L_NLEN), noff, nlen) == 1
            && span_eq(t, load32(tab, base + L_BOFF), load32(tab, base + L_BLEN), boff, blen) == 1 {
            return load32(tab, base + L_ADDR);
        }
        k = k + 1;
    }
    return NO;
}

fn fix_add(tab: ptr, site: u32, kind: u32, noff: u32, nlen: u32, boff: u32, blen: u32) {
    let k: u32 = cell(tab, C_NFIX);
    if k >= TB_FIX_MAX {
        let _f: u32 = fail("回填表满了 — 抬高 TB_FIX 的容量 (loment/tools/lomelf.lomt 的 TB_FIX_MAX)");
    }
    let base: u32 = TB_FIX + k * 28;
    store32(tab, base + F_SITE, site);
    store32(tab, base + F_KIND, kind);
    store32(tab, base + F_NOFF, noff);
    store32(tab, base + F_NLEN, nlen);
    store32(tab, base + F_BOFF, boff);
    store32(tab, base + F_BLEN, blen);
    setcell(tab, C_NFIX, k + 1);
}

fn slot_find(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NSLOT);
    while k < n {
        let base: u32 = TB_SLOT + k * 16;
        if span_eq(t, load32(tab, base + S_NOFF), load32(tab, base + S_NLEN), noff, nlen) == 1 {
            return load32(tab, base + S_OFF);
        }
        k = k + 1;
    }
    return NO;
}

fn slot_has(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    if slot_find(tab, t, noff, nlen) == NO {
        return 0;
    }
    return 1;
}

fn slot_put(tab: ptr, noff: u32, nlen: u32, off: u32) {
    let k: u32 = cell(tab, C_NSLOT);
    if k >= TB_SLOT_MAX {
        let _f: u32 = fail("槽表满了 — 抬高 TB_SLOT 的容量 (loment/tools/lomelf.lomt 的 TB_SLOT_MAX)");
    }
    let base: u32 = TB_SLOT + k * 16;
    store32(tab, base + S_NOFF, noff);
    store32(tab, base + S_NLEN, nlen);
    store32(tab, base + S_OFF, off);
    setcell(tab, C_NSLOT, k + 1);
}

fn alloc_find(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NALLOC);
    while k < n {
        let base: u32 = TB_ALLOC + k * 16;
        if span_eq(t, load32(tab, base + A_NOFF), load32(tab, base + A_NLEN), noff, nlen) == 1 {
            return load32(tab, base + A_OFF);
        }
        k = k + 1;
    }
    return NO;
}

fn alloc_put(tab: ptr, noff: u32, nlen: u32, off: u32, size: u32) {
    let k: u32 = cell(tab, C_NALLOC);
    if k >= TB_ALLOC_MAX {
        let _f: u32 = fail("alloca 表满了 (单个函数) — 抬高 TB_ALLOC 的容量 (loment/tools/lomelf.lomt 的 TB_ALLOC_MAX)");
    }
    let base: u32 = TB_ALLOC + k * 16;
    store32(tab, base + A_NOFF, noff);
    store32(tab, base + A_NLEN, nlen);
    store32(tab, base + A_OFF, off);
    store32(tab, base + A_SIZE, size);
    setcell(tab, C_NALLOC, k + 1);
}

// ---------------------------------------------------------------- x86-64 编码
// 所有发射函数把"代码缓冲游标"作为参数收下并返回新游标 (Loment 没有可变全局)。

fn e1(out: ptr, c: u32, b: u32) -> u32 {
    store8(out, c, b as u8);
    return c + 1;
}

fn e4(out: ptr, c: u32, v: u32) -> u32 {
    let d: u32 = e1(out, c, v % 256);
    d = e1(out, d, (v / 256) % 256);
    d = e1(out, d, (v / 65536) % 256);
    return e1(out, d, (v / 16777216) % 256);
}

fn e8(out: ptr, c: u32, v: u64) -> u32 {
    let d: u32 = c;
    let x: u64 = v;
    let i: u32 = 0;
    while i < 8 {
        d = e1(out, d, (x % 256) as u32);
        x = x / 256;
        i = i + 1;
    }
    return d;
}

fn rex(w: u32, r: u32, x: u32, b: u32) -> u32 {
    let v: u32 = 64 + w * 8 + (r / 8) * 4 + (x / 8) * 2 + (b / 8);
    if v == 64 {
        return 0;
    }
    return v;
}

fn em_rex(out: ptr, c: u32, v: u32) -> u32 {
    if v == 0 {
        return c;
    }
    return e1(out, c, v);
}

fn em_mem(out: ptr, c: u32, reg_field: u32, base: u32, disp: u32) -> u32 {
    let d: u32 = e1(out, c, 128 + (reg_field % 8) * 8 + (base % 8));
    if base % 8 == 4 {
        d = e1(out, d, 36);
    }
    return e4(out, d, disp);
}

fn em_modrm3(out: ptr, c: u32, reg: u32, rm: u32) -> u32 {
    return e1(out, c, 192 + (reg % 8) * 8 + (rm % 8));
}

fn em_mov_rr(out: ptr, c: u32, dst: u32, src: u32, w: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(w, src, 0, dst));
    d = e1(out, d, 137);
    return em_modrm3(out, d, src, dst);
}

fn em_mov_ri64(out: ptr, c: u32, dst: u32, imm: u64) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, dst));
    d = e1(out, d, 184 + dst % 8);
    return e8(out, d, imm);
}

fn em_mov_ri32(out: ptr, c: u32, dst: u32, imm: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, dst));
    d = e1(out, d, 184 + dst % 8);
    return e4(out, d, imm);
}

fn em_mov_rm(out: ptr, c: u32, dst: u32, base: u32, disp: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, dst, 0, base));
    d = e1(out, d, 139);
    return em_mem(out, d, dst, base, disp);
}

fn em_mov_mr(out: ptr, c: u32, base: u32, disp: u32, src: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, src, 0, base));
    d = e1(out, d, 137);
    return em_mem(out, d, src, base, disp);
}

fn em_lea(out: ptr, c: u32, dst: u32, base: u32, disp: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, dst, 0, base));
    d = e1(out, d, 141);
    return em_mem(out, d, dst, base, disp);
}

fn em_alu_rr(out: ptr, c: u32, op: u32, dst: u32, src: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, src, 0, dst));
    d = e1(out, d, op);
    return em_modrm3(out, d, src, dst);
}

fn em_alu_ri(out: ptr, c: u32, digit: u32, dst: u32, imm: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, dst));
    d = e1(out, d, 129);
    d = em_modrm3(out, d, digit, dst);
    return e4(out, d, imm);
}

fn em_imul_rr(out: ptr, c: u32, dst: u32, src: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, dst, 0, src));
    d = e1(out, d, 15);
    d = e1(out, d, 175);
    return em_modrm3(out, d, dst, src);
}

/// 发一条 jcc, 立即数留空; 返回立即数的偏移 (调用方自己回填相对距离)。
fn em_jcc_raw(out: ptr, c: u32, cond: u32) -> u32 {
    let d: u32 = e1(out, c, 15);
    d = e1(out, d, 128 + cond);
    let at: u32 = d;
    d = e4(out, d, 0);
    return at;
}

fn em_push(out: ptr, c: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, reg));
    return e1(out, d, 80 + reg % 8);
}

fn em_pop(out: ptr, c: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, reg));
    return e1(out, d, 88 + reg % 8);
}

fn em_load_sized(out: ptr, c: u32, reg: u32, base: u32, disp: u32, size: u32) -> u32 {
    if size == 8 {
        return em_mov_rm(out, c, reg, base, disp);
    }
    let d: u32 = em_rex(out, c, rex(0, reg, 0, base));
    if size == 4 {
        d = e1(out, d, 139);
        return em_mem(out, d, reg, base, disp);
    }
    d = e1(out, d, 15);
    if size == 1 {
        d = e1(out, d, 182);
    } else {
        d = e1(out, d, 183);
    }
    return em_mem(out, d, reg, base, disp);
}

fn em_store_sized(out: ptr, c: u32, base: u32, disp: u32, src: u32, size: u32) -> u32 {
    if size == 8 {
        return em_mov_mr(out, c, base, disp, src);
    }
    let d: u32 = c;
    if size == 2 {
        d = e1(out, d, 102);
    }
    d = em_rex(out, d, rex(0, src, 0, base));
    if size == 1 {
        d = e1(out, d, 136);
    } else {
        d = e1(out, d, 137);
    }
    return em_mem(out, d, src, base, disp);
}

fn em_zext64(out: ptr, c: u32, reg: u32, size: u32) -> u32 {
    if size >= 8 {
        return c;
    }
    if size == 4 {
        return em_mov_rr(out, c, reg, reg, 0);
    }
    let d: u32 = em_rex(out, c, rex(0, reg, 0, reg));
    d = e1(out, d, 15);
    if size == 2 {
        d = e1(out, d, 183);
    } else {
        d = e1(out, d, 182);
    }
    return em_modrm3(out, d, reg, reg);
}

fn em_sext64(out: ptr, c: u32, reg: u32, size: u32) -> u32 {
    if size >= 8 {
        return c;
    }
    let d: u32 = em_rex(out, c, rex(1, reg, 0, reg));
    if size == 4 {
        d = e1(out, d, 99);
        return em_modrm3(out, d, reg, reg);
    }
    d = e1(out, d, 15);
    if size == 2 {
        d = e1(out, d, 191);
    } else {
        d = e1(out, d, 190);
    }
    return em_modrm3(out, d, reg, reg);
}

fn em_copy(out: ptr, c: u32, dst: u32, src: u32, n: u32) -> u32 {
    let d: u32 = em_mov_rr(out, c, RDI, dst, 1);
    d = em_mov_rr(out, d, RSI, src, 1);
    d = em_mov_ri64(out, d, RCX, n as u64);
    d = e1(out, d, 243);
    return e1(out, d, 164);
}

fn em_call_lbl(out: ptr, c: u32, tab: ptr, noff: u32, nlen: u32) -> u32 {
    let d: u32 = e1(out, c, 232);
    fix_add(tab, d, 0, noff, nlen, 0, 0);
    return e4(out, d, 0);
}

/// 跳到基本块 (名字 = 函数名 + 块名)。
fn em_jmp_blk(out: ptr, c: u32, tab: ptr, fo: u32, fl: u32, bo: u32, bl: u32) -> u32 {
    let d: u32 = e1(out, c, 233);
    fix_add(tab, d, 0, fo, fl, bo, bl);
    return e4(out, d, 0);
}

fn em_jcc_blk(out: ptr, c: u32, cond: u32, tab: ptr, fo: u32, fl: u32,
              bo: u32, bl: u32) -> u32 {
    let d: u32 = e1(out, c, 15);
    d = e1(out, d, 128 + cond);
    fix_add(tab, d, 0, fo, fl, bo, bl);
    return e4(out, d, 0);
}

fn em_mov_abs(out: ptr, c: u32, tab: ptr, reg: u32, noff: u32, nlen: u32) -> u32 {
    let d: u32 = em_mov_ri64(out, c, reg, 0);
    fix_add(tab, d - 8, 1, noff, nlen, 0, 0);
    return d;
}

// ---------------------------------------------------------------- 取值 / 存值

fn emit_get(tab: ptr, out: ptr, c: u32, t: ptr, tyo: u32, tyl: u32,
            vo: u32, vl: u32, reg: u32) -> u32 {
    let sz: u32 = ty_size(t, tyo, tyl);
    let c0: u32 = load8(t, vo);
    let d: u32 = c;
    if c0 == 37 {
        let so: u32 = slot_find(tab, t, vo, vl);
        d = em_load_sized(out, d, reg, RBP, so, sz);
    } else {
        if c0 == 64 {
            d = em_mov_abs(out, d, tab, reg, vo, vl);
            if sz != 8 {
                d = em_load_sized(out, d, reg, reg, 0, sz);
            }
        } else {
            if c0 == 116 {
                d = em_mov_ri32(out, d, reg, 1);
            } else {
                if c0 == 102 || c0 == 110 || c0 == 117 {
                    d = em_mov_ri32(out, d, reg, 0);
                } else {
                    let nv: u64 = num64_at(t, vo, vo + vl);
                    d = em_mov_ri64(out, d, reg, nv);
                }
            }
        }
    }
    return em_zext64(out, d, reg, sz);
}

fn emit_get_signed(tab: ptr, out: ptr, c: u32, t: ptr, tyo: u32, tyl: u32,
                   vo: u32, vl: u32, reg: u32) -> u32 {
    let d: u32 = emit_get(tab, out, c, t, tyo, tyl, vo, vl, reg);
    return em_sext64(out, d, reg, ty_size(t, tyo, tyl));
}

fn emit_get_ptr(tab: ptr, out: ptr, c: u32, t: ptr, vo: u32, vl: u32, reg: u32) -> u32 {
    let so: u32 = alloc_find(tab, t, vo, vl);
    if so != NO {
        return em_lea(out, c, reg, RBP, so);
    }
    let s2: u32 = slot_find(tab, t, vo, vl);
    if s2 != NO {
        return em_mov_rm(out, c, reg, RBP, s2);
    }
    if load8(t, vo) == 64 {
        return em_mov_abs(out, c, tab, reg, vo, vl);
    }
    wstr(2, "lomelf: 指针值查不到: ");
    write_all(2, ptr_add(t, vo), vl as u64);
    wstr(2, " @fn=");
    write_all(2, ptr_add(t, cell(tab, C_FNO)), cell(tab, C_FNL) as u64);
    wstr(2, " nalloc=");
    wdec(2, ptr_add(t, IN_CAP - 64), cell(tab, C_NALLOC));
    wstr(2, " nslot=");
    wdec(2, ptr_add(t, IN_CAP - 64), cell(tab, C_NSLOT));
    wstr(2, "
");
    return die(1);
}

fn emit_agg_addr(tab: ptr, out: ptr, c: u32, t: ptr, vo: u32, vl: u32, reg: u32) -> u32 {
    let so: u32 = alloc_find(tab, t, vo, vl);
    if so != NO {
        return em_lea(out, c, reg, RBP, so);
    }
    let s2: u32 = slot_find(tab, t, vo, vl);
    if s2 != NO {
        return em_lea(out, c, reg, RBP, s2);
    }
    if load8(t, vo) == 64 {
        return em_mov_abs(out, c, tab, reg, vo, vl);
    }
    return c;
}

fn emit_put(tab: ptr, out: ptr, c: u32, t: ptr, doff: u32, dlen: u32, reg: u32) -> u32 {
    let so: u32 = slot_find(tab, t, doff, dlen);
    return em_mov_mr(out, c, RBP, so, reg);
}

/// 解析 `类型 值` 直接写进调用者给的记录 (tyo/tyl/vo/vl); 返回其后游标。
fn opnd_rec(tab: ptr, t: ptr, i: u32, n: u32, rec: u32) -> u32 {
    let ts: u64 = type_span(t, i, n);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let j: u32 = skip_sp(t, to + tl, n);
    store32(tab, rec, to);
    store32(tab, rec + 4, tl);
    store32(tab, rec + 8, j);
    let ve: u32 = word_end(t, j, n);
    store32(tab, rec + 12, ve - j);
    return ve;
}

/// 解析 `类型 值` 进格; 返回其后游标。
fn opnd(tab: ptr, t: ptr, i: u32, n: u32) -> u32 {
    let ts: u64 = type_span(t, i, n);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let j: u32 = skip_sp(t, to + tl, n);
    let ve: u32 = word_end(t, j, n);
    store32(tab, C_TYOFF, to);
    store32(tab, C_TYLEN, tl);
    store32(tab, C_VLOFF, j);
    store32(tab, C_VLLEN, ve - j);
    return ve;
}

fn skip_comma(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = skip_sp(t, i, n);
    if j < n && load8(t, j) == 44 {
        j = skip_sp(t, j + 1, n);
    }
    return j;
}

// ---------------------------------------------------------------- 结果尺寸

fn size_after_to(t: ptr, i: u32, n: u32) -> u32 {
    let le: u32 = line_end(t, i, n);
    let j: u32 = i;
    let found: u32 = 0;
    while j < le && found == 0 {
        if lit_at(t, j, le, " to ") == 1 {
            found = 1;
        } else {
            j = j + 1;
        }
    }
    if found == 0 {
        return 0;
    }
    let ts: u64 = type_span(t, j + 4, le);
    return ty_size(t, hi32(ts), lo32(ts));
}

fn result_size(t: ptr, i: u32, n: u32) -> u32 {
    if lit_at(t, i, n, "alloca ") == 1 {
        return 8;
    }
    if lit_at(t, i, n, "load ") == 1 {
        let ts: u64 = type_span(t, i + 5, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "getelementptr") == 1 {
        return 8;
    }
    if lit_at(t, i, n, "extractvalue ") == 1 {
        let ts: u64 = type_span(t, i + 13, n);
        let fo: u32 = hi32(ts);
        let fl: u32 = lo32(ts);
        let k: u32 = skip_comma(t, fo + fl, n);
        let nx: u64 = num_at(t, k, n);
        let fts: u64 = field_ty(t, fo, fl, lo32(nx));
        return ty_size(t, hi32(fts), lo32(fts));
    }
    if lit_at(t, i, n, "insertvalue ") == 1 {
        let ts: u64 = type_span(t, i + 12, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "call ") == 1 {
        let j: u32 = skip_sp(t, i + 5, n);
        if lit_at(t, j, n, "void") == 1 {
            return 0;
        }
        let ts: u64 = type_span(t, j, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "trunc ") == 1 || lit_at(t, i, n, "zext ") == 1
        || lit_at(t, i, n, "sext ") == 1 || lit_at(t, i, n, "ptrtoint ") == 1
        || lit_at(t, i, n, "inttoptr ") == 1 {
        return size_after_to(t, i, n);
    }
    if lit_at(t, i, n, "icmp ") == 1 {
        return 1;
    }
    if lit_at(t, i, n, "phi ") == 1 {
        let ts: u64 = type_span(t, i + 4, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "atomicrmw ") == 1 {
        let j: u32 = skip_sp(t, i + 10, n);
        let j2: u32 = skip_sp(t, word_end(t, j, n), n);
        let ts: u64 = type_span(t, j2, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if binop_ty(t, i, n, "add") == 1 || binop_ty(t, i, n, "sub") == 1
        || binop_ty(t, i, n, "mul") == 1 || binop_ty(t, i, n, "and") == 1
        || binop_ty(t, i, n, "or") == 1 || binop_ty(t, i, n, "xor") == 1
        || binop_ty(t, i, n, "sdiv") == 1 || binop_ty(t, i, n, "udiv") == 1
        || binop_ty(t, i, n, "srem") == 1 || binop_ty(t, i, n, "urem") == 1
        || binop_ty(t, i, n, "shl") == 1 || binop_ty(t, i, n, "lshr") == 1
        || binop_ty(t, i, n, "ashr") == 1 {
        let ts: u64 = type_span(t, binop_ty_at(t, i, n), n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    return 0;
}

/// 二元运算名的长度 (用于跳到类型); 不匹配返回 0。
fn binop_ty_at(t: ptr, i: u32, n: u32) -> u32 {
    if binop_ty(t, i, n, "add") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "sub") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "mul") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "and") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "xor") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "sdiv") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "udiv") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "srem") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "urem") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "shl") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "lshr") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "ashr") == 1 {
        return i + 5;
    }
    return i + 3;
}

/// 匹配 "op " 前缀且后面不是别的单词字符。
fn binop_ty(t: ptr, i: u32, n: u32, op: str) -> u32 {
    let L: u32 = str_len(op);
    if i + L >= n {
        return 0;
    }
    if lit_at(t, i, n, op) == 0 {
        return 0;
    }
    if load8(t, i + L) != 32 {
        return 0;
    }
    return 1;
}

// ---------------------------------------------------------------- 全局收集

/// 收集一个全局声明 (行 [ls,le)); 返回其数据字节数, 并把数据写进 gb。
fn one_global(tab: ptr, t: ptr, gb: ptr, ls: u32, le: u32) -> u32 {
    let noff: u32 = ls;                       // 含前导 '@' —— 与参考实现的 g.name 同名
    let nlen: u32 = word_end(t, noff, le) - noff;
    let i: u32 = skip_sp(t, word_end(t, noff, le), le);
    // 跳过 '='
    let j: u32 = skip_sp(t, i + 1, le);
    // 跳过限定词
    let go: u32 = 1;
    while go == 1 {
        let we: u32 = word_end(t, j, le);
        if lit_at(t, j, we, "private") == 1 || lit_at(t, j, we, "internal") == 1
            || lit_at(t, j, we, "external") == 1 || lit_at(t, j, we, "unnamed_addr") == 1
            || lit_at(t, j, we, "dso_local") == 1 || lit_at(t, j, we, "constant") == 1
            || lit_at(t, j, we, "global") == 1 || lit_at(t, j, we, "common") == 1 {
            j = skip_sp(t, we, le);
        } else {
            go = 0;
        }
    }
    let ts: u64 = type_span(t, j, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let sz: u32 = ty_size(t, to, tl);
    let k: u32 = skip_sp(t, to + tl, le);
    let kt: u32 = load8(t, k);
    let doff: u32 = align_to(cell(tab, C_GB), 8);
    let zero: u32 = 0;
    if kt == 99 && load8(t, k + 1) == 34 {
        // c"..."
        let q: u32 = k + 2;
        let o: u32 = doff;
        while q < le && load8(t, q) != 34 {
            if load8(t, q) == 92 {
                let h1: u32 = hexv(load8(t, q + 1));
                let h2: u32 = hexv(load8(t, q + 2));
                store8(gb, o, (h1 * 16 + h2) as u8);
                o = o + 1;
                q = q + 3;
            } else {
                store8(gb, o, load8(t, q) as u8);
                o = o + 1;
                q = q + 1;
            }
        }
        sz = o - doff;
    } else {
        if lit_at(t, k, le, "zeroinitializer") == 1 {
            sz = ty_size(t, to, tl);
        } else {
            let nv: u64 = num_at(t, k, le);
            let v: u32 = lo32(nv);
            let o: u32 = doff;
            let b: u32 = 0;
            while b < sz {
                store8(gb, o + b, ((v / pow256(b)) % 256) as u8);
                b = b + 1;
            }
        }
    }
    // 全零 -> bss (与参考实现一致: 判据是**内容**, 不是 zeroinitializer 关键字)
    let nz: u32 = 0;
    let q: u32 = 0;
    while q < sz {
        if load8(gb, doff + q) != 0 {
            nz = 1;
        }
        q = q + 1;
    }
    if nz == 0 {
        zero = 1;
    } else {
        setcell(tab, C_GB, doff + sz);
    }
    let gi: u32 = cell(tab, C_NG);
    if gi >= TB_G_MAX {
        let _f: u32 = fail("全局表满了 — 抬高 TB_G 的容量 (loment/tools/lomelf.lomt 的 TB_G_MAX)");
    }
    let gbase: u32 = TB_G + gi * 32;
    store32(tab, gbase + G_NOFF, noff);
    store32(tab, gbase + G_NLEN, nlen);
    store32(tab, gbase + G_TOFF, to);
    store32(tab, gbase + G_TLEN, tl);
    store32(tab, gbase + G_SIZE, sz);
    store32(tab, gbase + G_DOFF, doff);
    store32(tab, gbase + G_ADDR, 0);
    store32(tab, gbase + G_ZERO, zero);
    setcell(tab, C_NG, gi + 1);
    return sz;
}

fn hexv(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return 0;
}

fn pow256(b: u32) -> u32 {
    let v: u32 = 1;
    let i: u32 = 0;
    while i < b {
        v = v * 256;
        i = i + 1;
    }
    return v;
}

/// 第一遍: 扫全文, 收集全局。lc = 行数。
fn collect_globals(tab: ptr, t: ptr, n: u32, gb: ptr) {
    let i: u32 = 0;
    while i < n {
        let le: u32 = line_end(t, i, n);
        let ls: u32 = skip_sp(t, i, le);
        if ls < le && load8(t, ls) == 64 {
            one_global(tab, t, gb, ls, le);
        }
        i = le + 1;
    }
}

/// 第二遍: 定位 (有内容的进 data, 全零的进 bss), 并登记成标签。
fn place_globals(tab: ptr, t: ptr) {
    let n: u32 = cell(tab, C_NG);
    let dlen: u32 = align_to(cell(tab, C_GB), 8);
    let bss: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let gbase: u32 = TB_G + i * 32;
        let sz: u32 = load32(tab, gbase + G_SIZE);
        let z: u32 = load32(tab, gbase + G_ZERO);
        if z == 1 {
            bss = align_to(bss, 8);
            store32(tab, gbase + G_ADDR, data_base(tab) + dlen + bss);
            bss = bss + align_to(sz, 8);
        } else {
            store32(tab, gbase + G_ADDR, data_base(tab) + load32(tab, gbase + G_DOFF));
        }
        i = i + 1;
    }
    setcell(tab, C_BSS, bss);
    // 登记标签
    i = 0;
    while i < n {
        let gbase: u32 = TB_G + i * 32;
        lbl_add(tab, load32(tab, gbase + G_NOFF), load32(tab, gbase + G_NLEN), 0, 0,
                load32(tab, gbase + G_ADDR));
        i = i + 1;
    }
}

// ---------------------------------------------------------------- 指令降级

fn line_dest(t: ptr, ls: u32, le: u32) -> u64 {
    let i: u32 = skip_sp(t, ls, le);
    if i >= le {
        return 0;
    }
    if load8(t, i) != 37 {
        return 0;
    }
    let we: u32 = word_end(t, i, le);
    let j: u32 = skip_sp(t, we, le);
    if j < le && load8(t, j) == 61 {
        return pk16(i, we - i);
    }
    return 0;
}

fn lower(tab: ptr, out: ptr, c: u32, t: ptr, ls: u32, le: u32) -> u32 {
    let i: u32 = skip_sp(t, ls, le);
    if i >= le {
        return c;
    }
    if load8(t, i) == 59 {
        return c;
    }
    if load8(t, i) == 125 {
        return c;
    }
    // 基本块标签 `name:` —— 本档没有分支, 只跳过 (br/phi 是下一档)
    let e: u32 = le;
    while e > i && (load8(t, e - 1) == 32 || load8(t, e - 1) == 9 || load8(t, e - 1) == 13) {
        e = e - 1;
    }
    if e > i && load8(t, e - 1) == 58 {
        return c;
    }
    if lit_at(t, i, le, "alloca ") == 1 {
        return c;
    }
    if lit_at(t, i, le, "store ") == 1 {
        return do_store(tab, out, c, t, i + 6, le);
    }
    if lit_at(t, i, le, "load ") == 1 {
        return do_load(tab, out, c, t, i + 5, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "getelementptr") == 1 {
        return do_gep(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "extractvalue ") == 1 {
        return do_extract(tab, out, c, t, i + 13, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "insertvalue ") == 1 {
        return do_insert(tab, out, c, t, i + 12, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "icmp ") == 1 {
        return do_icmp(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "phi ") == 1 {
        return c;
    }
    if lit_at(t, i, le, "br") == 1 {
        return do_br(tab, out, c, t, i, le);
    }
    if lit_at(t, i, le, "switch ") == 1 {
        return do_switch(tab, out, c, t, i, le);
    }
    if lit_at(t, i, le, "atomicrmw ") == 1 {
        return do_atomic(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if binop_ty(t, i, le, "add") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 1);
    }
    if binop_ty(t, i, le, "sub") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 41);
    }
    if binop_ty(t, i, le, "mul") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 0);
    }
    if binop_ty(t, i, le, "and") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 33);
    }
    if binop_ty(t, i, le, "xor") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 49);
    }
    if binop_ty(t, i, le, "or") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 3, 9);
    }
    if binop_ty(t, i, le, "sdiv") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 13);
    }
    if binop_ty(t, i, le, "udiv") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 5);
    }
    if binop_ty(t, i, le, "srem") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 29);
    }
    if binop_ty(t, i, le, "urem") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 21);
    }
    if binop_ty(t, i, le, "shl") == 1 {
        return do_shift(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 36);
    }
    if binop_ty(t, i, le, "lshr") == 1 {
        return do_shift(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 45);
    }
    if binop_ty(t, i, le, "ashr") == 1 {
        return do_shift(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 121);
    }
    if lit_at(t, i, le, "trunc ") == 1 || lit_at(t, i, le, "zext ") == 1
        || lit_at(t, i, le, "sext ") == 1 {
        return do_cast(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "ptrtoint ") == 1 {
        return do_ptrcast(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 0);
    }
    if lit_at(t, i, le, "inttoptr ") == 1 {
        return do_ptrcast(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 1);
    }
    if lit_at(t, i, le, "call ") == 1 {
        return do_call(tab, out, c, t, i + 5, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "ret") == 1 {
        return do_ret(tab, out, c, t, i, le);
    }
    if lit_at(t, i, le, "unreachable") == 1 {
        let d: u32 = e1(out, c, 15);
        return e1(out, d, 11);
    }
    return fail_line(t, ls, le);
}

fn fetch_ptr_operand(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, reg: u32) -> u32 {
    let pe: u32 = opnd(tab, t, i, le);
    return emit_get_ptr(tab, out, c, t, load32(tab, C_VLOFF), load32(tab, C_VLLEN), reg);
}

fn do_load(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let j: u32 = skip_comma(t, to + tl, le);
    if is_agg(t, to, tl) == 1 {
        let d: u32 = emit_agg_addr(tab, out, c, t, doff, dlen, RDI);
        d = fetch_ptr_operand(tab, out, d, t, j, le, RSI);
        return em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
    }
    let sz: u32 = ty_size(t, to, tl);
    let d: u32 = fetch_ptr_operand(tab, out, c, t, j, le, RAX);
    d = em_load_sized(out, d, RAX, RAX, 0, sz);
    d = em_zext64(out, d, RAX, sz);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_store(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, i + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let k: u32 = skip_comma(t, ve, le);
    if is_agg(t, to, tl) == 1 {
        let d: u32 = fetch_ptr_operand(tab, out, c, t, k, le, RDI);
        d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
        return em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
    }
    let sz: u32 = ty_size(t, to, tl);
    let d: u32 = emit_get(tab, out, c, t, to, tl, vs, ve - vs, RAX);
    d = fetch_ptr_operand(tab, out, d, t, k, le, RCX);
    return em_store_sized(out, d, RCX, 0, RAX, sz);
}

fn do_gep(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let j: u32 = skip_sp(t, i + 13, le);
    if lit_at(t, j, le, "inbounds") == 1 {
        j = skip_sp(t, j + 8, le);
    }
    let ts: u64 = type_span(t, j, le);
    let co: u32 = hi32(ts);
    let cl: u32 = lo32(ts);
    let k: u32 = skip_comma(t, co + cl, le);
    let pe: u32 = opnd(tab, t, k, le);
    let d: u32 = emit_get_ptr(tab, out, c, t, load32(tab, C_VLOFF), load32(tab, C_VLLEN), RAX);
    let cur_o: u32 = co;
    let cur_l: u32 = cl;
    let k2: u32 = skip_comma(t, pe, le);
    while k2 < le {
        let ie: u32 = opnd(tab, t, k2, le);
        let vo: u32 = load32(tab, C_VLOFF);
        let vl: u32 = load32(tab, C_VLLEN);
        let to: u32 = load32(tab, C_TYOFF);
        let tl: u32 = load32(tab, C_TYLEN);
        // 参考实现: 先无条件取下标值 (结构体那条也会发这一句)
        d = emit_get(tab, out, d, t, to, tl, vo, vl, RCX);
        if load8(t, cur_o) == 91 {
            let es: u64 = arr_elem(t, cur_o, cur_l);
            let step: u32 = ty_size(t, hi32(es), lo32(es));
            cur_o = hi32(es);
            cur_l = lo32(es);
            if step != 1 {
                d = em_mov_ri64(out, d, RDX, step as u64);
                d = em_imul_rr(out, d, RCX, RDX);
            }
            d = em_alu_rr(out, d, 1, RAX, RCX);
        } else {
            if load8(t, cur_o) == 123 {
                let nx2: u64 = num_at(t, vo, le);
                let idx2: u32 = lo32(nx2);
                let fo2: u32 = field_off(t, cur_o, cur_l, idx2);
                if fo2 != 0 {
                    d = em_alu_ri(out, d, ADD, RAX, fo2);
                }
                let fts2: u64 = field_ty(t, cur_o, cur_l, idx2);
                cur_o = hi32(fts2);
                cur_l = lo32(fts2);
            } else {
                let step2: u32 = ty_size(t, cur_o, cur_l);
                if step2 != 1 {
                    d = em_mov_ri64(out, d, RDX, step2 as u64);
                    d = em_imul_rr(out, d, RCX, RDX);
                }
                d = em_alu_rr(out, d, 1, RAX, RCX);
            }
        }
        k2 = skip_comma(t, ie, le);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_extract(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let ao: u32 = hi32(ts);
    let al: u32 = lo32(ts);
    let j: u32 = skip_sp(t, ao + al, le);
    let ve: u32 = word_end(t, j, le);
    let k: u32 = skip_comma(t, ve, le);
    let nx: u64 = num_at(t, k, le);
    let idx: u32 = lo32(nx);
    let off: u32 = field_off(t, ao, al, idx);
    let fts: u64 = field_ty(t, ao, al, idx);
    let fo: u32 = hi32(fts);
    let fl: u32 = lo32(fts);
    let d: u32 = c;
    if is_agg(t, fo, fl) == 1 {
        d = emit_agg_addr(tab, out, d, t, doff, dlen, RDI);
        d = emit_agg_addr(tab, out, d, t, j, ve - j, RAX);
        d = em_lea(out, d, RSI, RAX, off);
        return em_copy(out, d, RDI, RSI, ty_size(t, fo, fl));
    }
    let fs: u32 = ty_size(t, fo, fl);
    d = emit_agg_addr(tab, out, d, t, j, ve - j, RAX);
    d = em_load_sized(out, d, RAX, RAX, off, fs);
    d = em_zext64(out, d, RAX, fs);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_insert(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let ao: u32 = hi32(ts);
    let al: u32 = lo32(ts);
    let sz: u32 = ty_size(t, ao, al);
    let j: u32 = skip_sp(t, ao + al, le);
    let ae: u32 = word_end(t, j, le);
    let k: u32 = skip_comma(t, ae, le);
    let ety: u64 = type_span(t, k, le);
    let eo: u32 = hi32(ety);
    let el: u32 = lo32(ety);
    let evs: u32 = skip_sp(t, eo + el, le);
    let eve: u32 = word_end(t, evs, le);
    let k2: u32 = skip_comma(t, eve, le);
    let nx: u64 = num_at(t, k2, le);
    let off: u32 = field_off(t, ao, al, lo32(nx));
    let so: u32 = slot_find(tab, t, doff, dlen);
    let d: u32 = c;
    if lit_at(t, j, ae, "undef") == 1 {
        d = em_lea(out, d, RDI, RBP, so);
        d = em_mov_ri64(out, d, RCX, sz as u64);
        d = em_mov_ri32(out, d, RAX, 0);
        d = e1(out, d, 243);
        d = e1(out, d, 170);
    } else {
        d = em_lea(out, d, RDI, RBP, so);
        d = emit_agg_addr(tab, out, d, t, j, ae - j, RSI);
        d = em_copy(out, d, RDI, RSI, sz);
    }
    if is_agg(t, eo, el) == 1 {
        d = em_lea(out, d, RDI, RBP, so);
        if off != 0 {
            d = em_alu_ri(out, d, ADD, RDI, off);
        }
        d = emit_agg_addr(tab, out, d, t, evs, eve - evs, RSI);
        return em_copy(out, d, RDI, RSI, ty_size(t, eo, el));
    }
    let es: u32 = ty_size(t, eo, el);
    d = emit_get(tab, out, d, t, eo, el, evs, eve - evs, RAX);
    return em_store_sized(out, d, RBP, so + off, RAX, es);
}

fn nargs_of(t: ptr, lp: u32, rp: u32) -> u32 {
    let a: u32 = skip_sp(t, lp + 1, rp);
    let n: u32 = 0;
    while a < rp {
        let ts: u64 = type_span(t, a, rp);
        let j: u32 = skip_sp(t, hi32(ts) + lo32(ts), rp);
        let ve: u32 = word_end(t, j, rp);
        a = skip_comma(t, ve, rp);
        n = n + 1;
    }
    return n;
}

/// 第 k 个实参的起点 (越界返回 rp)。
fn arg_start(t: ptr, lp: u32, rp: u32, k: u32) -> u32 {
    let a: u32 = skip_sp(t, lp + 1, rp);
    let i: u32 = 0;
    while i < k && a < rp {
        let ts: u64 = type_span(t, a, rp);
        let j: u32 = skip_sp(t, hi32(ts) + lo32(ts), rp);
        let ve: u32 = word_end(t, j, rp);
        a = skip_comma(t, ve, rp);
        i = i + 1;
    }
    return a;
}

/// 实参列表的括号区间: 写入 lp/rp 并返回; 找不到返回 0。
fn arg_parens(t: ptr, from: u32, le: u32) -> u64 {
    let lp: u32 = 0;
    let k: u32 = from;
    while k < le {
        if load8(t, k) == 40 && lp == 0 {
            lp = k;
        }
        k = k + 1;
    }
    if lp == 0 {
        return 0;
    }
    let rp: u32 = lp;
    let k2: u32 = lp;
    while k2 < le {
        if load8(t, k2) == 41 {
            rp = k2;
        }
        k2 = k2 + 1;
    }
    return pk16(lp, rp);
}

fn do_call(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let j: u32 = skip_sp(t, i, le);
    let has_ret: u32 = 1;
    let ret_agg: u32 = 0;
    if lit_at(t, j, le, "void") == 1 {
        has_ret = 0;
        j = skip_sp(t, j + 4, le);
    } else {
        let ts: u64 = type_span(t, j, le);
        if is_agg(t, hi32(ts), lo32(ts)) == 1 {
            ret_agg = 1;
        }
        j = skip_sp(t, hi32(ts) + lo32(ts), le);
    }
    if lit_at(t, j, le, "asm ") == 1 {
        return do_call_asm(tab, out, c, t, j, le, doff, dlen);
    }
    let cs: u32 = j;
    let ce: u32 = word_end(t, j, le);
    let pr: u64 = arg_parens(t, ce, le);
    let lp: u32 = hi32(pr);
    let rp: u32 = lo32(pr);
    let nargs: u32 = nargs_of(t, lp, rp);
    // ---- 外部函数 (docs/173): 实参走**寄存器**, 不走我们自己的栈约定。
    if ext_has(tab, t, cs + 1, ce - cs - 1) == 1 {
        return do_call_extern(tab, out, c, t, lp, rp, nargs, cs, ce, has_ret + ret_agg * 2);
    }
    let total: u32 = 0;
    let q: u32 = 0;
    while q < nargs {
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        if is_agg(t, to, tl) == 1 {
            total = total + align_to(ty_size(t, to, tl), 8);
        } else {
            total = total + 8;
        }
        q = q + 1;
    }
    if ret_agg == 1 {
        total = total + 8;                        // 隐藏结果指针那 8 字节
    }
    let d: u32 = c;
    q = nargs;
    while q > 0 {
        q = q - 1;
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        let vs: u32 = skip_sp(t, to + tl, rp);
        let ve: u32 = word_end(t, vs, rp);
        if is_agg(t, to, tl) == 1 {
            d = em_alu_ri(out, d, SUB, RSP, align_to(ty_size(t, to, tl), 8));
            d = em_mov_rr(out, d, RDI, RSP, 1);
            d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
            d = em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
        } else {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
            d = em_push(out, d, RAX);
        }
    }
    if ret_agg == 1 {
        d = em_lea(out, d, RAX, RBP, slot_find(tab, t, doff, dlen));
        d = em_push(out, d, RAX);
    }
    if lit_at(t, cs, ce, "@llvm.trap") == 1 {
        d = e1(out, d, 15);
        d = e1(out, d, 11);
    } else {
        d = em_call_lbl(out, d, tab, cs + 1, ce - cs - 1);
    }
    if total != 0 {
        d = em_alu_ri(out, d, ADD, RSP, total);
    }
    if has_ret == 1 && ret_agg == 0 {
        d = emit_put(tab, out, d, t, doff, dlen, RAX);
    }
    return d;
}

/// 内联汇编 syscall: `asm sideeffect "syscall", "={ax},{ax},{di},...", (args)`。
fn asm_code(t: ptr, s: u32, e: u32) -> u32 {
    if e - s == 2 && load8(t, s) == 97 && load8(t, s + 1) == 120 {
        return 1;                                   // ax
    }
    if e - s == 2 && load8(t, s) == 100 && load8(t, s + 1) == 105 {
        return 2;                                   // di
    }
    if e - s == 2 && load8(t, s) == 115 && load8(t, s + 1) == 105 {
        return 3;                                   // si
    }
    if e - s == 2 && load8(t, s) == 100 && load8(t, s + 1) == 120 {
        return 4;                                   // dx
    }
    if e - s == 3 && load8(t, s) == 114 && load8(t, s + 1) == 49 && load8(t, s + 2) == 48 {
        return 5;                                   // r10
    }
    if e - s == 2 && load8(t, s) == 114 && load8(t, s + 1) == 56 {
        return 6;                                   // r8
    }
    return 0;
}

fn asm_reg(code: u32) -> u32 {
    if code == 1 {
        return RAX;
    }
    if code == 2 {
        return RDI;
    }
    if code == 3 {
        return RSI;
    }
    if code == 4 {
        return RDX;
    }
    if code == 5 {
        return 10;
    }
    return 8;
}

/// 第 k 个实参对应的寄存器码 (约束里按顺序数, 跳过 ={..} 与 ~{..})。
fn arg_code(t: ptr, p3: u32, p4: u32, k: u32) -> u32 {
    let ci: u32 = p3 + 1;
    let ai: u32 = 0;
    let out: u32 = 0;
    while ci < p4 {
        if load8(t, ci) == 123 {
            let re: u32 = ci + 1;
            let re2: u32 = re;
            while re2 < p4 && load8(t, re2) != 125 {
                re2 = re2 + 1;
            }
            if ci >= p3 + 2 {
                let prev: u32 = load8(t, ci - 1);
                if prev != 61 && prev != 126 {
                    if ai == k {
                        out = asm_code(t, re, re2);
                    }
                    ai = ai + 1;
                }
            }
            ci = re2 + 1;
        } else {
            ci = ci + 1;
        }
    }
    return out;
}

fn do_call_asm(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    // 前四个引号: "syscall" 与 "约束"
    let nq: u32 = 0;
    let p3: u32 = 0;
    let p4: u32 = 0;
    let k: u32 = i;
    while k < le {
        if load8(t, k) == 34 {
            if nq == 2 {
                p3 = k;
            }
            if nq == 3 {
                p4 = k;
            }
            nq = nq + 1;
        }
        k = k + 1;
    }
    if p3 == 0 || p4 == 0 {
        return fail("内联汇编的约束串解析不了");
    }
    let pr: u64 = arg_parens(t, p4, le);
    let lp: u32 = hi32(pr);
    let rp: u32 = lo32(pr);
    let nargs: u32 = nargs_of(t, lp, rp);
    let d: u32 = c;
    // rax 最后写, 其余先写
    let code: u32 = 2;
    while code <= 6 {
        let q: u32 = 0;
        while q < nargs {
            if arg_code(t, p3, p4, q) == code {
                let a2: u32 = arg_start(t, lp, rp, q);
                let ts: u64 = type_span(t, a2, rp);
                let to: u32 = hi32(ts);
                let tl: u32 = lo32(ts);
                let vs: u32 = skip_sp(t, to + tl, rp);
                let ve: u32 = word_end(t, vs, rp);
                d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, asm_reg(code));
            }
            q = q + 1;
        }
        code = code + 1;
    }
    let q2: u32 = 0;
    while q2 < nargs {
        if arg_code(t, p3, p4, q2) == 1 {
            let a2: u32 = arg_start(t, lp, rp, q2);
            let ts: u64 = type_span(t, a2, rp);
            let to: u32 = hi32(ts);
            let tl: u32 = lo32(ts);
            let vs: u32 = skip_sp(t, to + tl, rp);
            let ve: u32 = word_end(t, vs, rp);
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        }
        q2 = q2 + 1;
    }
    if cell(tab, C_PE) == 1 {
        // Windows 没有 syscall 指令：改成 call __win_syscall，由 shim 按号派发
        let d2: u32 = e1(out, d, 232);          // E8
        let disp: u32 = cell(tab, C_SHIM) - (d2 + 4);
        d = e4(out, d2, disp);
    } else {
        d = e1(out, d, 15);
        d = e1(out, d, 5);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_cast(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let kind: u32 = 0;
    let bs: u32 = i + 6;
    if lit_at(t, i, le, "zext ") == 1 {
        kind = 1;
        bs = i + 5;
    }
    if lit_at(t, i, le, "sext ") == 1 {
        kind = 2;
        bs = i + 5;
    }
    let fts: u64 = type_span(t, bs, le);
    let fo: u32 = hi32(fts);
    let fl: u32 = lo32(fts);
    let vs: u32 = skip_sp(t, fo + fl, le);
    let ve: u32 = word_end(t, vs, le);
    let tsz: u32 = size_after_to(t, i, le);
    let fsz: u32 = ty_size(t, fo, fl);
    let d: u32 = emit_get(tab, out, c, t, fo, fl, vs, ve - vs, RAX);
    if kind == 1 {
        d = em_zext64(out, d, RAX, fsz);
    }
    if kind == 2 {
        d = em_sext64(out, d, RAX, fsz);
    }
    if tsz < 8 {
        d = em_zext64(out, d, RAX, tsz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_ptrcast(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
              to_ptr: u32) -> u32 {
    let bs: u32 = i + 9;
    if to_ptr == 1 {
        bs = i + 8;
    }
    let fts: u64 = type_span(t, bs, le);
    let fo: u32 = hi32(fts);
    let fl: u32 = lo32(fts);
    let vs: u32 = skip_sp(t, fo + fl, le);
    let ve: u32 = word_end(t, vs, le);
    let tsz: u32 = size_after_to(t, i, le);
    let d: u32 = c;
    if to_ptr == 1 {
        d = emit_get(tab, out, d, t, fo, fl, vs, ve - vs, RAX);
    } else {
        d = emit_get_ptr(tab, out, d, t, vs, ve - vs, RAX);
    }
    if tsz < 8 {
        d = em_zext64(out, d, RAX, tsz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_ret(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let j: u32 = skip_sp(t, i + 3, le);
    let d: u32 = c;
    if lit_at(t, j, le, "void") == 0 {
        let ts: u64 = type_span(t, j, le);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        let vs: u32 = skip_sp(t, to + tl, le);
        let ve: u32 = word_end(t, vs, le);
        if is_agg(t, to, tl) == 1 {
            d = em_mov_rm(out, d, RDI, RBP, 16);          // 取隐藏结果指针
            d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
            d = em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
            d = em_mov_rm(out, d, RAX, RBP, 16);
        } else {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        }
    }
    d = e1(out, d, 201);
    return e1(out, d, 195);
}

// ---------------------------------------------------------------- 函数发射

/// 本函数第一个 `{` 与末尾 `}` 之间的行区内, 规划帧 (槽 + alloca)。
fn plan_frame(tab: ptr, t: ptr, fs: u32, fe: u32) {
    setcell(tab, C_NPHI, 0);
    let i: u32 = fs;
    let cbo: u32 = 0;
    let cbl: u32 = 0;
    while i < fe {
        let ls: u32 = skip_sp(t, i, fe);
        let le: u32 = logical_end(t, i, fe);
        // 基本块标签?
        let e2: u32 = le;
        let go2: u32 = 1;
        while e2 > ls && go2 == 1 {
            let c2: u32 = load8(t, e2 - 1);
            if c2 == 32 || c2 == 9 || c2 == 13 {
                e2 = e2 - 1;
            } else {
                go2 = 0;
            }
        }
        let is_blk: u32 = 0;
        if e2 > ls && load8(t, e2 - 1) == 58 {
            is_blk = 1;
        }
        if is_blk == 1 {
            cbo = ls;
            cbl = e2 - 1 - ls;
        }
        let dst: u64 = line_dest(t, ls, le);
        if dst != 0 {
            let dd: u32 = skip_sp(t, hi32(dst) + lo32(dst), le);
            let dd2: u32 = skip_sp(t, dd + 1, le);
            if lit_at(t, dd2, le, "phi ") == 1 {
                let k: u32 = cell(tab, C_NPHI);
                if k >= TB_PHI_MAX {
                    let _f: u32 = fail("phi 表满了 (单个函数) — 抬高 TB_PHI 的容量 (loment/tools/lomelf.lomt 的 TB_PHI_MAX)");
                }
                let pb: u32 = TB_PHI + k * 16;
                store32(tab, pb + PH_BOFF, cbo);
                store32(tab, pb + PH_BLEN, cbl);
                store32(tab, pb + PH_IOFF, hi32(dst));
                store32(tab, pb + PH_ILEN, le - hi32(dst));
                setcell(tab, C_NPHI, k + 1);
            }
        }
        if dst != 0 {
            let do: u32 = hi32(dst);
            let dl: u32 = lo32(dst);
            let op: u32 = skip_sp(t, do + dl, le);
            let op2: u32 = skip_sp(t, op + 1, le);
            if lit_at(t, op2, le, "alloca ") == 1 {
                let ts: u64 = type_span(t, op2 + 7, le);
                let sz: u32 = ty_size(t, hi32(ts), lo32(ts));
                let fr: u32 = align_to(cell(tab, C_FRAME), 8) + align_to(sz, 8);
                setcell(tab, C_FRAME, fr);
                alloc_put(tab, do, dl, 0 - fr, sz);
            } else {
                if slot_has(tab, t, do, dl) == 0 {
                    let rs: u32 = result_size(t, op2, le);
                    if rs != 0 {
                        let fr: u32 = align_to(cell(tab, C_FRAME), 8) + align_to(rs, 8);
                        setcell(tab, C_FRAME, fr);
                        slot_put(tab, do, dl, 0 - fr);
                    }
                }
            }
        }
        i = le + 1;
    }
}

/// 函数头: `define [internal] RET @name(PARAMS) {`; 记下参数槽。
fn plan_params(tab: ptr, t: ptr, ls: u32, le: u32) -> u32 {
    let j: u32 = skip_sp(t, ls + 6, le);
    if lit_at(t, j, le, "internal") == 1 {
        j = skip_sp(t, j + 8, le);
    }
    if lit_at(t, j, le, "private") == 1 {
        j = skip_sp(t, j + 7, le);
    }
    let rts: u64 = type_span(t, j, le);
    let j2: u32 = skip_sp(t, hi32(rts) + lo32(rts), le);
    let ns: u32 = j2 + 1;
    let ne: u32 = word_end(t, ns, le);
    let lp: u32 = skip_sp(t, ne, le);
    let rp: u32 = le;
    let k: u32 = lp;
    while k < le {
        if load8(t, k) == 41 {
            rp = k;
        }
        k = k + 1;
    }
    let arg: u32 = 16;
    if is_agg(t, hi32(rts), lo32(rts)) == 1 {
        arg = 24;                                 // 隐藏结果指针占 [rbp+16]
    }
    let a: u32 = skip_sp(t, lp + 1, rp);
    while a < rp {
        let ae: u32 = opnd(tab, t, a, rp);
        let to: u32 = load32(tab, C_TYOFF);
        let tl: u32 = load32(tab, C_TYLEN);
        let vs: u32 = load32(tab, C_VLOFF);
        let vl: u32 = load32(tab, C_VLLEN);
        let sz: u32 = ty_size(t, to, tl);
        let esz: u32 = sz;
        if esz < 8 {
            esz = 8;
        }
        slot_put(tab, vs, vl, arg);
        arg = arg + align_to(esz, 8);
        a = skip_comma(t, ae, rp);
    }
    return ns;
}

// ---------------------------------------------------------------- 外部目标文件 (FFI, docs/173)
//
// 与 tools/lomelf.py 的 ForeignObject / compile_ll 后半段逐字对齐。第 1 阶段只认
// **静态、freestanding 的 ELF64 可重定位对象**: 取代码节的字节 + 它导出的全局符号。
// 两条边界**硬失败**而不是猜 (猜的后果是"调到一个错地址", 那是运行期崩溃而不是编译期报错):
//
//   * 对象里有重定位 -> 报错 (第 1 阶段不做跨对象重定位);
//   * 对象引用未定义符号 (典型是 libc 的 printf/malloc) -> 报错 (不链 libc)。
//
// **为什么代码节要认 `.text.*`**: clang 把所有函数塞进一个 `.text`, 但 rustc/LLVM 默认
// **按函数分节** (每个函数一个 `.text.<名字>`), 此时 `.text` 本身是空的。只认 `.text`
// 会把 Rust 那一族直接判成"没有代码节" (参考侧实测就是这么红的)。所以把所有代码节
// **按节表顺序拼成一块**, 并记下每节在拼接结果里的起点。

fn rd16(p: ptr, off: u32) -> u32 {
    let a: u32 = load8(p, off) as u32;
    let b: u32 = load8(p, off + 1) as u32;
    return a + b * 256;
}

fn rd64(p: ptr, off: u32) -> u64 {
    let lo: u64 = load32(p, off) as u64;
    let hi: u64 = load32(p, off + 4) as u64;
    return lo + hi * PHI;
}

/// 写到 NUL 为止 (外部文件里的 C 字符串)。上限 4096 —— 畸形输入不许读飞。
fn write_cstr(fd: u64, p: ptr, off: u32) -> u64 {
    let n: u32 = 0;
    while n < 4096 && load8(p, off + n) != 0 {
        n = n + 1;
    }
    return write_all(fd, ptr_add(p, off), n as u64);
}

fn cstr_len(p: ptr, off: u32) -> u32 {
    let n: u32 = 0;
    while n < 4096 && load8(p, off + n) != 0 {
        n = n + 1;
    }
    return n;
}

/// 把 16 对齐的缝隙显式**清零**。
///
/// 参考实现是 `while len(buf) % 16: buf.append(0)` —— 那些补齐字节**会进最终的 ELF**
/// (build_elf 从 [0, tlen) 整段拷)。自举侧若只是跳到对齐位置而**不写**, 拷出去的是 arena
/// 里的残留字节: 首次分配恰好是内核给的零页, 于是能对上, 但那**不是**一段可靠的性质 ——
/// 只要 arena 被复用过一次就会悄悄变得与参考不同。所以这里明写。
fn pad_zero(p: ptr, from: u32, to: u32) {
    let k: u32 = from;
    while k < to {
        store8(p, k, 0 as u8);
        k = k + 1;
    }
}

// ELF64 节头字段 (相对节头起点的偏移) 与节表定位。字段偏移见 Elf64_Shdr:
// sh_name@0 sh_type@4 sh_flags@8 sh_addr@16 sh_offset@24 sh_size@32 sh_link@40
// sh_info@44 sh_addralign@48 sh_entsize@56 (共 64 字节)。
fn sec_hdr(raw: ptr, k: u32) -> u32 {
    return load32(raw, 40) + k * rd16(raw, 58);
}

fn sh_type(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 4);
}

fn sh_off(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 24);
}

fn sh_size(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 32);
}

fn sh_link(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 40);
}

fn sh_info(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 44);
}

fn sh_num(raw: ptr) -> u32 {
    return rd16(raw, 60);
}

/// 第 k 节的**节名**在文件里的偏移 (取自 .shstrtab)。
fn sec_name(raw: ptr, k: u32) -> u32 {
    return sh_off(raw, rd16(raw, 62)) + load32(raw, sec_hdr(raw, k));
}

/// `.text` 或 `.text.*` —— 见上面"为什么必须认 .text.*"。
fn is_code_sec(raw: ptr, noff: u32) -> u32 {
    if load8(raw, noff) != 46 || load8(raw, noff + 1) != 116 || load8(raw, noff + 2) != 101
        || load8(raw, noff + 3) != 120 || load8(raw, noff + 4) != 116 {
        return 0;
    }
    if load8(raw, noff + 5) == 0 || load8(raw, noff + 5) == 46 {
        return 1;
    }
    return 0;
}

fn has_code(raw: ptr) -> u32 {
    let ns: u32 = sh_num(raw);
    let i: u32 = 0;
    while i < ns {
        if sh_type(raw, i) == 1 && is_code_sec(raw, sec_name(raw, i)) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 第 k 节在**拼接后的外部代码**里的起点: 它之前每个代码节先对齐 16 再累加长度。
/// 与参考实现里 `while len(buf) % 16: buf.append(0); s["at"] = len(buf)` 同一件事。
fn sec_at(raw: ptr, k: u32) -> u32 {
    let cur: u32 = 0;
    let i: u32 = 0;
    while i < k {
        if sh_type(raw, i) == 1 && is_code_sec(raw, sec_name(raw, i)) == 1 {
            cur = align_to(cur, 16) + sh_size(raw, i);
        }
        i = i + 1;
    }
    return align_to(cur, 16);
}

// ---------------------------------------------------------------- 外部符号名 (declare)

fn ext_add(tab: ptr, noff: u32, nlen: u32) {
    let k: u32 = cell(tab, C_NEXT);
    let base: u32 = TB_EXT + k * 8;
    store32(tab, base + E_NOFF, noff);
    store32(tab, base + E_NLEN, nlen);
    setcell(tab, C_NEXT, k + 1);
}

fn ext_has(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NEXT);
    while k < n {
        let base: u32 = TB_EXT + k * 8;
        if span_eq(t, load32(tab, base + E_NOFF), load32(tab, base + E_NLEN), noff, nlen) == 1 {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

/// 扫 `declare` 行, 记下外部符号名 (docs/173)。`llvm.*` **不是外部函数**: 运行期块里有
/// `declare void @llvm.trap()`, 而 do_call 对它是特判 (发 ud2)。把它收进来会抢进 C ABI
/// 那条路, 于是 `call llvm.trap` 在回填时报"未定义的标签" —— 参考侧实测把 elf 判据从
/// 7/7 打到 4/7。所以这里滤掉 (除 llvm.* 之外没有别的内建 declare)。
fn collect_externs(tab: ptr, t: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        let le: u32 = line_end(t, i, n);
        let ls: u32 = skip_sp(t, i, le);
        if lit_at(t, ls, le, "declare ") == 1 {
            let j: u32 = ls + 8;
            while j < le && load8(t, j) != 64 {
                j = j + 1;
            }
            if j < le {
                let ne: u32 = word_end(t, j + 1, le);
                if lit_at(t, j + 1, ne, "llvm.") == 0 {
                    ext_add(tab, j + 1, ne - (j + 1));
                }
            }
        }
        i = le + 1;
    }
}

// ---------------------------------------------------------------- C ABI 调用点 (docs/173)

/// System V AMD64 整数实参寄存器: rdi rsi rdx rcx r8 r9。我们**自己的**约定是实参走栈,
/// 这一套只给 extern 调用点。
fn c_arg_reg(k: u32) -> u32 {
    if k == 0 {
        return RDI;
    }
    if k == 1 {
        return RSI;
    }
    if k == 2 {
        return RDX;
    }
    if k == 3 {
        return RCX;
    }
    if k == 4 {
        return R8;
    }
    return R9;
}

/// extern 调用: 实参进寄存器, 不走我们自己的栈约定。
///
/// 求值顺序**从右往左**: 逐个算进 RAX 再 push, 然后**从左往右** pop 进目标寄存器 ——
/// 这样 push 完栈顶正好是第 0 个实参, pop 的先后与寄存器顺序自然对齐。**不能**直接
/// 一个个 `emit_get(..., RDI)`: emit_get 内部要用 RAX/RCX 求值, 会把前面已经放好的
/// 寄存器踩掉。
///
/// flags: bit0 = 有返回值, bit1 = 返回值是聚合 (第 1 阶段直接拒)。
fn do_call_extern(tab: ptr, out: ptr, c: u32, t: ptr, lp: u32, rp: u32, nargs: u32,
                  cs: u32, ce: u32, flags: u32) -> u32 {
    if nargs > 6 {
        return fail("extern 调用: 第 1 阶段最多 6 个实参 (docs/173 §3)");
    }
    if flags % 4 >= 2 {
        return fail("extern 调用: 第 1 阶段不接受聚合返回值");
    }
    let d: u32 = c;
    let q: u32 = nargs;
    while q > 0 {
        q = q - 1;
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        if is_agg(t, to, tl) == 1 {
            return fail("extern 调用: 第 1 阶段不接受聚合实参");
        }
        let vs: u32 = skip_sp(t, to + tl, rp);
        let ve: u32 = word_end(t, vs, rp);
        d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        d = em_push(out, d, RAX);
    }
    let k: u32 = 0;
    while k < nargs {
        d = em_pop(out, d, c_arg_reg(k));
        k = k + 1;
    }
    d = em_call_lbl(out, d, tab, cs + 1, ce - cs - 1);
    // **返回值照旧落回目标槽** —— 与内部调用同一步。少了这一句, 调用结果**丢掉**, 后面
    // 读到的是那个槽的旧值: 症状是"程序能跑、结果是假 0" (参考侧实测第一版就是这样:
    // `c_add(3,4) + c_mul(5,6)` 退出码 0 而不是 37)。
    if flags % 2 == 1 {
        d = emit_put(tab, out, d, t, cell(tab, C_DESTO), cell(tab, C_DESTL), RAX);
    }
    return d;
}

// ---------------------------------------------------------------- 读一个外部目标文件

/// 读 `path` 那个 `.o`, 把它的代码节接到代码缓冲之后, 并为它导出的符号立标签。
/// 返回新的代码缓冲游标。四条边界都是**硬失败** (与参考实现同口径, docs/173 §3)。
fn link_object(tab: ptr, t: ptr, txt: ptr, d: u32, mem: ptr, path: ptr) -> u32 {
    let fd: i64 = open_ro(path);
    if fd < 0 {
        wstr(2, "lomelf: 打不开外部目标文件: ");
        write_cstr(2, path, 0);
        wstr(2, "\n");
        return die(1);
    }
    let rn: u64 = read_all(fd as u64, mem, OBJ_CAP as u64);
    syscall4(3, fd as u64, 0, 0);
    if rn == 0 {
        wstr(2, "lomelf: 外部目标文件为空: ");
        write_cstr(2, path, 0);
        wstr(2, "\n");
        return die(1);
    }
    if rn >= (OBJ_CAP as u64) {
        wstr(2, "lomelf: 外部目标文件超过 4 MiB 上限: ");
        write_cstr(2, path, 0);
        wstr(2, "\n");
        return die(1);
    }
    if load8(mem, 0) != 127 || load8(mem, 1) != 69 || load8(mem, 2) != 76
        || load8(mem, 3) != 70 || load8(mem, 4) != 2 || load8(mem, 5) != 1 {
        wstr(2, "lomelf: 不是 ELF64 小端目标文件: ");
        write_cstr(2, path, 0);
        wstr(2, "\n");
        return die(1);
    }
    if rd16(mem, 16) != 1 {
        wstr(2, "lomelf: 不是可重定位目标文件 (ET_REL): ");
        write_cstr(2, path, 0);
        wstr(2, "\n");
        return die(1);
    }
    if has_code(mem) == 0 {
        wstr(2, "lomelf: 没有代码节 (.text / .text.*): ");
        write_cstr(2, path, 0);
        wstr(2, "\n");
        return die(1);
    }
    // **未定义符号在这里不再是错误** (阶段 2): 它可能由**另一个对象**提供 —— 那正是多目标
    // 文件 C 库的形状 (`a.o` 调 `b.o`)。判定推迟到"所有对象都摆好、重定位都应用完"。
    // 之前那两段 (未定义就报错 / 见重定位就报错) 是在没有重定位能力时的硬拒; 现在两条都
    // 换成了**真的去做**, 做不出来才报 —— 免得从"硬拒"退化成"静默忽略重定位"(那是错编)。
    let ns: u32 = sh_num(mem);
    // 接在我们自己的代码之后 (16 对齐)。**先拼字节, 再立标签** —— 标签地址 = 起点 + 节错
    // + 符号值, 所以要先把每节的起点算出来。
    let at0: u32 = align_to(d, 16);
    pad_zero(txt, d, at0);
    // 记下这个对象的代码在缓冲里的起点 —— 重定位要按它算 `S + A - P`, 而**应用**要等到
    // 所有对象都摆好 (见 apply_relocs)。
    let oi: u32 = cell(tab, C_NOBJ);
    store32(tab, TB_OBJ + oi * 8 + O_TEXT, at0);
    setcell(tab, C_NOBJ, oi + 1);
    let dd: u32 = at0;
    let i3: u32 = 0;
    while i3 < ns {
        if sh_type(mem, i3) == 1 && is_code_sec(mem, sec_name(mem, i3)) == 1 {
            let nd: u32 = align_to(dd, 16);
            pad_zero(txt, dd, nd);
            dd = nd;
            copy_n(txt, dd, mem, sh_off(mem, i3), sh_size(mem, i3));
            dd = dd + sh_size(mem, i3);
        }
        i3 = i3 + 1;
    }
    let i4: u32 = 0;
    while i4 < ns {
        if sh_type(mem, i4) == 2 {
            let link2: u32 = sh_link(mem, i4);
            if link2 < ns {
                let stro2: u32 = sh_off(mem, link2);
                let so2: u32 = sh_off(mem, i4);
                let cnt2: u32 = sh_size(mem, i4) / 24;
                let k2: u32 = 0;
                while k2 < cnt2 {
                    let o2: u32 = so2 + k2 * 24;
                    let nmoff2: u32 = load32(mem, o2);
                    let shndx: u32 = rd16(mem, o2 + 6);
                    // **`st_info` 的高 4 位是绑定, 低 4 位是类型** (`(bind << 4) | type`)。
                    // 原文这里是 `% 16` —— 取到的是**类型**: 收定义时靠"类型是 FUNC/OBJECT"
                    // 误打误撞能对, 但判"未定义的符号是不是全局的"就整个失效 (实测它让归档的
                    // 固定点选不出成员)。与参考实现同一次修掉。
                    let bind: u32 = (load8(mem, o2 + 4) as u32) / 16;
                    // GLOBAL(1) / WEAK(2), 且落在某个代码节里。shndx 可以是保留值
                    // (SHN_ABS=0xfff1 等), 比节表长 —— 直接拿去索引会读飞, 所以先比大小。
                    if nmoff2 != 0 && shndx != 0 && shndx < ns && (bind == 1 || bind == 2) {
                        if sh_type(mem, shndx) == 1
                            && is_code_sec(mem, sec_name(mem, shndx)) == 1 {
                            // 名字必须拷进**输入缓冲尾部**的名字池: 标签表存的是偏移, 而
                            // lbl_find 拿输入缓冲当基 —— 名字留在 .o 的缓冲里, 下一个 .o
                            // 一读进来就被盖掉了。
                            let noff: u32 = copy_name(tab, t, mem, stro2 + nmoff2);
                            let nl: u32 = cstr_len(mem, stro2 + nmoff2);
                            if lbl_find(tab, t, noff, nl, 0, 0) == NO {
                                let val: u32 = lo32(rd64(mem, o2 + 8));
                                lbl_add(tab, noff, nl, 0, 0,
                                        TEXT_VADDR + at0 + sec_at(mem, shndx) + val);
                            }
                        }
                    }
                    k2 = k2 + 1;
                }
            }
        }
        i4 = i4 + 1;
    }
    // 重定位**只记不应用** (docs/173 阶段 2): 应用要等所有对象都摆好、标签都立好 ——
    // `a.o` 里的重定位可能指向只有 `b.o` 知道的地址。只认参考实现认的那六种; 其余**硬拒**
    // (不认识的类型猜一个偏移 = 跳到错地址, 那是运行期崩溃不是编译期报错)。落在非代码节上的
    // 也拒 —— 本档不摆那些节, 静默算出来的地址是错的。
    let i5: u32 = 0;
    while i5 < ns {
        if sh_type(mem, i5) == 4 && sh_size(mem, i5) > 0 {
            let tgt: u32 = sh_info(mem, i5);                  // sh_info = 被重定位的节
            if tgt >= ns || sh_type(mem, tgt) != 1
                || is_code_sec(mem, sec_name(mem, tgt)) == 0 {
                wstr(2, "lomelf: 重定位指向非代码节 (docs/173 §3)\n");
                return die(1);
            }
            let tsecat: u32 = sec_at(mem, tgt);
            // **两个不同的偏移, 别搞混** (第一版就在这里错了两次):
            //   `symsec` 是**符号表**节号; 符号记录在 `sh_off(symsec) + 下标*24`;
            //   名字串却在**它 `sh_link` 指向的 `.strtab`** 里 —— 与符号表**不是同一节**。
            //   拿符号表的偏移去查名字, 得到的是空串或垃圾, 报错里就印出一串乱码/空白。
            let symsec: u32 = sh_link(mem, i5);
            let symoff0: u32 = sh_off(mem, symsec);
            let stro3: u32 = sh_off(mem, sh_link(mem, symsec));
            let ents: u32 = sh_size(mem, i5) / 24;
            let k5: u32 = 0;
            while k5 < ents {
                let o5: u32 = sh_off(mem, i5) + k5 * 24;
                let roff: u32 = lo32(rd64(mem, o5));
                let rinfo: u64 = rd64(mem, o5 + 8);
                let ty: u32 = lo32(rinfo);
                let si: u32 = hi32(rinfo);
                if ty != 1 && ty != 2 && ty != 4 && ty != 10 && ty != 11 && ty != 24 {
                    wstr(2, "lomelf: 不认识的重定位类型 (docs/173 §3)\n");
                    return die(1);
                }
                let symoff: u32 = symoff0 + si * 24;
                let nmoff3: u32 = load32(mem, symoff);
                let nlen3: u32 = cstr_len(mem, stro3 + nmoff3);
                let noff3: u32 = copy_name(tab, t, mem, stro3 + nmoff3);
                let fi: u32 = cell(tab, C_NFREL);
                let fb: u32 = TB_FREL + fi * 32;
                store32(tab, fb + F2_OBJ, oi);
                store32(tab, fb + F2_AT, tsecat);
                store32(tab, fb + F2_OFF, roff);
                store32(tab, fb + F2_TY, ty);
                store32(tab, fb + F2_NOFF, noff3);
                store32(tab, fb + F2_NLEN, nlen3);
                store32(tab, fb + F2_ADD, lo32(rd64(mem, o5 + 16)));
                setcell(tab, C_NFREL, fi + 1);
                k5 = k5 + 1;
            }
        }
        i5 = i5 + 1;
    }
    return dd;
}

/// 应用外部目标文件的全部重定位。**必须在所有对象都摆好、标签都立好之后**跑 (docs/173 阶段 2)。
///
/// `PC64` 这里按**零扩展**写 (参考实现按有符号)。实测到不了这条路 —— 它只出现在数据节的
/// 64 位 PC 相对引用上, 而落在非代码节的重定位我们**一开始就拒了**。留个记号免得以后有人
/// 以为两边逐位一致。
fn apply_relocs(tab: ptr, t: ptr, txt: ptr) -> u32 {
    let n: u32 = cell(tab, C_NFREL);
    let i: u32 = 0;
    while i < n {
        let base: u32 = TB_FREL + i * 32;
        let oi: u32 = load32(tab, base + F2_OBJ);
        let target: u32 = lbl_find(tab, t, load32(tab, base + F2_NOFF),
                                   load32(tab, base + F2_NLEN), 0, 0);
        if target == NO {
            // **到链接结束才判"没人定义"**: 这是"多目标文件 C 库"与"引用 libc"的分界线 ——
            // 前者由另一个对象提供, 后者到链接结束都空着。
            wstr(2, "lomelf: 引用了未定义的符号 ");
            write_all(2, ptr_add(t, load32(tab, base + F2_NOFF)),
                      load32(tab, base + F2_NLEN) as u64);
            wstr(2, " —— 到链接结束都没人提供它 (第 2 阶段仍不链 libc, docs/173 §3)\n");
            return die(1);
        }
        let site: u32 = load32(tab, TB_OBJ + oi * 8 + O_TEXT)
                        + load32(tab, base + F2_AT) + load32(tab, base + F2_OFF);
        let p: u32 = TEXT_VADDR + site;                       // 公式里的 P
        let val: u32 = target + load32(tab, base + F2_ADD);   // 公式里的 S + A
        let ty: u32 = load32(tab, base + F2_TY);
        if ty == 2 || ty == 4 {
            store32(txt, site, val - p);                      // PC32 / PLT32
        } else if ty == 24 {
            w64(txt, site, (val - p) as u64);                 // PC64
        } else if ty == 1 {
            w64(txt, site, val as u64);                       // 64
        } else {
            store32(txt, site, val);                          // 32 / 32S
        }
        i = i + 1;
    }
    return 0;
}

/// 把外部符号名拷进输入缓冲尾部的名字池, 返回它在 `t` 里的偏移。
fn copy_name(tab: ptr, t: ptr, p: ptr, off: u32) -> u32 {
    let cur: u32 = cell(tab, C_EXTN);
    let n: u32 = cstr_len(p, off);
    if cur + n >= IN_CAP {
        return fail("输入缓冲没有空间放外部符号名");
    }
    let k: u32 = 0;
    while k < n {
        store8(t, cur + k, load8(p, off + k) as u8);
        k = k + 1;
    }
    setcell(tab, C_EXTN, cur + n);
    return cur;
}

// ---------------------------------------------------------------- 落盘与回填

fn w32(p: ptr, off: u32, v: u32) {
    store8(p, off, (v % 256) as u8);
    store8(p, off + 1, ((v / 256) % 256) as u8);
    store8(p, off + 2, ((v / 65536) % 256) as u8);
    store8(p, off + 3, ((v / 16777216) % 256) as u8);
}

fn w64(p: ptr, off: u32, v: u64) {
    let x: u64 = v;
    let i: u32 = 0;
    while i < 8 {
        store8(p, off + i, (x % 256) as u8);
        x = x / 256;
        i = i + 1;
    }
}

/// 把回填表里的 rel32/abs64 落到代码缓冲上。
fn resolve_fixups(tab: ptr, t: ptr, txt: ptr) -> u32 {
    let n: u32 = cell(tab, C_NFIX);
    let i: u32 = 0;
    while i < n {
        let base: u32 = TB_FIX + i * 28;
        let site: u32 = load32(tab, base + F_SITE);
        let kind: u32 = load32(tab, base + F_KIND);
        let no: u32 = load32(tab, base + F_NOFF);
        let nl: u32 = load32(tab, base + F_NLEN);
        let addr: u32 = lbl_find(tab, t, no, nl, load32(tab, base + F_BOFF),
                                 load32(tab, base + F_BLEN));
        if addr == NO {
            wstr(2, "lomelf: 未定义的标签: ");
            write_all(2, ptr_add(t, no), nl as u64);
            wstr(2, "\n");
            return die(1);
        }
        if kind == 1 {
            if cell(tab, C_PE) == 1 {
                w64(txt, site, PE_IMG_BASE + (addr as u64));
            } else {
                w64(txt, site, addr as u64);
            }
        } else {
            w32(txt, site, addr - (txt_base(tab) + site + 4));
        }
        i = i + 1;
    }
    return 0;
}

/// 组装 ELF: 头 + 两个 PT_LOAD。返回文件总长。
fn build_elf(tab: ptr, ob: ptr, txt: ptr, tlen: u32, gb: ptr, dlen: u32, bss: u32) -> u32 {
    let text_off: u32 = 4096;
    let data_off: u32 = align_to(text_off + tlen, 4096);
    let total: u32 = data_off + dlen;
    // e_ident
    store8(ob, 0, 127 as u8);
    store8(ob, 1, 69 as u8);
    store8(ob, 2, 76 as u8);
    store8(ob, 3, 70 as u8);
    store8(ob, 4, 2 as u8);
    store8(ob, 5, 1 as u8);
    store8(ob, 6, 1 as u8);
    store8(ob, 7, 0 as u8);
    let z: u32 = 8;
    while z < 16 {
        store8(ob, z, 0 as u8);
        z = z + 1;
    }
    // e_type=2, e_machine=0x3E, e_version=1
    store8(ob, 16, 2 as u8);
    store8(ob, 17, 0 as u8);
    store8(ob, 18, 62 as u8);
    store8(ob, 19, 0 as u8);
    w32(ob, 20, 1);
    // e_entry = TEXT_VADDR (入口桩在代码缓冲起始处)
    w64(ob, 24, TEXT_VADDR as u64);
    // e_phoff = 64
    w64(ob, 32, 64);
    // e_shoff = 0
    w64(ob, 40, 0);
    // e_flags = 0
    w32(ob, 48, 0);
    // e_ehsize = 64
    store8(ob, 52, 64 as u8);
    store8(ob, 53, 0 as u8);
    // e_phentsize = 56
    store8(ob, 54, 56 as u8);
    store8(ob, 55, 0 as u8);
    // e_phnum = 2
    store8(ob, 56, 2 as u8);
    store8(ob, 57, 0 as u8);
    // e_shentsize/e_shnum/e_shstrndx = 0
    store8(ob, 58, 0 as u8);
    store8(ob, 59, 0 as u8);
    store8(ob, 60, 0 as u8);
    store8(ob, 61, 0 as u8);
    store8(ob, 62, 0 as u8);
    store8(ob, 63, 0 as u8);
    // phdr 0: text (R+X)
    phdr(ob, 64, 5, text_off, TEXT_VADDR, tlen, tlen);
    // phdr 1: data (R+W)
    phdr(ob, 120, 6, data_off, DATA_VADDR, dlen, dlen + bss);
    // 拷文本与数据
    copy_n(ob, text_off, txt, 0, tlen);
    copy_n(ob, data_off, gb, 0, dlen);
    return total;
}

// ---------------------------------------------------------------- PE 写出

fn pe_sec(ob: ptr, at: u32, nm: str, vs: u32, va: u32, rs: u32, rp: u32, ch: u32) {
    let i: u32 = 0;
    while i < 8 {
        store8(ob, at + i, 0 as u8);
        i = i + 1;
    }
    i = 0;
    while i < str_len(nm) {
        store8(ob, at + i, str_byte(nm, i) as u8);
        i = i + 1;
    }
    w32(ob, at + 8, vs);
    w32(ob, at + 12, va);
    w32(ob, at + 16, rs);
    w32(ob, at + 20, rp);
    w32(ob, at + 36, ch);
}

/// 组装 PE: DOS 头 + PE 头 + 三个有文件的节。返回文件总长。
/// 节表按 RVA 升序；每节的 VirtualSize 铺到下一节起点 —— 节间有空洞加载器会拒收。
/// 入口桩在代码缓冲最前，所以 AddressOfEntryPoint 恒为 PE_TEXT_RVA。
fn build_pe(ob: ptr, txt: ptr, tlen: u32, gb: ptr, dlen: u32, idata: ptr, ilen: u32) -> u32 {
    let opt: u32 = 88;                                   // 64 + 4 + 20
    let st: u32 = 328;                                   // 节表起址
    let toff: u32 = align_to(st + 120, PE_FILE_ALIGN);
    let ioff: u32 = toff + align_to(tlen, PE_FILE_ALIGN);
    let doff: u32 = ioff + align_to(ilen, PE_FILE_ALIGN);
    let isize: u32 = align_to(PE_STATE_RVA + PE_WS_SIZE, PE_SEC_ALIGN);
    let i: u32 = 0;
    while i < st + 120 {
        store8(ob, i, 0 as u8);
        i = i + 1;
    }
    store8(ob, 0, 77 as u8);                             // 'M'
    store8(ob, 1, 90 as u8);                             // 'Z'
    store8(ob, 60, 64 as u8);                            // e_lfanew = 0x40
    store8(ob, 64, 80 as u8);                            // 'P'
    store8(ob, 65, 69 as u8);                            // 'E'
    store8(ob, 68, 100 as u8);                           // Machine 0x8664
    store8(ob, 69, 134 as u8);
    store8(ob, 70, 3 as u8);                             // NumberOfSections
    store8(ob, 84, 240 as u8);                           // SizeOfOptionalHeader
    store8(ob, 86, 34 as u8);                            // Characteristics 0x22
    store8(ob, opt + 0, 11 as u8);                       // Magic 0x20B
    store8(ob, opt + 1, 2 as u8);
    store8(ob, opt + 2, 14 as u8);                       // MajorLinkerVersion
    w32(ob, opt + 16, PE_TEXT_RVA);                      // AddressOfEntryPoint
    w32(ob, opt + 20, PE_TEXT_RVA);                      // BaseOfCode
    w32(ob, opt + 24, 0x40000000);                       // ImageBase = 0x140000000
    w32(ob, opt + 28, 1);
    w32(ob, opt + 32, PE_SEC_ALIGN);
    w32(ob, opt + 36, PE_FILE_ALIGN);
    store8(ob, opt + 40, 6 as u8);                       // MajorOperatingSystemVersion
    store8(ob, opt + 48, 6 as u8);                       // MajorSubsystemVersion
    w32(ob, opt + 56, isize);                            // SizeOfImage (PE32+: 56)
    w32(ob, opt + 60, toff);                             // SizeOfHeaders (PE32+: 60)
    store8(ob, opt + 68, 3 as u8);                       // Subsystem: console
    w32(ob, opt + 72, 16777216);                         // StackReserve 16 MiB
    w32(ob, opt + 80, 1048576);                          // StackCommit 1 MiB
    w32(ob, opt + 88, 1048576);                          // HeapReserve
    w32(ob, opt + 96, 4096);                             // HeapCommit
    w32(ob, opt + 108, 16);                              // NumberOfRvaAndSizes
    w32(ob, opt + 120, PE_IDATA_RVA);                    // DataDirectory[1] = Import
    w32(ob, opt + 124, 40);
    pe_sec(ob, st, ".text", PE_IDATA_RVA - PE_TEXT_RVA, PE_TEXT_RVA,
           align_to(tlen, PE_FILE_ALIGN), toff, 0x60000020);
    pe_sec(ob, st + 40, ".idata", PE_DATA_RVA - PE_IDATA_RVA, PE_IDATA_RVA,
           align_to(ilen, PE_FILE_ALIGN), ioff, 0xC0000040);
    pe_sec(ob, st + 80, ".data", PE_STATE_RVA - PE_DATA_RVA + PE_WS_SIZE, PE_DATA_RVA,
           align_to(dlen, PE_FILE_ALIGN), doff, 0xC0000040);
    copy_n(ob, toff, txt, 0, tlen);
    copy_n(ob, ioff, idata, 0, ilen);
    copy_n(ob, doff, gb, 0, dlen);
    return doff + align_to(dlen, PE_FILE_ALIGN);
}

fn phdr(ob: ptr, at: u32, flags: u32, off: u32, vaddr: u32, filesz: u32, memsz: u32) {
    w32(ob, at, 1);
    w32(ob, at + 4, flags);
    w64(ob, at + 8, off as u64);
    w64(ob, at + 16, vaddr as u64);
    w64(ob, at + 24, vaddr as u64);
    w64(ob, at + 32, filesz as u64);
    w64(ob, at + 40, memsz as u64);
    w64(ob, at + 48, 4096);
}

fn copy_n(dst: ptr, doff: u32, src: ptr, soff: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, doff + i, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

// ---------------------------------------------------------------- 函数发射

/// 入口桩: `call _start; mov eax,60; mov edi,0; syscall` —— 用户态入口不能 return。
fn find_start(t: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let r: u32 = NO;
    while i + 6 < n {
        if lit_at(t, i, n, "_start") == 1 {
            if load8(t, i - 1) == 64 {
                r = i;
            }
        }
        i = i + 1;
    }
    return r;
}

fn em_entry_stub(out: ptr, c: u32, tab: ptr, ss: u32) -> u32 {
    let d: u32 = em_call_lbl(out, c, tab, ss, 6);
    d = em_mov_ri32(out, d, RAX, 60);
    d = em_mov_ri32(out, d, RDI, 0);
    d = e1(out, d, 15);
    return e1(out, d, 5);
}

/// PE 入口桩: `sub rsp,0x28; call _start; mov eax,60; mov edi,0; call __win_syscall; ud2`。
/// 长度固定（26 字节）—— 最后那个 `call` 的 rel32 恒为 +2（跳过 ud2 落到 shim 上），
/// 所以入口桩不需要知道 shim 的绝对位置；返回后 `d` 正好就是 shim 起点。
fn em_entry_stub_pe(out: ptr, c: u32, tab: ptr, ss: u32) -> u32 {
    let d: u32 = e1(out, c, 72);                // 48
    d = e1(out, d, 131);                        // 83
    d = e1(out, d, 236);                        // EC
    d = e1(out, d, 40);                         // 28   sub rsp, 0x28
    d = em_call_lbl(out, d, tab, ss, 6);        // call _start
    d = em_mov_ri32(out, d, RAX, 60);           // mov eax, 60
    d = em_mov_ri32(out, d, RDI, 0);            // mov edi, 0
    d = e1(out, d, 232);                        // E8   call __win_syscall
    d = e4(out, d, 2);                          // rel32 = +2
    d = e1(out, d, 15);                         // 0F
    return e1(out, d, 11);                      // 0B   ud2
}

// ---------------------------------------------------------------- 分支与算术

/// 下一个 `label %X` 的 (名起点 << 32) | 名长度。
fn next_label(t: ptr, from: u32, le: u32) -> u64 {
    let k: u32 = from;
    let found: u32 = 0;
    while k < le && found == 0 {
        if lit_at(t, k, le, "label") == 1 {
            found = 1;
        } else {
            k = k + 1;
        }
    }
    if found == 0 {
        return pk16(0, 0);
    }
    let q: u32 = skip_sp(t, k + 5, le);
    if q < le && load8(t, q) == 37 {
        q = q + 1;
    }
    let e: u32 = word_end(t, q, le);
    return pk16(q, e - q);
}

/// 给目标块的每个 phi 写入来自**当前块**的入边值。
///
/// **两趟，不是一趟。** LLVM 的 phi 是**同时**赋值：同一前驱上的若干 phi 按
/// "读旧值、写新值"一次完成。一趟顺序写会当场自我覆盖 —— 最典型的是
/// `%cur = phi [.., %nxt]` 与 `%prev = phi [.., %cur]` 这一对（链表遍历的标准写法）：
/// 先写 `%cur` 再读 `%cur` 给 `%prev`，`%prev` 拿到的是 `%nxt`。
///
/// 实测（2026-09-25）：这一条让 `__loment_free` 的插入**每步都以为走到了链尾**，
/// 于是每次都插在头部 —— 空闲链表恒为 1 个节点，`gc_auto` 因此回收不掉、arena 涨到 OOM。
/// 所以这一趟暂存不是优化，是语义。
///
/// 暂存用 `push`/`pop`（各 1 字节），不占帧 —— 栈本来就是现成的暂存区，
/// 而 pop 反序正好把顺序还原。参考侧 `tools/lomelf.py` 同一形态，
/// 两边的产物才逐字节相同。
fn emit_phis(tab: ptr, out: ptr, c: u32, t: ptr, le: u32, tbo: u32, tbl: u32) -> u32 {
    let d: u32 = c;
    let n: u32 = cell(tab, C_NPHI);
    let curbo: u32 = cell(tab, C_CURBO);
    let curbl: u32 = cell(tab, C_CURBL);
    let i: u32 = 0;
    while i < n {                              // 第一趟: 入边值 -> 栈
        let base: u32 = TB_PHI + i * 16;
        if span_eq(t, load32(tab, base + PH_BOFF), load32(tab, base + PH_BLEN), tbo, tbl) == 1 {
            let io: u32 = load32(tab, base + PH_IOFF);
            let ie: u32 = io + load32(tab, base + PH_ILEN);
            let dlen: u32 = word_end(t, io, ie) - io;
            let q: u32 = skip_sp(t, io + dlen, ie);
            let q2: u32 = skip_sp(t, q + 1, ie);
            let ts: u64 = type_span(t, q2 + 4, ie);
            let ptyo: u32 = hi32(ts);
            let ptyl: u32 = lo32(ts);
            let k: u32 = ptyo + ptyl;
            while k < ie {
                if load8(t, k) == 91 {
                    let vs: u32 = skip_sp(t, k + 1, ie);
                    let ve: u32 = word_end(t, vs, ie);
                    let lb: u32 = skip_comma(t, ve, ie);
                    let l2: u32 = lb;
                    if l2 < ie && load8(t, l2) == 37 {
                        l2 = l2 + 1;
                    }
                    let l2e: u32 = word_end(t, l2, ie);
                    if span_eq(t, l2, l2e - l2, curbo, curbl) == 1 {
                        if is_agg(t, ptyo, ptyl) == 1 {
                            d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
                            d = e1(out, d, 86);            // push rsi
                        } else {
                            d = emit_get(tab, out, d, t, ptyo, ptyl, vs, ve - vs, RAX);
                            d = e1(out, d, 80);            // push rax
                        }
                    }
                    while k < ie && load8(t, k) != 93 {
                        k = k + 1;
                    }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    let j: u32 = n;
    while j > 0 {                              // 第二趟: 反序取回 (栈是 LIFO) -> 目标
        j = j - 1;
        let base2: u32 = TB_PHI + j * 16;
        if span_eq(t, load32(tab, base2 + PH_BOFF), load32(tab, base2 + PH_BLEN), tbo, tbl) == 1 {
            let io2: u32 = load32(tab, base2 + PH_IOFF);
            let ie2: u32 = io2 + load32(tab, base2 + PH_ILEN);
            let dlen2: u32 = word_end(t, io2, ie2) - io2;
            let qq: u32 = skip_sp(t, io2 + dlen2, ie2);
            let qq2: u32 = skip_sp(t, qq + 1, ie2);
            let ts2: u64 = type_span(t, qq2 + 4, ie2);
            let ptyo2: u32 = hi32(ts2);
            let ptyl2: u32 = lo32(ts2);
            let k2: u32 = ptyo2 + ptyl2;
            while k2 < ie2 {
                if load8(t, k2) == 91 {
                    let vs2: u32 = skip_sp(t, k2 + 1, ie2);
                    let ve2: u32 = word_end(t, vs2, ie2);
                    let lb2: u32 = skip_comma(t, ve2, ie2);
                    let m2: u32 = lb2;
                    if m2 < ie2 && load8(t, m2) == 37 {
                        m2 = m2 + 1;
                    }
                    let m2e: u32 = word_end(t, m2, ie2);
                    if span_eq(t, m2, m2e - m2, curbo, curbl) == 1 {
                        if is_agg(t, ptyo2, ptyl2) == 1 {
                            let so: u32 = slot_find(tab, t, io2, dlen2);
                            d = e1(out, d, 94);            // pop rsi
                            d = em_lea(out, d, RDI, RBP, so);
                            d = em_copy(out, d, RDI, RSI, ty_size(t, ptyo2, ptyl2));
                        } else {
                            d = e1(out, d, 88);            // pop rax
                            d = emit_put(tab, out, d, t, io2, dlen2, RAX);
                        }
                    }
                    while k2 < ie2 && load8(t, k2) != 93 {
                        k2 = k2 + 1;
                    }
                }
                k2 = k2 + 1;
            }
        }
    }
    return d;
}

fn jump_to(tab: ptr, out: ptr, c: u32, t: ptr, le: u32, tbo: u32, tbl: u32) -> u32 {
    let d: u32 = emit_phis(tab, out, c, t, le, tbo, tbl);
    return em_jmp_blk(out, d, tab, cell(tab, C_FNO), cell(tab, C_FNL), tbo, tbl);
}

fn do_br(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let b: u32 = skip_sp(t, i + 2, le);
    if lit_at(t, b, le, "label") == 1 {
        let L: u64 = next_label(t, b, le);
        return jump_to(tab, out, c, t, le, hi32(L), lo32(L));
    }
    let ts: u64 = type_span(t, b, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let d: u32 = emit_get(tab, out, c, t, to, tl, vs, ve - vs, RAX);
    d = e1(out, d, 133);
    d = e1(out, d, 192);                       // test eax, eax
    let A: u64 = next_label(t, ve, le);
    let B: u64 = next_label(t, hi32(A) + lo32(A), le);
    d = emit_phis(tab, out, d, t, le, hi32(A), lo32(A));
    d = em_jcc_blk(out, d, 5, tab, cell(tab, C_FNO), cell(tab, C_FNL), hi32(A), lo32(A));
    return jump_to(tab, out, d, t, le, hi32(B), lo32(B));
}

fn do_switch(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let ts: u64 = type_span(t, i + 7, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let d: u32 = emit_get(tab, out, c, t, to, tl, vs, ve - vs, RAX);
    let D: u64 = next_label(t, ve, le);
    let lb: u32 = 0;
    let k: u32 = ve;
    while k < le {
        if load8(t, k) == 91 && lb == 0 {
            lb = k;
        }
        k = k + 1;
    }
    let rb: u32 = lb;
    let k2: u32 = lb;
    while k2 < le {
        if load8(t, k2) == 93 {
            rb = k2;
        }
        k2 = k2 + 1;
    }
    let q: u32 = lb + 1;
    while q < rb {
        let cts: u64 = type_span(t, q, rb);
        let co: u32 = hi32(cts);
        let cl: u32 = lo32(cts);
        let ns: u32 = skip_sp(t, co + cl, rb);
        let nx: u64 = num_at(t, ns, rb);
        let num: u32 = lo32(nx);
        let L: u64 = next_label(t, hi32(nx), rb);
        d = em_alu_ri(out, d, CMP, RAX, num);
        let jsite: u32 = em_jcc_raw(out, d, 5);
        d = jsite + 4;
        d = emit_phis(tab, out, d, t, le, hi32(L), lo32(L));
        d = em_jmp_blk(out, d, tab, cell(tab, C_FNO), cell(tab, C_FNL), hi32(L), lo32(L));
        w32(out, jsite, d - (jsite + 4));
        q = skip_comma(t, hi32(L) + lo32(L), rb);
    }
    return jump_to(tab, out, d, t, le, hi32(D), lo32(D));
}

/// `icmp <谓词> <类型> <a>, <b>`。
fn do_icmp(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ps: u32 = skip_sp(t, i + 5, le);
    let pe: u32 = word_end(t, ps, le);
    let cond: u32 = icmp_cond(t, ps, pe);
    let signed: u32 = icmp_signed(t, ps, pe);
    let ts: u64 = type_span(t, pe, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let bs: u32 = skip_comma(t, ve, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = c;
    if signed == 1 {
        d = emit_get_signed(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        d = emit_get_signed(tab, out, d, t, to, tl, bs, be - bs, RCX);
    } else {
        d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
    }
    d = em_alu_rr(out, d, 57, RAX, RCX);
    d = em_setcc(out, d, cond, RAX);
    d = em_zext64(out, d, RAX, 1);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn em_setcc(out: ptr, c: u32, cond: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, reg));
    d = e1(out, d, 15);
    d = e1(out, d, 144 + cond);
    return em_modrm3(out, d, 0, reg);
}

fn icmp_cond(t: ptr, s: u32, e: u32) -> u32 {
    if lit_at(t, s, e, "eq") == 1 {
        return 4;
    }
    if lit_at(t, s, e, "ne") == 1 {
        return 5;
    }
    if lit_at(t, s, e, "ugt") == 1 {
        return 7;
    }
    if lit_at(t, s, e, "uge") == 1 {
        return 3;
    }
    if lit_at(t, s, e, "ult") == 1 {
        return 2;
    }
    if lit_at(t, s, e, "ule") == 1 {
        return 6;
    }
    if lit_at(t, s, e, "sgt") == 1 {
        return 15;
    }
    if lit_at(t, s, e, "sge") == 1 {
        return 13;
    }
    if lit_at(t, s, e, "slt") == 1 {
        return 12;
    }
    if lit_at(t, s, e, "sle") == 1 {
        return 14;
    }
    return 4;
}

fn icmp_signed(t: ptr, s: u32, e: u32) -> u32 {
    if e - s >= 2 && load8(t, s) == 115 {
        return 1;
    }
    return 0;
}

/// 二元运算: a 放 RAX, b 放 RCX; 返回 b 的起点, 类型与 a 的跨度进格。
fn binops(tab: ptr, t: ptr, i: u32, le: u32, oplen: u32) -> u32 {
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let bs: u32 = skip_comma(t, ve, le);
    store32(tab, C_TYOFF, to);
    store32(tab, C_TYLEN, tl);
    store32(tab, C_VLOFF, vs);
    store32(tab, C_VLLEN, ve - vs);
    return bs;
}

fn do_alu(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
          oplen: u32, opcode: u32) -> u32 {
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let ao: u32 = skip_sp(t, to + tl, le);
    let al: u32 = word_end(t, ao, le) - ao;
    let bs: u32 = skip_comma(t, ao + al, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = emit_get(tab, out, c, t, to, tl, ao, al, RAX);
    d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
    if opcode == 0 {
        d = em_imul_rr(out, d, RAX, RCX);
    } else {
        d = em_alu_rr(out, d, opcode, RAX, RCX);
    }
    let sz: u32 = ty_size(t, to, tl);
    if sz < 8 {
        d = em_zext64(out, d, RAX, sz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn em_group3(out: ptr, c: u32, digit: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, reg));
    d = e1(out, d, 247);
    return em_modrm3(out, d, digit, reg);
}

fn do_div(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
          opts: u32) -> u32 {
    // 形参上限 10: oplen/signed/is_rem 打包进一个 (checker/codegen 的硬限额)
    let oplen: u32 = opts % 8;
    let signed: u32 = (opts / 8) % 2;
    let is_rem: u32 = opts / 16;
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let ao: u32 = skip_sp(t, to + tl, le);
    let al: u32 = word_end(t, ao, le) - ao;
    let bs: u32 = skip_comma(t, ao + al, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = c;
    if signed == 1 {
        d = emit_get_signed(tab, out, d, t, to, tl, ao, al, RAX);
        d = emit_get_signed(tab, out, d, t, to, tl, bs, be - bs, RCX);
        d = e1(out, d, 72);
        d = e1(out, d, 153);                     // cqo
    } else {
        d = emit_get(tab, out, d, t, to, tl, ao, al, RAX);
        d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
        d = em_mov_ri32(out, d, RDX, 0);
    }
    let digit: u32 = 6;
    if signed == 1 {
        digit = 7;
    }
    d = em_group3(out, d, digit, RCX);
    let sel: u32 = RAX;
    if is_rem == 1 {
        sel = RDX;
    }
    let sz: u32 = ty_size(t, to, tl);
    if sz < 8 {
        d = em_zext64(out, d, sel, sz);
    }
    return emit_put(tab, out, d, t, doff, dlen, sel);
}

fn em_shift_cl(out: ptr, c: u32, digit: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, reg));
    d = e1(out, d, 211);
    return em_modrm3(out, d, digit, reg);
}

fn do_shift(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
            opts: u32) -> u32 {
    // 同上: oplen/digit/is_ashr 打包
    let oplen: u32 = opts % 8;
    let digit: u32 = (opts / 8) % 8;
    let is_ashr: u32 = opts / 64;
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let ao: u32 = skip_sp(t, to + tl, le);
    let al: u32 = word_end(t, ao, le) - ao;
    let bs: u32 = skip_comma(t, ao + al, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = c;
    if is_ashr == 1 {
        d = emit_get_signed(tab, out, d, t, to, tl, ao, al, RAX);
    } else {
        d = emit_get(tab, out, d, t, to, tl, ao, al, RAX);
    }
    d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
    d = em_shift_cl(out, d, digit, RAX);
    let sz: u32 = ty_size(t, to, tl);
    if sz < 8 {
        d = em_zext64(out, d, RAX, sz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_atomic(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let a: u32 = i + 10;
    let pty: u64 = type_span(t, a, le);
    let po: u32 = hi32(pty);
    let pl: u32 = lo32(pty);
    let ps: u32 = skip_sp(t, po + pl, le);
    let pe: u32 = word_end(t, ps, le);
    let b: u32 = skip_comma(t, pe, le);
    let vty: u64 = type_span(t, b, le);
    let vo: u32 = hi32(vty);
    let vl: u32 = lo32(vty);
    let vs: u32 = skip_sp(t, vo + vl, le);
    let ve: u32 = word_end(t, vs, le);
    let d: u32 = emit_get_ptr(tab, out, c, t, ps, pe - ps, RCX);
    d = emit_get(tab, out, d, t, vo, vl, vs, ve - vs, RAX);
    d = e1(out, d, 240);                          // lock
    d = em_rex(out, d, rex(1, RAX, 0, RCX));
    d = e1(out, d, 15);
    d = e1(out, d, 193);                          // xadd
    d = em_mem(out, d, RAX, RCX, 0);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn emit_func(tab: ptr, out: ptr, c: u32, t: ptr, ls: u32, le: u32, bs: u32, be: u32) -> u32 {
    setcell(tab, C_NSLOT, 0);
    setcell(tab, C_NALLOC, 0);
    setcell(tab, C_FRAME, 0);
    let ns: u32 = plan_params(tab, t, ls, le);
    let ne: u32 = word_end(t, ns, le);
    plan_frame(tab, t, bs, be);
    lbl_add(tab, ns, ne - ns, 0, 0, txt_base(tab) + c);
    setcell(tab, C_FNO, ns);
    setcell(tab, C_FNL, ne - ns);
    let d: u32 = e1(out, c, 85);          // push rbp
    d = e1(out, d, 72);                   // REX.W
    d = e1(out, d, 137);                  // mov rbp, rsp
    d = e1(out, d, 229);
    if cell(tab, C_FRAME) != 0 {
        d = em_alu_ri(out, d, SUB, RSP, cell(tab, C_FRAME));
    }
    let i: u32 = bs;
    while i < be {
        let ls2: u32 = skip_sp(t, i, be);
        let le2: u32 = logical_end(t, i, be);
        // 基本块标签 -> 登记代码位置
        let e3: u32 = le2;
        let go3: u32 = 1;
        while e3 > ls2 && go3 == 1 {
            let c3: u32 = load8(t, e3 - 1);
            if c3 == 32 || c3 == 9 || c3 == 13 {
                e3 = e3 - 1;
            } else {
                go3 = 0;
            }
        }
        if e3 > ls2 && load8(t, e3 - 1) == 58 && line_dest(t, ls2, le2) == 0 {
            setcell(tab, C_CURBO, ls2);
            setcell(tab, C_CURBL, e3 - 1 - ls2);
            lbl_add(tab, cell(tab, C_FNO), cell(tab, C_FNL), ls2, e3 - 1 - ls2,
                    txt_base(tab) + d);
        } else {
            let dst: u64 = line_dest(t, ls2, le2);
            store32(tab, C_DESTO, hi32(dst));
            store32(tab, C_DESTL, lo32(dst));
            if dst != 0 {
                let op: u32 = skip_sp(t, hi32(dst) + lo32(dst), le2);
                let op2: u32 = skip_sp(t, op + 1, le2);
                d = lower(tab, out, d, t, op2, le2);
            } else {
                d = lower(tab, out, d, t, ls2, le2);
            }
        }
        i = le2 + 1;
    }
    return d;
}

fn emit_all(tab: ptr, out: ptr, c: u32, t: ptr, n: u32) -> u32 {
    let ss: u32 = find_start(t, n);
    if ss == NO {
        return fail("没有 _start 入口");
    }
    let d: u32 = c;
    if cell(tab, C_PE) == 1 {
        d = em_entry_stub_pe(out, c, tab, ss);
        setcell(tab, C_SHIM, d);                // syscall 站点按这个偏移算 rel32
        let rn: u32 = n_shim();
        let k: u32 = 0;
        while k < rn {
            d = blob_copy(out, d, shim_part(k));
            k = k + 1;
        }
    } else {
        d = em_entry_stub(out, c, tab, ss);
    }
    let i: u32 = 0;
    while i < n {
        let le: u32 = line_end(t, i, n);
        let ls: u32 = skip_sp(t, i, le);
        if lit_at(t, ls, le, "define ") == 1 {
            let bs: u32 = le + 1;
            let bs2: u32 = bs;
            let j: u32 = bs;
            let be: u32 = bs;
            let go: u32 = 1;
            while j < n && go == 1 {
                let je: u32 = line_end(t, j, n);
                let js: u32 = skip_sp(t, j, je);
                if js < je && load8(t, js) == 125 {
                    be = je;
                    go = 0;
                } else {
                    j = je + 1;
                }
            }
            d = emit_func(tab, out, d, t, ls, le, bs2, be);
            i = be + 1;
        } else {
            i = le + 1;
        }
    }
    return d;
}

// ---------------------------------------------------------------- 主程序

fn wdec(fd: u64, tmp: ptr, v: u32) -> u64 {
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        return write_all(fd, tmp, 1);
    }
    while x > 0 {
        let dg: u32 = x % 10;
        store8(tmp, d, (48 + dg) as u8);
        x = x / 10;
        d = d + 1;
    }
    let buf: ptr = ptr_add(tmp, 32);
    let q: u32 = 0;
    while q < d {
        store8(buf, q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    return write_all(fd, buf, d as u64);
}

fn _start() -> u32 {
    let mem: ptr = sys_alloc(ARENA) as ptr;
    if mem as u64 == 0 {
        return fail("oom (brk 失败)");
    }
    let rc: u32 = run(mem);
    return die(rc as u64);
}

fn run(mem: ptr) -> u32 {
    let ab: ptr = ptr_add(mem, M_ARGV);
    let a1: u64 = argv_n(ab, 8192, 1);
    let o1: u64 = argv_n(ab, 8192, 2);
    if a1 == 0 || o1 == 0 {
        wstr(2, "用法: lomelf IN.ll OUT\n");
        return die(2);
    }
    // 多出来的实参只可能是启动器透传的 `--link FILE.o` (docs/173 FFI)。**必须解析**:
    // 不看 argv[3..] 的话 `--link` 会被**静静忽略**, 然后在回填时报一句 "未定义的标签:
    // c_add" —— 用户看到的是"符号找不到"而不是"这个功能没实现", 方向完全错了。
    //
    // **必须先收完再读输入**: argv_n 每次都把 `/proc/self/cmdline` 重新读进 argv 缓冲,
    // 而它存放路径字符串的落点 (argv 缓冲 + 8192) **正是输入缓冲的起点** —— 读过输入之后
    // 再调 argv_n 会把输入的头 19 个字节踩掉。
    //
    // **判的是 lo32(长度) 不是整个返回值**: `/proc/self/cmdline` 以 NUL 结尾, 于是 argv_n
    // 的收尾那句 (`if f == n`) 会给出一个**长度 0 的命中** —— 打包值 `m * PHI` 非零。
    // 只判 `!= 0` 会把**每一次正常调用**都当成"多了个实参", 实测把 loment_elf_test 从 7/7
    // 打到 5/7 (两条都是"镜像退出 2")。
    let pbuf: ptr = ptr_add(mem, M_TXT);
    let nlink: u32 = 0;
    let obase: u32 = lo32(a1) + 8 + lo32(o1) + 8;   // 与下面的 pout 对齐
    let ok: u32 = 3;
    let go: u32 = 1;
    while go == 1 {
        let av: u64 = argv_n(ab, 8192, ok);
        if lo32(av) == 0 {
            go = 0;
        } else {
            if lo32(av) != 6 || lit_at(ab, hi32(av), hi32(av) + 6, "--link") == 0 {
                wstr(2, "lomelf: unknown option ");
                write_all(2, ptr_add(ab, hi32(av)), lo32(av) as u64);
                wstr(2, "\n");
                return die(2);
            }
            let pv: u64 = argv_n(ab, 8192, ok + 1);
            if lo32(pv) == 0 {
                wstr(2, "lomelf: --link 缺文件名\n");
                return die(2);
            }
            let dst: u32 = obase + nlink * 1024;
            if dst + 1024 >= 65536 {
                wstr(2, "lomelf: --link 的文件太多\n");
                return die(2);
            }
            let j: u32 = 0;
            while j < lo32(pv) {
                store8(pbuf, dst + j, load8(ab, hi32(pv) + j) as u8);
                j = j + 1;
            }
            store8(pbuf, dst + lo32(pv), 0 as u8);
            nlink = nlink + 1;
            ok = ok + 2;
        }
    }
    let inb: ptr = ptr_add(mem, M_IN);
    let ino: u32 = hi32(a1);
    let inn: u32 = lo32(a1);
    let oo: u32 = hi32(o1);
    let ol: u32 = lo32(o1);
    // 先把两个路径拷到稳定缓冲 (argv 的 cmdline 缓冲在后面会被读入覆盖)
    let pin: u32 = 0;
    let i: u32 = 0;
    while i < inn {
        store8(pbuf, pin + i, load8(ab, ino + i) as u8);
        i = i + 1;
    }
    store8(pbuf, pin + inn, 0 as u8);
    let pout: u32 = inn + 8;
    i = 0;
    while i < ol {
        store8(pbuf, pout + i, load8(ab, oo + i) as u8);
        i = i + 1;
    }
    store8(pbuf, pout + ol, 0 as u8);
    let fd: i64 = open_ro(ptr_add(pbuf, pin));
    if fd < 0 {
        return fail("打不开输入");
    }
    let n: u64 = read_all(fd as u64, inb, IN_CAP as u64);
    syscall4(3, fd as u64, 0, 0);
    if n == 0 {
        return fail("输入为空");
    }
    // **读满上限 = 文件还有剩** —— `read_all` 读够 `cap` 就停，它不知道文件多长。
    // 不检查的后果不是"少几条指令"：`.ll` 是逐行语法，截断点之后的函数定义凭空消失，
    // 汇编出来的是一个**缺胳膊少腿、跑起来就段错误**的可执行文件。
    // 2026-09-18 实测（docs/192）：同一份 `.ll`，这边段错误、clang 汇编完全正常 ——
    // 责任就在这一行。与 `copy_name` 那条守卫、与驱动程序里 `MAX_USE` / `MAX_ADDIN`
    // 的注解是同一条纪律：**超限报错退出，绝不静默丢**。
    if n >= IN_CAP as u64 {
        return fail("lomelf: 输入 .ll 超过输入缓冲上限 (装不下; 见 docs/192)");
    }
    let tab: ptr = ptr_add(mem, M_TAB);
    let gb: ptr = ptr_add(mem, M_GB);
    let txt: ptr = ptr_add(mem, M_TXT + 65536);
    let ob: ptr = ptr_add(mem, M_OUT);
    // 输出名以 `.exe` 结尾 = 出 PE（Windows），否则出 ELF。参考实现用 --target，
    // 镜像这边按后缀走 —— 发行包的启动器本来就按平台给不同的输出名。
    let pe: u32 = 0;
    if ol >= 4 {
        if load8(pbuf, pout + ol - 4) == 46 {
            if load8(pbuf, pout + ol - 3) == 101 {
                if load8(pbuf, pout + ol - 2) == 120 {
                    if load8(pbuf, pout + ol - 1) == 101 {
                        pe = 1;
                    }
                }
            }
        }
    }
    if nlink != 0 && pe == 1 {
        wstr(2, "lomelf: --link 目前只支持 ELF 目标 (docs/173 §3)\n");
        return die(2);
    }
    setcell(tab, C_PE, pe);
    // 外部符号名池的游标: 从输入文本的**末尾**开始, 见 copy_name。
    setcell(tab, C_EXTN, n as u32);
    collect_globals(tab, inb, n as u32, gb);
    collect_externs(tab, inb, n as u32);
    place_globals(tab, inb);
    let tlen: u32 = emit_all(tab, txt, 0, inb, n as u32);
    // 外部目标文件 (docs/173): 代码节接在我们自己的代码之后, 导出符号立标签。
    let tobj: ptr = ptr_add(mem, M_OBJ);
    let got: u32 = 0;
    while got < nlink {
        tlen = link_object(tab, inb, txt, tlen, tobj, ptr_add(pbuf, obase + got * 1024));
        got = got + 1;
    }
    // 外部对象的重定位: **所有对象都摆好了**才应用 (docs/173 阶段 2)。
    let rr: u32 = apply_relocs(tab, inb, txt);
    if rr != 0 {
        return rr;
    }
    let r: u32 = resolve_fixups(tab, inb, txt);
    if r != 0 {
        return r;
    }
    let dlen: u32 = align_to(cell(tab, C_GB), 8);
    let total: u32 = 0;
    if pe == 1 {
        let idata: ptr = ptr_add(tab, TB_IDATA);
        let dd: u32 = 0;
        let rn: u32 = n_idata();
        let k: u32 = 0;
        while k < rn {
            dd = blob_copy(idata, dd, idata_part(k));
            k = k + 1;
        }
        total = build_pe(ob, txt, tlen, gb, dlen, idata, dd);
    } else {
        total = build_elf(tab, ob, txt, tlen, gb, dlen, cell(tab, C_BSS));
    }
    let ofd: i64 = open_wo(ptr_add(pbuf, pout));
    if ofd < 0 {
        return fail("写不了输出");
    }
    write_all(ofd as u64, ob, total as u64);
    syscall4(3, ofd as u64, 0, 0);
    return 0;
}
