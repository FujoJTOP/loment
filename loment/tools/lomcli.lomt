fn do_syntax(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Loment 语法速查");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "表面是 Rust 的严格子集, 只多加了能力域 (capability + guard)。");
    colr(mem, 1);
    wstr(1, "\n\n");
    termrow(mem, 1, "模块", "首行 `module <name>` (无分号)");
    termrow(mem, 1, "导入", "`use 名字` / `use \"路径.lomt\"` —— 都不带分号");
    termrow(mem, 1, "函数", "`fn f(a: u32, b: str) -> u32 { ... }`, 无返回不写 ->, 形参 ≤ 10");
    termrow(mem, 1, "导出", "跨模块可见加 pub");
    termrow(mem, 1, "常量", "`const NAME: u32 = 3;` —— 初值只能是整数字面量");
    termrow(mem, 1, "变量", "`let x: u32 = e;` —— 类型标注必写, 没有类型推断");
    termrow(mem, 1, "控制流", "if / else if / else / while / for i in lo..hi");
    termrow(mem, 1, "返回", "`return <expr>;` —— 必须有值, 没有裸 return;");
    termrow(mem, 1, "结构体", "`struct S { a: u32 }`, 字面量 `S { a: 1 }`, 取字段 `s.a`");
    termrow(mem, 1, "枚举", "`enum E { A, B(u32) }`, 构造 `E::B(3)`");
    termrow(mem, 1, "match", "臂体是**块**不是表达式; 要穷尽或写 `_`");
    termrow(mem, 1, "数组", "`[u8; 16]` / 字面量 `[1, 2, 3]` / 下标 xs[0] 可读写");
    termrow(mem, 1, "切片", "参数 `[T]` / `mut [T]`, 传 `&xs` / `&mut xs`, `slice_len(s)`");
    termrow(mem, 1, "泛型", "`fn max_of<T>(a: T, b: T) -> T`, 编译期单态化");
    termrow(mem, 1, "trait", "`trait M { fn m(self) -> u32; }` + `impl M for S`, 静态派发");
    termrow(mem, 1, "类型", "u8..u64 i8..i64 bool ptr str、struct 名、[T; N]、[T]、mut [T]");
    termrow(mem, 1, "转换", "`x as u64` —— 整型/指针互转都要显式写");
    termrow(mem, 1, "字符串", "\"...\", 转义只有 \\n \\t \\\" \\\\ —— **没有 \\x 转义**");
    termrow(mem, 1, "注释", "// 与 /* */, /// 是文档注释 (loment doc 抽它)");
    termrow(mem, 1, "入口", "freestanding 叫 `_start`, 不接参数; 退出用 syscall4(60, ...)");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "坑清单: loment cheat   内建: loment builtins   错误码: loment codes");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

