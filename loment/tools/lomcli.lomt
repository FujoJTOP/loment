fn do_caps(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "能力域 (capability / guard)");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "Loment 相对 Rust 唯一多出来的语义层。");
    colr(mem, 1);
    wstr(1, "\n\n");
    wstr(1, "  ");
    yellow(mem, 1);
    wstr(1, "capability blk_write : disk[0..4] revocable");
    colr(mem, 1);
    wstr(1, "\n\n  ");
    gray(mem, 1);
    wstr(1, "guard blk_write(slot);   // 越界 -> trap; 通过 -> 审计计数 +1");
    colr(mem, 1);
    wstr(1, "\n\n");
    codrow(mem, 1, "语义", "guard cap(e) 求值 e 得索引 -> 不在 [lo, hi] 就 trap");
    codrow(mem, 1, "时机", "字面量越界是**编译期**错 (E4); 非字面量是运行期检查");
    codrow(mem, 1, "revocable", "声明与域描述表里的一个标志");
    codrow(mem, 1, "excluded", "声明出界的空间, 用了报 E5");
    wstr(1, "\n  ");
    red(mem, 1);
    wstr(1, "诚实边界");
    colr(mem, 1);
    wstr(1, ": guard 只约束**索引**落在域内, **不是授权** ——");
    wstr(1, "\n  它不检查「当前主体有没有这个能力」, 主体-能力的绑定在内核侧。");
    wstr(1, "\n\n");
    return 0;
}

fn do_cheat(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "一页速查");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "按「最容易踩」排序 —— 前两条最要命 (第 2 条是**静默**的: check 放行, 跑起来才崩)。");
    colr(mem, 1);
    wstr(1, "\n\n");
    codrow(mem, 1, "1", "match 臂体必须是**块**: `E::A => { return 0; }`, 不是 `E::A => 0,`");
    codrow(mem, 1, "2", "**非 void 函数掉出末尾 -> 运行期 SIGILL**: check 放行, 跑起来直接 Illegal instruction —— 末尾必须有一条 return");
    codrow(mem, 1, "3", "没有裸 `return;` —— 要么 `return <expr>;`, 要么 if/else 收尾");
    codrow(mem, 1, "4", "泛型枚举模式写单态化名: `Result_i64_u32::Ok(v)`");
    codrow(mem, 1, "5", "泛型函数实参定不出 T 时报 E2 (消息误导), 先 let 出带类型的变量");
    codrow(mem, 1, "6", "结构体字面量不能直接当实参: 先 `let x: S = S { ... };` 再传");
    codrow(mem, 1, "7", "条件位置的结构体字面量要加括号");
    codrow(mem, 1, "8", "模块内先定义后使用, 别依赖前向引用");
    codrow(mem, 1, "9", "一个解析错中止整个检查 —— 一次只改一处");
    codrow(mem, 1, "10", "`==` 用在 struct/enum 上: checker 放行但原生后端拒 —— 显式比字段");
    codrow(mem, 1, "11", "`const` 初值只能是整数字面量, 不能引用别的 const");
    codrow(mem, 1, "12", "没有字符串常量: 要标签就写 `pub fn name() -> str { return \"x\"; }`");
    codrow(mem, 1, "13", "`use` 后面不带分号");
    codrow(mem, 1, "14", "字符串转义只有 \\n \\t \\\" \\\\ —— 没有 \\x / \\0");
    codrow(mem, 1, "15", "let 必须写类型; 没有类型推断, 也没有隐式转换");
    codrow(mem, 1, "16", "`let mut x` 里的 mut 是**普通标识符**不是关键字, 别写 (报的语法错会指向别处)");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "全文: loment skill --print (装好的包里也有一份)");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 读源码

fn lnrow(mem: ptr, fd: u64, no: u32, p: ptr, n: u32) {
    gray(mem, fd);
    wpad_num(mem, fd, no, 5);
    wstr(fd, "  ");
    colr(mem, fd);
    wbytes(fd, p, n);
    wstr(fd, "\n");
}

fn wpad_num(mem: ptr, fd: u64, v: u32, w: u32) {
    let d: u32 = 1;
    let x: u32 = v;
    while x >= 10 {
        x = x / 10;
        d = d + 1;
    }
    let k: u32 = 0;
    while d + k < w {
        wstr(fd, " ");
        k = k + 1;
    }
    wdec(mem, fd, v);
}

// 带行号打印
fn print_numbered(mem: ptr, fd: u64, p: ptr, n: u32) {
    let i: u32 = 0;
    let ls: u32 = 0;
    let no: u32 = 1;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let len: u32 = i - ls;
            lnrow(mem, fd, no, ptr_add(p, ls), len);
            no = no + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
}

fn do_cat(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "cat 需要一个文件名");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    print_numbered(mem, 1, p, n);
    return 0;
}

fn do_stat(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "stat 需要一个文件名");
    }
    let path: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, 2, path);
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let lines: u32 = 0;
    let blanks: u32 = 0;
    let maxl: u32 = 0;
    let i: u32 = 0;
    let ls: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let len: u32 = i - ls;
            if len > 0 && load8(p, ls + len - 1) == 13 {
                len = len - 1;
            }
            lines = lines + 1;
            if len == 0 {
                blanks = blanks + 1;
            }
            if len > maxl {
                maxl = len;
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    title(mem, 1, "源码统计");
    kvb(mem, 1, "文件", path);
    kv(mem, 1, "字节", n);
    kv(mem, 1, "行数", lines);
    kv(mem, 1, "空行", blanks);
    kv(mem, 1, "非空行", lines - blanks);
    kv(mem, 1, "最长行", maxl);
    return 0;
}

fn do_count(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "count 需要一个文件名");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let nf: u32 = 0;
    let ns: u32 = 0;
    let ne: u32 = 0;
    let nt: u32 = 0;
    let nc: u32 = 0;
    let ng: u32 = 0;
    let i: u32 = 0;
    let ls: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let line: ptr = ptr_add(p, ls);
            let len: u32 = i - ls;
            if len > 0 && load8(line, len - 1) == 13 {
                len = len - 1;
            }
            // 跳到首个非空白
            let k: u32 = 0;
            while k < len && (load8(line, k) == 32 || load8(line, k) == 9) {
                k = k + 1;
            }
            let s: ptr = ptr_add(line, k);
            let sl: u32 = len - k;
            if k < len {
                if starts_with(s, sl, "pub ") {
                    if starts_with(ptr_add(s, 4), sl - 4, "fn ") {
                        nf = nf + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "struct ") {
                        ns = ns + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "enum ") {
                        ne = ne + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "trait ") {
                        nt = nt + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "const ") {
                        nc = nc + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "capability ") {
                        ng = ng + 1;
                    }
                } else {
                    if starts_with(s, sl, "fn ") {
                        nf = nf + 1;
                    }
                    if starts_with(s, sl, "struct ") {
                        ns = ns + 1;
                    }
                    if starts_with(s, sl, "enum ") {
                        ne = ne + 1;
                    }
                    if starts_with(s, sl, "trait ") {
                        nt = nt + 1;
                    }
                    if starts_with(s, sl, "const ") {
                        nc = nc + 1;
                    }
                    if starts_with(s, sl, "capability ") {
                        ng = ng + 1;
                    }
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    title(mem, 1, "声明计数");
    kv(mem, 1, "fn", nf);
    kv(mem, 1, "struct", ns);
    kv(mem, 1, "enum", ne);
    kv(mem, 1, "trait", nt);
    kv(mem, 1, "const", nc);
    kv(mem, 1, "capability", ng);
    return 0;
}

fn do_fns(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "fns 需要一个文件名");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    title(mem, 1, "函数签名");
    let i: u32 = 0;
    let ls: u32 = 0;
    let no: u32 = 1;
    let cnt: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let line: ptr = ptr_add(p, ls);
            let len: u32 = i - ls;
            if len > 0 && load8(line, len - 1) == 13 {
                len = len - 1;
            }
            let k: u32 = 0;
            while k < len && (load8(line, k) == 32 || load8(line, k) == 9) {
                k = k + 1;
            }
            let s: ptr = ptr_add(line, k);
            let sl: u32 = len - k;
            let isfn: u32 = 0;
            let off: u32 = 0;
            if starts_with(s, sl, "fn ") {
                isfn = 1;
            }
            if starts_with(s, sl, "pub fn ") {
                isfn = 1;
                off = 4;
            }
            if isfn == 1 {
                // 打到 `{` 为止
                let e: u32 = off;
                while e < sl && load8(s, e) != 123 {
                    e = e + 1;
                }
                let m: u32 = e;
                while m > off && load8(s, m - 1) == 32 {
                    m = m - 1;
                }
                gray(mem, 1);
                wpad_num(mem, 1, no, 5);
                wstr(1, "  ");
                colr(mem, 1);
                wbytes(1, ptr_add(s, off), m - off);
                wstr(1, "\n");
                cnt = cnt + 1;
            }
            no = no + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
    wstr(1, "\n  ");
    gray(mem, 1);
    wdec(mem, 1, cnt);
    wstr(1, " 个函数");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_tokens(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "tokens 需要一个文件名");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let nid: u32 = 0;
    let nkw: u32 = 0;
    let nnum: u32 = 0;
    let nstr: u32 = 0;
    let ncom: u32 = 0;
    let nop: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c == 47 && i + 1 < n && load8(p, i + 1) == 47 {
            while i < n && load8(p, i) != 10 {
                i = i + 1;
            }
            ncom = ncom + 1;
        } else if c == 47 && i + 1 < n && load8(p, i + 1) == 42 {
            i = i + 2;
            while i + 1 < n && !(load8(p, i) == 42 && load8(p, i + 1) == 47) {
                i = i + 1;
            }
            i = i + 2;
            ncom = ncom + 1;
        } else if c == 34 {
            i = i + 1;
            while i < n && load8(p, i) != 34 {
                if load8(p, i) == 92 && i + 1 < n {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            nstr = nstr + 1;
        } else if alpha(c) {
            let s: u32 = i;
            while i < n && (alpha(load8(p, i)) || digit(load8(p, i))) {
                i = i + 1;
            }
            if is_kw(p, s, i - s) {
                nkw = nkw + 1;
            } else {
                nid = nid + 1;
            }
        } else if digit(c) {
            while i < n && digit(load8(p, i)) {
                i = i + 1;
            }
            nnum = nnum + 1;
        } else if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1;
        } else {
            nop = nop + 1;
            i = i + 1;
        }
    }
    title(mem, 1, "词法直方图");
    kv(mem, 1, "标识符", nid);
    kv(mem, 1, "关键字", nkw);
    kv(mem, 1, "数字", nnum);
    kv(mem, 1, "字符串", nstr);
    kv(mem, 1, "注释", ncom);
    kv(mem, 1, "运算符/标点", nop);
    return 0;
}

fn is_kw(p: ptr, off: u32, n: u32) -> bool {
    let s: ptr = ptr_add(p, off);
    if eq_cstr(s, n, "module") || eq_cstr(s, n, "use") || eq_cstr(s, n, "fn") {
        return true;
    }
    if eq_cstr(s, n, "const") || eq_cstr(s, n, "let") || eq_cstr(s, n, "pub") {
        return true;
    }
    if eq_cstr(s, n, "struct") || eq_cstr(s, n, "enum") || eq_cstr(s, n, "trait") {
        return true;
    }
    if eq_cstr(s, n, "impl") || eq_cstr(s, n, "if") || eq_cstr(s, n, "else") {
        return true;
    }
    if eq_cstr(s, n, "while") || eq_cstr(s, n, "for") || eq_cstr(s, n, "in") {
        return true;
    }
    if eq_cstr(s, n, "match") || eq_cstr(s, n, "return") || eq_cstr(s, n, "break") {
        return true;
    }
    if eq_cstr(s, n, "continue") || eq_cstr(s, n, "as") || eq_cstr(s, n, "mut") {
        return true;
    }
    if eq_cstr(s, n, "capability") || eq_cstr(s, n, "guard") || eq_cstr(s, n, "self") {
        return true;
    }
    if eq_cstr(s, n, "revocable") || eq_cstr(s, n, "excluded") {
        return true;
    }
    return false;
}

fn do_grep(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 4 {
        return err_usage(mem, "grep 需要 <PAT> <FILE> 两个参数");
    }
    let pat: ptr = ptr_add(mem, M_P2);
    let pn: u32 = arg_copy(mem, ab, 2, pat);
    if pn == NOTFOUND || pn == 0 {
        return err_usage(mem, "grep 的模式不能为空");
    }
    let n: u32 = read_arg(mem, ab, 3);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let hits: u32 = scan_hits(mem, p, n, pat, 1);
    if hits == 0 {
        return 1;
    }
    return 0;
}

// needle 由调用方给出 (NUL 结尾)
fn scan_hits(mem: ptr, p: ptr, n: u32, pat: ptr, show: u32) -> u32 {
    let pl: u32 = strlen_n(pat);
    let i: u32 = 0;
    let ls: u32 = 0;
    let no: u32 = 1;
    let hits: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let line: ptr = ptr_add(p, ls);
            let len: u32 = i - ls;
            if len > 0 && load8(line, len - 1) == 13 {
                len = len - 1;
            }
            if find_bytes(line, len, pat, pl) != NOTFOUND {
                hits = hits + 1;
                if show == 1 {
                    yellow(mem, 1);
                    wpad_num(mem, 1, no, 5);
                    colr(mem, 1);
                    wstr(1, ": ");
                    wbytes(1, line, len);
                    wstr(1, "\n");
                }
            }
            no = no + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
    return hits;
}

fn find_bytes(p: ptr, n: u32, q: ptr, m: u32) -> u32 {
    if m == 0 || n < m {
        return NOTFOUND;
    }
    let i: u32 = 0;
    while i + m <= n {
        let k: u32 = 0;
        let eq: u32 = 1;
        while k < m {
            if load8(p, i + k) != load8(q, k) {
                eq = 0;
            }
            k = k + 1;
        }
        if eq == 1 {
            return i;
        }
        i = i + 1;
    }
    return NOTFOUND;
}

// ---------------------------------------------------------------- 工程

fn do_todo(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "todo 需要一个文件名");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let a: ptr = ptr_add(mem, M_P1);
    put(a, "TODO");
    let hits: u32 = scan_hits(mem, p, n, a, 1);
    put(a, "FIXME");
    let h2: u32 = scan_hits(mem, p, n, a, 1);
    put(a, "XXX");
    let h3: u32 = scan_hits(mem, p, n, a, 1);
    wstr(1, "\n  ");
    gray(mem, 1);
    wdec(mem, 1, hits + h2 + h3);
    wstr(1, " 条");
    colr(mem, 1);
    wstr(1, "\n\n");
    if hits + h2 + h3 == 0 {
        return 1;
    }
    return 0;
}

fn do_hash(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "hash 需要一个文件名");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let st: ptr = ptr_add(mem, M_SHA);
    let dg: ptr = ptr_add(mem, M_DIG);
    sha_init(st);
    sha_update(st, ptr_add(mem, M_FILE), n);
    sha_final(st, dg);
    let out: ptr = ptr_add(mem, M_OUT);
    hex_dig(dg, out);
    write_all(1, out, 64);
    wstr(1, "\n");
    return 0;
}

fn do_new(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "new 需要一个名字");
    }
    let nm: ptr = ptr_add(mem, M_P1);
    let nn: u32 = arg_copy(mem, ab, 2, nm);
    if nn == NOTFOUND || nn == 0 {
        return err_usage(mem, "名字不能为空");
    }
    let path: ptr = ptr_add(mem, M_P2);
    put_n(path, nm, nn);
    put(ptr_add(path, nn), ".lomt");
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(path, stb) != NOTFOUND {
        return err_path(mem, "已经存在, 不覆盖: ", path);
    }
    let fd: i64 = open_wo(path);
    if fd < 0 {
        return err_path(mem, "写不了 ", path);
    }
    wfd(fd, "module ");
    wfdp(fd, nm);
    wfd(fd, "\n\nfn _start() {\n    let s: str = \"hello from Loment\\n\";\n");
    wfd(fd, "    syscall4(1, 1, str_ptr(s) as u64, str_len(s) as u64);\n");
    wfd(fd, "    syscall4(60, 0, 0, 0);\n}\n");
    close_fd(fd);
    green(mem, 1);
    wstr(1, "  写了 ");
    colr(mem, 1);
    wbuf(1, path);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "跑它:  loment run ");
    wbuf(1, path);
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// 写一个 NUL 结尾的字节范围到 fd
fn wfd(fd: i64, s: str) {
    write_all(fd as u64, str_ptr(s), str_len(s) as u64);
}

fn wfdp(fd: i64, p: ptr) {
    write_all(fd as u64, p, strlen_n(p) as u64);
}

fn do_examples(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let dir: ptr = ptr_add(mem, M_P2);
    share_dir(mem, ab, dir);
    let dn: u32 = strlen_n(dir);
    put(ptr_add(dir, dn), "examples/");
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(dir, stb) != S_IFDIR {
        err_path(mem, "包里没有示例目录 ", dir);
        return 1;
    }
    title(mem, 1, "示例");
    kvb(mem, 1, "位置", dir);
    wstr(1, "\n");
    ls_dir(mem, 1, dir, 0, 0);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "看一个: loment example tour");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_example(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "example 需要一个名字, 如 tour");
    }
    let dir: ptr = ptr_add(mem, M_P2);
    share_dir(mem, ab, dir);
    let dn: u32 = strlen_n(dir);
    put(ptr_add(dir, dn), "examples/");
    let d2: u32 = strlen_n(dir);
    let nm: ptr = ptr_add(mem, M_P1);
    let nn: u32 = arg_copy(mem, ab, 2, nm);
    put_n(ptr_add(dir, d2), nm, nn);
    put(ptr_add(dir, d2 + nn), ".lomt");
    let n: u32 = slurp(dir, ptr_add(mem, M_FILE), FILE_CAP);
    if n == NOTFOUND {
        err_path(mem, "没有这个示例: ", dir);
        return 1;
    }
    write_all(1, ptr_add(mem, M_FILE), n as u64);
    return 0;
}

fn do_ls(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let dir: ptr = ptr_add(mem, M_P1);
    if argc >= 3 {
        arg_copy(mem, ab, 2, dir);
    } else {
        put(dir, "./");
    }
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(dir, stb) == NOTFOUND {
        return err_path(mem, "打不开 ", dir);
    }
    ls_dir(mem, 1, dir, 0, 0);
    return 0;
}

fn do_tree(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let dir: ptr = ptr_add(mem, M_P1);
    if argc >= 3 {
        arg_copy(mem, ab, 2, dir);
    } else {
        put(dir, "./");
    }
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(dir, stb) == NOTFOUND {
        return err_path(mem, "打不开 ", dir);
    }
    cyan(mem, 1);
    wbuf(1, dir);
    colr(mem, 1);
    wstr(1, "\n");
    ls_dir(mem, 1, dir, 1, 1);
    return 0;
}

// ---------------------------------------------------------------- 分发

// 把全局开关 (--no-color / -C) 从 argv 里**紧凑掉**, 就地左移。这样后面所有按下标取参数的
// 逻辑都不用改 —— 否则 `loment --no-color cat f` 会把 f 当成 argv[2] 的下一个。
fn strip_flags(mem: ptr, ab: ptr) -> u32 {
    let lend: u32 = load32(mem, M_CELL + C_ARGLEN);
    let src: u32 = 0;
    let dst: u32 = 0;
    let argc: u32 = 0;
    while src < lend {
        let e: u32 = src;
        while e < lend && load8(ab, e) != 0 {
            e = e + 1;
        }
        let n: u32 = e - src;
        let drop: u32 = 0;
        if n == 10 && eq_cstr(ptr_add(ab, src), n, "--no-color") {
            drop = 1;
        }
        if n == 2 && eq_cstr(ptr_add(ab, src), n, "-C") {
            drop = 1;
        }
        if drop == 0 {
            let k: u32 = 0;
            while k < n {
                store8(ab, dst + k, load8(ab, src + k) as u8);
                k = k + 1;
            }
            store8(ab, dst + n, 0 as u8);
            dst = dst + n + 1;
            argc = argc + 1;
        }
        src = e + 1;
    }
    store8(ab, dst, 0 as u8);
    store32(mem, M_CELL + C_ARGLEN, dst);
    return argc;
}

fn dispatch(mem: ptr, ab: ptr, argc: u32) -> u32 {
    // 全局开关: --no-color / -C (位置任意)
    let i: u32 = 1;
    while i < argc {
        let o: u32 = arg_at(mem, ab, i);
        if o != NOTFOUND {
            let p: ptr = ptr_add(ab, o);
            let pn: u32 = strlen_n(p);
            if eq_cstr(p, pn, "--no-color") || eq_cstr(p, pn, "-C") {
                store32(mem, M_CELL + C_COLOR, 0);
            }
        }
        i = i + 1;
    }
    let nac: u32 = strip_flags(mem, ab);
    if nac < 2 {
        return do_help(mem, ab, nac);
    }
    let co: u32 = arg_at(mem, ab, 1);
    let cmd: ptr = ptr_add(ab, co);
    let n: u32 = strlen_n(cmd);

    if eq_cstr(cmd, n, "help") {
        return do_help(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "commands") {
        return do_commands(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "version") {
        return do_version(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "about") {
        return do_about(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "tools") {
        return do_tools(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "where") {
        return do_where(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "env") {
        return do_env(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "doctor") {
        return do_doctor(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "color") {
        return do_color(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "codes") {
        return do_codes(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "explain") {
        return do_explain(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "syntax") {
        return do_syntax(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "builtins") {
        return do_builtins(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "types") {
        return do_types(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "keywords") {
        return do_keywords(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "caps") {
        return do_caps(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "cheat") {
        return do_cheat(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "cat") {
        return do_cat(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "stat") {
        return do_stat(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "count") {
        return do_count(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "fns") {
        return do_fns(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "tokens") {
        return do_tokens(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "grep") {
        return do_grep(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "todo") {
        return do_todo(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "hash") {
        return do_hash(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "new") {
        return do_new(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "examples") {
        return do_examples(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "example") {
        return do_example(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "ls") {
        return do_ls(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "tree") {
        return do_tree(mem, ab, nac);
    }
    // 这些由启动器直接转发给对应工具, 到不了这里; 但手工调用 loment-cli 时要给个交代
    if eq_cstr(cmd, n, "ir") || eq_cstr(cmd, n, "check") || eq_cstr(cmd, n, "build") {
        return delegate_note(mem, cmd, n, "loment-driver");
    }
    if eq_cstr(cmd, n, "run") {
        return delegate_note(mem, cmd, n, "loment-driver + loment-lomelf");
    }
    if eq_cstr(cmd, n, "fmt") {
        return delegate_note(mem, cmd, n, "loment-fmt");
    }
    if eq_cstr(cmd, n, "doc") {
        return delegate_note(mem, cmd, n, "loment-doc");
    }
    if eq_cstr(cmd, n, "lsp") {
        return delegate_note(mem, cmd, n, "loment-lsp");
    }
    if eq_cstr(cmd, n, "skill") {
        return delegate_note(mem, cmd, n, "share/loment/skill/SKILL.md");
    }

    red(mem, 2);
    wstr(2, "loment: ");
    colr(mem, 2);
    wstr(2, "未知命令 ");
    bold(mem, 2);
    wbytes(2, cmd, n);
    colr(mem, 2);
    wstr(2, "\n");
    gray(mem, 2);
    wstr(2, "  试 loment help —— 或 loment commands 拿命令名\n");
    colr(mem, 2);
    return 2;
}

fn delegate_note(mem: ptr, cmd: ptr, n: u32, who: str) -> u32 {
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "loment ");
    wbytes(1, cmd, n);
    wstr(1, " 由启动器直接转发给 ");
    wstr(1, who);
    wstr(1, ", 不经 loment-cli。\n  直接跑 loment ");
    wbytes(1, cmd, n);
    wstr(1, " ... 即可。");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn _start() -> u32 {
    let memv: u64 = sys_alloc(ARENA_CAP);
    if memv == 0 {
        return finish(1);
    }
    let mem: ptr = memv as ptr;
    store32(mem, M_CELL + C_COLOR, 1);
    store32(mem, M_CELL + C_ERR, 0);
    let ab: ptr = ptr_add(mem, M_ARGV);
    let cpath: ptr = ptr_add(mem, M_P3);
    put(cpath, "/proc/self/cmdline");
    let fd: i64 = open_ro(cpath);
    let rn: u64 = 0;
    if fd >= 0 {
        rn = read_all(fd as u64, ab, (ARGV_CAP - 1) as u64);
        close_fd(fd);
    }
    store8(ab, rn as u32, 0 as u8);
    store32(mem, M_CELL + C_ARGLEN, rn as u32);
    let argc: u32 = split_argv(mem, ab);
    let rc: u32 = dispatch(mem, ab, argc);
    return finish(rc as u64);
}

