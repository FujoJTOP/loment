// loment/tools/lomcli.lomt — Loment 自举 CLI 前端 (docs/169)
//
// 为什么用 Loment 写而不写在启动器的 shell 里: 启动器有两份 (bin/loment 是 bash,
// bin/loment.cmd 是 batch), 命令写在那里就得**写两遍并保持同步**。写在这里只写一遍,
// 两个启动器各加一行转发即可 —— 与 lomfmt/lomdoc/lomelf 同一条路数。
//
// 判据 (tools/loment_cli_test.py): 链成 PE 后**在本机原生跑**, 逐条验命令的输出与退出码,
// 并钉住"启动器认得的命令 == 这里列出的命令"不漂移。
//
// CLI:
//   lomcli <command> [args]      命令见 `lomcli help`
//   退出码: 0 = 成功 / 1 = 失败 / 2 = 用法错误
//
// 只用 8 个跨平台 syscall (read/write/close/brk/exit/getdents64/openat/newfstatat),
// 所以同一份源码在 ELF 与 PE 上行为一致。**PE 上 newfstatat 只填 st_mode** (实测
// 2026-09-15: st_size 恒为 0), 所以文件大小一律靠"读到底数出来", 不看 stat。

module lomcli

use bytes
use sha256

// ---------------------------------------------------------------- 内存布局
// 单块 brk 内存 + 命名偏移。Loment 没有可变全局也没有 out 参数, 所以跨函数共享的状态
// 一律靠这块内存 (与 lompkg.lomt / lomstatus.lomt 同法)。

const M_CELL: u32 = 0;             // 全局格 (C_*), 128
const M_OUT: u32 = 128;            // 短串/数字暂存, 4096
const M_ARGV: u32 = 4224;          // /proc/self/cmdline
const M_P1: u32 = 69760;           // 路径缓冲 1
const M_P2: u32 = 70784;           // 路径缓冲 2
const M_P3: u32 = 71808;           // 路径缓冲 3
const M_STB: u32 = 72832;          // struct stat, 256
const M_DIRBUF: u32 = 73088;       // getdents64 缓冲
const M_LSP: u32 = 105856;         // 目录递归: 每深度路径 (MAXD × PATH_CAP)
const M_LSN: u32 = 122240;         // 目录递归: 每深度名字池 (MAXD × 4096)
const M_LST: u32 = 187776;         // 目录递归: 每深度类型位 (MAXD × 256)
const M_FILE: u32 = 191872;        // 文件内容
const M_SHA: u32 = 454016;         // sha256 状态 (1024)
const M_DIG: u32 = 455040;         // sha256 摘要 (32)
const M_TMP: u32 = 455072;         // 通用暂存 (拼路径用)

const ARGV_CAP: u32 = 65536;
const PATH_CAP: u32 = 1024;
const DIR_CAP: u32 = 32768;
const FILE_CAP: u32 = 262144;
const ARENA_CAP: u64 = 470000;

const MAXD: u32 = 16;              // 目录递归深度上限
const ENT_CAP: u32 = 256;          // 一个目录最多记这么多条
const NPOOL: u32 = 4096;           // 每深度的名字池字节数

// 全局格 (M_CELL 内)
const C_COLOR: u32 = 0;            // 1 = 上色
const C_ERR: u32 = 8;              // 本次命令的错误计数
const C_ARGLEN: u32 = 20;          // /proc/self/cmdline 的真实字节数

const S_IFMT: u32 = 61440;
const S_IFDIR: u32 = 16384;
const NOTFOUND: u32 = 4294967295;

// ---------------------------------------------------------------- 系统调用

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn wbytes(fd: u64, p: ptr, n: u32) -> u64 {
    return write_all(fd, p, n as u64);
}

// 打印一个 NUL 结尾的运行期缓冲。Loment 没有 ptr -> str 的转换, 也没有"由 ptr+len 造 str"
// 的内建, 所以凡是**算出来的**文本一律走 wbuf, 不走 wstr (wstr 只吃字面量)。
fn wbuf(fd: u64, p: ptr) -> u64 {
    return write_all(fd, p, strlen_n(p) as u64);
}

fn open_ro(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 0);
}

// O_WRONLY|O_CREAT|O_TRUNC = 577, 0644 = 420
fn open_wo(path: ptr) -> i64 {
    return syscall6(257, (0 as u64) - 100, path as u64, 577, 420, 0);
}

fn close_fd(fd: i64) {
    syscall4(3, fd as u64, 0, 0);
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn stat_mode(p: ptr, stb: ptr) -> u32 {
    let r: i64 = syscall4(262, (0 as u64) - 100, p as u64, stb as u64);
    if r < 0 {
        return NOTFOUND;
    }
    return load32(stb, 24) & S_IFMT;
}

fn finish(rc: u64) -> u32 {
    syscall4(60, rc, 0, 0);
    return 0;
}

// ---------------------------------------------------------------- 文本工具

fn strlen_n(p: ptr) -> u32 {
    let n: u32 = 0;
    while load8(p, n) != 0 {
        n = n + 1;
    }
    return n;
}

fn put(dst: ptr, s: str) {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
}

fn put_n(dst: ptr, p: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
}


// 把一个 NUL 结尾的字节范围与字面量比内容
fn eq_cstr(p: ptr, n: u32, s: str) -> bool {
    if n != str_len(s) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(p, i) != load8(str_ptr(s), i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn starts_with(p: ptr, n: u32, s: str) -> bool {
    let m: u32 = str_len(s);
    if n < m {
        return false;
    }
    let i: u32 = 0;
    while i < m {
        if load8(p, i) != load8(str_ptr(s), i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}


fn digit(c: u32) -> bool {
    if c >= 48 && c <= 57 {
        return true;
    }
    return false;
}

fn alpha(c: u32) -> bool {
    if c >= 97 && c <= 122 {
        return true;
    }
    if c >= 65 && c <= 90 {
        return true;
    }
    if c == 95 {
        return true;
    }
    return false;
}

// ---------------------------------------------------------------- 输出

fn wdec(mem: ptr, fd: u64, v: u32) {
    let buf: ptr = ptr_add(mem, M_OUT);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, (48 + x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n / 2 {
        let lo: u8 = load8(buf, i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    write_all(fd, buf, n as u64);
}




// 右侧补空格到 w 列。只用 ASCII 串 —— 全角字符按字节数补会对不齐。
fn wpad(fd: u64, s: str, w: u32) {
    wstr(fd, s);
    let n: u32 = str_len(s);
    let k: u32 = 0;
    while n + k < w {
        wstr(fd, " ");
        k = k + 1;
    }
}

// 一段 UTF-8 的**显示宽度**: 三/四字节的字符按两列算 (CJK), 其余一列。
fn dwidth(p: ptr, n: u32) -> u32 {
    let w: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c >= 240 {
            w = w + 2;
            i = i + 4;
        } else if c >= 224 {
            w = w + 2;
            i = i + 3;
        } else if c >= 192 {
            w = w + 1;
            i = i + 2;
        } else {
            w = w + 1;
            i = i + 1;
        }
    }
    return w;
}

// 右侧补空格到 w **列** —— 中英混排的列对齐靠它, 不靠 wpad。
fn wpadx(fd: u64, s: str, w: u32) {
    wstr(fd, s);
    let d: u32 = dwidth(str_ptr(s), str_len(s));
    let k: u32 = 0;
    while d + k < w {
        wstr(fd, " ");
        k = k + 1;
    }
}

// ---------------------------------------------------------------- 颜色

fn color_on(mem: ptr) -> bool {
    if load32(mem, M_CELL + C_COLOR) == 1 {
        return true;
    }
    return false;
}

fn col(mem: ptr, fd: u64, code: str) {
    if color_on(mem) {
        let b: ptr = ptr_add(mem, M_OUT);
        store8(b, 0, 27 as u8);
        store8(b, 1, 91 as u8);
        let n: u32 = str_len(code);
        let i: u32 = 0;
        while i < n {
            store8(b, 2 + i, load8(str_ptr(code), i) as u8);
            i = i + 1;
        }
        store8(b, 2 + n, 109 as u8);
        write_all(fd, b, (3 + n) as u64);
    }
}

fn colr(mem: ptr, fd: u64) {
    col(mem, fd, "0");
}


fn bold(mem: ptr, fd: u64) {
    col(mem, fd, "1");
}

fn cyan(mem: ptr, fd: u64) {
    col(mem, fd, "1;36");
}

fn green(mem: ptr, fd: u64) {
    col(mem, fd, "1;32");
}

fn red(mem: ptr, fd: u64) {
    col(mem, fd, "1;31");
}

fn yellow(mem: ptr, fd: u64) {
    col(mem, fd, "1;33");
}

fn gray(mem: ptr, fd: u64) {
    col(mem, fd, "1;30");
}

// ---------------------------------------------------------------- argv

fn split_argv(mem: ptr, buf: ptr) -> u32 {
    let m: u32 = load32(mem, M_CELL + C_ARGLEN);
    let i: u32 = 0;
    let n: u32 = 0;
    if m > 0 {
        n = 1;
    }
    while i < m {
        if load8(buf, i) == 0 {
            n = n + 1;
        }
        i = i + 1;
    }
    // 末尾的 NUL 后面还有一个空串, 不算一个参数
    if m > 0 && load8(buf, m - 1) == 0 {
        n = n - 1;
    }
    return n;
}

// 第 k 个参数起点 (NUL 结尾的字节范围), 返回下标或 NOTFOUND
fn arg_at(mem: ptr, buf: ptr, k: u32) -> u32 {
    let m: u32 = load32(mem, M_CELL + C_ARGLEN);
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == k {
                return s;
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return NOTFOUND;
}

// ---------------------------------------------------------------- 文件

// 读一个文件到 dst, 返回字节数; 失败返回 NOTFOUND
fn slurp(path: ptr, dst: ptr, cap: u32) -> u32 {
    let fd: i64 = open_ro(path);
    if fd < 0 {
        return NOTFOUND;
    }
    let n: u64 = read_all(fd as u64, dst, cap as u64);
    close_fd(fd);
    return n as u32;
}

// 取 argv[0] 所在的目录 (带结尾分隔符) 写进 dst
fn self_dir(argv0: ptr, dst: ptr) {
    let n: u32 = strlen_n(argv0);
    let i: u32 = 0;
    let last: u32 = 0;
    while i < n {
        let c: u32 = load8(argv0, i);
        if c == 47 || c == 92 {
            last = i + 1;
        }
        i = i + 1;
    }
    let k: u32 = 0;
    while k < last {
        store8(dst, k, load8(argv0, k) as u8);
        k = k + 1;
    }
    store8(dst, last, 0 as u8);
}

// 包内工具定位: <bindir><name> 或 <bindir><name>.exe, 命中就把路径写进 dst
fn tool_path(bindir: ptr, name: str, dst: ptr, stb: ptr) -> bool {
    let bn: u32 = strlen_n(bindir);
    put_n(dst, bindir, bn);
    let tail: ptr = ptr_add(dst, bn);
    put(tail, name);
    if stat_mode(dst, stb) != NOTFOUND {
        return true;
    }
    put(tail, name);
    let tn: u32 = str_len(name);
    store8(tail, tn, 46 as u8);
    store8(tail, tn + 1, 101 as u8);
    store8(tail, tn + 2, 120 as u8);
    store8(tail, tn + 3, 101 as u8);
    store8(tail, tn + 4, 0 as u8);
    if stat_mode(dst, stb) != NOTFOUND {
        return true;
    }
    store8(dst, 0, 0 as u8);
    return false;
}

// ---------------------------------------------------------------- 目录

// 列目录。**先把整层读完再递归** —— getdents64 缓冲是全局共享的, 边读边递归会让子目录
// 的读覆盖父目录还没处理完的条目 (lompkg.lomt 当初就踩过这个, 见 docs/168 §5)。
// 所以每层有自己的名字池 (M_LSN) 与类型位 (M_LST), 按 depth 切片。
fn ls_dir(mem: ptr, fd: u64, dir: ptr, recursive: u32, depth: u32) -> u32 {
    if depth >= MAXD {
        return 0;
    }
    let base: ptr = ptr_add(mem, M_LSP + depth * PATH_CAP);
    let dn: u32 = strlen_n(dir);
    put_n(base, dir, dn);
    if dn > 0 {
        let lc: u32 = load8(base, dn - 1);
        if lc != 47 && lc != 92 {
            store8(base, dn, 47 as u8);
            store8(base, dn + 1, 0 as u8);
        }
    }
    let fd2: i64 = open_ro(base);
    if fd2 < 0 {
        return 0;
    }
    // ---- 第一遍: 读完整层
    let pool: ptr = ptr_add(mem, M_LSN + depth * NPOOL);
    let typs: ptr = ptr_add(mem, M_LST + depth * ENT_CAP);
    let nent: u32 = 0;
    let poff: u32 = 0;
    let dirbuf: ptr = ptr_add(mem, M_DIRBUF);
    let going: u32 = 1;
    while going == 1 {
        let rn: i64 = syscall4(217, fd2 as u64, dirbuf as u64, DIR_CAP as u64);
        if rn <= 0 {
            going = 0;
        } else {
            let total: u32 = rn as u32;
            let off: u32 = 0;
            while off < total {
                let reclen: u32 = load16(dirbuf, off + 16);
                if reclen == 0 {
                    off = total;
                } else {
                    let dtype: u32 = load8(dirbuf, off + 18);
                    let np: ptr = ptr_add(dirbuf, off + 19);
                    let nl: u32 = strlen_n(np);
                    let skip: u32 = 0;
                    if nl == 1 && load8(np, 0) == 46 {
                        skip = 1;
                    }
                    if nl == 2 && load8(np, 0) == 46 && load8(np, 1) == 46 {
                        skip = 1;
                    }
                    if skip == 0 && nent < ENT_CAP && poff + nl + 1 < NPOOL {
                        put_n(ptr_add(pool, poff), np, nl);
                        poff = poff + nl + 1;
                        store8(typs, nent, dtype as u8);
                        nent = nent + 1;
                    }
                    off = off + reclen;
                }
            }
        }
    }
    close_fd(fd2);

    // ---- 第二遍: 打印 + 递归 (这层已读完, 缓冲随便用)
    let i: u32 = 0;
    let cur: u32 = 0;
    while i < nent {
        let np: ptr = ptr_add(pool, cur);
        let nl: u32 = strlen_n(np);
        let isdir: u32 = 0;
        if load8(typs, i) == 4 {
            isdir = 1;
        }
        let d: u32 = 0;
        while d < depth {
            wstr(fd, "  ");
            d = d + 1;
        }
        if isdir == 1 {
            cyan(mem, fd);
        }
        wbytes(fd, np, nl);
        if isdir == 1 {
            wstr(fd, "/");
            colr(mem, fd);
        }
        wstr(fd, "\n");
        if recursive == 1 && isdir == 1 {
            let child: ptr = ptr_add(mem, M_LSP + (depth + 1) * PATH_CAP);
            let bl: u32 = strlen_n(base);
            put_n(child, base, bl);
            put_n(ptr_add(child, bl), np, nl);
            ls_dir(mem, fd, child, 1, depth + 1);
        }
        cur = cur + nl + 1;
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 帮助版面

fn sec(mem: ptr, fd: u64, title: str) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, title);
    colr(mem, fd);
    wstr(fd, "\n");
}

fn row(mem: ptr, fd: u64, name: str, args: str, desc: str) {
    wstr(fd, "  ");
    bold(mem, fd);
    wpad(fd, name, 9);
    colr(mem, fd);
    wstr(fd, " ");
    gray(mem, fd);
    wpad(fd, args, 17);
    colr(mem, fd);
    wstr(fd, " ");
    wstr(fd, desc);
    wstr(fd, "\n");
}

// 去掉前缀 (banner 里已经有个 Loment, 别再重复一行)
fn after_prefix(p: ptr, s: str) -> ptr {
    if starts_with(p, strlen_n(p), s) {
        return ptr_add(p, str_len(s));
    }
    return p;
}

fn banner(mem: ptr, fd: u64, ver: ptr) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, "Loment");
    colr(mem, fd);
    wstr(fd, "  ");
    bold(mem, fd);
    wbuf(fd, after_prefix(ver, "Loment "));
    colr(mem, fd);
    wstr(fd, "  ");
    gray(mem, fd);
    wstr(fd, "loment-cli");
    colr(mem, fd);
    wstr(fd, "\n");
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "用法  loment <command> [参数]");
    colr(mem, fd);
    wstr(fd, "\n");
}

fn catalog(mem: ptr, fd: u64) {
    sec(mem, fd, "编译与运行");
    row(mem, fd, "ir", "FILE", "打印 LLVM IR 到 stdout");
    row(mem, fd, "check", "FILE", "只检查, 丢弃 IR (诊断走 stderr)");
    row(mem, fd, "build", "FILE [-o NAME]", "编译并链接成可执行文件");
    row(mem, fd, "run", "FILE", "编译、链接并运行");
    row(mem, fd, "version", "", "打印版本行");
    row(mem, fd, "lsp", "", "语言服务 (stdio 上的 LSP)");

    sec(mem, fd, "源码工具");
    row(mem, fd, "fmt", "FILE", "格式化 (打印结果, 不落盘)");
    row(mem, fd, "doc", "FILE", "从 /// 注释生成 API 文档");
    row(mem, fd, "skill", "[--print]", "AI agent 指南 (路径 / 全文)");

    sec(mem, fd, "读源码");
    row(mem, fd, "cat", "FILE", "带行号打印");
    row(mem, fd, "stat", "FILE", "行数 / 字节数 / 最长行");
    row(mem, fd, "count", "FILE", "函数 / 结构体 / 枚举 计数");
    row(mem, fd, "fns", "FILE", "列出函数签名");
    row(mem, fd, "tokens", "FILE", "词法直方图");
    row(mem, fd, "grep", "PAT FILE", "按子串搜索, 带行号");
    row(mem, fd, "todo", "FILE", "列出 TODO / FIXME / XXX");
    row(mem, fd, "hash", "FILE", "sha256 内容哈希");

    sec(mem, fd, "工程");
    row(mem, fd, "ls", "[DIR]", "列目录 (目录带 /)");
    row(mem, fd, "tree", "[DIR]", "递归目录树");
    row(mem, fd, "new", "NAME", "生成 hello 骨架");
    row(mem, fd, "examples", "", "列出包内示例");
    row(mem, fd, "example", "NAME", "打印一个示例");

    sec(mem, fd, "语言速查");
    row(mem, fd, "syntax", "", "语法速查表");
    row(mem, fd, "builtins", "", "内建函数表");
    row(mem, fd, "types", "", "类型表");
    row(mem, fd, "keywords", "", "关键字");
    row(mem, fd, "caps", "", "能力域 capability / guard");
    row(mem, fd, "codes", "", "错误码表 E1–E19");
    row(mem, fd, "explain", "CODE", "单个错误码详解");
    row(mem, fd, "cheat", "", "一页速查");

    sec(mem, fd, "本机");
    row(mem, fd, "tools", "", "包内工具清单与是否就位");
    row(mem, fd, "where", "[TOOL]", "工具绝对路径");
    row(mem, fd, "env", "", "安装前缀与环境");
    row(mem, fd, "doctor", "", "体检: 组件是否齐全可跑");
    row(mem, fd, "about", "", "构建信息");
    row(mem, fd, "color", "[on|off]", "彩色开关");
    row(mem, fd, "commands", "", "所有命令名 (给补全用)");
    row(mem, fd, "help", "[COMMAND]", "这页 / 单条命令");

    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "loment help <command> 看单条 · loment commands 拿命令名列表");
    colr(mem, fd);
    wstr(fd, "\n  ");
    gray(mem, fd);
    // 表格里只写命令名 (干净), 这里给**可直接复制**的整行调用 —— 包括 agent 的第一动作
    wstr(fd, "例  loment run hi.lomt · loment skill --print · loment explain E4");
    colr(mem, fd);
    wstr(fd, "\n\n");
}

// 命令名清单 —— 与 catalog 必须一致 (判据 tools/loment_cli_test.py 钉住)
fn names_dump(fd: u64) {
    wstr(fd, "ir\ncheck\nbuild\nrun\nversion\nlsp\n");
    wstr(fd, "fmt\ndoc\nskill\n");
    wstr(fd, "cat\nstat\ncount\nfns\ntokens\ngrep\ntodo\nhash\n");
    wstr(fd, "ls\ntree\nnew\nexamples\nexample\n");
    wstr(fd, "syntax\nbuiltins\ntypes\nkeywords\ncaps\ncodes\nexplain\ncheat\n");
    wstr(fd, "tools\nwhere\nenv\ndoctor\nabout\ncolor\ncommands\nhelp\n");
}

fn usage_line(mem: ptr, fd: u64, name: str, args: str, desc: str) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, "loment ");
    wstr(fd, name);
    colr(mem, fd);
    if str_len(args) > 0 {
        wstr(fd, " ");
        gray(mem, fd);
        wstr(fd, args);
        colr(mem, fd);
    }
    wstr(fd, "\n\n  ");
    wstr(fd, desc);
    wstr(fd, "\n\n");
}

fn help_of(mem: ptr, fd: u64, cmd: ptr, n: u32) -> u32 {
    if eq_cstr(cmd, n, "ir") {
        usage_line(mem, fd, "ir", "FILE", "编译到 LLVM IR, 打到 stdout。不链接, 不落盘。");
        return 0;
    }
    if eq_cstr(cmd, n, "check") {
        usage_line(mem, fd, "check", "FILE", "只检查。诊断走 stderr, IR 丢弃 —— 所以不产出任何文件。\n  退出码非 0 = 有诊断。");
        return 0;
    }
    if eq_cstr(cmd, n, "build") {
        usage_line(mem, fd, "build", "FILE [-o NAME]", "编译并链接成可执行文件。\n  -o 收的是**不带扩展名**的名字: -o hi 出 hi.exe (Windows) / hi (Linux)。");
        return 0;
    }
    if eq_cstr(cmd, n, "run") {
        usage_line(mem, fd, "run", "FILE", "编译、链接并运行。退出码就是被运行程序的退出码。");
        return 0;
    }
    if eq_cstr(cmd, n, "fmt") {
        usage_line(mem, fd, "fmt", "FILE", "格式化并把结果打到 stdout (不改原文件)。");
        return 0;
    }
    if eq_cstr(cmd, n, "grep") {
        usage_line(mem, fd, "grep", "PAT FILE", "在 FILE 里按**子串**(不是正则)找 PAT, 命中打 `行号: 那一行`。\n  找不到 -> 退出码 1。");
        return 0;
    }
    if eq_cstr(cmd, n, "new") {
        usage_line(mem, fd, "new", "NAME", "在 NAME.lomt 写一个能直接 `loment run` 的 hello 骨架。\n  已存在则不覆盖, 退出码 1。");
        return 0;
    }
    if eq_cstr(cmd, n, "ls") {
        usage_line(mem, fd, "ls", "[DIR]", "列目录。目录带 `/` 且上色, 文件不带。默认当前目录。");
        return 0;
    }
    if eq_cstr(cmd, n, "tree") {
        usage_line(mem, fd, "tree", "[DIR]", "递归列目录树, 缩进表示层级。");
        return 0;
    }
    if eq_cstr(cmd, n, "color") {
        usage_line(mem, fd, "color", "[on|off]", "彩色开关。无参数时打印当前策略。\n  默认 on —— 管道输出若不要转义序列, 用 `color off` 或加 --no-color。");
        return 0;
    }
    if eq_cstr(cmd, n, "explain") {
        usage_line(mem, fd, "explain", "CODE", "给一个错误码 (E4 / e4 / 4 都行), 打它的含义与改法。");
        return 0;
    }
    if eq_cstr(cmd, n, "skill") {
        usage_line(mem, fd, "skill", "[--print]", "AI agent 指南。无参数打路径, --print 打全文。");
        return 0;
    }
    if eq_cstr(cmd, n, "help") {
        usage_line(mem, fd, "help", "[COMMAND]", "无参数打总览; 带命令名打单条。");
        return 0;
    }
    if eq_cstr(cmd, n, "commands") {
        usage_line(mem, fd, "commands", "", "每行一个命令名 (给补全脚本用)。");
        return 0;
    }
    if eq_cstr(cmd, n, "doctor") {
        usage_line(mem, fd, "doctor", "", "检查包内组件是否齐全、共享文件是否读得到。\n  退出码 0 = 全绿; 1 = 有缺失。");
        return 0;
    }
    if eq_cstr(cmd, n, "hash") {
        usage_line(mem, fd, "hash", "FILE", "打印文件的 sha256 十六进制 (只打哈希, 不带文件名 —— 好喂给 sha256sum -c)。");
        return 0;
    }
    if eq_cstr(cmd, n, "example") {
        usage_line(mem, fd, "example", "NAME", "打印包内示例 NAME.lomt 的全文。");
        return 0;
    }
    // 其余命令: 表里有一行, 就把那一行单独打出来
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "没有更详细的手册页: ");
    colr(mem, fd);
    bold(mem, fd);
    wbytes(fd, cmd, n);
    colr(mem, fd);
    wstr(fd, "\n");
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "试 loment commands 看全部, 或 loment help 看总览。");
    colr(mem, fd);
    wstr(fd, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 版本/环境

fn version_text(mem: ptr, bindir: ptr, dst: ptr) -> u32 {
    let p: ptr = ptr_add(mem, M_TMP);
    let bn: u32 = strlen_n(bindir);
    let k: u32 = 0;
    while k < bn {
        store8(p, k, load8(bindir, k) as u8);
        k = k + 1;
    }
        let bp: ptr = ptr_add(p, bn);
    put(bp, "..");
    put(ptr_add(bp, 2), "/share/loment/version");
    let n: u32 = slurp(p, dst, 256);
    if n == NOTFOUND {
        put(dst, "unknown");
        return 6;
    }
    // 只取第一行
    let i: u32 = 0;
    while i < n {
        if load8(dst, i) == 10 {
            store8(dst, i, 0 as u8);
            return i;
        }
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return n;
}

// ---------------------------------------------------------------- 小工具


fn err_path(mem: ptr, a: str, p: ptr) -> u32 {
    red(mem, 2);
    wstr(2, "loment: ");
    colr(mem, 2);
    wstr(2, a);
    wbytes(2, p, strlen_n(p));
    wstr(2, "\n");
    return 1;
}

fn err_usage(mem: ptr, msg: str) -> u32 {
    red(mem, 2);
    wstr(2, "loment: ");
    colr(mem, 2);
    wstr(2, msg);
    wstr(2, "\n");
    gray(mem, 2);
    wstr(2, "  试 loment help ");
    colr(mem, 2);
    return 2;
}

fn arg_copy(mem: ptr, ab: ptr, k: u32, dst: ptr) -> u32 {
    let o: u32 = arg_at(mem, ab, k);
    if o == NOTFOUND {
        store8(dst, 0, 0 as u8);
        return NOTFOUND;
    }
    let n: u32 = strlen_n(ptr_add(ab, o));
    put_n(dst, ptr_add(ab, o), n);
    return n;
}

// <bindir>/../share/loment/ 写进 dst
fn share_dir(mem: ptr, ab: ptr, dst: ptr) -> u32 {
    let b: ptr = ptr_add(mem, M_TMP);
    let o: u32 = arg_at(mem, ab, 0);
    self_dir(ptr_add(ab, o), b);
    let bn: u32 = strlen_n(b);
    put_n(dst, b, bn);
    put(ptr_add(dst, bn), "../share/loment/");
    return strlen_n(dst);
}

// 读 argv[k] 这个文件到 M_FILE, 返回长度; 找不到打错误并返回 NOTFOUND
fn read_arg(mem: ptr, ab: ptr, k: u32) -> u32 {
    let path: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, k, path);
    let n: u32 = slurp(path, ptr_add(mem, M_FILE), FILE_CAP);
    if n == NOTFOUND {
        err_path(mem, "打不开 ", path);
        return NOTFOUND;
    }
    return n;
}

fn kv(mem: ptr, fd: u64, k: str, v: u32) {
    wstr(fd, "  ");
    gray(mem, fd);
    wpadx(fd, k, 12);
    colr(mem, fd);
    bold(mem, fd);
    wdec(mem, fd, v);
    colr(mem, fd);
    wstr(fd, "\n");
}

// 值是运行期缓冲的版本 (路径、版本号这些算出来的文本)
fn kvb(mem: ptr, fd: u64, k: str, v: ptr) {
    wstr(fd, "  ");
    gray(mem, fd);
    wpadx(fd, k, 12);
    colr(mem, fd);
    bold(mem, fd);
    wbuf(fd, v);
    colr(mem, fd);
    wstr(fd, "
");
}

fn kvs(mem: ptr, fd: u64, k: str, v: str) {
    wstr(fd, "  ");
    gray(mem, fd);
    wpadx(fd, k, 12);
    colr(mem, fd);
    bold(mem, fd);
    wstr(fd, v);
    colr(mem, fd);
    wstr(fd, "\n");
}

fn title(mem: ptr, fd: u64, t: str) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, t);
    colr(mem, fd);
    wstr(fd, "\n");
}

// ---------------------------------------------------------------- 导航命令

fn do_help(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let ver: ptr = ptr_add(mem, M_P2);
    let bindir: ptr = ptr_add(mem, M_P3);
    version_text(mem, bindir_from(mem, ab, bindir), ver);
    banner(mem, 1, ver);
    if argc >= 3 {
        let o: u32 = arg_at(mem, ab, 2);
        return help_of(mem, 1, ptr_add(ab, o), strlen_n(ptr_add(ab, o)));
    }
    catalog(mem, 1);
    return 0;
}

fn bindir_from(mem: ptr, ab: ptr, dst: ptr) -> ptr {
    let o: u32 = arg_at(mem, ab, 0);
    self_dir(ptr_add(ab, o), dst);
    return dst;
}

fn do_commands(mem: ptr, ab: ptr, argc: u32) -> u32 {
    names_dump(1);
    return 0;
}

fn do_version(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let ver: ptr = ptr_add(mem, M_P2);
    version_text(mem, bindir_from(mem, ab, bindir), ver);
    wbuf(1, ver);
    wstr(1, "\n");
    return 0;
}

fn do_about(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let ver: ptr = ptr_add(mem, M_P2);
    bindir_from(mem, ab, bindir);
    version_text(mem, bindir, ver);
    title(mem, 1, "Loment");
    kvb(mem, 1, "版本", ver);
    kvs(mem, 1, "入口", "loment-cli (Loment 自举产物)");
    kvb(mem, 1, "安装于", bindir);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "这个 CLI 自己是 Loment 写的: 源码 loment/tools/lomcli.lomt, 只用 8 个跨平台 syscall。");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// 包内应当就位的工具
fn tool_name(i: u32) -> str {
    if i == 0 {
        return "loment-driver";
    }
    if i == 1 {
        return "loment-lsp";
    }
    if i == 2 {
        return "loment-fmt";
    }
    if i == 3 {
        return "loment-doc";
    }
    if i == 4 {
        return "loment-lomelf";
    }
    if i == 5 {
        return "loment-cli";
    }
    return "";
}

fn do_tools(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let p: ptr = ptr_add(mem, M_P2);
    let stb: ptr = ptr_add(mem, M_STB);
    bindir_from(mem, ab, bindir);
    title(mem, 1, "包内工具");
    let i: u32 = 0;
    let ok: u32 = 0;
    while i < 6 {
        let nm: str = tool_name(i);
        if tool_path(bindir, nm, p, stb) {
            wstr(1, "  ");
            green(mem, 1);
            wstr(1, "✓ ");
            colr(mem, 1);
            wpad(1, nm, 18);
            gray(mem, 1);
            wstr(1, "就位");
            colr(mem, 1);
            wstr(1, "\n");
            ok = ok + 1;
        } else {
            wstr(1, "  ");
            red(mem, 1);
            wstr(1, "✗ ");
            colr(mem, 1);
            wpad(1, nm, 18);
            gray(mem, 1);
            wstr(1, "缺");
            colr(mem, 1);
            wstr(1, "\n");
        }
        i = i + 1;
    }
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "共 ");
    colr(mem, 1);
    bold(mem, 1);
    wdec(mem, 1, ok);
    colr(mem, 1);
    gray(mem, 1);
    wstr(1, " / 6 就位");
    colr(mem, 1);
    wstr(1, "\n\n");
    if ok < 6 {
        return 1;
    }
    return 0;
}

fn do_where(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let p: ptr = ptr_add(mem, M_P2);
    let stb: ptr = ptr_add(mem, M_STB);
    bindir_from(mem, ab, bindir);
    if argc < 3 {
        wbuf(1, bindir);
        wstr(1, "\n");
        return 0;
    }
    let name: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, 2, name);
    let nm: str = "";
    if eq_cstr(name, strlen_n(name), "driver") {
        nm = "loment-driver";
    } else if eq_cstr(name, strlen_n(name), "lsp") {
        nm = "loment-lsp";
    } else if eq_cstr(name, strlen_n(name), "fmt") {
        nm = "loment-fmt";
    } else if eq_cstr(name, strlen_n(name), "doc") {
        nm = "loment-doc";
    } else if eq_cstr(name, strlen_n(name), "lomelf") {
        nm = "loment-lomelf";
    } else if eq_cstr(name, strlen_n(name), "cli") {
        nm = "loment-cli";
    } else {
        return err2_unknown(mem, name);
    }
    if tool_path(bindir, nm, p, stb) {
        wbuf(1, p);
        wstr(1, "\n");
        return 0;
    }
    // 报错要报**期望路径**, 不能报 tool_path 失败后清空的那个缓冲
    let q: ptr = ptr_add(mem, M_P1);
    let bn: u32 = strlen_n(bindir);
    put_n(q, bindir, bn);
    put(ptr_add(q, bn), nm);
    err_path(mem, "没找到 ", q);
    return 1;
}

fn err2_unknown(mem: ptr, name: ptr) -> u32 {
    err_path(mem, "不认识的工具 ", name);
    gray(mem, 2);
    wstr(2, "  driver / lsp / fmt / doc / lomelf / cli");
    colr(mem, 2);
    wstr(2, "\n");
    return 2;
}

fn do_env(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let share: ptr = ptr_add(mem, M_P2);
    let ver: ptr = ptr_add(mem, M_P1);
    bindir_from(mem, ab, bindir);
    share_dir(mem, ab, share);
    version_text(mem, bindir, ver);
    title(mem, 1, "环境");
    kvb(mem, 1, "bin 目录", bindir);
    kvb(mem, 1, "share 目录", share);
    kvb(mem, 1, "版本", ver);
    kvs(mem, 1, "路径来自", "argv[0] —— CLI 自定位, 不读环境变量");
    return 0;
}

fn do_doctor(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let p: ptr = ptr_add(mem, M_P2);
    let stb: ptr = ptr_add(mem, M_STB);
    let ver: ptr = ptr_add(mem, M_P1);
    bindir_from(mem, ab, bindir);
    title(mem, 1, "体检");
    let bad: u32 = 0;
    let i: u32 = 0;
    while i < 6 {
        let nm: str = tool_name(i);
        if tool_path(bindir, nm, p, stb) {
            wstr(1, "  ");
            green(mem, 1);
            wstr(1, "ok   ");
            colr(mem, 1);
            wstr(1, nm);
            wstr(1, "\n");
        } else {
            wstr(1, "  ");
            red(mem, 1);
            wstr(1, "缺失 ");
            colr(mem, 1);
            wstr(1, nm);
            wstr(1, "  ");
            gray(mem, 1);
            wstr(1, "→ loment build/run 会不可用");
            colr(mem, 1);
            wstr(1, "\n");
            bad = bad + 1;
        }
        i = i + 1;
    }
    // share/version
    version_text(mem, bindir, ver);
    if eq_cstr(ver, strlen_n(ver), "unknown") {
        wstr(1, "  ");
        red(mem, 1);
        wstr(1, "缺失 ");
        colr(mem, 1);
        wstr(1, "share/loment/version\n");
        bad = bad + 1;
    } else {
        wstr(1, "  ");
        green(mem, 1);
        wstr(1, "ok   ");
        colr(mem, 1);
        wstr(1, "版本 ");
        wbuf(1, ver);
        wstr(1, "\n");
    }
    wstr(1, "\n");
    if bad == 0 {
        green(mem, 1);
        wstr(1, "  全绿");
        colr(mem, 1);
        wstr(1, "\n\n");
        return 0;
    }
    red(mem, 1);
    wstr(1, "  ");
    wdec(mem, 1, bad);
    wstr(1, " 项缺失 —— 重装或把对应文件放回 bin/");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 1;
}

fn do_color(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc >= 3 {
        let a: ptr = ptr_add(mem, M_P1);
        arg_copy(mem, ab, 2, a);
        let n: u32 = strlen_n(a);
        if eq_cstr(a, n, "on") {
            store32(mem, M_CELL + C_COLOR, 1);
        } else if eq_cstr(a, n, "off") {
            store32(mem, M_CELL + C_COLOR, 0);
        } else {
            return err_usage(mem, "color 只认 on / off");
        }
    }
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "彩色 ");
    colr(mem, 1);
    if color_on(mem) {
        green(mem, 1);
        wstr(1, "on");
    } else {
        red(mem, 1);
        wstr(1, "off");
    }
    colr(mem, 1);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "默认 on。管道里不要转义序列时加 --no-color 或先跑 loment color off。");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 错误码

fn codrow(mem: ptr, fd: u64, code: str, desc: str) {
    wstr(fd, "  ");
    yellow(mem, fd);
    wpad(fd, code, 5);
    colr(mem, fd);
    wstr(fd, desc);
    wstr(fd, "\n");
}

// 速查表的行: 头一列是中文词, 按显示宽度对齐
fn termrow(mem: ptr, fd: u64, term: str, desc: str) {
    wstr(fd, "  ");
    yellow(mem, fd);
    wpadx(fd, term, 10);
    colr(mem, fd);
    wstr(fd, desc);
    wstr(fd, "
");
}

fn do_codes(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Loment 错误码");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "码按「你该做什么」分, 不按措辞分。编译器打的是 E2 @13 line 4: x —— E2=E002, @13 是第 13 个 token。");
    colr(mem, 1);
    wstr(1, "\n\n");
    codrow(mem, 1, "E1", "类型对不上 (含 return / 载荷 / 内建实参)");
    codrow(mem, 1, "E2", "有东西没声明 —— 十有八九是漏写类型标注, 或函数名拼错");
    codrow(mem, 1, "E3", "实参个数不对");
    codrow(mem, 1, "E4", "能力域问题 (未声明 / 越界 / 重复)");
    codrow(mem, 1, "E5", "用了 excluded 声明出界的空间");
    codrow(mem, 1, "E6", "值已被移动");
    codrow(mem, 1, "E7", "借用冲突 (可变借用与借用并存 / 可变借用两次)");
    codrow(mem, 1, "E8", "match / 枚举 (不穷尽、模式重复、载荷绑定不对)");
    codrow(mem, 1, "E9", "命名与基类型冲突 / 空 struct / 空 enum");
    codrow(mem, 1, "E10", "? 用在了不是 Result/Option 的地方");
    codrow(mem, 1, "E11", "切片可变性 (只读切片不能写、形参要 mut)");
    codrow(mem, 1, "E12", "悬垂引用");
    codrow(mem, 1, "E13", "重复定义 / 重名");
    codrow(mem, 1, "E14", "赋值目标不是左值");
    codrow(mem, 1, "E15", "字段与下标 (无此字段、缺字段、重复初始化…)");
    codrow(mem, 1, "E16", "数组字面量 / 长度与声明不符");
    codrow(mem, 1, "E17", "as 转换非法");
    codrow(mem, 1, "E18", "use <名字> 解析不出来 —— 改名字/补文件, 或改用路径形式");
    codrow(mem, 1, "E19", "语法错误 (解析期) —— 按消息给的 行:列 改那一行");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "loment explain E4 看单条的详细改法。");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn parse_code(p: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    if n > 0 && (load8(p, 0) == 69 || load8(p, 0) == 101) {
        i = 1;
    }
    let v: u32 = 0;
    let got: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if digit(c) {
            v = v * 10 + (c - 48);
            got = 1;
        } else {
            return 0;
        }
        i = i + 1;
    }
    if got == 0 {
        return 0;
    }
    return v;
}

fn do_explain(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "explain 需要一个错误码, 如 E4");
    }
    let a: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, 2, a);
    let code: u32 = parse_code(a, strlen_n(a));
    if code == 0 || code > 19 {
        return err_usage(mem, "错误码得是 E1..E19");
    }
    wstr(1, "\n  ");
    yellow(mem, 1);
    wstr(1, "E");
    wdec(mem, 1, code);
    colr(mem, 1);
    wstr(1, "\n\n  ");
    if code == 1 {
        wstr(1, "类型对不上。\n\n  常见: return 的值与声明不符; 枚举载荷类型不对; 内建函数实参类型不对。\n  改法: 看 IR 或对照函数签名; 转换要显式写 `as`。");
    } else if code == 2 {
        wstr(1, "有东西没声明。\n\n  最常见的三件事:\n    1. `let x = 1;` —— 语言没有类型推断, 要写 `let x: u32 = 1;`\n    2. 函数名拼错, 或忘了 `pub` (跨模块调用必须 pub)\n    3. 先用了后定义 —— 模块内要求先定义后使用\n  注意: 泛型函数实参定不出 T 时也报 E2, 那条消息会误导。");
    } else if code == 3 {
        wstr(1, "实参个数不对。\n\n  改法: 数一遍形参与实参; 形参最多 10 个。");
    } else if code == 4 {
        wstr(1, "能力域问题。\n\n  `capability c : disk[0..4]` 声明域, `guard c(i);` 用它。\n  字面量越界是编译期错误; 非字面量是运行期检查。\n  改法: 看域范围 [lo..hi] 是否含这个下标。");
    } else if code == 8 {
        wstr(1, "match / 枚举问题。\n\n  三种常见:\n    1. 臂体写成了表达式 —— 必须是块: `E::A => { return 0; }`\n    2. 泛型枚举要写单态化后的名字: `Result_i64_u32::Ok(v)`\n    3. 没穷尽, 也没写 `_` 臂");
    } else if code == 18 {
        wstr(1, "use 解析不出来。\n\n  两种写法: `use 名字` 或 `use \"路径.lomt\"`, 都**不带分号**。\n  改法: 确认文件在 loment/lib、examples、selfhost 或 tools 下; 自己目录里的伴生文件用路径形式。");
    } else if code == 19 {
        wstr(1, "语法错误 (解析期)。\n\n  消息给的是 行:列, 直接去那一行改。\n  两个最常见: `use x;` 多了分号; `return;` 没有值 (要 `return <expr>;`)。\n  注意: 一个解析错会中止整个检查, 后面的诊断都出不来 —— 一次只改一处。");
    } else {
        wstr(1, "见 loment codes 表:这一条属于「按你该做什么」分类的");
        wstr(1, "  ");
        wstr(1, "一类。");
    }
    wstr(1, "\n\n  ");
    gray(mem, 1);
    wstr(1, "完整表: loment codes   语法: loment syntax   指南: loment skill --print");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

