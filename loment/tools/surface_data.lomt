/// 这个码有几条修法（0 = 表里没有这个码）。**语言不进键** —— 两个语言槽的条数
/// 由生成器硬失败钉成相等，所以一个数就够。
pub fn code_nfix(c: u32) -> u32 {
    if c == 1 { return 4; }
    if c == 2 { return 4; }
    if c == 3 { return 3; }
    if c == 4 { return 4; }
    if c == 5 { return 3; }
    if c == 6 { return 4; }
    if c == 7 { return 4; }
    if c == 8 { return 4; }
    if c == 9 { return 3; }
    if c == 10 { return 3; }
    if c == 11 { return 3; }
    if c == 12 { return 4; }
    if c == 13 { return 4; }
    if c == 14 { return 3; }
    if c == 15 { return 4; }
    if c == 16 { return 4; }
    if c == 17 { return 4; }
    if c == 18 { return 4; }
    if c == 19 { return 4; }
    if c == 20 { return 3; }
    if c == 21 { return 4; }
    if c == 22 { return 5; }
    if c == 23 { return 3; }
    return 0;
}

// ---------------------------------------------------------------- 语言卡
// **键集 == `potato_from.LANGS`**（判据钉着）：翻译线加一门语言而这里没跟上,
// 症状是"新语言的文件报错时只字不提怎么翻" —— 静默缺口。

pub fn lang_count() -> u32 { return 7; }

pub fn decl_word_count() -> u32 { return 3; }

/// 声明的第 `i` 个词（`choose` / `write` / `grammar`）—— 词序是两边共享的契约。
pub fn decl_word(i: u32) -> str {
    if i == 0 { return "choose"; }
    if i == 1 { return "write"; }
    if i == 2 { return "grammar"; }
    return "";
}

pub fn alias_count() -> u32 { return 16; }

/// 第 `i` 个语法别名（报错器按**小写**比 —— 作者写 `C#` 还是 `c#` 都该认）。
pub fn alias_word(i: u32) -> str {
    if i == 0 { return "c"; }
    if i == 1 { return "c#"; }
    if i == 2 { return "c++"; }
    if i == 3 { return "cc"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "cs"; }
    if i == 6 { return "csharp"; }
    if i == 7 { return "cxx"; }
    if i == 8 { return "go"; }
    if i == 9 { return "golang"; }
    if i == 10 { return "java"; }
    if i == 11 { return "loment"; }
    if i == 12 { return "py"; }
    if i == 13 { return "python"; }
    if i == 14 { return "rs"; }
    if i == 15 { return "rust"; }
    return "";
}

/// 该别名对应的语言（= `LANG_CARDS` 的键 / `potato_from.LANGS` 的键）。
pub fn alias_lang(i: u32) -> str {
    if i == 0 { return "c"; }
    if i == 1 { return "csharp"; }
    if i == 2 { return "cpp"; }
    if i == 3 { return "cpp"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "csharp"; }
    if i == 6 { return "csharp"; }
    if i == 7 { return "cpp"; }
    if i == 8 { return "go"; }
    if i == 9 { return "go"; }
    if i == 10 { return "java"; }
    if i == 11 { return "loment"; }
    if i == 12 { return "python"; }
    if i == 13 { return "python"; }
    if i == 14 { return "rust"; }
    if i == 15 { return "rust"; }
    return "";
}

pub fn lang_key(i: u32) -> str {
    if i == 0 { return "cpp"; }
    if i == 1 { return "c"; }
    if i == 2 { return "csharp"; }
    if i == 3 { return "java"; }
    if i == 4 { return "go"; }
    if i == 5 { return "rust"; }
    if i == 6 { return "python"; }
