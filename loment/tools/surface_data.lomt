// surface_data.lomt — 由 `tools/loment_diag.py --dump-surface` 生成，别手改。
//
// 码 -> 文字 + 语言卡。**唯一真源是 `tools/loment_diag.py`**（RULES / CARDS /
// ASCII_ONE_LINER / LANG_CARDS），这里只是它的可读副本（`docs/176` B 那条管线：
// 数据从逻辑里拆出来，自举侧 `use` 它）。
//
// 为什么要生成而不是手抄第二份：`loment/tools/lomcli.lomt` 原先手抄了 24 条 `codrow`，
// 与 `loment_diag.RULES` 是同一件事的两份 —— 而本仓那四个静默 bug（docs/179 7.3）
// 全出自"同一份清单抄第二遍"。
//
// 中文与 ASCII **不是重复**：CLI 输出必须纯 ASCII（docs/169，936 控制台下 UTF-8 中文
// 被按 GBK 解成乱码，PE 垫片没有 WriteConsoleW），诊断那侧本来就是中文。两个受众。
//
// `code_fix` 用的是**平键 `c * 8 + i`**（一条码最多 8 条修法）：按码嵌 `if` 要嵌
// 两层，平键一层就够，而且生成器这边一眼看得出哪条码少了哪一档。
// **码从 1 起连续编号**, 所以 `n_codes()` 也就是最后那个码 —— 两个消费者（`lomcli`
// 的 codes/explain、报错器）都拿它当上界用, 那条不变式有判据钉着。

module surface_data

pub fn n_codes() -> u32 { return 23; }

pub fn code_title(c: u32) -> str {
    if c == 1 { return "类型不匹配"; }
    if c == 2 { return "符号未声明"; }
    if c == 3 { return "实参数量不符"; }
    if c == 4 { return "能力域非法"; }
    if c == 5 { return "与出界声明冲突"; }
    if c == 6 { return "移动后使用"; }
    if c == 7 { return "借用冲突"; }
    if c == 8 { return "match/变体用法非法"; }
    if c == 9 { return "类型名非法"; }
    if c == 10 { return "`?` 误用"; }
    if c == 11 { return "只读切片写入"; }
    if c == 12 { return "悬垂借用"; }
    if c == 13 { return "重名"; }
    if c == 14 { return "赋值目标非法"; }
    if c == 15 { return "字段/下标/取址非法"; }
    if c == 16 { return "数组字面量非法"; }
    if c == 17 { return "`as` 转换非法"; }
    if c == 18 { return "名字导入无法唯一解析"; }
    if c == 19 { return "语法错误（词法/解析期）"; }
    if c == 20 { return "单个文件的 use 太多"; }
    if c == 21 { return "外部函数的签名不支持"; }
    if c == 22 { return "`choose` / `addin` 用法不对"; }
    if c == 23 { return "这一版还没实现（编译器限制）"; }
    return "";
}

pub fn code_what(c: u32) -> str {
    if c == 1 { return "两处类型对不上 —— 返回值与声明、实参与形参、载荷与变体、内建实参、赋值两侧。"; }
    if c == 2 { return "用了一个没有声明的名字 —— 变量、函数、类型、常量都算。"; }
    if c == 3 { return "调用时给的实参个数与函数签名对不上。"; }
    if c == 4 { return "能力域本身有问题 —— 没声明就 `guard`、`[lo..hi]` 的边界不对、同名重复声明。"; }
    if c == 5 { return "用了一个被 `excluded` 声明**排除在外**的空间。"; }
    if c == 6 { return "一个值被**移动**给别人之后，又用它了。"; }
    if c == 7 { return "同一个变量在同一次调用里，既被可变借用又被借用，或者被可变借用两次。"; }
    if c == 8 { return "`match` 或枚举的用法有问题：不穷尽、模式重复、载荷绑定不对、主体不是枚举、臂体写成了表达式。"; }
    if c == 9 { return "类型名与基类型重名，或者声明了一个**空**的 `struct`/`enum`。"; }
    if c == 10 { return "`?` 用在了不返回 `Result`/`Option` 的地方，或者不在 `let` 的绑定位置。"; }
    if c == 11 { return "往一个**只读**切片里写，或者形参没声明 `mut`。"; }
    if c == 12 { return "返回了一个指向**局部变量**的引用。"; }
    if c == 13 { return "同一作用域里同一个名字出现了两次 —— 函数、类型、常量、字段、变体、参数都算。"; }
    if c == 14 { return "赋值左边不是一个能放东西的位置（不是左值）。"; }
    if c == 15 { return "字段或下标用错了 —— 没有这个字段、缺字段、重复初始化、对非结构体取字段、对非数组取下标。"; }
    if c == 16 { return "数组字面量有问题 —— 是空的、元素类型不一致、或者个数与声明长度不符。"; }
    if c == 17 { return "`as` 的目标类型不对，或者这个方向转不过去。"; }
    if c == 18 { return "`use <名字>` 解析不出来 —— 要么找不到，要么命中多处不知道用哪个。"; }
    if c == 19 { return "这一行按 Loment 的语法读不通 —— 词法期或解析期就停了。"; }
    if c == 20 { return "一个文件里的 `use` 超过了 **300 条**。"; }
    if c == 21 { return "`extern fn` 的签名超出了 FFI 第 1 阶段收的那几种。"; }
    if c == 22 { return "开关（`choose`）或核心模式（`std`/`no_std`）的写法不对。"; }
    if c == 23 { return "你写的东西语法和语义都对 —— 是**这一版的编译器后端还没做这块**。"; }
    return "";
}

pub fn code_why(c: u32) -> str {
    if c == 1 { return "Loment **没有隐式数值转换**，也没有类型推断：每个位置上的类型必须显式对得上。所以 `u32` 的值不会自动变成 `i64`，整数 `1` 也不是 `bool` 的 `true`。"; }
    if c == 2 { return "这是**新手撞得最多**的一条，而它在 Loment 里几乎总是同一件事：**没有类型推断** —— `let x = 1;` 是语法错，必须 `let x: u32 = 1;`。其次是**先定义后使用**（同一模块内），以及跨模块要 `pub` 导出 + `use` 导入。"; }
    if c == 3 { return "形参最多 **10 个**；方法调用的 `self` **不计入**实参；Loment 没有默认参数、没有可变参数、也没有重载 —— 名字不同就是不同函数。"; }
    if c == 4 { return "能力域是 Loment 唯一“新加的东西”：`capability c : space[lo..hi]` 声明一个**索引域**，`guard c(i);` 检查 `i` 落在域内（字面量越界是**编译期错**，其余是运行期 trap）。所以域必须**先声明**、`lo <= hi`、同一空间同一个名字只声明一次。"; }
    if c == 5 { return "`excluded “space: ...”` 是**出界声明**：它把一个空间从“本程序可以碰的”里拿掉，是给安全审计看的一份承诺。于是再用那个空间就与自己的承诺冲突 —— 这是**故意的**，不是编译器挑剔。"; }
    if c == 6 { return "Loment 的聚合类型（`struct` / `enum`）默认是**移动**语义：按值传进函数、按值赋给另一个变量，都相当于把所有权交出去。**全字段是整型**的类型自动按 `Copy` 处理，不会报这条。"; }
    if c == 7 { return "`&mut` 是**独占**借用（与 Rust 同一套规则）：可变借用存在期间，别的借用（包括只读的）都不能同时存在。这不是性能问题，是“谁能改它”的答案必须唯一。"; }
    if c == 8 { return "`match` 必须**穷尽**（或者有 `_` 兜底）；**臂体是块**、不是表达式；带载荷的变体模式要绑变量、无载荷的不能带括号；**泛型枚举**的模式要用**单态化之后**的名字（`Result_i64_u32::Ok(v)`），不是 `Result::Ok(v)`。"; }
    if c == 9 { return "`u8 u16 u32 u64 i8 i16 i32 i64 bool ptr str` 是**基类型名**，用户类型再叫这些名字，后面就没法区分了。空聚合同理：一个字段/变体都没有的类型表达不了任何东西，**当错误拒掉比让它悄悄存在好** —— 它多半是写了一半。"; }
    if c == 10 { return "`?` 的语义是“**错了就直接返回，对了就取出载荷**” —— 所以它要求两件事：当前函数返回 `Result`（或 `Option`），而且 `?` 只能出现在 `let x: T = expr?;` 的绑定位置。它不是一个“忽略错误”的记号。"; }
    if c == 11 { return "`fn f(xs: [u32])` 拿到的是**只读**切片 —— 切片是“借来的视野”，能不能写由形参类型决定。要写就得 `mut [u32]`，而调用处必须传 `&mut arr`（只读切片没人能借成可写的）。"; }
    if c == 12 { return "局部变量在函数返回时就不存在了，返回给它的引用必然悬垂。所以能安全返回的引用，只能来自**形参**（或来自调用方传进来的内存）—— 这是生命周期规则在 Loment 里的落点。"; }
    if c == 13 { return "`use` 是**平名字空间**：一个单元里的顶层名字必须唯一，所以**两个库也不能有同名顶层项**。这也是为什么 std 里的公开名字都带前缀（`json_parse` / `sha256_hex`）——不带的迟早会撞。"; }
    if c == 14 { return "只有**变量、字段、下标**可以被赋值 —— 它们指向一块确定的内存。表达式的结果（`a + b`、函数返回值）没有地址，所以放不了东西。"; }
    if c == 15 { return "结构体字面量的字段要**齐全且不重复**（没有默认值这回事）；`.` 只能用在结构体上，`[]` 只能用在数组/切片上，`&`/`&mut` 只能作用于数组或切片。另外两条形状上的规矩：**结构体字面量不能直接当实参**，**条件位置不能直接写结构体字面量**。"; }
    if c == 16 { return "`let xs: [u32; 3] = [1, 2, 3];` —— **长度是类型的一部分**，所以个数必须写死对得上，没有“按字面量长度自动推断”这回事（那需要类型推断，而 Loment 没有）。"; }
    if c == 17 { return "`as` 只做**位级**的转换：整数⇄整数、整数⇄布尔、指针⇄整数。别的（字符串→数字、结构体→结构体）不是“转换”而是“解析/构造”，必须写出过程来。"; }
    if c == 18 { return "名字形式按**层**搜：① 项目本地 `deps/<名字>/<名字>.lomt` → ② 工具链自带 store → ③ 内置四根（`loment/lib` → `examples` → `selfhost` → `tools`）。**前两层先命中先用**，唯一性只管第 ③ 层。所以撞名的症状通常是“我以为是另一个”。"; }
    if c == 19 { return "Loment 是 **Rust 的严格子集**，但它**去掉了**几样东西：单引号字符字面量、无值 `return;`、表达式式的 `match` 臂、`mut` 作为绑定修饰词。照 Rust 的习惯写很容易踩到这几处 —— 它们不是“暂时不支持”，是这门语言没有。"; }
    if c == 20 { return "这是一道**防静默丢**的闸门：自举镜像里那个暂存区原来就那么大，超出的会被悄悄丢掉，于是同一份源码在参考实现与自举镜下**给出不同的单元**。现在两边都是 300，超限报错 ——宁可报错也不要“少了一块但看起来编过了”。"; }
    if c == 21 { return "第 1 阶段只收**标量**（`i8..i64` / `u8..u64` / `bool`）与 `ptr`。`str` 在 Loment 里是“**指针 + 长度**”，**不是** C 字符串，两者不通用；结构体/枚举按值传要另一套寄存器分类规则 —— 都会**改变调用点的代码形状**，所以一律报错退出而不是静默错编。"; }
    if c == 22 { return "这是**两个不同的东西**被放在一起管：① **核心模式**是**整个程序**的属性 —— 只能出现一次、只能写在根单元（`loment.conf` 之外没有第二个地方能改它）；② **开关**是“打开才编进去的代码”，可以有很多条，但**同名只许写一次**、**取值前必须先 `set choose` 定义**。库不许 `choose` —— 库要表达需要就声明**能力需求**，由项目决定开不开。"; }
    if c == 23 { return "参考实现有两条后端：一条 Rust 转译路径走得远，原生 IR 路径（M0 起）是**逐块补**出来的。这条消息来自后者 —— 所以它**不是你的错**，把它当成“设计上还没到这里”看。这也是它单独一个码的理由：用户能做的事（换个写法绕开）与“照建议改那一行”完全不同。"; }
    return "";
}

pub fn code_yes(c: u32) -> str {
    if c == 1 { return "显式 `as`（整数⇄整数、整数⇄布尔、指针⇄整数）；标量/字符串/切片/数组/结构体/枚举作为类型"; }
    if c == 2 { return "泛型（调用点能定出 T 时）／trait 静态派发／`pub` 跨模块／两种 `use`"; }
    if c == 3 { return "最多 10 个形参；方法调用的 `self` 由编译器补"; }
    if c == 4 { return "`capability` + `guard`；`revocable` 标；字面量越界的编译期检查"; }
    if c == 5 { return "`excluded “<space>: ...”` 出界声明；多个能力域各占各的空间"; }
    if c == 6 { return "显式 `&` / `&mut`；全字段整型的聚合自动 `Copy`"; }
    if c == 7 { return "同一作用域里多个**只读**借用；一次可变借用"; }
    if c == 8 { return "`match` / `if let` / 单载荷变体 / `_` 兜底 / 泛型枚举（用单态化名）"; }
    if c == 9 { return "任意多字段的 `struct`；任意多变体的 `enum`（含单载荷）"; }
    if c == 10 { return "`Result` / `Option` / 绑定位置的 `?` / `match` 显式处理"; }
    if c == 11 { return "`[T]`（只读）与 `mut [T]`（可写）两种切片；`&arr` / `&mut arr` 两种传法"; }
    if c == 12 { return "返回来自形参的引用/切片；按值返回"; }
    if c == 13 { return "一个单元里任意多模块/函数/类型，只要名字不撞"; }
    if c == 14 { return "变量、结构体字段、数组/切片下标赋值"; }
    if c == 15 { return "字段读写、下标读写、`&arr` 取切片、结构体字面量（先绑变量）"; }
    if c == 16 { return "定长数组 `[T; N]`；字面量 `[1, 2, 3]`；下标读写"; }
    if c == 17 { return "整数⇄整数、整数⇄布尔、指针⇄整数的 `as`"; }
    if c == 18 { return "两种 `use`（名字 / 路径）；单文件最多 300 条；按层搜索 + 前缀优先"; }
    if c == 19 { return "Rust 子集那套语法；`//` `/* */` 注释；`let x: T = e;`"; }
    if c == 20 { return "单文件最多 300 条 `use`（路径形式 + 名字形式合起来算）"; }
    if c == 21 { return "标量与 `ptr` 的形参/返回；多个 `--link`；调用点走平台 C ABI（Linux 前六个整数实参进 rdi/rsi/rdx/rcx/r8/r9；Windows 进 rcx/rdx/r8/r9）"; }
    if c == 22 { return "单文件最多 500 条开关；`addin` 跨文件带开关设定（只有根单元能写）；空体开关（只驱动编译器行为）；库声明能力域"; }
    if c == 23 { return "标量运算、控制流、字符串、数组、切片、结构体、枚举（`match`）—— 按值传聚合看目标后端"; }
    return "";
}

pub fn code_no(c: u32) -> str {
    if c == 1 { return "隐式提升与隐式转换（`u32` → `i64` 也必须写 `as`）；整数与布尔互用"; }
    if c == 2 { return "类型推断／隐式全局／同一模块内的前向引用／隐式数值转换"; }
    if c == 3 { return "默认参数／可变参数／函数重载"; }
    if c == 4 { return "**授权** —— `guard` 只约束索引落在域内，不检查“当前主体有没有这个能力”（主体-能力的绑定在内核侧）"; }
    if c == 5 { return "局部豁免（“只在这一处放行”做不到）；对同一个空间既排除又使用"; }
    if c == 6 { return "隐式复制聚合；移动后再使用同一个值"; }
    if c == 7 { return "可变借用与任何其它借用并存；同一变量的两次可变借用"; }
    if c == 8 { return "臂体是表达式；多载荷变体；非穷尽且没有 `_`；`==` 直接比较枚举（checker 放行但原生后端会拒）"; }
    if c == 9 { return "与基类型重名；空 `struct`；空 `enum`"; }
    if c == 10 { return "在非 `let` 位置用 `?`；在返回非 `Result`/`Option` 的函数里用 `?`"; }
    if c == 11 { return "在只读切片上写；把 `&arr` 借成可写的"; }
    if c == 12 { return "返回指向局部变量的引用或切片"; }
    if c == 13 { return "同名顶层项共存；两个库同时导出同一个名字"; }
    if c == 14 { return "给表达式或字面量赋值（`1 = x`、`f() = x`）"; }
    if c == 15 { return "结构体字面量直接当实参；条件位置直接写结构体字面量；缺字段/多字段字面量"; }
    if c == 16 { return "空字面量；按字面量推断长度；元素类型不一致的数组"; }
    if c == 17 { return "聚合之间的 `as`；字符串与数字之间的 `as`（要自己写解析）"; }
    if c == 18 { return "第 ③ 层的歧义；循环导入；超过 300 条（那是 E020）"; }
    if c == 19 { return "单引号字符字面量；无值 `return;`；表达式式 match 臂；`let mut x: T`（`mut` 不是关键字）"; }
    if c == 20 { return "超过 300 条（超限是**报错**，不是截断）"; }
    if c == 21 { return "`str` 形参/返回（那是“指针+长度”，不是 C 字符串）；结构体/枚举/数组**按值**；`extern fn` 带类型参数；PE 目标的 FFI；`.a` 归档与 `.so`/`.dll` 动态库"; }
    if c == 22 { return "核心模式写两次或写在库里；取值前没定义；同名两个取值；嵌套声明；库写 `choose` 或 `addin`"; }
    if c == 23 { return "**这条消息本身就是“不支持”** —— 具体范围以 `docs/145` 的里程碑表为准，不在源码那一侧"; }
    return "";
}

pub fn code_ascii(c: u32) -> str {
    if c == 1 { return "type mismatch (return / payload / builtin argument)"; }
    if c == 2 { return "something is not declared - usually a missing type annotation or a misspelt name"; }
    if c == 3 { return "wrong number of arguments"; }
    if c == 4 { return "capability domain problem (undeclared / out of range / duplicate)"; }
    if c == 5 { return "used space that an `excluded` declaration put out of bounds"; }
    if c == 6 { return "value has been moved"; }
    if c == 7 { return "borrow conflict (mutable borrow next to a borrow / two mutable borrows)"; }
    if c == 8 { return "match / enum (not exhaustive, duplicate pattern, bad payload binding)"; }
    if c == 9 { return "name clashes with a base type / empty struct / empty enum"; }
    if c == 10 { return "`?` used where there is no Result or Option"; }
    if c == 11 { return "slice mutability (cannot write a read-only slice; the parameter needs `mut`)"; }
    if c == 12 { return "dangling reference"; }
    if c == 13 { return "duplicate definition / duplicate name"; }
    if c == 14 { return "assignment target is not an lvalue"; }
    if c == 15 { return "field or index (no such field, missing field, duplicate init, field on a non-struct)"; }
    if c == 16 { return "array literal / length does not match the declaration"; }
    if c == 17 { return "illegal `as` cast"; }
    if c == 18 { return "`use <name>` does not resolve - rename it, add the file, or use the path form"; }
    if c == 19 { return "parse error - fix that line as the `line:col` in the message says"; }
    if c == 20 { return "more than 300 `use` in one file - split the facade"; }
    if c == 21 { return "`extern fn` signature outside FFI stage 1 - scalars and `ptr` only"; }
    if c == 22 { return "bad `choose`: written twice, bad mode name, or written in a library"; }
    if c == 23 { return "not implemented in this version - a compiler limit, not your code"; }
    return "";
}

const FIX_STRIDE: u32 = 8;

/// 第 `i` 条修法（`i` 从 0 起）。`i` 超出该码的条数就是空串。
pub fn code_fix(c: u32, i: u32) -> str {
    let k: u32 = c * FIX_STRIDE + i;
    if k == 8 { return "照签名改一侧：看函数声明的返回类型/形参类型，把表达式改成那一侧。"; }
    if k == 9 { return "整型宽度不同就显式写 `as`：`x as u64`、`n as i32`（整数⇄整数、整数⇄布尔、指针⇄整数都可以）。"; }
    if k == 10 { return "布尔与整数分开：条件位置写 `x != 0` 或 `true`，不要指望 `1` 能当 `true`。"; }
    if k == 11 { return "数组/结构体的元素类型要统一，逐个 `as` 或加一个转换函数。"; }
    if k == 16 { return "补类型标注：`let x: u32 = 1;`（`let` 不带类型是 **E19 语法错**，但很容易被当成这条）。"; }
    if k == 17 { return "拼错了就改拼写；跨模块调用给声明加 `pub`，调用方补 `use <模块名>` 或 `use “./x.lomt”`。"; }
    if k == 18 { return "泛型函数的实参要能把 `T` 定出来：先 `let a: u32 = 4;` 再 `pick(a, b)` —— 直接传整数字面量会报这条，消息有误导。"; }
    if k == 19 { return "确实是别处来的名字：用路径形式 `use “./util.lomt”` 指明位置。"; }
    if k == 24 { return "照着签名数一遍，多的删、缺的补。"; }
    if k == 25 { return "方法调用别把 `self` 算进去（`obj.m(a)` 是 1 个实参，不是 2 个）。"; }
    if k == 26 { return "想写重载就换个名字：`parse_int` / `parse_float` —— Loment 按名字解析，同名不同参不允许。"; }
    if k == 32 { return "在模块顶层补声明：`capability c : disk[0..4]`（`c` 是名字，`disk` 是空间名）。"; }
    if k == 33 { return "边界反了就调正：必须 `lo <= hi`（`[0..4]` 是 0,1,2,3,4 五个值）。"; }
    if k == 34 { return "重名就改名；同一空间可以有多个域，各用各的名字。"; }
    if k == 35 { return "索引是字面量且越界：改索引或把域放大 —— 这是编译期检查，不是运行期。"; }
    if k == 40 { return "删掉那条 `excluded`（如果那份承诺本来就不该有）。"; }
    if k == 41 { return "换一个没有被排除的空间来声明能力域。"; }
    if k == 42 { return "保留承诺、把用到它的那处改掉 —— 能力域本来就是用来把访问收在明确范围内的。"; }
    if k == 48 { return "改成传引用：`f(&v)` 或 `f(&mut v)` —— 最常用的改法。"; }
    if k == 49 { return "确实要留一份：先在**移动之前**把需要的字段拷到新变量，再传。"; }
    if k == 50 { return "让类型变成可 `Copy` 的：字段全用整型（`u32`/`i64`/`bool`…），去掉里面的字符串/切片/指针。"; }
    if k == 51 { return "把所有权安排清楚：让它最后被用到的那一处消费，前面都用引用。"; }
    if k == 56 { return "只留一种借用：把 `&a, &mut a` 改成两次都用 `&a`（只读），或都改成 `&mut`。"; }
    if k == 57 { return "先把值取出来再传：`let n: u32 = a.x;` 然后传 `&mut a, n`。"; }
    if k == 58 { return "把一句话拆成两句：先读完、把结果存进变量，再做可变借用。"; }
    if k == 59 { return "要同时读写同一块，就按“读出来 → 算 → 写回去”三段写。"; }
    if k == 64 { return "臂体写成块：`E::A => { return 0; }`（写成 `E::A => 0,` 是 E19 语法错）。"; }
    if k == 65 { return "加一条 `_ => { ... }` 兜底，或把剩下的变体补全 —— 枚举加了变体之后这里就会红，这是故意的。"; }
    if k == 66 { return "泛型枚举用单态化名：`Result_i64_u32::Ok(v)` / `Result_i64_u32::Err(e)`（先看值的类型定宽）。"; }
    if k == 67 { return "载荷跟着变体走：`Kind::Big(w)` 要绑 `w`，`Kind::Small` 不能写 `Kind::Small()`。"; }
    if k == 72 { return "改名，别与基类型撞：`U32Box` / `Id` / `Amount`（带语义的名字比 `U32` 更该用）。"; }
    if k == 73 { return "`struct` 加字段；只是“先占个位”就等有字段了再声明。"; }
    if k == 74 { return "`enum` 至少给一个变体；空枚举连 `match` 都写不出来。"; }
    if k == 80 { return "把当前函数的返回类型改成 `Result<..., ...>`（或 `Option<...>`）。"; }
    if k == 81 { return "不用 `?`，显式 `match` 两个分支各写一段 —— 想在原地处理错误时用这条。"; }
    if k == 82 { return "把 `?` 挪到绑定位置：`let v: u32 = f()?;` 而不是 `g(f()?);`。"; }
    if k == 88 { return "形参改 `mut [u32]`。"; }
    if k == 89 { return "调用处改 `&mut arr`（原来大概是 `&arr`）。"; }
    if k == 90 { return "不改原数组：把切片内容复制到一个本地数组，改完再自己决定怎么用。"; }
    if k == 96 { return "返回值本身（按值返回）—— 最直接的一条。"; }
    if k == 97 { return "让调用方分配：形参收 `&mut`，把结果写进调用方给的内存。"; }
    if k == 98 { return "返回不依赖内存的信息：下标、长度、是否命中（`bool`）。"; }
    if k == 99 { return "确实要返回切片：让它指向形参而不是局部（`fn f(xs: [u32]) -> [u32] { return xs; }`）。"; }
    if k == 104 { return "重命名其中之一（最省事）。"; }
    if k == 105 { return "给名字加所属前缀：`json_parse` / `sha_parse`，撞名的可能立刻消失。"; }
    if k == 106 { return "两个库确实都要用：把其中一个的调用点改成路径形式 `use “./x.lomt”` 并改名导入后的符号。"; }
    if k == 107 { return "结构体字段/枚举变体重名：按语义改（`width`/`height` 而不是两个 `size`）。"; }
    if k == 112 { return "先把结果存进变量，再改那个变量。"; }
    if k == 113 { return "目标写成 `arr[i]` 或 `s.field` 这种“有位置”的形式。"; }
    if k == 114 { return "想改切片元素：把切片形参声明成 `mut [T]`（否则连 `arr[i] = x` 都写不了）。"; }
    if k == 120 { return "照声明补齐字段（名字和类型都要对）—— 缺哪个补哪个，多哪个删哪个。"; }
    if k == 121 { return "结构体字面量先落到变量：`let s: S = S { a: 1 };` 再 `f(s)`（当实参直接写会被后端拒）。"; }
    if k == 122 { return "条件里要用字段：加括号 `if (s.a) { }` —— 不然 `if s { }` 的歧义按 Rust 规则消解。"; }
    if k == 123 { return "取切片写 `&arr`（整块），`&arr[i]` 是取单个元素的地址，不是切片。"; }
    if k == 128 { return "让个数等于声明长度：声明 `[u32; 3]` 就给三个。"; }
    if k == 129 { return "元素类型统一：混了 `u32` 与 `i32` 就逐个 `as` 成同一种。"; }
    if k == 130 { return "空字面量不行：给个长度，或者改用切片参数 `[T]` 加 `&xs` 传进来。"; }
    if k == 131 { return "长度要变：那是切片不是数组 —— 形参写 `[T]`，调用处 `&arr`。"; }
    if k == 136 { return "目标改成基类型：`u8..u64` / `i8..i64` / `bool` / `ptr`。"; }
    if k == 137 { return "两个结构体之间要转：写一个显式函数，逐字段搬（顺便想清楚缺的字段怎么办）。"; }
    if k == 138 { return "字符串→数字：自己写解析循环（`str_byte` 逐字节，累加），没有内建 `parse`。"; }
    if k == 139 { return "整数→字符串：照 `write_dec` 的写法（取余 + 反序），也没有内建格式化。"; }
    if k == 144 { return "补文件到该在的位置（`deps/<名字>/<名字>.lomt` 是最正规的落点）。"; }
    if k == 145 { return "改名字，别与内置根里的模块撞（第 ③ 层命中多处就是名字起坏了）。"; }
    if k == 146 { return "用路径形式指明位置：`use “./util.lomt”` —— 路径形式不参与这套搜索。"; }
    if k == 147 { return "循环导入：把两边都要用的部分抽成第三个文件，两边都 `use` 它。"; }
    if k == 152 { return "按消息给的 `行:列` 看那一处（`@@@`、单引号、`#` 这类符号先查 `loment syntax`）。"; }
    if k == 153 { return "`match` 臂改成块：`E::A => { return 0; }`。"; }
    if k == 154 { return "`return` 补值：`return 0;`（Loment 没有 `return;`）。"; }
    if k == 155 { return "`let` 补类型：`let x: u32 = 1;`；本地变量不要写 `mut`（那是普通标识符，不是关键字）。"; }
    if k == 160 { return "把门面拆小：`core.lomt` 拉一半、`ext.lomt` 拉另一半，用的人按需 `use`。"; }
    if k == 161 { return "只 import 真正要用的门面（不用把整个库塞进一个文件）。"; }
    if k == 162 { return "确实很多：按层次组织（每一层只 `use` 下一层的几个），别做成一个几百条的表。"; }
    if k == 168 { return "换成标量或 `ptr`；不返回就省略 `-> T`（那样就是 void）。"; }
    if k == 169 { return "要传字符串：自己在内存里拼一个 **NUL 结尾**的字节串，形参写 `ptr`（C 那边按 `char*` 收）。"; }
    if k == 170 { return "要传结构体：改成传指针，或者把字段拆成几个标量参数。"; }
    if k == 171 { return "需要泛型：`extern fn` **不能带类型参数** —— 在 Loment 侧包一层泛型函数，里面调具体的那条。"; }
    if k == 176 { return "核心模式只写一次，而且只在入口那一份：`choose std` 或 `choose no_std`。"; }
    if k == 177 { return "开关先定义再取值：`set choose verbose { … }` 然后 `choose verbose`（或 `choose close verbose`）。"; }
    if k == 178 { return "定义在别的单元就把它拉进来：入口写 `addin chooseset`，那份 `chooseset.lomt` 里写 `set choose`。"; }
    if k == 179 { return "库里的 `choose` 搬到根单元去（库这一侧改成声明能力域）。"; }
    if k == 180 { return "声明别嵌在另一个开关体里 —— 预扫看不见它，那会让“开没开”变成鸡生蛋。"; }
    if k == 184 { return "换个写法绕开：用循环 + 数组代替还没支持的表达式，或用内建能做的那几种形态。"; }
    if k == 185 { return "查进度：`docs/145` 的里程碑表里看这一块排在哪一档。"; }
    if k == 186 { return "绕不开就报告：附上这条消息 + 最小可复现的那个文件（`loment ir` 的输出也有用）。"; }
    return "";
}

/// 这个码有几条修法（0 = 表里没有这个码）。
pub fn code_nfix(c: u32) -> u32 {
    if c == 1 { return 4; }
    if c == 2 { return 4; }
    if c == 3 { return 3; }
    if c == 4 { return 4; }
    if c == 5 { return 3; }
    if c == 6 { return 4; }
    if c == 7 { return 4; }
    if c == 8 { return 4; }
    if c == 9 { return 3; }
    if c == 10 { return 3; }
    if c == 11 { return 3; }
    if c == 12 { return 4; }
    if c == 13 { return 4; }
    if c == 14 { return 3; }
    if c == 15 { return 4; }
    if c == 16 { return 4; }
    if c == 17 { return 4; }
    if c == 18 { return 4; }
    if c == 19 { return 4; }
    if c == 20 { return 3; }
    if c == 21 { return 4; }
    if c == 22 { return 5; }
    if c == 23 { return 3; }
    return 0;
}

// ---------------------------------------------------------------- 语言卡
// **键集 == `potato_from.LANGS`**（判据钉着）：翻译线加一门语言而这里没跟上,
// 症状是"新语言的文件报错时只字不提怎么翻" —— 静默缺口。

pub fn lang_count() -> u32 { return 7; }

pub fn lang_key(i: u32) -> str {
    if i == 0 { return "cpp"; }
    if i == 1 { return "c"; }
    if i == 2 { return "csharp"; }
    if i == 3 { return "java"; }
    if i == 4 { return "go"; }
    if i == 5 { return "rust"; }
    if i == 6 { return "python"; }
    return "";
}

pub fn lang_name(i: u32) -> str {
    if i == 0 { return "C++"; }
    if i == 1 { return "C"; }
    if i == 2 { return "C#"; }
    if i == 3 { return "Java"; }
    if i == 4 { return "Go"; }
    if i == 5 { return "Rust"; }
    if i == 6 { return "Python"; }
    return "";
}

pub fn lang_exts(i: u32) -> str {
    if i == 0 { return ".cpp .cc .cxx .hpp"; }
    if i == 1 { return ".c .h"; }
    if i == 2 { return ".cs"; }
    if i == 3 { return ".java"; }
    if i == 4 { return ".go"; }
    if i == 5 { return ".rs"; }
    if i == 6 { return ".py"; }
    return "";
}

pub fn lang_tokens(i: u32) -> str {
    if i == 0 { return "std::|template<|using namespace|#include <vector>"; }
    if i == 1 { return "#include|int main(|printf("; }
    if i == 2 { return "using System|static void Main|string[] args"; }
    if i == 3 { return "public class|static void main|System.out"; }
    if i == 4 { return "func |package main|import ("; }
    if i == 5 { return "use std::|let mut |macro_rules!|#[derive"; }
    if i == 6 { return "def |__name__|self."; }
    return "";
}

pub fn lang_edge(i: u32) -> str {
    if i == 0 { return "类、模板、STL、异常、引用、指针、运算符重载都不翻；预处理指令（`#include` / `#define`）不收，所以语料不带 include；`std::cout` 那类成员访问也不收（`::` 连分词都过不去）。**它有真正的 `bool`**（不像 C 得靠 `<stdbool.h>`），而 `int x = (a < b);` 与 `if (x)`（x 是 int）**两边都合法** —— bool 与 int 双向隐式转换都留着，所以两个方向的强制转换**都要补**：结论与 C 一样、**理由完全不同**。`char` 的符号性由实现决定（x86-64 上 g++ 是 signed，ARM 上常常不是），映 `i8` / `u8` 都会在某台机器上悄悄算错，所以**拒**。"; }
    if i == 1 { return "指针算术、`union`、位域、宏、可变参数（`...`）、`goto` 进来的跳转都不翻；`int` 与条件混用（`if (x)`）、`&&` 出 int 要**补转换**（Loment 的条件只收 bool）。"; }
    if i == 2 { return "类继承、接口、泛型、LINQ、属性（`get; set;`）、事件、委托、异常都不翻；`using` / `namespace` / `class` 三层外壳会被抹掉（花括号形与文件级 `namespace X;` 都收）；`bool` 与 `int` 是分开的（`&&` 出 bool，**不用补转换**，这点与 C 相反）；`>>>` 是 C# 11 起的无符号右移。**`byte` 是 0..255 无符号的** —— 与 Java 的 `byte`（-128..127 有符号）**相反**。**不做整数宽度跟踪**：`int f(byte b) { return b; }` 那种混宽度的单元，翻出来的 Loment 会在检查时报「return 类型 u8，函数声明 i32」—— **响亮地失败，不是静默算错**（宽度跟踪是下一版的事）。"; }
    if i == 3 { return "类继承、接口、泛型擦除、异常、`String`、集合类都不翻；`boolean` 与 `int` 是分开的（`&&` 出 boolean，所以**不用补转换** —— 这点与 C 相反）；`>>>` 是无符号右移（Loment 的 `>>` 分有符号/无符号两种写法）。"; }
    if i == 4 { return "goroutine、channel、interface、`defer`、多返回值（Loment 只回一个值）、`string`、切片、`map`、指针都不翻；**类型写在名字后面**（`func f(a int) int`）、条件**不带括号**、**没有 `while`**（一个 `for` 管三种形状，含 `for { }` 死循环）。`int` 有平台宽度（x86-64 上是 64 位，所以映 `i64`）；`/` 与 `%` 向零截断（与 Loment 同）。**两处与别的门相反、而理由都在源语言那边**：① Go **没有隐式数值转换**，所以 `int(b)` 那种转换到处都在 —— 而它正好对上 Loment 的 `as`，源码里已经写好了、翻译器不用猜（C / C++ 要靠翻译器补，Java / C# 一个都不补）；② `i++` / `x += e` 在 Go 里是**语句、没有值**，所以照收（`i = i + 1`）——而 C / Java / C# 里它们是有值的表达式，那几门拒。"; }
    if i == 5 { return "trait 对象、闭包、宏（`macro_rules!`）、生命周期标注、`async` 都不翻；`&str` 与 `String` 都是“指针+长度”，翻过来是 `str`；借用检查那一套 Loment 同样管，所以这块一般能对上。"; }
    if i == 6 { return "动态类型、类继承、异常、生成器、装饰器、闭包捕获都不翻；`/` 是真除法（要整除得写 `//`，而 Loment 的 `/` 是整除）；`True`/`False` 是 int 的子类，**翻过来要补转换**。"; }
    return "";
}

pub fn lang_abi(i: u32) -> str {
    if i == 0 { return "能导 C ABI —— 要显式写 `extern \"C\"`（默认名字是 mangle 过的）。"; }
    if i == 1 { return "C ABI 是它默认的导出方式（`--link` 那份 `.o` 要自包含：不能有重定位、不能引用未定义的符号）。"; }
    if i == 2 { return "**.NET 默认不导出 C ABI**；要链接得上 NativeAOT 或 `[UnmanagedCallersOnly]`。"; }
    if i == 3 { return "**JVM 默认不导出 C ABI**；要链接得上 JNI 或 NativeAOT。"; }
    if i == 4 { return "默认**不**导 C ABI；要在源里显式写 `//export`。"; }
    if i == 5 { return "Rust 要导 C ABI 得在源里显式写 `extern \"C\"` + `#[no_mangle]`。"; }
    if i == 6 { return "**CPython 不导出 C ABI** —— 只出接口单元会得到一个**空 module**（stderr 上有 `[skip] f: 调用约定不是 C ABI`）。要真链接得走 C 扩展那条路。"; }
    return "";
}
