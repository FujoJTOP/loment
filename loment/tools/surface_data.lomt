}

pub fn lang_name(i: u32) -> str {
    if i == 0 { return "C++"; }
    if i == 1 { return "C"; }
    if i == 2 { return "C#"; }
    if i == 3 { return "Java"; }
    if i == 4 { return "Go"; }
    if i == 5 { return "Rust"; }
