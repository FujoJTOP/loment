// surface_data.lomt — 由 `tools/loment_diag.py --dump-surface` 生成，别手改。
//
// 码 -> 文字 + 语言卡。**唯一真源是 `tools/loment_diag.py`**（RULES / TITLE_EN /
// CARDS / CARDS_EN / ASCII_ONE_LINER / LANG_CARDS / LANG_EDGE_EN / LANG_ABI_EN），
// 这里只是它的可读副本（`docs/176` B 那条管线：数据从逻辑里拆出来，自举侧 `use` 它）。
//
// 为什么要生成而不是手抄第二份：`loment/tools/lomcli.lomt` 原先手抄了 24 条 `codrow`，
// 与 `loment_diag.RULES` 是同一件事的两份 —— 而本仓那四个静默 bug（docs/179 7.3）
// 全出自"同一份清单抄第二遍"。
//
// **语言槽 `lang`：0 = 英文（默认），1 = 中文**。默认是英文，理由在 `docs/169` §3a：
// Windows 控制台按 936 代码页解 UTF-8，中文是乱码，而 PE 垫片没有 WriteConsoleW。
// 英文那份**全 ASCII**（由生成器硬失败 + `loment_tools_test` 两处钉着），于是
// **报错器自己那部分**在任何代码页下都解码一致。**说清楚它没修到哪一步**：编译器给的
// 消息原文仍是它自己的语言（现在是中文）—— 那是 `docs/182` §5.3 那条分工，不在这一层。
// 想读中文就写 `errconfig`（`docs/182` §14）。
//
// `code_ascii` 是**第三个受众**，没有语言槽：它是给 CLI 看的一行 ASCII（`loment codes`／
// `explain`），本来就只能是 ASCII，与上面两个槽不是一回事。
//
// 平键：`code_*` 是 `c * 2 + lang`，`code_fix` 是 `(c * stride + i) * 2 + lang`
// （一条码最多 8 条修法）。按码嵌 `if` 要嵌两层，平键一层就够，而且生成器这边一眼
// 看得出哪条码少了哪一档。
// **码从 1 起连续编号**, 所以 `n_codes()` 也就是最后那个码 —— 两个消费者（`lomcli`
// 的 codes/explain、报错器）都拿它当上界用, 那条不变式有判据钉着。

module surface_data

pub fn n_codes() -> u32 { return 23; }

pub fn code_title(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "type mismatch"; }
    if k == 3 { return "类型不匹配"; }
    if k == 4 { return "undeclared name"; }
    if k == 5 { return "符号未声明"; }
    if k == 6 { return "wrong number of arguments"; }
    if k == 7 { return "实参数量不符"; }
    if k == 8 { return "illegal capability domain"; }
    if k == 9 { return "能力域非法"; }
    if k == 10 { return "conflicts with an out-of-bounds declaration"; }
    if k == 11 { return "与出界声明冲突"; }
    if k == 12 { return "use after move"; }
    if k == 13 { return "移动后使用"; }
    if k == 14 { return "borrow conflict"; }
    if k == 15 { return "借用冲突"; }
    if k == 16 { return "illegal `match` / variant use"; }
    if k == 17 { return "match/变体用法非法"; }
    if k == 18 { return "illegal type name"; }
    if k == 19 { return "类型名非法"; }
    if k == 20 { return "misused `?`"; }
    if k == 21 { return "`?` 误用"; }
    if k == 22 { return "write into a read-only slice"; }
    if k == 23 { return "只读切片写入"; }
    if k == 24 { return "dangling borrow"; }
    if k == 25 { return "悬垂借用"; }
    if k == 26 { return "duplicate name"; }
    if k == 27 { return "重名"; }
    if k == 28 { return "illegal assignment target"; }
    if k == 29 { return "赋值目标非法"; }
    if k == 30 { return "illegal field / index / address-of"; }
    if k == 31 { return "字段/下标/取址非法"; }
    if k == 32 { return "illegal array literal"; }
    if k == 33 { return "数组字面量非法"; }
    if k == 34 { return "illegal `as` cast"; }
    if k == 35 { return "`as` 转换非法"; }
    if k == 36 { return "`use <name>` does not resolve uniquely"; }
    if k == 37 { return "名字导入无法唯一解析"; }
    if k == 38 { return "syntax error (lexer / parser)"; }
    if k == 39 { return "语法错误（词法/解析期）"; }
    if k == 40 { return "too many `use` in one file"; }
    if k == 41 { return "单个文件的 use 太多"; }
    if k == 42 { return "unsupported `extern fn` signature"; }
    if k == 43 { return "外部函数的签名不支持"; }
    if k == 44 { return "bad `choose` / `addin`"; }
    if k == 45 { return "`choose` / `addin` 用法不对"; }
    if k == 46 { return "not implemented in this version (compiler limit)"; }
    if k == 47 { return "这一版还没实现（编译器限制）"; }
    return "";
}

pub fn code_what(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "Two types do not line up - the return value against the declaration, an argument against a parameter, a payload against its variant, a builtin argument, or the two sides of an assignment."; }
    if k == 3 { return "两处类型对不上 —— 返回值与声明、实参与形参、载荷与变体、内建实参、赋值两侧。"; }
    if k == 4 { return "A name was used without being declared - a variable, a function, a type or a constant."; }
    if k == 5 { return "用了一个没有声明的名字 —— 变量、函数、类型、常量都算。"; }
    if k == 6 { return "The number of arguments at the call site does not match the function signature."; }
    if k == 7 { return "调用时给的实参个数与函数签名对不上。"; }
    if k == 8 { return "The capability domain itself is wrong - `guard` on something undeclared, a bad `[lo..hi]` range, or one name declared twice."; }
    if k == 9 { return "能力域本身有问题 —— 没声明就 `guard`、`[lo..hi]` 的边界不对、同名重复声明。"; }
    if k == 10 { return "A space that an `excluded` declaration **put out of bounds** was used."; }
    if k == 11 { return "用了一个被 `excluded` 声明**排除在外**的空间。"; }
    if k == 12 { return "A value was **moved** to someone else and then used again."; }
    if k == 13 { return "一个值被**移动**给别人之后，又用它了。"; }
    if k == 14 { return "In one call, the same variable is borrowed mutably and also borrowed, or borrowed mutably twice."; }
    if k == 15 { return "同一个变量在同一次调用里，既被可变借用又被借用，或者被可变借用两次。"; }
    if k == 16 { return "A `match` or an enum is used wrongly: not exhaustive, a duplicate pattern, a bad payload binding, a subject that is not an enum, or an arm written as an expression."; }
    if k == 17 { return "`match` 或枚举的用法有问题：不穷尽、模式重复、载荷绑定不对、主体不是枚举、臂体写成了表达式。"; }
    if k == 18 { return "A type name collides with a base type, or an **empty** `struct`/`enum` was declared."; }
    if k == 19 { return "类型名与基类型重名，或者声明了一个**空**的 `struct`/`enum`。"; }
    if k == 20 { return "`?` was used where the function does not return `Result`/`Option`, or somewhere other than the binding position of a `let`."; }
    if k == 21 { return "`?` 用在了不返回 `Result`/`Option` 的地方，或者不在 `let` 的绑定位置。"; }
    if k == 22 { return "Writing into a **read-only** slice, or a parameter that was not declared `mut`."; }
    if k == 23 { return "往一个**只读**切片里写，或者形参没声明 `mut`。"; }
    if k == 24 { return "A reference to a **local variable** was returned."; }
    if k == 25 { return "返回了一个指向**局部变量**的引用。"; }
    if k == 26 { return "The same name appears twice in one scope - a function, a type, a constant, a field, a variant or a parameter."; }
    if k == 27 { return "同一作用域里同一个名字出现了两次 —— 函数、类型、常量、字段、变体、参数都算。"; }
    if k == 28 { return "The left-hand side of an assignment is not a place that can hold something (it is not an lvalue)."; }
    if k == 29 { return "赋值左边不是一个能放东西的位置（不是左值）。"; }
    if k == 30 { return "A field or an index is used wrongly - no such field, a missing field, a duplicate initializer, a field taken off a non-struct, an index applied to a non-array."; }
    if k == 31 { return "字段或下标用错了 —— 没有这个字段、缺字段、重复初始化、对非结构体取字段、对非数组取下标。"; }
    if k == 32 { return "An array literal is wrong - it is empty, its element types differ, or its count does not match the declared length."; }
    if k == 33 { return "数组字面量有问题 —— 是空的、元素类型不一致、或者个数与声明长度不符。"; }
    if k == 34 { return "The target type of `as` is wrong, or this direction cannot be converted at all."; }
    if k == 35 { return "`as` 的目标类型不对，或者这个方向转不过去。"; }
    if k == 36 { return "`use <name>` does not resolve - either nothing was found, or more than one thing matched and there is no way to tell which was meant."; }
    if k == 37 { return "`use <名字>` 解析不出来 —— 要么找不到，要么命中多处不知道用哪个。"; }
    if k == 38 { return "This line does not read as Loment syntax - the lexer or the parser stopped here."; }
    if k == 39 { return "这一行按 Loment 的语法读不通 —— 词法期或解析期就停了。"; }
    if k == 40 { return "One file has more than **300** `use` statements."; }
    if k == 41 { return "一个文件里的 `use` 超过了 **300 条**。"; }
    if k == 42 { return "An `extern fn` signature goes beyond what FFI stage 1 accepts."; }
    if k == 43 { return "`extern fn` 的签名超出了 FFI 第 1 阶段收的那几种。"; }
    if k == 44 { return "A switch (`choose`) or the core mode (`std`/`no_std`) is written wrongly."; }
    if k == 45 { return "开关（`choose`）或核心模式（`std`/`no_std`）的写法不对。"; }
    if k == 46 { return "What you wrote is syntactically and semantically right - **this version of the compiler backend just does not do that yet**."; }
    if k == 47 { return "你写的东西语法和语义都对 —— 是**这一版的编译器后端还没做这块**。"; }
    return "";
}

pub fn code_why(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "Loment has **no implicit numeric conversion** and no type inference: every position must match explicitly. A `u32` value never becomes an `i64` on its own, and the integer `1` is not the `bool` `true`."; }
    if k == 3 { return "Loment **没有隐式数值转换**，也没有类型推断：每个位置上的类型必须显式对得上。所以 `u32` 的值不会自动变成 `i64`，整数 `1` 也不是 `bool` 的 `true`。"; }
    if k == 4 { return "This is the one beginners hit most, and in Loment it is almost always the same thing: **there is no type inference** - `let x = 1;` is a syntax error and you must write `let x: u32 = 1;`. Next comes defining after use inside one module, and then a cross-module name that needs `pub` on the declaration and `use` at the call site."; }
    if k == 5 { return "这是**新手撞得最多**的一条，而它在 Loment 里几乎总是同一件事：**没有类型推断** —— `let x = 1;` 是语法错，必须 `let x: u32 = 1;`。其次是**先定义后使用**（同一模块内），以及跨模块要 `pub` 导出 + `use` 导入。"; }
    if k == 6 { return "A function takes at most **10** parameters. A method's `self` does **not** count as an argument. Loment has no default arguments, no variadics and no overloading - a different name is a different function."; }
    if k == 7 { return "形参最多 **10 个**；方法调用的 `self` **不计入**实参；Loment 没有默认参数、没有可变参数、也没有重载 —— 名字不同就是不同函数。"; }
    if k == 8 { return "A capability domain is the one thing Loment adds: `capability c : space[lo..hi]` declares an **index domain** and `guard c(i);` checks that `i` falls inside it (a literal out of range is a **compile-time** error, anything else is a run-time trap). So the domain has to be declared first, `lo <= hi` has to hold, and one name may be declared only once per space."; }
    if k == 9 { return "能力域是 Loment 唯一“新加的东西”：`capability c : space[lo..hi]` 声明一个**索引域**，`guard c(i);` 检查 `i` 落在域内（字面量越界是**编译期错**，其余是运行期 trap）。所以域必须**先声明**、`lo <= hi`、同一空间同一个名字只声明一次。"; }
    if k == 10 { return "`excluded \"space: ...\"` is an **out-of-bounds declaration**: it removes a space from what this program may touch, and it is a promise written for a security audit. Using that space again therefore contradicts your own promise - and that is **deliberate**, not the compiler being fussy."; }
    if k == 11 { return "`excluded “space: ...”` 是**出界声明**：它把一个空间从“本程序可以碰的”里拿掉，是给安全审计看的一份承诺。于是再用那个空间就与自己的承诺冲突 —— 这是**故意的**，不是编译器挑剔。"; }
    if k == 12 { return "Loment's aggregate types (`struct` / `enum`) are **move** by default: passing one by value to a function, or assigning one to another variable, hands over ownership. Types whose fields are **all integers** are `Copy` automatically and never report this."; }
    if k == 13 { return "Loment 的聚合类型（`struct` / `enum`）默认是**移动**语义：按值传进函数、按值赋给另一个变量，都相当于把所有权交出去。**全字段是整型**的类型自动按 `Copy` 处理，不会报这条。"; }
    if k == 14 { return "`&mut` is an **exclusive** borrow (the same rule as Rust): while a mutable borrow is alive, no other borrow - not even a read-only one - may exist alongside it. This is not about performance; the answer to \"who may change it\" has to be unique."; }
    if k == 15 { return "`&mut` 是**独占**借用（与 Rust 同一套规则）：可变借用存在期间，别的借用（包括只读的）都不能同时存在。这不是性能问题，是“谁能改它”的答案必须唯一。"; }
    if k == 16 { return "`match` must be **exhaustive** (or carry a `_` arm); **an arm body is a block**, not an expression; a variant with a payload binds a variable and one without a payload takes no parentheses; and a **generic enum** pattern must use the **monomorphized** name (`Result_i64_u32::Ok(v)`), not `Result::Ok(v)`."; }
    if k == 17 { return "`match` 必须**穷尽**（或者有 `_` 兜底）；**臂体是块**、不是表达式；带载荷的变体模式要绑变量、无载荷的不能带括号；**泛型枚举**的模式要用**单态化之后**的名字（`Result_i64_u32::Ok(v)`），不是 `Result::Ok(v)`。"; }
    if k == 18 { return "`u8 u16 u32 u64 i8 i16 i32 i64 bool ptr str` are **base type names**; a user type taking one of them leaves no way to tell the two apart later. Empty aggregates for the same reason: a type with no field and no variant expresses nothing, and **rejecting it loudly beats letting it exist quietly** - it is almost always half-written."; }
    if k == 19 { return "`u8 u16 u32 u64 i8 i16 i32 i64 bool ptr str` 是**基类型名**，用户类型再叫这些名字，后面就没法区分了。空聚合同理：一个字段/变体都没有的类型表达不了任何东西，**当错误拒掉比让它悄悄存在好** —— 它多半是写了一半。"; }
    if k == 20 { return "`?` means **return now if it failed, unwrap the payload if it worked**, so it asks two things: the enclosing function returns `Result` (or `Option`), and `?` sits in the binding position `let x: T = expr?;`. It is not an \"ignore the error\" marker."; }
    if k == 21 { return "`?` 的语义是“**错了就直接返回，对了就取出载荷**” —— 所以它要求两件事：当前函数返回 `Result`（或 `Option`），而且 `?` 只能出现在 `let x: T = expr?;` 的绑定位置。它不是一个“忽略错误”的记号。"; }
    if k == 22 { return "`fn f(xs: [u32])` receives a **read-only** slice. A slice is a borrowed view, and whether you may write through it is decided by the parameter type: to write, the parameter must be `mut [u32]`, and the call site must pass `&mut arr` (nobody can borrow a read-only slice as writable)."; }
    if k == 23 { return "`fn f(xs: [u32])` 拿到的是**只读**切片 —— 切片是“借来的视野”，能不能写由形参类型决定。要写就得 `mut [u32]`，而调用处必须传 `&mut arr`（只读切片没人能借成可写的）。"; }
    if k == 24 { return "A local variable stops existing when the function returns, so a reference to it is necessarily dangling. A reference that can be returned safely can only come from a **parameter** (or from memory the caller handed in) - this is where the lifetime rules land in Loment."; }
    if k == 25 { return "局部变量在函数返回时就不存在了，返回给它的引用必然悬垂。所以能安全返回的引用，只能来自**形参**（或来自调用方传进来的内存）—— 这是生命周期规则在 Loment 里的落点。"; }
    if k == 26 { return "`use` is a **flat namespace**: the top-level names in one unit must be unique, so **two libraries may not both have a top-level item of the same name**. That is also why the public names in std carry a prefix (`json_parse` / `sha256_hex`) - the ones that do not will collide sooner or later."; }
    if k == 27 { return "`use` 是**平名字空间**：一个单元里的顶层名字必须唯一，所以**两个库也不能有同名顶层项**。这也是为什么 std 里的公开名字都带前缀（`json_parse` / `sha256_hex`）——不带的迟早会撞。"; }
    if k == 28 { return "Only a **variable, a field or an index** can be assigned to - they name a definite piece of memory. The result of an expression (`a + b`, a function's return value) has no address, so nothing can be stored in it."; }
    if k == 29 { return "只有**变量、字段、下标**可以被赋值 —— 它们指向一块确定的内存。表达式的结果（`a + b`、函数返回值）没有地址，所以放不了东西。"; }
    if k == 30 { return "A struct literal must list its fields **completely and without repeats** (there are no defaults); `.` only applies to structs, `[]` only to arrays and slices, and `&`/`&mut` only to arrays and slices. Two more shape rules: **a struct literal cannot be passed as an argument directly**, and **a struct literal cannot be written directly in a condition**."; }
    if k == 31 { return "结构体字面量的字段要**齐全且不重复**（没有默认值这回事）；`.` 只能用在结构体上，`[]` 只能用在数组/切片上，`&`/`&mut` 只能作用于数组或切片。另外两条形状上的规矩：**结构体字面量不能直接当实参**，**条件位置不能直接写结构体字面量**。"; }
    if k == 32 { return "`let xs: [u32; 3] = [1, 2, 3];` - **the length is part of the type**, so the count must be written out and match. There is no \"infer the length from the literal\", because that would need type inference and Loment has none."; }
    if k == 33 { return "`let xs: [u32; 3] = [1, 2, 3];` —— **长度是类型的一部分**，所以个数必须写死对得上，没有“按字面量长度自动推断”这回事（那需要类型推断，而 Loment 没有）。"; }
    if k == 34 { return "`as` performs a **bit-level** conversion only: integer<->integer, integer<->bool, pointer<->integer. Anything else (a string to a number, a struct to a struct) is not a conversion but a parse or a construction, and the steps have to be written out."; }
    if k == 35 { return "`as` 只做**位级**的转换：整数⇄整数、整数⇄布尔、指针⇄整数。别的（字符串→数字、结构体→结构体）不是“转换”而是“解析/构造”，必须写出过程来。"; }
    if k == 36 { return "The name form searches **layer by layer**: (1) the project's `deps/<name>/<name>.lomt`, (2) the toolchain's own store, (3) the four built-in roots (`loment/lib` -> `examples` -> `selfhost` -> `tools`). **The first two layers take the first hit**, and uniqueness is only enforced in layer 3. So a collision usually shows up as \"I thought that was the other one\"."; }
    if k == 37 { return "名字形式按**层**搜：① 项目本地 `deps/<名字>/<名字>.lomt` → ② 工具链自带 store → ③ 内置四根（`loment/lib` → `examples` → `selfhost` → `tools`）。**前两层先命中先用**，唯一性只管第 ③ 层。所以撞名的症状通常是“我以为是另一个”。"; }
    if k == 38 { return "Loment's **own syntax is close to Rust but drops** a few things: single-quoted character literals, value-less `return;`, expression-style `match` arms, and `mut` as a binding modifier. Writing from Rust habits lands on these easily - they are not \"not supported yet\", the language simply does not have them. (That is the native syntax only: the same logic can also be written the C / C++ / Java / C# / Go / Python way, which is a different layer - see `docs/188`.)"; }
    if k == 39 { return "Loment 的**原生语法与 Rust 很接近，但去掉了**几样东西：单引号字符字面量、无值 `return;`、表达式式的 `match` 臂、`mut` 作为绑定修饰词。照 Rust 的习惯写很容易踩到这几处 —— 它们不是“暂时不支持”，是这门语言没有。（说的只是**原生语法**：同一段逻辑也能用 C / C++ / Java / C# / Go / Python 的写法写，那是另一层，见 `docs/188`。）"; }
    if k == 40 { return "This is a **never-silently-drop** gate: the scratch area in the self-hosted mirror was only that big, and anything past it was dropped without a word - so the same source produced **different units** under the reference implementation and under the self-hosted one. Both are 300 now and going over is an error: better an error than \"a piece is missing but it looked like it compiled\"."; }
    if k == 41 { return "这是一道**防静默丢**的闸门：自举镜像里那个暂存区原来就那么大，超出的会被悄悄丢掉，于是同一份源码在参考实现与自举镜下**给出不同的单元**。现在两边都是 300，超限报错 ——宁可报错也不要“少了一块但看起来编过了”。"; }
    if k == 42 { return "Stage 1 takes only **scalars** (`i8..i64` / `u8..u64` / `bool`) and `ptr`. In Loment `str` is **a pointer plus a length**, **not** a C string, and the two are not interchangeable; passing structs or enums by value needs a different register classification. Both of those **change the shape of the code at the call site**, so this errors out rather than compiling something quietly wrong."; }
    if k == 43 { return "第 1 阶段只收**标量**（`i8..i64` / `u8..u64` / `bool`）与 `ptr`。`str` 在 Loment 里是“**指针 + 长度**”，**不是** C 字符串，两者不通用；结构体/枚举按值传要另一套寄存器分类规则 —— 都会**改变调用点的代码形状**，所以一律报错退出而不是静默错编。"; }
    if k == 44 { return "Two different things are managed here: (1) **the core mode** is a property of **the whole program** - it may appear once and only in the root unit (nothing outside `loment.conf` can change it); (2) **a switch** is \"code that is compiled in only when it is on\". There can be many switches, but **one name may be written once**, and a value may only be set after `set choose` declared it. A library may not `choose`: to express a need, a library declares a **capability requirement** and the project decides."; }
    if k == 45 { return "这是**两个不同的东西**被放在一起管：① **核心模式**是**整个程序**的属性 —— 只能出现一次、只能写在根单元（`loment.conf` 之外没有第二个地方能改它）；② **开关**是“打开才编进去的代码”，可以有很多条，但**同名只许写一次**、**取值前必须先 `set choose` 定义**。库不许 `choose` —— 库要表达需要就声明**能力需求**，由项目决定开不开。"; }
    if k == 46 { return "The reference implementation has two backends: the Rust transpile path goes further, and the native IR path (from M0 on) is filled in **block by block**. This message comes from the latter, so it is **not your mistake** - read it as \"the design has not arrived here yet\". That is also why it has a code of its own: what the user can do here (write it another way) is completely different from \"fix that line as suggested\"."; }
    if k == 47 { return "参考实现有两条后端：一条 Rust 转译路径走得远，原生 IR 路径（M0 起）是**逐块补**出来的。这条消息来自后者 —— 所以它**不是你的错**，把它当成“设计上还没到这里”看。这也是它单独一个码的理由：用户能做的事（换个写法绕开）与“照建议改那一行”完全不同。"; }
    return "";
}

pub fn code_yes(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "explicit `as` (integer<->integer, integer<->bool, pointer<->integer); scalar / string / slice / array / struct / enum as types"; }
    if k == 3 { return "显式 `as`（整数⇄整数、整数⇄布尔、指针⇄整数）；标量/字符串/切片/数组/结构体/枚举作为类型"; }
    if k == 4 { return "generics (when the call site determines T) / static trait dispatch / `pub` across modules / both `use` forms"; }
    if k == 5 { return "泛型（调用点能定出 T 时）／trait 静态派发／`pub` 跨模块／两种 `use`"; }
    if k == 6 { return "up to 10 parameters; `self` on a method call is supplied by the compiler"; }
    if k == 7 { return "最多 10 个形参；方法调用的 `self` 由编译器补"; }
    if k == 8 { return "`capability` + `guard`; the `revocable` flag; compile-time checking of literal out-of-range indexes"; }
    if k == 9 { return "`capability` + `guard`；`revocable` 标；字面量越界的编译期检查"; }
    if k == 10 { return "`excluded \"<space>: ...\"` out-of-bounds declarations; several capability domains, each in its own space"; }
    if k == 11 { return "`excluded “<space>: ...”` 出界声明；多个能力域各占各的空间"; }
    if k == 12 { return "explicit `&` / `&mut`; an aggregate whose fields are all integers is `Copy` automatically"; }
    if k == 13 { return "显式 `&` / `&mut`；全字段整型的聚合自动 `Copy`"; }
    if k == 14 { return "several **read-only** borrows in one scope; one mutable borrow"; }
    if k == 15 { return "同一作用域里多个**只读**借用；一次可变借用"; }
    if k == 16 { return "`match` / `if let` / single-payload variants / `_` catch-all / generic enums (via the monomorphized name)"; }
    if k == 17 { return "`match` / `if let` / 单载荷变体 / `_` 兜底 / 泛型枚举（用单态化名）"; }
    if k == 18 { return "a `struct` with any number of fields; an `enum` with any number of variants (single payload included)"; }
    if k == 19 { return "任意多字段的 `struct`；任意多变体的 `enum`（含单载荷）"; }
    if k == 20 { return "`Result` / `Option` / `?` in a binding position / explicit `match`"; }
    if k == 21 { return "`Result` / `Option` / 绑定位置的 `?` / `match` 显式处理"; }
    if k == 22 { return "both slice forms, `[T]` (read-only) and `mut [T]` (writable); both ways to pass, `&arr` and `&mut arr`"; }
    if k == 23 { return "`[T]`（只读）与 `mut [T]`（可写）两种切片；`&arr` / `&mut arr` 两种传法"; }
    if k == 24 { return "returning a reference or slice that comes from a parameter; returning by value"; }
    if k == 25 { return "返回来自形参的引用/切片；按值返回"; }
    if k == 26 { return "any number of modules / functions / types in one unit, as long as no name repeats"; }
    if k == 27 { return "一个单元里任意多模块/函数/类型，只要名字不撞"; }
    if k == 28 { return "assignment to a variable, a struct field, an array or slice index"; }
    if k == 29 { return "变量、结构体字段、数组/切片下标赋值"; }
    if k == 30 { return "reading and writing fields; reading and writing indexes; `&arr` for a slice; struct literals (bound to a variable first)"; }
    if k == 31 { return "字段读写、下标读写、`&arr` 取切片、结构体字面量（先绑变量）"; }
    if k == 32 { return "fixed-size arrays `[T; N]`; literals `[1, 2, 3]`; reading and writing indexes"; }
    if k == 33 { return "定长数组 `[T; N]`；字面量 `[1, 2, 3]`；下标读写"; }
    if k == 34 { return "`as` between integers, between an integer and a bool, between a pointer and an integer"; }
    if k == 35 { return "整数⇄整数、整数⇄布尔、指针⇄整数的 `as`"; }
    if k == 36 { return "both `use` forms (name / path); at most 300 per file; layered search where an earlier layer wins"; }
    if k == 37 { return "两种 `use`（名字 / 路径）；单文件最多 300 条；按层搜索 + 前缀优先"; }
    if k == 38 { return "the Rust-subset syntax; `//` and `/* */` comments; `let x: T = e;`"; }
    if k == 39 { return "Rust 风味那套语法；`//` `/* */` 注释；`let x: T = e;`"; }
    if k == 40 { return "at most 300 `use` per file (the path form and the name form counted together)"; }
    if k == 41 { return "单文件最多 300 条 `use`（路径形式 + 名字形式合起来算）"; }
    if k == 42 { return "scalar and `ptr` parameters / returns; several `--link`; the call site uses the platform C ABI (on Linux the first six integer arguments go in rdi/rsi/rdx/rcx/r8/r9, on Windows in rcx/rdx/r8/r9)"; }
    if k == 43 { return "标量与 `ptr` 的形参/返回；多个 `--link`；调用点走平台 C ABI（Linux 前六个整数实参进 rdi/rsi/rdx/rcx/r8/r9；Windows 进 rcx/rdx/r8/r9）"; }
    if k == 44 { return "up to 500 switches per file; `addin` to carry switch settings across files (root unit only); empty switch bodies (purely to drive compiler behaviour); capability domains declared by a library"; }
    if k == 45 { return "单文件最多 500 条开关；`addin` 跨文件带开关设定（只有根单元能写）；空体开关（只驱动编译器行为）；库声明能力域"; }
    if k == 46 { return "scalar arithmetic, control flow, strings, arrays, slices, structs, enums (`match`) - passing aggregates by value depends on the backend"; }
    if k == 47 { return "标量运算、控制流、字符串、数组、切片、结构体、枚举（`match`）—— 按值传聚合看目标后端"; }
    return "";
}

pub fn code_no(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "implicit promotion and implicit conversion (`u32` -> `i64` also needs `as`); using an integer where a bool is expected"; }
    if k == 3 { return "隐式提升与隐式转换（`u32` → `i64` 也必须写 `as`）；整数与布尔互用"; }
    if k == 4 { return "type inference / implicit globals / forward references inside one module / implicit numeric conversion"; }
    if k == 5 { return "类型推断／隐式全局／同一模块内的前向引用／隐式数值转换"; }
    if k == 6 { return "default arguments / variadic arguments / function overloading"; }
    if k == 7 { return "默认参数／可变参数／函数重载"; }
    if k == 8 { return "**authorization** - `guard` only constrains the index to the domain, it does not check whether the current subject holds this capability (that binding lives in the kernel)"; }
    if k == 9 { return "**授权** —— `guard` 只约束索引落在域内，不检查“当前主体有没有这个能力”（主体-能力的绑定在内核侧）"; }
    if k == 10 { return "local exemptions (there is no \"allow it just here\"); both excluding a space and using it"; }
    if k == 11 { return "局部豁免（“只在这一处放行”做不到）；对同一个空间既排除又使用"; }
    if k == 12 { return "implicitly copying aggregates; using a value after it has been moved"; }
    if k == 13 { return "隐式复制聚合；移动后再使用同一个值"; }
    if k == 14 { return "a mutable borrow alive next to any other borrow; two mutable borrows of the same variable"; }
    if k == 15 { return "可变借用与任何其它借用并存；同一变量的两次可变借用"; }
    if k == 16 { return "expression arm bodies; multi-payload variants; non-exhaustive without `_`; comparing enums with `==` (the checker allows it but the native backend rejects it)"; }
    if k == 17 { return "臂体是表达式；多载荷变体；非穷尽且没有 `_`；`==` 直接比较枚举（checker 放行但原生后端会拒）"; }
    if k == 18 { return "a name that collides with a base type; an empty `struct`; an empty `enum`"; }
    if k == 19 { return "与基类型重名；空 `struct`；空 `enum`"; }
    if k == 20 { return "`?` outside a `let` binding; `?` inside a function that does not return `Result`/`Option`"; }
    if k == 21 { return "在非 `let` 位置用 `?`；在返回非 `Result`/`Option` 的函数里用 `?`"; }
    if k == 22 { return "writing through a read-only slice; borrowing `&arr` as writable"; }
    if k == 23 { return "在只读切片上写；把 `&arr` 借成可写的"; }
    if k == 24 { return "returning a reference or slice that points at a local variable"; }
    if k == 25 { return "返回指向局部变量的引用或切片"; }
    if k == 26 { return "two top-level items sharing a name; two libraries exporting the same name"; }
    if k == 27 { return "同名顶层项共存；两个库同时导出同一个名字"; }
    if k == 28 { return "assignment to an expression or a literal (`1 = x`, `f() = x`)"; }
    if k == 29 { return "给表达式或字面量赋值（`1 = x`、`f() = x`）"; }
    if k == 30 { return "a struct literal passed straight as an argument; a struct literal written in a condition; literals with missing or extra fields"; }
    if k == 31 { return "结构体字面量直接当实参；条件位置直接写结构体字面量；缺字段/多字段字面量"; }
    if k == 32 { return "an empty literal; inferring the length from the literal; an array with mismatched element types"; }
    if k == 33 { return "空字面量；按字面量推断长度；元素类型不一致的数组"; }
    if k == 34 { return "`as` between aggregates; `as` between a string and a number (write the parse yourself)"; }
    if k == 35 { return "聚合之间的 `as`；字符串与数字之间的 `as`（要自己写解析）"; }
    if k == 36 { return "ambiguity in layer 3; circular imports; more than 300 uses (that is E020)"; }
    if k == 37 { return "第 ③ 层的歧义；循环导入；超过 300 条（那是 E020）"; }
    if k == 38 { return "single-quoted character literals; value-less `return;`; expression-style match arms; `let mut x: T` (`mut` is not a keyword)"; }
    if k == 39 { return "单引号字符字面量；无值 `return;`；表达式式 match 臂；`let mut x: T`（`mut` 不是关键字）"; }
    if k == 40 { return "more than 300 (going over is an **error**, not a truncation)"; }
    if k == 41 { return "超过 300 条（超限是**报错**，不是截断）"; }
    if k == 42 { return "`str` parameters / returns (that is a pointer plus a length, not a C string); structs / enums / arrays **by value**; an `extern fn` with type parameters; FFI on the PE target; `.a` archives and `.so` / `.dll` dynamic libraries"; }
    if k == 43 { return "`str` 形参/返回（那是“指针+长度”，不是 C 字符串）；结构体/枚举/数组**按值**；`extern fn` 带类型参数；PE 目标的 FFI；`.a` 归档与 `.so`/`.dll` 动态库"; }
    if k == 44 { return "the core mode written twice or written in a library; setting a value before declaring it; two settings for one name; nested declarations; a library writing `choose` or `addin`"; }
    if k == 45 { return "核心模式写两次或写在库里；取值前没定义；同名两个取值；嵌套声明；库写 `choose` 或 `addin`"; }
    if k == 46 { return "**this message itself is the \"not supported\"** - the exact scope is the milestone table in `docs/145`, not anything on your side of the source"; }
    if k == 47 { return "**这条消息本身就是“不支持”** —— 具体范围以 `docs/145` 的里程碑表为准，不在源码那一侧"; }
    return "";
}

pub fn code_ascii(c: u32) -> str {
    if c == 1 { return "type mismatch (return / payload / builtin argument)"; }
    if c == 2 { return "something is not declared - usually a missing type annotation or a misspelt name"; }
    if c == 3 { return "wrong number of arguments"; }
    if c == 4 { return "capability domain problem (undeclared / out of range / duplicate)"; }
    if c == 5 { return "used space that an `excluded` declaration put out of bounds"; }
    if c == 6 { return "value has been moved"; }
    if c == 7 { return "borrow conflict (mutable borrow next to a borrow / two mutable borrows)"; }
    if c == 8 { return "match / enum (not exhaustive, duplicate pattern, bad payload binding)"; }
    if c == 9 { return "name clashes with a base type / empty struct / empty enum"; }
    if c == 10 { return "`?` used where there is no Result or Option"; }
    if c == 11 { return "slice mutability (cannot write a read-only slice; the parameter needs `mut`)"; }
    if c == 12 { return "dangling reference"; }
    if c == 13 { return "duplicate definition / duplicate name"; }
    if c == 14 { return "assignment target is not an lvalue"; }
    if c == 15 { return "field or index (no such field, missing field, duplicate init, field on a non-struct)"; }
    if c == 16 { return "array literal / length does not match the declaration"; }
    if c == 17 { return "illegal `as` cast"; }
    if c == 18 { return "`use <name>` does not resolve - rename it, add the file, or use the path form"; }
    if c == 19 { return "parse error - fix that line as the `line:col` in the message says"; }
    if c == 20 { return "more than 300 `use` in one file - split the facade"; }
    if c == 21 { return "`extern fn` signature outside FFI stage 1 - scalars and `ptr` only"; }
    if c == 22 { return "bad `choose`: written twice, bad mode name, or written in a library"; }
    if c == 23 { return "not implemented in this version - a compiler limit, not your code"; }
    return "";
}

const FIX_STRIDE: u32 = 8;

/// 第 `i` 条修法（`i` 从 0 起）。`i` 超出该码的条数就是空串。
pub fn code_fix(c: u32, i: u32, lang: u32) -> str {
    let k: u32 = (c * FIX_STRIDE + i) * 2 + lang;
    if k == 16 { return "Change one side to match the signature: read the declared return type / parameter type and make the expression be that."; }
    if k == 18 { return "Different integer widths: write the cast out - `x as u64`, `n as i32` (integer<->integer, integer<->bool and pointer<->integer are all allowed)."; }
    if k == 20 { return "Booleans and integers are separate: write `x != 0` or `true` in a condition; do not expect `1` to work as `true`."; }
    if k == 22 { return "Array / struct elements must all be one type: cast each element with `as`, or add a conversion function."; }
    if k == 17 { return "照签名改一侧：看函数声明的返回类型/形参类型，把表达式改成那一侧。"; }
    if k == 19 { return "整型宽度不同就显式写 `as`：`x as u64`、`n as i32`（整数⇄整数、整数⇄布尔、指针⇄整数都可以）。"; }
    if k == 21 { return "布尔与整数分开：条件位置写 `x != 0` 或 `true`，不要指望 `1` 能当 `true`。"; }
    if k == 23 { return "数组/结构体的元素类型要统一，逐个 `as` 或加一个转换函数。"; }
    if k == 32 { return "Add the type annotation: `let x: u32 = 1;` (a `let` with no type is really E019, a syntax error, but it is easy to read as this one)."; }
    if k == 34 { return "Misspelt: fix the spelling. Cross-module: put `pub` on the declaration and `use <module>` or `use \"./x.lomt\"` at the call site."; }
    if k == 36 { return "Generic functions need their arguments to pin down `T`: `let a: u32 = 4;` then `pick(a, b)`. Passing integer literals straight in reports this code, and that message is misleading."; }
    if k == 38 { return "The name really does come from elsewhere: name its location with the path form `use \"./util.lomt\"`."; }
    if k == 33 { return "补类型标注：`let x: u32 = 1;`（`let` 不带类型是 **E19 语法错**，但很容易被当成这条）。"; }
    if k == 35 { return "拼错了就改拼写；跨模块调用给声明加 `pub`，调用方补 `use <模块名>` 或 `use “./x.lomt”`。"; }
    if k == 37 { return "泛型函数的实参要能把 `T` 定出来：先 `let a: u32 = 4;` 再 `pick(a, b)` —— 直接传整数字面量会报这条，消息有误导。"; }
    if k == 39 { return "确实是别处来的名字：用路径形式 `use “./util.lomt”` 指明位置。"; }
    if k == 48 { return "Count against the signature: delete the extras, supply the missing ones."; }
    if k == 50 { return "Do not count `self` in a method call (`obj.m(a)` is one argument, not two)."; }
    if k == 52 { return "Want an overload? Use a different name: `parse_int` / `parse_float`. Loment resolves by name, and one name with two different parameter lists is not allowed."; }
    if k == 49 { return "照着签名数一遍，多的删、缺的补。"; }
    if k == 51 { return "方法调用别把 `self` 算进去（`obj.m(a)` 是 1 个实参，不是 2 个）。"; }
    if k == 53 { return "想写重载就换个名字：`parse_int` / `parse_float` —— Loment 按名字解析，同名不同参不允许。"; }
    if k == 64 { return "Declare it at module top level: `capability c : disk[0..4]` (`c` is the name, `disk` is the space)."; }
    if k == 66 { return "Range reversed? Swap it: `lo <= hi` is required (`[0..4]` is five values: 0,1,2,3,4)."; }
    if k == 68 { return "Name already taken: rename it. One space may hold several domains, each with its own name."; }
    if k == 70 { return "The index is a literal and out of range: change the index or widen the domain. This check happens at compile time, not at run time."; }
    if k == 65 { return "在模块顶层补声明：`capability c : disk[0..4]`（`c` 是名字，`disk` 是空间名）。"; }
    if k == 67 { return "边界反了就调正：必须 `lo <= hi`（`[0..4]` 是 0,1,2,3,4 五个值）。"; }
    if k == 69 { return "重名就改名；同一空间可以有多个域，各用各的名字。"; }
    if k == 71 { return "索引是字面量且越界：改索引或把域放大 —— 这是编译期检查，不是运行期。"; }
    if k == 80 { return "Delete that `excluded` line, if the promise should not have been there in the first place."; }
    if k == 82 { return "Declare the capability domain over a space that is not excluded."; }
    if k == 84 { return "Keep the promise and change the place that uses it - a capability domain exists precisely to keep access inside a stated range."; }
    if k == 81 { return "删掉那条 `excluded`（如果那份承诺本来就不该有）。"; }
    if k == 83 { return "换一个没有被排除的空间来声明能力域。"; }
    if k == 85 { return "保留承诺、把用到它的那处改掉 —— 能力域本来就是用来把访问收在明确范围内的。"; }
    if k == 96 { return "Pass a reference instead: `f(&v)` or `f(&mut v)` - the most common fix."; }
    if k == 98 { return "You really need a second copy: copy the fields you need into a new variable **before** the move, then pass the original."; }
    if k == 100 { return "Make the type `Copy`: give it only integer fields (`u32`/`i64`/`bool`...), with no string, slice or pointer inside."; }
    if k == 102 { return "Arrange ownership: let the place that uses it last be the one that consumes it, and use references everywhere before that."; }
    if k == 97 { return "改成传引用：`f(&v)` 或 `f(&mut v)` —— 最常用的改法。"; }
    if k == 99 { return "确实要留一份：先在**移动之前**把需要的字段拷到新变量，再传。"; }
    if k == 101 { return "让类型变成可 `Copy` 的：字段全用整型（`u32`/`i64`/`bool`…），去掉里面的字符串/切片/指针。"; }
    if k == 103 { return "把所有权安排清楚：让它最后被用到的那一处消费，前面都用引用。"; }
    if k == 112 { return "Keep only one kind of borrow: turn `&a, &mut a` into `&a` for both (read-only), or into `&mut` for both."; }
    if k == 114 { return "Take the value out first: `let n: u32 = a.x;` then pass `&mut a, n`."; }
    if k == 116 { return "Split one statement into two: read first, store the result in a variable, then take the mutable borrow."; }
    if k == 118 { return "If you must read and write the same memory, write it as three steps: read out, compute, write back."; }
