// lompi/lpi_cli.lomt — 命令行: 命令分派与输出
//
// 命令面照 pip 摆, 但每一条都只做 Loment 模型里**成立**的事:
//
//   lompi index   <store>                     仓库里有哪些包 (pip index)
//   lompi show    <store> <名字[@版本]>        一个包的元数据与身份 (pip show)
//   lompi tree    <store> <名字[@版本]>        依赖树 + 实例身份 (pipdeptree)
//   lompi resolve <store> <名字[@版本]>        把锁打出来 (pip freeze)
//   lompi verify  <store> <锁文件>             重算并逐字节比对 (pip check 的强版本)
//   lompi plan    <store> <名字[@版本]> [--into D]  解出闭包与落盘清单
//   lompi hash    <包目录>                     单个包的自身源码哈希
//   lompi help
//
// **为什么没有"直接装"**: 实测 PE 上只有 8 个 syscall, 其中**没有 mkdir (83)** ——
// 能写进已存在的目录, 但建不了目录。装一个包要新建 `deps/<名字>/`, 所以 lompi 把
// 那一步做成**计划** (plan): 打出确定的目录与文件清单, 由上层的 shell / CI / 参考
// 工具链去执行。在 ELF 目标上 mkdir 是可用的, 那时 plan 可以直接就地执行 —— 边界
// 是目标平台的, 不是 lompi 的。
//
// resolve 与 verify 是一对: resolve 打出锁, verify **重新算一遍再逐字节比对**。
// 这比"检查一下版本对不对"强得多 —— 它真的回答了"这棵仓库还是不是那把锁描述的那棵"。
//
// 命名: 公开 cli_*, 自检 test_cli_*。

module lpi_cli

use "lpi_idn.lomt"

// ---------------------------------------------------------------- 输出

fn out_lit(s: str) {
    sys_write_str(1, s);
}

fn out_slice(p: ptr, off: u32, n: u32) {
    sys_write(1, ((p as u64) + (off as u64)) as ptr, n as u64);
}

fn out_dec(scr: ptr, v: u64) {
    txt_write_dec(1, scr, v);
}

fn err_lit(s: str) {
    sys_write_str(2, s);
}

fn err_name(p: ptr, off: u32, n: u32) {
    sys_write(2, ((p as u64) + (off as u64)) as ptr, n as u64);
}

/// 用法错 (缺参数 / 不认识的命令): 退出码 **2**, 不是 1。
/// 1 留给"跑了但失败" —— 脚本靠这个区分"我用错了"和"仓库有问题"。
fn cli_usage(msg: str) -> u32 {
    err_lit("lompi: ");
    err_lit(msg);
    err_lit("\n");
    return 2;
}

/// 一条诊断行: "lompi: <消息>\n" 到 stderr。退出码 1。
fn cli_die(msg: str) -> u32 {
    err_lit("lompi: ");
    err_lit(msg);
    err_lit("\n");
    return 1;
}

// ---------------------------------------------------------------- 报告缓冲区

fn R(ws: ptr) -> ptr { return ((ws as u64) + WS_REPORT as u64) as ptr; }

// ---------------------------------------------------------------- argv

fn arg_count(buf: ptr, m: u32) -> u32 {
    return sys_arg_count(buf, m);
}

fn arg_is(buf: ptr, av: u64, lit: str) -> bool {
    return sys_arg_eq(buf, av, lit);
}

/// 参数 = "名字[@版本]"。返回 (名字偏移 << 32) | (名字长度 << 16) | 版本长度 打包 —
/// 版本紧跟在名字后面, 中间隔一个 '@'。没有 '@' 时版本长度为 0。
fn spec_split(buf: ptr, av: u64) -> u64 {
    let off: u32 = sys_arg_off(av);
    let n: u32 = sys_arg_len(av);
    let at: u32 = txt_find(buf, off, n, 64);
    if at == TXT_NFIND {
        return (off as u64) * 4294967296 + (n as u64) * 65536 + 0;
    }
    return (off as u64) * 4294967296 + (at as u64) * 65536 + ((n - at - 1) as u64);
}

fn spec_name_off(sp: u64) -> u32 { return (sp / 4294967296) as u32; }
fn spec_name_len(sp: u64) -> u32 { return ((sp % 4294967296) / 65536) as u32; }
fn spec_ver_len(sp: u64) -> u32 { return (sp % 65536) as u32; }
fn spec_ver_ptr(buf: ptr, sp: u64) -> ptr {
    return ((buf as u64) + (spec_name_off(sp) as u64) + (spec_name_len(sp) as u64) + 1) as ptr;
}

// ---------------------------------------------------------------- 公共步骤

/// 扫仓库 + 算身份。返回包数; 失败时用 code 指出原因 (1 打不开 / 2 环 / 3 缺依赖)。
fn load_store(ws: ptr, buf: ptr, m: u32, store: u64, msg: ptr, msgcap: u32) -> u32 {
    let sp: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    sys_put_bytes(sp, buf, sys_arg_off(store), sys_arg_len(store));
    let n: u32 = sto_scan(ws, sp);
    if n == 0 {
        return 0;
    }
    if idn_pass1(ws, n) != n {
        return 0;
    }
    let r: u32 = idn_pass2(ws, n, msg, msgcap);
    if r == IDN_CYCLE {
    cli_die("dependency cycle in store");
        return 0;
    }
    if r == IDN_MISSING {
        err_lit("lompi: missing dependency in store: ");
        sys_write(2, msg, txt_len_cstr(msg) as u64);
        err_lit("\n");
        return 0;
    }
    return n;
}

// ---------------------------------------------------------------- index

fn cmd_index(ws: ptr, buf: ptr, m: u32, av_store: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let n: u32 = load_store(ws, buf, m, av_store, msg, 128);
    if n == 0 {
        return 1;
    }
    out_dec(scr, n as u64);
    out_lit(" package(s) in store\n");
    let i: u32 = 0;
    while i < n {
        out_slice(names, pkg_name_off(ws, i), pkg_name_len(ws, i));
        out_lit(" ");
        out_slice(names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
        out_lit(" ");
        out_slice(pkg_id_hex(ws, i), 0, 16);
        out_lit("\n");
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- show

fn cmd_show(ws: ptr, buf: ptr, m: u32, av_store: u64, av_spec: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let n: u32 = load_store(ws, buf, m, av_store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let off: u32 = spec_name_off(sp);
    let nl: u32 = spec_name_len(sp);
    let vl: u32 = spec_ver_len(sp);
    let idx: u32 = sto_find_bytes2(ws, n, ((buf as u64) + (off as u64)) as ptr, nl,
                                   spec_ver_ptr(buf, sp), vl);
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    out_lit("name:    ");
    out_slice(names, pkg_name_off(ws, idx), pkg_name_len(ws, idx));
    out_lit("\nversion: ");
    out_slice(names, pkg_ver_off(ws, idx), pkg_ver_len(ws, idx));
    out_lit("\nid:      ");
    out_slice(pkg_id_hex(ws, idx), 0, 64);
    out_lit("\ndir:     ");
    out_lit("");
    sys_write(1, pkg_dir(ws, idx), txt_len_cstr(pkg_dir(ws, idx)) as u64);
    out_lit("\n");
    // 边
    let d: ptr = pkg_dir(ws, idx);
    let nf: u32 = pkg_list_sources(ws, d);
    let c: u32 = pkg_edges(ws, d, nf);
    let pool: ptr = ((ws as u64) + WS_EPOOL as u64) as ptr;
    let eents: ptr = ((ws as u64) + WS_EENTS as u64) as ptr;
    idn_sort_edges(pool, eents, c);
    out_dec(scr, c as u64);
    out_lit(" use edge(s):\n");
    let k: u32 = 0;
    while k < c {
        out_lit("  ");
        if lex_ent_kind(eents, k) == LEX_NAME {
            out_lit("name ");
        } else {
            out_lit("path ");
        }
        out_slice(pool, lex_ent_off(eents, k), lex_ent_len(eents, k));
        out_lit("\n");
        k = k + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- tree

/// 第 idx 个包的边数 (重算)。lpi_idn 里的同名助手是私有的, 这里另开一个公开入口。
fn idn_edges_of(ws: ptr, idx: u32) -> u32 {
    let d: ptr = pkg_dir(ws, idx);
    let nf: u32 = pkg_list_sources(ws, d);
    if nf == DIR_ERR {
        return 0;
    }
    return pkg_edges(ws, d, nf);
}

/// 依赖树。用一个 (下标, 深度) 的显式栈 —— 语言没有递归深度保证, 而且树里
/// 菱形依赖会让同一个包出现多次, 所以"已经打过"的要标出来, 不能默默重复。
fn cmd_tree(ws: ptr, buf: ptr, m: u32, av_store: u64, av_spec: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let pool: ptr = ((ws as u64) + WS_EPOOL as u64) as ptr;
    let eents: ptr = ((ws as u64) + WS_EENTS as u64) as ptr;
    // 栈: 每个元素 8 字节 (下标 u32 + 深度 u32), 放在报告区尾部之前的一块独立空间
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 5120) as ptr;
    let n: u32 = load_store(ws, buf, m, av_store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    let spx: u32 = 0;
    txt_store32(stack, 0, idx);
    txt_store32(stack, 4, 0);
    spx = 1;
    while spx > 0 {
        spx = spx - 1;
        let cur: u32 = txt_load32(stack, spx * 8);
        let depth: u32 = txt_load32(stack, spx * 8 + 4);
        let ind: u32 = 0;
        while ind < depth {
            out_lit("  ");
            ind = ind + 1;
        }
        out_slice(names, pkg_name_off(ws, cur), pkg_name_len(ws, cur));
        out_lit("@");
        out_slice(names, pkg_ver_off(ws, cur), pkg_ver_len(ws, cur));
        out_lit(" ");
        out_slice(pkg_id_hex(ws, cur), 0, 12);
        if (pkg_flags(ws, cur) & PKG_F_INCLOSURE) != 0 {
            out_lit("  (already shown)\n");
        } else {
            out_lit("\n");
            pkg_set_flag(ws, cur, PKG_F_INCLOSURE);
            let c: u32 = idn_edges_of(ws, cur);
            idn_sort_edges(pool, eents, c);
            // 逆序压栈, 弹出时才是正序
            let k: u32 = c;
            while k > 0 {
                k = k - 1;
                if lex_ent_kind(eents, k) == LEX_NAME {
                    let ch: u32 = sto_find_bytes(ws, n,
                        ((pool as u64) + (lex_ent_off(eents, k) as u64)) as ptr,
                        lex_ent_len(eents, k));
                    if ch != PKG_NONE && spx < 256 {
                        txt_store32(stack, spx * 8, ch);
                        txt_store32(stack, spx * 8 + 4, depth + 1);
                        spx = spx + 1;
                    }
                }
            }
        }
    }
    return 0;
}

// ---------------------------------------------------------------- resolve / verify

/// 把锁打出来 (进报告区)。锁的每行是 `名字 版本 身份` —— 只有**内容哈希**,
/// 没有版本区间 (docs/168 §3.2: 版本对机器只是标签)。
fn build_lock(ws: ptr, n: u32, root: u32) -> u32 {
    let rep: ptr = R(ws);
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let pool: ptr = ((ws as u64) + WS_EPOOL as u64) as ptr;
    let eents: ptr = ((ws as u64) + WS_EENTS as u64) as ptr;
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 5120) as ptr;
    let o: u32 = 0;
    o = txt_put(rep, o, "# lompi lock v1\n");
    if root == PKG_NONE {
        return o;
    }
    let spx: u32 = 0;
    txt_store32(stack, 0, root);
    spx = 1;
    pkg_set_flag(ws, root, PKG_F_INCLOSURE);
    while spx > 0 {
        spx = spx - 1;
        let cur: u32 = txt_load32(stack, spx * 8);
        o = txt_put_bytes(rep, o, names, pkg_name_off(ws, cur), pkg_name_len(ws, cur));
        o = txt_put(rep, o, " ");
        o = txt_put_bytes(rep, o, names, pkg_ver_off(ws, cur), pkg_ver_len(ws, cur));
        o = txt_put(rep, o, " ");
        o = txt_put_bytes(rep, o, pkg_id_hex(ws, cur), 0, 64);
        o = txt_put(rep, o, "\n");
        let c: u32 = idn_edges_of(ws, cur);
        idn_sort_edges(pool, eents, c);
        let k: u32 = c;
        while k > 0 {
            k = k - 1;
            if lex_ent_kind(eents, k) == LEX_NAME {
                let ch: u32 = sto_find_bytes(ws, n,
                    ((pool as u64) + (lex_ent_off(eents, k) as u64)) as ptr,
                    lex_ent_len(eents, k));
                if ch != PKG_NONE && (pkg_flags(ws, ch) & PKG_F_INCLOSURE) == 0 && spx < 256 {
                    pkg_set_flag(ws, ch, PKG_F_INCLOSURE);
                    txt_store32(stack, spx * 8, ch);
                    spx = spx + 1;
                }
            }
        }
    }
    return o;
}

fn cmd_resolve(ws: ptr, buf: ptr, m: u32, av_store: u64, av_spec: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let n: u32 = load_store(ws, buf, m, av_store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    let o: u32 = build_lock(ws, n, idx);
    sys_write(1, R(ws), o as u64);
    return 0;
}

/// verify: **重新算一遍**, 与锁文件逐字节比。
/// 比"检查版本对不对"强 —— 它回答的是"这棵仓库还是不是那把锁描述的那棵"。
fn cmd_verify(ws: ptr, buf: ptr, m: u32, av_store: u64, av_spec: u64, av_lock: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let lockp: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let n: u32 = load_store(ws, buf, m, av_store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    let o: u32 = build_lock(ws, n, idx);
    // 读锁文件
    sys_put_bytes(lockp, buf, sys_arg_off(av_lock), sys_arg_len(av_lock));
    let file: ptr = ((ws as u64) + WS_STORE as u64) as ptr;
    let got: u64 = sys_read_file(lockp, file, 4096);
    if got == SYS_ERR {
        cli_die("cannot read lock file");
        return 2;
    }
    if got as u32 != o || !txt_eq(R(ws), 0, o, file, 0, o) {
        err_lit("[DIFF] lompi: lock does not match store\n");
        return 1;
    }
    out_lit("[OK] lompi: lock matches store (");
    out_dec(((ws as u64) + (WS_TMP + 7000) as u64) as ptr, o as u64);
    out_lit(" bytes)\n");
    return 0;
}

// ---------------------------------------------------------------- plan

/// 落盘计划。**这一步就是 pip 的 install**, 只是把"建目录"那部分如实写在计划里,
/// 因为 PE 上 lompi 自己做不到 (没有 mkdir) —— 不假装做到。
fn cmd_plan(ws: ptr, buf: ptr, m: u32, av_store: u64, av_spec: u64, into: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let n: u32 = load_store(ws, buf, m, av_store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    out_lit("# lompi plan (target dirs must already exist -- no mkdir on PE)\n");
    out_lit("mkdir -p ");
    if into == 0 {
        out_lit("deps");
    } else {
        sys_write(1, ((buf as u64) + (sys_arg_off(into) as u64)) as ptr, sys_arg_len(into) as u64);
    }
    out_lit("\n");
    // 闭包
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 5120) as ptr;
    let c: u32 = idn_closure(ws, n, idx, stack, 256, msg, 128);
    out_lit("# ");
    out_dec(scr, c as u64);
    out_lit(" package instance(s) in the closure:\n");
    let i: u32 = 0;
    while i < n {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            out_lit("#   ");
            out_slice(names, pkg_name_off(ws, i), pkg_name_len(ws, i));
            out_lit("@");
            out_slice(names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
            out_lit(" ");
            out_slice(pkg_id_hex(ws, i), 0, 12);
            out_lit("\n");
            out_lit("#     from ");
            sys_write(1, pkg_dir(ws, i), txt_len_cstr(pkg_dir(ws, i)) as u64);
            out_lit("\n");
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- hash

fn cmd_hash(ws: ptr, buf: ptr, m: u32, av_dir: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let dig: ptr = ((ws as u64) + WS_DIG as u64) as ptr;
    let hex: ptr = ((ws as u64) + WS_HEX as u64) as ptr;
    sys_put_bytes(scr, buf, sys_arg_off(av_dir), sys_arg_len(av_dir));
    let nf: u32 = pkg_list_sources(ws, scr);
    if nf == DIR_ERR {
        cli_die("cannot open directory");
        return 1;
    }
    if pkg_own_hash(ws, scr, nf, dig) != nf {
        cli_die("source file unreadable or too large (refusing to hash truncated content)");
        return 1;
    }
    sha_hex(dig, hex);
    out_lit("files: ");
    out_dec(((ws as u64) + WS_SCR2 as u64) as ptr, nf as u64);
    out_lit("\nself:  ");
    out_slice(hex, 0, 64);
    out_lit("\n");
    return 0;
}

// ---------------------------------------------------------------- help / main

// Output here is ASCII-only ON PURPOSE: on a 936 (GBK) Windows console the PE
// runtime writes UTF-8 bytes via WriteFile and the console decodes them as GBK, so
// anything non-ASCII becomes mojibake. The runtime has no WriteConsoleW, so the only
// lever we own is to print nothing but ASCII.
fn print_help() {
    out_lit("lompi 0.1.0 - package manager for Loment libraries\n");
    out_lit("        identity = content hash, dependencies = `use` in source\n");
    out_lit("\n");
    out_lit("  lompi install <name> [--into DIR] [--apply] [--from-lock F]  fetch/validate/install\n");
    out_lit("        --apply        really write the files (target dirs must already exist)\n");
    out_lit("        --from-lock F  install exactly the instances F pins, refuse on mismatch\n");
    out_lit("        --into DIR     target DIR\\<name>\\; default is the global store\n");
    out_lit("  lompi check   <dir>                                 is this a valid Loment library?\n");
    out_lit("  lompi fetch   [--registry URL]                      plan the registry download\n");
    out_lit("  lompi config                                        show global root and registry\n");
    out_lit("  lompi version                                       print the version\n");
    out_lit("\n");
    out_lit("  lompi index   <store>                               list packages in the store\n");
    out_lit("  lompi show    <store> <name[@version]>              metadata / use edges / identity\n");
    out_lit("  lompi tree    <store> <name[@version]>              dependency tree\n");
    out_lit("  lompi resolve <store> <name[@version]>              print the lock (hash-pinned)\n");
    out_lit("  lompi verify  <store> <name[@version]> <lockfile>   recompute and compare byte-for-byte\n");
    out_lit("  lompi plan    <store> <name[@version]> [--into DIR]   closure + materialization plan\n");
    out_lit("  lompi hash    <package-dir>                         own-source hash of one package\n");
    out_lit("\n");
    out_lit("store layout: <store>/<name>/<version>/*.lomt (+ optional pkg.lomp)\n");
    out_lit("registry:     a git repo with that same layout; see lompi.conf or --registry\n");
    out_lit("install default destination: the global store (use --into DIR for a project)\n");
}

/// 命令行入口。返回退出码 (0 = OK / 1 = 失败 / 2 = 用法错)。
pub fn cli_main(ws: ptr, buf: ptr, m: u32) -> u32 {
    let ac: u32 = arg_count(buf, m);
    if ac < 2 {
        print_help();
        return 2;
    }
    let c1: u64 = sys_arg_at(buf, m, 1);
    if arg_is(buf, c1, "help") || arg_is(buf, c1, "--help") || arg_is(buf, c1, "-h") {
        print_help();
        return 0;
    }
    if arg_is(buf, c1, "version") || arg_is(buf, c1, "--version") || arg_is(buf, c1, "-V") {
        return cmd_version();
    }
    if arg_is(buf, c1, "config") {
        return cmd_config(ws, buf, m);
    }
    if arg_is(buf, c1, "check") {
        if ac < 3 {
            return cli_usage("check needs a <directory>");
        }
        return cmd_check(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "fetch") {
        return cmd_fetch(ws, buf, m);
    }
    if arg_is(buf, c1, "install") {
        if ac < 3 {
            return cli_usage("install needs a <name>");
        }
        return cmd_install(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "index") {
        if ac < 3 {
            return cli_usage("index needs a <store>");
        }
        return cmd_index(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "hash") {
        if ac < 3 {
            return cli_usage("hash needs a <package-dir>");
        }
        return cmd_hash(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "show") {
        if ac < 4 {
            return cli_usage("show needs <store> <name>");
        }
        return cmd_show(ws, buf, m, sys_arg_at(buf, m, 2), sys_arg_at(buf, m, 3));
    }
    if arg_is(buf, c1, "tree") {
        if ac < 4 {
            return cli_usage("tree needs <store> <name>");
        }
        return cmd_tree(ws, buf, m, sys_arg_at(buf, m, 2), sys_arg_at(buf, m, 3));
    }
    if arg_is(buf, c1, "resolve") {
        if ac < 4 {
            return cli_usage("resolve needs <store> <name>");
        }
        return cmd_resolve(ws, buf, m, sys_arg_at(buf, m, 2), sys_arg_at(buf, m, 3));
    }
    if arg_is(buf, c1, "verify") {
        if ac < 5 {
            return cli_usage("verify needs <store> <name> <lockfile>");
        }
        return cmd_verify(ws, buf, m, sys_arg_at(buf, m, 2), sys_arg_at(buf, m, 3),
                          sys_arg_at(buf, m, 4));
    }
    if arg_is(buf, c1, "plan") {
        if ac < 4 {
            return cli_usage("plan needs <store> <name>");
        }
        let into: u64 = 0;
        let k: u32 = 4;
        while k < ac {
            if arg_is(buf, sys_arg_at(buf, m, k), "--into") && k + 1 < ac {
                into = sys_arg_at(buf, m, k + 1);
            }
            k = k + 1;
        }
        return cmd_plan(ws, buf, m, sys_arg_at(buf, m, 2), sys_arg_at(buf, m, 3), into);
    }
    err_lit("lompi: unknown command: ");
    sys_write(2, ((buf as u64) + (sys_arg_off(c1) as u64)) as ptr, sys_arg_len(c1) as u64);
    err_lit("\n");
    print_help();
    return 2;
}

// ---------------------------------------------------------------- 配置: 全局根 / 网址库
//
// **为什么全局根是"推"出来的而不是读环境变量**: 实测 `/proc/self/environ` 在 PE 垫片
// 上读不了 (它只合成 cmdline), 语言也没有 getenv。但 argv[0] 是**执行文件的全路径**,
// 所以从它反推用户目录是可行的。规则按可靠性排序, 命中哪条 `lompi config` 会打出来 ——
// 猜错看得见, 不会静默走错目录。
//
// 网址库的配置文件 `lompi.conf` 放在**执行文件旁边**, 内容是 **Loment 源码**, 形状与
// `pkg.lomp` 一样: `pub fn registry() -> str { return "https://..."; }`。
// 不新造格式 —— 读它用的就是读清单那套 lex_find_label。

/// ASCII 小写 (Windows 路径大小写不保证)。
fn cfg_fold(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

/// 大小写不敏感地找子串。返回下标或 TXT_NFIND。
fn cfg_find_ci(p: ptr, n: u32, lit: str) -> u32 {
    let ln: u32 = str_len(lit);
    if ln == 0 || ln > n {
        return TXT_NFIND;
    }
    let i: u32 = 0;
    while i + ln <= n {
        let j: u32 = 0;
        let hit: u32 = 1;
        while j < ln {
            if cfg_fold(load8(p, i + j)) != cfg_fold(str_byte(lit, j)) {
                hit = 0;
            }
            j = j + 1;
        }
        if hit == 1 {
            return i;
        }
        i = i + 1;
    }
    return TXT_NFIND;
}

/// path 的父目录。返回长度。
pub fn cfg_parent(path: ptr, out: ptr, outcap: u32) -> u32 {
    let n: u32 = txt_len_cstr(path);
    let cut: u32 = 0;
    let found: u32 = 0;
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        let c: u32 = load8(path, i);
        if (c == 47 || c == 92) && found == 0 {
            cut = i;
            found = 1;
            i = 0;
        }
    }
    let len: u32 = cut;
    if found == 0 {
        return 0;
    }
    if len > outcap {
        return 0;
    }
    sys_copy(out, 0, path, 0, len);
    store8(out, len, 0 as u8);
    return len;
}

/// argv[0] 的目录 —— 也就是执行文件所在目录。scr 是调用方给的暂存 (≥512 字节)。
fn cfg_exe_dir(buf: ptr, m: u32, scr: ptr, out: ptr, outcap: u32) -> u32 {
    let a0: u64 = sys_arg_at(buf, m, 0);
    if a0 == 0 {
        return 0;
    }
    sys_put_bytes(scr, buf, sys_arg_off(a0), sys_arg_len(a0));
    return cfg_parent(scr, out, outcap);
}

/// 全局根 (store / cache / lompi.conf 的父目录)。路径写进 out, 返回**命中的规则号**:
///   0 = exe 在 `\AppData\Local\` 下 -> 它就是 %LOCALAPPDATA%, 根 = <它>\lompi
///   1 = exe 在 `\Users\<名>\` 下      -> 根 = `\Users\<名>\.lompi`
///   2 = 都不是                       -> 根 = <exe 目录>\.lompi
/// 命中的是哪条会由 `lompi config` 打出来 —— 推错了要看得见。
pub fn cfg_root(exe_path: ptr, scr: ptr, out: ptr, outcap: u32) -> u32 {
    let n: u32 = txt_len_cstr(exe_path);
    let a: u32 = cfg_find_ci(exe_path, n, "\\AppData\\Local\\");
    if a != TXT_NFIND && a + 20 <= outcap {
        let end: u32 = a + 15;                 // 含结尾那个 '\'
        sys_copy(out, 0, exe_path, 0, end);
        txt_put(out, end, "lompi");
        return 0;
    }
    let u: u32 = cfg_find_ci(exe_path, n, "\\Users\\");
    if u != TXT_NFIND {
        let ns: u32 = u + 7;                   // 用户名起点
        let ne: u32 = ns;
        while ne < n && load8(exe_path, ne) != 92 && load8(exe_path, ne) != 47 {
            ne = ne + 1;
        }
        if ne > ns && ne + 8 <= outcap {
            sys_copy(out, 0, exe_path, 0, ne);
            txt_put(out, ne, "\\.lompi");
            return 1;
        }
    }
    let dn: u32 = cfg_parent(exe_path, scr, 4096);
    if dn == 0 || dn + 8 > outcap {
        store8(out, 0, 0 as u8);
        return 2;
    }
    sys_copy(out, 0, scr, 0, dn);
    txt_put(out, dn, "\\.lompi");
    return 2;
}

/// `root` + `\` + `sub`, 写进 out 并补 NUL。返回总长度。
pub fn cfg_join(root: ptr, sub: str, out: ptr, outcap: u32) -> u32 {
    let rn: u32 = txt_len_cstr(root);
    let sl: u32 = str_len(sub);
    if rn + 1 + sl > outcap {
        return 0;
    }
    sys_copy(out, 0, root, 0, rn);
    let o1: u32 = txt_put(out, rn, "\\");
    let o2: u32 = txt_put(out, o1, sub);
    store8(out, o2, 0 as u8);
    return o2;
}

/// 读 `<dir>\lompi.conf` 里的标签 (Loment 源码, 形状同 pkg.lomp)。返回长度 (0 = 没有)。
/// out 不能用 WS_SCR2 (本函数内部拿它拼路径)。
pub fn cfg_label(ws: ptr, dir: ptr, name: str, out: ptr, outcap: u32) -> u32 {
    let file: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let dn: u32 = txt_len_cstr(dir);
    if dn == 0 || dn + 12 > WS_SCR2_CAP {
        return 0;
    }
    sys_copy(scr, 0, dir, 0, dn);
    let o: u32 = txt_put(scr, dn, "\\lompi.conf");
    store8(scr, o, 0 as u8);
    let got: u64 = sys_read_file(scr, file, 65536);
    if got == SYS_ERR {
        return 0;
    }
    return lex_find_label(file, got as u32, name, out, outcap);
}

/// 解析生效的网址库。顺序: `--registry <url>` > lompi.conf 的 `registry()` > 无。
/// 返回长度 (0 = 没配); 来源写进 src 的第 0 字节: 0=命令行 1=配置文件 2=没配。
pub fn cfg_registry(ws: ptr, buf: ptr, exe_dir: ptr, flag_av: u64,
                    out: ptr, outcap: u32, src: ptr) -> u32 {
    store8(src, 0, 2 as u8);
    if flag_av != 0 {
        let l: u32 = sys_arg_len(flag_av);
        if l > outcap {
            return 0;
        }
        sys_copy(out, 0, buf, sys_arg_off(flag_av), l);
        store8(src, 0, 0 as u8);
        return l;
    }
    let n: u32 = cfg_label(ws, exe_dir, "registry", out, outcap);
    if n > 0 {
        store8(src, 0, 1 as u8);
    }
    return n;
}

/// 从命令行取 `--flag <值>` 的参数, 没有返回 0。
pub fn cfg_flag_arg(buf: ptr, m: u32, lit: str) -> u64 {
    let ac: u32 = sys_arg_count(buf, m);
    let k: u32 = 2;
    while k < ac {
        if arg_is(buf, sys_arg_at(buf, m, k), lit) && k + 1 < ac {
            return sys_arg_at(buf, m, k + 1);
        }
        k = k + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- version / config / check

fn cmd_version() -> u32 {
    out_lit("lompi 0.1.0\n");
    return 0;
}

/// 打出生效的全局根与网址库, **连"它是按哪条规则推出来的"一起打** ——
/// 推错了要看得见, 而不是静默落到错误的目录上去装东西。
fn cmd_config(ws: ptr, buf: ptr, m: u32) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_OUT as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_OUT as u64 + 1024) as ptr;
    let p: ptr = ((ws as u64) + WS_OUT as u64 + 2048) as ptr;
    let reg: ptr = ((ws as u64) + WS_OUT as u64 + 3072) as ptr;
    let sr: ptr = ((ws as u64) + WS_TMP as u64 + 512) as ptr;
    let exen: u32 = cfg_exe_dir(buf, m, scr, exed, 1024);
    out_lit("version:  0.1.0\n");
    out_lit("exe:      ");
    sys_write(1, exed, exen as u64);
    out_lit("\n");
    if exen == 0 {
        cli_die("cannot derive the executable directory from argv[0]");
        return 1;
    }
    let rule: u32 = cfg_root(exed, scr, root, 1024);
    out_lit("global:   ");
    sys_write(1, root, txt_len_cstr(root) as u64);
    out_lit("\n  rule:   ");
    if rule == 0 {
        out_lit("argv[0] sits under \\AppData\\Local\\, so that is %LOCALAPPDATA%\n");
    } else if rule == 1 {
        out_lit("argv[0] sits under \\Users\\<name>\\, so <that>\\.lompi\n");
    } else {
        out_lit("fallback: <exe dir>\\.lompi (exe is not under AppData or Users)\n");
    }
    cfg_join(root, "store", p, 1024);
    out_lit("store:    ");
    sys_write(1, p, txt_len_cstr(p) as u64);
    out_lit("\n");
    cfg_join(root, "cache", p, 1024);
    out_lit("cache:    ");
    sys_write(1, p, txt_len_cstr(p) as u64);
    out_lit("\n");
    cfg_join(exed, "lompi.conf", p, 1024);
    out_lit("conf:     ");
    sys_write(1, p, txt_len_cstr(p) as u64);
    if cli_exists(p) {
        out_lit("  (present)\n");
    } else {
        out_lit("  (absent)\n");
    }
    let n: u32 = cfg_registry(ws, buf, exed, cfg_flag_arg(buf, m, "--registry"), reg, 1024, sr);
    out_lit("registry: ");
    if n == 0 {
        out_lit("(not set) -- install will use the global store\n");
    } else {
        sys_write(1, reg, n as u64);
        out_lit("\n  from:   ");
        if load8(sr, 0) == 0 {
            out_lit("--registry\n");
        } else {
            out_lit("lompi.conf\n");
        }
    }
    return 0;
}

/// 追加一个**运行期**的 NUL 结尾串 (不含 NUL)。返回新偏移。
/// 为什么不用 txt_put: 那个收的是编译期 str 字面量, 运行期的 ptr 传不进去。
pub fn cli_put_cstr(dst: ptr, off: u32, s: ptr) -> u32 {
    let n: u32 = txt_len_cstr(s);
    sys_copy(dst, off, s, 0, n);
    return off + n;
}

/// 文件在不在 (读得开就算在)。
fn cli_exists(path: ptr) -> bool {
    let fd: i64 = sys_open_ro(path);
    if fd < 0 {
        return false;
    }
    sys_close(fd);
    return true;
}

/// `check <目录>`: 这**是不是一个正确的 Loment 库**。
fn cmd_check(ws: ptr, buf: ptr, m: u32, av_dir: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let rep: ptr = ((ws as u64) + WS_REPORT as u64) as ptr;
    let dec: ptr = ((ws as u64) + WS_TMP as u64) as ptr;
    sys_put_bytes(scr, buf, sys_arg_off(av_dir), sys_arg_len(av_dir));
    let bad: u32 = pkg_check(ws, scr, rep, WS_REPORT_CAP);
    sys_write(1, rep, txt_len_cstr(rep) as u64);
    if bad == 0 {
        out_lit("[OK] lompi: this is a valid Loment library\n");
        return 0;
    }
    out_lit("[BAD] lompi: ");
    out_dec(dec, bad as u64);
    out_lit(" check(s) failed\n");
    return 1;
}

// ---------------------------------------------------------------- fetch / install

/// 从 URL 取仓库名 (最后一段, 去掉结尾的 .git)。
pub fn cfg_slug(url: ptr, n: u32, out: ptr, outcap: u32) -> u32 {
    let cut: u32 = 4294967295;
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        let c: u32 = load8(url, i);
        if (c == 47 || c == 58) && cut == 4294967295 {
            cut = i;
            i = 0;
        }
    }
    let s: u32 = 0;
    if cut != 4294967295 {
        s = cut + 1;
    }
    let e: u32 = n - s;
    let e2: u32 = e;
    if e > 4 && txt_eq_lit(url, s + e - 4, 4, ".git") {
        e2 = e - 4;
    }
    if e2 == 0 || e2 > outcap {
        return 0;
    }
    sys_copy(out, 0, url, s, e2);
    store8(out, e2, 0 as u8);
    return e2;
}

/// `fetch`: 把网址库克隆到缓存 —— **lompi 自己做不到联网**, 所以给出计划。
/// PE 上只有 8 个 syscall, 没有 socket; 垫片也没有 ws2_32/winhttp。这一步必须由
/// shell / CI 执行, 与 `mkdir` 那条边界是同一个道理。
fn cmd_fetch(ws: ptr, buf: ptr, m: u32) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_OUT as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_OUT as u64 + 1024) as ptr;
    let cache: ptr = ((ws as u64) + WS_OUT as u64 + 2048) as ptr;
    let slug: ptr = ((ws as u64) + WS_OUT as u64 + 3072) as ptr;
    let reg: ptr = ((ws as u64) + WS_OUT as u64 + 3328) as ptr;
    let dst: ptr = ((ws as u64) + WS_OUT as u64 + 4352) as ptr;
    let sr: ptr = ((ws as u64) + WS_TMP as u64) as ptr;
    if cfg_exe_dir(buf, m, scr, exed, 1024) == 0 {
        return cli_die("cannot derive the executable directory from argv[0]");
    }
    let n: u32 = cfg_registry(ws, buf, exed, cfg_flag_arg(buf, m, "--registry"), reg, 1024, sr);
    if n == 0 {
        cli_die("no registry configured: pass --registry <url> or put a lompi.conf next to lompi.exe");
        return 1;
    }
    cfg_root(exed, scr, root, 1024);
    cfg_join(root, "cache", cache, 1024);
    cfg_slug(reg, n, slug, 256);
    let dn: u32 = txt_len_cstr(cache);
    sys_copy(dst, 0, cache, 0, dn);
    let o1: u32 = txt_put(dst, dn, "\\");
    let o2: u32 = cli_put_cstr(dst, o1, slug);
    store8(dst, o2, 0 as u8);

    out_lit("# lompi fetch plan (lompi cannot do network on PE -- no socket in the 8 syscalls)\n");
    out_lit("# registry: ");
    sys_write(1, reg, n as u64);
    if load8(sr, 0) == 0 {
        out_lit("  (from --registry)\n");
    } else {
        out_lit("  (from lompi.conf)\n");
    }
    out_lit("mkdir -p ");
    sys_write(1, cache, dn as u64);
    out_lit("\n");
    out_lit("git clone --depth 1 ");
    sys_write(1, reg, n as u64);
    out_lit(" ");
    sys_write(1, dst, o2 as u64);
    out_lit("\n# to update later:  git -C ");
    sys_write(1, dst, o2 as u64);
    out_lit(" pull\n");
    return 0;
}

/// 把一个包的源文件 (含可选的 pkg.lomp) 从 src 目录拷进 dst 目录。
/// 返回拷过去的文件数; 有任何一步失败返回 4294967295。
///
/// **不建目录** —— dst 必须已经存在。这是 PE 上没有 mkdir 的直接后果, 不是没做完:
/// 能写进已存在的目录, 建不了目录。所以 `--apply` 会先把缺的目录查出来报清楚。
fn cli_copy_pkg(ws: ptr, src: ptr, dst: ptr, scr: ptr, scr2: ptr) -> u32 {
    let file: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_NAMES as u64) as ptr;
    let ents: ptr = ((ws as u64) + WS_ENTS as u64) as ptr;
    let sn: u32 = txt_len_cstr(src);
    let dn: u32 = txt_len_cstr(dst);
    if sn == dn && txt_eq(src, 0, sn, dst, 0, dn) {
        return 0;                                  // 源与目标同一个目录, 没什么可做
    }
    let n: u32 = pkg_list_sources(ws, src);
    if n == DIR_ERR {
        return 4294967295;
    }
    let k: u32 = 0;
    while k < n {
        let o: u32 = dir_ent_name_off(ents, k);
        let l: u32 = dir_ent_name_len(ents, k);
        sys_join(scr, src, sn, ((names as u64) + (o as u64)) as ptr, l);
        let got: u64 = sys_read_file(scr, file, PKG_FILE_MAX as u64);
        if got == SYS_ERR || got > (PKG_FILE_MAX as u64) {
            return 4294967295;
        }
        sys_join(scr2, dst, dn, ((names as u64) + (o as u64)) as ptr, l);
        if sys_write_file(scr2, file, got) == SYS_ERR {
            return 4294967295;
        }
        k = k + 1;
    }
    // pkg.lomp 是可选标签文件, 一起带过去 —— 留着才知道这个包自称是什么
    let leaf: ptr = ((ws as u64) + WS_TMP as u64 + 7168) as ptr;
    txt_put(leaf, 0, "pkg.lomp");
    store8(leaf, 8, 0 as u8);
    sys_join(scr, src, sn, leaf, 8);
    let pg: u64 = sys_read_file(scr, file, 65536);
    if pg != SYS_ERR {
        sys_join(scr2, dst, dn, leaf, 8);
        if sys_write_file(scr2, file, pg) == SYS_ERR {
            return 4294967295;
        }
    }
    return n;
}

/// 命令行里有没有这个开关 (不带值的那种)。
pub fn cfg_has_flag(buf: ptr, m: u32, lit: str) -> bool {
    let ac: u32 = sys_arg_count(buf, m);
    let k: u32 = 2;
    while k < ac {
        if arg_is(buf, sys_arg_at(buf, m, k), lit) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// 第 i 个实例的目标目录 (NUL 结尾, 写进 dst)。
/// `--into DIR` -> `DIR\<名字>` (编译器 `use` 要的扁平形状);
/// 不给 -> `<全局库>\<名字>\<版本>`。
fn cli_dst_of(dst: ptr, buf: ptr, into: u64, store: ptr, ws: ptr, i: u32) {
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let o: u32 = 0;
    if into != 0 {
        let l: u32 = sys_arg_len(into);
        sys_copy(dst, 0, buf, sys_arg_off(into), l);
        o = l;
    } else {
        let sn: u32 = txt_len_cstr(store);
        sys_copy(dst, 0, store, 0, sn);
        o = sn;
    }
    store8(dst, o, 92 as u8);
    o = o + 1;
    sys_copy(dst, o, names, pkg_name_off(ws, i), pkg_name_len(ws, i));
    o = o + pkg_name_len(ws, i);
    if into == 0 {
        store8(dst, o, 92 as u8);
        o = o + 1;
        sys_copy(dst, o, names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
        o = o + pkg_ver_len(ws, i);
    }
    store8(dst, o, 0 as u8);
}

/// `--apply` 那一半: **真的把文件写过去**。
///
/// 先查目标目录在不在 —— lompi 建不了目录 (PE 上没有 mkdir), 所以缺就先一次性报清楚
/// 再拒, 而不是拷一半留下个半成品。目录由调用方建 (报错里直接给出 mkdir 命令)。
fn cli_apply(ws: ptr, np: u32, into: u64, buf: ptr, store: ptr) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let scr2: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let dst: ptr = ((ws as u64) + WS_REPORT as u64 + 4096) as ptr;
    let st: ptr = ((ws as u64) + WS_TMP as u64 + 7168) as ptr;
    let missing: u32 = 0;
    let i: u32 = 0;
    while i < np {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            cli_dst_of(dst, buf, into, store, ws, i);
            if !dir_stat_exists(dst, st) {
                missing = missing + 1;
            }
        }
        i = i + 1;
    }
    if missing > 0 {
        err_lit("[BAD] lompi: refusing --apply: target director(y/ies) do not exist.\n");
        err_lit("      lompi cannot mkdir on PE -- create them first:\n");
        i = 0;
        while i < np {
            if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
                cli_dst_of(dst, buf, into, store, ws, i);
                err_lit("      mkdir -p \"");
                sys_write(2, dst, txt_len_cstr(dst) as u64);
                err_lit("\"\n");
            }
            i = i + 1;
        }
        return 1;
    }
    i = 0;
    while i < np {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            cli_dst_of(dst, buf, into, store, ws, i);
            let c: u32 = cli_copy_pkg(ws, pkg_dir(ws, i), dst, scr, scr2);
            if c == 4294967295 {
                err_lit("lompi: copy failed into ");
                sys_write(2, dst, txt_len_cstr(dst) as u64);
                err_lit("\n");
                return 1;
            }
            out_lit("installed ");
            out_slice(names, pkg_name_off(ws, i), pkg_name_len(ws, i));
            out_lit("@");
            out_slice(names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
            out_lit(" -> ");
            sys_write(1, dst, txt_len_cstr(dst) as u64);
            out_lit("\n");
        }
        i = i + 1;
    }
    out_lit("[OK] lompi: installed\n");
    return 0;
}

/// `install <名字> [--into DIR]`: 就位 -> **校验** -> 身份 -> 落盘计划 (含拷贝命令)。
///
/// 来源 (按序): 缓存里克隆好的网址库 -> 全局库。目标: `--into DIR` 装成
/// `DIR\<名字>\`, 不给就**全局安装**到 `<全局根>\store\<名字>\<版本>\`。
fn cmd_install(ws: ptr, buf: ptr, m: u32, av_spec: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_OUT as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_OUT as u64 + 1024) as ptr;
    let cache: ptr = ((ws as u64) + WS_OUT as u64 + 2048) as ptr;
    let store: ptr = ((ws as u64) + WS_OUT as u64 + 3072) as ptr;
    let slug: ptr = ((ws as u64) + WS_OUT as u64 + 4096) as ptr;
    let reg: ptr = ((ws as u64) + WS_OUT as u64 + 4352) as ptr;
    let srcroot: ptr = ((ws as u64) + WS_OUT as u64 + 5376) as ptr;
    let sr: ptr = ((ws as u64) + WS_TMP as u64 + 512) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 1024) as ptr;
    let rep: ptr = ((ws as u64) + WS_REPORT as u64) as ptr;
    let dec: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    if cfg_exe_dir(buf, m, scr, exed, 1024) == 0 {
        return cli_die("cannot derive the executable directory from argv[0]");
    }
    cfg_root(exed, scr, root, 1024);
    cfg_join(root, "store", store, 1024);
    cfg_join(root, "cache", cache, 1024);
    let into: u64 = cfg_flag_arg(buf, m, "--into");

    // ---- 来源: 缓存里的网址库 -> 全局库
    let n: u32 = cfg_registry(ws, buf, exed, cfg_flag_arg(buf, m, "--registry"), reg, 1024, sr);
    let have_reg: u32 = 0;
    if n > 0 {
        cfg_slug(reg, n, slug, 256);
        let cn: u32 = txt_len_cstr(cache);
        sys_copy(srcroot, 0, cache, 0, cn);
        let g1: u32 = txt_put(srcroot, cn, "\\");
        let g2: u32 = cli_put_cstr(srcroot, g1, slug);
        store8(srcroot, g2, 0 as u8);
        if cli_exists(srcroot) {
            have_reg = 1;
        }
    }
    if have_reg == 0 {
        // +1: 结尾 NUL 也要抄。少抄一个字节, 路径后面就会拖着上一步写进去的
        // 网址库路径残字 (srcroot 先被当作缓存路径用过), sto_scan 于是报"没有包"——
        // 而这个分支恰恰是"配了网址库但还没克隆"时才会走到的。
        sys_copy(srcroot, 0, store, 0, txt_len_cstr(store) + 1);
    }

    let np: u32 = sto_scan(ws, srcroot);
    if np == 0 {
        if have_reg == 1 {
            cli_die("the fetched registry is empty or unreadable; run `lompi fetch` first");
        } else {
            cli_die("no packages found; is the global store populated?");
        }
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, np,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }

    // ---- 校验: 不是正确的 Loment 库就拒装, 并说清是哪一条不过
    let bad: u32 = pkg_check(ws, pkg_dir(ws, idx), rep, WS_REPORT_CAP);
    if bad != 0 {
        err_lit("[BAD] lompi: refusing to install -- not a valid Loment library:\n");
        sys_write(2, rep, txt_len_cstr(rep) as u64);
        return 1;
    }
    // pkg_check 用掉了列目录那套暂存, 身份要重算一次
    let np2: u32 = sto_scan(ws, srcroot);
    if idn_pass1(ws, np2) != np2 {
        return cli_die("some package in the store could not be hashed");
    }
    let r2: u32 = idn_pass2(ws, np2, msg, 256);
    if r2 != IDN_OK {
        // 仓库层面算不出身份: 报出来, 但**不因此拒绝** —— 要装的那一支可能是好的,
        // 让下面的锁/闭包检查去裁决, 免得一个坏包把整个仓库的安装都堵死。
        err_lit("# note: the store has packages that cannot be identified: ");
        if r2 == IDN_CYCLE {
            err_lit("dependency cycle\n");
        } else {
            err_lit("missing dependency `");
            sys_write(2, msg, txt_len_cstr(msg) as u64);
            err_lit("`\n");
        }
    }

    // ---- 闭包: `--from-lock` 按锁对实例, 否则按"版本最大"解析
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 2048) as ptr;
    let lockav: u64 = cfg_flag_arg(buf, m, "--from-lock");
    let from_lock: u32 = 0;
    let cl: u32 = 0;
    if lockav != 0 {
        let lbuf: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
        let lpath: ptr = ((ws as u64) + WS_OUT as u64 + 6400) as ptr;
        sys_put_bytes(lpath, buf, sys_arg_off(lockav), sys_arg_len(lockav));
        let got: u64 = sys_read_file(lpath, lbuf, 65536);
        if got == SYS_ERR {
            return cli_die("cannot read the lock file");
        }
        let ln: u32 = pkg_lock_read(ws, lbuf, got as u32, np2, msg, 256);
        if ln == PKG_ERR {
            err_lit("lompi: lock does not match this store: ");
            sys_write(2, msg, txt_len_cstr(msg) as u64);
            err_lit("\n  (the locked instance is absent, or its identity changed)\n");
            return 1;
        }
        cl = ln;
        from_lock = 1;
    } else {
        let idx2: u32 = sto_find_bytes2(ws, np2,
                                        ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                        spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
        cl = idn_closure(ws, np2, idx2, stack, 256, msg, 256);
        if cl == 4294967295 {
            err_lit("lompi: missing dependency in store: ");
            sys_write(2, msg, txt_len_cstr(msg) as u64);
            err_lit("\n");
            return 1;
        }
    }

    // ---- 落盘: 打出计划; `--apply` 时交给 cli_apply 真的写。
    // 目标目录必须已存在 —— PE 上没有 mkdir, cli_apply 会先一次性报清缺哪些再拒,
    // 而不是拷一半留下半成品。
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let apply: bool = cfg_has_flag(buf, m, "--apply");
    let dstb: ptr = ((ws as u64) + WS_OUT as u64 + 7424) as ptr;
    out_lit("# lompi install plan\n");
    out_lit("# source:   ");
    sys_write(1, srcroot, txt_len_cstr(srcroot) as u64);
    if have_reg == 1 {
        out_lit("  (cached registry)\n");
    } else {
        out_lit("  (global store)\n");
    }
    out_lit("# closure:  ");
    if from_lock == 1 {
        out_lit("from the lock file -- every entry checked against this store\n");
    } else {
        out_lit("resolved by highest version\n");
    }
    out_lit("# dest:     ");
    if into != 0 {
        out_lit("--into <DIR> -> DIR\\<name>\\ (flat, as the compiler expects)\n");
    } else {
        out_lit("global store -> <global>\\store\\<name>\\<version>\\\n");
    }
    out_lit("mkdir -p ");
    if into != 0 {
        sys_write(1, ((buf as u64) + (sys_arg_off(into) as u64)) as ptr, sys_arg_len(into) as u64);
    } else {
        sys_write(1, store, txt_len_cstr(store) as u64);
    }
    out_lit("\n# ");
    out_dec(dec, cl as u64);
    out_lit(" package instance(s):\n");
    let i: u32 = 0;
    while i < np2 {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            cli_dst_of(dstb, buf, into, store, ws, i);
            out_lit("cp -r ");
            sys_write(1, pkg_dir(ws, i), txt_len_cstr(pkg_dir(ws, i)) as u64);
            out_lit(" ");
            sys_write(1, dstb, txt_len_cstr(dstb) as u64);
            out_lit("\n");
        }
        i = i + 1;
    }
    if apply {
        return cli_apply(ws, np2, into, buf, store);
    }
    out_lit("# nothing was written: re-run with --apply to materialize (target dirs must exist)\n");
    return 0;
}

// ---------------------------------------------------------------- 自检

fn test_cli_spec_split_with_version() -> bool {
    let b: ptr = alloc(128);
    sys_put_lit(b, "geom@1.0.0");
    let av: u64 = 0;
    let sp: u64 = spec_split(b, av + 10);
    return spec_name_off(sp) == 0 && spec_name_len(sp) == 4 && spec_ver_len(sp) == 5;
}

fn test_cli_spec_split_without_version() -> bool {
    let b: ptr = alloc(128);
    sys_put_lit(b, "mathutil");
    let av: u64 = 0;
    let sp: u64 = spec_split(b, av + 8);
    return spec_name_off(sp) == 0 && spec_name_len(sp) == 8 && spec_ver_len(sp) == 0;
}

fn test_cli_verify_sees_identical_lock() -> bool {
    // resolve 与 verify 是一对: 同一棵仓库重算出来的锁必须逐字节一样。
    // 这里直接比两次 build_lock 的输出 (免去写临时文件 —— PE 上写文件要真路径)。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let rep: ptr = R(ws);
    sys_put_lit(scr, "fixture/store");
    let n: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n);
    if idn_pass2(ws, n, msg, 128) != IDN_OK {
        return false;
    }
    let root: u32 = sto_find(ws, n, "geom", "");
    let o1: u32 = build_lock(ws, n, root);
    let first: ptr = sys_alloc(4096);
    sys_copy(first, 0, rep, 0, o1);
    // 重扫一遍再算
    let n2: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n2);
    if idn_pass2(ws, n2, msg, 128) != IDN_OK {
        return false;
    }
    let root2: u32 = sto_find(ws, n2, "geom", "");
    let o2: u32 = build_lock(ws, n2, root2);
    return o1 == o2 && txt_eq(first, 0, o1, rep, 0, o2);
}

fn test_cli_lock_has_one_line_per_instance() -> bool {
    // geom 的闭包是 2 个实例 -> 锁里除表头外应当正好 2 行。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let rep: ptr = R(ws);
    sys_put_lit(scr, "fixture/store");
    let n: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n);
    idn_pass2(ws, n, msg, 128);
    let root: u32 = sto_find(ws, n, "geom", "");
    let o: u32 = build_lock(ws, n, root);
    let i: u32 = 0;
    let lines: u32 = 0;
    while i < o {
        if load8(rep, i) == 10 {
            lines = lines + 1;
        }
        i = i + 1;
    }
    return lines == 3;   // 表头 + 2 行
}

fn test_cli_diamond_dedups_to_one_instance() -> bool {
    // 菱形: diamond 同时 `use geom` 与 `use mathutil`, 而 geom 也依赖 mathutil。
    // 闭包里 mathutil 必须**只出现一次** —— 同一个实例摊两遍是错的 (它会让
    // "闭包里有几个包"这个数骗人)。夹具: fixture/store_diamond。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let rep: ptr = R(ws);
    sys_put_lit(scr, "fixture/store_diamond");
    let n: u32 = sto_scan(ws, scr);
    if n != 3 {
        return false;
    }
    idn_pass1(ws, n);
    if idn_pass2(ws, n, msg, 128) != IDN_OK {
        return false;
    }
    let root: u32 = sto_find(ws, n, "diamond", "");
    let o: u32 = build_lock(ws, n, root);
    // 表头 + 3 个实例 = 4 行; mathutil 摊了两遍就会是 5 行。
    let i: u32 = 0;
    let lines: u32 = 0;
    while i < o {
        if load8(rep, i) == 10 {
            lines = lines + 1;
        }
        i = i + 1;
    }
    return lines == 4;
}

fn test_cli_tree_diamond_shares_same_geom_identity() -> bool {
    // 同一份 geom 源码, 在这个仓库里绑到 mathutil 0.1.0 -> 身份与 fixture/store
    // 里那份不同。这条把"身份含依赖的绑定"从 CLI 这一层再钉一次。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    sys_put_lit(scr, "fixture/store_diamond");
    let n: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n);
    if idn_pass2(ws, n, msg, 128) != IDN_OK {
        return false;
    }
    let g: u32 = sto_find(ws, n, "geom", "");
    if g == PKG_NONE {
        return false;
    }
    // fixture/store 里 geom 绑的是 mathutil 0.2.0, 身份前缀是 06b4cc0d3b1f136f
    return txt_eq_lit(pkg_id_hex(ws, g), 0, 16, "0f4bb3784d09714d");
}

pub fn selftest_cli() -> u32 {
    let f: u32 = 0;
    if !test_cli_spec_split_with_version() { f = f + 1; sys_write_str(1, "  FAIL cli_spec1\n"); }
    if !test_cli_spec_split_without_version() { f = f + 1; sys_write_str(1, "  FAIL cli_spec2\n"); }
    if !test_cli_verify_sees_identical_lock() { f = f + 1; sys_write_str(1, "  FAIL cli_lockstable\n"); }
    if !test_cli_lock_has_one_line_per_instance() { f = f + 1; sys_write_str(1, "  FAIL cli_locklines\n"); }
    return f;
}
