// lompi/lpi_sha.lomt — SHA-256
//
// 为什么要它: lompi 的实例身份是**内容哈希** (docs/168 判据 2), 所以哈希不是装饰,
// 是正确性本身 —— 弱的哈希会把两个不同的实例合并成一个, 那是静默的错。
// 这一层是纯整数运算, 没有 syscall, 所以自检能拿标准测试向量钉死。
//
// 用法 (调用方自己管缓冲, 本层不分配):
//   let st: ptr = sys_alloc(sha_state_size());
//   sha_init(st); sha_update(st, p, n); sha_final(st, dig); sha_hex(dig, hex);
//   st 至少 1024 字节 (布局到 @624 为止, 留余量), dig 32 字节, hex 64 字节。
//
// 状态块布局 (与仓库 loment/lib/sha256.lomt 一致, 便于两边对拍):
//   @0   H[8]     32 字节
//   @32  CNT      u32  (当前块里已有多少字节)
//   @36  TOT      u32  (总共吃了多少字节)
//   @48  BLK      64 字节
//   @112 W[64]    256 字节
//   @368 K[64]    256 字节
//
// 命名: 公开 sha_*, 自检 test_sha_*。
//
// 一条**写法纪律** (不是风格): 所有算术都让变量在左。实测 fujoc-s 对以整数字面量
// 开头的表达式按 32 位算 (见 lpi_sys 的 test_sys_wide_arithmetic_needs_variable_first),
// 而 SHA 到处都是宽算术。

module lpi_sha

use "lpi_dir.lomt"

pub const SHA_H: u32 = 0;
pub const SHA_CNT: u32 = 32;
pub const SHA_TOT: u32 = 36;
pub const SHA_BLK: u32 = 48;
pub const SHA_W: u32 = 112;
pub const SHA_K: u32 = 368;

pub fn sha_state_size() -> u32 {
    return 1024;
}

pub fn sha_dig_size() -> u32 {
    return 32;
}

pub fn sha_hex_size() -> u32 {
    return 64;
}

// ---------------------------------------------------------------- 字节序

/// 大端读 u32。
pub fn sha_be32(p: ptr, off: u32) -> u32 {
    let a: u32 = load8(p, off + 0);
    let b: u32 = load8(p, off + 1);
    let c: u32 = load8(p, off + 2);
    let d: u32 = load8(p, off + 3);
    return (a << 24) | (b << 16) | (c << 8) | d;
}

pub fn sha_put_be32(p: ptr, off: u32, v: u32) {
    store8(p, off + 0, ((v >> 24) & 255) as u8);
    store8(p, off + 1, ((v >> 16) & 255) as u8);
    store8(p, off + 2, ((v >> 8) & 255) as u8);
    store8(p, off + 3, (v & 255) as u8);
}

pub fn sha_put_be64(p: ptr, off: u32, v: u64) {
    let sc: u64 = 4294967296;
    let hi: u32 = (v / sc) as u32;
    let lo: u32 = (v % sc) as u32;
    sha_put_be32(p, off + 0, hi);
    sha_put_be32(p, off + 4, lo);
}

// ---------------------------------------------------------------- 初始化

pub fn sha_init(s: ptr) {
    store32_at(s, SHA_H + 0, 1779033703);
    store32_at(s, SHA_H + 4, 3144134277);
    store32_at(s, SHA_H + 8, 1013904242);
    store32_at(s, SHA_H + 12, 2773480762);
    store32_at(s, SHA_H + 16, 1359893119);
    store32_at(s, SHA_H + 20, 2600822924);
    store32_at(s, SHA_H + 24, 528734635);
    store32_at(s, SHA_H + 28, 1541459225);
    txt_store32(s, SHA_CNT, 0);
    txt_store32(s, SHA_TOT, 0);
    store32_at(s, SHA_K + 0, 1116352408);
    store32_at(s, SHA_K + 4, 1899447441);
    store32_at(s, SHA_K + 8, 3049323471);
    store32_at(s, SHA_K + 12, 3921009573);
    store32_at(s, SHA_K + 16, 961987163);
    store32_at(s, SHA_K + 20, 1508970993);
    store32_at(s, SHA_K + 24, 2453635748);
    store32_at(s, SHA_K + 28, 2870763221);
    store32_at(s, SHA_K + 32, 3624381080);
    store32_at(s, SHA_K + 36, 310598401);
    store32_at(s, SHA_K + 40, 607225278);
    store32_at(s, SHA_K + 44, 1426881987);
    store32_at(s, SHA_K + 48, 1925078388);
    store32_at(s, SHA_K + 52, 2162078206);
    store32_at(s, SHA_K + 56, 2614888103);
    store32_at(s, SHA_K + 60, 3248222580);
    store32_at(s, SHA_K + 64, 3835390401);
    store32_at(s, SHA_K + 68, 4022224774);
    store32_at(s, SHA_K + 72, 264347078);
    store32_at(s, SHA_K + 76, 604807628);
    store32_at(s, SHA_K + 80, 770255983);
    store32_at(s, SHA_K + 84, 1249150122);
    store32_at(s, SHA_K + 88, 1555081692);
    store32_at(s, SHA_K + 92, 1996064986);
    store32_at(s, SHA_K + 96, 2554220882);
    store32_at(s, SHA_K + 100, 2821834349);
    store32_at(s, SHA_K + 104, 2952996808);
