// std/std.lomt — 包入口 (可移植层)。
//
// `use std` 指的是**包内与包同名的那个模块** (docs/168 判据 test_multi_file_package_
// survives_materialize: 包名与入口文件名必须一致), 所以这个文件必须叫 std.lomt
// 且 `module std`。它自己不做任何事 —— 作用是把包内全部模块拉进**同一个单元**,
// 于是 `pub` 的东西对消费方可见 (平名字空间, 前缀是各模块自己的纪律)。
//
// 包内 76 个模块, **全部是可移植的**: 一个 syscall 都不发 (numfmt 在最底下)。
// 宿主侧 (syscall/fd/argv/目录/stat/日志) 在另一个包 host 里, 依赖方向单向:
//     host -> std -> numfmt
// 所以裸机/无宿主的消费者只依赖 std, 不会把 getdents64 之类的东西拖进来。
//
// **这条入口的工具链边界** (实测, 不是猜测): 打包版编译器有两个限制 —— 单文件最多
// 8 条 use、菱形导入会崩。这个文件两条都不满足 (61 条 use; mem/wide 被多个模块共用
// 就是菱形)。所以:
//   - **参考实现** (`python tools/loment.py`) 能吃它 —— 它做去重、不限条数;
//     `loment lib materialize` 正是走这条路, 物化出来的树才是编译器吃的形状。
//   - 打包版编译器上, 消费方要**按需 use 具体模块** (路径形式), 不要 `use std`。
// 这不是这一层能自己解决的事 —— 要让它变成一条 use, 得先让编译器支持去重与不限条数。
//
// 顺序: 从最底层往上 —— 顺着读就是依赖方向 (下面每层只 use 比它更早的)。

module std

// 基础: 内建之外的第一层
use "mem.lomt"
use "bit.lomt"
use "num.lomt"
use "numfmt.lomt"
use "wide.lomt"
use "endian.lomt"
use "assert.lomt"

// 分配
use "arena.lomt"
use "mall.lomt"
use "pool.lomt"
use "memdbg.lomt"

// 软浮点 (bits -> 算术 -> 转换 -> 大整数 -> 文本/超越)
use "f64bits.lomt"
use "f64.lomt"
use "f64conv.lomt"
use "round.lomt"
use "bigint.lomt"
use "f64fmt.lomt"
use "mathf.lomt"

// 十进制
use "bigdec.lomt"
use "fixed.lomt"

// 缓冲与游标输出
use "buf.lomt"
use "ring.lomt"
use "out.lomt"
use "fmt.lomt"
use "vec.lomt"

// 容器
use "heap.lomt"
use "deque.lomt"
use "map.lomt"
use "set.lomt"
use "mapstr.lomt"
use "ilist.lomt"
use "trie.lomt"
use "bst.lomt"
use "bitset.lomt"

// 文本
use "char.lomt"
use "text.lomt"
use "trim.lomt"
use "split.lomt"
use "word.lomt"
use "line.lomt"
use "parse.lomt"
use "utf8.lomt"
use "case.lomt"
use "glob.lomt"
use "path.lomt"
use "quote.lomt"
use "csv.lomt"
use "hex.lomt"
use "base64.lomt"
use "varint.lomt"

// 排序与查找
use "sort.lomt"
use "bsearch.lomt"

// 随机
use "rand.lomt"

// 摘要与校验
use "crc32.lomt"
use "crc16.lomt"
use "crc32c.lomt"
use "adler32.lomt"
use "sum.lomt"
use "md5.lomt"
use "sha1.lomt"
use "sha256.lomt"
use "sha512.lomt"
use "hmac.lomt"
use "kdf.lomt"

// 整数上的数学 (math 是整数版; 浮点版是上面的 mathf)
use "math.lomt"
use "hash.lomt"

// 编解码与格式 (T7)。全部是**游标式**读取: 值留在原文里, 不建树。
//   base32/58/85 是"字节<->文本", url 是百分号编码, 其余是四种配置/交换格式。
use "base32.lomt"
use "base58.lomt"
use "base85.lomt"
use "url.lomt"
use "ini.lomt"
use "jsn.lomt"
use "toml.lomt"
use "mpk.lomt"
use "cbor.lomt"
use "asn1.lomt"

// 补齐: 上面那几段是按主题手写的, 这一段是全量核对后补上的漏项。
// (清单以**目录里的实际文件**为准, 由 tools/ 的核对脚本生成。)
use "ansi.lomt"
use "atomics.lomt"
use "blit.lomt"
use "bloom.lomt"
use "bmp.lomt"
use "bufio.lomt"
use "civil.lomt"
use "clock.lomt"
use "comb.lomt"
use "coro.lomt"
use "deflate.lomt"
use "env.lomt"
use "fenwick.lomt"
use "flags.lomt"
use "font.lomt"
use "fwalk.lomt"
use "graph.lomt"
use "hashx.lomt"
use "hexdump.lomt"
use "huffman.lomt"
use "inflate.lomt"
use "intern.lomt"
use "interp.lomt"
use "intmath.lomt"
use "lru.lomt"
use "lzss.lomt"
use "matrix.lomt"
use "mst.lomt"
use "noise.lomt"
use "once.lomt"
use "perm.lomt"
use "png.lomt"
use "proc.lomt"
use "qoi.lomt"
use "raster.lomt"
use "rational.lomt"
use "rle.lomt"
use "rng.lomt"
use "sched.lomt"
use "search.lomt"
use "shortest.lomt"
use "spin.lomt"
use "stats.lomt"
use "table.lomt"
use "tmpf.lomt"
use "tui.lomt"
use "udiff.lomt"
use "unionfind.lomt"
use "width.lomt"
use "wrap.lomt"
use "zlibc.lomt"
