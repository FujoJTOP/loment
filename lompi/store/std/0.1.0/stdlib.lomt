// std/stdlib.lomt — LibL 的 `<stdlib.h>`（能落下来的那一半）
//
// **LibL 是什么**：这门语言的标准库的专有名词，形态照 libc —— 一个 libc 头对一个模块，
// 函数名、参数序、返回值语义都取 libc 的（docs/232）。这一份是 `<stdlib.h>`。
//
// **`<stdlib.h>` 有两半，这一份只做前一半**（不是没时间，是后一半要运行期）：
//
//   | 那一半 | 函数 | 落不落得下来 |
//   |---|---|---|
//   | 转换 | `atoi` `atol` `strtol` `strtoul` | ✅ 纯函数 |
//   | 整数 | `abs` `labs` `llabs` | ✅ 纯函数 |
//   | 排序/查找 | `qsort` `bsearch` | ✅ 见下面"没有函数指针" |
//   | **分配** | `malloc` `calloc` `realloc` `free` | ❌ 见 §分配 |
//   | **进程** | `exit` `abort` `atexit` | ❌ 要运行期（docs/232 §6） |
//   | **环境** | `getenv` `setenv` | ❌ 世界面（`docs/219` §4 的 `world` 类） |
//   | **随机** | `rand` `srand` `random` | ❌ 要模块级状态（见下） |
//   | **shell** | `system` | ❌ 世界面 |
//
// **为什么 `rand`/`srand` 落不下来**：libc 那一对靠一个模块级静态种子。本语言**没有模块级
// 可变全局**（顶层只收 `const`，lomentc.py:1626-1738）。仓库里 `rng.lomt` 的形状是
// "状态由调用方持有"（`rng_next(state: ptr)`），要用随机数请走它 —— 那是同一件事的正确形状，
// 只是名字不叫 `rand`。
//
// **为什么分配落不下来**：`malloc` 要一个**模块级堆句柄**，同上没有地方放；`mall.lomt` 是
// **调用方给 arena** 的无状态分配器（`mall_alloc(buf, cap, n)`），给不出 libc 那个签名；
// 而内建 `alloc` 的堆布局是**编译器私有的**，从库里伸手读它就是把实现细节钉进库
// （`docs/158` 要防的正是这个）。这一族是 LibL 的下一步（docs/232 §6）。
//
// **`qsort` 没有函数指针**：libc 的第四个参数是一个比较函数，而本语言**没有函数指针**
// （`TYPES` 里没有 `fn` 类型）。所以第四个参数换成 **`kind`**：元素宽度由 `width` 给，
// 比较方式由 `kind` 给。这不是降级 —— 它把"比较函数"从**运行期的一个地址**变成
// **产物里的一个常量**，于是"这个排序按什么比"是不读源码可判的
// （与 `gc_ladder` / 端口表同族，docs/210 §3）。代价是自定义比较（比如"按第二个字段排"）
// 只能靠调用方自己写循环，**如实列在这里**。
//
// 命名：平名字空间，公开一律 libc 名（`atoi` `qsort` `bsearch` …），内部一律 `sd_*`，
// 自检 `test_stdlib_*`。

module stdlib

// 需求：这一族要用到运行期（除法/取模/`alloc`）—— 库里写 `choose` 是**声明需求**，
// 根单元要满足它（docs/227 §2.2）。包内 126 个模块已是同一个形状。
choose runtime

use "mem.lomt"
use "string.lomt"
use "ctype.lomt"

// ---------------------------------------------------------------- 转换

/// NULL。**内联的 `0 as ptr` 不能当实参**（检查器报"实参期望 ptr，得到整型字面量"），
/// 所以要先落到一个返回 `ptr` 的函数上。
fn sd_null() -> ptr {
    return 0 as ptr;
}

/// 第 c 个字符在 base 进制下的值；不是合法数字返回 -1。
/// （`char_hex_val` 只管 16 进制，这里要管到 36。）
fn sd_digit(c: u32, base: u32) -> i64 {
    let v: i64 = 0 as i64 - 1;
    if c >= 48 && c <= 57 {
        v = (c - 48) as i64;
    }
    if c >= 97 && c <= 122 {
        v = (c - 87) as i64;
    }
    if c >= 65 && c <= 90 {
        v = (c - 55) as i64;
    }
    if v < (0 as i64) {
        return 0 as i64 - 1;
    }
    if v >= (base as i64) {
        return 0 as i64 - 1;
    }
    return v;
}

/// `strtol` —— 前导空白、可选正负号、按 base 收数字。
///
/// `base` 取 0 时按前缀定：`0x`/`0X` -> 16，`0` -> 8，其余 10（libc 的原语义）。
/// 一个数字都没读到就返回 0，并且把 `endp` 指回**原串开头**（不是跳过空白后的位置）。
/// `endp` 是**调用方给的 8 字节槽**；给 NULL 就不写（libc 的 `char **` 同形）。
///
/// **`errno` 不在这里**：越界要设 `ERANGE`，而 errno 是模块级可变全局（见文件头）。
/// 越界时这里饱和到 i64 的边界并**照常返回** —— 调用方要区分请自己比边界值。
pub fn strtol(s: ptr, endp: ptr, base: u32) -> i64 {
    let i: u32 = 0;
    while isspace(load8(s, i)) {
        i = i + 1;
    }
    let neg: bool = false;
    if load8(s, i) == 45 {
        neg = true;
        i = i + 1;
    } else {
        if load8(s, i) == 43 {
            i = i + 1;
        }
    }
    let b: u32 = base;
    if b == 0 {
        if load8(s, i) == 48 {
            if load8(s, i + 1) == 120 || load8(s, i + 1) == 88 {
                b = 16;
                i = i + 2;
            } else {
                b = 8;
                i = i + 1;
            }
        } else {
            b = 10;
        }
    } else {
        if b == 16 && load8(s, i) == 48 {
            if load8(s, i + 1) == 120 || load8(s, i + 1) == 88 {
                i = i + 2;
            }
        }
    }
    let acc: i64 = 0 as i64;
    let nd: u32 = 0;
    let scanning: bool = true;
    while scanning {
        let d: i64 = sd_digit(load8(s, i), b);
        if d < (0 as i64) {
            scanning = false;
        } else {
            acc = acc * (b as i64) + d;
            nd = nd + 1;
            i = i + 1;
        }
    }
    if nd == 0 {
        // libc: 一个数字都没吃到 -> 原串开头, 不是跳过空白/符号之后的位置。
        if (endp as u64) != (0 as u64) {
            mem_store64(endp, 0, s as u64);
        }
        return 0 as i64;
    }
    if (endp as u64) != (0 as u64) {
        mem_store64(endp, 0, ptr_add(s, i) as u64);
    }
    if neg {
        return 0 as i64 - acc;
    }
    return acc;
}

/// `strtoul` —— 同 `strtol`，但按无符号收回。负号**照收**（回绕，libc 也这样）。
pub fn strtoul(s: ptr, endp: ptr, base: u32) -> u64 {
    let i: u32 = 0;
    while isspace(load8(s, i)) {
        i = i + 1;
    }
    let neg: bool = false;
    if load8(s, i) == 45 {
        neg = true;
        i = i + 1;
    } else {
        if load8(s, i) == 43 {
            i = i + 1;
        }
    }
    let b: u32 = base;
    if b == 0 {
        if load8(s, i) == 48 {
            if load8(s, i + 1) == 120 || load8(s, i + 1) == 88 {
                b = 16;
                i = i + 2;
            } else {
                b = 8;
                i = i + 1;
            }
        } else {
            b = 10;
        }
    } else {
        if b == 16 && load8(s, i) == 48 {
            if load8(s, i + 1) == 120 || load8(s, i + 1) == 88 {
                i = i + 2;
            }
        }
    }
    let acc: u64 = 0 as u64;
    let nd: u32 = 0;
    let scanning: bool = true;
    while scanning {
        let d: i64 = sd_digit(load8(s, i), b);
        if d < (0 as i64) {
            scanning = false;
        } else {
            acc = acc * (b as u64) + (d as u64);
            nd = nd + 1;
            i = i + 1;
        }
    }
    if nd == 0 {
        if (endp as u64) != (0 as u64) {
            mem_store64(endp, 0, s as u64);
        }
        return 0 as u64;
    }
    if (endp as u64) != (0 as u64) {
        mem_store64(endp, 0, ptr_add(s, i) as u64);
    }
    if neg {
        return (0 as u64) - acc;
    }
    return acc;
}

/// `atoi` —— 等价于 `(int)strtol(s, NULL, 10)`。本语言的 `i64` 收得下，
/// 但 libc 的 `atoi` 返回 `int`，越界是未定义的 —— 这里不假装能收，只是不检查。
pub fn atoi(s: ptr) -> i64 {
    return strtol(s, sd_null(), 10);
}

/// `atol` —— 等价于 `strtol(s, NULL, 10)`。
pub fn atol(s: ptr) -> i64 {
    return strtol(s, sd_null(), 10);
}

/// `abs` —— C 的那个 `abs(int)`。**`INT_MIN` 是未定义的**（libc 同）。
pub fn abs(v: i32) -> i32 {
    if v < (0 as i32) {
        return 0 as i32 - v;
    }
    return v;
}

/// `labs` —— C 的 `long` 版。本语言只有一个 64 位整数宽度。
pub fn labs(v: i64) -> i64 {
    if v < (0 as i64) {
        return 0 as i64 - v;
    }
    return v;
}

/// `llabs` —— 与 `labs` 同一个东西（本语言没有 `long` 与 `long long` 之分）。
pub fn llabs(v: i64) -> i64 {
    return labs(v);
}

// ---------------------------------------------------------------- 排序 / 查找

/// `qsort` 的第四个参数（libc 那边是比较函数）。
///
/// `qk_u32`：`width` 必须 4，按无符号 32 位比。
/// `qk_i64`：`width` 必须 8，按有符号 64 位比。
/// `qk_bytes`：按 `width` 个字节**词典序**比（无符号，与 `memcmp` 同）。
/// `qk_cstr`：`width` 必须 8，每个元素是一个 **NUL 结尾串的指针**。
pub enum qsort_kind {
    qk_u32,
    qk_i64,
    qk_bytes,
    qk_cstr,
}

/// 交换第 i、j 个元素。**逐字节**，所以任何 width 都行（不需要 8 字节的暂存）。
fn sd_swap(base: ptr, i: u32, j: u32, width: u32) {
    let a: u32 = i * width;
    let b: u32 = j * width;
    let k: u32 = 0;
    while k < width {
        let t: u32 = load8(base, a + k);
        store8(base, a + k, load8(base, b + k) as u8);
        store8(base, b + k, t as u8);
        k = k + 1;
    }
}

/// 第 i 个元素是否**小于**第 j 个（按 kind）。
fn sd_less(base: ptr, i: u32, j: u32, width: u32, kind: qsort_kind) -> bool {
    let a: u32 = i * width;
    let b: u32 = j * width;
    match kind {
        qsort_kind::qk_u32 => {
            return mem_load32(base, a) < mem_load32(base, b);
        }
        qsort_kind::qk_i64 => {
            return (mem_load64(base, a) as i64) < (mem_load64(base, b) as i64);
        }
        qsort_kind::qk_bytes => {
            return memcmp(ptr_add(base, a), ptr_add(base, b), width) < (0 as i64);
        }
        qsort_kind::qk_cstr => {
            return strcmp(mem_load64(base, a) as ptr, mem_load64(base, b) as ptr) < (0 as i64);
        }
    }
    return false;
}

/// 第 i 个元素与 key 比（bsearch 用）。同上按 kind。
fn sd_key_cmp(key: ptr, base: ptr, i: u32, width: u32, kind: qsort_kind) -> i64 {
    let o: u32 = i * width;
    match kind {
        qsort_kind::qk_u32 => {
            let ka: u32 = mem_load32(key, 0);
            let va: u32 = mem_load32(base, o);
            if ka < va {
                return 0 as i64 - 1;
            }
            if ka > va {
                return 1 as i64;
            }
            return 0 as i64;
        }
        qsort_kind::qk_i64 => {
            let kk: i64 = mem_load64(key, 0) as i64;
            let vv: i64 = mem_load64(base, o) as i64;
            if kk < vv {
                return 0 as i64 - 1;
            }
            if kk > vv {
                return 1 as i64;
            }
            return 0 as i64;
        }
        qsort_kind::qk_bytes => {
            return memcmp(key, ptr_add(base, o), width);
        }
        qsort_kind::qk_cstr => {
            return strcmp(key, mem_load64(base, o) as ptr);
        }
    }
    return 0 as i64;
}

/// `qsort` —— **升序、稳定**（插入排序）。第 4 个参数是比较**种类**，不是比较函数
/// （本语言没有函数指针，见文件头）。
///
/// `n < 2` 或 `width == 0` 时什么都不做。
pub fn qsort(base: ptr, n: u32, width: u32, kind: qsort_kind) {
    let doit: bool = n >= 2 && width > 0;
    if doit {
        let i: u32 = 1;
        while i < n {
            let j: u32 = i;
            let go: bool = true;
            while go {
                if j == 0 {
                    go = false;
                } else {
                    if sd_less(base, j, j - 1, width, kind) {
                        sd_swap(base, j, j - 1, width);
                        j = j - 1;
                    } else {
                        go = false;
                    }
                }
            }
            i = i + 1;
        }
    }
}

/// `qsort` 的常用档：n 个无符号 32 位，升序。`width` 固定 4。
pub fn qsort_u32(base: ptr, n: u32) {
    qsort(base, n, 4, qsort_kind::qk_u32);
}

/// `bsearch` —— 在一段**已按同一 kind 排好序**的数组里找 `key` 指向的那个值。
///
/// 找到返回**该元素的地址**，找不到返回 NULL。**重复元素返回哪一个不保证**
/// （libc 也只是"其中一个"）—— 要第一个用 `bsearch_lower` 那类。
///
/// `key` 与 `base` 里的元素**同形**：`qk_u32` 时 `key` 指向一个 u32，`qk_cstr` 时
/// `key` 本身就是那个 C 串的指针。
pub fn bsearch(key: ptr, base: ptr, n: u32, width: u32, kind: qsort_kind) -> ptr {
    let lo: u32 = 0;
    let hi: u32 = n;
    let go: bool = true;
    while go {
        if lo >= hi {
            go = false;
        } else {
            let mid: u32 = lo + (hi - lo) / 2;
            let c: i64 = sd_key_cmp(key, base, mid, width, kind);
            if c == (0 as i64) {
                return ptr_add(base, mid * width);
            }
            if c < (0 as i64) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
    }
    return 0 as ptr;
}

/// `bsearch` 的常用档：在 u32 数组里找一个 u32。
pub fn bsearch_u32(v: u32, base: ptr, n: u32) -> ptr {
    let slot: ptr = alloc(4);
    mem_store32(slot, 0, v);
    return bsearch(slot, base, n, 4, qsort_kind::qk_u32);
}

// ---------------------------------------------------------------- 自检

/// 字面量 -> NUL 结尾的 C 串。**不能用 `str_ptr`**：本语言的字面量不带 NUL
/// （见 `string.lomt` 的 `cstr_of`），直接喂给 `strtol` 会读过头。
fn sd_cs(s: str) -> ptr {
    let d: ptr = alloc(str_len(s) + 1);
    return cstr_of(d, s);
}

fn test_stdlib_strtol_bases() -> bool {
    return strtol(sd_cs("0x1F"), sd_null(), 16) == 31 as i64
        && strtol(sd_cs("0x1F"), sd_null(), 0) == 31 as i64
        && strtol(sd_cs("1011"), sd_null(), 2) == 11 as i64
        && strtol(sd_cs("zz"), sd_null(), 36) == 1295 as i64
        && strtol(sd_cs("   -42xyz"), sd_null(), 10) == (0 as i64 - 42)
        && strtol(sd_cs("+7"), sd_null(), 10) == 7 as i64;
}

fn test_stdlib_strtol_no_digits() -> bool {
    // 一个数字都没有 -> 0, 且 endp 指回**原串开头** (不是跳过空白之后)
    let slot: ptr = alloc(8);
    let src: ptr = sd_cs("   xyz");
    let v: i64 = strtol(src, slot, 10);
    return v == 0 as i64 && (mem_load64(slot, 0) as u64) == (src as u64);
}

fn test_stdlib_strtol_endptr_stops_at_junk() -> bool {
    // "12ab" 十进制 -> 12, endp 停在 'a' (偏移 2)
    let slot: ptr = alloc(8);
    let src: ptr = sd_cs("12ab");
    let v: i64 = strtol(src, slot, 10);
    let stop: ptr = mem_load64(slot, 0) as ptr;
    return v == 12 as i64 && (stop as u64) == (ptr_add(src, 2) as u64);
}

fn test_stdlib_abs_family() -> bool {
    return abs(0 as i32 - 5) == 5 as i32
        && labs(0 as i64 - 5) == 5 as i64
        && llabs(0 as i64 - 5) == 5 as i64
        && abs(7 as i32) == 7 as i32;
}

fn test_stdlib_qsort_u32() -> bool {
    let a: ptr = alloc(24);
    mem_store32(a, 0, 3);
    mem_store32(a, 4, 1);
    mem_store32(a, 8, 4);
    mem_store32(a, 12, 1);
    mem_store32(a, 16, 5);
    qsort_u32(a, 5);
    // 稳定: 两个 1 的相对次序不保证可观测 (值相同), 但数组必须有序
    return mem_load32(a, 0) == 1 && mem_load32(a, 4) == 1 && mem_load32(a, 8) == 3
        && mem_load32(a, 12) == 4 && mem_load32(a, 16) == 5;
}

fn test_stdlib_qsort_i64_signed() -> bool {
    // 有符号: -1 必须排在 1 前面 (按无符号比会反)
    let a: ptr = alloc(24);
    mem_store64(a, 0, 1 as u64);
    mem_store64(a, 8, 18446744073709551615 as u64);
    mem_store64(a, 16, 0 as u64);
    qsort(a, 3, 8, qsort_kind::qk_i64);
    return (mem_load64(a, 0) as i64) == (0 as i64 - 1)
        && (mem_load64(a, 8) as i64) == 0 as i64
        && (mem_load64(a, 16) as i64) == 1 as i64;
}

fn test_stdlib_qsort_bytes() -> bool {
    // 3 字节一个元素, 词典序
    let a: ptr = alloc(12);
    store8(a, 0, 98 as u8); store8(a, 1, 98 as u8); store8(a, 2, 98 as u8);
    store8(a, 3, 97 as u8); store8(a, 4, 122 as u8); store8(a, 5, 122 as u8);
    store8(a, 6, 97 as u8); store8(a, 7, 98 as u8); store8(a, 8, 122 as u8);
    qsort(a, 3, 3, qsort_kind::qk_bytes);
    return load8(a, 0) == 97 && load8(a, 1) == 98 && load8(a, 2) == 122
        && load8(a, 3) == 97 && load8(a, 4) == 122 && load8(a, 5) == 122
        && load8(a, 6) == 98 && load8(a, 7) == 98;
}

fn test_stdlib_bsearch_u32() -> bool {
    let a: ptr = alloc(24);
    mem_store32(a, 0, 1);
    mem_store32(a, 4, 3);
    mem_store32(a, 8, 4);
    mem_store32(a, 12, 7);
    let hit: ptr = bsearch_u32(4, a, 4);
    let miss: ptr = bsearch_u32(5, a, 4);
    return (hit as u64) == (ptr_add(a, 8) as u64) && (miss as u64) == (0 as u64);
}
