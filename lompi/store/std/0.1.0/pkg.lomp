// std/pkg.lomp — 库清单 (可选; docs/168 §3.2)
//
// 只放**给人看**的两个标签: 机器的身份是内容哈希 (Merkle 递归), 版本号对机器只是标签。
// 所以这里没有依赖段 (依赖就是源码里的 `use`), 也没有版本区间。
//
// 为什么是函数不是常量: 语言只有整数常量, `pub const NAME: str = "x";` 是语法错
// (docs/168 §3.2 实测)。把它写成函数就零语言改动。
//
// 后缀是 .lomp 的全部理由: 告诉工具"这是描述文件, 别当程序编"。

module pkg

pub fn name() -> str {
    return "std";
}

pub fn version() -> str {
    return "0.1.0";
}
