# Force LF for all text files: the kernel feeds raw source strings to the
# LLVM integrated assembler, and CRLF line endings inside global_asm! blocks
# make LLVM reject ELF directives (.type/.size) with "expected absolute
# expression" / "unknown directive" (M9 DEV 记录).
* text=auto
*.rs   text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.toml text eol=lf
*.ld   text eol=lf
*.s    text eol=lf
*.S    text eol=lf
*.asm  text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
# Loment 源文件: 必须 LF。测试里有一批判据按**原始字节**读这些文件 (自举 lexer/parser/
# codegen 与参考实现对照), 检出换行不同会让"同一 commit 在两台机器上文件字节不同",
# 于是出现"只在某个 worktree 才红"的假回归 (2026-09-12 归因 C2/C11/C14 时发现)。
*.lomt text eol=lf
*.lom  text eol=lf
# 同类: 被工具/构建/外部校验器逐字节或逐行读的工件与源码。CRLF 在这些地方是真的坏 ——
# sha256sum -c 会把 \r 当文件名的一部分、IR 逐字节比较会假红、Cargo 每次都重写锁文件。
*.ll     text eol=lf
*.csv    text eol=lf
*.lock   text eol=lf
*.def    text eol=lf
*.fui    text eol=lf
*.fus    text eol=lf
*.svg    text eol=lf
*.html   text eol=lf
*.js     text eol=lf
*.vim    text eol=lf
*.fuc    text eol=lf
*.sha256 text eol=lf
loment/build/SHA256SUMS text eol=lf
LICENSE text eol=lf
# 自举种子 (参考实现发射的 IR): 文本, 但绝不能被换行转换改字节 —— 驱动按字节比对
loment/build/selfhost_driver.ll text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
# binary artifacts — never convert, never diff as text
*.bin   binary
*.exe   binary
*.dll   binary
*.elf   binary
*.o     binary
*.a     binary
*.run   binary
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
