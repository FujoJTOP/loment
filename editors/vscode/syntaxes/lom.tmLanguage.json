{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "L0 (.lom)",
  "scopeName": "source.lom",
  "comment": "L0 接口层单源 (.lom) 的语法高亮：module / record / enum / const / param / meta。scope 名一律用标准 TextMate 前缀（自造根名主题不会着色）。",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#layout" },
    { "include": "#enum-block" },
    { "include": "#decl-name" },
    { "include": "#types" },
    { "include": "#declaration" },
    { "include": "#fields" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.lom", "match": "//.*" },
        { "name": "comment.block.lom", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.lom", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.lom", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.decimal.lom", "match": "\\b[0-9]+\\b" }
      ]
    },
    "layout": {
      "patterns": [
        { "name": "keyword.other.layout.lom", "match": "\\b(layout|packed|size|endian|little|big)(?=\\s*[=(,]|\\b)" },
        { "name": "variable.other.layout-attr.lom", "match": "(?<=\\b(size|endian)\\s*=)\\s*[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "enum-block": {
      "patterns": [
        {
          "name": "meta.block.enum.lom",
          "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "storage.type.declaration.enum.lom" },
            "2": { "name": "entity.name.type.lom" }
          },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.definition.block.lom" } },
          "patterns": [
            { "include": "#comments" },
            { "name": "constant.other.enummember.lom", "match": "[A-Za-z_][A-Za-z0-9_]*" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "decl-name": {
      "patterns": [
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.module.lom" },
            "2": { "name": "entity.name.namespace.lom" }
          }
        },
        {
          "match": "\\b(record)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.record.lom" },
            "2": { "name": "entity.name.type.lom" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.const.lom" },
            "2": { "name": "variable.other.constant.lom" }
          }
        },
        {
          "match": "\\b(param)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.param.lom" },
            "2": { "name": "variable.parameter.lom" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.lom",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|bool|f32|f64|str|bytes|ptr|void|usize|isize)\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "name": "storage.type.declaration.lom",
          "match": "\\b(enum|meta|use)\\b"
        },
        {
          "match": "\\b(layer|layers|formats?)\\b",
          "captures": { "1": { "name": "entity.name.tag.meta-section.lom" } }
        }
      ]
    },
    "fields": {
      "patterns": [
        { "name": "entity.name.tag.lom", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*[:=])" },
        { "name": "entity.name.type.lom", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
        { "name": "constant.other.lom", "match": "\\b[A-Z][A-Z0-9_]{1,}\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.lom", "match": "\\.\\." },
        { "name": "keyword.operator.assignment.lom", "match": "=" },
        { "name": "keyword.operator.lom", "match": "[+\\-*/%&|^<>]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.block.lom", "match": "[{}]" },
        { "name": "punctuation.definition.parameters.lom", "match": "[()]" },
        { "name": "punctuation.definition.brackets.lom", "match": "\\[|\\]" },
        { "name": "punctuation.separator.lom", "match": "[,;]" },
        { "name": "punctuation.separator.type.lom", "match": ":" },
        { "name": "punctuation.separator.member.lom", "match": "\\." },
        { "name": "punctuation.lom", "match": "@" }
      ]
    }
  }
}
