{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loment",
  "scopeName": "source.loment",
  "comment": "Loment L1 语法高亮 (语法是 Rust 严格子集, 见 docs/143)。模式保持 Oniguruma 与 JS RegExp 双向可编译。",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#capability" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#control" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#declaration" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.loment",
          "match": "//.*"
        },
        {
          "name": "comment.block.loment",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.loment",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.loment",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.loment",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.loment",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "capability": {
      "patterns": [
        {
          "name": "keyword.other.capability.loment",
          "match": "\\b(capability|guard|revocable|excluded)\\b"
        },
        {
          "name": "constant.language.audit.loment",
          "match": "\\b__(loment_caps|loment_audit|frame)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.loment",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|bool|str|ptr)\\b"
        },
        {
          "name": "storage.type.unit.loment",
          "match": "\\(\\)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.loment",
          "match": "\\b(alloc|free|load8|store8|str_len|str_eq|str_byte|str_ptr|slice_len|ptr_add|ptr_sub|atomic_add|get_bits|set_bits|panic|syscall4|syscall6)\\b(?=\\s*\\()"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.loment",
          "match": "\\b(if|else|while|for|in|match|return|as|self)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.modifier.loment",
          "match": "\\b(pub|mut|interrupt)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.loment",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "name": "storage.type.declaration.loment",
          "match": "\\b(module|use|fn|let|const|struct|enum|impl|trait|type|where)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.loment",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.type.loment",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.loment",
          "match": "->"
        },
        {
          "name": "keyword.operator.path.loment",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.loment",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.logical.loment",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.loment",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.loment",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.loment",
          "match": "[+\\-*/%&|^]"
        },
        {
          "name": "punctuation.loment",
          "match": "[{}()\\[\\];,.:?@]"
        }
      ]
    }
  }
}
