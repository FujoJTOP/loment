{
  "name": "loment",
  "displayName": "Loment",
  "description": "Loment 语言支持：语法高亮（含七门外门表层语法）+ LSP（补全/跳转/诊断/格式化）+ 构建/检查/运行命令（docs/143/148/155/188）",
  "version": "0.2.0",
  "publisher": "FujoJTOP",
  "license": "Loment-Open",
  "repository": {
    "type": "git",
    "url": "https://github.com/FujoJTOP/loment.git"
  },
  "icon": "loment-icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "//files": "打进包里的文件**允许清单**（vsce 认这个字段，npm 也认）。node_modules 必须在里面 —— 商店装下来的那份**不会**跑 npm install，vscode-languageclient 是随包发的。`tools/vscode_ext.py` 的 INCLUDE_* 是同一件事的另一份表达（那份给本机侧载用），判据钉着两边不漏同一类文件。",
  "files": [
    "src",
    "syntaxes",
    "node_modules",
    "package.json",
    "language-configuration.json",
    "language-configuration-python.json",
    "README.md",
    "LICENSE",
    "loment-icon.png"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "未受信工作区（Restricted Mode）里保留语法高亮与语言服务；下面这些设置被挡住 —— 工作区的 .vscode/settings.json 不能借着它们指向任意程序或脚本（#166）。",
      "restrictedConfigurations": [
        "loment.serverCommand",
        "loment.serverArgs",
        "loment.toolCommand",
        "loment.toolArgs",
        "loment.dapCommand",
        "loment.dapArgs",
        "loment.serverPath",
        "loment.dapScript"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "构建 / 运行 / 调试都要真文件系统（编译产物、ELF、ptrace）。"
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "loment",
    "fujoos",
    "fujolang"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:loment",
    "onLanguage:lom",
    "onLanguage:loment-c",
    "onLanguage:loment-cpp",
    "onLanguage:loment-java",
    "onLanguage:loment-csharp",
    "onLanguage:loment-go",
    "onLanguage:loment-python",
    "onLanguage:loment-natural",
    "workspaceContains:**/loment.conf"
  ],
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "loment",
        "aliases": [
          "Loment",
          "loment"
        ],
        "extensions": [
          ".lomt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lom",
        "aliases": [
          "L0 (.lom)",
          "lom"
        ],
        "extensions": [
          ".lom"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-c",
        "aliases": ["Loment (C surface grammar)"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-cpp",
        "aliases": ["Loment (C++ surface grammar)"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-java",
        "aliases": ["Loment (Java surface grammar)"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-csharp",
        "aliases": ["Loment (C# surface grammar)"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-go",
        "aliases": ["Loment (Go surface grammar)"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-python",
        "aliases": ["Loment (Python surface grammar)"],
        "configuration": "./language-configuration-python.json"
      },
      {
        "id": "loment-natural",
        "aliases": ["Loment (natural surface grammar)"]
      }
    ],
    "grammars": [
      {
        "language": "loment",
        "scopeName": "source.loment",
        "path": "./syntaxes/loment.tmLanguage.json"
      },
      {
        "language": "lom",
        "scopeName": "source.lom",
        "path": "./syntaxes/lom.tmLanguage.json"
      },
      {
        "language": "loment-c",
        "scopeName": "source.loment.c",
        "path": "./syntaxes/loment-c.tmLanguage.json"
      },
      {
        "language": "loment-cpp",
        "scopeName": "source.loment.cpp",
        "path": "./syntaxes/loment-cpp.tmLanguage.json"
      },
      {
        "language": "loment-java",
        "scopeName": "source.loment.java",
        "path": "./syntaxes/loment-java.tmLanguage.json"
      },
      {
        "language": "loment-csharp",
        "scopeName": "source.loment.csharp",
        "path": "./syntaxes/loment-csharp.tmLanguage.json"
      },
      {
        "language": "loment-go",
        "scopeName": "source.loment.go",
        "path": "./syntaxes/loment-go.tmLanguage.json"
      },
      {
        "language": "loment-python",
        "scopeName": "source.loment.python",
        "path": "./syntaxes/loment-python.tmLanguage.json"
      },
      {
        "language": "loment-natural",
        "scopeName": "source.loment.natural",
        "path": "./syntaxes/loment-natural.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Loment",
      "properties": {
        "loment.serverPath": {
          "type": "string",
          "default": "",
          "description": "tools/loment_lsp.py 的绝对路径（仅当没用 serverCommand 时生效）。留空则从工作区逐级向上自动查找。"
        },
        "loment.serverCommand": {
          "type": "string",
          "default": "",
          "description": "改用别的命令起语言服务（**不需要 Python**）。Windows 上的推荐值：wsl —— 配合 scripts/install-lsp.ps1 装好的 Loment 版服务。留空则用 python + serverPath。"
        },
        "loment.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "serverCommand 的参数。例：[\"-e\", \"/home/<you>/.local/share/loment/lsp\"]（scripts/install-lsp.ps1 会把该行打出来）。"
        },
        "loment.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "启用语言服务（补全 / 跳转 / 诊断 / 格式化）。关掉后只保留语法高亮与命令。"
        },
        "loment.extraExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外认成 L1 源的后缀（例：[\".foo\"]）。项目在 `loment.conf` 里用 `source_ext()` 声明自定义后缀时**不用填这里** —— 扩展会自己去读那份 conf（打开的是子目录、conf 在上一层时也照样找得到）。这里是给「没有 conf 也想认某个后缀」的场合用的。"
        },
        "loment.buildDir": {
          "type": "string",
          "default": "loment/build",
          "description": "构建产物（.ll / .potato.json）输出目录，相对工作区根。"
        },
        "loment.toolCommand": {
          "type": "string",
          "default": "",
          "description": "「编译 / 运行」用哪个 Loment 可执行文件（**不需要 Python**）。装了包就填 `loment`；Windows 上经 WSL 跑时填 `wsl`。留空时：Windows 上若工作区里有 scripts/lomc.ps1 就自动用它，否则命令**明确报错**（不会点了没反应）。"
        },
        "loment.toolArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "toolCommand 的参数。例：[\"-e\", \"/home/<you>/.local/share/loment/bin/loment\"]（配 toolCommand=\"wsl\"）。"
        },
        "loment.dapScript": {
          "type": "string",
          "default": "",
          "description": "调试适配器 tools/loment_dap.py 的绝对路径。留空则从工作区逐级向上自动查找。"
        },
        "loment.dapCommand": {
          "type": "string",
          "default": "",
          "description": "改用别的命令起调试适配器（默认 Windows 上走 `wsl -e python3 <dapScript>`，其它平台走 `python3 <dapScript>`）。留空即用默认。"
        },
        "loment.dapArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "dapCommand 的参数（不含脚本路径时，记得自己带上）。"
        }
      }
    },
    "breakpoints": [
      {
        "language": "loment"
      },
      {
        "language": "loment-c"
      },
      {
        "language": "loment-cpp"
      },
      {
        "language": "loment-java"
      },
      {
        "language": "loment-csharp"
      },
      {
        "language": "loment-go"
      },
      {
        "language": "loment-python"
      },
      {
        "language": "loment-natural"
      }
    ],
    "debuggers": [
      {
        "type": "loment",
        "label": "Loment 调试",
        "languages": [
          "loment",
          "loment-c",
          "loment-cpp",
          "loment-java",
          "loment-csharp",
          "loment-go",
          "loment-python",
          "loment-natural"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的 .lomt 源文件（编译在调试会话里现做，带 DWARF）"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "传给被调试程序的参数"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "在入口（`_start` 的第一条指令）就停下"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "loment",
            "request": "launch",
            "name": "调试当前 Loment 文件",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Loment: 调试一个 .lomt 文件",
            "description": "走 WSL 里的 ptrace（需要 Windows 侧装有 LLVM 的 clang / llvm-objdump）",
            "body": {
              "type": "loment",
              "request": "launch",
              "name": "调试 Loment",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "loment",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "`build`（编译）或 `run`（编译并运行）"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "loment.build",
        "title": "Loment: 编译当前文件"
      },
      {
        "command": "loment.run",
        "title": "Loment: 编译并运行"
      },
      {
        "command": "loment.restartServer",
        "title": "Loment: 重启语言服务"
      },
      {
        "command": "loment.showIr",
        "title": "Loment: 生成 LLVM IR（当前文件）"
      },
      {
        "command": "loment.checkFile",
        "title": "Loment: 静态检查（当前文件）"
      },
      {
        "command": "loment.runTests",
        "title": "Loment: 运行文件内 test_* 函数"
      },
      {
        "command": "loment.runInFujoOS",
        "title": "Loment: 在 FujoOS 里运行（QEMU）"
      },
      {
        "command": "loment.formatDocument",
        "title": "Loment: 格式化文档（lomfmt）"
      }
    ],
    "problemMatchers": [
      {
        "name": "loment",
        "owner": "loment",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (E\\d{3}) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5,
          "severity": "error"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loment.showIr",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.checkFile",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.runTests",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.build",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.run",
          "when": "editorLangId =~ /^loment/"
        }
      ],
      "editor/context": [
        {
          "command": "loment.build",
          "when": "editorLangId =~ /^loment/",
          "group": "loment@1"
        },
        {
          "command": "loment.run",
          "when": "editorLangId =~ /^loment/",
          "group": "loment@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "loment.run",
          "when": "editorLangId =~ /^loment/",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "package": "python ../../tools/vscode_ext.py --emit ../../loment/build/loment-vscode.vsix"
  }
}
