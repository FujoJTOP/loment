{
  "name": "loment",
  "displayName": "Loment",
  "description": "Loment 语言支持：语法高亮 + LSP（补全/跳转/诊断/格式化）+ 构建/检查/运行命令（docs/143/148/155）",
  "version": "0.1.0",
  "publisher": "FujoJTOP",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "loment",
    "fujoos",
    "fujolang"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:loment",
    "onLanguage:lom"
  ],
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "loment",
        "aliases": [
          "Loment",
          "loment"
        ],
        "extensions": [
          ".lomt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lom",
        "aliases": [
          "L0 (.lom)",
          "lom"
        ],
        "extensions": [
          ".lom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loment",
        "scopeName": "source.loment",
        "path": "./syntaxes/loment.tmLanguage.json"
      },
      {
        "language": "lom",
        "scopeName": "source.lom",
        "path": "./syntaxes/lom.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Loment",
      "properties": {
        "loment.serverPath": {
          "type": "string",
          "default": "",
          "description": "tools/loment_lsp.py 的绝对路径（仅当没用 serverCommand 时生效）。留空则从工作区逐级向上自动查找。"
        },
        "loment.serverCommand": {
          "type": "string",
          "default": "",
          "description": "改用别的命令起语言服务（**不需要 Python**）。Windows 上的推荐值：wsl —— 配合 scripts/install-lsp.ps1 装好的 Loment 版服务。留空则用 python + serverPath。"
        },
        "loment.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "serverCommand 的参数。例：[\"-e\", \"/home/<you>/.local/share/loment/lsp\"]（scripts/install-lsp.ps1 会把该行打出来）。"
        },
        "loment.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "启用语言服务（补全 / 跳转 / 诊断 / 格式化）。关掉后只保留语法高亮与命令。"
        },
        "loment.buildDir": {
          "type": "string",
          "default": "loment/build",
          "description": "构建产物（.ll / .potato.json）输出目录，相对工作区根。"
        },
        "loment.toolCommand": {
          "type": "string",
          "default": "",
          "description": "「编译 / 运行」用哪个 Loment 可执行文件（**不需要 Python**）。装了包就填 `loment`；Windows 上经 WSL 跑时填 `wsl`。留空时：Windows 上若工作区里有 scripts/lomc.ps1 就自动用它，否则命令**明确报错**（不会点了没反应）。"
        },
        "loment.toolArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "toolCommand 的参数。例：[\"-e\", \"/home/<you>/.local/share/loment/bin/loment\"]（配 toolCommand=\"wsl\"）。"
        },
        "loment.dapScript": {
          "type": "string",
          "default": "",
          "description": "调试适配器 tools/loment_dap.py 的绝对路径。留空则从工作区逐级向上自动查找。"
        },
        "loment.dapCommand": {
          "type": "string",
          "default": "",
          "description": "改用别的命令起调试适配器（默认 Windows 上走 `wsl -e python3 <dapScript>`，其它平台走 `python3 <dapScript>`）。留空即用默认。"
        },
        "loment.dapArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "dapCommand 的参数（不含脚本路径时，记得自己带上）。"
        }
      }
    },
    "breakpoints": [
      {
        "language": "loment"
      }
    ],
    "debuggers": [
      {
        "type": "loment",
        "label": "Loment 调试",
        "languages": [
          "loment"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的 .lomt 源文件（编译在调试会话里现做，带 DWARF）"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "传给被调试程序的参数"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "在入口（`_start` 的第一条指令）就停下"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "loment",
            "request": "launch",
            "name": "调试当前 Loment 文件",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Loment: 调试一个 .lomt 文件",
            "description": "走 WSL 里的 ptrace（需要 Windows 侧装有 LLVM 的 clang / llvm-objdump）",
            "body": {
              "type": "loment",
              "request": "launch",
              "name": "调试 Loment",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "loment",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "`build`（编译）或 `run`（编译并运行）"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "loment.build",
        "title": "Loment: 编译当前文件"
      },
      {
        "command": "loment.run",
        "title": "Loment: 编译并运行"
      },
      {
        "command": "loment.restartServer",
        "title": "Loment: 重启语言服务"
      },
      {
        "command": "loment.showIr",
        "title": "Loment: 生成 LLVM IR（当前文件）"
      },
      {
        "command": "loment.checkFile",
        "title": "Loment: 静态检查（当前文件）"
      },
      {
        "command": "loment.runTests",
        "title": "Loment: 运行文件内 test_* 函数"
      },
      {
        "command": "loment.runInFujoOS",
        "title": "Loment: 在 FujoOS 里运行（QEMU）"
      },
      {
        "command": "loment.formatDocument",
        "title": "Loment: 格式化文档（lomfmt）"
      }
    ],
    "problemMatchers": [
      {
        "name": "loment",
        "owner": "loment",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (E\\d{3}) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5,
          "severity": "error"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loment.showIr",
          "when": "editorLangId == loment"
        },
        {
          "command": "loment.checkFile",
          "when": "editorLangId == loment"
        },
        {
          "command": "loment.runTests",
          "when": "editorLangId == loment"
        },
        {
          "command": "loment.build",
          "when": "editorLangId == loment"
        },
        {
          "command": "loment.run",
          "when": "editorLangId == loment"
        }
      ],
      "editor/context": [
        {
          "command": "loment.build",
          "when": "editorLangId == loment",
          "group": "loment@1"
        },
        {
          "command": "loment.run",
          "when": "editorLangId == loment",
          "group": "loment@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "loment.run",
          "when": "editorLangId == loment",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "package": "python ../../tools/vscode_ext.py --emit ../../loment/build/loment-vscode.vsix"
  }
}
