# Loment 本地构建产物 (可重生成, 不在 release-manifest 的 134 件工件里)
#   loment-vscode.vsix      <- python tools/vscode_ext.py --emit (docs/155 §安装)
#   selfhost_codegen.ll     <- 自举 codegen 单跑一次的 IR 落盘
/loment/build/*.vsix
/loment/build/loment-vscode-*.zip
/loment/build/selfhost_codegen.ll
# 审计报告 (含提交哈希与运行时间, 每次跑都变; 由 loment_audit --json 生成)
/loment/build/audit-report.json
# 测试用的临时探针 (loment_fmt_test / loment_doc_test 会自己删; 崩了也不该进仓库)
/loment/build/fmt_*_case.lomt
/loment/build/lomdoc_edge.lomt
/loment/build/json_*.lomt
/loment/build/probe_*.lomt
# lomc.ps1 的产物 (IR/ELF: 每次编译都会变, 按需重建)
/loment/build/stage1.elf
# 仓库侧报错器的开发入口 (`loment err`) 编出来的产物与新鲜度戳 (docs/182 §6);
# Windows 上那个 .exe 已被上面的 `*.exe` 收掉。
/loment/build/lomenterr.elf
/loment/build/lomenterr.src-sha
/loment/build/user_hello.ll
/loment/build/user_hello.elf
/loment/build/all_loment.ll
/loment/build/all_loment.elf
/loment/build/lsp.ll
/loment/build/lsp.elf
/loment/build/lsp_check_case.lomt
# MSYS 版 vim 的语言服务垫片: scripts/install-lsp.ps1 生成, 里面是**那台机器的** WSL 家目录路径
/loment/build/loment-lsp.cmd

# Loment 发行包 (构建产物: 每次打包重建; setup.exe 非确定性 -> 不进校验和清单, 见 docs/162)
/loment/dist/
/loment/build/dist/

# 签名私钥/自签证书 (本机, 绝不进仓库 —— 判据 loment_sign_test 会核这条忽略规则)
/loment/build/sign/

# 会话交接件 (整段对话正文, 绝不进仓库)
/.claude/HANDOFF.md
/.claude/transcript-extract.txt
